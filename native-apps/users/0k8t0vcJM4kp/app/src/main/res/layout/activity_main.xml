<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- Premium Workspace Navigation Header Bar -->
    <RelativeLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="#FFFFFF"
        android:paddingLeft="24dp"
        android:paddingRight="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="Cloud Notes Pro"
            android:textColor="#1E293B"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnLogout"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:text="LOGOUT"
            android:textSize="12sp"
            android:textColor="#EF4444"
            android:textStyle="bold" />

        <!-- Fine Separator Under Header -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E2E8F0"
            android:layout_alignParentBottom="true" />

    </RelativeLayout>

    <!-- Metrics Dashboard (Runs calculations fully offline/client-side) -->
    <LinearLayout
        android:id="@+id/dashboardStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/headerBar"
        android:orientation="horizontal"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:background="#F8FAFC"
        android:gravity="center">

        <!-- Metrics Total Card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="6dp"
            android:padding="16dp"
            android:background="@drawable/bg_stat_card">
            
            <TextView
                android:id="@+id/txtStatTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#6366F1" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="All Items"
                android:textSize="11sp"
                android:textColor="#64748B"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Metrics Active Card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="6dp"
            android:padding="16dp"
            android:background="@drawable/bg_stat_card">
            
            <TextView
                android:id="@+id/txtStatActive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#F59E0B" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Active"
                android:textSize="11sp"
                android:textColor="#64748B"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Metrics Completed Card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="6dp"
            android:padding="16dp"
            android:background="@drawable/bg_stat_card">
            
            <TextView
                android:id="@+id/txtStatCompleted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#10B981" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Completed"
                android:textSize="11sp"
                android:textColor="#64748B"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <!-- Interactive Filtering & Query Section -->
    <LinearLayout
        android:id="@+id/filterSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/dashboardStats"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingBottom="16dp"
        android:background="#F8FAFC">

        <EditText
            android:id="@+id/searchQuery"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="Search catalog database..."
            android:textSize="14sp"
            android:paddingLeft="16dp"
            android:textColor="#1E293B"
            android:background="@drawable/bg_edit_text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/filterType"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginRight="6dp" />

            <Spinner
                android:id="@+id/filterStatus"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginLeft="6dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Notes ListView Catalog -->
    <ListView
        android:id="@+id/listViewNotes"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/filterSection"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:paddingBottom="96dp"
        android:clipToPadding="false" />

    <!-- No match message info -->
    <TextView
        android:id="@+id/emptyView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="No dynamic matching items found.\nTap '+' below to add a note!"
        android:gravity="center"
        android:textColor="#94A3B8"
        android:textSize="15sp"
        android:lineSpacingMultiplier="1.2"
        android:visibility="gone" />

    <!-- Floating Primary FAB (Rounded layout overlay) -->
    <Button
        android:id="@+id/btnAddNote"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentRight="true"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="24dp"
        android:text="+"
        android:textSize="28sp"
        android:textColor="#FFFFFF"
        android:background="@drawable/bg_button_primary"
        android:elevation="4dp" />

</RelativeLayout>