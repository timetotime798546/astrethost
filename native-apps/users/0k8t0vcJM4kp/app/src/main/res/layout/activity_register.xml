<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FAFAFA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="Join Cloud Notes"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#311B92" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Your encrypted persistent catalog database"
            android:textSize="14sp"
            android:textColor="#5C6BC0" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#FFFFFF"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email Address"
                android:textStyle="bold"
                android:textColor="#37474F" />

            <EditText
                android:id="@+id/regEmail"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:hint="you@domain.com"
                android:inputType="textEmailAddress"
                android:paddingLeft="12dp"
                android:background="@android:drawable/editbox_background_normal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Password"
                android:textStyle="bold"
                android:textColor="#37474F" />

            <EditText
                android:id="@+id/regPassword"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:hint="At least 6 characters"
                android:inputType="textPassword"
                android:paddingLeft="12dp"
                android:background="@android:drawable/editbox_background_normal" />

            <Button
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:text="Register &amp; Log In"
                android:textColor="#FFFFFF"
                android:backgroundTint="#311B92"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/btnBackToLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Already have an account? Log In"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#311B92"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>
</ScrollView>