<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="56dp"
            android:text="Recover Vault"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#1E293B" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="A security key will be emailed to you"
            android:textSize="14sp"
            android:textColor="#64748B" />

        <!-- Step 1 View: Send Verification Code -->
        <LinearLayout
            android:id="@+id/layoutStep1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="#FFFFFF"
            android:elevation="0dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Account Email"
                android:textStyle="bold"
                android:textColor="#334155"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/forgotEmail"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:hint="name@example.com"
                android:inputType="textEmailAddress"
                android:paddingLeft="16dp"
                android:textSize="14sp"
                android:textColor="#1E293B"
                android:background="@drawable/bg_edit_text" />

            <Button
                android:id="@+id/btnSendOtp"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="28dp"
                android:text="Send Security Code"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_button_primary"
                android:textStyle="bold"
                android:textSize="15sp" />

        </LinearLayout>

        <!-- Step 2 View: Input Verification Code and New Pass -->
        <LinearLayout
            android:id="@+id/layoutStep2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="#FFFFFF"
            android:elevation="0dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Security Code (OTP)"
                android:textStyle="bold"
                android:textColor="#334155"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/editOtp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:hint="6-digit code"
                android:inputType="number"
                android:paddingLeft="16dp"
                android:textSize="14sp"
                android:textColor="#1E293B"
                android:background="@drawable/bg_edit_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="New Password"
                android:textStyle="bold"
                android:textColor="#334155"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/editNewPassword"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:hint="Minimum 6 characters"
                android:inputType="textPassword"
                android:paddingLeft="16dp"
                android:textSize="14sp"
                android:textColor="#1E293B"
                android:background="@drawable/bg_edit_text" />

            <Button
                android:id="@+id/btnResetPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="28dp"
                android:text="Save New Credentials"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_button_primary"
                android:textStyle="bold"
                android:textSize="15sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/btnBackFromForgot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Back to Sign In"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#6366F1"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>
</ScrollView>