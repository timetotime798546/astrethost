<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FAFAFA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="Reset Password"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#004D40" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="We will email you a code to reset your password"
            android:textSize="14sp"
            android:textColor="#00796B" />

        <!-- Step 1 Layout -->
        <LinearLayout
            android:id="@+id/layoutStep1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#FFFFFF"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Account Email Address"
                android:textStyle="bold"
                android:textColor="#37474F" />

            <EditText
                android:id="@+id/forgotEmail"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:hint="email@example.com"
                android:inputType="textEmailAddress"
                android:paddingLeft="12dp"
                android:background="@android:drawable/editbox_background_normal" />

            <Button
                android:id="@+id/btnSendOtp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:text="Send Verification Code"
                android:textColor="#FFFFFF"
                android:backgroundTint="#004D40"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Step 2 Layout (Initially Invisible) -->
        <LinearLayout
            android:id="@+id/layoutStep2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Verification Code (OTP)"
                android:textStyle="bold"
                android:textColor="#37474F" />

            <EditText
                android:id="@+id/editOtp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:hint="6-digit code"
                android:inputType="number"
                android:paddingLeft="12dp"
                android:background="@android:drawable/editbox_background_normal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="New Password"
                android:textStyle="bold"
                android:textColor="#37474F" />

            <EditText
                android:id="@+id/editNewPassword"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:hint="At least 6 characters"
                android:inputType="textPassword"
                android:paddingLeft="12dp"
                android:background="@android:drawable/editbox_background_normal" />

            <Button
                android:id="@+id/btnResetPassword"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:text="Reset &amp; Save Password"
                android:textColor="#FFFFFF"
                android:backgroundTint="#004D40"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/btnBackFromForgot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Remembered password? Log In"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#004D40"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>
</ScrollView>