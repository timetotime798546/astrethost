{
  "backend": true,
  "api_base_url": "https://trumpledroid-api.cloudbeta28624.workers.dev",
  "roles": {
    "user": ["own"]
  },
  "collections": {
    "notes": {
      "fields": {
        "title": "string",
        "description": "string",
        "date": "string",
        "status": "string",
        "type": "string",
        "imageUrl": "string"
      },
      "operations": ["create", "read", "update", "delete"]
    }
  },
  "logic": {
    "note_statistics": {
      "type": "calculation",
      "inputs": ["notes_list"],
      "formula": "total_notes = count(notes), completed_notes = count(notes where status == 'Completed')"
    }
  }
}