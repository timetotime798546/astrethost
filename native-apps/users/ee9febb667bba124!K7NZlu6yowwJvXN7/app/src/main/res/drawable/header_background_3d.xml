<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Drop Shadow base layout representing background depth -->
    <item android:top="0dp" android:bottom="0dp" android:left="0dp" android:right="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#0D47A1" />
        </shape>
    </item>
    <!-- Mid Extrusion Layer -->
    <item android:top="0dp" android:bottom="4dp" android:left="0dp" android:right="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#1565C0" />
        </shape>
    </item>
    <!-- Top Interactive Layer with soft gradient lightsource simulation -->
    <item android:top="0dp" android:bottom="8dp" android:left="0dp" android:right="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#2196F3"
                android:endColor="#1E88E5"
                android:angle="270" />
        </shape>
    </item>
</layer-list>