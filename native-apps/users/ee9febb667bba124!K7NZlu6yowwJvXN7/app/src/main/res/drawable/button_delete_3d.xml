<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow -->
    <item android:left="2dp" android:right="2dp" android:top="3dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#C62828" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- Top face layer -->
    <item android:left="0dp" android:right="0dp" android:top="0dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#E53935"
                android:endColor="#C62828"
                android:angle="270" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#FF8A80" />
        </shape>
    </item>
</layer-list>