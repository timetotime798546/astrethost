<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed State (Tactile Depressed Visual Style) -->
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#141416" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item android:top="5dp" android:bottom="0dp" android:left="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <gradient android:startColor="#2c2c2e" android:endColor="#222224" android:angle="270" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Normal Raised State (3D Tactile Profile) -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#141416" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item android:bottom="6dp" android:left="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <gradient android:startColor="#3c3c3e" android:endColor="#2c2c2e" android:angle="270" />
                    <corners android:radius="14dp" />
                    <stroke android:width="1dp" android:color="#48484a" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>