<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Extrusion Shadow representing height -->
    <item android:left="2dp" android:right="2dp" android:top="3dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#1565C0" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- Top Face -->
    <item android:left="0dp" android:right="0dp" android:top="0dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#2196F3"
                android:endColor="#1976D2"
                android:angle="270" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#90CAF9" />
        </shape>
    </item>
</layer-list>