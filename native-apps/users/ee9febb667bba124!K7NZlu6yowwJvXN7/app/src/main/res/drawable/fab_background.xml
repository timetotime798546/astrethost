<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom shadow layer simulating high-elevation physical lift -->
    <item android:left="4dp" android:right="4dp" android:top="6dp" android:bottom="0dp">
        <shape android:shape="oval">
            <solid android:color="#AD1457" />
        </shape>
    </item>
    <!-- Top tactile click face -->
    <item android:left="0dp" android:right="0dp" android:top="0dp" android:bottom="5dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#FF4081"
                android:endColor="#D81B60"
                android:angle="270" />
            <stroke android:width="1.5dp" android:color="#FF80AB" />
        </shape>
    </item>
</layer-list>