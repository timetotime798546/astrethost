<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed State -->
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#1a6e2e" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item android:top="5dp" android:bottom="0dp" android:left="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <gradient android:startColor="#30d158" android:endColor="#24a142" android:angle="270" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Normal Raised State -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#1a6e2e" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item android:bottom="6dp" android:left="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <gradient android:startColor="#4cd964" android:endColor="#30d158" android:angle="270" />
                    <corners android:radius="14dp" />
                    <stroke android:width="1dp" android:color="#a6ffb3" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>