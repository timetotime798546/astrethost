<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom 3D Ambient Shadow -->
    <item android:left="4dp" android:right="4dp" android:top="6dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#BDBDBD" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Middle Bevel Structure Shadow -->
    <item android:left="1dp" android:right="1dp" android:top="2dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#E0E0E0" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Main Floating Layer Surface -->
    <item android:left="0dp" android:right="0dp" android:top="0dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FFFFFF"
                android:endColor="#F5F5F5"
                android:angle="270" />
            <corners android:radius="14dp" />
            <stroke android:width="1.5dp" android:color="#EAEAEA" />
        </shape>
    </item>
</layer-list>