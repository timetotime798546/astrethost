<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 3D Shadow -->
    <item android:left="1dp" android:right="1dp" android:top="2dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#1565C0" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <!-- Body -->
    <item android:left="0dp" android:right="0dp" android:top="0dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FFFFFF"
                android:endColor="#F2F2F2"
                android:angle="270" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#BBDEFB" />
        </shape>
    </item>
</layer-list>