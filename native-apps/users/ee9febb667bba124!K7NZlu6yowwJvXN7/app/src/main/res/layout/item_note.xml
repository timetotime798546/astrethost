<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_background"
    android:padding="16dp"
    android:layout_margin="2dp">

    <!-- Header: Title & Category badge -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/tv_note_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_toLeftOf="@+id/tv_note_category"
            android:text="Note Title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:ellipsize="end"
            android:maxLines="1"/>

        <TextView
            android:id="@+id/tv_note_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:text="Work"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/badge_background"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_marginLeft="8dp"/>
    </RelativeLayout>

    <!-- Excerpt / Content snippet -->
    <TextView
        android:id="@+id/tv_note_snippet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="This is a quick preview of the note content..."
        android:textSize="14sp"
        android:textColor="#666666"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginBottom="8dp"/>

    <!-- Bottom info: Creation date -->
    <TextView
        android:id="@+id/tv_note_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="May 20, 2024 - 10:30 AM"
        android:textSize="11sp"
        android:textColor="#999999"
        android:gravity="right"/>
</LinearLayout>