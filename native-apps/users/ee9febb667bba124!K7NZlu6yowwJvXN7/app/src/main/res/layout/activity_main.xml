<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B0B0C"
    android:padding="16dp">

    <!-- Premium Header Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="MODERN CALC"
            android:textColor="#505054"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />

        <Button
            android:id="@+id/btn_toggle_history"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="HISTORY"
            android:textColor="#FF9F0A"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@android:color/transparent" />
    </LinearLayout>

    <!-- Expandable History Area -->
    <LinearLayout
        android:id="@+id/layout_history"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:orientation="vertical"
        android:background="#151517"
        android:visibility="gone"
        android:padding="10dp"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Calculation History"
                android:textColor="#a2a2a7"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_clear_history"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="CLEAR"
                android:textColor="#ff3b30"
                android:textSize="10sp"
                android:background="@android:color/transparent" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/scroll_history"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/tv_history_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No calculations yet"
                android:textColor="#8e8e93"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.2" />
        </ScrollView>
    </LinearLayout>

    <!-- Top Display Canvas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.3"
        android:orientation="vertical"
        android:gravity="bottom|end"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/tv_equation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8e8e93"
            android:textSize="22sp"
            android:maxLines="2"
            android:ellipsize="start"
            android:layout_gravity="end"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/tv_display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#ffffff"
            android:textSize="54sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_gravity="end" />
    </LinearLayout>

    <!-- Memory Operations Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <Button
            android:id="@+id/btn_mc"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="MC"
            android:textColor="#FF9F0A"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/btn_memory" />

        <Button
            android:id="@+id/btn_mr"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="MR"
            android:textColor="#FF9F0A"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/btn_memory" />

        <Button
            android:id="@+id/btn_m_plus"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="M+"
            android:textColor="#FF9F0A"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/btn_memory" />

        <Button
            android:id="@+id/btn_m_minus"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="M-"
            android:textColor="#FF9F0A"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/btn_memory" />
    </LinearLayout>

    <!-- Keypad Grid Row 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="2dp">

        <Button
            android:id="@+id/btn_clear"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="AC"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold"
            android:background="@drawable/btn_function" />

        <Button
            android:id="@+id/btn_backspace"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="⌫"
            android:textColor="#000000"
            android:textSize="22sp"
            android:textStyle="bold"
            android:background="@drawable/btn_function" />

        <Button
            android:id="@+id/btn_percent"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="%"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold"
            android:background="@drawable/btn_function" />

        <Button
            android:id="@+id/btn_divide"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="÷"
            android:textColor="#ffffff"
            android:textSize="28sp"
            android:textStyle="bold"
            android:background="@drawable/btn_operator" />
    </LinearLayout>

    <!-- Keypad Grid Row 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="2dp">

        <Button
            android:id="@+id/btn_7"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="7"
            android:textColor="#ffffff"
            android:textSize="24sp"
            android:background="@drawable/btn_number" />

        <Button
            android:id="@+id/btn_8"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="8"
            android:textColor="#ffffff"
            android:textSize="24sp"
            android:background="@drawable/btn_number" />

        <Button
            android:id="@+id/btn_9"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="9"
            android:textColor="#ffffff"
            android:textSize="24sp"
            android:background="@drawable/btn_number" />

        <Button
            android:id="@+id/btn_multiply"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="×"
            android:textColor="#ffffff"
            android:textSize="28sp"
            android:textStyle="bold"
            android:background="@drawable/btn_operator" />
    </LinearLayout>

    <!-- Keypad Grid Row 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="2dp">

        <Button
            android:id="@+id/btn_4"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="4"
            android:textColor="#ffffff"
            android:textSize="24sp"
            android:background="@drawable/btn_number" />

        <Button
            android:id="@+id/btn_5"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="5"
            android:textColor="#ffffff"
            android:textSize="24sp"
            android:background="@drawable/btn_number" />

        <Button
            android:id="@+id/btn_6"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="6"
            android:textColor="#ffffff"
            android:textSize="24sp"
            android:background="@drawable/btn_number" />

        <Button
            android:id="@+id/btn_subtract"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="−"
            android:textColor="#ffffff"
            android:textSize="28sp"
            android:textStyle="bold"
            android:background="@drawable/btn_operator" />
    </LinearLayout>

    <!-- Keypad Grid Row 4 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="2dp">

        <Button
            android:id="@+id/btn_1"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="1"
            android:textColor="#ffffff"
            android:textSize="24sp"
            android:background="@drawable/btn_number" />

        <Button
            android:id="@+id/btn_2"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="2"
            android:textColor="#ffffff"
            android:textSize="24sp"
            android:background="@drawable/btn_number" />

        <Button
            android:id="@+id/btn_3"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="3"
            android:textColor="#ffffff"
            android:textSize="24sp"
            android:background="@drawable/btn_number" />

        <Button
            android:id="@+id/btn_add"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="+"
            android:textColor="#ffffff"
            android:textSize="28sp"
            android:textStyle="bold"
            android:background="@drawable/btn_operator" />
    </LinearLayout>

    <!-- Keypad Grid Row 5 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <Button
            android:id="@+id/btn_toggle_sign"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="±"
            android:textColor="#ffffff"
            android:textSize="24sp"
            android:background="@drawable/btn_number" />

        <Button
            android:id="@+id/btn_0"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="0"
            android:textColor="#ffffff"
            android:textSize="24sp"
            android:background="@drawable/btn_number" />

        <Button
            android:id="@+id/btn_dot"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="."
            android:textColor="#ffffff"
            android:textSize="24sp"
            android:background="@drawable/btn_number" />

        <Button
            android:id="@+id/btn_equal"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:text="="
            android:textColor="#ffffff"
            android:textSize="28sp"
            android:textStyle="bold"
            android:background="@drawable/btn_equals" />
    </LinearLayout>

</LinearLayout>