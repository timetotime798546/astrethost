<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F3F6">

    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/header_background_3d"
        android:padding="16dp"
        android:elevation="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Notes Manager"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:shadowColor="#212121"
            android:shadowDx="1"
            android:shadowDy="2"
            android:shadowRadius="3" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <EditText
                android:id="@+id/et_search"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:hint="Search notes..."
                android:textColorHint="#90CAF9"
                android:textColor="#FFFFFF"
                android:background="@drawable/search_background_3d"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textSize="15sp"
                android:singleLine="true" />

            <Spinner
                android:id="@+id/spinner_category_filter"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="8dp"
                android:background="@drawable/spinner_background_3d"
                android:paddingStart="8dp"
                android:paddingEnd="24dp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header_layout"
        android:orientation="vertical">

        <!-- Custom Pull-to-refresh Loader Panel -->
        <RelativeLayout
            android:id="@+id/pull_to_refresh_header"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="#E1F5FE"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:orientation="vertical"
                android:gravity="center">

                <ProgressBar
                    android:id="@+id/pull_progress_bar"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:indeterminate="true"
                    android:indeterminateTint="#0288D1" />

                <TextView
                    android:id="@+id/pull_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Pull down to refresh..."
                    android:textColor="#01579B"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </RelativeLayout>

        <ListView
            android:id="@+id/list_view_notes"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="12dp"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="12dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="No notes found.\nPull down to update or tap '+' !"
        android:textAlignment="center"
        android:textColor="#757575"
        android:textSize="16sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btn_add_note"
        android:layout_width="60dp"
        android:layout_height="65dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="24dp"
        android:background="@drawable/fab_background"
        android:text="+"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:gravity="center"
        android:elevation="8dp"
        android:visibility="gone" />

    <!-- Loader overlay with professional transitions and sound welcome integration -->
    <RelativeLayout
        android:id="@+id/loader_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1976D2"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Rounded logo badge simulation inside notes loader -->
            <TextView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/category_badge"
                android:backgroundTint="#FFFFFF"
                android:gravity="center"
                android:text="📝"
                android:textSize="38sp"
                android:layout_marginBottom="20dp"
                android:elevation="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notes Manager"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Secure • Simple • Elegant"
                android:textColor="#BBDEFB"
                android:textSize="12sp"
                android:textStyle="normal"
                android:layout_marginBottom="32dp" />

            <ProgressBar
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:indeterminate="true"
                android:indeterminateTint="#FFFFFF"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/loader_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Initializing notebook..."
                android:textColor="#E3F2FD"
                android:textSize="14sp" />
        </LinearLayout>
    </RelativeLayout>

</RelativeLayout>