<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/game_container"
    android:layout_width="match_match"
    android:layout_height="match_parent"
    android:background="#020205">

    <!-- The GLSurfaceView container will be added programmatically here -->

    <!-- Game Playing HUD (Overlaid on top of OpenGL surface) -->
    <RelativeLayout
        android:id="@+id/hud_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp"
        android:visibility="gone">

        <!-- Top Status Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_alignParentTop="true">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/score_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SCORE: 0000"
                    android:textColor="#00E5FF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:typeface="monospace" />

                <TextView
                    android:id="@+id/speed_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SPEED: 1.0x"
                    android:textColor="#FFFF00"
                    android:textSize="13sp"
                    android:typeface="monospace" />
            </LinearLayout>

            <TextView
                android:id="@+id/shield_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SHIELDS: [III]"
                android:textColor="#00E676"
                android:textSize="18sp"
                android:textStyle="bold"
                android:typeface="monospace" />
        </LinearLayout>

        <!-- Bottom Touch Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/btn_left"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:layout_marginRight="10dp"
                android:background="@drawable/btn_cyan"
                android:text="◀  LEFT"
                android:textColor="#00E5FF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:typeface="monospace" />

            <Button
                android:id="@+id/btn_right"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:layout_marginLeft="10dp"
                android:background="@drawable/btn_cyan"
                android:text="RIGHT  ▶"
                android:textColor="#00E5FF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:typeface="monospace" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Welcome / Start Game Menu Overlay -->
    <RelativeLayout
        android:id="@+id/menu_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E0020205"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SPACE RUN 3D"
                android:textColor="#00E5FF"
                android:textSize="36sp"
                android:textStyle="bold"
                android:typeface="monospace"
                android:gravity="center"
                android:shadowColor="#00E5FF"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="15" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Dodging simulator inside GLES 2.0 universe."
                android:textColor="#80FFFFFF"
                android:textSize="14sp"
                android:gravity="center"
                android:typeface="monospace" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="INSTRUCTIONS:\n1. Hold LEFT or RIGHT buttons to dodge.\n2. Avoid incoming glowing hazard cubes.\n3. Keep shields active to survive."
                android:textColor="#00E676"
                android:textSize="14sp"
                android:gravity="left"
                android:lineSpacingExtra="4dp"
                android:typeface="monospace" />

            <Button
                android:id="@+id/btn_start"
                android:layout_width="220dp"
                android:layout_height="64dp"
                android:layout_marginTop="40dp"
                android:background="@drawable/btn_cyan"
                android:text="START RUN"
                android:textColor="#00E5FF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:typeface="monospace" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Game Over Screen Overlay -->
    <RelativeLayout
        android:id="@+id/gameover_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F00A0005"
        android:padding="24dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SHIELD BREACHED"
                android:textColor="#FF1744"
                android:textSize="32sp"
                android:textStyle="bold"
                android:typeface="monospace"
                android:shadowColor="#FF1744"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="12" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="SYSTEM TERMINATED"
                android:textColor="#80FFFFFF"
                android:textSize="14sp"
                android:typeface="monospace" />

            <TextView
                android:id="@+id/gameover_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="FINAL SCORE: 0000"
                android:textColor="#00E5FF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:typeface="monospace" />

            <Button
                android:id="@+id/btn_restart"
                android:layout_width="220dp"
                android:layout_height="64dp"
                android:layout_marginTop="40dp"
                android:background="@drawable/btn_danger"
                android:text="REPLAY"
                android:textColor="#FF1744"
                android:textSize="20sp"
                android:textStyle="bold"
                android:typeface="monospace" />
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>