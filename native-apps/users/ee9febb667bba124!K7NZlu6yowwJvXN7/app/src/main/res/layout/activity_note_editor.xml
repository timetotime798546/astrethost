<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F9F9F9"
    android:padding="16dp">

    <!-- Form Heading -->
    <TextView
        android:id="@+id/editor_header_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Compose Note"
        android:textColor="#333333"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Edit Note Title Field -->
    <EditText
        android:id="@+id/editor_title"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Note Title"
        android:background="@android:drawable/edit_text"
        android:padding="10dp"
        android:textSize="18sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:layout_marginBottom="14dp" />

    <!-- Category Selector Title Label -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Assign Category"
        android:textColor="#555555"
        android:textStyle="bold"
        android:textSize="13sp"
        android:layout_marginBottom="6dp" />

    <!-- Spinner Selection -->
    <Spinner
        android:id="@+id/editor_category_spinner"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@android:drawable/btn_default"
        android:layout_marginBottom="16dp" />

    <!-- Content Field -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Note details:"
        android:textColor="#555555"
        android:textStyle="bold"
        android:textSize="13sp"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/editor_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:hint="Start typing your thoughts here..."
        android:gravity="top|left"
        android:background="@android:drawable/edit_text"
        android:padding="12dp"
        android:textSize="16sp"
        android:inputType="textMultiLine"
        android:scrollbars="vertical"
        android:layout_marginBottom="20dp" />

    <!-- Bottom Buttons Layout Panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btn_editor_delete"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="Delete"
            android:backgroundTint="#F44336"
            android:textColor="#FFFFFF"
            android:layout_marginRight="8dp" />

        <Button
            android:id="@+id/btn_editor_save"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1.5"
            android:text="Save Note"
            android:backgroundTint="#2196F3"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginLeft="8dp" />

    </LinearLayout>

</LinearLayout>