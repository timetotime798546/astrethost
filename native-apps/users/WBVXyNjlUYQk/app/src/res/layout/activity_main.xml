<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F6F8">

    <!-- Top Action Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="Text Replacer V10"
            android:textColor="#212121"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_load"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginRight="8dp"
                android:background="#E1F5FE"
                android:text="Load Image"
                android:textColor="#0288D1"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_save"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="#0288D1"
                android:text="Save PNG"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <!-- OCR Control Panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="12dp"
        android:elevation="2dp"
        android:layout_marginBottom="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Spinner
                android:id="@+id/spinner_ocr_mode"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btn_ocr_action"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginLeft="8dp"
                android:background="#FF9800"
                android:text="Run OCR"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Offline download status indicator -->
        <LinearLayout
            android:id="@+id/layout_offline_download"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_download_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Bilingual Offline Data: Missing (Hindi + Eng)"
                android:textColor="#C62828"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_download_data"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="#ECEFF1"
                android:text="Download Data"
                android:textColor="#37474F"
                android:textSize="10sp"
                android:layout_marginLeft="6dp" />
        </LinearLayout>

        <!-- OCR progress state indicator -->
        <LinearLayout
            android:id="@+id/layout_ocr_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="6dp"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/ocr_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:max="100" />

            <TextView
                android:id="@+id/tv_ocr_progress_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Processing OCR..."
                android:textColor="#0288D1"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Main Workspace (Editor View) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#E0E0E0"
        android:padding="8dp">

        <com.nativeimagetextreplacer.app.EditorView
            android:id="@+id/editor_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- Word Selector & Block Actions Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="vertical">

        <!-- Mode Switcher Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#ECEFF1"
            android:padding="6dp"
            android:gravity="center">
            
            <Button
                android:id="@+id/btn_mode_text"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="38dp"
                android:text="Text Editor"
                android:textColor="#FFFFFF"
                android:background="#0288D1"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginRight="4dp" />

            <Button
                android:id="@+id/btn_mode_brush"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="38dp"
                android:text="Brush Clean"
                android:textColor="#37474F"
                android:background="#CFD8DC"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginRight="4dp" />

            <Button
                android:id="@+id/btn_mode_overlay"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="38dp"
                android:text="Image Overlays"
                android:textColor="#37474F"
                android:background="#CFD8DC"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- CONTAINER FOR TEXT MODE (to be shown/hidden) -->
        <LinearLayout
            android:id="@+id/container_text_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="visible">

            <!-- Detected Words Horizontal Chip List -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Detected:"
                    android:textColor="#757575"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginRight="8dp"/>

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/detected_chips_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <Button
                    android:id="@+id/btn_add_box"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="#E8F5E9"
                    android:text="+ Add Box"
                    android:textColor="#2E7D32"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginLeft="8dp"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginBottom="8dp" />

            <!-- Control / Style Panel (Dynamic based on Selection) -->
            <LinearLayout
                android:id="@+id/panel_no_selection"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No text area selected"
                    android:textColor="#9E9E9E"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap any text block on the image to edit / replace it"
                    android:textColor="#BDBDBD"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/panel_selection"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Text Input & Helper Chips -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <EditText
                            android:id="@+id/et_replacement"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:background="@android:drawable/edit_text"
                            android:hint="Enter Replacement Text (Hindi / Eng)"
                            android:paddingLeft="8dp"
                            android:singleLine="true"
                            android:textSize="14sp" />

                        <Button
                            android:id="@+id/btn_replace_apply"
                            style="?android:attr/buttonStyleSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginLeft="8dp"
                            android:background="#388E3C"
                            android:text="Replace"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Translation Helper Chips -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Quick:"
                            android:textColor="#757575"
                            android:textSize="11sp"
                            android:layout_marginRight="4dp"/>

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:scrollbars="none">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <Button
                                    android:id="@+id/chip_hi_1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="28dp"
                                    android:layout_marginRight="4dp"
                                    android:background="#F5F5F5"
                                    android:text="नमस्ते"
                                    android:textColor="#424242"
                                    android:textSize="10sp" />

                                <Button
                                    android:id="@+id/chip_hi_2"
                                    android:layout_width="wrap_content"
                                    android:layout_height="28dp"
                                    android:layout_marginRight="4dp"
                                    android:background="#F5F5F5"
                                    android:text="धन्यवाद"
                                    android:textColor="#424242"
                                    android:textSize="10sp" />

                                <Button
                                    android:id="@+id/chip_hi_3"
                                    android:layout_width="wrap_content"
                                    android:layout_height="28dp"
                                    android:layout_marginRight="4dp"
                                    android:background="#F5F5F5"
                                    android:text="स्वागत है"
                                    android:textColor="#424242"
                                    android:textSize="10sp" />

                                <Button
                                    android:id="@+id/chip_en_1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="28dp"
                                    android:layout_marginRight="4dp"
                                    android:background="#F5F5F5"
                                    android:text="REPLACED"
                                    android:textColor="#424242"
                                    android:textSize="10sp" />

                                <Button
                                    android:id="@+id/chip_en_2"
                                    android:layout_width="wrap_content"
                                    android:layout_height="28dp"
                                    android:background="#F5F5F5"
                                    android:text="NEW TEXT"
                                    android:textColor="#424242"
                                    android:textSize="10sp" />
                            </LinearLayout>
                        </HorizontalScrollView>
                    </LinearLayout>

                    <!-- Styling Controls: Font Size, Bold, Alignment -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Size:"
                            android:textColor="#555555"
                            android:textSize="12sp" />

                        <SeekBar
                            android:id="@+id/sb_text_size"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="150" />

                        <Button
                            android:id="@+id/btn_bold"
                            android:layout_width="40dp"
                            android:layout_height="32dp"
                            android:layout_marginRight="4dp"
                            android:background="#EEEEEE"
                            android:text="B"
                            android:textColor="#212121"
                            android:textStyle="bold"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:background="#EEEEEE"
                            android:padding="2dp">

                            <Button
                                android:id="@+id/btn_align_left"
                                android:layout_width="32dp"
                                android:layout_height="28dp"
                                android:background="#FFFFFF"
                                android:text="L"
                                android:textColor="#212121"
                                android:textSize="10sp" />

                            <Button
                                android:id="@+id/btn_align_center"
                                android:layout_width="32dp"
                                android:layout_height="28dp"
                                android:background="#EEEEEE"
                                android:text="C"
                                android:textColor="#212121"
                                android:textSize="10sp" />

                            <Button
                                android:id="@+id/btn_align_right"
                                android:layout_width="32dp"
                                android:layout_height="28dp"
                                android:background="#EEEEEE"
                                android:text="R"
                                android:textColor="#212121"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Color Palettes -->
                    <!-- Text Color Palette -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="10dp">

                        <TextView
                            android:layout_width="70dp"
                            android:layout_height="wrap_content"
                            android:text="Text Color:"
                            android:textColor="#555555"
                            android:textSize="11sp" />

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:scrollbars="none">

                            <LinearLayout
                                android:id="@+id/container_text_colors"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" />
                        </HorizontalScrollView>
                    </LinearLayout>

                    <!-- Background Color Palette -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:layout_width="70dp"
                            android:layout_height="wrap_content"
                            android:text="Bg Color:"
                            android:textColor="#555555"
                            android:textSize="11sp" />

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:scrollbars="none">

                            <LinearLayout
                                android:id="@+id/container_bg_colors"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" />
                        </HorizontalScrollView>
                    </LinearLayout>

                    <!-- Reset & Delete Block buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_horizontal"
                        android:layout_marginTop="12dp">

                        <Button
                            android:id="@+id/btn_reset_block"
                            style="?android:attr/buttonStyleSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginRight="16dp"
                            android:background="#CFD8DC"
                            android:text="Reset Original"
                            android:textColor="#37474F"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btn_delete_block"
                            style="?android:attr/buttonStyleSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:background="#FFEBEE"
                            android:text="Delete Block"
                            android:textColor="#C62828"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <!-- CONTAINER FOR BRUSH MODE -->
        <LinearLayout
            android:id="@+id/panel_brush_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Brush Remover Tool"
                android:textColor="#263238"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tv_brush_size_label"
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:text="Brush Size: 30"
                    android:textColor="#37474F"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/sb_brush_size"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="150"
                    android:progress="30" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_horizontal">

                <Button
                    android:id="@+id/btn_brush_undo"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="100dp"
                    android:layout_height="40dp"
                    android:layout_marginRight="8dp"
                    android:background="#ECEFF1"
                    android:text="Undo"
                    android:textColor="#37474F"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_brush_redo"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="100dp"
                    android:layout_height="40dp"
                    android:layout_marginRight="8dp"
                    android:background="#ECEFF1"
                    android:text="Redo"
                    android:textColor="#37474F"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_brush_reset"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="100dp"
                    android:layout_height="40dp"
                    android:background="#FFEBEE"
                    android:text="Reset All"
                    android:textColor="#C62828"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- CONTAINER FOR OVERLAY MODE -->
        <LinearLayout
            android:id="@+id/panel_overlay_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Image Overlay Layers"
                android:textColor="#263238"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Drag &amp; Drop or tap overlays. Resize using orange corner handles."
                android:textColor="#78909C"
                android:textSize="11sp"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btn_add_overlay"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="150dp"
                    android:layout_height="40dp"
                    android:layout_marginRight="12dp"
                    android:background="#E1F5FE"
                    android:text="+ Add Overlay"
                    android:textColor="#0288D1"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_delete_overlay"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="150dp"
                    android:layout_height="40dp"
                    android:background="#FFEBEE"
                    android:text="Delete Selected"
                    android:textColor="#C62828"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>