<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.inventorysalesmanager.app">

    <application
        android:allowBackup="true"
        android:label="Inventory &amp; Sales Manager"
        android:icon="@drawable/icon"
        android:roundIcon="@drawable/icon"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Dashboard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ProductListActivity"
            android:label="Products"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".AddEditProductActivity"
            android:label="Manage Product"
            android:parentActivityName=".ProductListActivity" />

        <activity
            android:name=".ProductDetailActivity"
            android:label="Product Detail"
            android:parentActivityName=".ProductListActivity" />

        <activity
            android:name=".SalesActivity"
            android:label="Sales Ledger"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ReportsActivity"
            android:label="Analytical Reports"
            android:parentActivityName=".MainActivity" />

    </application>
</manifest>