<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.github.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="26dp"
    android:background="#FFFFFF">

    <!-- Green check illustration dynamic -->
    <TextView
        android:id="@+id/tv_dialog_icon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/circle_green"
        android:gravity="center"
        android:text="✔"
        android:textColor="#FFFFFF"
        android:textSize="34sp"
        android:textStyle="bold"
        android:layout_marginBottom="18dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Focus Session Complete!"
        android:textColor="#212121"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tv_dialog_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Excellent work! You focused beautifully. Now take a short break!"
        android:textColor="#757575"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btn_dialog_dismiss"
        android:layout_width="160dp"
        android:layout_height="48dp"
        android:text="GREAT"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="14sp"
        android:background="@drawable/button_accent" />
</LinearLayout>