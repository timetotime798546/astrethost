<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_marginLeft="12dp"
    android:layout_marginRight="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/note_item_bg">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/note_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_toLeftOf="@+id/note_category"
            android:text="Note Title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:ellipsize="end"
            android:singleLine="true" />

        <TextView
            android:id="@+id/note_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:background="@drawable/category_tag_bg"
            android:text="Work"
            android:textColor="#4A148C"
            android:textSize="12sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <TextView
        android:id="@+id/note_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="This is note content."
        android:textSize="14sp"
        android:textColor="#666666"
        android:maxLines="2"
        android:ellipsize="end" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/note_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_centerInParent="true"
            android:text="Jan 12, 2026"
            android:textSize="11sp"
            android:textColor="#999999" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_edit_note"
                android:layout_width="45dp"
                android:layout_height="30dp"
                android:background="?android:attr/selectableItemBackground"
                android:text="EDIT"
                android:textColor="#6200EE"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_delete_note"
                android:layout_width="45dp"
                android:layout_height="30dp"
                android:background="?android:attr/selectableItemBackground"
                android:text="DEL"
                android:textColor="#D32F2F"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>