<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="16dp"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Edge Border Light Controller"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp" />

        <!-- Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#1E1E1E"
            android:padding="16dp"
            android:layout_marginBottom="20dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Display Overlay Mode"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_service_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status: Disabled"
                    android:textColor="#FF5555"
                    android:textSize="14sp"
                    android:layout_topMargin="4dp"/>
            </LinearLayout>

            <Switch
                android:id="@+id/switch_light_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Controls Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E1E1E"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <!-- Border Width -->
            <TextView
                android:id="@+id/tv_label_width"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Border Width: 12dp"
                android:textColor="#E0E0E0"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/sb_border_width"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="35"
                android:progress="12"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp" />

            <!-- Animation Speed -->
            <TextView
                android:id="@+id/tv_label_speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Animation Speed: 5"
                android:textColor="#E0E0E0"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/sb_speed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="25"
                android:progress="5"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp" />

            <!-- Corner Radius -->
            <TextView
                android:id="@+id/tv_label_radius"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Border Corner Radius: 45dp"
                android:textColor="#E0E0E0"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/sb_radius"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="150"
                android:progress="45"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />
        </LinearLayout>

        <!-- Color Gradient Preset Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E1E1E"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Color Style"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <RadioGroup
                android:id="@+id/rg_color_styles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rb_style_rainbow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RGB Rainbow Cycle"
                    android:textColor="#E0E0E0"
                    android:checked="true"
                    android:layout_marginBottom="6dp" />

                <RadioButton
                    android:id="@+id/rb_style_blue_purple"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Neon Blue-Purple Dream"
                    android:textColor="#E0E0E0"
                    android:layout_marginBottom="6dp" />

                <RadioButton
                    android:id="@+id/rb_style_fire"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Volcano Fire (Red-Orange)"
                    android:textColor="#E0E0E0"
                    android:layout_marginBottom="6dp" />

                <RadioButton
                    android:id="@+id/rb_style_aurora"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aurora Teal (Green-Cyan)"
                    android:textColor="#E0E0E0"
                    android:layout_marginBottom="6dp" />

                <RadioButton
                    android:id="@+id/rb_style_pastel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pastel Blossom"
                    android:textColor="#E0E0E0" />
            </RadioGroup>
        </LinearLayout>

        <!-- Info Description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Note: Drawing overlays requires permissive system authorization. Click 'Display Overlay' toggle to set up system options. Closing this screen maintains the customized boundary animation."
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />
            
    </LinearLayout>
</ScrollView>