<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F7F9FC">

    <LinearLayout
        android:id="@+id/main_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- Header -->
        <TextView
            android:id="@+id/app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Simple Joy"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#2C3E50"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/app_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your little companion for daily smiles"
            android:textSize="14sp"
            android:textColor="#7F8C8D"
            android:layout_marginBottom="24dp"
            android:gravity="center" />

        <!-- Counter Card Container -->
        <LinearLayout
            android:id="@+id/counter_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#FFFFFF"
            android:padding="24dp"
            android:layout_marginBottom="24dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TAP COUNT"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#95A5A6"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/tv_counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="72sp"
                android:textStyle="bold"
                android:textColor="#3498DB"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btn_tap"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Tap to Smile!"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#3498DB"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Quote Card Container -->
        <LinearLayout
            android:id="@+id/quote_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#FFFFFF"
            android:padding="24dp"
            android:layout_marginBottom="24dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DAILY AFFIRMATION"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#95A5A6"
                android:letterSpacing="0.1"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tv_quote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Press the button above to start your journey of simple joys!"
                android:textSize="16sp"
                android:textColor="#34495E"
                android:gravity="center"
                android:lineSpacingMultiplier="1.2"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btn_new_quote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inspire Me"
                style="?android:attr/borderlessButtonStyle"
                android:textColor="#2980B9"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Dynamic Palette Switcher and Control Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="4dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CHOOSE THEME PALETTE"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#95A5A6"
                android:letterSpacing="0.1"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/btn_theme_blue"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:backgroundTint="#3498DB"
                    android:layout_margin="4dp" />

                <Button
                    android:id="@+id/btn_theme_green"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:backgroundTint="#2ECC71"
                    android:layout_margin="4dp" />

                <Button
                    android:id="@+id/btn_theme_purple"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:backgroundTint="#9B59B6"
                    android:layout_margin="4dp" />

                <Button
                    android:id="@+id/btn_theme_orange"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:backgroundTint="#E67E22"
                    android:layout_margin="4dp" />
            </LinearLayout>

            <!-- Reset Actions -->
            <Button
                android:id="@+id/btn_reset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reset Statistics"
                style="?android:attr/borderlessButtonStyle"
                android:textColor="#E74C3C"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>