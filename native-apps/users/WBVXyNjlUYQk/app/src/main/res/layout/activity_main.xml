<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F9F6F0">

    <!-- Top Toolbar Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#5D4037"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:elevation="4dp">

        <TextView
            android:id="@+id/appTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Donkey World 🐴"
            android:textColor="#FFFFFF"
            android:textSize="20dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/levelBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#8D6E63"
            android:textColor="#FFFFFF"
            android:text="Level 1"
            android:textSize="14dp"
            android:textStyle="bold"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </LinearLayout>

    <!-- Main Container Layout with tab structures -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- SCREEN 1: CLICKER GAME (FEED THE DONKEY) -->
        <ScrollView
            android:id="@+id/layoutGame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Feed Your Donkey Companion"
                    android:textColor="#3E2723"
                    android:textSize="18dp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <!-- ASCII Visual Representation of Donkey -->
                <TextView
                    android:id="@+id/asciiDonkey"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  ,\\_,\n  (O.O)\n  (   )\n  -\"-\"-"
                    android:textColor="#5D4037"
                    android:textSize="42dp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="20dp"
                    android:background="#EFEBE9"
                    android:padding="24dp" />

                <!-- Tap Button to Feed -->
                <Button
                    android:id="@+id/btnFeedDonkey"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🥕 Feed Donkey a Carrot"
                    android:textSize="16dp"
                    android:padding="16dp"
                    android:background="#E65100"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <!-- Feeding Progress Tracker -->
                <TextView
                    android:id="@+id/textStats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Carrots Fed: 0"
                    android:textColor="#3E2723"
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"/>

                <ProgressBar
                    android:id="@+id/feedingProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="240dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:max="10"
                    android:progress="0" />

                <TextView
                    android:id="@+id/evolutionStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Feed 10 times to Level Up!"
                    android:textColor="#795548"
                    android:textSize="12dp"
                    android:layout_marginTop="5dp" />

            </LinearLayout>
        </ScrollView>

        <!-- SCREEN 2: DONKEY SOUNDBOARD -->
        <ScrollView
            android:id="@+id/layoutSounds"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Donkey Bray Simulator"
                    android:textColor="#3E2723"
                    android:textSize="18dp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Experience synthetic generated vocalizations"
                    android:textColor="#795548"
                    android:textSize="14dp"
                    android:layout_marginBottom="24dp"
                    android:gravity="center" />

                <!-- Sound Buttons -->
                <Button
                    android:id="@+id/btnBrayClassic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:padding="16dp"
                    android:text="📢 Classic Bray (Hee-Haw)"
                    android:background="#8D6E63"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btnBrayExcited"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:padding="16dp"
                    android:text="⚡ Excited Rapid Bray"
                    android:background="#8D6E63"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btnBraySleepy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:padding="16dp"
                    android:text="💤 Low Groggy Bray"
                    android:background="#8D6E63"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Note: Sounds are synthetically generated directly using raw frequency modulators over standard Android audio channels."
                    android:textColor="#8D6E63"
                    android:textSize="11dp"
                    android:gravity="center"
                    android:layout_marginTop="20dp" />

            </LinearLayout>
        </ScrollView>

        <!-- SCREEN 3: DONKEY FACTS & INFORMATION -->
        <ScrollView
            android:id="@+id/layoutFacts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fascinating Donkey Facts"
                    android:textColor="#3E2723"
                    android:textSize="18dp"
                    android:textStyle="bold"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="15dp" />

                <!-- Facts Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#FFFFFF"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:elevation="2dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/textFactIndex"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fact #1"
                        android:textColor="#E65100"
                        android:textStyle="bold"
                        android:textSize="12dp" />

                    <TextView
                        android:id="@+id/textFactContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Donkeys have incredibly strong memories. They can recognize areas and other donkeys they have not seen for up to 25 years."
                        android:textColor="#3E2723"
                        android:textSize="16dp" />

                </LinearLayout>

                <Button
                    android:id="@+id/btnNextFact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎲 Next Donkey Fact"
                    android:background="#5D4037"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="24dp" />

                <!-- Donkey Anatomy & Care Guideline Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Care Guidelines"
                    android:textColor="#3E2723"
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Diet: Mainly barley straw, hay, and fresh clean grass in controlled proportions. Too much rich food makes donkeys ill!\n\n• Companionship: Donkeys are highly social herd animals and can develop severe depression if kept solitary without animal companionship.\n\n• Grooming: Regular hoof care from a professional farrier every 6-10 weeks is critical."
                    android:textColor="#5D4037"
                    android:textSize="14dp"
                    android:lineSpacingMultiplier="1.2" />

            </LinearLayout>
        </ScrollView>

    </FrameLayout>

    <!-- Bottom Tab Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="#EFEBE9"
        android:elevation="8dp">

        <Button
            android:id="@+id/tabFeed"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="🌾 Feed"
            android:background="#D7CCC8"
            android:textColor="#3E2723"
            android:textStyle="bold"
            android:textSize="12dp" />

        <Button
            android:id="@+id/tabSounds"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="🔊 Sounds"
            android:background="#EFEBE9"
            android:textColor="#5D4037"
            android:textStyle="bold"
            android:textSize="12dp" />

        <Button
            android:id="@+id/tabFacts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="📚 Facts"
            android:background="#EFEBE9"
            android:textColor="#5D4037"
            android:textStyle="bold"
            android:textSize="12dp" />

    </LinearLayout>

</LinearLayout>