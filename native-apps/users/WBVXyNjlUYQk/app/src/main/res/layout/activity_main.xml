<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Charging Voice Alert"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/primary_dark"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card_background"
            android:padding="20dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tv_battery_percentage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="--%"
                android:textSize="64sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:gravity="center" />

            <TextView
                android:id="@+id/tv_charging_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Status: --"
                android:textSize="18sp"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tv_power_source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Power Source: --"
                android:textSize="14sp"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tv_monitoring_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Monitoring: Inactive"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="@color/accent"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/btn_start"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="START MONITORING"
                android:background="@color/primary"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_stop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="STOP MONITORING"
                android:background="#E0E0E0"
                android:textColor="#333333"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- CUSTOM VOICE ALERTS & OWNER CONFIGURATION SECTION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card_background"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="OWNER &amp; CUSTOM VOICE TEXTS"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/primary_dark"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Owner Name:"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary" />

            <EditText
                android:id="@+id/et_owner_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g., Aman"
                android:inputType="textPersonName"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Charger Connected Speech Text:"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary" />

            <EditText
                android:id="@+id/et_msg_connected"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="apka mobile charge hone laga h"
                android:inputType="text"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Charger Disconnected Speech Text:"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary" />

            <EditText
                android:id="@+id/et_msg_disconnected"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="charging remove kar diya hai"
                android:inputType="text"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="100% Fully Charged Speech Text:"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary" />

            <EditText
                android:id="@+id/et_msg_full"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="battery poori charge ho gayi hai"
                android:inputType="text"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Percentage Alert Text (Use %d for percent, No Owner name):"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary" />

            <EditText
                android:id="@+id/et_msg_percent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Battery badh gayi hai. Ab total battery %d percent hai"
                android:inputType="text"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btn_save_custom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SAVE SPEECH SETTINGS"
                android:background="@color/primary"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GENERAL SETTINGS"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="8dp" />

        <Switch
            android:id="@+id/switch_voice_alerts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable Voice Alerts"
            android:textSize="16sp"
            android:padding="12dp"
            android:checked="true" />

        <Switch
            android:id="@+id/switch_percent_alerts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Battery Percentage Alerts"
            android:textSize="16sp"
            android:padding="12dp"
            android:checked="true"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="INDIVIDUAL VOICE ALERTS"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="8dp" />

        <Switch
            android:id="@+id/switch_alert_connected"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Charger Connected Speech"
            android:textSize="15sp"
            android:padding="10dp"
            android:checked="true" />

        <Switch
            android:id="@+id/switch_alert_disconnected"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Charger Disconnected Speech"
            android:textSize="15sp"
            android:padding="10dp"
            android:checked="true" />

        <Switch
            android:id="@+id/switch_alert_percent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Percentage Increase Speech"
            android:textSize="15sp"
            android:padding="10dp"
            android:checked="true" />

        <Switch
            android:id="@+id/switch_alert_full"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="100% Fully Charged Speech"
            android:textSize="15sp"
            android:padding="10dp"
            android:checked="true"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFF9C4"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Important for Reliable Background Alerts"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#5D4037" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Some Android manufacturers aggressively restrict background apps. To guarantee alerts, allow this app to run uninhibited."
                android:textSize="12sp"
                android:textColor="#5D4037"
                android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/btn_battery_optimization"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Battery Optimization Settings"
                android:textSize="12sp"
                android:background="#FBC02D"
                android:textColor="#212121" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>