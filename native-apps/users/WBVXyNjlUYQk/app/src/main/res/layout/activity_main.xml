<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Header Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:background="#2E5A44"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Horse Care Companion"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Tab Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:elevation="4dp">

        <TextView
            android:id="@+id/tab_horses"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Horses"
            android:textColor="#FFFFFF"
            android:background="#2E5A44"
            android:textStyle="bold"
            android:textSize="12sp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/tab_care"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Care Log"
            android:textColor="#555555"
            android:background="#E8EAE6"
            android:textStyle="bold"
            android:textSize="12sp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/tab_activity"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Activity"
            android:textColor="#555555"
            android:background="#E8EAE6"
            android:textStyle="bold"
            android:textSize="12sp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/tab_guide"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Guide"
            android:textColor="#555555"
            android:background="#E8EAE6"
            android:textStyle="bold"
            android:textSize="12sp"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <!-- Content Views -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Tab 1: Horses Layout -->
        <ScrollView
            android:id="@+id/layout_horses"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="My Stables"
                    android:textColor="#2E5A44"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:id="@+id/container_horses_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <Button
                    android:id="@+id/btn_add_horse"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="+ Add New Horse"
                    android:textColor="#FFFFFF"
                    android:background="#2E5A44"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="40dp" />
            </LinearLayout>
        </ScrollView>

        <!-- Tab 2: Care Logs Layout -->
        <ScrollView
            android:id="@+id/layout_care"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Care &amp; Feeding Logs"
                    android:textColor="#2E5A44"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Horse Selection Spinner -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#FFFFFF"
                    android:padding="12dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select Horse:"
                        android:textStyle="bold"
                        android:textColor="#555555"
                        android:textSize="12sp" />

                    <Spinner
                        android:id="@+id/spinner_care_horses"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_add_care_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="+ Log New Care Event"
                    android:textColor="#FFFFFF"
                    android:background="#2E5A44"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="History for selected horse:"
                    android:textStyle="bold"
                    android:textColor="#555555"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/container_care_logs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <!-- Tab 3: Activity Tracker Layout -->
        <ScrollView
            android:id="@+id/layout_activity"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Training &amp; Activity Tracker"
                    android:textColor="#2E5A44"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Selection -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#FFFFFF"
                    android:padding="12dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select Horse:"
                        android:textStyle="bold"
                        android:textColor="#555555"
                        android:textSize="12sp" />

                    <Spinner
                        android:id="@+id/spinner_activity_horses"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <!-- Timer Block -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#FFFFFF"
                    android:padding="16dp"
                    android:gravity="center"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Session Tracker"
                        android:textStyle="bold"
                        android:textColor="#2E5A44"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/txt_timer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00"
                        android:textColor="#222222"
                        android:textSize="48sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp" />

                    <!-- Activity Type Spinner -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Type: "
                            android:textColor="#555555"
                            android:textStyle="bold" />

                        <Spinner
                            android:id="@+id/spinner_activity_type"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <Button
                            android:id="@+id/btn_timer_start"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Start"
                            android:layout_marginEnd="8dp"
                            android:background="#2E5A44"
                            android:textColor="#FFFFFF" />

                        <Button
                            android:id="@+id/btn_timer_pause"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pause"
                            android:layout_marginEnd="8dp"
                            android:background="#888888"
                            android:textColor="#FFFFFF"
                            android:enabled="false" />

                        <Button
                            android:id="@+id/btn_timer_reset"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Reset"
                            android:background="#991B1B"
                            android:textColor="#FFFFFF" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_timer_save"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Save Active Session"
                        android:textColor="#FFFFFF"
                        android:background="#2E5A44"
                        android:layout_marginTop="12dp"
                        android:enabled="false" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Activity Logs:"
                    android:textStyle="bold"
                    android:textColor="#555555"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/container_activity_logs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <!-- Tab 4: Educational Guide Layout -->
        <ScrollView
            android:id="@+id/layout_guide"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Equine Care Guide"
                    android:textColor="#2E5A44"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Card 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#FFFFFF"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Feeding &amp; Hydration"
                        android:textStyle="bold"
                        android:textColor="#2E5A44"
                        android:textSize="16sp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#333333"
                        android:textSize="14sp"
                        android:text="• Feed standard roughage (hay/pasture) at 1.5% - 2% of the horse's total body weight daily.\n• Keep fresh water accessible at all times. Average consumption is 5-10 gallons daily.\n• Feed grain in smaller, frequent portions and only when the work level demands additional energy." />
                </LinearLayout>

                <!-- Card 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#FFFFFF"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hoof &amp; Farrier Maintenance"
                        android:textStyle="bold"
                        android:textColor="#2E5A44"
                        android:textSize="16sp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#333333"
                        android:textSize="14sp"
                        android:text="• Clean hooves daily with a hoof pick to check for rocks, foreign items, or signs of thrush.\n• Schedule a professional farrier trimming or shoeing appointment every 4 to 8 weeks depending on the horse's personal needs and hoof wear." />
                </LinearLayout>

                <!-- Card 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#FFFFFF"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Target Resting Vital Signs"
                        android:textStyle="bold"
                        android:textColor="#2E5A44"
                        android:textSize="16sp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#333333"
                        android:textSize="14sp"
                        android:text="• Temperature: 99.5°F - 101.5°F (37.5°C - 38.6°C).\n• Heart Rate / Pulse: 30 - 40 beats per minute.\n• Respiration Rate: 8 - 15 breaths per minute.\n• Mucous Membranes: Moist and salmon pink color." />
                </LinearLayout>

                <!-- Card 4 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#FFFFFF"
                    android:padding="16dp"
                    android:layout_marginBottom="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Critical Warning Signs"
                        android:textStyle="bold"
                        android:textColor="#991B1B"
                        android:textSize="16sp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#333333"
                        android:textSize="14sp"
                        android:text="• Colic (Abdominal Pain): Watch for pawing at ground, rolling, looking back at flanks, sweating, and lack of bowel movement.\n• Lameness: Reluctance to step forward, bobbing head when walking, or warm areas on hoof/leg.\n• Heavy eye tearing, cloudy eyes, or persistent coughing." />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>