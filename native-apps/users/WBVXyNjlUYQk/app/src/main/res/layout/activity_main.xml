<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FA">

    <!-- Screen Title Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:elevation="3dp">

        <TextView
            android:id="@+id/tv_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Focus Timer"
            android:textColor="#212121"
            android:textSize="21sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Switched Screen Frame -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Focus Timer Layout -->
        <ScrollView
            android:id="@+id/layout_timer_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="20dp">

                <!-- Circular Timer Indicator Frame -->
                <RelativeLayout
                    android:id="@+id/timer_circle_wrapper"
                    android:layout_width="260dp"
                    android:layout_height="260dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="24dp">

                    <com.focustimer.app.CircularProgressView
                        android:id="@+id/circular_progress"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <!-- Timer Count and Stage -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tv_countdown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="25:00"
                            android:textColor="#212121"
                            android:textSize="46sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_timer_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="STAY FOCUSED"
                            android:textColor="#757575"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp"
                            android:letterSpacing="0.1" />
                    </LinearLayout>
                </RelativeLayout>

                <!-- Preset Selection Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="16dp"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SELECT PRESET MINUTES"
                        android:textColor="#757575"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btn_preset_5"
                                android:layout_width="62dp"
                                android:layout_height="42dp"
                                android:text="5m"
                                android:textColor="@drawable/preset_button_text_color"
                                android:textSize="13sp"
                                android:textAllCaps="false"
                                android:background="@drawable/preset_button_bg"
                                android:layout_marginRight="8dp" />

                            <Button
                                android:id="@+id/btn_preset_15"
                                android:layout_width="62dp"
                                android:layout_height="42dp"
                                android:text="15m"
                                android:textColor="@drawable/preset_button_text_color"
                                android:textSize="13sp"
                                android:textAllCaps="false"
                                android:background="@drawable/preset_button_bg"
                                android:layout_marginRight="8dp" />

                            <Button
                                android:id="@+id/btn_preset_25"
                                android:layout_width="62dp"
                                android:layout_height="42dp"
                                android:text="25m"
                                android:textColor="@drawable/preset_button_text_color"
                                android:textSize="13sp"
                                android:textAllCaps="false"
                                android:background="@drawable/preset_button_bg"
                                android:layout_marginRight="8dp" />

                            <Button
                                android:id="@+id/btn_preset_45"
                                android:layout_width="62dp"
                                android:layout_height="42dp"
                                android:text="45m"
                                android:textColor="@drawable/preset_button_text_color"
                                android:textSize="13sp"
                                android:textAllCaps="false"
                                android:background="@drawable/preset_button_bg"
                                android:layout_marginRight="8dp" />

                            <Button
                                android:id="@+id/btn_preset_60"
                                android:layout_width="62dp"
                                android:layout_height="42dp"
                                android:text="60m"
                                android:textColor="@drawable/preset_button_text_color"
                                android:textSize="13sp"
                                android:textAllCaps="false"
                                android:background="@drawable/preset_button_bg" />
                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>

                <!-- Core Timer Action Controls -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <Button
                        android:id="@+id/btn_reset"
                        android:layout_width="120dp"
                        android:layout_height="50dp"
                        android:text="RESET"
                        android:textColor="#E53935"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:background="@drawable/button_secondary"
                        android:layout_marginRight="16dp" />

                    <Button
                        android:id="@+id/btn_start"
                        android:layout_width="150dp"
                        android:layout_height="50dp"
                        android:text="START"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:background="@drawable/button_accent" />

                    <Button
                        android:id="@+id/btn_pause"
                        android:layout_width="150dp"
                        android:layout_height="50dp"
                        android:text="PAUSE"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:background="@drawable/button_accent"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/btn_resume"
                        android:layout_width="150dp"
                        android:layout_height="50dp"
                        android:text="RESUME"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:background="@drawable/button_accent"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Dynamic History Logs screen -->
        <ScrollView
            android:id="@+id/layout_history_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Focus Summary Stats -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="20dp"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TODAY'S SUMMARY"
                        android:textColor="#757575"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tv_stats_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="#E53935"
                                android:textSize="36sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sessions"
                                android:textColor="#757575"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="45dp"
                            android:background="#E0E0E0"
                            android:layout_gravity="center_vertical" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tv_stats_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="#E53935"
                                android:textSize="36sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Total Minutes"
                                android:textColor="#757575"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- History dynamic log section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="COMPLETED LOGS"
                            android:textColor="#757575"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btn_clear_history"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:text="CLEAR ALL"
                            android:textColor="#E53935"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:background="@null"
                            android:paddingLeft="8dp"
                            android:paddingRight="8dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/history_logs_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/tv_empty_history"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:gravity="center"
                        android:text="No focus sessions logged today.\nComplete timers to build daily logs."
                        android:textColor="#757575"
                        android:textSize="13sp"
                        android:visibility="visible" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Preference Settings Screen -->
        <ScrollView
            android:id="@+id/layout_settings_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Core Preferences -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PREFERENCES"
                        android:textColor="#757575"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Completion Sound"
                                android:textColor="#212121"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Play alerts on complete focus milestones"
                                android:textColor="#757575"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <Switch
                            android:id="@+id/switch_sound"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EEEEEE"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Default Focus duration"
                                android:textColor="#212121"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="The default time on application startup"
                                android:textColor="#757575"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <Spinner
                            android:id="@+id/spinner_default_time"
                            android:layout_width="120dp"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Storage & Action Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DATA CONFIGURATION"
                        android:textColor="#757575"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/btn_settings_clear_data"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="Reset Focus Session History"
                        android:textColor="#E53935"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:background="@drawable/button_secondary" />
                </LinearLayout>

                <!-- Information Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ABOUT"
                        android:textColor="#757575"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Focus Timer Native"
                        android:textColor="#212121"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Version 1.0.0"
                        android:textColor="#757575"
                        android:textSize="13sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="A native lightweight Focus timer built with high-fidelity performance controls to streamline Pomodoro metrics without tracking, overhead, or complex frameworks."
                        android:textColor="#616161"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.2" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Bottom Tab Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:elevation="8dp">

        <LinearLayout
            android:id="@+id/tab_timer"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/tab_button_bg"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tv_tab_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Timer"
                android:textColor="@drawable/tab_button_text_color"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_history"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/tab_button_bg"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tv_tab_history"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="History"
                android:textColor="@drawable/tab_button_text_color"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_settings"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/tab_button_bg"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tv_tab_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textColor="@drawable/tab_button_text_color"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>