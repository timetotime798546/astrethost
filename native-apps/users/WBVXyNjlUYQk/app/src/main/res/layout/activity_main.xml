<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:background="#3F51B5"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mini Toolbox"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 1. DASHBOARD CONTAINER -->
        <LinearLayout
            android:id="@+id/layout_dashboard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose a tool:"
                android:textColor="#757575"
                android:textSize="16sp"
                android:layout_marginBottom="16dp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Tip Calc Card -->
                    <LinearLayout
                        android:id="@+id/card_tip_calc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/card_background"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💵 Tip Calculator"
                            android:textColor="#3F51B5"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Split bills and calculate tip percentages instantly."
                            android:textColor="#757575"
                            android:textSize="14sp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <!-- Unit Converter Card -->
                    <LinearLayout
                        android:id="@+id/card_unit_conv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/card_background"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚖️ Unit Converter"
                            android:textColor="#3F51B5"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Convert metric and imperial units of length, mass &amp; temperature."
                            android:textColor="#757575"
                            android:textSize="14sp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <!-- Dice Roller Card -->
                    <LinearLayout
                        android:id="@+id/card_dice_roller"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/card_background"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎲 Dice Roller"
                            android:textColor="#3F51B5"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Roll high quality interactive dice and record history."
                            android:textColor="#757575"
                            android:textSize="14sp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <!-- Stopwatch Card -->
                    <LinearLayout
                        android:id="@+id/card_stopwatch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/card_background"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⏱️ Stopwatch"
                            android:textColor="#3F51B5"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Measure and split elapsed time with high precision."
                            android:textColor="#757575"
                            android:textSize="14sp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <!-- 2. TIP CALCULATOR CONTAINER -->
        <LinearLayout
            android:id="@+id/layout_tip_calc"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <Button
                android:id="@+id/btn_back_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← Back"
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💵 Tip Calculator"
                android:textSize="22sp"
                android:textColor="#212121"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bill Amount ($)"
                        android:textColor="#757575" />

                    <EditText
                        android:id="@+id/et_bill"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:hint="0.00"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tip Percentage (%)"
                        android:textColor="#757575" />

                    <EditText
                        android:id="@+id/et_tip_percent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:hint="15"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Split (Number of People)"
                        android:textColor="#757575" />

                    <EditText
                        android:id="@+id/et_people"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:hint="1"
                        android:layout_marginBottom="16dp" />

                    <Button
                        android:id="@+id/btn_calc_tip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Calculate"
                        android:background="@drawable/button_background"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="24dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/dice_background"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tv_tip_result"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Enter values and tap Calculate to see results."
                            android:textColor="#212121"
                            android:textSize="16sp" />
                    </LinearLayout>

                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <!-- 3. UNIT CONVERTER CONTAINER -->
        <LinearLayout
            android:id="@+id/layout_unit_conv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <Button
                android:id="@+id/btn_back_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← Back"
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚖️ Unit Converter"
                android:textSize="22sp"
                android:textColor="#212121"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Input Value"
                        android:textColor="#757575" />

                    <EditText
                        android:id="@+id/et_unit_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:hint="Enter numeric value"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Conversion Type"
                        android:textColor="#757575"
                        android:layout_marginBottom="8dp" />

                    <RadioGroup
                        android:id="@+id/rg_conversion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp">

                        <RadioButton
                            android:id="@+id/rb_m_to_ft"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Meters to Feet"
                            android:checked="true" />

                        <RadioButton
                            android:id="@+id/rb_ft_to_m"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Feet to Meters" />

                        <RadioButton
                            android:id="@+id/rb_kg_to_lbs"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kilograms to Pounds" />

                        <RadioButton
                            android:id="@+id/rb_lbs_to_kg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pounds to Kilograms" />

                        <RadioButton
                            android:id="@+id/rb_c_to_f"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Celsius to Fahrenheit" />

                        <RadioButton
                            android:id="@+id/rb_f_to_c"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fahrenheit to Celsius" />
                    </RadioGroup>

                    <Button
                        android:id="@+id/btn_convert"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Convert"
                        android:background="@drawable/button_background"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="24dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/dice_background"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tv_convert_result"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Result will be displayed here"
                            android:textColor="#212121"
                            android:textSize="16sp"
                            android:gravity="center" />
                    </LinearLayout>

                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <!-- 4. DICE ROLLER CONTAINER -->
        <LinearLayout
            android:id="@+id/layout_dice_roller"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <Button
                android:id="@+id/btn_back_dice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← Back"
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎲 Dice Roller"
                android:textSize="22sp"
                android:textColor="#212121"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/dice_background">

                <TextView
                    android:id="@+id/tv_dice_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎲\nRoll!"
                    android:textColor="#3F51B5"
                    android:textSize="64sp"
                    android:textStyle="bold"
                    android:gravity="center" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_roll_dice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Roll Dice"
                android:background="@drawable/button_background"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btn_clear_dice_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Clear History"
                android:background="@android:drawable/btn_default"
                android:textColor="#333333"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tv_dice_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Recent rolls:\nNone"
                android:textColor="#757575"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 5. STOPWATCH CONTAINER -->
        <LinearLayout
            android:id="@+id/layout_stopwatch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <Button
                android:id="@+id/btn_back_stopwatch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← Back"
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏱️ Stopwatch"
                android:textSize="22sp"
                android:textColor="#212121"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/dice_background">

                <TextView
                    android:id="@+id/tv_stopwatch_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00.0"
                    android:textColor="#212121"
                    android:textSize="54sp"
                    android:textStyle="bold"
                    android:typeface="monospace" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/btn_stopwatch_start"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Start"
                    android:background="@drawable/button_background"
                    android:textColor="#FFFFFF"
                    android:layout_marginRight="4dp" />

                <Button
                    android:id="@+id/btn_stopwatch_pause"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Pause"
                    android:background="@android:drawable/btn_default"
                    android:textColor="#333333"
                    android:layout_marginRight="4dp" />

                <Button
                    android:id="@+id/btn_stopwatch_reset"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Reset"
                    android:background="@android:drawable/btn_default"
                    android:textColor="#333333" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_stopwatch_lap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lap Time"
                android:background="@android:drawable/btn_default"
                android:textColor="#333333"
                android:layout_marginBottom="16dp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/tv_stopwatch_laps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Laps:\nNone"
                    android:textColor="#757575"
                    android:textSize="14sp" />
            </ScrollView>
        </LinearLayout>

    </FrameLayout>
</LinearLayout>