<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- Primary Game Custom Canvas Rendering View -->
    <com.retrobrickbreaker.app.GameView
        android:id="@+id/game_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Status Bar & HUD -->
    <RelativeLayout
        android:id="@+id/hud_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="#A6000000">

        <TextView
            android:id="@+id/tv_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SCORE: 0000"
            android:textColor="#00FFCC"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tv_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:text="LEVEL: 1"
            android:textColor="#FFFF00"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tv_lives"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:text="LIVES: ❤❤❤"
            android:textColor="#FF3366"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />
    </RelativeLayout>

    <!-- Overlay Screen for Welcome / Start State -->
    <LinearLayout
        android:id="@+id/overlay_start"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6101015"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RETRO"
            android:textColor="#FF3366"
            android:textSize="24sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.2" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BRICK BREAKER"
            android:textColor="#00FFCC"
            android:textSize="38sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:gravity="center"
            android:shadowColor="#00FFCC"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="10" />

        <TextView
            android:id="@+id/tv_high_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="HIGH SCORE: 0"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="• DRAG PADDLE TO BOUNCE BALL\n• CLEAR ALL BRICKS TO WIN\n• WATCH OUT FOR FALLING POWER-UPS"
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:lineSpacingExtra="6dp"
            android:gravity="center"
            android:fontFamily="monospace" />

        <Button
            android:id="@+id/btn_play"
            android:layout_width="220dp"
            android:layout_height="60dp"
            android:layout_marginTop="50dp"
            android:backgroundTint="#00FFCC"
            android:text="START GAME"
            android:textColor="#121212"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />
            
        <Button
            android:id="@+id/btn_toggle_sound"
            android:layout_width="220dp"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#333333"
            android:text="SOUND: ON"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- Overlay Screen for Game Over / Win State -->
    <LinearLayout
        android:id="@+id/overlay_game_over"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6151010"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_game_result_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GAME OVER"
            android:textColor="#FF3366"
            android:textSize="42sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:shadowColor="#FF3366"
            android:shadowRadius="8" />

        <TextView
            android:id="@+id/tv_final_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="FINAL SCORE: 0000"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tv_new_record"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="NEW RECORD!"
            android:textColor="#FFFF00"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_retry"
            android:layout_width="220dp"
            android:layout_height="60dp"
            android:layout_marginTop="50dp"
            android:backgroundTint="#FF3366"
            android:text="PLAY AGAIN"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />
    </LinearLayout>
</RelativeLayout>