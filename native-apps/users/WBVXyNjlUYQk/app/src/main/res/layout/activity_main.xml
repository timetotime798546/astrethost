<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FAFAFA">

    <!-- Header App Title -->
    <TextView
        android:id="@+id/app_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Simple Notepad"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#212121"
        android:layout_marginBottom="12dp"
        android:gravity="center_horizontal"/>

    <!-- Search Bar Section -->
    <EditText
        android:id="@+id/search_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Search notes..."
        android:inputType="text"
        android:padding="10dp"
        android:background="#EFEFEF"
        android:layout_marginBottom="12dp"
        android:importantForAutofill="no"
        android:textSize="14sp" />

    <!-- Note Editor Mode Indicator -->
    <TextView
        android:id="@+id/editor_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Create Note"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#757575"
        android:layout_marginBottom="4dp" />

    <!-- Optional Title Form Field -->
    <EditText
        android:id="@+id/note_title_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Note Title (Optional)"
        android:inputType="textCapSentences"
        android:padding="10dp"
        android:background="#FFFFFF"
        android:layout_marginBottom="8dp"
        android:importantForAutofill="no"
        android:textSize="16sp"/>

    <!-- Mandatory Note Body Field -->
    <EditText
        android:id="@+id/note_input"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:hint="Type your note here..."
        android:inputType="textMultiLine"
        android:gravity="top"
        android:padding="10dp"
        android:background="#FFFFFF"
        android:layout_marginBottom="12dp"
        android:importantForAutofill="no"
        android:textSize="14sp"/>

    <!-- Form Action Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btn_save"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:text="Save Note"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btn_cancel_edit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:text="New/Clear"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn_clear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:text="Clear All"
            android:layout_marginStart="4dp"
            android:textColor="#D32F2F"/>
    </LinearLayout>

    <!-- Notes List Section Description -->
    <TextView
        android:id="@+id/notes_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your Notes (Click to edit, long-press to delete):"
        android:textSize="12sp"
        android:textStyle="italic"
        android:textColor="#757575"
        android:layout_marginBottom="8dp"/>

    <!-- Scrollable Note List View -->
    <ListView
        android:id="@+id/notes_listview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#E0E0E0"
        android:dividerHeight="1dp"
        android:background="#FFFFFF" />
</LinearLayout>