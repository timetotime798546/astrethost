<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#ECEFF1">

    <!-- Top Action Bar / Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#37474F"
        android:padding="8dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1.2"
            android:layout_height="wrap_content"
            android:text="Sketch Studio"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingStart="4dp" />

        <Button
            android:id="@+id/btn_undo"
            android:layout_width="55dp"
            android:layout_height="36dp"
            android:text="Undo"
            android:textSize="10sp"
            android:background="#546E7A"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn_redo"
            android:layout_width="55dp"
            android:layout_height="36dp"
            android:text="Redo"
            android:textSize="10sp"
            android:background="#546E7A"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn_clear"
            android:layout_width="55dp"
            android:layout_height="36dp"
            android:text="Clear"
            android:textSize="10sp"
            android:background="#C62828"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="55dp"
            android:layout_height="36dp"
            android:text="Save"
            android:textSize="10sp"
            android:background="#2E7D32"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Guide Template Status / Texture Control Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#ECEFF1"
        android:padding="8dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_current_template"
            android:layout_width="0dp"
            android:layout_weight="1.1"
            android:layout_height="wrap_content"
            android:text="Guide: None"
            android:textColor="#37474F"
            android:textSize="12sp"
            android:textStyle="italic" />

        <Button
            android:id="@+id/btn_template_next"
            android:layout_width="0dp"
            android:layout_weight="0.95"
            android:layout_height="34dp"
            android:text="Cycle Guides"
            android:textSize="10sp"
            android:background="#78909C"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btn_paper"
            android:layout_width="0dp"
            android:layout_weight="0.95"
            android:layout_height="34dp"
            android:text="Paper On/Off"
            android:textSize="10sp"
            android:background="#78909C"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Canvas drawing view container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="4dp"
        android:background="#90A4AE"
        android:padding="4dp">

        <com.pencilsketchstudio.app.DrawingView
            android:id="@+id/drawing_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- Bottom Dashboard Panel (Brush properties & Color choosing picker) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="10dp">

        <!-- Pencil leads / Tools header labels -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PENCIL TYPES &amp; LEAD GRADE"
            android:textColor="#455A64"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <!-- Row 1: Brush styles selection list -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_tool_hb"
                    android:layout_width="85dp"
                    android:layout_height="36dp"
                    android:text="HB Pencil"
                    android:textSize="11sp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_tool_2b"
                    android:layout_width="85dp"
                    android:layout_height="36dp"
                    android:text="2B Sketch"
                    android:textSize="11sp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_tool_6b"
                    android:layout_width="85dp"
                    android:layout_height="36dp"
                    android:text="6B Charcoal"
                    android:textSize="11sp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_tool_color"
                    android:layout_width="85dp"
                    android:layout_height="36dp"
                    android:text="Colored"
                    android:textSize="11sp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_tool_eraser"
                    android:layout_width="85dp"
                    android:layout_height="36dp"
                    android:text="Eraser"
                    android:textSize="11sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Color Lead Selector label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SELECT PENCIL LEAD COLOR"
            android:textColor="#455A64"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="2dp" />

        <!-- Row 2: Color list -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:id="@+id/colors_layout_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical" />
        </HorizontalScrollView>

        <!-- Sliders & Labels -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F5F7F8"
            android:padding="8dp">

            <!-- Lead size slider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/tv_size_label"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="Lead Size: 12px"
                    android:textColor="#263238"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/sb_size"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Lead opacity slider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_opacity_label"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="Lead Opacity: 78%"
                    android:textColor="#263238"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/sb_opacity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>