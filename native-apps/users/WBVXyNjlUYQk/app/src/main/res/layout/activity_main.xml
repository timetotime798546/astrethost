<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#00796B"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="ZenHabit Studio"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main Content Frame -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- TAB 1: HABITS TRACKER -->
        <ScrollView
            android:id="@+id/layout_habits_tab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Progress Header Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_background"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Today's Progress"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#004D40"/>

                    <ProgressBar
                        android:id="@+id/habits_progress_bar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:layout_marginTop="8dp"
                        android:max="100"
                        android:progress="0" />

                    <TextView
                        android:id="@+id/habits_progress_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0% habits completed today"
                        android:textColor="#757575"
                        android:layout_marginTop="4dp"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Add Habit Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_background"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Create Habit Goal"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#004D40" />

                    <EditText
                        android:id="@+id/edit_habit_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Drink 8 glasses of water, Meditate..."
                        android:singleLine="true"
                        android:layout_marginTop="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Category: "
                            android:textSize="14sp"/>

                        <Spinner
                            android:id="@+id/spinner_category"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_add_habit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/button_background"
                        android:textColor="#FFFFFF"
                        android:text="Add to Routine"
                        android:layout_marginTop="12dp" />
                </LinearLayout>

                <!-- List Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your Habits"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp"/>

                <!-- Habits Container -->
                <LinearLayout
                    android:id="@+id/habits_list_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <!-- TAB 2: MINDFUL TIMER -->
        <ScrollView
            android:id="@+id/layout_timer_tab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <!-- Dynamic breathing visualization visual -->
                <com.zenhabit.app.CustomTimerVisualizerView
                    android:id="@+id/timer_visualizer"
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:layout_marginTop="16dp" />

                <!-- Digital Time Display -->
                <TextView
                    android:id="@+id/timer_countdown_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="25:00"
                    android:textSize="48sp"
                    android:textStyle="bold"
                    android:textColor="#00796B"
                    android:layout_marginTop="16dp" />

                <!-- Preset Quick Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp"
                    android:gravity="center">

                    <Button
                        android:id="@+id/btn_preset_focus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Focus (25m)"
                        style="?android:attr/buttonStyleSmall"
                        android:layout_margin="4dp"/>

                    <Button
                        android:id="@+id/btn_preset_short"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Zen Breath (1m)"
                        style="?android:attr/buttonStyleSmall"
                        android:layout_margin="4dp"/>

                    <Button
                        android:id="@+id/btn_preset_long"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Relax (10m)"
                        style="?android:attr/buttonStyleSmall"
                        android:layout_margin="4dp"/>
                </LinearLayout>

                <!-- Timer Controllers -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="24dp"
                    android:gravity="center">

                    <Button
                        android:id="@+id/btn_timer_start"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/button_background"
                        android:textColor="#FFFFFF"
                        android:text="Start Focus"
                        android:layout_margin="8dp" />

                    <Button
                        android:id="@+id/btn_timer_reset"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/button_background"
                        android:textColor="#FFFFFF"
                        android:text="Reset"
                        android:layout_margin="8dp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- TAB 3: MOOD JOURNAL -->
        <ScrollView
            android:id="@+id/layout_journal_tab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Mood Selector Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_background"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="How do you feel today?"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#004D40"/>

                    <!-- Smiley layout representation -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="12dp">

                        <Button
                            android:id="@+id/btn_mood_1"
                            android:layout_width="wrap_content"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="😇\nPeace"
                            android:background="@android:color/transparent"/>

                        <Button
                            android:id="@+id/btn_mood_2"
                            android:layout_weight="1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="😄\nJoy"
                            android:background="@android:color/transparent"/>

                        <Button
                            android:id="@+id/btn_mood_3"
                            android:layout_weight="1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="😐\nCalm"
                            android:background="@android:color/transparent"/>

                        <Button
                            android:id="@+id/btn_mood_4"
                            android:layout_weight="1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="😰\nAnxious"
                            android:background="@android:color/transparent"/>

                        <Button
                            android:id="@+id/btn_mood_5"
                            android:layout_weight="1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="😴\nTired"
                            android:background="@android:color/transparent"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txt_selected_mood"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Selected Mood: Calm (3)"
                        android:textStyle="italic"
                        android:layout_marginTop="8dp"
                        android:textColor="#00796B"
                        android:gravity="center_horizontal" />

                    <EditText
                        android:id="@+id/edit_mood_note"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Add a reflective note..."
                        android:layout_marginTop="12dp" />

                    <Button
                        android:id="@+id/btn_save_mood"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/button_background"
                        android:textColor="#FFFFFF"
                        android:text="Log Mood State"
                        android:layout_marginTop="12dp" />
                </LinearLayout>

                <!-- Chart Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Weekly Mood Graph"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp"/>

                <!-- Custom Chart Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_background"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.zenhabit.app.CustomChartView
                        android:id="@+id/custom_chart_view"
                        android:layout_width="match_parent"
                        android:layout_height="200dp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#E0F2F1"
        android:orientation="horizontal">

        <Button
            android:id="@+id/nav_habits"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="Habits"
            android:background="?android:attr/selectableItemBackground"
            android:textColor="#00796B"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/nav_timer"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="Focus"
            android:background="?android:attr/selectableItemBackground"
            android:textColor="#555555"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/nav_journal"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="Journal"
            android:background="?android:attr/selectableItemBackground"
            android:textColor="#555555"
            android:textSize="14sp"
            android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>