<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FA">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#2196F3"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Home Control"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHeaderStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="System Secure | Temp: 72°F"
            android:textColor="#E0F2F1"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Room Filter Switchers -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="#FFFFFF"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:paddingLeft="12dp"
        android:paddingRight="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnFilterAll"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="All Devices"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_bg"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_marginRight="8dp"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnFilterLiving"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Living Room"
                android:textColor="#333333"
                android:background="@drawable/button_bg_secondary"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_marginRight="8dp"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnFilterBackyard"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Backyard"
                android:textColor="#333333"
                android:background="@drawable/button_bg_secondary"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:textSize="12sp" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Content Scroll -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Card 1: Smart Thermostat (LIVING ROOM) -->
            <LinearLayout
                android:id="@+id/cardThermostat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Smart Thermostat"
                    android:textColor="#212121"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Living Room Climate"
                    android:textColor="#757575"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Temp Indicator Circle -->
                    <LinearLayout
                        android:id="@+id/layoutTempCircle"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:background="@drawable/circle_temp_bg"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_alignParentLeft="true"
                        android:layout_centerVertical="true"
                        android:layout_marginLeft="16dp">

                        <TextView
                            android:id="@+id/tvCurrentTemp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="72°F"
                            android:textColor="#2196F3"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Target"
                            android:textColor="#757575"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Control Buttons -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_toRightOf="@id/layoutTempCircle"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:gravity="center">

                        <Button
                            android:id="@+id/btnTempUp"
                            android:layout_width="120dp"
                            android:layout_height="38dp"
                            android:text="Increase (+)"
                            android:textColor="#FFFFFF"
                            android:background="@drawable/button_bg"
                            android:layout_marginBottom="8dp"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/btnTempDown"
                            android:layout_width="120dp"
                            android:layout_height="38dp"
                            android:text="Decrease (-)"
                            android:textColor="#FFFFFF"
                            android:background="@drawable/button_bg"
                            android:textSize="12sp" />

                    </LinearLayout>

                </RelativeLayout>

            </LinearLayout>

            <!-- Card 2: Smart Lights (LIVING ROOM) -->
            <LinearLayout
                android:id="@+id/cardLights"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Main Lights"
                            android:textColor="#212121"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Living Room System"
                            android:textColor="#757575"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <Switch
                        android:id="@+id/switchLights"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:checked="true" />

                </RelativeLayout>

                <LinearLayout
                    android:id="@+id/layoutLightControl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Brightness Level"
                            android:textColor="#212121"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvLightBrightness"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="80%"
                            android:textColor="#2196F3"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:layout_alignParentRight="true" />

                    </RelativeLayout>

                    <SeekBar
                        android:id="@+id/seekBarBrightness"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="80" />

                </LinearLayout>

            </LinearLayout>

            <!-- Card 3: Smart Lock (BACKYARD) -->
            <LinearLayout
                android:id="@+id/cardLock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Main Entrance Lock"
                            android:textColor="#212121"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Security Node A-1"
                            android:textColor="#757575"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <Switch
                        android:id="@+id/switchLock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:checked="true" />

                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Security Status: "
                        android:textColor="#757575"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvLockStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SECURE &amp; LOCKED"
                        android:textColor="#4CAF50"
                        android:textStyle="bold"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Card 4: Backyard Camera (BACKYARD) -->
            <LinearLayout
                android:id="@+id/cardCamera"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Backyard Security Cam"
                    android:textColor="#212121"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Live feed monitoring system"
                    android:textColor="#757575"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp" />

                <!-- Custom view for Camera Stream -->
                <com.homecontrol.app.CameraView
                    android:id="@+id/cameraView"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_marginBottom="12dp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Button
                        android:id="@+id/btnCameraTrigger"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Simulate Alert"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/button_bg"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:textSize="11sp" />

                    <CheckBox
                        android:id="@+id/cbMotionAlerts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Motion Detection"
                        android:checked="true"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:textSize="11sp" />

                </RelativeLayout>

            </LinearLayout>

            <!-- Card 5: System Log Panel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="16dp"
                android:layout_marginBottom="24dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="System Activity Logs"
                        android:textColor="#212121"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnClearLogs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CLEAR"
                        android:textColor="#2196F3"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:clickable="true"
                        android:focusable="true" />

                </RelativeLayout>

                <!-- Scrollable Logs list -->
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:background="#FAFAFA"
                    android:padding="8dp">

                    <LinearLayout
                        android:id="@+id/layoutLogsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        
                        <!-- Dynamic logs go here -->

                    </LinearLayout>
                </ScrollView>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>