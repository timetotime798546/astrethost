<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F2F5">

    <!-- Top Action Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#092F62"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="Aadhaar Card Template Maker"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- INPUT FORM SECTION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="16dp"
                android:elevation="2dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fill User Details / विवरण दर्ज करें"
                    android:textColor="#092F62"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Name Input -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Full Name / पूरा नाम:"
                    android:textSize="12sp"
                    android:textColor="#555555" />
                <EditText
                    android:id="@+id/input_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g. Rahul Kumar"
                    android:inputType="textPersonName"
                    android:textSize="14sp"
                    android:layout_marginBottom="10dp" />

                <!-- Aadhaar Input -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aadhaar Number (12 Digits) / आधार संख्या:"
                    android:textSize="12sp"
                    android:textColor="#555555" />
                <EditText
                    android:id="@+id/input_aadhaar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="1234 5678 9012"
                    android:inputType="number"
                    android:textSize="14sp"
                    android:layout_marginBottom="10dp" />

                <!-- DOB Input -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Date of Birth / जन्म तिथि:"
                    android:textSize="12sp"
                    android:textColor="#555555" />
                <EditText
                    android:id="@+id/input_dob"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="DD/MM/YYYY (Click to Pick)"
                    android:focusable="false"
                    android:clickable="true"
                    android:textSize="14sp"
                    android:layout_marginBottom="10dp" />

                <!-- Gender Input -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gender / लिंग:"
                    android:textSize="12sp"
                    android:textColor="#555555"
                    android:layout_marginBottom="4dp" />
                <RadioGroup
                    android:id="@+id/input_gender_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">
                    <RadioButton
                        android:id="@+id/gender_male"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Male / पुरुष"
                        android:checked="true"
                        android:textSize="12sp" />
                    <RadioButton
                        android:id="@+id/gender_female"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Female / महिला"
                        android:textSize="12sp"
                        android:layout_marginLeft="12dp" />
                    <RadioButton
                        android:id="@+id/gender_other"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Other / अन्य"
                        android:textSize="12sp"
                        android:layout_marginLeft="12dp" />
                </RadioGroup>

                <!-- Address Input -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Address / पता:"
                    android:textSize="12sp"
                    android:textColor="#555555" />
                <EditText
                    android:id="@+id/input_address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="S/O Suresh Kumar, House No 42, Sector 15..."
                    android:inputType="textMultiLine"
                    android:lines="3"
                    android:gravity="top"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <!-- Select Photo Button -->
                <Button
                    android:id="@+id/btn_select_photo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Select Profile Photo / फोटो चुनें"
                    android:textColor="#FFFFFF"
                    android:background="#303F9F"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <!-- LIVE PREVIEW SECTION CONTAINER FOR DOWNLOAD -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aadhaar Template Preview (Editable) / पूर्वावलोकन"
                android:textColor="#333333"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- The Layout that will be screenshotted/converted to Bitmap -->
            <LinearLayout
                android:id="@+id/card_download_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- FRONT CARD -->
                <RelativeLayout
                    android:layout_width="340dp"
                    android:layout_height="215dp"
                    android:background="@drawable/card_border"
                    android:padding="8dp">

                    <!-- Tricolor Header Bar -->
                    <LinearLayout
                        android:id="@+id/front_tricolor"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:orientation="horizontal">
                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="#FF9933" />
                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="#FFFFFF" />
                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="#128807" />
                    </LinearLayout>

                    <!-- Top Banner Text -->
                    <LinearLayout
                        android:id="@+id/front_banner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/front_tricolor"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="4dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="भारत सरकार"
                            android:textColor="#D32F2F"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="GOVERNMENT OF INDIA"
                            android:textColor="#092F62"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Profile Photo Frame -->
                    <ImageView
                        android:id="@+id/preview_photo"
                        android:layout_width="70dp"
                        android:layout_height="90dp"
                        android:layout_below="@id/front_banner"
                        android:layout_alignParentLeft="true"
                        android:layout_marginLeft="6dp"
                        android:layout_marginTop="4dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/avatar_placeholder" />

                    <!-- User Information Details -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@id/preview_photo"
                        android:layout_below="@id/front_banner"
                        android:layout_marginLeft="12dp"
                        android:layout_marginTop="4dp"
                        android:orientation="vertical">

                        <!-- Name -->
                        <TextView
                            android:id="@+id/preview_lbl_name_hindi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="नाम:"
                            android:textColor="#555555"
                            android:textSize="9sp" />
                        <TextView
                            android:id="@+id/preview_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rahul Kumar"
                            android:textColor="#000000"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="2dp"/>

                        <!-- DOB -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="जन्म तिथि / DOB: "
                                android:textColor="#555555"
                                android:textSize="10sp" />
                            <TextView
                                android:id="@+id/preview_dob"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="01/01/1995"
                                android:textColor="#000000"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Gender -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="2dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="पुरुष / Male"
                                android:id="@+id/preview_gender"
                                android:textColor="#000000"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- Bottom Aadhaar Number Representation -->
                    <TextView
                        android:id="@+id/preview_aadhaar_front"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_marginBottom="22dp"
                        android:gravity="center_horizontal"
                        android:text="1234 5678 9012"
                        android:textColor="#092F62"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <!-- Bottom Tricolor Tagline Banner -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="18dp"
                        android:layout_alignParentBottom="true"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="#F0F0F0">
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="2dp"
                            android:background="#FF9933" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="मेरा आधार, मेरी पहचान"
                            android:textColor="#000000"
                            android:textSize="9sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </RelativeLayout>

                <!-- Divider between Cards -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:background="#FFFFFF" />

                <!-- BACK CARD -->
                <RelativeLayout
                    android:layout_width="340dp"
                    android:layout_height="215dp"
                    android:background="@drawable/card_border"
                    android:padding="8dp">

                    <!-- Tricolor Header Bar -->
                    <LinearLayout
                        android:id="@+id/back_tricolor"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:orientation="horizontal">
                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="#FF9933" />
                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="#FFFFFF" />
                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="#128807" />
                    </LinearLayout>

                    <!-- Top Authority Banner -->
                    <LinearLayout
                        android:id="@+id/back_banner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/back_tricolor"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="4dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="भारतीय विशिष्ट पहचान प्राधिकरण"
                            android:textColor="#092F62"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="UNIQUE IDENTIFICATION AUTHORITY OF INDIA"
                            android:textColor="#555555"
                            android:textSize="8sp" />
                    </LinearLayout>

                    <!-- Back Content Section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/back_banner"
                        android:orientation="horizontal"
                        android:layout_marginTop="6dp"
                        android:paddingLeft="4dp"
                        android:paddingRight="4dp">

                        <!-- Address Info -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.3"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="पता / Address:"
                                android:textColor="#555555"
                                android:textSize="9sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/preview_address"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="S/O: Suresh Kumar, House No. 42, Sector 15, Dwarka, New Delhi - 110075"
                                android:textColor="#000000"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <!-- Mock QR/Barcode Panel on Right -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.8"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:layout_marginLeft="6dp">

                            <ImageView
                                android:id="@+id/preview_qr_code"
                                android:layout_width="70dp"
                                android:layout_height="70dp"
                                android:scaleType="fitCenter" />

                            <ImageView
                                android:id="@+id/preview_barcode"
                                android:layout_width="90dp"
                                android:layout_height="25dp"
                                android:scaleType="fitXY"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- Bottom Aadhaar Number Representation -->
                    <TextView
                        android:id="@+id/preview_aadhaar_back"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_marginBottom="22dp"
                        android:gravity="center_horizontal"
                        android:text="1234 5678 9012"
                        android:textColor="#092F62"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <!-- Safe bottom disclaimer note instead of legal tagline -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="18dp"
                        android:layout_alignParentBottom="true"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="#F0F0F0">
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="2dp"
                            android:background="#128807" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NOT A LEGAL DOCUMENT - TEMPLATE FOR DEMO USE ONLY"
                            android:textColor="#D32F2F"
                            android:textSize="7sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </RelativeLayout>

            </LinearLayout>

            <!-- EXPORT ACTION BUTTON -->
            <Button
                android:id="@+id/btn_download_card"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="Download Aadhaar Card / कार्ड डाउनलोड करें"
                android:textColor="#FFFFFF"
                android:background="#092F62"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>