<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05050A">

    <!-- Primary Game Custom Canvas Rendering View -->
    <com.retrobrickbreaker.app.GameView
        android:id="@+id/game_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Status Bar & HUD -->
    <RelativeLayout
        android:id="@+id/hud_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="20dp"
        android:paddingTop="16dp"
        android:paddingRight="20dp"
        android:paddingBottom="16dp"
        android:layout_alignParentTop="true">

        <TextView
            android:id="@+id/tv_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SCORE: 0000"
            android:textColor="#00FFCC"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tv_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:text="LEVEL: 1"
            android:textColor="#FFFF00"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tv_lives"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:text="LIVES: ❤❤❤"
            android:textColor="#FF3366"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />
    </RelativeLayout>

    <!-- Floating Card Overlay for Welcome / Start State -->
    <LinearLayout
        android:id="@+id/overlay_start"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RETRO"
            android:textColor="#FF3366"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.25" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="BRICK BREAKER"
            android:textColor="#00FFCC"
            android:textSize="32sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:gravity="center"
            android:shadowColor="#00FFCC"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="15" />

        <TextView
            android:id="@+id/tv_high_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="HIGH SCORE: 0"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:fontFamily="monospace" />

        <View
            android:layout_width="140dp"
            android:layout_height="2dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:background="#33FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CONTROLS:\n• DRAG PADDLE TO BOUNCE BALL\n• DESTROY ALL BRICKS TO WIN\n• CATCH GLOWING POWER-UPS"
            android:textColor="#BBBBBB"
            android:textSize="12sp"
            android:lineSpacingExtra="6dp"
            android:gravity="left"
            android:fontFamily="monospace" />

        <Button
            android:id="@+id/btn_play"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="32dp"
            android:text="START GAME"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />
            
        <Button
            android:id="@+id/btn_toggle_sound"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="SOUND: ON"
            android:textSize="13sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- Floating Card Overlay for Game Over / Win State -->
    <LinearLayout
        android:id="@+id/overlay_game_over"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_game_result_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GAME OVER"
            android:textColor="#FF3366"
            android:textSize="36sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:shadowColor="#FF3366"
            android:shadowRadius="15" />

        <TextView
            android:id="@+id/tv_final_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="FINAL SCORE: 0000"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tv_new_record"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="⚡ NEW RECORD! ⚡"
            android:textColor="#FFFF00"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_retry"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="32dp"
            android:text="PLAY AGAIN"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />
    </LinearLayout>
</RelativeLayout>