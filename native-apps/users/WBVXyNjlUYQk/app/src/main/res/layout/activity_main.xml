<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F5132"
    android:padding="12dp">

    <!-- Header Panel -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DICE MASTER PRO"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sensor_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shake to Roll: Enabled"
                android:textColor="#A2E9C1"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_toggle_sound"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:background="@drawable/button_selector"
            android:text="🔊"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />
    </RelativeLayout>

    <!-- Navigation Tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/tab_solo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginRight="4dp"
            android:background="@drawable/tab_button_selector"
            android:text="Classic Solo"
            android:textColor="#212121"
            android:textStyle="bold" />

        <Button
            android:id="@+id/tab_duel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginRight="4dp"
            android:background="@drawable/tab_button_selector"
            android:text="Dice Duel"
            android:textColor="#212121"
            android:textStyle="bold" />

        <Button
            android:id="@+id/tab_stats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/tab_button_selector"
            android:text="Stats &amp; Settings"
            android:textColor="#212121"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- 1. SOLO ROLL VIEW -->
            <LinearLayout
                android:id="@+id/layout_solo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Controls -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/card_background"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Number of Dice: "
                        android:textColor="#212121"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spinner_dice_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp" />
                </LinearLayout>

                <!-- Dynamic Visual Dice Area -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/card_background"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <!-- Row 1: Dice 1, 2, 3 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginBottom="10dp">

                        <!-- Include Die 1 -->
                        <RelativeLayout
                            android:id="@+id/die_1"
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:layout_margin="6dp"
                            android:background="@drawable/die_background"
                            android:padding="8dp">
                            <View android:id="@+id/die_1_dot_1" android:layout_width="10dp" android:layout_height="10dp" android:layout_alignParentLeft="true" android:layout_alignParentTop="true" android:background="@drawable/dot_shape" />
                            <View android:id="@+id/die_1_dot_2" android:layout_width="10dp" android:layout_height="10dp" android:layout_centerHorizontal="true" android:layout_alignParentTop="true" android:background="@drawable/dot_shape" />
                            <View android:id="@+id/die_1_dot_3" android:layout_width="10dp" android:layout_height="10dp" android:layout_alignParentRight="true" android:layout_alignParentTop="true" android:background="@drawable/dot_shape" />
                            <View android:id="@+id/die_1_dot_4" android:layout_width="10dp" android:layout_height="10dp" android:layout_alignParentLeft="true" android:layout_centerVertical="true" android:background="@drawable/dot_shape" />
                            <View android:id="@+id/die_1_dot_5" android:layout_width="10dp" android:layout_height="10dp" android:layout_centerInParent="true" android:background="@drawable/dot_shape" />
                            <View android:id="@+id/die_1_dot_6" android:layout_width="10dp" android:layout_height="10dp" android:layout_alignParentRight="true" android:layout_centerVertical="true" android:background="@drawable/dot_shape" />
                            <View android:id="@+id/die_1_dot_7" android:layout_width="10dp" android:layout_height="10dp" android:layout_alignParentLeft="true" android:layout_alignParentBottom="true" android:background="@drawable/dot_shape" />
                            <View android:id="@+id/die_1_dot_8" android:layout_width="10dp" android:layout_height="10dp" android:layout_centerHorizontal="true" android:layout_alignParentBottom="true" android:background="@drawable/dot_shape" />
                            <View android:id="@+id/die_1_dot_9" android:layout_width="10dp" android:layout_height="10dp" android:layout_alignParentRight="true" android:layout_alignParentBottom="true" android:background="@drawable/dot_shape" />
                        </RelativeLayout>

                        <!-- Include Die 2 -->
                        <RelativeLayout
                            android:id="@+id/die_2"
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:layout_margin="6dp"
                            android:background="@drawable/die_background"
                            android:padding="8dp">
                            <View android:id="@+id/die_2_dot_1" android:layout_width="10dp" android:layout_height="10dp" android:layout_alignParentLeft="true" android:layout_alignParentTop="true" android:background="@drawable/dot_shape" />
                            <View android:id="@+id/die_2_dot_2" android:layout_width="10dp" android:layout_height="10dp" android:layout_centerHorizontal="true" android:layout_alignParentTop="true" android:background="@drawable/dot_shape" />
                            <View android:id="@+id/die_2_dot_3" android:layout_width="10dp" android:layout_height="10dp" android:layout_alignParentRight="true" android:layout_alignParentTop="true" android:background="@drawable/dot_shape" />
                            <View android:id="@+id/die_2_dot_4" android:layout_width="10dp" android:layout_height="10dp" android:layout_alignParentLeft="true" android:layout_centerVertical="true" android:background="@drawable/dot_shape" />
                            <View android:id="@+id/die_2_dot_5" android:layout_width="10dp" android:layout_height="10dp" android:layout_centerInParent="true" android:background="@drawable/dot_shape" />
                            <View android:id="@+id/die_2_dot_6" android:layout_width="10dp" android:layout_height="10dp" android:layout_alignParentRight="true" android:layout_centerVertical="true" android:background="@drawable/dot_shape" />
                            <View android:id="@+id/die_2_dot_7" android:layout_width="10dp" android:layout_height="10dp" android:layout_alignParentLeft="true" android:layout_alignParentBottom="true" android:background="@drawable/dot_shape" />
                            <View android:id="@+id/die_2_dot_8" android:layout_width="10dp" android:layout_height="10dp" android:layout_centerHorizontal="true" android:layout_alignParentBottom="true" android:background="@drawable/dot_shape" />
                            <View android:id="@+id/die_2_dot_9" android:layout_width="10dp" android:layout_height="10dp" android:layout_alignParentRight="true" android:layout_alignParentBottom="true" android:background="@drawable/dot_shape" />
                        </RelativeLayout>

                        <!-- Include Die 3 -->
                        <RelativeLayout
                            android:id="@+id/die_3"
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:layout_margin="6dp"
                            android:background="@drawable/die_background"
                            android:padding="8dp">
                            <View android:id="@+id/die_3_dot_1" android:layout_width="10dp" android:layout_height="10dp" android:layout_alignParentLeft="true" android:layout_alignParentTop="true" android:background="@drawable/dot_shape" />
                            <View android:id="@+id/die_3_dot_2" android:layout_width="10dp" android:layout_height="10dp" android:layout_centerHorizontal="true" android:layout_alignParentTop="true" android:background="@drawable/dot_shape" />
                            <View android:id="@+id/die_3_dot_3" android:layout_width="10dp" android:layout_height="10dp" android:layout_alignParentRight="true" android:layout_alignParentTop="true" android:background="@drawable/dot_shape" />
                            <View android:id="@+id/die_3_dot_4" android:layout_width="10dp" android:layout_height="10dp" android:layout_alignParentLeft="true" android:layout_centerVertical="true" android:background="@drawable/dot_shape" />
                            <View android:id="@+id/die_3_dot_5" android:layout_width="10dp" android:layout_height="10dp" android:layout_centerInParent="true" android:background="@drawable/dot_shape" />
                            <View android:id="@+id/die_3_dot_6" android:layout_width="10dp" android:layout_height="10dp" android:layout_alignParentRight="true" android:layout_centerVertical="true" android:background="@drawable/dot_shape" />
                            <View android:id="@+id/die_3_dot_7" android:layout_width="10dp" android:layout_height="10dp" android:layout_alignParentLeft="true" android:layout_alignParentBottom="true" android:background="@drawable/dot_shape" />
                            <View android:id="@+id/die_3_dot_8" android:layout_width="10dp" android:layout_height="10dp" android:layout_centerHorizontal="true" android:layout_alignParentBottom="true" android:background="@drawable/dot_shape" />
                            <View android:id="@+id/die_3_dot_9" android:layout_width="10dp" android:layout_height="10dp" android:layout_alignParentRight="true" android:layout_alignParentBottom="true" android:background="@drawable/dot_shape" />
                        </RelativeLayout>
                    </LinearLayout>

                    <!-- Row 2: Dice 4, 5 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <!-- Include Die 4 -->
                        <RelativeLayout
                            android:id="@+id/die_4"
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:layout_margin="6dp"
                            android:background="@drawable/die_background"
                            android:padding="8dp">
                            <View android:id="@+id/die_4_dot_1" android:layout_width="10dp" android:layout_height="10dp" android:layout_alignParentLeft="true" android:layout_alignParentTop="true" android:background="@drawable/dot_shape" />
                            <View android:id="@+id/die_4_dot_2" android:layout_width="10dp" android:layout_height="10dp" android:layout_centerHorizontal="true" android:layout_alignParentTop="true" android:background="@drawable/dot_shape" />
                            <View android:id="@+id/die_4_dot_3" android:layout_width="10dp" android:layout_height="10dp" android:layout_alignParentRight="true" android:layout_alignParentTop="true" android:background="@drawable/dot_shape" />
                            <View android:id="@+id/die_4_dot_4" android:layout_width="10dp" android:layout_height="10dp" android:layout_alignParentLeft="true" android:layout_centerVertical="true" android:background="@drawable/dot_shape" />
                            <View android:id="@+id/die_4_dot_5" android:layout_width="10dp" android:layout_height="10dp" android:layout_centerInParent="true" android:background="@drawable/dot_shape" />
                            <View android:id="@+id/die_4_dot_6" android:layout_width="10dp" android:layout_height="10dp" android:layout_alignParentRight="true" android:layout_centerVertical="true" android:background="@drawable/dot_shape" />
                            <View android:id="@+id/die_4_dot_7" android:layout_width="10dp" android:layout_height="10dp" android:layout_alignParentLeft="true" android:layout_alignParentBottom="true" android:background="@drawable/dot_shape" />
                            <View android:id="@+id/die_4_dot_8" android:layout_width="10dp" android:layout_height="10dp" android:layout_centerHorizontal="true" android:layout_alignParentBottom="true" android:background="@drawable/dot_shape" />
                            <View android:id="@+id/die_4_dot_9" android:layout_width="10dp" android:layout_height="10dp" android:layout_alignParentRight="true" android:layout_alignParentBottom="true" android:background="@drawable/dot_shape" />
                        </RelativeLayout>

                        <!-- Include Die 5 -->
                        <RelativeLayout
                            android:id="@+id/die_5"
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:layout_margin="6dp"
                            android:background="@drawable/die_background"
                            android:padding="8dp">
                            <View android:id="@+id/die_5_dot_1" android:layout_width="10dp" android:layout_height="10dp" android:layout_alignParentLeft="true" android:layout_alignParentTop="true" android:background="@drawable/dot_shape" />
                            <View android:id="@+id/die_5_dot_2" android:layout_width="10dp" android:layout_height="10dp" android:layout_centerHorizontal="true" android:layout_alignParentTop="true" android:background="@drawable/dot_shape" />
                            <View android:id="@+id/die_5_dot_3" android:layout_width="10dp" android:layout_height="10dp" android:layout_alignParentRight="true" android:layout_alignParentTop="true" android:background="@drawable/dot_shape" />
                            <View android:id="@+id/die_5_dot_4" android:layout_width="10dp" android:layout_height="10dp" android:layout_alignParentLeft="true" android:layout_centerVertical="true" android:background="@drawable/dot_shape" />
                            <View android:id="@+id/die_5_dot_5" android:layout_width="10dp" android:layout_height="10dp" android:layout_centerInParent="true" android:background="@drawable/dot_shape" />
                            <View android:id="@+id/die_5_dot_6" android:layout_width="10dp" android:layout_height="10dp" android:layout_alignParentRight="true" android:layout_centerVertical="true" android:background="@drawable/dot_shape" />
                            <View android:id="@+id/die_5_dot_7" android:layout_width="10dp" android:layout_height="10dp" android:layout_alignParentLeft="true" android:layout_alignParentBottom="true" android:background="@drawable/dot_shape" />
                            <View android:id="@+id/die_5_dot_8" android:layout_width="10dp" android:layout_height="10dp" android:layout_centerHorizontal="true" android:layout_alignParentBottom="true" android:background="@drawable/dot_shape" />
                            <View android:id="@+id/die_5_dot_9" android:layout_width="10dp" android:layout_height="10dp" android:layout_alignParentRight="true" android:layout_alignParentBottom="true" android:background="@drawable/dot_shape" />
                        </RelativeLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_roll_sum"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Score: Roll to Begin"
                        android:textColor="#212121"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_roll_solo"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/button_selector"
                    android:text="ROLL DICE!"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Solo Stats Panel -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_background"
                    android:padding="12dp"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Solo History Log"
                        android:textColor="#212121"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_solo_history"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No rolls yet."
                        android:textColor="#555555"
                        android:textSize="13sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 2. DICE DUEL VIEW -->
            <LinearLayout
                android:id="@+id/layout_duel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Mode Selector -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/card_background"
                    android:padding="8dp"
                    android:layout_marginBottom="12dp">

                    <Button
                        android:id="@+id/btn_mode_battle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Roll Battle"
                        android:layout_marginRight="4dp"
                        android:background="@drawable/button_selector"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/btn_mode_pig"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Pig Game"
                        android:background="@drawable/button_selector"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

                <!-- Duel Match Status Board -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_background"
                    android:padding="16dp"
                    android:gravity="center_horizontal"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/tv_game_mode_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MODE: ROLL BATTLE"
                        android:textColor="#757575"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_turn_indicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Player 1's Turn"
                        android:textColor="#D32F2F"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="12dp" />

                    <!-- Scores layout -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Player 1"
                                android:textColor="#212121"
                                android:textSize="14sp" />
                            <TextView
                                android:id="@+id/tv_p1_score"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="#2E7D32"
                                android:textSize="28sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="40dp"
                            android:background="#DDDDDD" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Player 2"
                                android:textColor="#212121"
                                android:textSize="14sp" />
                            <TextView
                                android:id="@+id/tv_p2_score"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="#2E7D32"
                                android:textSize="28sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Turn Pending points for Pig Game -->
                    <TextView
                        android:id="@+id/tv_turn_points"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Turn points: 0"
                        android:textColor="#E65100"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <!-- Single Active Die for Pig/Duel mode -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:background="@drawable/card_background"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <RelativeLayout
                        android:id="@+id/duel_die"
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:background="@drawable/die_background"
                        android:padding="10dp">
                        <View android:id="@+id/duel_die_dot_1" android:layout_width="12dp" android:layout_height="12dp" android:layout_alignParentLeft="true" android:layout_alignParentTop="true" android:background="@drawable/dot_shape" />
                        <View android:id="@+id/duel_die_dot_2" android:layout_width="12dp" android:layout_height="12dp" android:layout_centerHorizontal="true" android:layout_alignParentTop="true" android:background="@drawable/dot_shape" />
                        <View android:id="@+id/duel_die_dot_3" android:layout_width="12dp" android:layout_height="12dp" android:layout_alignParentRight="true" android:layout_alignParentTop="true" android:background="@drawable/dot_shape" />
                        <View android:id="@+id/duel_die_dot_4" android:layout_width="12dp" android:layout_height="12dp" android:layout_alignParentLeft="true" android:layout_centerVertical="true" android:background="@drawable/dot_shape" />
                        <View android:id="@+id/duel_die_dot_5" android:layout_width="12dp" android:layout_height="12dp" android:layout_centerInParent="true" android:background="@drawable/dot_shape" />
                        <View android:id="@+id/duel_die_dot_6" android:layout_width="12dp" android:layout_height="12dp" android:layout_alignParentRight="true" android:layout_centerVertical="true" android:background="@drawable/dot_shape" />
                        <View android:id="@+id/duel_die_dot_7" android:layout_width="12dp" android:layout_height="12dp" android:layout_alignParentLeft="true" android:layout_alignParentBottom="true" android:background="@drawable/dot_shape" />
                        <View android:id="@+id/duel_die_dot_8" android:layout_width="12dp" android:layout_height="12dp" android:layout_centerHorizontal="true" android:layout_alignParentBottom="true" android:background="@drawable/dot_shape" />
                        <View android:id="@+id/duel_die_dot_9" android:layout_width="12dp" android:layout_height="12dp" android:layout_alignParentRight="true" android:layout_alignParentBottom="true" android:background="@drawable/dot_shape" />
                    </RelativeLayout>
                </RelativeLayout>

                <!-- Action Controls -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_duel_roll"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginRight="6dp"
                        android:background="@drawable/button_selector"
                        android:text="ROLL"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_duel_hold"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_selector"
                        android:text="HOLD / SAVE"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Battle Status Board Log -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_background"
                    android:padding="12dp"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Battle Feed Log"
                        android:textColor="#212121"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_duel_log"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Select a game mode above and click ROLL to begin match!"
                        android:textColor="#424242"
                        android:textSize="13sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 3. STATS & SETTINGS VIEW -->
            <LinearLayout
                android:id="@+id/layout_stats"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Overall Stats Frame -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_background"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LIFETIME DICE STATISTICS"
                        android:textColor="#1B5E20"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/stat_total_rolls"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Lifetime Rolls: 0"
                        android:textColor="#212121"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/stat_highest_roll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Highest Sum Rolled: 0"
                        android:textColor="#212121"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/stat_roll_frequency"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1s: 0  |  2s: 0  |  3s: 0  |  4s: 0  |  5s: 0  |  6s: 0"
                        android:textColor="#555555"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Shake Customizer Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_background"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MOTION SENSOR CONTROLS"
                        android:textColor="#1B5E20"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <CheckBox
                        android:id="@+id/cb_shake_to_roll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Enable Shake-to-Roll"
                        android:checked="true"
                        android:textColor="#212121"
                        android:layout_marginTop="6dp" />

                    <TextView
                        android:id="@+id/tv_shake_sensitivity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Shake Sensitivity Threshold: Medium (16)"
                        android:textColor="#212121"
                        android:textSize="13sp"
                        android:layout_marginTop="8dp" />

                    <SeekBar
                        android:id="@+id/sb_shake_sensitivity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:max="20"
                        android:progress="10" />
                </LinearLayout>

                <!-- Board Style Selector Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_background"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DICE BOARD STYLE COLORS"
                        android:textColor="#1B5E20"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/theme_casino_green"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginRight="4dp"
                            android:background="@drawable/button_selector"
                            android:text="Green Table"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/theme_indigo"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginRight="4dp"
                            android:background="@drawable/button_selector"
                            android:text="Indigo Navy"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/theme_charcoal"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:background="@drawable/button_selector"
                            android:text="Charcoal"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Reset Board Panel -->
                <Button
                    android:id="@+id/btn_reset_stats"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/button_selector"
                    android:text="Reset Global Stats"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
    </ScrollView>
</LinearLayout>