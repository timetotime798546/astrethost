<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#090D16"
    android:padding="16dp">

    <!-- Header Section -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true">

            <TextView
                android:id="@+id/app_title_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Simple Tap Counter"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="0.02" />

            <TextView
                android:id="@+id/app_subtitle_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ultra-Precision Utility Matrix"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:layout_marginTop="2dp"
                android:letterSpacing="0.05" />
        </LinearLayout>

        <TextView
            android:id="@+id/high_score_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="#1E293B"
            android:text="BEST: 0"
            android:textColor="#F59E0B"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:letterSpacing="0.05" />
    </RelativeLayout>

    <!-- Channel Matrix Switcher Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CHANNEL SELECTION MATRIX"
            android:textColor="#475569"
            android:textSize="9sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"
            android:letterSpacing="0.1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_chan_0"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="CH. ALPHA"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_chan_1"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="CH. BETA"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginEnd="4dp"
                android:layout_marginStart="4dp" />

            <Button
                android:id="@+id/btn_chan_2"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="CH. GAMMA"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginStart="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Stats Dashboard Card -->
    <LinearLayout
        android:id="@+id/stats_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginBottom="12dp"
        android:gravity="center">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp">

            <TextView
                android:id="@+id/label_tally"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:text="CURRENT MATRIX TALLY"
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />
        </RelativeLayout>

        <TextView
            android:id="@+id/counter_display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="58sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp"
            android:gravity="center">

            <TextView
                android:id="@+id/step_size_display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Incrementing by +1"
                android:textColor="#3B82F6"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:layout_width="1dp"
                android:layout_height="12dp"
                android:background="#33FFFFFF"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/goal_display_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GOAL: NONE"
                android:textColor="#F59E0B"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Tap Target Area Container with dynamic frame ID -->
    <FrameLayout
        android:id="@+id/tap_container_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:layout_marginBottom="12dp">

        <!-- Flashing overlay used for goal celebration triggers -->
        <View
            android:id="@+id/goal_celebration_flash"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#00000000"
            android:visibility="gone" />

        <RelativeLayout
            android:id="@+id/tap_circle_button"
            android:layout_width="170dp"
            android:layout_height="170dp"
            android:layout_gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:elevation="6dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_centerInParent="true"
                android:gravity="center">

                <TextView
                    android:id="@+id/tap_action_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TAP"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.25" />

                <TextView
                    android:id="@+id/tap_action_sublabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TO COUNT"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp"
                    android:letterSpacing="0.1" />
            </LinearLayout>
        </RelativeLayout>
    </FrameLayout>

    <!-- Controls & Step Selector Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STEP CONFIGURATION"
            android:textColor="#475569"
            android:textSize="9sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"
            android:letterSpacing="0.1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_step_1"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="+1"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_step_5"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="+5"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginEnd="2dp"
                android:layout_marginStart="2dp" />

            <Button
                android:id="@+id/btn_step_10"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="+10"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginEnd="2dp"
                android:layout_marginStart="2dp" />

            <Button
                android:id="@+id/btn_step_minus"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="-1"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginStart="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- EXPANDED ADVANCED LAB PANEL (Auto-Pulse, Waveform, Goal Targets) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SYNTHESIZER LAB &amp; AUTOMATION ENGINE"
            android:textColor="#475569"
            android:textSize="9sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"
            android:letterSpacing="0.1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_lab_autopulse"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1.2"
                android:text="PULSE: OFF"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_lab_waveform"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1.1"
                android:text="WAVE: SINE"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginEnd="2dp"
                android:layout_marginStart="2dp" />

            <Button
                android:id="@+id/btn_lab_pitch"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="0.9"
                android:text="PITCH: MID"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginEnd="2dp"
                android:layout_marginStart="2dp" />

            <Button
                android:id="@+id/btn_lab_goal"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1.1"
                android:text="GOAL: NONE"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginStart="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Action Bar Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btn_action_reset"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="RESET"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="12sp"
            android:letterSpacing="0.05"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn_action_theme"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1.1"
            android:text="THEME CYCLE"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="12sp"
            android:letterSpacing="0.05"
            android:layout_marginEnd="2dp"
            android:layout_marginStart="2dp" />

        <Button
            android:id="@+id/btn_action_haptic"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="SOUND: ON"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="12sp"
            android:letterSpacing="0.05"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- History Log Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LAB TIMELINE METRIC FEED"
            android:textColor="#475569"
            android:textSize="9sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"
            android:letterSpacing="0.1" />

        <ScrollView
            android:id="@+id/history_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical"
            android:fadeScrollbars="true">

            <LinearLayout
                android:id="@+id/history_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="2dp" />
        </ScrollView>
    </LinearLayout>

</LinearLayout>