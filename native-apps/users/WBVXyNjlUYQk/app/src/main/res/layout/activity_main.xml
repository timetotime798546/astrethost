<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F1F5F9">

    <!-- Header Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#6200EE"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Randomizer Pro"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Navigation Tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#CBD5E1"
        android:orientation="horizontal"
        android:padding="2dp">

        <Button
            android:id="@+id/btn_tab_number"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:text="Numbers"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:textStyle="bold"
            android:background="#6200EE"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn_tab_dice"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:text="Dice"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:textStyle="bold"
            android:background="#CBD5E1"
            android:textColor="#334155" />

        <Button
            android:id="@+id/btn_tab_coin"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:text="Coin"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:textStyle="bold"
            android:background="#CBD5E1"
            android:textColor="#334155" />

        <Button
            android:id="@+id/btn_tab_history"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:text="History"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:textStyle="bold"
            android:background="#CBD5E1"
            android:textColor="#334155" />
    </LinearLayout>

    <!-- Main Content Containers -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 1. NUMBER PANEL -->
        <ScrollView
            android:id="@+id/layout_number"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- CARD: Single Generator -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_bg"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Single Random Number"
                        android:textSize="16sp"
                        android:textColor="#6200EE"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <!-- Input Ranges -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginRight="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Min Value"
                                android:textSize="12sp"
                                android:textColor="#64748B"
                                android:layout_marginBottom="4dp" />

                            <EditText
                                android:id="@+id/et_single_min"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:background="@drawable/edit_text_bg"
                                android:inputType="numberSigned"
                                android:paddingLeft="12dp"
                                android:text="1"
                                android:textSize="14sp"
                                android:textColor="#0F172A" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginLeft="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Max Value"
                                android:textSize="12sp"
                                android:textColor="#64748B"
                                android:layout_marginBottom="4dp" />

                            <EditText
                                android:id="@+id/et_single_max"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:background="@drawable/edit_text_bg"
                                android:inputType="numberSigned"
                                android:paddingLeft="12dp"
                                android:text="100"
                                android:textSize="14sp"
                                android:textColor="#0F172A" />
                        </LinearLayout>
                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_generate_single"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/button_bg"
                        android:text="Generate Number"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp" />

                    <!-- Big Single Display -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:background="#F8FAFC">

                        <TextView
                            android:id="@+id/txt_single_result"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textColor="#1E293B"
                            android:textSize="54sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- CARD: Multiple Generator -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_bg"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Multiple Random Numbers"
                        android:textSize="16sp"
                        android:textColor="#6200EE"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <!-- Inputs -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginRight="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Min"
                                android:textSize="12sp"
                                android:textColor="#64748B"
                                android:layout_marginBottom="4dp" />

                            <EditText
                                android:id="@+id/et_multi_min"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:background="@drawable/edit_text_bg"
                                android:inputType="numberSigned"
                                android:paddingLeft="12dp"
                                android:text="1"
                                android:textSize="14sp"
                                android:textColor="#0F172A" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginLeft="4dp"
                            android:layout_marginRight="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Max"
                                android:textSize="12sp"
                                android:textColor="#64748B"
                                android:layout_marginBottom="4dp" />

                            <EditText
                                android:id="@+id/et_multi_max"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:background="@drawable/edit_text_bg"
                                android:inputType="numberSigned"
                                android:paddingLeft="12dp"
                                android:text="100"
                                android:textSize="14sp"
                                android:textColor="#0F172A" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginLeft="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Count"
                                android:textSize="12sp"
                                android:textColor="#64748B"
                                android:layout_marginBottom="4dp" />

                            <EditText
                                android:id="@+id/et_multi_count"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:background="@drawable/edit_text_bg"
                                android:inputType="number"
                                android:paddingLeft="12dp"
                                android:text="5"
                                android:textSize="14sp"
                                android:textColor="#0F172A" />
                        </LinearLayout>
                    </LinearLayout>

                    <CheckBox
                        android:id="@+id/cb_no_duplicates"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No Duplicates"
                        android:textSize="14sp"
                        android:textColor="#334155"
                        android:layout_marginBottom="12dp"
                        android:checked="true" />

                    <Button
                        android:id="@+id/btn_generate_multi"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/button_bg"
                        android:text="Generate List"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp" />

                    <!-- Multi Result Output -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Results:"
                        android:textSize="12sp"
                        android:textColor="#64748B"
                        android:layout_marginBottom="4dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#F8FAFC"
                        android:padding="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txt_multi_result"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Click generate to view list..."
                            android:textColor="#334155"
                            android:textSize="16sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- 2. DICE PANEL -->
        <LinearLayout
            android:id="@+id/layout_dice"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dice Rolling Simulator"
                    android:textSize="16sp"
                    android:textColor="#6200EE"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <RadioGroup
                    android:id="@+id/rg_dice_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="24dp">

                    <RadioButton
                        android:id="@+id/rb_1_die"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="1 Die"
                        android:checked="true"
                        android:textColor="#334155" />

                    <RadioButton
                        android:id="@+id/rb_2_dice"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="2 Dice"
                        android:textColor="#334155" />

                    <RadioButton
                        android:id="@+id/rb_3_dice"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="3 Dice"
                        android:textColor="#334155" />
                </RadioGroup>

                <!-- Dice Views Container -->
                <LinearLayout
                    android:id="@+id/dice_views_container"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_marginBottom="24dp"
                    android:background="#F8FAFC"
                    android:padding="8dp" />

                <TextView
                    android:id="@+id/txt_dice_total"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Total Sum: 1"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1E293B"
                    android:gravity="center"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/btn_roll_dice"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/button_bg"
                    android:text="Roll Dice"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 3. COIN PANEL -->
        <LinearLayout
            android:id="@+id/layout_coin"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="16dp"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Coin Flipper Simulator"
                    android:textSize="16sp"
                    android:textColor="#6200EE"
                    android:textStyle="bold"
                    android:layout_marginBottom="24dp" />

                <!-- The Gold / Silver Coin TextView -->
                <TextView
                    android:id="@+id/coin_view"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:background="@drawable/coin_gold_bg"
                    android:gravity="center"
                    android:text="FLIP"
                    android:textColor="#7A5900"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="32dp" />

                <Button
                    android:id="@+id/btn_flip_coin"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/button_bg"
                    android:text="Flip Coin"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 4. HISTORY PANEL -->
        <LinearLayout
            android:id="@+id/layout_history"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Generation Log"
                        android:textSize="16sp"
                        android:textColor="#6200EE"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_clear_history"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/button_secondary_bg"
                        android:text="Clear Log"
                        android:textColor="#0F172A"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp" />
                </LinearLayout>

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="#F8FAFC"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/txt_history_log"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="History is empty..."
                        android:textColor="#475569"
                        android:textSize="14sp"
                        android:lineSpacingMultiplier="1.3" />
                </ScrollView>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>