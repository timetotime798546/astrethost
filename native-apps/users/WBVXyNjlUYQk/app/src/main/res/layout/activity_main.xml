<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0915"
    android:weightSum="10">

    <!-- Mystical Title Banner -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#18162D"
        android:padding="8dp">

        <TextView
            android:id="@+id/app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="✨ MAGIC SPELLBOOK ✨"
            android:textColor="#FFE082"
            android:textSize="22sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Tab Selection Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:background="#121024"
        android:padding="4dp">

        <Button
            android:id="@+id/btn_tab_wand"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="#4A154B"
            android:text="Wand"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/btn_tab_spells"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="#18162D"
            android:text="Spells"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/btn_tab_potion"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="#18162D"
            android:text="Potion"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/btn_tab_oracle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="#18162D"
            android:text="Oracle"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textAllCaps="false"/>
    </LinearLayout>

    <!-- Dynamic Content Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="8">

        <!-- 1. Magic Wand Tab -->
        <LinearLayout
            android:id="@+id/layout_tab_wand"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="visible"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Wand of Sparkles"
                android:textColor="#00E5FF"
                android:textSize="18sp"
                android:gravity="center"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wand_desc"
                android:textColor="#B0BEC5"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginBottom="16dp"/>

            <!-- Custom magical particle drawing screen -->
            <com.magicspellbook.app.MagicWandView
                android:id="@+id/magic_wand_canvas"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#05040B"/>
        </LinearLayout>

        <!-- 2. Spellbook Tab -->
        <ScrollView
            android:id="@+id/layout_tab_spells"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ancient Grimoire Spells"
                    android:textColor="#FFD600"
                    android:textSize="18sp"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"/>

                <!-- Spell Card 1: Lumos -->
                <LinearLayout
                    android:id="@+id/spell_lumos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#18162D"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔆 Lumos Maxima"
                        android:textColor="#FFD600"
                        android:textSize="16sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Casts an intense bright white visual flare on screen. Tap to conjure."
                        android:textColor="#CFD8DC"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <!-- Spell Card 2: Pyrokinesis -->
                <LinearLayout
                    android:id="@+id/spell_pyro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#18162D"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔥 Pyrokinesis Flame"
                        android:textColor="#FF1744"
                        android:textSize="16sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Unleashes rapid fire crackles and bursts of glowing ruby energy."
                        android:textColor="#CFD8DC"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <!-- Spell Card 3: Temporal Shift -->
                <LinearLayout
                    android:id="@+id/spell_tempest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#18162D"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚡ Lightning Tempest"
                        android:textColor="#00E5FF"
                        android:textSize="16sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Summons loud electrostatic crackles and deep flashing sky sparkles."
                        android:textColor="#CFD8DC"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <!-- Spell Card 4: Levitation -->
                <LinearLayout
                    android:id="@+id/spell_levitate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#18162D"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌀 Wingardium Leviosa"
                        android:textColor="#00E676"
                        android:textSize="16sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Creates low-gravity emerald floaters rising upwards across your view."
                        android:textColor="#CFD8DC"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- 3. Potion Mixer Tab -->
        <LinearLayout
            android:id="@+id/layout_tab_potion"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="The Alchemist Cauldron"
                android:textColor="#00E676"
                android:textSize="18sp"
                android:gravity="center"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Choose 2 ingredients to brew a magical potion:"
                android:textColor="#B0BEC5"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginBottom="16dp"/>

            <!-- Ingredients Selection Grid -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="2"
                android:layout_gravity="center"
                android:layout_marginBottom="16dp">

                <CheckBox
                    android:id="@+id/chk_phoenix_feather"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:text="🪶 Phoenix Feather"
                    android:textColor="#FFFFFF"
                    android:buttonTint="#FF1744"/>

                <CheckBox
                    android:id="@+id/chk_dragon_scale"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:text="🐉 Dragon Scale"
                    android:textColor="#FFFFFF"
                    android:buttonTint="#00E5FF"/>

                <CheckBox
                    android:id="@+id/chk_fairy_dust"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:text="✨ Fairy Dust"
                    android:textColor="#FFFFFF"
                    android:buttonTint="#FFD600"/>

                <CheckBox
                    android:id="@+id/chk_moonstone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:text="💎 Moonstone"
                    android:textColor="#FFFFFF"
                    android:buttonTint="#E040FB"/>
            </GridLayout>

            <!-- Brew Button -->
            <Button
                android:id="@+id/btn_brew"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/brew_button"
                android:background="#00E676"
                android:textColor="#0A0915"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <!-- Result Frame simulating bubbling potion -->
            <LinearLayout
                android:id="@+id/potion_cauldron"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="#18162D"
                android:gravity="center"
                android:padding="16dp">

                <TextView
                    android:id="@+id/txt_potion_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🧪 Empty Cauldron"
                    android:textColor="#CFD8DC"
                    android:textSize="16sp"
                    android:textStyle="italic"/>

                <TextView
                    android:id="@+id/txt_potion_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Select ingredients to begin synthesis."
                    android:textColor="#90A4AE"
                    android:textSize="12sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 4. Magic Oracle Tab -->
        <LinearLayout
            android:id="@+id/layout_tab_oracle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            android:gravity="center"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="The Cosmic Crystal Ball"
                android:textColor="#FFD600"
                android:textSize="18sp"
                android:gravity="center"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <!-- Crystal Ball Circle Frame -->
            <FrameLayout
                android:id="@+id/btn_oracle_sphere"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="center"
                android:background="@android:drawable/dialog_holo_dark_frame"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="20dp">

                <!-- Deep radial magic looking background inside -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#2E0854"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/txt_oracle_response"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="12dp"
                        android:text="🔮\nTAP ME"
                        android:textColor="#FFE082"
                        android:textSize="16sp"
                        android:textStyle="bold"/>
                </RelativeLayout>
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ask_oracle_hint"
                android:textColor="#90A4AE"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

    </FrameLayout>
</LinearLayout>