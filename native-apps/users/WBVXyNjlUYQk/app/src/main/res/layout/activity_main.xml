<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2196F3"
        android:orientation="vertical"
        android:padding="16dp">
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="App Debugger &amp; Diagnostic Tool"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Troubleshoot errors, view logs, and inspect metrics"
            android:textColor="#E0E0E0"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Navigation Tabs -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="#1E88E5">
        
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            
            <Button
                android:id="@+id/btn_tab_system"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SYSTEM INFO"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_tab_logcat"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LOGCAT"
                android:textColor="#B0BEC5"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_tab_diagnostics"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TESTS"
                android:textColor="#B0BEC5"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_tab_sandbox"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CRASH SANDBOX"
                android:textColor="#B0BEC5"
                android:textStyle="bold" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Main Dynamic Content Frame -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp">

        <!-- Tab 1: System Info -->
        <ScrollView
            android:id="@+id/view_system"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Device Specifications"
                    android:textColor="#333333"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/txt_system_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#FFFFFF"
                    android:padding="12dp"
                    android:textColor="#424242"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:elevation="1dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Runtime Details"
                    android:textColor="#333333"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/txt_runtime_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#FFFFFF"
                    android:padding="12dp"
                    android:textColor="#424242"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:elevation="1dp" />
            </LinearLayout>
        </ScrollView>

        <!-- Tab 2: Logcat Console -->
        <LinearLayout
            android:id="@+id/view_logcat"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <EditText
                    android:id="@+id/edt_logcat_filter"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Filter logs (e.g. Activity, Error)..."
                    android:textSize="14sp"
                    android:inputType="text" />

                <Button
                    android:id="@+id/btn_refresh_logcat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Refresh"
                    android:textSize="12sp" />
                
                <Button
                    android:id="@+id/btn_clear_logcat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Clear Screen"
                    android:textSize="12sp"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#1E1E1E"
                android:padding="8dp">

                <TextView
                    android:id="@+id/txt_logcat_output"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#00FF00"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:text="No logs gathered yet. Tap Refresh." />
            </ScrollView>
        </LinearLayout>

        <!-- Tab 3: Diagnostics / Tests -->
        <ScrollView
            android:id="@+id/view_diagnostics"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Network Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Network Connectivity Diagnostic"
                    android:textColor="#333333"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <Button
                        android:id="@+id/btn_run_network_test"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Run Network Check"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/txt_network_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="12dp"
                        android:text="Not tested"
                        android:textColor="#757575"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txt_network_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#FFFFFF"
                    android:padding="8dp"
                    android:textSize="12sp"
                    android:textColor="#616161"
                    android:layout_marginBottom="16dp" />

                <!-- Storage Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Storage Performance Test"
                    android:textColor="#333333"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <Button
                        android:id="@+id/btn_run_storage_test"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Run Storage Test"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/txt_storage_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="12dp"
                        android:text="Not tested"
                        android:textColor="#757575"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txt_storage_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#FFFFFF"
                    android:padding="8dp"
                    android:textSize="12sp"
                    android:textColor="#616161"
                    android:layout_marginBottom="16dp" />

                <!-- Permissions Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manifest Permissions Checklist"
                    android:textColor="#333333"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/txt_permission_checklist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#FFFFFF"
                    android:padding="12dp"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:textColor="#424242" />

            </LinearLayout>
        </ScrollView>

        <!-- Tab 4: Sandbox & Error Simulator -->
        <ScrollView
            android:id="@+id/view_sandbox"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Error Simulation Sandbox"
                    android:textColor="#333333"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Test how standard exceptions and crashes act on Android. We intercept crashes below so they display in a diagnostics dialog rather than just silently exiting the app!"
                    android:textColor="#757575"
                    android:textSize="12sp"
                    android:layout_marginBottom="16dp" />

                <!-- Trigger handled error -->
                <Button
                    android:id="@+id/btn_trigger_handled_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Simulate Handled Exception (Try/Catch)"
                    android:backgroundTint="#4CAF50"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="12dp" />

                <!-- Trigger null pointer -->
                <Button
                    android:id="@+id/btn_trigger_npe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Trigger NullPointerException (Interception)"
                    android:backgroundTint="#F44336"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="12dp" />

                <!-- Trigger index out of bounds -->
                <Button
                    android:id="@+id/btn_trigger_oob"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Trigger IndexOutOfBoundsException"
                    android:backgroundTint="#FF9800"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="12dp" />

                <!-- Trigger arithmetic exception -->
                <Button
                    android:id="@+id/btn_trigger_div_zero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Trigger Division by Zero"
                    android:backgroundTint="#E91E63"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="16dp" />

                <!-- Interception Log Panel -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Last Exception Caught State"
                    android:textColor="#333333"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/txt_sandbox_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#ECEFF1"
                    android:padding="12dp"
                    android:text="No exception caught in this session."
                    android:textColor="#37474F"
                    android:textSize="12sp"
                    android:fontFamily="monospace" />

            </LinearLayout>
        </ScrollView>

    </FrameLayout>

    <!-- App status bar -->
    <TextView
        android:id="@+id/txt_status_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#37474F"
        android:padding="8dp"
        android:text="App Status: Diagnostic Engine Online"
        android:textColor="#ECEFF1"
        android:textSize="11sp"
        android:gravity="center" />

</LinearLayout>