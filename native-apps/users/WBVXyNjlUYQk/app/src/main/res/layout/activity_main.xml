<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#090D16"
    android:padding="20dp">

    <!-- Header Section -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true">

            <TextView
                android:id="@+id/app_title_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Simple Tap Counter"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:letterSpacing="0.02" />

            <TextView
                android:id="@+id/app_subtitle_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ultra-Precision Utility Matrix"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:layout_marginTop="2dp"
                android:letterSpacing="0.05" />
        </LinearLayout>

        <TextView
            android:id="@+id/high_score_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="#1E293B"
            android:text="BEST: 0"
            android:textColor="#F59E0B"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:letterSpacing="0.05" />
    </RelativeLayout>

    <!-- Stats Dashboard Card -->
    <LinearLayout
        android:id="@+id/stats_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp"
        android:layout_marginBottom="20dp"
        android:gravity="center">

        <TextView
            android:id="@+id/label_tally"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CURRENT TALLY"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:id="@+id/counter_display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="72sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp"
            android:letterSpacing="-0.02" />

        <TextView
            android:id="@+id/step_size_display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Incrementing by +1"
            android:textColor="#3B82F6"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Tap Target Area Container with dynamic frame ID -->
    <FrameLayout
        android:id="@+id/tap_container_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="24dp">

        <RelativeLayout
            android:id="@+id/tap_circle_button"
            android:layout_width="210dp"
            android:layout_height="210dp"
            android:layout_gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:elevation="6dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_centerInParent="true"
                android:gravity="center">

                <TextView
                    android:id="@+id/tap_action_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TAP"
                    android:textColor="#FFFFFF"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.25" />

                <TextView
                    android:id="@+id/tap_action_sublabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TO COUNT"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp"
                    android:letterSpacing="0.1" />
            </LinearLayout>
        </RelativeLayout>
    </FrameLayout>

    <!-- Controls & Step Selector Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STEP CONFIGURATION"
            android:textColor="#475569"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:letterSpacing="0.1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_step_1"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="+1"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="15sp"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btn_step_5"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="+5"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="15sp"
                android:layout_marginEnd="3dp"
                android:layout_marginStart="3dp" />

            <Button
                android:id="@+id/btn_step_10"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="+10"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="15sp"
                android:layout_marginEnd="3dp"
                android:layout_marginStart="3dp" />

            <Button
                android:id="@+id/btn_step_minus"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="-1"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="15sp"
                android:layout_marginStart="6dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Action Bar Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

        <Button
            android:id="@+id/btn_action_reset"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="RESET"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp"
            android:letterSpacing="0.05"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btn_action_theme"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1.2"
            android:text="THEME CYCLE"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp"
            android:letterSpacing="0.05"
            android:layout_marginEnd="3dp"
            android:layout_marginStart="3dp" />

        <Button
            android:id="@+id/btn_action_haptic"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="SOUND: ON"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp"
            android:letterSpacing="0.05"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <!-- History Log Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACTIVITY REALTIME TIMELINE"
            android:textColor="#475569"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"
            android:letterSpacing="0.1" />

        <ScrollView
            android:id="@+id/history_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical"
            android:fadeScrollbars="true">

            <LinearLayout
                android:id="@+id/history_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="4dp" />
        </ScrollView>
    </LinearLayout>

</LinearLayout>