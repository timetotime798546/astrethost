<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6F8">

    <!-- MAIN APP CONTENT VIEW -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Title Header Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:elevation="2dp"
                android:padding="20dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Task Dashboard"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#333333"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Asynchronous loading and operations"
                    android:textSize="14sp"
                    android:textColor="#777777"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Simulator Controls Card (Simulates failure modes/errors) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:elevation="2dp"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Error Simulator"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#444444"
                    android:layout_marginBottom="8dp"/>

                <CheckBox
                    android:id="@+id/cbSimulateError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Simulate Save/Reset error (fails operations)"
                    android:textSize="14sp"
                    android:textColor="#555555" />
            </LinearLayout>

            <!-- Add Task Form Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:elevation="2dp"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Create New Task"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#444444"
                    android:layout_marginBottom="12dp"/>

                <EditText
                    android:id="@+id/etTaskName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter task title..."
                    android:singleLine="true"
                    android:textSize="16sp"
                    android:layout_marginBottom="12dp"/>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp">

                    <Button
                        android:id="@+id/btnAddTask"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="Save Task"
                        android:background="#2196F3"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold" />

                    <!-- Small inline spinner for saving -->
                    <ProgressBar
                        android:id="@+id/progressSaving"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginRight="16dp"
                        android:visibility="gone"
                        android:indeterminate="true" />
                </FrameLayout>
            </LinearLayout>

            <!-- Tasks List Container Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:elevation="2dp"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Saved Tasks"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#444444"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:id="@+id/tasksContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tvEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No tasks loaded. Add a task above."
                    android:gravity="center"
                    android:textColor="#888888"
                    android:padding="16dp"/>
            </LinearLayout>

            <!-- Danger Zone Action Button -->
            <Button
                android:id="@+id/btnResetTasks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Reset and Clear Tasks"
                android:background="#E53935"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="32dp" />

        </LinearLayout>
    </ScrollView>

    <!-- FULLSCREEN OVERLAY LOADERS AND ALERTS -->

    <!-- 1. Fullscreen Task Resetting Overlay Loader -->
    <LinearLayout
        android:id="@+id/overlayResetting"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:indeterminate="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Resetting task list..."
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Optimizing offline memory space"
            android:textColor="#BBBBBB"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- 2. Screen-level Animated Splash Loader (At Launch) -->
    <LinearLayout
        android:id="@+id/overlaySplash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true">

        <!-- Splash Icon Simulation -->
        <TextView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="#2196F3"
            android:gravity="center"
            android:text="⚡"
            android:textSize="40sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Loading Task Database"
            android:textColor="#222222"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Initializing local storage configurations..."
            android:textColor="#666666"
            android:textSize="14sp"
            android:layout_marginBottom="32dp"/>

        <!-- Smooth circular progress indicator -->
        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="true" />
    </LinearLayout>

    <!-- Error Banner Alert Overlay (at the top of the viewport) -->
    <LinearLayout
        android:id="@+id/bannerError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#D32F2F"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚠️ Error: Remote storage sync has timed out."
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp"/>

        <Button
            android:id="@+id/btnDismissError"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Dismiss"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:background="#00000000" />
    </LinearLayout>

</FrameLayout>