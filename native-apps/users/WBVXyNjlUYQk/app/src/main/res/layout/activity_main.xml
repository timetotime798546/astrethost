<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:padding="16dp">

    <!-- Top Header Title -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_alignParentTop="true"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3D CHRONOMETER"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.2"
            android:shadowColor="#00E5FF"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="10"/>

        <TextView
            android:id="@+id/tvReadoutHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HOLOGRAPHIC 3D DIAL"
            android:textColor="#8A8A9F"
            android:textSize="10sp"
            android:letterSpacing="0.1"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <!-- Interactive Digital Display / Mode Output -->
    <TextView
        android:id="@+id/tvDigitalReadout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/layoutHeader"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="12dp"
        android:text="TILT TO ROTATE"
        android:textColor="#00E5FF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:shadowColor="#00E5FF"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="6"/>

    <!-- 3D Clock View Container -->
    <FrameLayout
        android:id="@+id/clockContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/tvDigitalReadout"
        android:layout_above="@id/dashboardCard"
        android:layout_margin="12dp">

        <com.threedclock.app.Clock3DView
            android:id="@+id/clock3DView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />
    </FrameLayout>

    <!-- Bottom Dashboard Card (Glassmorphism design) -->
    <LinearLayout
        android:id="@+id/dashboardCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_dashboard"
        android:orientation="vertical"
        android:padding="16dp"
        android:elevation="8dp">

        <!-- Tab Mode Navigation Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnModeClock"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginRight="4dp"
                android:text="CLOCK"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/btn_tab_active" />

            <Button
                android:id="@+id/btnModeStopwatch"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginLeft="2dp"
                android:layout_marginRight="2dp"
                android:text="CHRONO"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/btn_tab_normal" />

            <Button
                android:id="@+id/btnModeTimer"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginLeft="4dp"
                android:text="TIMER"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/btn_tab_normal" />
        </LinearLayout>

        <!-- Dynamic Control Panels -->

        <!-- 1. CLOCK CONFIGURATION CONTROLS -->
        <LinearLayout
            android:id="@+id/layoutClockControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- Sensor Tilt Switch -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Holographic Gravity Tilt"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true" />

                <Switch
                    android:id="@+id/swSensor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:checked="true" />
            </RelativeLayout>

            <!-- Sensitivity slider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tilt Responsiveness"
                    android:textColor="#8A8A9F"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <SeekBar
                    android:id="@+id/sbSensitivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="0dp"
                    android:paddingRight="0dp" />
            </LinearLayout>

            <!-- Bezel Depth slider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3D Rim Extrusion"
                    android:textColor="#8A8A9F"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <SeekBar
                    android:id="@+id/sbDepth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="0dp"
                    android:paddingRight="0dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 2. STOPWATCH CONTROLS -->
        <LinearLayout
            android:id="@+id/layoutStopwatchControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:visibility="gone"
            android:gravity="center">

            <Button
                android:id="@+id/btnSwStart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginRight="8dp"
                android:text="START"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="@drawable/btn_action" />

            <Button
                android:id="@+id/btnSwReset"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:text="RESET"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="@drawable/btn_action_secondary" />
        </LinearLayout>

        <!-- 3. TIMER CONTROLS -->
        <LinearLayout
            android:id="@+id/layoutTimerControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Set duration -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Duration Selector (Or Drag Dial)"
                    android:textColor="#8A8A9F"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvTimerVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5 Min"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="14sp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/sbTimerSelect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:paddingLeft="0dp"
                android:paddingRight="0dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <Button
                    android:id="@+id/btnTimerStart"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginRight="8dp"
                    android:text="START"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:background="@drawable/btn_action" />

                <Button
                    android:id="@+id/btnTimerReset"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="8dp"
                    android:text="RESET"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:background="@drawable/btn_action_secondary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Divider line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#30FFFFFF"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp" />

        <!-- Theme Selection Grid -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CHRONO SKIN / THEME"
            android:textColor="#8A8A9F"
            android:textSize="10sp"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="4">

            <Button
                android:id="@+id/btnThemeGold"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginRight="4dp"
                android:text="GOLD"
                android:textColor="#FFE082"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/btn_theme_select" />

            <Button
                android:id="@+id/btnThemeNeon"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginLeft="2dp"
                android:layout_marginRight="2dp"
                android:text="NEON"
                android:textColor="#00E5FF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/btn_theme_select" />

            <Button
                android:id="@+id/btnThemeObsidian"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginLeft="2dp"
                android:layout_marginRight="2dp"
                android:text="ONYX"
                android:textColor="#E0E0E0"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/btn_theme_select" />

            <Button
                android:id="@+id/btnThemeSteampunk"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginLeft="4dp"
                android:text="BRONZE"
                android:textColor="#D48D47"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/btn_theme_select" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>