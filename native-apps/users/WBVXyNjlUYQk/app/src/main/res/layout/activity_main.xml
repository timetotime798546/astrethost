<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5"
    android:padding="12dp">

    <!-- App Header Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Uniq Tool"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:gravity="center"
        android:layout_marginBottom="12dp"/>

    <!-- Scrollable configuration elements -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Input Box Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Input Text:"
                android:textStyle="bold"
                android:textColor="#555555"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/et_input"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:background="#FFFFFF"
                android:hint="Type or paste your duplicate-rich text here..."
                android:gravity="top|left"
                android:inputType="textMultiLine"
                android:scrollbars="vertical"
                android:padding="8dp"
                android:textSize="14sp"
                android:textColor="#222222"
                android:layout_marginBottom="12dp" />

            <!-- Options Configuration Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Processing Options:"
                android:textStyle="bold"
                android:textColor="#555555"
                android:layout_marginBottom="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#EAEAEA"
                android:padding="8dp"
                android:layout_marginBottom="12dp">

                <CheckBox
                    android:id="@+id/cb_adjacent_only"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Adjacent duplicates only (Unix style)"
                    android:checked="false"
                    android:textSize="13sp"/>

                <CheckBox
                    android:id="@+id/cb_case_insensitive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Case-insensitive matching"
                    android:checked="false"
                    android:textSize="13sp"/>

                <CheckBox
                    android:id="@+id/cb_ignore_whitespace"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ignore leading/trailing whitespace"
                    android:checked="true"
                    android:textSize="13sp"/>

                <CheckBox
                    android:id="@+id/cb_count_occurrences"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Prefix unique lines with occurrences count"
                    android:checked="false"
                    android:textSize="13sp"/>

                <CheckBox
                    android:id="@+id/cb_sort_output"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sort remaining lines alphabetically"
                    android:checked="false"
                    android:textSize="13sp"/>
            </LinearLayout>

            <!-- Interactive Processing Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/btn_process"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="Filter Duplicates"
                    android:background="#2196F3"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:layout_marginRight="4dp"/>

                <Button
                    android:id="@+id/btn_sample"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sample"
                    android:background="#FF9800"
                    android:textColor="#FFFFFF"
                    android:layout_marginRight="4dp"/>

                <Button
                    android:id="@+id/btn_clear"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Clear"
                    android:background="#757575"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>

            <!-- Line Statistics Section -->
            <TextView
                android:id="@+id/tv_statistics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Stats: Input Lines: 0 | Output Lines: 0"
                android:textSize="12sp"
                android:textColor="#666666"
                android:gravity="center_horizontal"
                android:layout_marginBottom="12dp"/>

            <!-- Output Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Output Text:"
                android:textStyle="bold"
                android:textColor="#555555"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/et_output"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:background="#FFFFFF"
                android:hint="Processed unique text will appear here..."
                android:gravity="top|left"
                android:inputType="textMultiLine"
                android:scrollbars="vertical"
                android:editable="false"
                android:focusable="true"
                android:textIsSelectable="true"
                android:padding="8dp"
                android:textSize="14sp"
                android:textColor="#111111"
                android:layout_marginBottom="12dp" />

            <!-- Utility Operations Footer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btn_copy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Copy Output"
                    android:background="#4CAF50"
                    android:textColor="#FFFFFF"
                    android:layout_marginRight="8dp"/>

                <Button
                    android:id="@+id/btn_share"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Share"
                    android:background="#009688"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>