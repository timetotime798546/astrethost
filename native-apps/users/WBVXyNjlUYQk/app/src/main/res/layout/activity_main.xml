<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Top Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#3F51B5"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Randomizer Pro"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Tab Bar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="#303F9F">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp">

            <Button
                android:id="@+id/btn_tab_coin_dice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Coin &amp; Dice"
                android:textColor="#FFFFFF"
                android:background="?android:attr/selectableItemBackground"
                android:textAllCaps="false"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_tab_decision"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Decision"
                android:textColor="#FFFFFF"
                android:background="?android:attr/selectableItemBackground"
                android:textAllCaps="false"
                android:paddingLeft="16dp"
                android:paddingRight="16dp" />

            <Button
                android:id="@+id/btn_tab_numbers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Numbers"
                android:textColor="#FFFFFF"
                android:background="?android:attr/selectableItemBackground"
                android:textAllCaps="false"
                android:paddingLeft="16dp"
                android:paddingRight="16dp" />

            <Button
                android:id="@+id/btn_tab_password"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Password"
                android:textColor="#FFFFFF"
                android:background="?android:attr/selectableItemBackground"
                android:textAllCaps="false"
                android:paddingLeft="16dp"
                android:paddingRight="16dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Main Content Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 1. Coin & Dice Section -->
        <ScrollView
            android:id="@+id/layout_coin_dice"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <!-- Coin Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#FFFFFF"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="COIN FLIPPER"
                        android:textSize="14sp"
                        android:textColor="#757575"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:id="@+id/tv_coin_visual"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:background="@android:drawable/dialog_holo_light_frame"
                        android:gravity="center"
                        android:text="HEADS"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#3F51B5"
                        android:layout_marginBottom="16dp"/>

                    <Button
                        android:id="@+id/btn_flip_coin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Flip Coin"
                        android:backgroundTint="#3F51B5"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

                <!-- Dice Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#FFFFFF"
                    android:padding="16dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DICE ROLLER"
                        android:textSize="14sp"
                        android:textColor="#757575"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tv_dice_1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚀"
                            android:textSize="72sp"
                            android:textColor="#212121"
                            android:layout_margin="4dp"/>

                        <TextView
                            android:id="@+id/tv_dice_2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚀"
                            android:textSize="72sp"
                            android:textColor="#212121"
                            android:layout_margin="4dp"
                            android:visibility="gone"/>

                        <TextView
                            android:id="@+id/tv_dice_3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚀"
                            android:textSize="72sp"
                            android:textColor="#212121"
                            android:layout_margin="4dp"
                            android:visibility="gone"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Number of Dice: "
                            android:textSize="16sp"
                            android:textColor="#212121" />

                        <Spinner
                            android:id="@+id/spinner_dice_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_roll_dice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Roll Dice"
                        android:backgroundTint="#3F51B5"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- 2. Decision Section -->
        <ScrollView
            android:id="@+id/layout_decision"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#FFFFFF"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DECISION MAKER"
                        android:textSize="14sp"
                        android:textColor="#757575"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Can't decide? Add your options below and let the app choose for you!"
                        android:textSize="14sp"
                        android:textColor="#616161"
                        android:layout_marginBottom="16dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <EditText
                            android:id="@+id/et_option_input"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Enter an option..."
                            android:inputType="text"
                            android:maxLines="1" />

                        <Button
                            android:id="@+id/btn_add_option"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Add"
                            android:backgroundTint="#3F51B5"
                            android:textColor="#FFFFFF"
                            android:layout_marginLeft="8dp"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Options List:"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        android:layout_marginBottom="8dp"/>

                    <!-- Scrollable container for dynamic layouts -->
                    <LinearLayout
                        android:id="@+id/list_options_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp">
                        <!-- Options appended programmatically here -->
                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_decide"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="DECIDE FOR ME!"
                        android:textSize="16sp"
                        android:backgroundTint="#E91E63"
                        android:textColor="#FFFFFF" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- 3. Numbers Section -->
        <ScrollView
            android:id="@+id/layout_numbers"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#FFFFFF"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RANDOM NUMBER GENERATOR"
                        android:textSize="14sp"
                        android:textColor="#757575"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginRight="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Min Value"
                                android:textSize="12sp"
                                android:textColor="#616161" />

                            <EditText
                                android:id="@+id/et_num_min"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="1"
                                android:inputType="numberSigned" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginLeft="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Max Value"
                                android:textSize="12sp"
                                android:textColor="#616161" />

                            <EditText
                                android:id="@+id/et_num_max"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="100"
                                android:inputType="numberSigned" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Quantity to Generate"
                            android:textSize="12sp"
                            android:textColor="#616161" />

                        <EditText
                            android:id="@+id/et_num_qty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="1"
                            android:inputType="number" />
                    </LinearLayout>

                    <CheckBox
                        android:id="@+id/cb_allow_duplicates"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Allow duplicate numbers"
                        android:checked="true"
                        android:layout_marginBottom="16dp"/>

                    <Button
                        android:id="@+id/btn_generate_numbers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Generate"
                        android:backgroundTint="#3F51B5"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="24dp"/>

                    <!-- Results Output -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Result:"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/tv_numbers_result"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#EEEEEE"
                        android:padding="16dp"
                        android:gravity="center"
                        android:text="---"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="#3F51B5"
                        android:layout_marginBottom="16dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="History:"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tv_numbers_history"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No history yet"
                        android:textSize="14sp"
                        android:textColor="#757575"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- 4. Password Section -->
        <ScrollView
            android:id="@+id/layout_password"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#FFFFFF"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PASSWORD GENERATOR"
                        android:textSize="14sp"
                        android:textColor="#757575"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp"/>

                    <!-- Password Length -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Length: "
                            android:textSize="16sp"
                            android:textColor="#212121" />

                        <TextView
                            android:id="@+id/tv_pwd_length_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="12"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#3F51B5"
                            android:layout_marginRight="16dp"/>

                        <SeekBar
                            android:id="@+id/sb_password_length"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="26"
                            android:progress="6" /> <!-- Standard length offset by 6 inside Java code -->
                    </LinearLayout>

                    <!-- Criteria Options -->
                    <CheckBox
                        android:id="@+id/cb_pwd_upper"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Include Uppercase Letters (A-Z)"
                        android:checked="true"
                        android:layout_marginBottom="6dp" />

                    <CheckBox
                        android:id="@+id/cb_pwd_lower"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Include Lowercase Letters (a-z)"
                        android:checked="true"
                        android:layout_marginBottom="6dp" />

                    <CheckBox
                        android:id="@+id/cb_pwd_digits"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Include Numbers (0-9)"
                        android:checked="true"
                        android:layout_marginBottom="6dp" />

                    <CheckBox
                        android:id="@+id/cb_pwd_symbols"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Include Special Symbols (!@#$...)"
                        android:checked="false"
                        android:layout_marginBottom="16dp" />

                    <Button
                        android:id="@+id/btn_generate_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Generate Password"
                        android:backgroundTint="#3F51B5"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="24dp" />

                    <!-- Output & Copy -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Generated Password:"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        android:layout_marginBottom="8dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="#EEEEEE"
                        android:padding="8dp">

                        <TextView
                            android:id="@+id/tv_password_result"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="P@$$w0rd"
                            android:textSize="18sp"
                            android:typeface="monospace"
                            android:textColor="#212121"
                            android:textIsSelectable="true"
                            android:paddingLeft="8dp"/>

                        <Button
                            android:id="@+id/btn_copy_password"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Copy"
                            android:textSize="12sp"
                            android:backgroundTint="#757575"
                            android:textColor="#FFFFFF"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>