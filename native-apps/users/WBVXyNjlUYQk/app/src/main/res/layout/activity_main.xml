<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/funny_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER SECTION -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/giggle_header"
            android:textColor="@color/text_dark"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/giggle_tagline"
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:layout_marginBottom="24dp"/>

        <!-- DAD JOKE CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/joke_card_title"
                android:textColor="@color/funny_orange"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/jokeText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Press the button to initiate comedy gold!"
                android:textColor="@color/text_dark"
                android:textSize="16sp"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:minLines="3"/>

            <Button
                android:id="@+id/jokeButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="@string/joke_btn"
                android:textColor="@color/text_dark"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/button_bg" />

            <TextView
                android:id="@+id/giggleCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Total giggles: 0"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:layout_marginTop="10dp"/>
        </LinearLayout>

        <!-- EXCUSE GENERATOR CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/excuse_card_title"
                android:textColor="@color/funny_orange"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <!-- EXCUSE CATEGORY SELECTORS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp"
                android:weightSum="3">

                <Button
                    android:id="@+id/catWork"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="👔 Work"
                    android:textSize="11sp"
                    android:background="@drawable/button_bg"
                    android:layout_marginRight="4dp"/>

                <Button
                    android:id="@+id/catSchool"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="🎒 School"
                    android:textSize="11sp"
                    android:background="@drawable/button_bg"
                    android:layout_marginRight="4dp"/>

                <Button
                    android:id="@+id/catGym"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="🏋️ Gym"
                    android:textSize="11sp"
                    android:background="@drawable/button_bg"/>
            </LinearLayout>

            <TextView
                android:id="@+id/excuseText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Need an escape route? Select a category and press Generate!"
                android:textColor="@color/text_dark"
                android:textSize="16sp"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:minLines="3"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/excuseButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="3"
                    android:text="@string/excuse_btn"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/button_bg_purple"
                    android:layout_marginRight="8dp"/>

                <Button
                    android:id="@+id/copyButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="📋"
                    android:textColor="@color/text_dark"
                    android:textSize="18sp"
                    android:background="@drawable/button_bg"/>
            </LinearLayout>
        </LinearLayout>

        <!-- SOUND SYNTHESIZER CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sound_card_title"
                android:textColor="@color/funny_orange"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Locally synthesized retro audio frequencies. Totally safe, absolutely noisy!"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3">

                <Button
                    android:id="@+id/soundBtnLaser"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="@string/sound_laser"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:background="@drawable/button_bg_cyan"
                    android:layout_marginRight="4dp"/>

                <Button
                    android:id="@+id/soundBtnBounce"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="@string/sound_bounce"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:background="@drawable/button_bg_purple"
                    android:layout_marginRight="4dp"/>

                <Button
                    android:id="@+id/soundBtnRaspberry"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="@string/sound_raspberry"
                    android:textColor="@color/text_dark"
                    android:textSize="11sp"
                    android:background="@drawable/button_bg"/>
            </LinearLayout>
        </LinearLayout>

        <!-- PRANKS CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prank_card_title"
                android:textColor="@color/funny_orange"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pass the phone to a friend and watch them panic with a super-convincing cracked screen effect!"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/prankCrackBtn"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="@string/prank_cracked_btn"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/button_bg_purple"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>