<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="12dp">

    <!-- Screen Display Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2.0"
        android:orientation="vertical"
        android:background="@drawable/screen_bg"
        android:gravity="bottom"
        android:padding="16dp"
        android:layout_marginBottom="12dp">

        <!-- History/Expression -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:scrollbars="none">
            
            <TextView
                android:id="@+id/tv_expression"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#8E8E93"
                android:textSize="20sp"
                android:singleLine="true"
                android:layout_gravity="end"
                android:gravity="end" />
        </HorizontalScrollView>

        <!-- Main Display / Live Result -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:layout_marginTop="8dp"
            android:scrollbars="none">
            
            <TextView
                android:id="@+id/tv_result"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#1C1C1E"
                android:textSize="44sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:layout_gravity="end"
                android:gravity="end" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Keypad Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="5.0"
        android:orientation="vertical">

        <!-- Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <Button
                android:id="@+id/btn_clear"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="C"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_action"
                android:textSize="18sp"
                android:layout_marginRight="3dp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_paren_open"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="("
                android:textColor="#1C1C1E"
                android:background="@drawable/btn_number"
                android:textSize="18sp"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_paren_close"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text=")"
                android:textColor="#1C1C1E"
                android:background="@drawable/btn_number"
                android:textSize="18sp"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_backspace"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="DEL"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_action"
                android:textSize="16sp"
                android:layout_marginLeft="3dp"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <Button
                android:id="@+id/btn_sin"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="sin"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_operator"
                android:textSize="16sp"
                android:layout_marginRight="3dp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_cos"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="cos"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_operator"
                android:textSize="16sp"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_tan"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="tan"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_operator"
                android:textSize="16sp"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_sqrt"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="√"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_operator"
                android:textSize="18sp"
                android:layout_marginLeft="3dp"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Row 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <Button
                android:id="@+id/btn_power"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="^"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_operator"
                android:textSize="18sp"
                android:layout_marginRight="3dp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_pi"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="π"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_operator"
                android:textSize="18sp"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_e"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="e"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_operator"
                android:textSize="18sp"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_divide"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="÷"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_operator"
                android:textSize="22sp"
                android:layout_marginLeft="3dp"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Row 4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <Button
                android:id="@+id/btn_7"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="7"
                android:textColor="#1C1C1E"
                android:background="@drawable/btn_number"
                android:textSize="22sp"
                android:layout_marginRight="3dp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_8"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="8"
                android:textColor="#1C1C1E"
                android:background="@drawable/btn_number"
                android:textSize="22sp"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_9"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="9"
                android:textColor="#1C1C1E"
                android:background="@drawable/btn_number"
                android:textSize="22sp"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_multiply"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="×"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_operator"
                android:textSize="22sp"
                android:layout_marginLeft="3dp"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Row 5 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <Button
                android:id="@+id/btn_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="4"
                android:textColor="#1C1C1E"
                android:background="@drawable/btn_number"
                android:textSize="22sp"
                android:layout_marginRight="3dp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="5"
                android:textColor="#1C1C1E"
                android:background="@drawable/btn_number"
                android:textSize="22sp"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="6"
                android:textColor="#1C1C1E"
                android:background="@drawable/btn_number"
                android:textSize="22sp"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_subtract"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="−"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_operator"
                android:textSize="22sp"
                android:layout_marginLeft="3dp"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Row 6 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <Button
                android:id="@+id/btn_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="1"
                android:textColor="#1C1C1E"
                android:background="@drawable/btn_number"
                android:textSize="22sp"
                android:layout_marginRight="3dp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="2"
                android:textColor="#1C1C1E"
                android:background="@drawable/btn_number"
                android:textSize="22sp"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="3"
                android:textColor="#1C1C1E"
                android:background="@drawable/btn_number"
                android:textSize="22sp"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_add"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="+"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_operator"
                android:textSize="22sp"
                android:layout_marginLeft="3dp"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Row 7 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_plus_minus"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="±"
                android:textColor="#1C1C1E"
                android:background="@drawable/btn_number"
                android:textSize="22sp"
                android:layout_marginRight="3dp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="0"
                android:textColor="#1C1C1E"
                android:background="@drawable/btn_number"
                android:textSize="22sp"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_decimal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="."
                android:textColor="#1C1C1E"
                android:background="@drawable/btn_number"
                android:textSize="22sp"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_equal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="="
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_equal"
                android:textSize="24sp"
                android:layout_marginLeft="3dp"
                android:textAllCaps="false" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>