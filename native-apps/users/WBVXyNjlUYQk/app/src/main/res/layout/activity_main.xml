<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050510">

    <!-- Custom Render Canvas -->
    <com.cosmicdodger.app.GameView
        android:id="@+id/game_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- In-Game UI Overlay Display -->
    <RelativeLayout
        android:id="@+id/hud_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SCORE: 0"
            android:textColor="#00FFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_alignParentStart="true" />

        <TextView
            android:id="@+id/tv_lives"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LIVES: ❤❤❤"
            android:textColor="#FF3B70"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_alignParentEnd="true" />
    </RelativeLayout>

    <!-- Welcome Menu Screen overlay -->
    <LinearLayout
        android:id="@+id/start_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="#ED03030A">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="COSMIC DODGER"
            android:textColor="#00FFFF"
            android:textSize="38sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Shoot incoming obstacles &amp; collect gold stars!"
            android:textColor="#9E9EB2"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_marginBottom="32dp" />

        <TextView
            android:id="@+id/tv_start_high_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HIGH SCORE: 0"
            android:textColor="#FFD700"
            android:textSize="21sp"
            android:layout_marginBottom="40dp" />

        <Button
            android:id="@+id/btn_start"
            android:layout_width="210dp"
            android:layout_height="60dp"
            android:text="LAUNCH GAME"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:backgroundTint="#00FFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Slide screen horizontally to navigate • Shoots lasers automatically"
            android:textColor="#626277"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="40dp" />
    </LinearLayout>

    <!-- Game Over overlay Screen -->
    <LinearLayout
        android:id="@+id/game_over_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="#F50B0615"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CRASH DETECTED"
            android:textColor="#FF3B3B"
            android:textSize="36sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tv_final_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FINAL SCORE: 0"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_game_over_high_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BEST RECORD: 0"
            android:textColor="#FFD700"
            android:textSize="19sp"
            android:layout_marginBottom="40dp" />

        <Button
            android:id="@+id/btn_restart"
            android:layout_width="210dp"
            android:layout_height="60dp"
            android:text="RETRY MISSION"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:backgroundTint="#FF3B70" />
    </LinearLayout>

</FrameLayout>