<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <!-- Header App Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="30dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Simple Counter"
            android:textColor="#212121"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true" />

        <Button
            android:id="@+id/btn_reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RESET"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#D32F2F"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true" />
    </RelativeLayout>

    <!-- Main Counter Card Frame -->
    <LinearLayout
        android:id="@+id/counter_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#FFFFFF"
        android:padding="24dp"
        android:layout_marginBottom="30dp"
        android:elevation="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CURRENT COUNT"
            android:textColor="#757575"
            android:textSize="14sp"
            android:letterSpacing="0.1"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/txt_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#212121"
            android:textSize="80sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <!-- Count adjustment controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Minus Button -->
            <Button
                android:id="@+id/btn_minus"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:text="-"
                android:textSize="32sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#757575"
                android:layout_marginEnd="20dp" />

            <!-- Plus Button -->
            <Button
                android:id="@+id/btn_plus"
                android:layout_width="120dp"
                android:layout_height="80dp"
                android:text="+"
                android:textSize="36sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#009688" />
        </LinearLayout>
    </LinearLayout>

    <!-- Footer Controls & Customizer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:elevation="2dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Customize Theme Color:"
            android:textColor="#424242"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Color Circle 1 (Teal) -->
            <Button
                android:id="@+id/btn_theme_teal"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_margin="6dp"
                android:backgroundTint="#009688" />

            <!-- Color Circle 2 (Blue) -->
            <Button
                android:id="@+id/btn_theme_blue"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_margin="6dp"
                android:backgroundTint="#2196F3" />

            <!-- Color Circle 3 (Orange) -->
            <Button
                android:id="@+id/btn_theme_orange"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_margin="6dp"
                android:backgroundTint="#FF9800" />

            <!-- Color Circle 4 (Purple) -->
            <Button
                android:id="@+id/btn_theme_purple"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_margin="6dp"
                android:backgroundTint="#9C27B0" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>