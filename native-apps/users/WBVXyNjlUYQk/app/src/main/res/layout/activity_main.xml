<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Primary Application Dashboard layout -->
    <ScrollView
        android:id="@+id/main_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F5F6FA"
        android:visibility="visible">

        <LinearLayout
            android:id="@+id/shake_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- App Title Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#6C5CE7"
                android:orientation="vertical"
                android:padding="24dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🤪 GOOFBALL MACHINE"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:layout_gravity="center_horizontal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your digital cure for extreme productivity"
                    android:textColor="#D6D1FF"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp"
                    android:layout_gravity="center_horizontal" />
            </LinearLayout>

            <!-- Card 1: Excuse Generator -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="18dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🤥 Bulletproof Excuse Spinner"
                    android:textColor="#2D3436"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Missed a meeting or dinner? Generate a foolproof scenario."
                    android:textColor="#7F8C8D"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tv_excuse_output"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Click 'SPIN EXCUSE' to create total chaos!"
                    android:textColor="#0984E3"
                    android:textSize="16sp"
                    android:textStyle="italic"
                    android:gravity="center"
                    android:padding="16dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="#EDF2F7" />

                <Button
                    android:id="@+id/btn_spin_excuse"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SPIN EXCUSE"
                    android:background="#0984E3"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Card 2: Dad Jokes Generator -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="18dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌽 Groan-Worthy Dad Jokes"
                    android:textColor="#2D3436"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scientifically engineered to induce massive eye rolls."
                    android:textColor="#7F8C8D"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tv_dad_joke"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Why don't skeletons fight each other? ... They don't have the guts!"
                    android:textColor="#27AE60"
                    android:textSize="15sp"
                    android:gravity="center"
                    android:padding="16dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="#EDF7F1" />

                <Button
                    android:id="@+id/btn_next_joke"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="NEXT BAD JOKE"
                    android:background="#27AE60"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Card 3: The Ultimate Drama Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="18dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚨 Red Alert Drama Button"
                    android:textColor="#2D3436"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Triggers maximum tension, heavy vibrations, screen shaking and loud alerts."
                    android:textColor="#7F8C8D"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tv_drama_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Status: Quietly boring."
                    android:textColor="#D63031"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:padding="8dp"
                    android:layout_marginTop="8dp" />

                <Button
                    android:id="@+id/btn_drama"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="INSTIGATE DRAMA"
                    android:background="#D63031"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- Card 4: Insult/Compliment Spinner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="18dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🧐 Suspicious Compliment Machine"
                    android:textColor="#2D3436"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_suspicious_compliment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Roll to find out what people *really* mean."
                    android:textColor="#E67E22"
                    android:textSize="15sp"
                    android:gravity="center"
                    android:padding="16dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="#FEF5EC" />

                <Button
                    android:id="@+id/btn_compliment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="GENERATE SUSPICION"
                    android:background="#E67E22"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Card 5: BOSS PANIC BUTTON -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#2D3436"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️ BOSS INCOMING PANIC AREA"
                    android:textColor="#F1C40F"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_gravity="center_horizontal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Instantly covers this nonsense with a very realistic, highly boring spreadsheet to save your job."
                    android:textColor="#BDC3C7"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btn_panic_trigger"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ACT BUSY! (PANIC)"
                    android:background="#F1C40F"
                    android:textColor="#2D3436"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Fullscreen Boss/Panic Mode Overlay Layout (Invisible by default) -->
    <LinearLayout
        android:id="@+id/layout_panic_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <!-- Top mock header looking like an enterprise system dashboard -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#2C3E50"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Q4_Financial_Consolidation_System_v19.4"
                android:textColor="#ECF0F1"
                android:textStyle="bold"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sync: SUCCESS"
                android:textColor="#2ECC71"
                android:textSize="11sp"
                android:layout_alignParentRight="true" />
        </RelativeLayout>

        <!-- Simulated technical spreadsheet chart/table elements -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PROJECTIONS TABLE"
            android:textColor="#7F8C8D"
            android:textStyle="bold"
            android:textSize="12sp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <!-- Mock spreadsheet headers -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#BDC3C7"
            android:padding="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Month"
                android:textColor="#2C3E50"
                android:textStyle="bold"
                android:textSize="11sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:text="Optimized ROI"
                android:textColor="#2C3E50"
                android:textStyle="bold"
                android:textSize="11sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:text="Resource Alloc"
                android:textColor="#2C3E50"
                android:textStyle="bold"
                android:textSize="11sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Deficit"
                android:textColor="#2C3E50"
                android:textStyle="bold"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Mock spreadsheet rows -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:background="#F2F4F4">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="OCTOBER"
                android:textSize="11sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:text="$1,845,992.51"
                android:textSize="11sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:text="94.2%"
                android:textSize="11sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0.00%"
                android:textColor="#27AE60"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="NOVEMBER"
                android:textSize="11sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:text="$2,120,443.05"
                android:textSize="11sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:text="96.8%"
                android:textSize="11sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="-1.04%"
                android:textColor="#C0392B"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:background="#F2F4F4">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="DECEMBER"
                android:textSize="11sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:text="$4,912,042.88"
                android:textSize="11sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:text="99.1%"
                android:textSize="11sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0.00%"
                android:textColor="#27AE60"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Technical status logs to reinforce authenticity -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LOG OVERVIEW"
            android:textColor="#7F8C8D"
            android:textStyle="bold"
            android:textSize="11sp"
            android:layout_marginTop="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="#1C2833"
            android:textColor="#2ECC71"
            android:padding="10dp"
            android:textSize="9sp"
            android:text="[System] Initializing data handshake...\n[Info] Connected to primary ledger secure pipeline.\n[Sync] Downloading 40,000 corporate cells...\n[Calculations] Resolving standard standard deviation matrices...\n[Success] Cloud backup validated. Current node is active.\n[Status] Monitoring Q4 targets closely..." />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Swipe or tap the button below when danger is gone."
            android:textColor="#7F8C8D"
            android:textSize="11sp"
            android:layout_marginTop="20dp"
            android:layout_gravity="center_horizontal" />

        <Button
            android:id="@+id/btn_exit_panic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="THE COAST IS CLEAR (RETURN TO FUN)"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="#27AE60"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</FrameLayout>