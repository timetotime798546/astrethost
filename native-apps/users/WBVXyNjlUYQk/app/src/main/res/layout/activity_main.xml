<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#008080"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Multi Utility Suite"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- App Main Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 1. CALCULATOR LAYOUT -->
        <LinearLayout
            android:id="@+id/calc_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#FFFFFF"
            android:visibility="visible">

            <TextView
                android:id="@+id/calc_screen"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/display_background"
                android:gravity="end|center_vertical"
                android:padding="16dp"
                android:text="0"
                android:textColor="#333333"
                android:textSize="32sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Row 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">
                    <Button
                        android:id="@+id/btn_calc_c"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginRight="8dp"
                        android:text="C"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:background="@drawable/button_calc_clear" />
                    <Button
                        android:id="@+id/btn_calc_back"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginRight="8dp"
                        android:text="DEL"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:background="@drawable/button_calc_clear" />
                    <Button
                        android:id="@+id/btn_calc_percent"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginRight="8dp"
                        android:text="%"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:background="@drawable/button_calc_operator" />
                    <Button
                        android:id="@+id/btn_calc_div"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="/"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:background="@drawable/button_calc_operator" />
                </LinearLayout>

                <!-- Row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">
                    <Button
                        android:id="@+id/btn_calc_7"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginRight="8dp"
                        android:text="7"
                        android:textColor="#333333"
                        android:textSize="20sp"
                        android:background="@drawable/button_calc_number" />
                    <Button
                        android:id="@+id/btn_calc_8"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginRight="8dp"
                        android:text="8"
                        android:textColor="#333333"
                        android:textSize="20sp"
                        android:background="@drawable/button_calc_number" />
                    <Button
                        android:id="@+id/btn_calc_9"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginRight="8dp"
                        android:text="9"
                        android:textColor="#333333"
                        android:textSize="20sp"
                        android:background="@drawable/button_calc_number" />
                    <Button
                        android:id="@+id/btn_calc_mul"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="*"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:background="@drawable/button_calc_operator" />
                </LinearLayout>

                <!-- Row 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">
                    <Button
                        android:id="@+id/btn_calc_4"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginRight="8dp"
                        android:text="4"
                        android:textColor="#333333"
                        android:textSize="20sp"
                        android:background="@drawable/button_calc_number" />
                    <Button
                        android:id="@+id/btn_calc_5"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginRight="8dp"
                        android:text="5"
                        android:textColor="#333333"
                        android:textSize="20sp"
                        android:background="@drawable/button_calc_number" />
                    <Button
                        android:id="@+id/btn_calc_6"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginRight="8dp"
                        android:text="6"
                        android:textColor="#333333"
                        android:textSize="20sp"
                        android:background="@drawable/button_calc_number" />
                    <Button
                        android:id="@+id/btn_calc_sub"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="-"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:background="@drawable/button_calc_operator" />
                </LinearLayout>

                <!-- Row 4 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">
                    <Button
                        android:id="@+id/btn_calc_1"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginRight="8dp"
                        android:text="1"
                        android:textColor="#333333"
                        android:textSize="20sp"
                        android:background="@drawable/button_calc_number" />
                    <Button
                        android:id="@+id/btn_calc_2"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginRight="8dp"
                        android:text="2"
                        android:textColor="#333333"
                        android:textSize="20sp"
                        android:background="@drawable/button_calc_number" />
                    <Button
                        android:id="@+id/btn_calc_3"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginRight="8dp"
                        android:text="3"
                        android:textColor="#333333"
                        android:textSize="20sp"
                        android:background="@drawable/button_calc_number" />
                    <Button
                        android:id="@+id/btn_calc_add"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="+"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:background="@drawable/button_calc_operator" />
                </LinearLayout>

                <!-- Row 5 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/btn_calc_0"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="2"
                        android:layout_marginRight="8dp"
                        android:text="0"
                        android:textColor="#333333"
                        android:textSize="20sp"
                        android:background="@drawable/button_calc_number" />
                    <Button
                        android:id="@+id/btn_calc_dot"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginRight="8dp"
                        android:text="."
                        android:textColor="#333333"
                        android:textSize="20sp"
                        android:background="@drawable/button_calc_number" />
                    <Button
                        android:id="@+id/btn_calc_equal"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="="
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:background="@drawable/button_calc_operator" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 2. STOPWATCH & TIMER LAYOUT -->
        <ScrollView
            android:id="@+id/stopwatch_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:background="#FFFFFF"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Stopwatch Title -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="STOPWATCH"
                    android:textSize="14sp"
                    android:textColor="#008080"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- Main Display -->
                <TextView
                    android:id="@+id/stopwatch_display"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="00:00.00"
                    android:textSize="44sp"
                    android:gravity="center"
                    android:textColor="#333333"
                    android:layout_marginBottom="16dp" />

                <!-- Buttons row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">
                    <Button
                        android:id="@+id/btn_sw_start"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginRight="4dp"
                        android:text="Start"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/button_background" />
                    <Button
                        android:id="@+id/btn_sw_pause"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginRight="4dp"
                        android:text="Pause"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/button_background" />
                    <Button
                        android:id="@+id/btn_sw_lap"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginRight="4dp"
                        android:text="Lap"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/button_background" />
                    <Button
                        android:id="@+id/btn_sw_reset"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Reset"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/button_calc_clear" />
                </LinearLayout>

                <!-- Laps Display -->
                <TextView
                    android:id="@+id/tv_laps"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:background="#F5F5F5"
                    android:padding="8dp"
                    android:textColor="#666666"
                    android:textSize="14sp"
                    android:scrollbars="vertical"
                    android:layout_marginBottom="24dp"
                    android:text="Laps will appear here..." />

                <!-- Divider line -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#DDDDDD"
                    android:layout_marginBottom="24dp" />

                <!-- Countdown Section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="COUNTDOWN TIMER"
                    android:textSize="14sp"
                    android:textColor="#008080"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- Control elements -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical">
                    <EditText
                        android:id="@+id/et_timer_input"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Seconds"
                        android:inputType="number"
                        android:textSize="16sp" />
                    <Button
                        android:id="@+id/btn_timer_start"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Start"
                        android:textColor="#FFFFFF"
                        android:layout_marginLeft="8dp"
                        android:background="@drawable/button_background" />
                    <Button
                        android:id="@+id/btn_timer_stop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Stop"
                        android:textColor="#FFFFFF"
                        android:layout_marginLeft="8dp"
                        android:background="@drawable/button_calc_clear" />
                </LinearLayout>

                <!-- Timer output -->
                <TextView
                    android:id="@+id/timer_display"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textSize="40sp"
                    android:gravity="center"
                    android:textColor="#333333" />
            </LinearLayout>
        </ScrollView>

        <!-- 3. QUICK NOTES LAYOUT -->
        <LinearLayout
            android:id="@+id/notes_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#FFFFFF"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="QUICK NOTES"
                android:textSize="14sp"
                android:textColor="#008080"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/et_note_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Title (optional)"
                android:inputType="textCapWords"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/et_note_content"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:hint="Type your note here..."
                android:inputType="textMultiLine"
                android:gravity="top"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btn_save_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Save Note"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="16dp"
                android:background="@drawable/button_background" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SAVED NOTES (Long click to delete)"
                android:textSize="12sp"
                android:textColor="#777777"
                android:layout_marginBottom="8dp" />

            <ListView
                android:id="@+id/lv_notes"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#F9F9F9"
                android:divider="#EEEEEE"
                android:dividerHeight="1dp" />
        </LinearLayout>

        <!-- 4. UNIT CONVERTER LAYOUT -->
        <ScrollView
            android:id="@+id/converter_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:background="#FFFFFF"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="UNIT CONVERTER"
                    android:textSize="14sp"
                    android:textColor="#008080"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Select Category"
                    android:textSize="12sp"
                    android:textColor="#777777"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    android:id="@+id/spinner_category"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="16dp"
                    android:background="@android:drawable/btn_dropdown"
                    android:spinnerMode="dropdown" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Enter Value"
                    android:textSize="12sp"
                    android:textColor="#777777"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/et_converter_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="0.0"
                    android:inputType="numberDecimal|numberSigned"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginRight="8dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="From"
                            android:textSize="12sp"
                            android:textColor="#777777"
                            android:layout_marginBottom="4dp" />

                        <Spinner
                            android:id="@+id/spinner_from"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@android:drawable/btn_dropdown"
                            android:spinnerMode="dropdown" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="To"
                            android:textSize="12sp"
                            android:textColor="#777777"
                            android:layout_marginBottom="4dp" />

                        <Spinner
                            android:id="@+id/spinner_to"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@android:drawable/btn_dropdown"
                            android:spinnerMode="dropdown" />
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btn_convert"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Convert"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/button_background"
                    android:layout_marginBottom="24dp" />

                <TextView
                    android:id="@+id/tv_converter_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Result: 0.0"
                    android:textSize="22sp"
                    android:gravity="center"
                    android:textColor="#333333"
                    android:textStyle="bold" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Bottom tab Navigation bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="#EEEEEE">

        <Button
            android:id="@+id/tab_calc"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Calc"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:background="@android:color/transparent" />

        <Button
            android:id="@+id/tab_stopwatch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Timer"
            android:textSize="11sp"
            android:textColor="#555555"
            android:background="@android:color/transparent" />

        <Button
            android:id="@+id/tab_notes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Notes"
            android:textSize="11sp"
            android:textColor="#555555"
            android:background="@android:color/transparent" />

        <Button
            android:id="@+id/tab_converter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Converter"
            android:textSize="11sp"
            android:textColor="#555555"
            android:background="@android:color/transparent" />
    </LinearLayout>
</LinearLayout>