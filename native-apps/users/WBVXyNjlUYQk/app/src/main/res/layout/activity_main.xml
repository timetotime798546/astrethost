<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F1F5F9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- Header Block -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/app_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Simple Clicker"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="#0F172A" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Premium Tally &amp; Tracker Companion"
                android:textSize="13sp"
                android:textColor="#64748B"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Dynamic Counter Display Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="28dp"
            android:background="@drawable/card_background"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CURRENT COUNT"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#94A3B8"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/text_counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="84sp"
                android:textStyle="bold"
                android:textColor="#2563EB"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/text_achievement"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Keep clicking to set custom peaks!"
                android:textSize="13sp"
                android:textColor="#64748B"
                android:textStyle="bold"
                android:gravity="center" />
        </LinearLayout>

        <!-- Step Increment Multipliers Configuration -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SELECT INCREMENT STEP"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#64748B"
            android:letterSpacing="0.06"
            android:layout_gravity="start"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/btn_step_1"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="+ 1"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/chip_selected"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btn_step_5"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="+ 5"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/chip_unselected"
                android:textColor="#475569"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp" />

            <Button
                android:id="@+id/btn_step_10"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="+ 10"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/chip_unselected"
                android:textColor="#475569"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- Main Action Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="3"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/btn_decrement"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:text="-"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_dec_bg"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_reset"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:text="RESET"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#475569"
                android:background="@drawable/btn_reset_bg"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_increment"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:text="+"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_inc_bg"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Haptic Preference Toggle -->
        <Button
            android:id="@+id/btn_haptic_toggle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="HAPTIC FEEDBACK: ON"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/toggle_active"
            android:layout_marginBottom="24dp" />

        <!-- Persistent Statistics Storage Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="20dp"
            android:background="@drawable/stats_background"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/text_high_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="High Score: 0"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#1E293B"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/text_total_clicks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Session Clicks: 0"
                android:textSize="13sp"
                android:textColor="#475569" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>