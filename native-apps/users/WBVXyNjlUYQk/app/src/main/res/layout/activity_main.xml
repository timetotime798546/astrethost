<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF5F6">

    <!-- App Header Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="#FF69B4"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:elevation="4dp">

        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Payal 🎀 (AI Sister)"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Settings ⚙️"
            android:textColor="#FF69B4"
            android:background="#FFFFFF"
            android:textSize="12sp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_gravity="center_vertical" />
    </LinearLayout>

    <!-- API Key Notice Panel -->
    <TextView
        android:id="@+id/tvKeyWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFE0B2"
        android:textColor="#E65100"
        android:textSize="13sp"
        android:padding="10dp"
        android:gravity="center"
        android:text="⚠️ API Key is missing! Click Settings on top to enter your Gemini API Key."
        android:visibility="gone" />

    <!-- Chat Message List Container -->
    <ScrollView
        android:id="@+id/chatScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:scrollbarStyle="outsideOverlay"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/chatContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Preferences Status Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="#FFF0F2"
        android:gravity="center_vertical">

        <CheckBox
            android:id="@+id/cbSpeakResponse"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Auto Speak Responses 🔊"
            android:textColor="#4A148C"
            android:checked="true"
            android:textSize="12sp" />
        
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
            
        <TextView
            android:id="@+id/tvModelLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Model: Loading..."
            android:textColor="#FF1493"
            android:textSize="11sp"
            android:textStyle="italic" />
    </LinearLayout>

    <!-- Message Input Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:elevation="8dp">

        <EditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Type a message for Payal..."
            android:background="@drawable/bg_input"
            android:paddingLeft="18dp"
            android:paddingTop="10dp"
            android:paddingRight="18dp"
            android:paddingBottom="10dp"
            android:maxLines="4"
            android:textColor="#333333"
            android:textColorHint="#997080"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnMic"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginLeft="6dp"
            android:text="🎙️"
            android:textSize="16sp"
            android:background="@drawable/user_bubble"
            android:textColor="#333333" />

        <Button
            android:id="@+id/btnSend"
            android:layout_width="72dp"
            android:layout_height="44dp"
            android:layout_marginLeft="6dp"
            android:text="Send"
            android:textColor="#FFFFFF"
            android:background="#FF69B4"
            android:textStyle="bold"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>