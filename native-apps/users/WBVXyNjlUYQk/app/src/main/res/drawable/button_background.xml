<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Drop shadow for the modern elevated look -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#002D05" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:bottom="4dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#2E7D32"
                android:endColor="#1B5E20"
                android:angle="270"/>
            <corners android:radius="10dp" />
            <stroke android:width="1.2dp" android:color="#81C784" />
        </shape>
    </item>
</layer-list>