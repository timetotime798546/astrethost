{
  "backend": true,
  "api_base_url": "https://trumpledroid-api.cloudbeta28624.workers.dev",
  "roles": {
    "user": ["own"]
  },
  "collections": {
    "appointments": {
      "fields": {
        "doctor_name": "string",
        "service_name": "string",
        "patient_name": "string",
        "patient_phone": "string",
        "appointment_date": "string",
        "appointment_time": "string",
        "notes": "string",
        "fee": "number",
        "tax": "number",
        "total_fee": "number",
        "status": "string"
      },
      "operations": ["create", "read", "update", "delete"]
    }
  },
  "logic": {
    "total_appointment_fee": {
      "type": "calculation",
      "inputs": ["fee", "tax"],
      "formula": "fee + tax"
    }
  }
}