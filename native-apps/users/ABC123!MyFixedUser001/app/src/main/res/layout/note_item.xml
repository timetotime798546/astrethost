<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_margin="6dp"
    android:background="@drawable/round_card"
    android:padding="12dp"
    android:elevation="1dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv_note_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_toLeftOf="@+id/ll_actions"
            android:text="Note Title"
            android:textColor="#212121"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:id="@+id/ll_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_edit_note"
                android:layout_width="44dp"
                android:layout_height="32dp"
                android:background="#00000000"
                android:text="EDIT"
                android:textColor="#3F51B5"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_delete_note"
                android:layout_width="44dp"
                android:layout_height="32dp"
                android:background="#00000000"
                android:text="DEL"
                android:textColor="#E53935"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <TextView
        android:id="@+id/tv_note_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="This is the content description preview..."
        android:textColor="#666666"
        android:textSize="13sp"
        android:maxLines="3"
        android:ellipsize="end" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">

        <!-- Category badge -->
        <TextView
            android:id="@+id/tv_note_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_category"
            android:text="Personal"
            android:textColor="#1976D2"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_note_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:text="2023-10-25 10:30"
            android:textColor="#999999"
            android:textSize="11sp" />
    </RelativeLayout>
</LinearLayout>