<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage Categories"
        android:textColor="#212121"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <!-- Add Category Input Field -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <EditText
            android:id="@+id/et_new_category"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/input_background"
            android:hint="New Category Name..."
            android:inputType="textCapWords"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_add_category"
            android:layout_width="64dp"
            android:layout_height="40dp"
            android:layout_marginLeft="8dp"
            android:background="#4CAF50"
            android:text="Add"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Existing Categories:"
        android:textColor="#777777"
        android:textSize="12sp"
        android:layout_marginBottom="6dp" />

    <!-- ListView of existing categories -->
    <ListView
        android:id="@+id/lv_categories"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:divider="#EEEEEE"
        android:dividerHeight="1dp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btn_close_categories"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="#3F51B5"
        android:text="Close"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />
</LinearLayout>