<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_match"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:weightSum="10">

    <!-- DISPLAY LAYER (Top 35%) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3.5"
        android:background="@drawable/bg_display"
        android:orientation="vertical"
        android:gravity="bottom|end"
        android:padding="24dp">

        <!-- Expression History View -->
        <TextView
            android:id="@+id/tv_history"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_muted"
            android:textSize="22sp"
            android:textStyle="normal"
            android:maxLines="2"
            android:ellipsize="start"
            android:text=""
            android:layout_marginBottom="8dp" />

        <!-- Main Display Value View -->
        <TextView
            android:id="@+id/tv_display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_white"
            android:textSize="54sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="0" />
    </LinearLayout>

    <!-- KEYBOARD CONTAINER (Bottom 65%) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="6.5"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center">

        <!-- Row 1: C, +/-, %, / -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btn_clear"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:background="@drawable/btn_function"
                android:text="C"
                android:textColor="@color/text_dark"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_negate"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:background="@drawable/btn_function"
                android:text="±"
                android:textColor="@color/text_dark"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_percent"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:background="@drawable/btn_function"
                android:text="%"
                android:textColor="@color/text_dark"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_div"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/btn_operator"
                android:text="÷"
                android:textColor="@color/text_white"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 2: 7, 8, 9, * -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btn_7"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:background="@drawable/btn_number"
                android:text="7"
                android:textColor="@color/text_white"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btn_8"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:background="@drawable/btn_number"
                android:text="8"
                android:textColor="@color/text_white"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btn_9"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:background="@drawable/btn_number"
                android:text="9"
                android:textColor="@color/text_white"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btn_mul"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/btn_operator"
                android:text="×"
                android:textColor="@color/text_white"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 3: 4, 5, 6, - -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btn_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:background="@drawable/btn_number"
                android:text="4"
                android:textColor="@color/text_white"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btn_5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:background="@drawable/btn_number"
                android:text="5"
                android:textColor="@color/text_white"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btn_6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:background="@drawable/btn_number"
                android:text="6"
                android:textColor="@color/text_white"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btn_sub"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/btn_operator"
                android:text="−"
                android:textColor="@color/text_white"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 4: 1, 2, 3, + -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btn_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:background="@drawable/btn_number"
                android:text="1"
                android:textColor="@color/text_white"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btn_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:background="@drawable/btn_number"
                android:text="2"
                android:textColor="@color/text_white"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btn_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:background="@drawable/btn_number"
                android:text="3"
                android:textColor="@color/text_white"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btn_add"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/btn_operator"
                android:text="+"
                android:textColor="@color/text_white"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 5: 0, ., Backspace, = -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:background="@drawable/btn_number"
                android:text="0"
                android:textColor="@color/text_white"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btn_dot"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:background="@drawable/btn_number"
                android:text="."
                android:textColor="@color/text_white"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btn_back"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:background="@drawable/btn_number"
                android:text="⌫"
                android:textColor="@color/text_white"
                android:textSize="20sp" />

            <Button
                android:id="@+id/btn_eq"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/btn_operator"
                android:text="="
                android:textColor="@color/text_white"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>