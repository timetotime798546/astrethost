<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- Top Toolbar Header -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#2E7D32"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:elevation="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_add_quick"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Add"
            android:textColor="#2E7D32"
            android:background="@drawable/card_bg"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:height="36dp"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main Content Frame -->
    <FrameLayout
        android:id="@+id/content_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottom_tabs"
        android:layout_below="@+id/top_bar">

        <!-- DASHBOARD TAB CONTAINER -->
        <ScrollView
            android:id="@+id/container_dashboard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Balance Summary Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="18dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Current Balance"
                        android:textColor="#757575"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txt_dashboard_balance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$0.00"
                        android:textColor="#212121"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="14dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Income Segment -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Income"
                                android:textColor="#4CAF50"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txt_dashboard_income"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$0.00"
                                android:textColor="#4CAF50"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <!-- Visual Divider -->
                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="#E0E0E0"
                            android:layout_marginLeft="8dp"
                            android:layout_marginRight="8dp" />

                        <!-- Expense Segment -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Expenses"
                                android:textColor="#F44336"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txt_dashboard_expense"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$0.00"
                                android:textColor="#F44336"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Action Button -->
                <Button
                    android:id="@+id/btn_add_transaction_main"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="24dp"
                    android:text="+ Add Transaction"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/button_bg"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Recent Activities Title Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Recent Transactions"
                        android:textColor="#212121"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_view_all_transactions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View All"
                        android:textColor="#2E7D32"
                        android:textStyle="bold"
                        android:padding="8dp" />
                </LinearLayout>

                <!-- Mini recent transaction list -->
                <LinearLayout
                    android:id="@+id/layout_recent_transactions_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/txt_no_recent_transactions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/no_transactions"
                    android:textColor="#757575"
                    android:gravity="center"
                    android:layout_marginTop="24dp"
                    android:visibility="gone" />

            </LinearLayout>
        </ScrollView>

        <!-- TRANSACTIONS HISTORY TAB CONTAINER -->
        <LinearLayout
            android:id="@+id/container_transactions"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All Transactions"
                android:textColor="#212121"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Dynamic Filters -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <!-- Type Selector -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginRight="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Type Filter"
                        android:textColor="#757575"
                        android:textSize="12sp" />

                    <Spinner
                        android:id="@+id/spinner_filter_type"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/edit_text_bg"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Category Selector -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginLeft="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Category Filter"
                        android:textColor="#757575"
                        android:textSize="12sp" />

                    <Spinner
                        android:id="@+id/spinner_filter_category"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/edit_text_bg"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>

            <ListView
                android:id="@+id/list_transactions"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="@null"
                android:dividerHeight="0dp" />

            <TextView
                android:id="@+id/txt_transactions_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No transactions match current selectors."
                android:textColor="#757575"
                android:gravity="center"
                android:layout_marginTop="32dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- REPORTS ANALYSIS TAB CONTAINER -->
        <ScrollView
            android:id="@+id/container_reports"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Monthly Expenses Share"
                    android:textColor="#212121"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Month Browser Navigation -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/card_bg"
                    android:padding="8dp"
                    android:layout_marginBottom="16dp">

                    <Button
                        android:id="@+id/btn_prev_month"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="&lt;"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:background="@drawable/button_accent_bg"
                        android:textColor="#FFFFFF"
                        android:minWidth="0dp"
                        android:minHeight="0dp" />

                    <TextView
                        android:id="@+id/txt_selected_month"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="All Time"
                        android:textColor="#212121"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:gravity="center" />

                    <Button
                        android:id="@+id/btn_next_month"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="&gt;"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:background="@drawable/button_accent_bg"
                        android:textColor="#FFFFFF"
                        android:minWidth="0dp"
                        android:minHeight="0dp" />
                </LinearLayout>

                <!-- Pie Chart Graphical Area -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="280dp"
                    android:background="@drawable/card_bg"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp"
                    android:layout_marginBottom="20dp">

                    <com.expensetrackerpro.app.PieChartView
                        android:id="@+id/pie_chart_view"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </LinearLayout>

                <!-- Item Breakdown lists -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Breakdown by Category"
                    android:textColor="#212121"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/layout_category_breakdown_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Bottom Selection Tabs Navigation -->
    <LinearLayout
        android:id="@+id/bottom_tabs"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="horizontal">

        <!-- Tab Dashboard -->
        <LinearLayout
            android:id="@+id/tab_dashboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/lbl_tab_dashboard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dashboard"
                android:textColor="#2E7D32"
                android:textStyle="bold"
                android:textSize="14sp" />

            <View
                android:id="@+id/indicator_dashboard"
                android:layout_width="40dp"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:background="#2E7D32"
                android:visibility="visible" />
        </LinearLayout>

        <!-- Tab History -->
        <LinearLayout
            android:id="@+id/tab_transactions"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/lbl_tab_transactions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="History"
                android:textColor="#757575"
                android:textStyle="bold"
                android:textSize="14sp" />

            <View
                android:id="@+id/indicator_transactions"
                android:layout_width="40dp"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:background="#2E7D32"
                android:visibility="invisible" />
        </LinearLayout>

        <!-- Tab Reports -->
        <LinearLayout
            android:id="@+id/tab_reports"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/lbl_tab_reports"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reports"
                android:textColor="#757575"
                android:textStyle="bold"
                android:textSize="14sp" />

            <View
                android:id="@+id/indicator_reports"
                android:layout_width="40dp"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:background="#2E7D32"
                android:visibility="invisible" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>