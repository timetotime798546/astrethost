<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.multiutilitysuite.app">

    <application
        android:allowBackup="true"
        android:icon="@drawable/icon"
        android:roundIcon="@drawable/icon"
        android:label="Multi Utility Suite"
        android:theme="@android:style/Theme.Material.Light">
        
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <activity android:name=".CalculatorActivity" android:exported="false" />
        <activity android:name=".StopwatchActivity" android:exported="false" />
        <activity android:name=".NotesActivity" android:exported="false" />
        <activity android:name=".UnitConverterActivity" android:exported="false" />
        <activity android:name=".DiceRollerActivity" android:exported="false" />
        <activity android:name=".BmiCalculatorActivity" android:exported="false" />
        <activity android:name=".ColorPickerActivity" android:exported="false" />
        <activity android:name=".SensorExplorerActivity" android:exported="false" />
        <activity android:name=".AppInfoActivity" android:exported="false" />
        
    </application>
</manifest>