<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_flashlight"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_flashlight_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Flashlight Utility"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="40dp" />

    <Button
        android:id="@+id/btn_flashlight_toggle"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:text="TURN ON"
        android:textSize="22sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#AA00FF"
        android:layout_centerInParent="true" />

    <TextView
        android:id="@+id/tv_flashlight_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Flashlight INACTIVE"
        android:textColor="#9E9E9E"
        android:textSize="16sp"
        android:layout_below="@id/btn_flashlight_toggle"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="30dp" />

</RelativeLayout>
