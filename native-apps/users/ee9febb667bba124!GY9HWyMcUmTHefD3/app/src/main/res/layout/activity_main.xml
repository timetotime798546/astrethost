<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Multi Tool Suite"
            android:textColor="#212121"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center_horizontal"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="8 Fully-Featured Essential Utilities"
            android:textColor="#757575"
            android:textSize="14sp"
            android:gravity="center_horizontal"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btn_calculator"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Calculator"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#03A9F4"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn_notes"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Quick Notes"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn_stopwatch"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Stopwatch"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#FF9800"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn_unit"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Unit Converter"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#E91E63"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn_flashlight"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Flashlight"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#9C27B0"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn_bmi"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="BMI Calculator"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#009688"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn_dice"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Dice Roller"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#3F51B5"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>
