<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FCE4EC">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Quick Converter"
        android:textSize="22sp"
        android:textColor="#880E4F"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <EditText
        android:id="@+id/et_converter_input"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:hint="Enter Number to Convert"
        android:inputType="numberDecimal"
        android:padding="12dp"
        android:background="#FFFFFF"
        android:textSize="18sp"
        android:textColor="#880E4F"
        android:layout_marginBottom="24dp"/>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="2"
        android:layout_marginBottom="24dp">

        <Button
            android:id="@+id/btn_km_to_mi"
            android:text="Km to Miles"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"/>

        <Button
            android:id="@+id/btn_mi_to_km"
            android:text="Miles to Km"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"/>

        <Button
            android:id="@+id/btn_c_to_f"
            android:text="°C to °F"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"/>

        <Button
            android:id="@+id/btn_f_to_c"
            android:text="°F to °C"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"/>

    </GridLayout>

    <TextView
        android:id="@+id/tv_converter_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Result will show here"
        android:textColor="#333333"
        android:textSize="20sp"
        android:gravity="center"
        android:layout_marginTop="16dp"
        android:textStyle="italic"/>
</LinearLayout>
