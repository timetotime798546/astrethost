<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#2196F3"
        android:padding="20dp"
        android:elevation="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Task Flow"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 of 0 tasks completed"
            android:textColor="#E3F2FD"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Filters -->
    <LinearLayout
        android:id="@+id/layoutFilters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/layoutHeader"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#FFFFFF">

        <Button
            android:id="@+id/btnFilterAll"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="All"
            android:textSize="12sp"
            android:background="#2196F3"
            android:textColor="#FFFFFF"
            android:layout_margin="4dp" />

        <Button
            android:id="@+id/btnFilterPending"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="Pending"
            android:textSize="12sp"
            android:background="#EEEEEE"
            android:textColor="#333333"
            android:layout_margin="4dp" />

        <Button
            android:id="@+id/btnFilterCompleted"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="Completed"
            android:textSize="12sp"
            android:background="#EEEEEE"
            android:textColor="#333333"
            android:layout_margin="4dp" />
    </LinearLayout>

    <!-- ListView -->
    <ListView
        android:id="@+id/listViewTasks"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layoutFilters"
        android:layout_above="@+id/layoutBottomSpacer"
        android:divider="@android:color/transparent"
        android:dividerHeight="8dp"
        android:padding="12dp"
        android:clipToPadding="false" />

    <!-- No Tasks View -->
    <TextView
        android:id="@+id/textNoTasks"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="No tasks yet! Tap + to add one."
        android:textColor="#888888"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- Anchor/Spacer -->
    <View
        android:id="@+id/layoutBottomSpacer"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_alignParentBottom="true"
        android:visibility="invisible" />

    <!-- Floating Action Button -->
    <ImageButton
        android:id="@+id/fabAddTask"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/fab_background"
        android:src="@android:drawable/ic_input_add"
        android:tint="#FFFFFF"
        android:contentDescription="Add Task"
        android:elevation="6dp" />

</RelativeLayout>