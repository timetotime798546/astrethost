<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/task_item_bg"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical"
    android:elevation="2dp">

    <!-- Priority Strip Indicator -->
    <View
        android:id="@+id/viewPriorityIndicator"
        android:layout_width="6dp"
        android:layout_height="40dp"
        android:background="#FF1744"
        android:layout_marginEnd="12dp" />

    <CheckBox
        android:id="@+id/checkboxComplete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textTaskTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Task Title"
            android:textColor="#212121"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textTaskDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Task description goes here."
            android:textColor="#666666"
            android:textSize="13sp"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/textTaskDueDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Due: Dec 31, 2024"
            android:textColor="#888888"
            android:textSize="11sp"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/btnDeleteTask"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_delete"
        android:tint="#757575"
        android:contentDescription="Delete Task" />

</LinearLayout>