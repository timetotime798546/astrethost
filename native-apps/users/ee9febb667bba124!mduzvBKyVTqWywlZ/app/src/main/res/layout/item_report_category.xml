<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_background"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <!-- Primary Row Header details -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tv_rep_cat_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Food"
            android:textColor="#333333"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_alignParentLeft="true" />

        <!-- Total sum formatted values -->
        <TextView
            android:id="@+id/tv_rep_cat_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$0.00"
            android:textColor="#333333"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_alignParentRight="true" />

        <!-- Dynamic relative percentage allocation text -->
        <TextView
            android:id="@+id/tv_rep_cat_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textColor="#008080"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_toLeftOf="@id/tv_rep_cat_amount"
            android:layout_marginRight="12dp" />
    </RelativeLayout>

    <!-- Custom relative percentage width filler component -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:background="#E0E0E0"
        android:orientation="horizontal"
        android:weightSum="100">

        <View
            android:id="@+id/view_progress_bar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0"
            android:background="#C62828" />

        <View
            android:id="@+id/view_progress_empty"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="100" />
    </LinearLayout>
</LinearLayout>