<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- High-Performance Interactive Ambient 3D Particle Canvas -->
    <com.acresizer.app.ParticleBackgroundView
        android:id="@+id/particleBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Header Toolbar -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:background="#1E3A8A"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:elevation="4dp">

        <TextView
            android:id="@+id/txtHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AC Resizer 3D"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tactile 3D Controls • Holographic Shifting Preview • Custom Filters"
            android:textColor="#93C5FD"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Main Scrollable Body Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/actionBottomBar"
        android:layout_below="@id/headerBar"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Card 0: Theme Selection Settings -->
            <LinearLayout
                android:id="@+id/themeCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="14dp"
                android:elevation="2dp">

                <TextView
                    android:id="@+id/themeTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="Ambient Workspace Color Space"
                    android:textColor="#111827"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnThemeBlue"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginRight="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/preset_button_bg"
                        android:text="Cyan Blue"
                        android:textColor="#1E3A8A"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnThemeDark"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginLeft="2dp"
                        android:layout_marginRight="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/preset_button_bg"
                        android:text="Dark Slate"
                        android:textColor="#1E293B"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnThemeGreen"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginLeft="2dp"
                        android:layout_marginRight="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/preset_button_bg"
                        android:text="Forest Green"
                        android:textColor="#064E3B"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnThemePurple"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginLeft="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/preset_button_bg"
                        android:text="Neon Purple"
                        android:textColor="#4C1D95"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Card 1: Selected Photo Container / Display (With 3D Perspective Rotation) -->
            <LinearLayout
                android:id="@+id/cardInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="14dp"
                android:elevation="4dp">

                <TextView
                    android:id="@+id/lblSelectedPhoto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="Selected Photo (Tap / Hold to tilt in 3D)"
                    android:textColor="#111827"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:background="#F1F5F9">

                    <ImageView
                        android:id="@+id/originalImageView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:id="@+id/placeholderText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:padding="12dp"
                        android:text="Choose an image file from storage\nto initialize 3D perspective workflows"
                        android:textColor="#64748B"
                        android:textSize="13sp" />
                </FrameLayout>

                <TextView
                    android:id="@+id/originalInfoText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="#475569"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <!-- Rotate Input Option -->
                <Button
                    android:id="@+id/btnRotateInput"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/preset_button_bg"
                    android:text="🔄 Realtime Rotate View (90°)"
                    android:textColor="#1E3A8A"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <!-- Choose Photo Button -->
                <Button
                    android:id="@+id/btnSelectPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/button_bg"
                    android:text="Select Image"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Card 2: Resize Controls -->
            <LinearLayout
                android:id="@+id/cardResize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="14dp"
                android:elevation="3dp">

                <TextView
                    android:id="@+id/lblResizeSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="Dimension Settings"
                    android:textColor="#111827"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/lblWidth"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Width (px)"
                            android:textColor="#475569"
                            android:textSize="11sp" />

                        <EditText
                            android:id="@+id/widthInput"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/input_bg"
                            android:hint="Width"
                            android:inputType="number"
                            android:paddingLeft="10dp"
                            android:paddingRight="10dp"
                            android:textColor="#111827"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"
                        android:layout_marginBottom="10dp"
                        android:text="✖"
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/lblHeight"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Height (px)"
                            android:textColor="#475569"
                            android:textSize="11sp" />

                        <EditText
                            android:id="@+id/heightInput"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/input_bg"
                            android:hint="Height"
                            android:inputType="number"
                            android:paddingLeft="10dp"
                            android:paddingRight="10dp"
                            android:textColor="#111827"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <CheckBox
                    android:id="@+id/maintainAspect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:checked="true"
                    android:text="Proportional Scaling Logic"
                    android:textColor="#334155"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Aspect Scaling Presets:"
                    android:textColor="#475569"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/preset25"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_marginRight="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/preset_button_bg"
                        android:text="25%"
                        android:textColor="#2563EB"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/preset50"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_marginLeft="2dp"
                        android:layout_marginRight="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/preset_button_bg"
                        android:text="50%"
                        android:textColor="#2563EB"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/preset75"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_marginLeft="2dp"
                        android:layout_marginRight="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/preset_button_bg"
                        android:text="75%"
                        android:textColor="#2563EB"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/preset100"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_marginLeft="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/preset_button_bg"
                        android:text="100%"
                        android:textColor="#2563EB"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/presetPassport"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginRight="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/preset_button_bg"
                        android:text="Passport Photo\n(350 x 450 px)"
                        android:textColor="#1E3A8A"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/presetSignature"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginLeft="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/preset_button_bg"
                        android:text="Signature Bounds\n(300 x 100 px)"
                        android:textColor="#1E3A8A"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="#E2E8F0" />

                <!-- Export Formats Selection -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Export Encoded File Format:"
                    android:textColor="#475569"
                    android:textSize="11sp" />

                <RadioGroup
                    android:id="@+id/formatRadioGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/radioJpg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="12dp"
                        android:checked="true"
                        android:text="JPEG (.jpg)"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/radioPng"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="12dp"
                        android:text="PNG (.png)"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/radioWebp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="WEBP (.webp)"
                        android:textSize="12sp" />
                </RadioGroup>

                <!-- Compression Quality SeekBar -->
                <LinearLayout
                    android:id="@+id/qualityLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/qualityValText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Compression Ratio: 85%"
                        android:textColor="#475569"
                        android:textSize="11sp" />

                    <SeekBar
                        android:id="@+id/qualitySeekBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:max="100"
                        android:progress="85" />
                </LinearLayout>
            </LinearLayout>

            <!-- Card 2B: Photo Enhancer & Border Customizer -->
            <LinearLayout
                android:id="@+id/cardEnhancer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="14dp"
                android:elevation="3dp">

                <TextView
                    android:id="@+id/enhancerTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="Real-time Filters &amp; Effects"
                    android:textColor="#111827"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Brightness Slider -->
                <TextView
                    android:id="@+id/lblBrightness"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Brightness Offset: 0"
                    android:textColor="#475569"
                    android:textSize="11sp" />

                <SeekBar
                    android:id="@+id/seekBarBrightness"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="10dp"
                    android:max="200"
                    android:progress="100" />

                <!-- Contrast Slider -->
                <TextView
                    android:id="@+id/lblContrast"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Contrast Scale: 1.0x"
                    android:textColor="#475569"
                    android:textSize="11sp" />

                <SeekBar
                    android:id="@+id/seekBarContrast"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="10dp"
                    android:max="150"
                    android:progress="50" />

                <!-- Quick Filters -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <Button
                        android:id="@+id/btnEnhanceAuto"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:layout_marginRight="2dp"
                        android:background="@drawable/preset_button_bg"
                        android:text="Vibrant HDR"
                        android:textColor="#2563EB"
                        android:textSize="10sp" />

                    <Button
                        android:id="@+id/btnEnhanceGray"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:layout_marginLeft="1dp"
                        android:layout_marginRight="1dp"
                        android:background="@drawable/preset_button_bg"
                        android:text="Monochrome"
                        android:textColor="#2563EB"
                        android:textSize="10sp" />

                    <Button
                        android:id="@+id/btnEnhanceReset"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:layout_marginLeft="2dp"
                        android:background="@drawable/preset_button_bg"
                        android:text="Reset Logic"
                        android:textColor="#2563EB"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Premium 3D Stereoscopic Red-Cyan Filter Trigger Button -->
                <Button
                    android:id="@+id/btn3DEffect"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/preset_button_bg"
                    android:text="🕶️ Apply Stereoscopic 3D Offset Filter"
                    android:textColor="#7C3AED"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E2E8F0"
                    android:layout_marginBottom="10dp"/>

                <!-- Border Outline controls -->
                <TextView
                    android:id="@+id/lblBorderWidth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Border Stroke Width: 0 px"
                    android:textColor="#475569"
                    android:textSize="11sp" />

                <SeekBar
                    android:id="@+id/seekBarBorderWidth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="10dp"
                    android:max="50"
                    android:progress="0" />

                <TextView
                    android:id="@+id/lblBorderColor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Border Framing Color:"
                    android:textColor="#475569"
                    android:textSize="11sp"
                    android:layout_marginBottom="5dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnBorderWhite"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:layout_marginRight="1dp"
                        android:background="@drawable/preset_button_bg"
                        android:text="White"
                        android:textColor="#000000"
                        android:textSize="9sp" />

                    <Button
                        android:id="@+id/btnBorderBlack"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:layout_marginLeft="1dp"
                        android:layout_marginRight="1dp"
                        android:background="@drawable/preset_button_bg"
                        android:text="Black"
                        android:textColor="#000000"
                        android:textSize="9sp" />

                    <Button
                        android:id="@+id/btnBorderRed"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:layout_marginLeft="1dp"
                        android:layout_marginRight="1dp"
                        android:background="@drawable/preset_button_bg"
                        android:text="Red"
                        android:textColor="#EF4444"
                        android:textSize="9sp" />

                    <Button
                        android:id="@+id/btnBorderBlue"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:layout_marginLeft="1dp"
                        android:layout_marginRight="1dp"
                        android:background="@drawable/preset_button_bg"
                        android:text="Blue"
                        android:textColor="#3B82F6"
                        android:textSize="9sp" />

                    <Button
                        android:id="@+id/btnBorderGold"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:layout_marginLeft="1dp"
                        android:background="@drawable/preset_button_bg"
                        android:text="Gold"
                        android:textColor="#D97706"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Card 3: Preview Output Resized Image (With dynamic double-sided 3D Card Flip architecture) -->
            <LinearLayout
                android:id="@+id/cardPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="14dp"
                android:elevation="5dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:id="@+id/lblResizedPreview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentLeft="true"
                        android:text="Processed Preview"
                        android:textColor="#111827"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnFlipCard"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_alignParentRight="true"
                        android:background="@drawable/preset_button_bg"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:text="🔄 3D Card Flip"
                        android:textColor="#7C3AED"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <!-- Dual Sided flipping container to display 3D card layout details -->
                <FrameLayout
                    android:id="@+id/layoutPreviewFlipContainer"
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:background="#F1F5F9">

                    <!-- Front Side View: Display Resized Photo Output -->
                    <LinearLayout
                        android:id="@+id/sidePreviewFront"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:id="@+id/resizedImageView"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="fitCenter" />

                            <TextView
                                android:id="@+id/resizedPlaceholderText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="Resized output will render inside container"
                                android:textColor="#94A3B8"
                                android:textSize="12sp" />
                        </FrameLayout>
                    </LinearLayout>

                    <!-- Back Side View: Display Premium 3D Backside Analytics Panel -->
                    <LinearLayout
                        android:id="@+id/sidePreviewBack"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#1E293B"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📊 3D Core Metrics Back-Panel"
                            android:textColor="#38BDF8"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="6dp"
                            android:layout_marginBottom="6dp"
                            android:background="#334155" />

                        <TextView
                            android:id="@+id/txtAnalyticsDimensions"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Resolution target: N/A"
                            android:textColor="#F1F5F9"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/txtAnalyticsFormat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Format profile: N/A"
                            android:textColor="#F1F5F9"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/txtAnalyticsAspect"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Aspect ratio balance: Calculating..."
                            android:textColor="#F1F5F9"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/txtAnalyticsMemory"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Allocated Texture Overhead: 0 MB"
                            android:textColor="#F1F5F9"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Tip: Touch and hold this card preview container to pivot perspective axes in active viewport space."
                            android:textColor="#94A3B8"
                            android:textSize="9sp" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/resizedInfoText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="#059669"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Rotate Output Option -->
                <Button
                    android:id="@+id/btnRotateOutput"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/preset_button_bg"
                    android:text="🔄 Spin Transformed Preview (90°)"
                    android:textColor="#1E3A8A"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Action Controls -->
    <LinearLayout
        android:id="@+id/actionBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Trigger Resize Action -->
        <Button
            android:id="@+id/btnResize"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/button_bg"
            android:enabled="false"
            android:text="Resize &amp; Style Image"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Export Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_marginRight="4dp"
                android:layout_weight="1.2"
                android:background="@drawable/button_secondary_bg"
                android:enabled="false"
                android:text="💾 Save to Device"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnShare"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_marginLeft="4dp"
                android:layout_weight="0.8"
                android:background="@drawable/button_bg"
                android:enabled="false"
                android:text="🔗 Share"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Custom Async Progress Loading Overlay -->
    <LinearLayout
        android:id="@+id/progressOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/progressMessageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Initializing Engine..."
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</RelativeLayout>