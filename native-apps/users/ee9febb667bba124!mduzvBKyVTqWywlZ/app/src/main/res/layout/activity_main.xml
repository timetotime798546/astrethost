<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA">

    <!-- SCREEN 1: DASHBOARD / HOME -->
    <LinearLayout
        android:id="@+id/screen_home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- Top Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="#2E3A59"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Creative Canvas &amp; Puzzle"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select Your Base Canvas:"
                    android:textColor="#2E3A59"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"/>

                <!-- Card Layout for Image 1 Selector -->
                <LinearLayout
                    android:id="@+id/card_image_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#FFFFFF"
                    android:elevation="4dp"
                    android:padding="10dp"
                    android:layout_marginBottom="16dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/thumbnail_1"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/asset_6a9f18319c82d"
                        android:background="#EEEEEE" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Asset Canvas One"
                        android:textColor="#2E3A59"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap to select this gorgeous futuristic landscape."
                        android:textColor="#7F8C8D"
                        android:textSize="13sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>

                <!-- Card Layout for Image 2 Selector -->
                <LinearLayout
                    android:id="@+id/card_image_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#FFFFFF"
                    android:elevation="4dp"
                    android:padding="10dp"
                    android:layout_marginBottom="24dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/thumbnail_2"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/asset_6a9f1839db93c"
                        android:background="#EEEEEE" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Asset Canvas Two"
                        android:textColor="#2E3A59"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap to select this vibrant creative art piece."
                        android:textColor="#7F8C8D"
                        android:textSize="13sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>

                <!-- Quick Mode Selectors -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select Creative Mode"
                    android:textColor="#2E3A59"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <Button
                        android:id="@+id/btn_mode_studio"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_weight="1"
                        android:layout_marginRight="8dp"
                        android:background="#3498DB"
                        android:text="Art Studio"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_mode_puzzle"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_weight="1"
                        android:layout_marginLeft="8dp"
                        android:background="#E67E22"
                        android:text="Sliding Puzzle"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_mode_about"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="16dp"
                    android:background="#2E3A59"
                    android:text="About Creative Canvas"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"/>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- SCREEN 2: ART STUDIO / FILTER OVERLAY -->
    <LinearLayout
        android:id="@+id/screen_studio"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Toolbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="#3498DB"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <Button
                android:id="@+id/btn_studio_back"
                android:layout_width="60dp"
                android:layout_height="40dp"
                android:text="Back"
                android:background="#2980B9"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Art Studio Canvas"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginLeft="16dp" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Canvas Preview Container -->
                <FrameLayout
                    android:id="@+id/studio_canvas_container"
                    android:layout_width="match_parent"
                    android:layout_height="320dp"
                    android:background="#2C3E50"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/img_studio_preview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:src="@drawable/asset_6a9f18319c82d" />

                    <!-- Floating Meme Text Overlay Custom placement -->
                    <TextView
                        android:id="@+id/txt_overlay_preview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="20dp"
                        android:text="MEME TEXT HERE"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:shadowColor="#000000"
                        android:shadowDx="2"
                        android:shadowDy="2"
                        android:shadowRadius="3"
                        android:gravity="center"
                        android:visibility="gone"/>
                </FrameLayout>

                <!-- Customizing Controllers -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Image Filters"
                    android:textColor="#2C3E50"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"/>

                <!-- Filters Row -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_filter_original"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="Original"
                            android:background="#BDC3C7"
                            android:layout_marginRight="6dp"/>

                        <Button
                            android:id="@+id/btn_filter_gray"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="Mono"
                            android:background="#BDC3C7"
                            android:layout_marginRight="6dp"/>

                        <Button
                            android:id="@+id/btn_filter_sepia"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="Sepia"
                            android:background="#BDC3C7"
                            android:layout_marginRight="6dp"/>

                        <Button
                            android:id="@+id/btn_filter_invert"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="Invert"
                            android:background="#BDC3C7"
                            android:layout_marginRight="6dp"/>

                        <Button
                            android:id="@+id/btn_filter_warm"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="Warm"
                            android:background="#BDC3C7" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Text Overlay Builder -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dynamic Text Overlay"
                    android:textColor="#2C3E50"
                    android:textStyle="bold"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/edt_overlay_text"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Type something creative..."
                    android:background="#FFFFFF"
                    android:paddingHorizontal="12dp"
                    android:inputType="textCapCharacters"
                    android:textColor="#2C3E50"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Color: "
                        android:textColor="#2C3E50" />

                    <!-- Horizontal Palette -->
                    <View
                        android:id="@+id/color_palette_white"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="#FFFFFF"
                        android:layout_marginLeft="10dp"/>

                    <View
                        android:id="@+id/color_palette_yellow"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="#F1C40F"
                        android:layout_marginLeft="10dp"/>

                    <View
                        android:id="@+id/color_palette_red"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="#E74C3C"
                        android:layout_marginLeft="10dp"/>

                    <View
                        android:id="@+id/color_palette_blue"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="#3498DB"
                        android:layout_marginLeft="10dp"/>

                    <View
                        android:id="@+id/color_palette_green"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="#2ECC71"
                        android:layout_marginLeft="10dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Font Size: "
                        android:textColor="#2C3E50" />

                    <Button
                        android:id="@+id/btn_size_decrease"
                        android:layout_width="40dp"
                        android:layout_height="36dp"
                        android:text="-"
                        android:background="#BDC3C7"
                        android:layout_marginLeft="12dp"/>

                    <TextView
                        android:id="@+id/txt_font_size_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="22sp"
                        android:textStyle="bold"
                        android:textColor="#2C3E50"
                        android:layout_marginLeft="12dp"
                        android:layout_marginRight="12dp"/>

                    <Button
                        android:id="@+id/btn_size_increase"
                        android:layout_width="40dp"
                        android:layout_height="36dp"
                        android:text="+"
                        android:background="#BDC3C7" />
                </LinearLayout>

                <!-- Actions -->
                <Button
                    android:id="@+id/btn_reset_canvas"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="20dp"
                    android:background="#95A5A6"
                    android:text="Reset Canvas Editor"
                    android:textColor="#FFFFFF" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- SCREEN 3: SLIDING PUZZLE -->
    <LinearLayout
        android:id="@+id/screen_puzzle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Toolbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="#E67E22"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <Button
                android:id="@+id/btn_puzzle_back"
                android:layout_width="60dp"
                android:layout_height="40dp"
                android:text="Back"
                android:background="#D35400"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Canvas Sliding Puzzle"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginLeft="16dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center_horizontal">

            <!-- Move counters -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_horizontal"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/txt_puzzle_moves"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Moves: 0"
                    android:textColor="#2C3E50"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginRight="30dp"/>

                <TextView
                    android:id="@+id/txt_puzzle_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status: Unshuffled"
                    android:textColor="#E67E22"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Playable 3x3 Grid Layout Container -->
            <FrameLayout
                android:layout_width="320dp"
                android:layout_height="320dp"
                android:background="#34495E"
                android:padding="4dp">

                <GridLayout
                    android:id="@+id/puzzle_grid_layout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:columnCount="3"
                    android:rowCount="3" />
            </FrameLayout>

            <!-- Buttons bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp"
                android:weightSum="2">

                <Button
                    android:id="@+id/btn_puzzle_shuffle"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_marginRight="8dp"
                    android:background="#27AE60"
                    android:text="Shuffle &amp; Start"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"/>

                <Button
                    android:id="@+id/btn_puzzle_solve_cheat"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="8dp"
                    android:background="#95A5A6"
                    android:text="Cheat/Reset"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap neighboring tiles of the dark cell to slide and reconstruct your chosen gorgeous asset image."
                android:textColor="#7F8C8D"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginTop="20dp" />

        </LinearLayout>
    </LinearLayout>

    <!-- SCREEN 4: ABOUT CREATIVE CANVAS -->
    <LinearLayout
        android:id="@+id/screen_about"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Toolbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="#2E3A59"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <Button
                android:id="@+id/btn_about_back"
                android:layout_width="60dp"
                android:layout_height="40dp"
                android:text="Back"
                android:background="#1F283E"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="About Creative Canvas"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginLeft="16dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:src="@drawable/icon"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Creative Canvas"
                android:textColor="#2E3A59"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Version 1.0.0"
                android:textColor="#7F8C8D"
                android:textSize="14sp"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="This application is crafted with advanced dynamic features to offer direct interactions with top-tier graphic assets. Load art seamlessly, apply gorgeous monochrome filters, and play advanced slide puzzles generated dynamically."
                android:textColor="#2C3E50"
                android:textSize="15sp"
                android:lineSpacingMultiplier="1.2"
                android:gravity="center"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Created using native Java development &amp; zero-dependency UI performance styling."
                android:textColor="#95A5A6"
                android:textSize="13sp"
                android:gravity="center" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>