<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F6FA">

    <!-- Top App Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#1A237E"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="Java Web Server"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_ip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:textColor="#00E5FF"
            android:textSize="12sp"
            android:text="IP: --" />
    </RelativeLayout>

    <!-- Tab Selection Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:elevation="4dp">

        <Button
            android:id="@+id/tab_server"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Server Console"
            android:background="?android:attr/selectableItemBackground"
            android:textColor="#1A237E"
            android:textStyle="bold" />

        <Button
            android:id="@+id/tab_files"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="File Manager"
            android:background="?android:attr/selectableItemBackground"
            android:textColor="#757575" />
    </LinearLayout>

    <!-- Main Dynamic Content Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- PANEL 1: SERVER CONTROL PANEL -->
        <LinearLayout
            android:id="@+id/panel_server"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#FFFFFF"
                android:padding="12dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Server State"
                        android:textSize="12sp"
                        android:textColor="#757575" />

                    <TextView
                        android:id="@+id/txt_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OFFLINE (PORT 3399)"
                        android:textColor="#D32F2F"
                        android:textStyle="bold"
                        android:textSize="16sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_start_stop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="START"
                    android:backgroundTint="#2E7D32"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <!-- Logs / Output Terminal Window -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Connection Stream Logs"
                android:textColor="#757575"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <ScrollView
                android:id="@+id/scroll_logs"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#121212"
                android:padding="10dp">

                <TextView
                    android:id="@+id/txt_logs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="#00FF66"
                    android:textSize="12sp"
                    android:text="Web server operational. Tap START to host server on port 3399.\nSupports 1000 simultaneous connections under native concurrent execution pools.\n" />
            </ScrollView>
        </LinearLayout>

        <!-- PANEL 2: FILE MANAGER PANEL -->
        <LinearLayout
            android:id="@+id/panel_files"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="Web Root Files"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1A237E" />

                <Button
                    android:id="@+id/btn_new_file"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="+ Create"
                    android:textSize="12sp"
                    android:backgroundTint="#1A237E"
                    android:textColor="#FFFFFF" />
            </RelativeLayout>

            <ListView
                android:id="@+id/list_files"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#FFFFFF"
                android:elevation="1dp"
                android:divider="#EEEEEE"
                android:dividerHeight="1dp" />
        </LinearLayout>

        <!-- PANEL 3: TEXT EDITOR OVERLAY -->
        <LinearLayout
            android:id="@+id/panel_editor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:visibility="gone">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/editor_file_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="editing: index.html"
                    android:textColor="#212121"
                    android:textStyle="bold"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_editor_cancel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="?android:attr/buttonStyleSmall"
                        android:text="Cancel"
                        android:backgroundTint="#E0E0E0"
                        android:textColor="#212121"
                        android:layout_marginEnd="6dp"/>

                    <Button
                        android:id="@+id/btn_editor_save"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="?android:attr/buttonStyleSmall"
                        android:text="Save"
                        android:backgroundTint="#1A237E"
                        android:textColor="#FFFFFF" />
                </LinearLayout>
            </RelativeLayout>

            <EditText
                android:id="@+id/edit_file_content"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#F9F9F9"
                android:gravity="top|start"
                android:hint="Write HTML, CSS, JS code here..."
                android:fontFamily="monospace"
                android:inputType="textMultiLine|textNoSuggestions"
                android:padding="12dp"
                android:scrollbars="vertical"
                android:textSize="14sp" />
        </LinearLayout>

    </FrameLayout>
</LinearLayout>