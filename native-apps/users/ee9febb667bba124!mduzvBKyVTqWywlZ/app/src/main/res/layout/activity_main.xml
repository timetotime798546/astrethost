<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F4F6">

    <!-- Top Header Toolbar -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#1E3A8A"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Photo Resizer Pro"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="अपनी फ़ोटो का आकार और साइज़ तुरंत बदलें"
            android:textColor="#93C5FD"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Main Scrollable Body Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/actionBottomBar"
        android:layout_below="@id/headerBar"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card 1: Selected Photo Container / Display -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="आपकी चुनी हुई फ़ोटो (Selected Photo)"
                    android:textColor="#111827"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:background="#E5E7EB">

                    <ImageView
                        android:id="@+id/originalImageView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:id="@+id/placeholderText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:padding="12dp"
                        android:text="गैलरी से फ़ोटो चुनने के लिए\nनीचे दिए गए बटन पर क्लिक करें"
                        android:textColor="#6B7280"
                        android:textSize="14sp" />
                </FrameLayout>

                <TextView
                    android:id="@+id/originalInfoText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="#4B5563"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <!-- Choose Photo Button -->
                <Button
                    android:id="@+id/btnSelectPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/button_bg"
                    android:text="गैलरी से फ़ोटो चुनें (Choose Photo)"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Card 2: Resize Controls -->
            <LinearLayout
                android:id="@+id/resizeOptionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="रीसाइज़ सेटिंग (Resize Options)"
                    android:textColor="#111827"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Side by side Width & Height input fields -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Width Input Box -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="चौड़ाई (Width - px)"
                            android:textColor="#4B5563"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/widthInput"
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/input_bg"
                            android:hint="उदा. 1080"
                            android:inputType="number"
                            android:paddingLeft="10dp"
                            android:paddingRight="10dp"
                            android:textColor="#111827" />
                    </LinearLayout>

                    <!-- Spacing / Separator symbol -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"
                        android:layout_marginBottom="12dp"
                        android:text="✖"
                        android:textColor="#9CA3AF"
                        android:textSize="14sp" />

                    <!-- Height Input Box -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ऊंचाई (Height - px)"
                            android:textColor="#4B5563"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/heightInput"
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/input_bg"
                            android:hint="उदा. 1920"
                            android:inputType="number"
                            android:paddingLeft="10dp"
                            android:paddingRight="10dp"
                            android:textColor="#111827" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Checkbox to maintain Aspect Ratio -->
                <CheckBox
                    android:id="@+id/maintainAspect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:checked="true"
                    android:text="पहलू अनुपात बनाए रखें (Lock Aspect Ratio)"
                    android:textColor="#374151"
                    android:textSize="13sp" />

                <!-- Presets Quick Sizing Row -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="त्वरित प्रीसेट (Presets):"
                    android:textColor="#4B5563"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/preset25"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginRight="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/preset_button_bg"
                        android:text="25%"
                        android:textColor="#2563EB"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/preset50"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginLeft="2dp"
                        android:layout_marginRight="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/preset_button_bg"
                        android:text="50%"
                        android:textColor="#2563EB"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/preset75"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginLeft="2dp"
                        android:layout_marginRight="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/preset_button_bg"
                        android:text="75%"
                        android:textColor="#2563EB"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/preset100"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginLeft="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/preset_button_bg"
                        android:text="100%"
                        android:textColor="#2563EB"
                        android:textSize="12sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="#E5E7EB" />

                <!-- Export Formats Selection -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="फ़ोटो प्रारूप चुनें (Select Image Format):"
                    android:textColor="#4B5563"
                    android:textSize="12sp" />

                <RadioGroup
                    android:id="@+id/formatRadioGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/radioJpg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="16dp"
                        android:checked="true"
                        android:text="JPEG (.jpg)" />

                    <RadioButton
                        android:id="@+id/radioPng"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="16dp"
                        android:text="PNG (.png)" />

                    <RadioButton
                        android:id="@+id/radioWebp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="WEBP (.webp)" />
                </RadioGroup>

                <!-- Compression Quality SeekBar -->
                <LinearLayout
                    android:id="@+id/qualityLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/qualityValText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="गुणवत्ता (Compression Quality): 85%"
                        android:textColor="#4B5563"
                        android:textSize="12sp" />

                    <SeekBar
                        android:id="@+id/qualitySeekBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:max="100"
                        android:progress="85" />
                </LinearLayout>
            </LinearLayout>

            <!-- Card 3: Preview Output Resized Image -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="रीसाइज़ का पूर्वावलोकन (Preview Resized)"
                    android:textColor="#111827"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:background="#F3F4F6">

                    <ImageView
                        android:id="@+id/resizedImageView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:id="@+id/resizedPlaceholderText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="यहाँ रीसाइज़ की हुई फ़ोटो दिखेगी"
                        android:textColor="#9CA3AF"
                        android:textSize="13sp" />
                </FrameLayout>

                <TextView
                    android:id="@+id/resizedInfoText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="#047857"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Action Controls -->
    <LinearLayout
        android:id="@id/actionBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Trigger Resize Action -->
        <Button
            android:id="@+id/btnResize"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/button_bg"
            android:enabled="false"
            android:text="रीसाइज़ करें (Resize Image)"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Export Buttons (Save and Share side by side) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginRight="6dp"
                android:layout_weight="1.2"
                android:background="@drawable/button_secondary_bg"
                android:enabled="false"
                android:text="💾 गैलरी में सेव करें"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnShare"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginLeft="6dp"
                android:layout_weight="0.8"
                android:background="@drawable/button_bg"
                android:enabled="false"
                android:text="🔗 शेयर करें"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Custom Async Progress Loading Overlay -->
    <LinearLayout
        android:id="@+id/progressOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/progressMessageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="रीसाइज़ प्रक्रिया चालू है..."
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</RelativeLayout>