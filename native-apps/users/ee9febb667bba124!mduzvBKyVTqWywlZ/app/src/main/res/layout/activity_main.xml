<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Custom Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Photo Resizer Pro"
                    android:textColor="#212121"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Resize &amp; compress images instantly"
                    android:textColor="#757575"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Selection Panel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Source Image"
                android:textColor="#2E7D32"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <ImageView
                android:id="@+id/ivOriginalPreview"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="#E0E0E0"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_gallery"
                android:layout_marginBottom="12dp"
                android:contentDescription="Original Preview" />

            <TextView
                android:id="@+id/tvOriginalStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No image selected"
                android:textColor="#424242"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnPickImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Choose Image from Gallery"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2E7D32" />
        </LinearLayout>

        <!-- Resize Panel -->
        <LinearLayout
            android:id="@+id/layoutSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="2dp"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resize Configurations"
                android:textColor="#1976D2"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- Width & Height -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Width (px)"
                        android:textSize="12sp"
                        android:textColor="#757575" />

                    <EditText
                        android:id="@+id/etWidth"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:hint="Width"
                        android:textSize="16sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Height (px)"
                        android:textSize="12sp"
                        android:textColor="#757575" />

                    <EditText
                        android:id="@+id/etHeight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:hint="Height"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <CheckBox
                android:id="@+id/cbLockRatio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lock Aspect Ratio"
                android:checked="true"
                android:layout_marginBottom="16dp" />

            <!-- Percent Scaling Shortcuts -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quick Scales"
                android:textSize="12sp"
                android:textColor="#757575"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btnScale25"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="25%"
                    style="?android:attr/buttonStyleSmall"
                    android:backgroundTint="#F0F0F0"
                    android:textColor="#212121"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnScale50"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="50%"
                    style="?android:attr/buttonStyleSmall"
                    android:backgroundTint="#F0F0F0"
                    android:textColor="#212121"
                    android:layout_marginHorizontal="2dp" />

                <Button
                    android:id="@+id/btnScale75"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="75%"
                    style="?android:attr/buttonStyleSmall"
                    android:backgroundTint="#F0F0F0"
                    android:textColor="#212121"
                    android:layout_marginHorizontal="2dp" />

                <Button
                    android:id="@+id/btnScaleOriginal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:text="Reset"
                    style="?android:attr/buttonStyleSmall"
                    android:backgroundTint="#F0F0F0"
                    android:textColor="#212121"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <!-- Encoding & Quality Options -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Output Format"
                android:textSize="12sp"
                android:textColor="#757575"
                android:layout_marginBottom="6dp" />

            <RadioGroup
                android:id="@+id/rgFormat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <RadioButton
                    android:id="@+id/rbJpeg"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="JPEG"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/rbPng"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="PNG" />

                <RadioButton
                    android:id="@+id/rbWebp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="WEBP" />
            </RadioGroup>

            <!-- Quality Slider -->
            <LinearLayout
                android:id="@+id/layoutQuality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Compression Quality"
                        android:textSize="12sp"
                        android:textColor="#757575" />

                    <TextView
                        android:id="@+id/tvQualityValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="85%"
                        android:textSize="12sp"
                        android:textColor="#1976D2"
                        android:textStyle="bold" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/sbQuality"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="85"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnResize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Process and Scale"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1976D2" />
        </LinearLayout>

        <!-- Result/Output Panel -->
        <LinearLayout
            android:id="@+id/layoutResizedResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="2dp"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Output Result"
                android:textColor="#E65100"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <ImageView
                android:id="@+id/ivResizedPreview"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="#E0E0E0"
                android:scaleType="fitCenter"
                android:layout_marginBottom="12dp"
                android:contentDescription="Resized Preview" />

            <TextView
                android:id="@+id/tvResizedStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Processing finished"
                android:textColor="#424242"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSave"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Save to Gallery"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2E7D32"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnShare"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Share Image"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#E65100"
                    android:layout_marginStart="6dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>