<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/window_bg">

    <!-- MAIN CALCULATOR INTERFACE -->
    <LinearLayout
        android:id="@+id/layout_calculator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="visible">

        <!-- HEADER BAR WITH SOUND TOGGLE AND HISTORY TRIGGER -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="Sleek Calc"
                android:textColor="@color/text_main"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <!-- SOUND ENABLE/DISABLE BUTTON -->
                <Button
                    android:id="@+id/btn_toggle_sound"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/btn_number"
                    android:text="🔊"
                    android:textColor="@color/text_main"
                    android:textSize="16sp" />

                <!-- VIEW HISTORY OVERLAY TRIGGERS -->
                <Button
                    android:id="@+id/btn_open_history"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/btn_number"
                    android:text="📜"
                    android:textColor="@color/text_main"
                    android:textSize="16sp" />
            </LinearLayout>
        </RelativeLayout>

        <!-- DISPLAY SCREEN CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.2"
            android:background="@drawable/display_border"
            android:gravity="bottom|end"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <!-- Formula Expression -->
            <TextView
                android:id="@+id/txt_expression"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="start"
                android:singleLine="true"
                android:text=""
                android:textColor="@color/text_sub"
                android:textSize="22sp" />

            <!-- Input / Result View -->
            <TextView
                android:id="@+id/txt_display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="start"
                android:singleLine="true"
                android:text="0"
                android:textColor="@color/text_main"
                android:textSize="44sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- CONTROLS & KEYPAD GRID -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3.2"
            android:orientation="vertical">

            <!-- ROW 1 (AC, DEL, PERCENT, DIVIDE) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_clear"
                    style="@style/CalculatorButton"
                    android:background="@drawable/btn_action"
                    android:text="AC" />

                <TextView
                    android:id="@+id/btn_delete"
                    style="@style/CalculatorButton"
                    android:background="@drawable/btn_operator"
                    android:text="⌫" />

                <TextView
                    android:id="@+id/btn_percent"
                    style="@style/CalculatorButton"
                    android:background="@drawable/btn_operator"
                    android:text="%" />

                <TextView
                    android:id="@+id/btn_divide"
                    style="@style/CalculatorButton"
                    android:background="@drawable/btn_operator"
                    android:text="÷"
                    android:textColor="@color/accent_orange" />
            </LinearLayout>

            <!-- ROW 2 (7, 8, 9, MULTIPLY) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_7"
                    style="@style/CalculatorButton"
                    android:background="@drawable/btn_number"
                    android:text="7" />

                <TextView
                    android:id="@+id/btn_8"
                    style="@style/CalculatorButton"
                    android:background="@drawable/btn_number"
                    android:text="8" />

                <TextView
                    android:id="@+id/btn_9"
                    style="@style/CalculatorButton"
                    android:background="@drawable/btn_number"
                    android:text="9" />

                <TextView
                    android:id="@+id/btn_multiply"
                    style="@style/CalculatorButton"
                    android:background="@drawable/btn_operator"
                    android:text="×"
                    android:textColor="@color/accent_orange" />
            </LinearLayout>

            <!-- ROW 3 (4, 5, 6, MINUS) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_4"
                    style="@style/CalculatorButton"
                    android:background="@drawable/btn_number"
                    android:text="4" />

                <TextView
                    android:id="@+id/btn_5"
                    style="@style/CalculatorButton"
                    android:background="@drawable/btn_number"
                    android:text="5" />

                <TextView
                    android:id="@+id/btn_6"
                    style="@style/CalculatorButton"
                    android:background="@drawable/btn_number"
                    android:text="6" />

                <TextView
                    android:id="@+id/btn_subtract"
                    style="@style/CalculatorButton"
                    android:background="@drawable/btn_operator"
                    android:text="-"
                    android:textColor="@color/accent_orange" />
            </LinearLayout>

            <!-- ROW 4 (1, 2, 3, PLUS) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_1"
                    style="@style/CalculatorButton"
                    android:background="@drawable/btn_number"
                    android:text="1" />

                <TextView
                    android:id="@+id/btn_2"
                    style="@style/CalculatorButton"
                    android:background="@drawable/btn_number"
                    android:text="2" />

                <TextView
                    android:id="@+id/btn_3"
                    style="@style/CalculatorButton"
                    android:background="@drawable/btn_number"
                    android:text="3" />

                <TextView
                    android:id="@+id/btn_add"
                    style="@style/CalculatorButton"
                    android:background="@drawable/btn_operator"
                    android:text="+"
                    android:textColor="@color/accent_orange" />
            </LinearLayout>

            <!-- ROW 5 (00, 0, DOT, EQUALS) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_double_zero"
                    style="@style/CalculatorButton"
                    android:background="@drawable/btn_number"
                    android:text="00" />

                <TextView
                    android:id="@+id/btn_0"
                    style="@style/CalculatorButton"
                    android:background="@drawable/btn_number"
                    android:text="0" />

                <TextView
                    android:id="@+id/btn_dot"
                    style="@style/CalculatorButton"
                    android:background="@drawable/btn_number"
                    android:text="." />

                <TextView
                    android:id="@+id/btn_equals"
                    style="@style/CalculatorButton"
                    android:background="@drawable/btn_operator"
                    android:text="="
                    android:textColor="@color/accent_indigo" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- OVERLAY SLIDABLE HISTORY LIST DRAWER -->
    <LinearLayout
        android:id="@+id/panel_history"
        android:layout_width="match_parent"
        android:layout_height="420dp"
        android:layout_gravity="bottom"
        android:background="@drawable/history_border"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <!-- History Top Control Strip -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="@string/history_title"
                android:textColor="@color/accent_indigo"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_clear_history"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/btn_number"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:text="Clear All"
                    android:textColor="@color/accent_orange"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_close_history"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/btn_action"
                    android:text="✕"
                    android:textColor="@color/text_main"
                    android:textSize="12sp" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Scrollable list of items -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fadeScrollbars="true">

            <LinearLayout
                android:id="@+id/list_history_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <!-- IMMERSIVE SIMULATED LOADER LAYOUT -->
    <RelativeLayout
        android:id="@+id/layout_loader"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/loader_bg"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <!-- High Quality Branding -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/loader_title"
                android:textColor="@color/text_main"
                android:textSize="38sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/loader_subtitle"
                android:textColor="@color/accent_indigo"
                android:textSize="14sp"
                android:letterSpacing="0.05" />

            <!-- Circular Loading Animation -->
            <ProgressBar
                android:id="@+id/loader_progress"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginTop="32dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/accent_orange" />

            <!-- Informational Loading Text -->
            <TextView
                android:id="@+id/txt_loader_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/loader_text"
                android:textColor="@color/text_sub"
                android:textSize="13sp" />
        </LinearLayout>
    </RelativeLayout>

</FrameLayout>