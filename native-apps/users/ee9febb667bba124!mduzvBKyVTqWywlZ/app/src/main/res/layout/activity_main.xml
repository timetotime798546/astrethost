<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F7"
    android:padding="16dp">

    <!-- Top Action Header -->
    <RelativeLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:text="Gemini Assistant"
            android:textColor="#212121"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:background="#E0E0E0"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="⚙ Settings"
            android:textColor="#333333"
            android:textSize="12sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Visual Transcript Display Area -->
    <LinearLayout
        android:id="@+id/display_box"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/controls_container"
        android:layout_below="@+id/header_layout"
        android:background="@drawable/card_bg"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Conversation Log"
            android:textColor="#757575"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <ScrollView
            android:id="@+id/log_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <TextView
                android:id="@+id/txt_conversation_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:text="Hi! Tap the blue mic below and ask me anything, or try saying 'open Camera' or 'open Chrome'!"
                android:textColor="#424242"
                android:textSize="16sp"
                android:lineSpacingMultiplier="1.2" />
        </ScrollView>
    </LinearLayout>

    <!-- Dynamic Action and Command Controls Container -->
    <LinearLayout
        android:id="@+id/controls_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/txt_status_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Ready to listen"
            android:textColor="#757575"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_record_trigger"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:background="@drawable/mic_button_bg"
            android:elevation="6dp"
            android:text="🎤"
            android:textColor="#FFFFFF"
            android:textSize="32sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Tap circular microphone to start speaking"
            android:textColor="#9E9E9E"
            android:textSize="11sp" />
    </LinearLayout>

</RelativeLayout>