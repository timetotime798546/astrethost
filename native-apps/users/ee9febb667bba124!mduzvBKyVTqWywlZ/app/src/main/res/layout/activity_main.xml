<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6F9">

    <!-- Top Navigation Header / Tabs Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1F2937"
        android:padding="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AI Studio"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <Button
            android:id="@+id/btn_tab_chat"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="AI Chat"
            android:textSize="12sp"
            android:background="#3B82F6"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn_tab_files"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="My Files"
            android:textSize="12sp"
            android:background="#4B5563"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn_tab_settings"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="API Key"
            android:textSize="12sp"
            android:background="#4B5563"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Main Content Panels -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- PANEL 1: AI CHAT WORKSPACE -->
        <LinearLayout
            android:id="@+id/panel_chat"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="visible"
            android:padding="12dp">

            <!-- Prompt Context/File Attachment Bar -->
            <LinearLayout
                android:id="@+id/layout_attachment_indicator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#FEF3C7"
                android:padding="8dp"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txt_attached_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Attached File: code.txt"
                    android:textColor="#92400E"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_detach_file"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:text="Detach"
                    android:textSize="10sp"
                    android:textColor="#92400E"
                    android:background="#FDE68A" />
            </LinearLayout>

            <!-- Scrollable Chat Stream -->
            <ScrollView
                android:id="@+id/scroll_chat"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="8dp"
                android:background="#FFFFFF">

                <LinearLayout
                    android:id="@+id/container_chat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp" />
            </ScrollView>

            <!-- Bottom Control: File Attacher + Prompt Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btn_attach_file_dialog"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="📎"
                    android:textSize="18sp"
                    android:textColor="#374151"
                    android:background="#E5E7EB"
                    android:layout_marginEnd="6dp" />

                <EditText
                    android:id="@+id/edit_prompt"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:hint="Type your prompt..."
                    android:textColor="#111827"
                    android:background="#FFFFFF"
                    android:padding="8dp"
                    android:textSize="14sp"
                    android:inputType="textLongMessage"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_send_prompt"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="Send"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:background="#3B82F6" />
            </LinearLayout>
        </LinearLayout>

        <!-- PANEL 2: MY FILES VAULT -->
        <LinearLayout
            android:id="@+id/panel_files"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="12dp">

            <!-- Top File Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Document Explorer"
                    android:textColor="#374151"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_create_new_file"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="＋ Add File"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:background="#10B981" />
            </LinearLayout>

            <!-- Files List Dynamic Section -->
            <ListView
                android:id="@+id/list_stored_files"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#FFFFFF"
                android:divider="#E5E7EB"
                android:dividerHeight="1dp" />

            <!-- File Edit/Creation Overlay Editor Panel -->
            <LinearLayout
                android:id="@+id/layout_file_editor"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:visibility="gone"
                android:elevation="4dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/txt_editor_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Edit Document"
                    android:textColor="#1F2937"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <EditText
                    android:id="@+id/edit_file_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="File Name (e.g., source.txt)"
                    android:inputType="text"
                    android:textColor="#111827"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <EditText
                    android:id="@+id/edit_file_content"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:hint="Type the code or message contents here..."
                    android:gravity="top"
                    android:inputType="textMultiLine"
                    android:textColor="#374151"
                    android:textSize="13sp"
                    android:background="#F9FAFB"
                    android:padding="8dp"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end">

                    <Button
                        android:id="@+id/btn_editor_cancel"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Cancel"
                        android:textColor="#374151"
                        android:background="#E5E7EB"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btn_editor_save"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Save Code"
                        android:textColor="#FFFFFF"
                        android:background="#10B981" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- PANEL 3: API / CONFIG SETTINGS -->
        <ScrollView
            android:id="@+id/panel_settings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:padding="16dp"
            android:background="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="AI Engine Settings"
                    android:textColor="#1F2937"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Equip AI File Companion with real API keys or operate in Simulation Sandbox mode dynamically."
                    android:textColor="#6B7280"
                    android:textSize="13sp"
                    android:layout_marginBottom="20dp" />

                <!-- API Key Input Field -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Gemini Developer Key"
                    android:textColor="#374151"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/edit_api_key"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter Gemini API Key..."
                    android:inputType="textPassword"
                    android:textColor="#111827"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Your key stays secure in localized configurations on this hardware device."
                    android:textColor="#9CA3AF"
                    android:textSize="11sp"
                    android:layout_marginBottom="24dp" />

                <!-- Operating Mode Selection -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Active Engine Selection"
                    android:textColor="#374151"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <RadioButton
                    android:id="@+id/radio_real_api"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Connect Live Gemini LLM Engine"
                    android:textColor="#1F2937"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/radio_mock_api"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Run Local Simulated Sandbox Developer (Free / Mock responses)"
                    android:textColor="#1F2937"
                    android:textSize="13sp"
                    android:checked="true"
                    android:layout_marginBottom="24dp" />

                <!-- Trigger Button to Save -->
                <Button
                    android:id="@+id/btn_save_config"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Save &amp; Update Configuration"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:background="#3B82F6" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>