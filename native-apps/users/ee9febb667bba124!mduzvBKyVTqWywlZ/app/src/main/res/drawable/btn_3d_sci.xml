<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="2dp">
                <shape>
                    <solid android:color="#1B4F72" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:top="3dp" android:bottom="0dp" android:left="1dp" android:right="1dp">
                <shape>
                    <gradient 
                        android:startColor="#21618C" 
                        android:endColor="#1A5276" 
                        android:angle="270" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="4dp">
                <shape>
                    <solid android:color="#0E334E" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:bottom="4dp" android:left="1dp" android:right="1dp">
                <shape>
                    <gradient 
                        android:startColor="#3498DB" 
                        android:endColor="#2980B9" 
                        android:angle="270" />
                    <corners android:radius="8dp" />
                    <stroke android:width="1.5dp" android:color="#5DADE2" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>