<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="2dp">
                <shape>
                    <solid android:color="#4A0E0E" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:top="3dp" android:bottom="0dp" android:left="1dp" android:right="1dp">
                <shape>
                    <gradient 
                        android:startColor="#962D22" 
                        android:endColor="#78241C" 
                        android:angle="270" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="4dp">
                <shape>
                    <solid android:color="#360A0A" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:bottom="4dp" android:left="1dp" android:right="1dp">
                <shape>
                    <gradient 
                        android:startColor="#E74C3C" 
                        android:endColor="#C0392B" 
                        android:angle="270" />
                    <corners android:radius="8dp" />
                    <stroke android:width="1.5dp" android:color="#FF7666" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>