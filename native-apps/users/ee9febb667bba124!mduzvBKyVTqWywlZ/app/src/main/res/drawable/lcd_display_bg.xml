<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Physical Outer Bezel (Gutter Shadow) -->
    <item>
        <shape>
            <solid android:color="#111314" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Screen Glass Backlight -->
    <item android:top="4dp" android:bottom="4dp" android:left="4dp" android:right="4dp">
        <shape>
            <gradient 
                android:startColor="@color/lcd_bg_start" 
                android:endColor="@color/lcd_bg_end" 
                android:angle="270" />
            <corners android:radius="11dp" />
            <stroke android:width="2dp" android:color="@color/lcd_glow" />
        </shape>
    </item>
</layer-list>