<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="2dp">
                <shape>
                    <solid android:color="#803300" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:top="3dp" android:bottom="0dp" android:left="1dp" android:right="1dp">
                <shape>
                    <gradient 
                        android:startColor="#D35400" 
                        android:endColor="#A04000" 
                        android:angle="270" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="4dp">
                <shape>
                    <solid android:color="#602000" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:bottom="4dp" android:left="1dp" android:right="1dp">
                <shape>
                    <gradient 
                        android:startColor="#FF8F3D" 
                        android:endColor="#E67E22" 
                        android:angle="270" />
                    <corners android:radius="8dp" />
                    <stroke android:width="1.5dp" android:color="#FFA663" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>