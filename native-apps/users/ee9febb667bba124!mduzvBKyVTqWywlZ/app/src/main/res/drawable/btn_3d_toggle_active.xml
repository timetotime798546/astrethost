<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="2dp">
        <shape>
            <solid android:color="#006652" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:top="3dp" android:bottom="0dp" android:left="1dp" android:right="1dp">
        <shape>
            <gradient 
                android:startColor="#00FFCC" 
                android:endColor="#16A085" 
                android:angle="270" />
            <corners android:radius="8dp" />
            <stroke android:width="1.5dp" android:color="#E0FFF9" />
        </shape>
    </item>
</layer-list>