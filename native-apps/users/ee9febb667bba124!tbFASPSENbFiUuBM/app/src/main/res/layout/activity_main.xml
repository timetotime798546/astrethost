<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:weightSum="10">

    <!-- Calculation Display Panels -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3.5"
        android:orientation="vertical"
        android:gravity="bottom|end"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingBottom="24dp">

        <!-- Upper expression output stream -->
        <TextView
            android:id="@+id/tvFormula"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="#8E8E93"
            android:textSize="24sp"
            android:maxLines="1"
            android:ellipsize="start"
            android:text="" />

        <!-- Output display result frame -->
        <TextView
            android:id="@+id/tvDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="#FFFFFF"
            android:textSize="54sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="0"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- Calculator Keyboard Keypad Matrix -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="6.5"
        android:orientation="vertical"
        android:padding="12dp"
        android:weightSum="5">

        <!-- Keyboard Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:weightSum="4"
            android:layout_marginBottom="4dp">

            <Button
                android:id="@+id/btn_c"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:text="C"
                android:textSize="24sp"
                android:textColor="#000000"
                android:background="@drawable/btn_function" />

            <Button
                android:id="@+id/btn_bracket_open"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:text="("
                android:textSize="24sp"
                android:textColor="#000000"
                android:background="@drawable/btn_function" />

            <Button
                android:id="@+id/btn_bracket_close"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:text=")"
                android:textSize="24sp"
                android:textColor="#000000"
                android:background="@drawable/btn_function" />

            <Button
                android:id="@+id/btn_divide"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:text="÷"
                android:textSize="26sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_operator" />
        </LinearLayout>

        <!-- Keyboard Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:weightSum="4"
            android:layout_marginBottom="4dp">

            <Button
                android:id="@+id/btn_7"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:text="7"
                android:textSize="24sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_numeric" />

            <Button
                android:id="@+id/btn_8"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:text="8"
                android:textSize="24sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_numeric" />

            <Button
                android:id="@+id/btn_9"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:text="9"
                android:textSize="24sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_numeric" />

            <Button
                android:id="@+id/btn_multiply"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:text="×"
                android:textSize="26sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_operator" />
        </LinearLayout>

        <!-- Keyboard Row 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:weightSum="4"
            android:layout_marginBottom="4dp">

            <Button
                android:id="@+id/btn_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:text="4"
                android:textSize="24sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_numeric" />

            <Button
                android:id="@+id/btn_5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:text="5"
                android:textSize="24sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_numeric" />

            <Button
                android:id="@+id/btn_6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:text="6"
                android:textSize="24sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_numeric" />

            <Button
                android:id="@+id/btn_subtract"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:text="−"
                android:textSize="26sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_operator" />
        </LinearLayout>

        <!-- Keyboard Row 4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:weightSum="4"
            android:layout_marginBottom="4dp">

            <Button
                android:id="@+id/btn_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:text="1"
                android:textSize="24sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_numeric" />

            <Button
                android:id="@+id/btn_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:text="2"
                android:textSize="24sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_numeric" />

            <Button
                android:id="@+id/btn_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:text="3"
                android:textSize="24sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_numeric" />

            <Button
                android:id="@+id/btn_add"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:text="+"
                android:textSize="26sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_operator" />
        </LinearLayout>

        <!-- Keyboard Row 5 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:weightSum="4">

            <Button
                android:id="@+id/btn_backspace"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:text="⌫"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_numeric" />

            <Button
                android:id="@+id/btn_0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:text="0"
                android:textSize="24sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_numeric" />

            <Button
                android:id="@+id/btn_dot"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:text="."
                android:textSize="24sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_numeric" />

            <Button
                android:id="@+id/btn_equals"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:text="="
                android:textSize="26sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_operator" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>