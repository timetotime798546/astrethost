{
  "backend": true,
  "api_base_url": "https://trumpledroid-api.cloudbeta28624.workers.dev",
  "roles": {
    "user": ["own"]
  },
  "collections": {
    "wallets": {
      "fields": {
        "email": "string",
        "deposited_balance": "number",
        "bonus_balance": "number",
        "total_winnings": "number",
        "is_admin": "boolean"
      },
      "operations": ["create", "read", "update", "delete"]
    },
    "transactions": {
      "fields": {
        "email": "string",
        "tx_ref": "string",
        "category": "string",
        "amount": "number",
        "status": "string",
        "details": "string",
        "timestamp": "string"
      },
      "operations": ["create", "read", "update", "delete"]
    },
    "game_rounds": {
      "fields": {
        "round_id": "string",
        "user_email": "string",
        "bet_amount": "number",
        "crash_multiplier": "number",
        "cashout_multiplier": "number",
        "payout_amount": "number",
        "result": "string",
        "timestamp": "string"
      },
      "operations": ["create", "read", "update"]
    },
    "withdrawals": {
      "fields": {
        "email": "string",
        "tx_ref": "string",
        "amount": "number",
        "payout_method": "string",
        "recipient_detail": "string",
        "fee": "number",
        "net_amount": "number",
        "status": "string",
        "timestamp": "string"
      },
      "operations": ["create", "read", "update", "delete"]
    },
    "financial_allocations": {
      "fields": {
        "reference_id": "string",
        "pool_amount": "number",
        "owner_share_amount": "number",
        "winner_share_amount": "number",
        "owner_percentage": "number",
        "winner_percentage": "number",
        "status": "string",
        "timestamp": "string"
      },
      "operations": ["create", "read", "update"]
    }
  },
  "logic": {
    "pool_allocation": {
      "type": "calculation",
      "inputs": ["pool_amount"],
      "formula": "pool_amount * 0.60"
    },
    "winner_allocation": {
      "type": "calculation",
      "inputs": ["pool_amount"],
      "formula": "pool_amount * 0.40"
    },
    "wallet_available_balance": {
      "type": "calculation",
      "inputs": ["deposited_balance", "bonus_balance"],
      "formula": "deposited_balance + bonus_balance"
    }
  }
}