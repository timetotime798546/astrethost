{
  "backend": true,
  "api_base_url": "https://trumpledroid-api.cloudbeta28624.workers.dev",
  "roles": {
    "user": ["own"]
  },
  "collections": {
    "wallet_balances": {
      "fields": {
        "balance": "number",
        "total_deposited": "number",
        "total_won": "number",
        "user_email": "string"
      },
      "operations": ["create", "read", "update", "delete"]
    },
    "deposit_requests": {
      "fields": {
        "user_email": "string",
        "amount": "number",
        "utr_number": "string",
        "image_id": "string",
        "status": "string",
        "timestamp": "string"
      },
      "operations": ["create", "read", "update", "delete"]
    },
    "withdraw_requests": {
      "fields": {
        "user_email": "string",
        "amount": "number",
        "upi_id": "string",
        "status": "string",
        "timestamp": "string"
      },
      "operations": ["create", "read", "update", "delete"]
    },
    "game_bets": {
      "fields": {
        "bet_amount": "number",
        "cashout_multiplier": "number",
        "win_amount": "number",
        "crashed_at": "number",
        "result": "string"
      },
      "operations": ["create", "read", "update", "delete"]
    }
  },
  "logic": {
    "cashout_payout": {
      "type": "calculation",
      "inputs": ["bet_amount", "multiplier"],
      "formula": "bet_amount * multiplier"
    },
    "house_edge_margin": {
      "type": "calculation",
      "inputs": ["total_in", "total_out"],
      "formula": "(total_in - total_out) / total_in * 100"
    }
  }
}