{
  "backend": true,
  "api_base_url": "https://trumpledroid-api.cloudbeta28624.workers.dev",
  "roles": {
    "user": ["own"]
  },
  "collections": {
    "devices": {
      "fields": {
        "device_id": "string",
        "device_name": "string",
        "role": "string",
        "pairing_code": "string",
        "status": "string",
        "battery_pct": "integer",
        "is_charging": "boolean",
        "network_type": "string",
        "ip_address": "string",
        "last_seen": "string",
        "authorized_features": "string"
      },
      "operations": ["create", "read", "update", "delete"]
    },
    "sessions": {
      "fields": {
        "controller_id": "string",
        "managed_device_id": "string",
        "session_state": "string",
        "started_at": "string",
        "ended_at": "string",
        "permission_screen_sharing": "boolean",
        "permission_file_access": "boolean"
      },
      "operations": ["create", "read", "update", "delete"]
    },
    "audit_logs": {
      "fields": {
        "device_id": "string",
        "action": "string",
        "details": "string",
        "timestamp": "string"
      },
      "operations": ["create", "read"]
    }
  },
  "logic": {
    "battery_health_percentage": {
      "type": "calculation",
      "inputs": ["current_level", "max_level"],
      "formula": "(current_level / max_level) * 100"
    }
  }
}