<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OPERATOR ADMIN CONTROL"
            android:textColor="@color/aviator_gold"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Management dashboard for house edge margin, player win control, deposit approvals, and UPI payout dispatch."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- House Margin Setting Card (70% Default) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/card_dark"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HOUSE MARGIN &amp; WIN RATIO"
                android:textColor="@color/text_white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMarginRatioDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Current Setting: 70% House Edge / 30% User Wins"
                android:textColor="@color/aviator_green"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <Button
                    android:id="@+id/btnSetMargin70"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@color/aviator_green"
                    android:text="70% HOUSE (Default)"
                    android:textColor="@color/text_white"
                    android:textSize="11sp"
                    android:layout_marginRight="6dp" />

                <Button
                    android:id="@+id/btnSetMargin80"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@color/card_subtle"
                    android:text="80% HIGH PROFIT"
                    android:textColor="@color/text_white"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Direct UPI Settlement To Admin Bank Account -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/card_dark"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OPERATOR UPI ACCOUNT SETTINGS"
                android:textColor="@color/text_white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Payments collected on your QR can be reconciled here and routed to your primary bank account."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etAdminUpi"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@color/card_subtle"
                android:padding="10dp"
                android:text="aviatorpay.business@okhdfcbank"
                android:textColor="@color/text_white" />

            <Button
                android:id="@+id/btnSaveAdminUpi"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@color/aviator_gold"
                android:text="SAVE OPERATOR UPI ID"
                android:textColor="@color/bg_dark"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Manual Deposit Approvals (Verify Real Payments) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/card_dark"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PENDING DEPOSIT VERIFICATIONS"
                android:textColor="@color/text_white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPendingDepositsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Pending Verification: 0 requests"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnApproveTestDeposit"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:background="@color/aviator_green"
                android:text="VERIFY &amp; APPROVE LAST DEPOSIT (₹100)"
                android:textColor="@color/text_white"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Back to Game -->
        <Button
            android:id="@+id/btnBackFromAdmin"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:background="@color/card_subtle"
            android:text="EXIT ADMIN &amp; RETURN TO GAME"
            android:textColor="@color/text_white" />

    </LinearLayout>
</ScrollView>