<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dark_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="16dp">

            <Button
                android:id="@+id/btn_admin_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="←"
                android:textColor="@color/white"
                android:background="@drawable/bg_chip" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Executive Administrator"
                android:textColor="@color/accent_gold"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginStart="14dp" />
        </LinearLayout>

        <!-- 60% OWNER / 40% WINNER ALLOCATION MODULE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FINANCIAL DISTRIBUTION ALLOCATION (60 / 40 POOL)"
                android:textColor="@color/accent_gold"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Calculate and execute legal share allocation between platform owner (60%) and winner pool (40%)."
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Distribution Pool Amount (₹)"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/et_admin_pool_amount"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_chip"
                android:inputType="numberDecimal"
                android:textColor="@color/white"
                android:paddingHorizontal="12dp"
                android:text="1000"
                android:textSize="16sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btn_calc_allocation"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="CALCULATE 60 / 40 ALLOCATION"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:background="@drawable/bg_chip" />

            <!-- Computed Allocation Cards -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip"
                    android:padding="12dp"
                    android:orientation="vertical"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Owner Share (60%)"
                        android:textColor="@color/accent_red_bright"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_owner_share_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹ 600.00"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip"
                    android:padding="12dp"
                    android:orientation="vertical"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Winner Share (40%)"
                        android:textColor="@color/accent_green"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_winner_share_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹ 400.00"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btn_record_allocation"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="14dp"
                android:text="RECORD AUDITED ALLOCATION"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:background="@drawable/bg_red_button" />

        </LinearLayout>

        <!-- Pending Withdrawals Management -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pending Withdrawal Approvals"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/container_admin_withdrawals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_admin_no_withdrawals"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scanning for withdrawal requests..."
                android:textColor="@color/text_secondary" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>