<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dark_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <!-- Logo Block -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ARBAJ SBZ"
            android:textColor="@color/accent_red_bright"
            android:textSize="32sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VIP Aviation Gaming &amp; Allocation Hub"
            android:textColor="@color/metallic_silver"
            android:textSize="13sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="32dp" />

        <!-- Form Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pilot Login"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email Address"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/et_login_email"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_chip"
                android:inputType="textEmailAddress"
                android:textColor="@color/white"
                android:paddingHorizontal="12dp"
                android:hint="pilot@arbajsbz.com"
                android:textColorHint="@color/text_secondary"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Password"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/et_login_password"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_chip"
                android:inputType="textPassword"
                android:textColor="@color/white"
                android:paddingHorizontal="12dp"
                android:hint="••••••••"
                android:textColorHint="@color/text_secondary"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="24dp" />

            <Button
                android:id="@+id/btn_submit_login"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="ENTER COCKPIT"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:background="@drawable/bg_red_button" />

            <Button
                android:id="@+id/btn_goto_register"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="12dp"
                android:text="Create Account (Get ₹50 Bonus)"
                android:textColor="@color/accent_gold"
                android:background="@android:color/transparent" />

        </LinearLayout>

        <!-- Terms Footer -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="18+ Only • Play Responsibly • Secure SSL Encryption"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:layout_marginTop="24dp" />

    </LinearLayout>
</ScrollView>