<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ADD FUNDS VIA UPI QR"
            android:textColor="@color/aviator_green"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Scan the Official Operator QR code, pay via GPay/PhonePe/Paytm, enter the 12-digit Bank UTR and upload the screenshot. Funds will be verified by Operator before crediting."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- QR Code Presentation Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/card_dark"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OFFICIAL OPERATOR PAYMENT QR"
                android:textColor="@color/aviator_gold"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Display QR code image -->
            <ImageView
                android:id="@+id/ivAdminQrCode"
                android:layout_width="230dp"
                android:layout_height="230dp"
                android:layout_marginTop="12dp"
                android:background="#FFFFFF"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:contentDescription="Operator QR" />

            <TextView
                android:id="@+id/tvUpiIdDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="UPI ID: aviatorpay.business@okhdfcbank"
                android:textColor="@color/text_white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Minimum Deposit: ₹100 | Recommended: ₹200 / ₹500"
                android:textColor="@color/aviator_red"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Verification Form -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/card_dark"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PAYMENT VERIFICATION (ANTI-FRAUD AI)"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Amount Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Deposit Amount (₹)"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etDepositAmount"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@color/card_subtle"
                android:hint="e.g. 100 or 200"
                android:inputType="number"
                android:padding="10dp"
                android:text="100"
                android:textColor="@color/text_white"
                android:textColorHint="@color/text_muted" />

            <!-- UTR Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="12-Digit Banking UTR / Ref No (Mandatory)"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etUtrNumber"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@color/card_subtle"
                android:hint="Enter 12-digit UTR from GPay/Paytm"
                android:inputType="number"
                android:maxLength="12"
                android:padding="10dp"
                android:textColor="@color/text_white"
                android:textColorHint="@color/text_muted" />

            <!-- Screenshot Selection -->
            <Button
                android:id="@+id/btnSelectScreenshot"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="@color/card_subtle"
                android:text="SELECT PAYMENT SCREENSHOT"
                android:textColor="@color/text_white"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/ivProofPreview"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="10dp"
                android:background="#0A0B0E"
                android:scaleType="centerInside"
                android:visibility="gone"
                android:contentDescription="Payment Proof" />

            <!-- AI Anti-Fraud Status Banner -->
            <TextView
                android:id="@+id/tvUtrValidationStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="AI Anti-Fraud Checker: Ready"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- Submit Verification -->
            <Button
                android:id="@+id/btnSubmitVerification"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@color/aviator_green"
                android:text="SUBMIT FOR OPERATOR APPROVAL"
                android:textColor="@color/text_white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/pbDepositLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:visibility="gone" />
        </LinearLayout>

        <Button
            android:id="@+id/btnBackDeposit"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="16dp"
            android:background="@color/card_subtle"
            android:text="BACK TO GAME"
            android:textColor="@color/text_white" />

    </LinearLayout>
</ScrollView>