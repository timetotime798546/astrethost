<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="RESET PASSWORD"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/aviator_gold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Receive OTP on your registered Gmail to reset password."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etForgotEmail"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="24dp"
            android:background="@color/card_subtle"
            android:hint="Registered Email"
            android:inputType="textEmailAddress"
            android:padding="12dp"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_muted" />

        <Button
            android:id="@+id/btnSendOtp"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:background="@color/card_subtle"
            android:text="SEND OTP CODE"
            android:textColor="@color/text_white" />

        <EditText
            android:id="@+id/etOtp"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:background="@color/card_subtle"
            android:hint="Enter 6-Digit OTP"
            android:inputType="number"
            android:padding="12dp"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_muted" />

        <EditText
            android:id="@+id/etNewPassword"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="14dp"
            android:background="@color/card_subtle"
            android:hint="Enter New Password"
            android:inputType="textPassword"
            android:padding="12dp"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_muted" />

        <Button
            android:id="@+id/btnResetPassword"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="22dp"
            android:background="@color/aviator_green"
            android:text="RESET PASSWORD"
            android:textColor="@color/text_white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/pbForgot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>