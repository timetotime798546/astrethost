<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090D16"
    android:orientation="vertical">

    <!-- Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#121826"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Arbaj AI Studio"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_user_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Creator Studio"
                android:textColor="#38BDF8"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_logout"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="#243044"
            android:text="Sign Out"
            android:textAllCaps="false"
            android:textColor="#EF4444"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Horizontal Studio Feature Tabs -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0F172A"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="6dp">

            <Button
                android:id="@+id/btn_nav_video"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginRight="4dp"
                android:background="#2563EB"
                android:text="AI Video"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_nav_image"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginRight="4dp"
                android:background="#334155"
                android:text="AI Images"
                android:textAllCaps="false"
                android:textColor="#CBD5E1"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_nav_story"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginRight="4dp"
                android:background="#334155"
                android:text="Story Script"
                android:textAllCaps="false"
                android:textColor="#CBD5E1"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_nav_voice"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginRight="4dp"
                android:background="#334155"
                android:text="Voice &amp; Audio"
                android:textAllCaps="false"
                android:textColor="#CBD5E1"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_nav_characters"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginRight="4dp"
                android:background="#334155"
                android:text="Characters"
                android:textAllCaps="false"
                android:textColor="#CBD5E1"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_nav_youtube"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginRight="4dp"
                android:background="#334155"
                android:text="YouTube Tools"
                android:textAllCaps="false"
                android:textColor="#CBD5E1"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_nav_projects"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="#334155"
                android:text="My Projects"
                android:textAllCaps="false"
                android:textColor="#CBD5E1"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Main Workspace Area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. AI Video Generator Section -->
            <LinearLayout
                android:id="@+id/sec_video"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="AI Video Generator (Free Tier Enabled)"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Generate cinematic realistic video scenes with camera trajectory controls."
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/et_video_prompt"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_marginTop="12dp"
                    android:background="#151D2C"
                    android:gravity="top|left"
                    android:hint="Describe the video: e.g. A futuristic Mumbai street illuminated by neon raindrops, slow dolly shot, 4k 24fps..."
                    android:padding="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#64748B"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Aspect Ratio"
                    android:textColor="#CBD5E1"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rg_video_aspect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rb_aspect_16_9"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="16:9 Landscape"
                        android:textColor="#CBD5E1"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rb_aspect_9_16"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:text="9:16 Shorts"
                        android:textColor="#CBD5E1"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rb_aspect_1_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:text="1:1 Square"
                        android:textColor="#CBD5E1"
                        android:textSize="12sp" />
                </RadioGroup>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Cinematic Style"
                    android:textColor="#CBD5E1"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rg_video_style"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rb_style_cinematic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Cinematic"
                        android:textColor="#CBD5E1"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rb_style_anime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:text="Anime Studio"
                        android:textColor="#CBD5E1"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rb_style_documentary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:text="Documentary"
                        android:textColor="#CBD5E1"
                        android:textSize="12sp" />
                </RadioGroup>

                <Button
                    android:id="@+id/btn_generate_video"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="16dp"
                    android:background="#2563EB"
                    android:text="Generate AI Video Clip"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/pb_video"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_video_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="#151D2C"
                    android:lineSpacingExtra="3dp"
                    android:padding="12dp"
                    android:textColor="#34D399"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 2. AI Image Generator Section -->
            <LinearLayout
                android:id="@+id/sec_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="AI Image Generator &amp; Thumbnail Studio"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_image_prompt"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginTop="12dp"
                    android:background="#151D2C"
                    android:gravity="top|left"
                    android:hint="Describe image: e.g. An Indian hero in warrior armor, dramatic rim lighting, 8k photographic wallpaper..."
                    android:padding="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#64748B"
                    android:textSize="13sp" />

                <RadioGroup
                    android:id="@+id/rg_image_aspect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rb_img_16_9"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="16:9 Thumbnail"
                        android:textColor="#CBD5E1"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rb_img_9_16"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:text="9:16 Portrait"
                        android:textColor="#CBD5E1"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rb_img_1_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:text="1:1 Post"
                        android:textColor="#CBD5E1"
                        android:textSize="12sp" />
                </RadioGroup>

                <RadioGroup
                    android:id="@+id/rg_image_style"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rb_img_photo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Realistic 8K"
                        android:textColor="#CBD5E1"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rb_img_portrait"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:text="Portrait"
                        android:textColor="#CBD5E1"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rb_img_thumbnail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:text="YouTube Thumb"
                        android:textColor="#CBD5E1"
                        android:textSize="12sp" />
                </RadioGroup>

                <Button
                    android:id="@+id/btn_generate_image"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="14dp"
                    android:background="#0284C7"
                    android:text="Synthesize High-Res Image"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/pb_image"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_image_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="#151D2C"
                    android:padding="12dp"
                    android:textColor="#38BDF8"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 3. AI Story & Script Breakdown Section -->
            <LinearLayout
                android:id="@+id/sec_story"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="AI Story &amp; Video Script Studio"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Supports Hindi, English, Urdu story writing with scene-by-scene camera instructions."
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/et_story_idea"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_marginTop="12dp"
                    android:background="#151D2C"
                    android:gravity="top|left"
                    android:hint="Enter story premise or script: e.g. Ek gaon ka ladka jo AI scientist banna chahta hai aur uski dushwariyan..."
                    android:padding="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#64748B"
                    android:textSize="13sp" />

                <RadioGroup
                    android:id="@+id/rg_story_language"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rb_lang_hindi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Hindi Kahani"
                        android:textColor="#CBD5E1"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rb_lang_urdu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:text="Urdu Dastaan"
                        android:textColor="#CBD5E1"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rb_lang_english"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:text="English Script"
                        android:textColor="#CBD5E1"
                        android:textSize="12sp" />
                </RadioGroup>

                <Button
                    android:id="@+id/btn_generate_story"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="14dp"
                    android:background="#16A34A"
                    android:text="Breakdown Into AI Video Scenes"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/pb_story"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_story_overview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:textColor="#F59E0B"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/ll_scene_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- 4. Voice Studio & Audio Timing Section -->
            <LinearLayout
                android:id="@+id/sec_voice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="AI Voice Studio &amp; Audio Timing"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_voice_text"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_marginTop="12dp"
                    android:background="#151D2C"
                    android:gravity="top|left"
                    android:hint="Enter dialogue or narration to calculate exact audio timing and voice synthesis..."
                    android:padding="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#64748B"
                    android:textSize="13sp" />

                <RadioGroup
                    android:id="@+id/rg_voice_tone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rb_tone_cinematic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Deep Cinematic Movie Narrator (140 WPM)"
                        android:textColor="#CBD5E1"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rb_tone_storyteller"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Emotional Storyteller Hindi/Urdu (125 WPM)"
                        android:textColor="#CBD5E1"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rb_tone_energetic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="High-Energy YouTube Host (160 WPM)"
                        android:textColor="#CBD5E1"
                        android:textSize="12sp" />
                </RadioGroup>

                <Button
                    android:id="@+id/btn_generate_speech"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="14dp"
                    android:background="#7C3AED"
                    android:text="Synthesize Voice &amp; Timing"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_speech_duration_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="#151D2C"
                    android:lineSpacingExtra="3dp"
                    android:padding="12dp"
                    android:textColor="#A78BFA"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 5. Character Consistency Studio -->
            <LinearLayout
                android:id="@+id/sec_characters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Character Consistency Studio"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Store persistent visual profiles to reuse the same faces and clothing across all video scenes."
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/et_char_name"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:background="#151D2C"
                    android:hint="Character Name: e.g. Vikram"
                    android:padding="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#64748B"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/et_char_appearance"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="#151D2C"
                    android:hint="Visual Features: 28yo athletic Indian male, sharp jawline, short fade hair"
                    android:padding="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#64748B"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/et_char_clothing"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="#151D2C"
                    android:hint="Consistent Outfit: Navy blue leather jacket, white crewneck"
                    android:padding="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#64748B"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/et_char_voice"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="#151D2C"
                    android:hint="Voice Persona: Calm baritone, subtle Hindi inflection"
                    android:padding="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#64748B"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_save_character"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="12dp"
                    android:background="#059669"
                    android:text="Save Consistent Character Profile"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/pb_char"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Saved Character Models:"
                    android:textColor="#CBD5E1"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/ll_character_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- 6. YouTube Creator Tools Section -->
            <LinearLayout
                android:id="@+id/sec_youtube"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="YouTube Creator Growth Toolkit"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_yt_topic"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="12dp"
                    android:background="#151D2C"
                    android:hint="Video Concept / Topic: e.g. Free AI Tools in 2025"
                    android:padding="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#64748B"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_generate_yt_pack"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="12dp"
                    android:background="#DC2626"
                    android:text="Generate Titles, Tags, Hook &amp; Description"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_yt_output"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="#151D2C"
                    android:lineSpacingExtra="3dp"
                    android:padding="12dp"
                    android:textColor="#FCA5A5"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 7. Workspace & Projects Section -->
            <LinearLayout
                android:id="@+id/sec_projects"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Cloud Workspace &amp; Exports"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_refresh_projects"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="#243044"
                        android:text="Sync"
                        android:textAllCaps="false"
                        android:textColor="#38BDF8"
                        android:textSize="12sp" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/pb_projects"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="14dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_empty_projects"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text="No generated projects found yet.\nUse AI Video or AI Image Generator to produce creative assets."
                    android:textColor="#64748B"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/ll_projects_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>