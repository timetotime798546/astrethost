<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090D16"
    android:orientation="vertical">

    <!-- Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#121826"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Arbaj AI Studio"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_user_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Creator Studio • Real AI Engine v1.2"
                android:textColor="#38BDF8"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_logout"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="#243044"
            android:text="Sign Out"
            android:textAllCaps="false"
            android:textColor="#EF4444"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Horizontal Studio Feature Tabs -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0F172A"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="6dp">

            <Button
                android:id="@+id/btn_nav_video"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginRight="4dp"
                android:background="#2563EB"
                android:text="AI Video (Text)"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_nav_img2vid"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginRight="4dp"
                android:background="#334155"
                android:text="Image-to-Video"
                android:textAllCaps="false"
                android:textColor="#CBD5E1"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_nav_image"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginRight="4dp"
                android:background="#334155"
                android:text="AI Images"
                android:textAllCaps="false"
                android:textColor="#CBD5E1"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_nav_story"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginRight="4dp"
                android:background="#334155"
                android:text="Story Script"
                android:textAllCaps="false"
                android:textColor="#CBD5E1"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_nav_voice"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginRight="4dp"
                android:background="#334155"
                android:text="Voice &amp; Audio"
                android:textAllCaps="false"
                android:textColor="#CBD5E1"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_nav_characters"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginRight="4dp"
                android:background="#334155"
                android:text="Characters"
                android:textAllCaps="false"
                android:textColor="#CBD5E1"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_nav_youtube"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginRight="4dp"
                android:background="#334155"
                android:text="YouTube Tools"
                android:textAllCaps="false"
                android:textColor="#CBD5E1"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_nav_projects"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="#334155"
                android:text="My Projects"
                android:textAllCaps="false"
                android:textColor="#CBD5E1"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Main Workspace Area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. Real AI Video Generator Section (Text-to-Video) -->
            <LinearLayout
                android:id="@+id/sec_video"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Real AI Text-to-Video Generator"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Generates genuine MP4 video files with physical motion, lighting, and camera tracking."
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/et_video_prompt"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_marginTop="12dp"
                    android:background="#151D2C"
                    android:gravity="top|left"
                    android:hint="e.g. Create an ultra-realistic cinematic Indian village scene. A poor young Indian man wearing an old shirt walks along a dusty village road in early morning with realistic sunlight..."
                    android:padding="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#64748B"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Aspect Ratio"
                    android:textColor="#CBD5E1"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rg_video_aspect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rb_aspect_16_9"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="16:9 Landscape"
                        android:textColor="#CBD5E1"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rb_aspect_9_16"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:text="9:16 Shorts"
                        android:textColor="#CBD5E1"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rb_aspect_1_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:text="1:1 Square"
                        android:textColor="#CBD5E1"
                        android:textSize="12sp" />
                </RadioGroup>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Cinematic Visual Style"
                    android:textColor="#CBD5E1"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rg_video_style"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rb_style_cinematic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Cinematic Photoreal"
                        android:textColor="#CBD5E1"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rb_style_documentary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:text="Real Documentary"
                        android:textColor="#CBD5E1"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rb_style_anime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:text="Anime"
                        android:textColor="#CBD5E1"
                        android:textSize="12sp" />
                </RadioGroup>

                <Button
                    android:id="@+id/btn_generate_video"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:background="#2563EB"
                    android:text="Generate Genuine AI Video"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Real Generation Status Indicator -->
                <LinearLayout
                    android:id="@+id/ll_video_progress_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="#151D2C"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone">

                    <ProgressBar
                        android:id="@+id/pb_video"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:max="100"
                        android:progress="0" />

                    <TextView
                        android:id="@+id/tv_video_stage_message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Initializing AI Video Pipeline..."
                        android:textColor="#38BDF8"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Video Ready Action Card -->
                <LinearLayout
                    android:id="@+id/ll_video_result_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="#132338"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Video Generated Successfully!"
                        android:textColor="#10B981"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_video_result_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="#CBD5E1"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_play_latest_video"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginRight="8dp"
                            android:layout_weight="1"
                            android:background="#2563EB"
                            android:text="Play Video"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btn_download_latest_video"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:background="#10B981"
                            android:text="Download MP4"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- 2. Real Image-to-Video Generator Section -->
            <LinearLayout
                android:id="@+id/sec_img2vid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Real Image-to-Video Animator"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Provide an image URL to animate portraits, landscapes, or characters realistically."
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/et_img2vid_url"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="12dp"
                    android:background="#151D2C"
                    android:hint="Image URL: https://images.unsplash.com/photo-..."
                    android:padding="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#64748B"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/et_img2vid_prompt"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginTop="10dp"
                    android:background="#151D2C"
                    android:gravity="top|left"
                    android:hint="Describe motion: e.g. The person slowly turns head, blinks naturally and smiles gently..."
                    android:padding="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#64748B"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Motion Dynamic"
                    android:textColor="#CBD5E1"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rg_img2vid_motion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rb_motion_subtle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Subtle &amp; Natural"
                        android:textColor="#CBD5E1"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rb_motion_dynamic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:text="Dynamic Movement"
                        android:textColor="#CBD5E1"
                        android:textSize="12sp" />
                </RadioGroup>

                <Button
                    android:id="@+id/btn_generate_img2vid"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:background="#7C3AED"
                    android:text="Animate Image to Video"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/pb_img2vid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_img2vid_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="#A78BFA"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 3. AI Image Generator Section -->
            <LinearLayout
                android:id="@+id/sec_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="AI Image Generator &amp; Thumbnail Studio"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_image_prompt"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginTop="12dp"
                    android:background="#151D2C"
                    android:gravity="top|left"
                    android:hint="Describe image: e.g. An Indian hero in warrior armor, dramatic rim lighting, 8k photographic wallpaper..."
                    android:padding="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#64748B"
                    android:textSize="13sp" />

                <RadioGroup
                    android:id="@+id/rg_image_aspect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rb_img_16_9"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="16:9 Thumbnail"
                        android:textColor="#CBD5E1"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rb_img_9_16"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:text="9:16 Portrait"
                        android:textColor="#CBD5E1"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rb_img_1_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:text="1:1 Post"
                        android:textColor="#CBD5E1"
                        android:textSize="12sp" />
                </RadioGroup>

                <Button
                    android:id="@+id/btn_generate_image"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="14dp"
                    android:background="#0284C7"
                    android:text="Synthesize High-Res Image"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/pb_image"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_image_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="#151D2C"
                    android:padding="12dp"
                    android:textColor="#38BDF8"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 4. AI Story & Script Breakdown Section -->
            <LinearLayout
                android:id="@+id/sec_story"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="AI Story &amp; Video Script Studio"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Supports Hindi, English, Urdu story writing with scene-by-scene camera instructions."
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/et_story_idea"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_marginTop="12dp"
                    android:background="#151D2C"
                    android:gravity="top|left"
                    android:hint="Enter story premise: e.g. Ek gaon ka ladka jo AI scientist banna chahta hai..."
                    android:padding="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#64748B"
                    android:textSize="13sp" />

                <RadioGroup
                    android:id="@+id/rg_story_language"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rb_lang_hindi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Hindi"
                        android:textColor="#CBD5E1"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rb_lang_urdu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:text="Urdu"
                        android:textColor="#CBD5E1"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rb_lang_english"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:text="English"
                        android:textColor="#CBD5E1"
                        android:textSize="12sp" />
                </RadioGroup>

                <Button
                    android:id="@+id/btn_generate_story"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="14dp"
                    android:background="#16A34A"
                    android:text="Breakdown Into AI Video Scenes"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/pb_story"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_story_overview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:textColor="#F59E0B"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/ll_scene_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- 5. Voice Studio & Audio Timing Section -->
            <LinearLayout
                android:id="@+id/sec_voice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="AI Voice Studio &amp; Audio Timing"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_voice_text"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_marginTop="12dp"
                    android:background="#151D2C"
                    android:gravity="top|left"
                    android:hint="Enter dialogue or narration to calculate exact audio timing and voice profile..."
                    android:padding="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#64748B"
                    android:textSize="13sp" />

                <RadioGroup
                    android:id="@+id/rg_voice_tone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rb_tone_cinematic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Deep Cinematic Movie Narrator (140 WPM)"
                        android:textColor="#CBD5E1"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rb_tone_storyteller"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Emotional Storyteller Hindi/Urdu (125 WPM)"
                        android:textColor="#CBD5E1"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rb_tone_energetic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="High-Energy YouTube Host (160 WPM)"
                        android:textColor="#CBD5E1"
                        android:textSize="12sp" />
                </RadioGroup>

                <Button
                    android:id="@+id/btn_generate_speech"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="14dp"
                    android:background="#7C3AED"
                    android:text="Synthesize Voice &amp; Timing"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_speech_duration_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="#151D2C"
                    android:lineSpacingExtra="3dp"
                    android:padding="12dp"
                    android:textColor="#A78BFA"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 6. Character Studio -->
            <LinearLayout
                android:id="@+id/sec_characters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Character Consistency Studio"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_char_name"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:background="#151D2C"
                    android:hint="Character Name: e.g. Vikram"
                    android:padding="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#64748B"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/et_char_appearance"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="#151D2C"
                    android:hint="Visual Features: 28yo athletic Indian male, sharp jawline"
                    android:padding="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#64748B"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/et_char_clothing"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="#151D2C"
                    android:hint="Outfit: Navy blue jacket, white crewneck"
                    android:padding="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#64748B"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/et_char_voice"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="#151D2C"
                    android:hint="Voice Persona: Calm baritone"
                    android:padding="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#64748B"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_save_character"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="12dp"
                    android:background="#059669"
                    android:text="Save Character Profile"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/pb_char"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Saved Character Profiles:"
                    android:textColor="#CBD5E1"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/ll_character_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- 7. YouTube Creator Tools Section -->
            <LinearLayout
                android:id="@+id/sec_youtube"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="YouTube Creator Growth Toolkit"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_yt_topic"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="12dp"
                    android:background="#151D2C"
                    android:hint="Topic: e.g. Indian Village Life in 2025"
                    android:padding="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#64748B"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_generate_yt_pack"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="12dp"
                    android:background="#DC2626"
                    android:text="Generate Viral Metadata &amp; Shorts Hook"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_yt_output"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="#151D2C"
                    android:lineSpacingExtra="3dp"
                    android:padding="12dp"
                    android:textColor="#FCA5A5"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 8. Workspace & Projects Section -->
            <LinearLayout
                android:id="@+id/sec_projects"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Saved Videos &amp; Workspace"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_refresh_projects"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="#243044"
                        android:text="Sync"
                        android:textAllCaps="false"
                        android:textColor="#38BDF8"
                        android:textSize="12sp" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/pb_projects"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="14dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_empty_projects"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text="No generated projects yet.\nGenerate an AI Video or Image to see your files here."
                    android:textColor="#64748B"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/ll_projects_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>