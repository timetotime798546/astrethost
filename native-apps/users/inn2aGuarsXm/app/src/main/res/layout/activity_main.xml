<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_dark_gradient"
    android:padding="16dp">

    <!-- Top Branding & Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ARBAJ SBZ"
                android:textColor="@color/accent_red_bright"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aviation Gaming Arena"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Balance Quick Pill -->
        <LinearLayout
            android:id="@+id/btn_open_wallet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_dark"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹ "
                android:textColor="@color/accent_gold"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_main_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.00"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="14sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_menu_settings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:text="⚙"
            android:textColor="@color/white"
            android:background="@drawable/bg_chip" />
    </LinearLayout>

    <!-- Multiplier Live Stage -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card_dark">

        <com.arbajsbz.app.AviationFlightView
            android:id="@+id/flight_canvas"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tv_multiplier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.00x"
                android:textColor="@color/white"
                android:textSize="48sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_round_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NEXT ROUND IN 5s"
                android:textColor="@color/accent_gold"
                android:textSize="13sp"
                android:letterSpacing="0.05" />
        </LinearLayout>
    </LinearLayout>

    <!-- Recent History Chips -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recent: "
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_hist_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1.42x"
            android:textColor="@color/accent_red_bright"
            android:background="@drawable/bg_chip"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:layout_marginStart="4dp"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_hist_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2.80x"
            android:textColor="@color/accent_green"
            android:background="@drawable/bg_chip"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:layout_marginStart="6dp"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_hist_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1.15x"
            android:textColor="@color/accent_red_bright"
            android:background="@drawable/bg_chip"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:layout_marginStart="6dp"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_hist_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3.45x"
            android:textColor="@color/accent_green"
            android:background="@drawable/bg_chip"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:layout_marginStart="6dp"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Bet Entry Control Center -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_dark"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Bet Quick Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btn_bet_100"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="₹100"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:background="@drawable/bg_chip"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_bet_200"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="₹200"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:background="@drawable/bg_chip"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_bet_500"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="₹500"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:background="@drawable/bg_chip"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_bet_1000"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="₹1,000"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:background="@drawable/bg_chip" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp">

            <EditText
                android:id="@+id/et_bet_amount"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip"
                android:inputType="numberDecimal"
                android:hint="Bet Amount (₹)"
                android:textColorHint="@color/text_secondary"
                android:textColor="@color/white"
                android:paddingHorizontal="14dp"
                android:text="100"
                android:textSize="16sp" />

            <!-- Main Action: Place Bet or Cash Out -->
            <Button
                android:id="@+id/btn_action_game"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.2"
                android:text="PLACE BET"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_red_button" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Navigation Hub -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/nav_wallet"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Wallet"
            android:textColor="@color/metallic_silver"
            android:textSize="12sp"
            android:background="@drawable/bg_chip"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/nav_withdraw"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Withdraw"
            android:textColor="@color/metallic_silver"
            android:textSize="12sp"
            android:background="@drawable/bg_chip"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/nav_history"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Ledger"
            android:textColor="@color/metallic_silver"
            android:textSize="12sp"
            android:background="@drawable/bg_chip"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/nav_admin"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Admin"
            android:textColor="@color/accent_gold"
            android:textSize="12sp"
            android:background="@drawable/bg_chip" />
    </LinearLayout>
</LinearLayout>