<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- Top Status Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="@color/card_dark"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AVIATOR"
            android:textColor="@color/aviator_red"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="6dp"
            android:text="PRO"
            android:textColor="@color/aviator_gold"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- User Wallet Balance -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/card_subtle"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹ "
                android:textColor="@color/aviator_green"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWalletBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.00"
                android:textColor="@color/text_white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Deposit Action Button -->
        <Button
            android:id="@+id/btnNavDeposit"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginLeft="8dp"
            android:background="@color/aviator_green"
            android:text="DEPOSIT"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Admin Control Entry -->
        <Button
            android:id="@+id/btnNavAdmin"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginLeft="8dp"
            android:background="@color/card_subtle"
            android:text="⚙"
            android:textColor="@color/aviator_gold"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Previous Multipliers History Bar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="#16181F"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layoutHistoryBadges"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="8dp"
            android:paddingRight="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2.14x"
                android:textColor="@color/aviator_green"
                android:background="@color/card_subtle"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:layout_marginRight="6dp"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.20x"
                android:textColor="@color/aviator_red"
                android:background="@color/card_subtle"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:layout_marginRight="6dp"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5.80x"
                android:textColor="@color/aviator_gold"
                android:background="@color/card_subtle"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:layout_marginRight="6dp"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Aviator Dynamic Flight Arena -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.aviatorpro.app.AviatorFlightView
            android:id="@+id/flightView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Win Alert Pop-up Notification -->
        <LinearLayout
            android:id="@+id/layoutWinNotification"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="20dp"
            android:background="@color/aviator_green"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvWinNotice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YOU CASHED OUT! ₹200.00"
                android:textColor="@color/text_white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- Live Betting Control Cockpit -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_dark"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Bet Quick Select Presets -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btnPreset100"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@color/card_subtle"
                android:text="₹100"
                android:textColor="@color/text_white"
                android:layout_marginRight="4dp"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnPreset200"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@color/card_subtle"
                android:text="₹200"
                android:textColor="@color/text_white"
                android:layout_marginRight="4dp"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnPreset500"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@color/card_subtle"
                android:text="₹500"
                android:textColor="@color/text_white"
                android:layout_marginRight="4dp"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnPreset1000"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@color/card_subtle"
                android:text="₹1000"
                android:textColor="@color/text_white"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Bet Value Stepper & Primary Action -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical">

            <!-- Amount Adjuster -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="@color/card_subtle"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingLeft="8dp"
                android:paddingRight="8dp">

                <Button
                    android:id="@+id/btnMinusBet"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@color/card_dark"
                    android:text="-"
                    android:textColor="@color/text_white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBetAmountDisplay"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="₹100"
                    android:textColor="@color/text_white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnPlusBet"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@color/card_dark"
                    android:text="+"
                    android:textColor="@color/text_white"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Main Dynamic Bet / Cash Out Button -->
            <Button
                android:id="@+id/btnBetOrCashout"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1.2"
                android:layout_marginLeft="10dp"
                android:background="@color/aviator_green"
                android:text="BET ₹100"
                android:textColor="@color/text_white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Bottom Options: Withdraw & Profile Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnNavWithdraw"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@color/card_subtle"
                android:text="WITHDRAW TO UPI"
                android:textColor="@color/aviator_gold"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnUserAuth"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:background="@color/card_subtle"
                android:text="LOGIN / REGISTER"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Copyright Footnote -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/copyright_text"
            android:textColor="@color/text_muted"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>