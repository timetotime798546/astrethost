<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:orientation="vertical">

    <!-- Top Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E293B"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MK Device Hub"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_user_identity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Controller: user@mk.local"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_logout"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="#334155"
            android:text="Sign Out"
            android:textAllCaps="false"
            android:textColor="#EF4444"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Secondary Device Status Card (Local Presence) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="14dp"
        android:background="#1E293B"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="This Phone Telemetry"
                android:textColor="#38BDF8"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_local_battery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Battery: 100%"
                android:textColor="#34D399"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_local_network"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Network: Wi-Fi (192.168.1.100)"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_broadcast_status"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="10dp"
            android:background="#0284C7"
            android:text="Update My Device Telemetry"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- Paired Managed Devices Section Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Authorized Paired Devices"
            android:textColor="#F1F5F9"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_add_device"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="#16A34A"
            android:text="+ Pair Device"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_refresh_devices"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginLeft="6dp"
            android:background="#334155"
            android:text="Sync"
            android:textAllCaps="false"
            android:textColor="#CBD5E1"
            android:textSize="12sp" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/pb_devices_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_margin="16dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_no_devices"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:gravity="center"
        android:text="No devices paired yet.\nClick '+ Pair Device' to connect your secondary phone."
        android:textColor="#64748B"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- List of Paired Devices -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="8dp">

        <LinearLayout
            android:id="@+id/ll_device_list_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

</LinearLayout>