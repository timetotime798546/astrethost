<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAFAFA">

    <!-- Top Action Bar Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:background="@color/primary"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="पहाड़ी रनर (Pahadi Runner)"
            android:textColor="@color/text_light"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAccount"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="लॉगिन / प्रोफ़ाइल"
            android:textSize="12sp"
            android:background="#2E7D32"
            android:textColor="@color/text_light" />
    </LinearLayout>

    <!-- Stat Dashboard Strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#E8F5E9"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="फ्री चांस (Free Runs)"
                android:textSize="12sp"
                android:textColor="#37474F" />

            <TextView
                android:id="@+id/tvRunsLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3 / 3"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/primary" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#C8E6C9" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="कुल सिक्के (Coins)"
                android:textSize="12sp"
                android:textColor="#37474F" />

            <TextView
                android:id="@+id/tvTotalCoins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#E65100" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#C8E6C9" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="हाई स्कोर"
                android:textSize="12sp"
                android:textColor="#37474F" />

            <TextView
                android:id="@+id/tvHighScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 m"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1565C0" />
        </LinearLayout>
    </LinearLayout>

    <!-- Main Game Canvas Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.pahadirunner.app.GameView
            android:id="@+id/gameView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Overlay for Game Start / Limit Exceeded -->
        <LinearLayout
            android:id="@+id/layoutOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#CC000000"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvOverlayTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="पहाड़ी रनर में स्वागत है!"
                android:textColor="@color/text_light"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvOverlayDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="पहाड़ों में दौड़ें, पत्थरों से बचें और हर सिक्के पर ₹50 कमाएँ! आपको 3 बार फ्री खेलने का मौका मिलेगा।"
                android:textColor="#B0BEC5"
                android:textSize="14sp"
                android:gravity="center" />

            <Button
                android:id="@+id/btnPlayGame"
                android:layout_width="220dp"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:background="@color/button_green"
                android:text="दौड़ शुरू करें (Run)"
                android:textColor="@color/text_light"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnRechargeOverlay"
                android:layout_width="220dp"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                android:background="@color/accent"
                android:text="पैसे डालें / स्क्रीनशॉट भेजें"
                android:textColor="@color/text_light"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#FFFFFF">

        <Button
            android:id="@+id/btnJump"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="@color/primary"
            android:text="कूदें (JUMP)"
            android:textColor="@color/text_light"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnRechargeDirect"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginLeft="12dp"
            android:background="@color/accent"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:text="स्क्रीनशॉट वेरिफाई"
            android:textColor="@color/text_light"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>