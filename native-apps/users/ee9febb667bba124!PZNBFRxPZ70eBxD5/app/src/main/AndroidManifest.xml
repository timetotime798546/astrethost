<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:label="OmniControl Suite"
        android:icon="@drawable/icon"
        android:roundIcon="@drawable/icon"
        android:theme="@style/AppTheme">

        <activity
            android:name="com.omnicontrolsuite.app.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.omnicontrolsuite.app.TaskActivity"
            android:label="Task Manager"
            android:exported="false" />

        <activity
            android:name="com.omnicontrolsuite.app.NotesActivity"
            android:label="Notes Editor"
            android:exported="false" />

        <activity
            android:name="com.omnicontrolsuite.app.CalculatorActivity"
            android:label="Calculator &amp; Utility"
            android:exported="false" />

        <activity
            android:name="com.omnicontrolsuite.app.AnalyticsActivity"
            android:label="System Analytics"
            android:exported="false" />

        <activity
            android:name="com.omnicontrolsuite.app.SettingsActivity"
            android:label="Suite Settings"
            android:exported="false" />

    </application>
</manifest>