<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="COSMIC PILOT MANUAL"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#38BDF8"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="THE MISSION"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FB923C"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Clear the cosmic grid by vectoring all spacecrafts (arrows) out of bounds. Be highly tactical: if any two spacecrafts collide or intersect, a major cosmic crash results in immediate game failure!"
                android:textSize="16sp"
                android:textColor="#94A3B8"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="HOW TO FLIGHT DIRECT"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FB923C"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Examine the current grid coordinates.\n2. Locate an arrow that has an open pathway ahead with absolutely no other arrow in its trajectory.\n3. Tap on the arrow to launch it.\n4. Watch it safely escape outer atmosphere, earning you points!\n5. Plan your launches in precise chronological sequence to avoid cross-intersecting routes."
                android:textSize="16sp"
                android:textColor="#94A3B8"
                android:layout_marginBottom="24dp"/>

        </LinearLayout>

    </ScrollView>

    <Button
        android:id="@+id/btn_back_help"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="RETURN TO HANGAR"
        android:textSize="16sp"
        android:backgroundTint="#38BDF8"
        android:textColor="#090D16"/>

</LinearLayout>