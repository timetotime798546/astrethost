<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.google.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground"
    android:padding="16dp">

    <!-- Title Toolbar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Back"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_bg"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Workspace Notebook"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/textPrimary"
            android:layout_centerInParent="true" />

        <Button
            android:id="@+id/btnNewNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="New"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_bg"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true" />
    </RelativeLayout>

    <!-- Split UI for small device or single flow structure -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Editor Form -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:padding="12dp"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">

            <EditText
                android:id="@+id/editNoteTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Document Title"
                android:textColor="@color/textDark"
                android:textStyle="bold"
                android:background="@drawable/input_bg"
                android:padding="10dp"
                android:layout_marginBottom="8dp"
                android:inputType="textCapWords" />

            <EditText
                android:id="@+id/editNoteContent"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:hint="Type rich document logs here..."
                android:textColor="@color/textDark"
                android:background="@drawable/input_bg"
                android:padding="10dp"
                android:gravity="top|left"
                android:layout_marginBottom="8dp"
                android:inputType="textMultiLine" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSaveNote"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Commit Changes"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/button_bg"
                    android:layout_marginRight="4dp" />

                <Button
                    android:id="@+id/btnDeleteNote"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Delete Entry"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/button_bg"
                    android:layout_marginLeft="4dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Saved documents section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Archived Corporate Assets"
            android:textStyle="bold"
            android:textColor="@color/textPrimary"
            android:layout_marginBottom="6dp" />

        <ListView
            android:id="@+id/listNotes"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/card_bg"
            android:padding="8dp"
            android:divider="@color/borderLight"
            android:dividerHeight="1dp" />
    </LinearLayout>
</LinearLayout>