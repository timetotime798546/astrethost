<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.google.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground"
    android:padding="16dp">

    <!-- Back Navigation Panel -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Back"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_bg"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Diagnostic Engine"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/textPrimary"
            android:layout_centerInParent="true" />
    </RelativeLayout>

    <!-- Canvas Graph Box Frame -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@drawable/card_bg"
        android:orientation="vertical"
        android:padding="12dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="System Metrics Over Time"
            android:textStyle="bold"
            android:textColor="@color/textPrimary"
            android:layout_marginBottom="8dp" />

        <com.omnicontrolsuite.app.AnalyticsView
            android:id="@+id/analyticsCanvasView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnRefreshChart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Update Analytics Canvas"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_bg"
            android:layout_marginRight="4dp" />

        <Button
            android:id="@+id/btnResetMetrics"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Clear Metrics Log"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_bg"
            android:layout_marginLeft="4dp" />
    </LinearLayout>

    <!-- System Logging Console -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Diagnostic Log Stream"
        android:textStyle="bold"
        android:textColor="@color/textPrimary"
        android:layout_marginBottom="6dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/card_bg"
        android:padding="10dp">

        <TextView
            android:id="@+id/txtLogConsole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="[INFO] Analytics monitor initialized.\n[SYSTEM] System engine active..."
            android:fontFamily="monospace"
            android:textColor="#2E7D32"
            android:textSize="11sp" />
    </ScrollView>
</LinearLayout>