<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E14"
    android:padding="16dp">

    <!-- Styled App Spinner Loader Area -->
    <LinearLayout
        android:id="@+id/loader_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="visible">

        <ProgressBar
            android:id="@+id/loading_spinner"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:indeterminate="true"
            android:indeterminateTint="#00E676"
            style="?android:attr/progressBarStyleLarge" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Initializing Neural AI Core..."
            android:textColor="#00E5FF"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.05" />
    </LinearLayout>

    <!-- Main Content Container: AI Terminal Interface -->
    <LinearLayout
        android:id="@+id/main_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Top Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp"
            android:layout_marginBottom="8dp">

            <View
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="#00E676"
                android:layout_marginEnd="10dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/hello_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HALO AI CORE"
                    android:textColor="#00E676"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.05" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Offline Intelligence System • Active"
                    android:textColor="#888888"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_replay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="?android:attr/buttonStyleSmall"
                android:text="Diagnostics"
                android:textColor="#121212"
                android:backgroundTint="#00E5FF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Quick AI Commands Horizontal Scroll -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="4dp">

                <Button
                    android:id="@+id/chip_system"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="[System Stats]"
                    android:textColor="#00E5FF"
                    android:backgroundTint="#1A233A"
                    android:textSize="11sp"
                    style="?android:attr/buttonStyleSmall" />

                <Button
                    android:id="@+id/chip_joke"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="[Tell Joke]"
                    android:textColor="#00E5FF"
                    android:backgroundTint="#1A233A"
                    android:textSize="11sp"
                    style="?android:attr/buttonStyleSmall" />

                <Button
                    android:id="@+id/chip_future"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="[Predict Future]"
                    android:textColor="#00E5FF"
                    android:backgroundTint="#1A233A"
                    android:textSize="11sp"
                    style="?android:attr/buttonStyleSmall" />

                <Button
                    android:id="@+id/chip_matrix"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="[Binary Rain]"
                    android:textColor="#00E5FF"
                    android:backgroundTint="#1A233A"
                    android:textSize="11sp"
                    style="?android:attr/buttonStyleSmall" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Chat Log Scroll View -->
        <ScrollView
            android:id="@+id/chat_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#0F131C"
            android:padding="10dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:id="@+id/chat_history_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <!-- Thinking / Processing Indicator -->
        <LinearLayout
            android:id="@+id/ai_thinking_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="8dp"
                android:indeterminateTint="#00E676" />

            <TextView
                android:id="@+id/ai_thinking_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HALO AI is calculating response..."
                android:textColor="#888888"
                android:textSize="12sp"
                android:fontFamily="sans-serif-italic" />
        </LinearLayout>

        <!-- Input Box Area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/chat_input"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:background="#1A233A"
                android:hint="Talk to HALO AI core..."
                android:textColorHint="#556688"
                android:textColor="#FFFFFF"
                android:padding="12dp"
                android:maxLines="3"
                android:textSize="14sp"
                android:imeOptions="actionSend"
                android:inputType="textShortMessage" />

            <Button
                android:id="@+id/btn_send"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="SEND"
                android:textColor="#121212"
                android:backgroundTint="#00E676"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>