<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_height"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <!-- Header Bar -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#008080"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">
        
        <TextView
            android:id="@+id/appTitleHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hospital AI Assistant"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
            
        <TextView
            android:id="@+id/connectionStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Online"
            android:textColor="#A7FFEB"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Tab Contents Container -->
    <FrameLayout
        android:id="@+id/containerMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNavBar"
        android:layout_below="@+id/headerBar">

        <!-- CHAT SCREEN SECTION -->
        <LinearLayout
            android:id="@+id/tabLayoutChat"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- Live State Tracker Grid Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:layout_margin="10dp"
                android:orientation="vertical"
                android:padding="12dp">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Active Appointment Tracker"
                    android:textStyle="bold"
                    android:textColor="#008080"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp"/>
                
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:rowCount="4"
                    android:useDefaultMargins="true">
                    
                    <TextView android:id="@+id/badgeName" android:text="👤 Name: --" android:background="#ECEFF1" android:padding="5dp" android:textSize="11sp" android:layout_columnWeight="1" android:textColor="#37474F" android:layout_margin="2dp"/>
                    <TextView android:id="@+id/badgeAge" android:text="🎂 Age: --" android:background="#ECEFF1" android:padding="5dp" android:textSize="11sp" android:layout_columnWeight="1" android:textColor="#37474F" android:layout_margin="2dp"/>
                    <TextView android:id="@+id/badgePhone" android:text="📞 Phone: --" android:background="#ECEFF1" android:padding="5dp" android:textSize="11sp" android:layout_columnWeight="1" android:textColor="#37474F" android:layout_margin="2dp"/>
                    <TextView android:id="@+id/badgeDept" android:text="🏥 Dept: --" android:background="#ECEFF1" android:padding="5dp" android:textSize="11sp" android:layout_columnWeight="1" android:textColor="#37474F" android:layout_margin="2dp"/>
                    <TextView android:id="@+id/badgeDoctor" android:text="🩺 Doctor: --" android:background="#ECEFF1" android:padding="5dp" android:textSize="11sp" android:layout_columnWeight="1" android:textColor="#37474F" android:layout_margin="2dp"/>
                    <TextView android:id="@+id/badgeDate" android:text="📅 Date: --" android:background="#ECEFF1" android:padding="5dp" android:textSize="11sp" android:layout_columnWeight="1" android:textColor="#37474F" android:layout_margin="2dp"/>
                    <TextView android:id="@+id/badgeTime" android:text="⏰ Time: --" android:background="#ECEFF1" android:padding="5dp" android:textSize="11sp" android:layout_columnWeight="1" android:textColor="#37474F" android:layout_margin="2dp"/>
                    <TextView android:id="@+id/badgeStatus" android:text="⚠️ Unfinished" android:background="#FFEBEE" android:padding="5dp" android:textSize="11sp" android:layout_columnWeight="1" android:textColor="#C62828" android:textStyle="bold" android:layout_margin="2dp"/>
                </GridLayout>
                
                <!-- Booking confirmation block visible only when target fields are loaded -->
                <LinearLayout
                    android:id="@+id/layoutConfirmBookingContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginTop="10dp"
                    android:background="#E0F2F1"
                    android:padding="8dp">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="All Details Collected! Please confirm below:"
                        android:textColor="#004D40"
                        android:textSize="12sp"
                        android:textStyle="bold"/>
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">
                        <Button
                            android:id="@+id/btnConfirmDirect"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:text="Confirm Booking"
                            android:textColor="#FFFFFF"
                            android:background="@drawable/bg_button"
                            android:textSize="11sp"
                            android:layout_marginRight="4dp"/>
                        <Button
                            android:id="@+id/btnResetTracker"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:text="Reset Form"
                            android:textColor="#FFFFFF"
                            android:background="#E53935"
                            android:textSize="11sp"
                            android:layout_marginLeft="4dp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Dynamic Bubble Scroll Workspace -->
            <ScrollView
                android:id="@+id/scrollChatView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:fillViewport="true">
                
                <LinearLayout
                    android:id="@+id/layoutMessageBubbles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="10dp" />
            </ScrollView>

            <!-- Animation indicator of state -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="4dp">
                <com.hospitalaibooker.app.AiAnimationView
                    android:id="@+id/aiAnimationIndicatorView"
                    android:layout_width="150dp"
                    android:layout_height="40dp" />
                <TextView
                    android:id="@+id/txtAIStatusState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI is sleeping"
                    android:textColor="#78909C"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- User Interactive Console -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#FFFFFF"
                android:padding="8dp"
                android:gravity="center_vertical">
                
                <ImageButton
                    android:id="@+id/btnRecordMic"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="#E0F2F1"
                    android:src="@android:drawable/presence_audio_online"
                    android:tint="#008080"
                    android:layout_marginRight="6dp"
                    android:contentDescription="Speak" />

                <EditText
                    android:id="@+id/edtTxtUserInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Describe your appointment details..."
                    android:textColor="#37474F"
                    android:textColorHint="#90A4AE"
                    android:background="#ECEFF1"
                    android:padding="10dp" 
                    android:textSize="14sp"
                    android:inputType="textShortMessage"
                    android:maxLines="3"/>

                <Button
                    android:id="@+id/btnSendText"
                    android:layout_width="60dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_button"
                    android:text="Send"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:layout_marginLeft="6dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ADMIN PANEL SECTION -->
        <LinearLayout
            android:id="@+id/tabLayoutAdmin"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Confirmed SQL Database Bookings"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#263238"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnRefreshBookings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Refresh Bookings List"
                android:background="@drawable/bg_button"
                android:textColor="#FFFFFF" 
                android:layout_marginBottom="10dp"/>

            <ListView
                android:id="@+id/listAdminBookings"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="#CFD8DC"
                android:dividerHeight="1dp" />
                
            <TextView
                android:id="@+id/txtAdminStatusPlaceholder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="No appointments fetched yet. Run refresh."
                android:textColor="#78909C"
                android:layout_marginTop="20dp"/>
        </LinearLayout>

        <!-- SETTINGS SECTION -->
        <ScrollView
            android:id="@+id/tabLayoutSettings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gemini API Configuration"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#263238"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gemini API Key:"
                    android:textColor="#37474F"
                    android:textStyle="bold"
                    android:textSize="12sp"/>
                <EditText
                    android:id="@+id/edtSettingsApiKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:hint="AIzaSy... (Gemini Key)"
                    android:textColor="#263238"
                    android:background="#E0F2F1"
                    android:padding="10dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI System Prompt / Instructions:"
                    android:textColor="#37474F"
                    android:textStyle="bold"
                    android:textSize="12sp"/>
                <EditText
                    android:id="@+id/edtSettingsSystemInstruction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:lines="4"
                    android:gravity="top"
                    android:textColor="#263238"
                    android:background="#E0F2F1"
                    android:padding="10dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MySQL PHP Backend Endpoint Link:"
                    android:textColor="#37474F"
                    android:textStyle="bold"
                    android:textSize="12sp"/>
                <EditText
                    android:id="@+id/edtSettingsBackendUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:hint="https://yourdomain.com/book_api.php"
                    android:textColor="#263238"
                    android:background="#E0F2F1"
                    android:padding="10dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/btnSaveSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Save Settings &amp; Restart State"
                    android:background="@drawable/bg_button"
                    android:textColor="#FFFFFF" />

                <!-- Secure Deployment Guide Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical"
                    android:padding="12dp">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Secure PHP Database Guideline:"
                        android:textStyle="bold"
                        android:textColor="#C62828"
                        android:textSize="12sp"
                        android:layout_marginBottom="6dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Copy and run the robust SQL script &amp; backend secure prepared statement handler bundled at the top of the java file to prevent injection attacks and securely insert database records."
                        android:textColor="#546E7A"
                        android:textSize="11sp"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Bottom Tabs Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:divider="?android:attr/dividerVertical"
        android:showDividers="middle">
        
        <Button
            android:id="@+id/btnTabChat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Chat"
            android:background="?android:attr/selectableItemBackground"
            android:textColor="#008080"
            android:textSize="12sp"
            android:textStyle="bold" />
            
        <Button
            android:id="@+id/btnTabAdmin"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Admin"
            android:background="?android:attr/selectableItemBackground"
            android:textColor="#78909C"
            android:textSize="12sp"
            android:textStyle="normal" />
            
        <Button
            android:id="@+id/btnTabSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Settings"
            android:background="?android:attr/selectableItemBackground"
            android:textColor="#78909C"
            android:textSize="12sp"
            android:textStyle="normal" />
    </LinearLayout>
</RelativeLayout>