<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6F7"
    android:padding="16dp">

    <!-- Display Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:orientation="vertical"
        android:gravity="bottom|end"
        android:padding="16dp"
        android:background="@drawable/display_bg"
        android:elevation="4dp"
        android:layout_marginBottom="16dp">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:scrollbars="none"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tv_expression"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#7F8C8D"
                android:textSize="24sp"
                android:singleLine="true"
                android:layout_gravity="end|center_vertical" />
        </HorizontalScrollView>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:scrollbars="none">

            <TextView
                android:id="@+id/tv_result"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#2C3E50"
                android:textSize="48sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:layout_gravity="end|center_vertical" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Keypad Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2.8"
        android:orientation="vertical">

        <!-- Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btn_clear"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="C"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_action"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_parenthesis_open"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="("
                android:textSize="22sp"
                android:textColor="#2C3E50"
                android:background="@drawable/btn_number"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_parenthesis_close"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text=")"
                android:textSize="22sp"
                android:textColor="#2C3E50"
                android:background="@drawable/btn_number"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_divide"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="/"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_operator" />
        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btn_7"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="7"
                android:textSize="22sp"
                android:textColor="#2C3E50"
                android:background="@drawable/btn_number"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_8"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="8"
                android:textSize="22sp"
                android:textColor="#2C3E50"
                android:background="@drawable/btn_number"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_9"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="9"
                android:textSize="22sp"
                android:textColor="#2C3E50"
                android:background="@drawable/btn_number"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_multiply"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="*"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_operator" />
        </LinearLayout>

        <!-- Row 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btn_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="4"
                android:textSize="22sp"
                android:textColor="#2C3E50"
                android:background="@drawable/btn_number"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="5"
                android:textSize="22sp"
                android:textColor="#2C3E50"
                android:background="@drawable/btn_number"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="6"
                android:textSize="22sp"
                android:textColor="#2C3E50"
                android:background="@drawable/btn_number"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_subtract"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="-"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_operator" />
        </LinearLayout>

        <!-- Row 4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btn_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="1"
                android:textSize="22sp"
                android:textColor="#2C3E50"
                android:background="@drawable/btn_number"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="2"
                android:textSize="22sp"
                android:textColor="#2C3E50"
                android:background="@drawable/btn_number"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="3"
                android:textSize="22sp"
                android:textColor="#2C3E50"
                android:background="@drawable/btn_number"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_add"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="+"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_operator" />
        </LinearLayout>

        <!-- Row 5 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="0"
                android:textSize="22sp"
                android:textColor="#2C3E50"
                android:background="@drawable/btn_number"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_decimal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="."
                android:textSize="22sp"
                android:textColor="#2C3E50"
                android:background="@drawable/btn_number"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_backspace"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="⌫"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_action"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_equals"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="="
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_equal" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>