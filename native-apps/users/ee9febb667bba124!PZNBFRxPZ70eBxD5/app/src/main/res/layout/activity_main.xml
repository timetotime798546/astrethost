<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android='http://schemas.android.com/apk/res/android'
    android:layout_width='match_parent'
    android:layout_height='match_parent'
    android:orientation='vertical'
    android:background='@color/calc_bg'
    android:weightSum='10'>

    <!-- Display Portion -->
    <LinearLayout
        android:layout_width='match_parent'
        android:layout_height='0dp'
        android:layout_weight='3.2'
        android:background='@color/display_bg'
        android:orientation='vertical'
        android:gravity='bottom|end'
        android:padding='24dp'>

        <!-- Scrollable Active Expression -->
        <ScrollView
            android:layout_width='match_parent'
            android:layout_height='wrap_content'
            android:fillViewport='true'
            android:scrollbars='none'>
            
            <TextView
                android:id='@+id/tv_expression'
                android:layout_width='match_parent'
                android:layout_height='wrap_content'
                android:text=''
                android:gravity='end'
                android:textSize='38sp'
                android:textColor='@color/text_primary'
                android:singleLine='false'
                android:maxLines='3' />
        </ScrollView>

        <!-- Live Calculated Preview -->
        <TextView
            android:id='@+id/tv_result'
            android:layout_width='match_parent'
            android:layout_height='wrap_content'
            android:text=''
            android:gravity='end'
            android:textSize='22sp'
            android:textColor='@color/text_secondary'
            android:layout_marginTop='8dp'
            android:singleLine='true' />
    </LinearLayout>

    <!-- Spacing border separator -->
    <View
        android:layout_width='match_parent'
        android:layout_height='1dp'
        android:background='#E0E6ED'/>

    <!-- Input Grid System -->
    <LinearLayout
        android:layout_width='match_parent'
        android:layout_height='0dp'
        android:layout_weight='6.8'
        android:orientation='vertical'
        android:padding='16dp'
        android:gravity='center'>

        <!-- Row 1: C | DEL | % | / -->
        <LinearLayout
            android:layout_width='match_parent'
            android:layout_height='0dp'
            android:layout_weight='1'
            android:orientation='horizontal'
            android:layout_marginBottom='12dp'>

            <Button
                android:id='@+id/btn_clear'
                android:layout_width='0dp'
                android:layout_height='match_parent'
                android:layout_weight='1'
                android:layout_marginEnd='12dp'
                android:background='@drawable/btn_action_selector'
                android:text='C'
                android:textSize='22sp'
                android:textColor='@color/text_primary'
                android:textAllCaps='false' />

            <Button
                android:id='@+id/btn_delete'
                android:layout_width='0dp'
                android:layout_height='match_parent'
                android:layout_weight='1'
                android:layout_marginEnd='12dp'
                android:background='@drawable/btn_action_selector'
                android:text='⌫'
                android:textSize='22sp'
                android:textColor='@color/text_primary'
                android:textAllCaps='false' />

            <Button
                android:id='@+id/btn_percent'
                android:layout_width='0dp'
                android:layout_height='match_parent'
                android:layout_weight='1'
                android:layout_marginEnd='12dp'
                android:background='@drawable/btn_action_selector'
                android:text='%'
                android:textSize='22sp'
                android:textColor='@color/text_primary'
                android:textAllCaps='false' />

            <Button
                android:id='@+id/btn_divide'
                android:layout_width='0dp'
                android:layout_height='match_parent'
                android:layout_weight='1'
                android:background='@drawable/btn_operator_selector'
                android:text='÷'
                android:textSize='26sp'
                android:textColor='#FFFFFF'
                android:textAllCaps='false' />
        </LinearLayout>

        <!-- Row 2: 7 | 8 | 9 | * -->
        <LinearLayout
            android:layout_width='match_parent'
            android:layout_height='0dp'
            android:layout_weight='1'
            android:orientation='horizontal'
            android:layout_marginBottom='12dp'>

            <Button
                android:id='@+id/btn_7'
                android:layout_width='0dp'
                android:layout_height='match_parent'
                android:layout_weight='1'
                android:layout_marginEnd='12dp'
                android:background='@drawable/btn_number_selector'
                android:text='7'
                android:textSize='24sp'
                android:textColor='@color/text_primary'
                android:textAllCaps='false' />

            <Button
                android:id='@+id/btn_8'
                android:layout_width='0dp'
                android:layout_height='match_parent'
                android:layout_weight='1'
                android:layout_marginEnd='12dp'
                android:background='@drawable/btn_number_selector'
                android:text='8'
                android:textSize='24sp'
                android:textColor='@color/text_primary'
                android:textAllCaps='false' />

            <Button
                android:id='@+id/btn_9'
                android:layout_width='0dp'
                android:layout_height='match_parent'
                android:layout_weight='1'
                android:layout_marginEnd='12dp'
                android:background='@drawable/btn_number_selector'
                android:text='9'
                android:textSize='24sp'
                android:textColor='@color/text_primary'
                android:textAllCaps='false' />

            <Button
                android:id='@+id/btn_multiply'
                android:layout_width='0dp'
                android:layout_height='match_parent'
                android:layout_weight='1'
                android:background='@drawable/btn_operator_selector'
                android:text='×'
                android:textSize='26sp'
                android:textColor='#FFFFFF'
                android:textAllCaps='false' />
        </LinearLayout>

        <!-- Row 3: 4 | 5 | 6 | - -->
        <LinearLayout
            android:layout_width='match_parent'
            android:layout_height='0dp'
            android:layout_weight='1'
            android:orientation='horizontal'
            android:layout_marginBottom='12dp'>

            <Button
                android:id='@+id/btn_4'
                android:layout_width='0dp'
                android:layout_height='match_parent'
                android:layout_weight='1'
                android:layout_marginEnd='12dp'
                android:background='@drawable/btn_number_selector'
                android:text='4'
                android:textSize='24sp'
                android:textColor='@color/text_primary'
                android:textAllCaps='false' />

            <Button
                android:id='@+id/btn_5'
                android:layout_width='0dp'
                android:layout_height='match_parent'
                android:layout_weight='1'
                android:layout_marginEnd='12dp'
                android:background='@drawable/btn_number_selector'
                android:text='5'
                android:textSize='24sp'
                android:textColor='@color/text_primary'
                android:textAllCaps='false' />

            <Button
                android:id='@+id/btn_6'
                android:layout_width='0dp'
                android:layout_height='match_parent'
                android:layout_weight='1'
                android:layout_marginEnd='12dp'
                android:background='@drawable/btn_number_selector'
                android:text='6'
                android:textSize='24sp'
                android:textColor='@color/text_primary'
                android:textAllCaps='false' />

            <Button
                android:id='@+id/btn_subtract'
                android:layout_width='0dp'
                android:layout_height='match_parent'
                android:layout_weight='1'
                android:background='@drawable/btn_operator_selector'
                android:text='-'
                android:textSize='26sp'
                android:textColor='#FFFFFF'
                android:textAllCaps='false' />
        </LinearLayout>

        <!-- Row 4: 1 | 2 | 3 | + -->
        <LinearLayout
            android:layout_width='match_parent'
            android:layout_height='0dp'
            android:layout_weight='1'
            android:orientation='horizontal'
            android:layout_marginBottom='12dp'>

            <Button
                android:id='@+id/btn_1'
                android:layout_width='0dp'
                android:layout_height='match_parent'
                android:layout_weight='1'
                android:layout_marginEnd='12dp'
                android:background='@drawable/btn_number_selector'
                android:text='1'
                android:textSize='24sp'
                android:textColor='@color/text_primary'
                android:textAllCaps='false' />

            <Button
                android:id='@+id/btn_2'
                android:layout_width='0dp'
                android:layout_height='match_parent'
                android:layout_weight='1'
                android:layout_marginEnd='12dp'
                android:background='@drawable/btn_number_selector'
                android:text='2'
                android:textSize='24sp'
                android:textColor='@color/text_primary'
                android:textAllCaps='false' />

            <Button
                android:id='@+id/btn_3'
                android:layout_width='0dp'
                android:layout_height='match_parent'
                android:layout_weight='1'
                android:layout_marginEnd='12dp'
                android:background='@drawable/btn_number_selector'
                android:text='3'
                android:textSize='24sp'
                android:textColor='@color/text_primary'
                android:textAllCaps='false' />

            <Button
                android:id='@+id/btn_add'
                android:layout_width='0dp'
                android:layout_height='match_parent'
                android:layout_weight='1'
                android:background='@drawable/btn_operator_selector'
                android:text='+'
                android:textSize='26sp'
                android:textColor='#FFFFFF'
                android:textAllCaps='false' />
        </LinearLayout>

        <!-- Row 5: +/- | 0 | . | = -->
        <LinearLayout
            android:layout_width='match_parent'
            android:layout_height='0dp'
            android:layout_weight='1'
            android:orientation='horizontal'>

            <Button
                android:id='@+id/btn_plus_minus'
                android:layout_width='0dp'
                android:layout_height='match_parent'
                android:layout_weight='1'
                android:layout_marginEnd='12dp'
                android:background='@drawable/btn_number_selector'
                android:text='±'
                android:textSize='24sp'
                android:textColor='@color/text_primary'
                android:textAllCaps='false' />

            <Button
                android:id='@+id/btn_0'
                android:layout_width='0dp'
                android:layout_height='match_parent'
                android:layout_weight='1'
                android:layout_marginEnd='12dp'
                android:background='@drawable/btn_number_selector'
                android:text='0'
                android:textSize='24sp'
                android:textColor='@color/text_primary'
                android:textAllCaps='false' />

            <Button
                android:id='@+id/btn_dot'
                android:layout_width='0dp'
                android:layout_height='match_parent'
                android:layout_weight='1'
                android:layout_marginEnd='12dp'
                android:background='@drawable/btn_number_selector'
                android:text='.'
                android:textSize='24sp'
                android:textColor='@color/text_primary'
                android:textAllCaps='false' />

            <Button
                android:id='@+id/btn_equal'
                android:layout_width='0dp'
                android:layout_height='match_parent'
                android:layout_weight='1'
                android:background='@drawable/btn_operator_selector'
                android:text='='
                android:textSize='26sp'
                android:textColor='#FFFFFF'
                android:textAllCaps='false' />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>