<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <TextView
        android:id="@+id/text_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ARROW FLOW"
        android:textSize="38sp"
        android:textStyle="bold"
        android:textColor="#38BDF8"
        android:gravity="center"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/text_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CRASH COURSE"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#FB923C"
        android:gravity="center"
        android:layout_marginBottom="40dp"/>

    <TextView
        android:id="@+id/text_highscore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cosmic High Score: 0"
        android:textSize="18sp"
        android:textColor="#94A3B8"
        android:layout_marginBottom="48dp" />

    <Button
        android:id="@+id/btn_play"
        android:layout_width="240dp"
        android:layout_height="64dp"
        android:text="PLAY MISSIONS"
        android:textSize="18sp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#38BDF8"
        android:textColor="#090D16"/>

    <Button
        android:id="@+id/btn_settings"
        android:layout_width="240dp"
        android:layout_height="56dp"
        android:text="THEME &amp; SETTINGS"
        android:textSize="16sp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#1B2336"
        android:textColor="#F1F5F9"/>

    <Button
        android:id="@+id/btn_help"
        android:layout_width="240dp"
        android:layout_height="56dp"
        android:text="PILOT MANUAL"
        android:textSize="16sp"
        android:backgroundTint="#1B2336"
        android:textColor="#F1F5F9"/>

</LinearLayout>