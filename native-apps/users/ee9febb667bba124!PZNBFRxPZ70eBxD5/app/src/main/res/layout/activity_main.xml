<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#EBEBEB">

    <!-- Header toolbar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#212121"
        android:paddingHorizontal="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:text="Paint Studio"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_undo"
                android:layout_width="60dp"
                android:layout_height="38dp"
                android:layout_marginEnd="4dp"
                android:text="Undo"
                android:textSize="11sp"
                android:background="#424242"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btn_redo"
                android:layout_width="60dp"
                android:layout_height="38dp"
                android:layout_marginEnd="4dp"
                android:text="Redo"
                android:textSize="11sp"
                android:background="#424242"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btn_clear"
                android:layout_width="60dp"
                android:layout_height="38dp"
                android:layout_marginEnd="4dp"
                android:text="Clear"
                android:textSize="11sp"
                android:background="#D32F2F"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btn_save"
                android:layout_width="60dp"
                android:layout_height="38dp"
                android:text="Save"
                android:textSize="11sp"
                android:background="#388E3C"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Canvas area -->
    <FrameLayout
        android:id="@+id/canvas_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF">

        <!-- DrawingView will be inserted here programmatically -->
    </FrameLayout>

    <!-- Control Dashboard -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1E1E1E"
        android:padding="8dp">

        <!-- Palette selection (Horizontal Scroll) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/color_black"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_margin="4dp"
                    android:tag="#000000"
                    android:background="#000000" />
                <Button
                    android:id="@+id/color_red"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_margin="4dp"
                    android:tag="#F44336"
                    android:background="#F44336" />
                <Button
                    android:id="@+id/color_green"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_margin="4dp"
                    android:tag="#4CAF50"
                    android:background="#4CAF50" />
                <Button
                    android:id="@+id/color_blue"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_margin="4dp"
                    android:tag="#2196F3"
                    android:background="#2196F3" />
                <Button
                    android:id="@+id/color_yellow"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_margin="4dp"
                    android:tag="#FFEB3B"
                    android:background="#FFEB3B" />
                <Button
                    android:id="@+id/color_orange"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_margin="4dp"
                    android:tag="#FF9800"
                    android:background="#FF9800" />
                <Button
                    android:id="@+id/color_purple"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_margin="4dp"
                    android:tag="#9C27B0"
                    android:background="#9C27B0" />
                <Button
                    android:id="@+id/color_cyan"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_margin="4dp"
                    android:tag="#00BCD4"
                    android:background="#00BCD4" />
                <Button
                    android:id="@+id/color_pink"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_margin="4dp"
                    android:tag="#E91E63"
                    android:background="#E91E63" />
                <Button
                    android:id="@+id/color_brown"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_margin="4dp"
                    android:tag="#795548"
                    android:background="#795548" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Brush Size Slider and Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/txt_brush_size"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="Size: 10px"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/seek_brush_size"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="10" />
        </LinearLayout>

        <!-- Tool selector rows -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btn_tool_freehand"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:text="Brush"
                android:textSize="10sp"
                android:background="#5E5E5E"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btn_tool_line"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:text="Line"
                android:textSize="10sp"
                android:background="#3E3E3E"
                android:textColor="#BBBBBB" />

            <Button
                android:id="@+id/btn_tool_rect"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:text="Rect"
                android:textSize="10sp"
                android:background="#3E3E3E"
                android:textColor="#BBBBBB" />

            <Button
                android:id="@+id/btn_tool_circle"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:text="Circle"
                android:textSize="10sp"
                android:background="#3E3E3E"
                android:textColor="#BBBBBB" />

            <Button
                android:id="@+id/btn_tool_eraser"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:text="Eraser"
                android:textSize="10sp"
                android:background="#3E3E3E"
                android:textColor="#BBBBBB" />

            <Button
                android:id="@+id/btn_board_bg"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:text="BG"
                android:textSize="10sp"
                android:background="#4F5D75"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
