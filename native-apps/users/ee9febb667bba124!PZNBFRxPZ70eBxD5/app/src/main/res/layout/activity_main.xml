<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9">

    <!-- WELCOME / LOADER SCREEN -->
    <LinearLayout
        android:id="@+id/welcomeScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#FFFFFF"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="40dp">
            
            <!-- Styled Placeholder Logo -->
            <TextView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="#3F51B5"
                android:textColor="#FFFFFF"
                android:textSize="40sp"
                android:textStyle="bold"
                android:text="✓"
                android:gravity="center"
                android:layout_marginBottom="16dp"
                android:elevation="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Todo Pro"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your daily smart organizer"
                android:textSize="14sp"
                android:textColor="#757575"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/welcomeProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="0"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/welcomeStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Initializing..."
            android:textSize="12sp"
            android:textColor="#757575"
            android:textStyle="italic" />
    </LinearLayout>

    <!-- MAIN APPLICATION SCREEN -->
    <LinearLayout
        android:id="@+id/mainScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Custom App Bar Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#3F51B5"
            android:padding="16dp"
            android:elevation="4dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/btnAddNew">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Todo Pro"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtStats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 of 0 tasks completed"
                    android:textColor="#D0D4F1"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnAddNew"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="+ ADD"
                android:textColor="#3F51B5"
                android:background="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingLeft="16dp"
                android:paddingRight="16dp" />
        </RelativeLayout>

        <!-- Filter & Search Panel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:elevation="2dp">

            <!-- Search Input -->
            <EditText
                android:id="@+id/editSearch"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="#F0F2F5"
                android:hint="Search tasks..."
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:textSize="14sp"
                android:singleLine="true"
                android:textColor="#1A1A1A"
                android:layout_marginBottom="8dp" />

            <!-- Horizontal Filter Categories -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnFilterAll"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="All"
                    android:textSize="11sp"
                    android:background="#3F51B5"
                    android:textColor="#FFFFFF"
                    android:layout_marginRight="4dp" />

                <Button
                    android:id="@+id/btnFilterPending"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="Active"
                    android:textSize="11sp"
                    android:background="#E0E0E0"
                    android:textColor="#424242"
                    android:layout_marginRight="4dp" />

                <Button
                    android:id="@+id/btnFilterCompleted"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="Done"
                    android:textSize="11sp"
                    android:background="#E0E0E0"
                    android:textColor="#424242" />
            </LinearLayout>
        </LinearLayout>

        <!-- Scrollable Task List -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/taskListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Dynamically Populated Cards Go Here -->
                <TextView
                    android:id="@+id/txtEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:gravity="center"
                    android:text="No tasks to display!\nTap + ADD to get started."
                    android:textColor="#888888"
                    android:textSize="16sp"
                    android:lineSpacingMultiplier="1.2"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- CREATE / EDIT TASK BOTTOM OVERLAY -->
    <RelativeLayout
        android:id="@+id/addEditContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="20dp">

            <TextView
                android:id="@+id/txtFormTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create New Task"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A"
                android:layout_marginBottom="16dp" />

            <EditText
                android:id="@+id/editTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Task Name"
                android:textColor="#1A1A1A"
                android:textSize="16sp"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/editDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Description"
                android:textColor="#4A4A4A"
                android:textSize="14sp"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <!-- Category Input -->
                <EditText
                    android:id="@+id/editCategory"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Category (e.g. Work, Home)"
                    android:textColor="#4A4A4A"
                    android:textSize="14sp"
                    android:layout_marginRight="8dp" />

                <!-- Priority Level -->
                <Spinner
                    android:id="@+id/spinnerPriority"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical" />
            </LinearLayout>

            <!-- Due Date Field -->
            <EditText
                android:id="@+id/editDueDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Due Date (e.g. Tomorrow, Fri 6 PM)"
                android:textColor="#4A4A4A"
                android:textSize="14sp"
                android:layout_marginBottom="20dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCancel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cancel"
                    android:textColor="#757575"
                    android:background="#E0E0E0"
                    android:layout_marginRight="8dp" />

                <Button
                    android:id="@+id/btnSaveTask"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Save"
                    android:textColor="#FFFFFF"
                    android:background="#3F51B5" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
