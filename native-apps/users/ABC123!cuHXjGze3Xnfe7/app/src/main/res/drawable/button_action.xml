<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="#242B35" />
                </shape>
            </item>
            <item android:top="5dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <gradient 
                        android:startColor="#2D3748" 
                        android:endColor="#202733" 
                        android:angle="270" />
                    <stroke android:width="1dp" android:color="#3A475C" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Normal state -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="#1F242E" />
                </shape>
            </item>
            <item android:bottom="6dp" android:left="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <gradient 
                        android:startColor="#546E7A" 
                        android:endColor="#37474F" 
                        android:angle="270" />
                    <stroke android:width="1.5dp" android:color="#78909C" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>