<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.google.com/apk/res/android">
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="#0D3B11" />
                </shape>
            </item>
            <item android:top="5dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <gradient 
                        android:startColor="#1E5E26" 
                        android:endColor="#15421B" 
                        android:angle="270" />
                    <stroke android:width="1dp" android:color="#2E7D32" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Normal state -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="#144A1B" />
                </shape>
            </item>
            <item android:bottom="6dp" android:left="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <gradient 
                        android:startColor="#4CAF50" 
                        android:endColor="#2E7D32" 
                        android:angle="270" />
                    <stroke android:width="1.5dp" android:color="#81C784" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>