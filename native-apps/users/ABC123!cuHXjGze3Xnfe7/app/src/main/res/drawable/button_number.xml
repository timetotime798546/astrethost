<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state: Button cap is pushed downward reducing the 3D extrusion -->
    <item android:state_pressed="true">
        <layer-list>
            <!-- Extrusion Shadow (Recessed shadow) -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="#1A1A1C" />
                </shape>
            </item>
            <!-- Pressed active keycap shifted down -->
            <item android:top="5dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <gradient 
                        android:startColor="#242426" 
                        android:endColor="#1C1C1E" 
                        android:angle="270" />
                    <stroke android:width="1dp" android:color="#2D2D31" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Normal state: Raised 3D keycap -->
    <item>
        <layer-list>
            <!-- 3D extrusion/shadow side -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="#141416" />
                </shape>
            </item>
            <!-- Elevated keycap body (shifted up leaving bottom spacing visible) -->
            <item android:bottom="6dp" android:left="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <gradient 
                        android:startColor="#3E3E42" 
                        android:endColor="#2B2B2D" 
                        android:angle="270" />
                    <stroke android:width="1.5dp" android:color="#4F4F54" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>