<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep hollow container bar -->
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="10dp" />
            <solid android:color="#E2E8F0" />
        </shape>
    </item>
    <!-- Recessed glossy cylinder progressive bar -->
    <item android:id="@android:id/progress">
        <clip>
            <layer-list>
                <!-- 3D depth outline -->
                <item>
                    <shape>
                        <corners android:radius="10dp" />
                        <solid android:color="#312E81" />
                    </shape>
                </item>
                <!-- Progressive cylinder surface -->
                <item android:bottom="3dp">
                    <shape>
                        <corners android:radius="10dp" />
                        <gradient
                            android:startColor="#4F46E5"
                            android:endColor="#818CF8"
                            android:angle="90" />
                    </shape>
                </item>
            </layer-list>
        </clip>
    </item>
</layer-list>