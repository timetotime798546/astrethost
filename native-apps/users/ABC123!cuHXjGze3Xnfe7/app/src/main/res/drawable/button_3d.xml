<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="4dp" android:bottom="0dp" android:left="0dp" android:right="0dp">
                <shape android:shape="rectangle">
                    <solid android:color="#EC4899" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <!-- 3D shadow segment -->
            <item android:top="4dp" android:bottom="0dp" android:left="0dp" android:right="0dp">
                <shape android:shape="rectangle">
                    <solid android:color="#DB2777" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <!-- Foreground plate -->
            <item android:top="0dp" android:bottom="4dp" android:left="0dp" android:right="0dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#EC4899"
                        android:endColor="#F43F5E"
                        android:angle="0" />
                    <corners android:radius="12dp" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#FBCFE8" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>