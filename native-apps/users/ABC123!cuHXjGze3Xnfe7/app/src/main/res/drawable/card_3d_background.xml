<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom 3D solid shadow block -->
    <item android:top="8dp" android:bottom="0dp" android:left="0dp" android:right="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#CBD5E1" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- Top card plate -->
    <item android:top="0dp" android:bottom="8dp" android:left="0dp" android:right="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="20dp" />
            <stroke
                android:width="2dp"
                android:color="#94A3B8" />
        </shape>
    </item>
</layer-list>