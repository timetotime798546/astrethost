<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom 3D solid glow block representing spatial depth -->
    <item android:top="8dp" android:bottom="0dp" android:left="0dp" android:right="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#4338CA" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Top card plate -->
    <item android:top="0dp" android:bottom="8dp" android:left="0dp" android:right="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#1E293B" />
            <corners android:radius="16dp" />
            <stroke
                android:width="2dp"
                android:color="#818CF8" />
        </shape>
    </item>
</layer-list>