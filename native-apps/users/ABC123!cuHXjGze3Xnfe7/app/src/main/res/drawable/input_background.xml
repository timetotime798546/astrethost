<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- External Deep Recessed Bevel -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#CFD8DC" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <!-- Internal Upper Shadow -->
    <item android:top="2dp" android:left="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#B0BEC5" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <!-- Sunken Input Face (slightly displaced to create internal depth) -->
    <item android:top="3dp" android:left="3dp" android:bottom="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#FAFAFA" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</layer-list>