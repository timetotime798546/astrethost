<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#0C0E12" />
        </shape>
    </item>
    <item android:top="4dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient 
                android:startColor="#232731" 
                android:endColor="#171A21" 
                android:angle="270" />
            <stroke android:width="1dp" android:color="#2D3342" />
        </shape>
    </item>
</layer-list>