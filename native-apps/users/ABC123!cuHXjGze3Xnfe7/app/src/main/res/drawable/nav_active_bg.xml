<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep inner shadow background -->
    <item>
        <shape>
            <solid android:color="#CBD5E1" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Recessed active button panel -->
    <item android:top="3dp" android:left="2dp" android:right="2dp" android:bottom="1dp">
        <shape>
            <solid android:color="#EEF2FF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>