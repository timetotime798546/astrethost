<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state: simulated downward push compression -->
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="4dp" android:bottom="0dp">
                <shape>
                    <solid android:color="#312E81" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- Default state: popped up with 3D bottom extrusion depth -->
    <item>
        <layer-list>
            <!-- 3D Bevel Edge -->
            <item android:top="4dp">
                <shape>
                    <solid android:color="#312E81" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <!-- Top Tactile Gradient Surface -->
            <item android:bottom="4dp">
                <shape>
                    <gradient
                        android:startColor="#4F46E5"
                        android:endColor="#6366F1"
                        android:angle="45" />
                    <corners android:radius="12dp" />
                    <stroke android:width="1dp" android:color="#818CF8" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>