<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark outer framing bezel representing recess cut-out -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#0A0B0D" />
        </shape>
    </item>
    <!-- Recessed screen display surface shifted dynamically -->
    <item android:top="4dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient 
                android:startColor="#13151A" 
                android:endColor="#1D212A" 
                android:angle="270" />
            <stroke android:width="1dp" android:color="#232733" />
        </shape>
    </item>
</layer-list>