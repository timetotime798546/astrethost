<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark Outermost Shadow Layer -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#90A4AE" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Soft Intermediate Extrusion Layer -->
    <item android:bottom="2dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_shadow" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Raised Surface Face Layer -->
    <item android:bottom="6dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_bg" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#F1F5F7" />
        </shape>
    </item>
</layer-list>