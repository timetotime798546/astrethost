<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom Bevel / Extrusion Shadow -->
    <item android:top="6dp">
        <shape>
            <solid android:color="#120E36" />
        </shape>
    </item>
    <!-- Top Gradient Surface -->
    <item android:bottom="6dp">
        <shape>
            <gradient
                android:startColor="#1E1B4B"
                android:endColor="#4F46E5"
                android:angle="135"/>
        </shape>
    </item>
</layer-list>