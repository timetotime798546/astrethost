<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#2E2E3E" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#00E5FF" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#1A2A3A" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="#00E5FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1F1F28" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#2E2E3B" />
        </shape>
    </item>
</selector>