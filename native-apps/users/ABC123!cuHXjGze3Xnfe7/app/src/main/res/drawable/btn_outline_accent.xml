<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="2dp" android:bottom="0dp">
                <shape>
                    <solid android:color="#FFE4E6" />
                    <corners android:radius="10dp" />
                    <stroke android:width="1.5dp" android:color="#FDA4AF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- Default state -->
    <item>
        <layer-list>
            <!-- Shadow Layer -->
            <item android:top="2dp">
                <shape>
                    <solid android:color="#FECDD3" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <!-- Surface Layer -->
            <item android:bottom="2dp">
                <shape>
                    <solid android:color="#FFF1F2" />
                    <corners android:radius="10dp" />
                    <stroke android:width="1.5dp" android:color="#FB7185" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>