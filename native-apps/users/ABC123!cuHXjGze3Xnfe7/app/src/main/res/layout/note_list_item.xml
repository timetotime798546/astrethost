<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="14dp"
    android:background="@drawable/card_bg"
    android:padding="16dp">

    <!-- Top line containing title and category tag badge -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/itemTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@+id/itemTag"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Note Title"
            android:textColor="@color/text_dark"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/itemTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Personal"
            android:textSize="11sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Note Content -->
    <TextView
        android:id="@+id/itemContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="3"
        android:lineSpacingMultiplier="1.2"
        android:text="This is note description preview content."
        android:textColor="@color/gray_text"
        android:textSize="14sp"
        android:layout_marginBottom="12dp" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gray_border"
        android:layout_marginBottom="10dp" />

    <!-- Bottom Actions Row with Date & Control buttons -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Date Timestamp -->
        <TextView
            android:id="@+id/itemDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:text="Oct 24, 2023"
            android:textColor="@color/gray_text"
            android:textSize="12sp" />

        <!-- Control Action Buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:orientation="horizontal">

            <!-- Edit Button -->
            <Button
                android:id="@+id/itemBtnEdit"
                android:layout_width="54dp"
                android:layout_height="32dp"
                android:background="@drawable/button_secondary_bg"
                android:text="Edit"
                android:textColor="@color/primary_blue"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:layout_marginEnd="6dp" />

            <!-- Share Button -->
            <Button
                android:id="@+id/itemBtnShare"
                android:layout_width="54dp"
                android:layout_height="32dp"
                android:background="@drawable/button_secondary_bg"
                android:text="Share"
                android:textColor="@color/text_dark"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:layout_marginEnd="6dp" />

            <!-- Delete Button -->
            <Button
                android:id="@+id/itemBtnDelete"
                android:layout_width="54dp"
                android:layout_height="32dp"
                android:background="@drawable/button_secondary_bg"
                android:text="Delete"
                android:textColor="#DC2626"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textAllCaps="false" />
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>