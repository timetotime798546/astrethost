<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="18dp"
    android:gravity="center_vertical"
    android:background="@drawable/card_bg"
    android:elevation="2dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="8dp"
    android:layout_marginLeft="6dp"
    android:layout_marginRight="6dp">

    <CheckBox
        android:id="@+id/task_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="14dp"
        android:buttonTint="#4F46E5" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/task_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Finish Lab 3 Assignment"
            android:textColor="#0F172A"
            android:textStyle="bold"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/task_subject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CS-101"
                android:textColor="#4F46E5"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/badge_subject"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginRight="8dp"/>

            <TextView
                android:id="@+id/task_due_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅 Oct 25"
                android:textColor="#E11D48"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginRight="8dp"/>

            <TextView
                android:id="@+id/task_priority"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HIGH"
                android:textColor="#E11D48"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/badge_high"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginRight="8dp"/>

            <TextView
                android:id="@+id/task_hours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏱️ 2 hrs"
                android:textColor="#475569"
                android:textSize="12sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btn_delete_task"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:text="🗑️"
        android:textSize="16sp"
        android:textColor="#EF4444"
        android:background="@drawable/btn_outline_accent"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:layout_marginLeft="10dp"/>
</LinearLayout>