<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_horizontal">

        <!-- HEADER VIEW WITH 5D STATE INDICATOR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PENTERACT INTERSECTION SIMULATOR"
                    android:textColor="#38BDF8"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.25" />

                <TextView
                    android:id="@+id/tvChronosHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HyperSpace 5D"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnAudioToggle"
                android:layout_width="110dp"
                android:layout_height="36dp"
                android:text="🔊 BEATS: ON"
                android:textSize="9sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:layout_marginLeft="6dp" />
        </LinearLayout>

        <!-- HYPERSPACE 5D CORE VIEWPORT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_3d_background"
            android:padding="12dp"
            android:gravity="center_horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5-DIMENSIONAL REAL-TIME GRAPH"
                android:textColor="#818CF8"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp" />

            <!-- Active Hyper-Shape Selection Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="10dp">

                <Button
                    android:id="@+id/btnShapeSimplex"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="36dp"
                    android:text="5-Simplex"
                    android:textSize="9sp"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:layout_marginRight="4dp" />

                <Button
                    android:id="@+id/btnShapePenteract"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="36dp"
                    android:text="Penteract (5-Cube)"
                    android:textSize="9sp"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:layout_marginRight="4dp" />

                <Button
                    android:id="@+id/btnShapeCross"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="36dp"
                    android:text="5D Cross"
                    android:textSize="9sp"
                    android:textAllCaps="false"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Embedded Custom 5D Render Canvas -->
            <com.hyperspace5d.app.Hyper5DView
                android:id="@+id/hyper5DView"
                android:layout_width="match_parent"
                android:layout_height="220dp" />

            <!-- Spatial Real-time Analytics Display -->
            <TextView
                android:id="@+id/tvProjectionMetrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="W-Axis Offset: 0.00 | V-Axis Offset: 0.00 | Faces Projected: 80"
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:gravity="center"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- INTERACTIVE MULTIDIMENSIONAL SLIDERS CARD -->
        <LinearLayout
            android:id="@+id/cardControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_3d_background"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4TH DIMENSION SHIFT (W-AXIS)"
                android:textColor="#34D399"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="4dp" />

            <SeekBar
                android:id="@+id/sbWAxis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="200"
                android:progress="100"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5TH DIMENSION SHIFT (V-AXIS)"
                android:textColor="#F43F5E"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="4dp" />

            <SeekBar
                android:id="@+id/sbVAxis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="200"
                android:progress="100"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACTIVE MULTI-DIMENSIONAL ROTATION PLANES"
                android:textColor="#818CF8"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp" />

            <!-- Row 1 Planes Toggle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp"
                android:weightSum="3">

                <Button
                    android:id="@+id/btnToggleXY"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="X - Y"
                    android:textSize="9sp"
                    android:textAllCaps="false"
                    android:layout_marginRight="4dp" />

                <Button
                    android:id="@+id/btnToggleXW"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="X - W"
                    android:textSize="9sp"
                    android:textAllCaps="false"
                    android:layout_marginRight="4dp" />

                <Button
                    android:id="@+id/btnToggleZV"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="Z - V"
                    android:textSize="9sp"
                    android:textAllCaps="false" />
            </LinearLayout>

            <!-- Row 2 Planes Toggle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp"
                android:weightSum="3">

                <Button
                    android:id="@+id/btnToggleYW"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="Y - W"
                    android:textSize="9sp"
                    android:textAllCaps="false"
                    android:layout_marginRight="4dp" />

                <Button
                    android:id="@+id/btnToggleXV"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="X - V"
                    android:textSize="9sp"
                    android:textAllCaps="false"
                    android:layout_marginRight="4dp" />

                <Button
                    android:id="@+id/btnToggleWV"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="W - V"
                    android:textSize="9sp"
                    android:textAllCaps="false" />
            </LinearLayout>

            <!-- Dynamic Interdimensional Harmonization Button -->
            <Button
                android:id="@+id/btnHarmonize"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/button_3d"
                android:text="Harmonize Coordinates ⚡"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="false" />

        </LinearLayout>

        <!-- VOLUMETRIC WISDOM DRAWER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/wisdom_3d_background"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DIMENSIONAL FIELD CHRONICLES"
                android:textColor="#2DD4BF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvAtmosphereQuote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="“Hyperspace is the bridge connecting simple coordinates with multi-dimensional eternity.”"
                android:textColor="#E2E8F0"
                android:textSize="13sp"
                android:textStyle="italic"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnExciteAtmosphere"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Shift Atmospheric Vector →"
                android:textSize="10sp"
                android:background="#00000000"
                android:textColor="#38BDF8"
                android:textAllCaps="false"
                android:paddingLeft="0dp"
                android:paddingRight="0dp"
                android:textStyle="bold"/>

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HyperSpace 5D • Built with Pure Matrix Mathematics"
            android:textColor="#475569"
            android:textSize="10sp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>