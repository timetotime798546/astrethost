<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ECEFF1"
    android:padding="24dp">

    <LinearLayout
        android:id="@+id/card_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:background="@drawable/card_background"
        android:orientation="vertical"
        android:padding="32dp"
        android:gravity="center"
        android:elevation="4dp">

        <!-- Animated Avatar icon -->
        <TextView
            android:id="@+id/logo_icon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/circle_background"
            android:gravity="center"
            android:text="👋"
            android:textSize="40sp"
            android:layout_marginBottom="24dp" />

        <!-- App Heading -->
        <TextView
            android:id="@+id/welcome_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome!"
            android:textColor="#212121"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <!-- Informative Details -->
        <TextView
            android:id="@+id/welcome_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="We are preparing things for you."
            android:textColor="#757575"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Loader widget -->
        <ProgressBar
            android:id="@+id/loader_progress"
            style="?android:attr/progressBarStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp" />

        <!-- Status updates -->
        <TextView
            android:id="@+id/loader_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connecting securely..."
            android:textColor="#3F51B5"
            android:textSize="14sp"
            android:textStyle="italic"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Explore action button (appears once loader completes) -->
        <Button
            android:id="@+id/action_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reload App"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_background"
            android:visibility="gone"
            android:layout_marginTop="8dp" />

    </LinearLayout>

    <!-- Branding Footnote -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:text="Powered by Android Native"
        android:textColor="#9E9E9E"
        android:textSize="12sp"
        android:layout_marginBottom="16dp" />

</RelativeLayout>