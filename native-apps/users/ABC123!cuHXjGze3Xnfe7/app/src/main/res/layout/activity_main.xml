<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC">

    <!-- Premium Custom Header bar with elegant 3D gradient and bottom shadow bevel -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@drawable/header_3d_bg"
        android:elevation="8dp"
        android:paddingLeft="24dp"
        android:paddingRight="24dp">

        <TextView
            android:id="@+id/header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentLeft="true"
            android:text="🎓 Study Planner Pro"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

        <TextView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:background="@drawable/badge_subject"
            android:gravity="center"
            android:text="🎯"
            android:textSize="22sp"/>
    </RelativeLayout>

    <!-- Main Content Frame with soft border highlights -->
    <FrameLayout
        android:id="@+id/content_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- DASHBOARD TAB -->
        <ScrollView
            android:id="@+id/dashboard_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Welcome Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:elevation="2dp"
                    android:padding="20dp"
                    android:layout_marginBottom="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Welcome Back, Scholar! 🌟"
                        android:textColor="#0F172A"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Stay on top of your study schedule &amp; reach your academic goals."
                        android:textColor="#475569"
                        android:textSize="14sp"
                        android:layout_marginTop="6dp"
                        android:lineSpacingMultiplier="1.2" />
                </LinearLayout>

                <!-- Progress Tracker Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:elevation="3dp"
                    android:padding="22dp"
                    android:layout_marginBottom="18dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentLeft="true"
                            android:layout_centerVertical="true"
                            android:text="📈 Semester Task Progress"
                            android:textColor="#0F172A"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/dashboard_progress_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"
                            android:layout_centerVertical="true"
                            android:text="0%"
                            android:textColor="#4F46E5"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <ProgressBar
                        android:id="@+id/dashboard_progress_bar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="16dp"
                        android:layout_marginTop="16dp"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/custom_progress_bar" />
                </LinearLayout>

                <!-- Daily Study Quote Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_quote_bg"
                    android:elevation="2dp"
                    android:padding="18dp"
                    android:layout_marginBottom="22dp">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💡 INSPIRATIONAL THOUGHT"
                        android:textColor="#4F46E5"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/tv_study_quote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="&quot;The secret of getting ahead is getting started.&quot;"
                        android:textColor="#334155"
                        android:textSize="15sp"
                        android:textStyle="italic"
                        android:lineSpacingMultiplier="1.2" />
                </LinearLayout>

                <!-- Statistics Grid Row 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <!-- Card 1: Subjects -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/card_subjects_bg"
                        android:elevation="2dp"
                        android:orientation="horizontal"
                        android:layout_marginRight="8dp">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="match_parent"
                            android:background="#4F46E5" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="18dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📚 Courses"
                                android:textColor="#4F46E5"
                                android:textSize="13sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/stats_subjects_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="#0F172A"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:layout_marginTop="8dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Card 2: Tasks -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/card_pending_bg"
                        android:elevation="2dp"
                        android:orientation="horizontal"
                        android:layout_marginLeft="8dp">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="match_parent"
                            android:background="#F43F5E" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="18dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⏳ Pending"
                                android:textColor="#E11D48"
                                android:textSize="13sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/stats_tasks_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="#F43F5E"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:layout_marginTop="8dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Statistics Grid Row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="26dp">

                    <!-- Card 3: Completed Tasks -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/card_completed_bg"
                        android:elevation="2dp"
                        android:orientation="horizontal"
                        android:layout_marginRight="8dp">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="match_parent"
                            android:background="#10B981" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="18dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✅ Done"
                                android:textColor="#059669"
                                android:textSize="13sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/stats_completed_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="#10B981"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:layout_marginTop="8dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Card 4: Study Hours -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/card_hours_bg"
                        android:elevation="2dp"
                        android:orientation="horizontal"
                        android:layout_marginLeft="8dp">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="match_parent"
                            android:background="#F59E0B" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="18dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⏱️ Study Budget"
                                android:textColor="#D97706"
                                android:textSize="13sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/stats_hours_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 hrs"
                                android:textColor="#F59E0B"
                                android:textSize="25sp"
                                android:textStyle="bold"
                                android:layout_marginTop="8dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Upcoming Deadlines Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📅 High Priority Study Agenda"
                    android:textColor="#0F172A"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="14dp"
                    android:letterSpacing="0.01"/>

                <!-- Upcoming tasks container -->
                <LinearLayout
                    android:id="@+id/upcoming_tasks_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <!-- Dynamic child items will be inflated here in Java -->
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_no_upcoming"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎉 No upcoming tasks. Excellent schedule discipline!"
                    android:textColor="#64748B"
                    android:gravity="center"
                    android:padding="36dp"
                    android:background="@drawable/card_bg"
                    android:layout_marginTop="8dp"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <!-- Quick Button to Go to Tasks -->
                <Button
                    android:id="@+id/btn_quick_add_task"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/btn_primary"
                    android:text="Manage Tasks &amp; Schedule 📝"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:elevation="3dp" />

            </LinearLayout>
        </ScrollView>

        <!-- SUBJECTS TAB -->
        <LinearLayout
            android:id="@+id/subjects_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <!-- Subject Input Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:elevation="2dp"
                android:padding="22dp"
                android:layout_marginBottom="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📚 Register New Academic Subject"
                    android:textColor="#0F172A"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"/>

                <EditText
                    android:id="@+id/et_subject_code"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/edittext_bg"
                    android:hint="Subject Code (e.g. MATH-101)"
                    android:paddingLeft="18dp"
                    android:paddingRight="18dp"
                    android:textColor="#0F172A"
                    android:textColorHint="#94A3B8"
                    android:textSize="15sp"
                    android:singleLine="true"/>

                <EditText
                    android:id="@+id/et_subject_name"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/edittext_bg"
                    android:hint="Subject Name (e.g. Advanced Calculus)"
                    android:layout_marginTop="14dp"
                    android:paddingLeft="18dp"
                    android:paddingRight="18dp"
                    android:textColor="#0F172A"
                    android:textColorHint="#94A3B8"
                    android:textSize="15sp"
                    android:singleLine="true"/>

                <Button
                    android:id="@+id/btn_add_subject"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/btn_primary"
                    android:text="Save Subject 📚"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Registered Course Modules"
                android:textColor="#0F172A"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginBottom="14dp"/>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <ListView
                    android:id="@+id/subjects_listview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="@android:color/transparent"
                    android:dividerHeight="0dp"
                    android:overScrollMode="never" />

                <TextView
                    android:id="@+id/tv_no_subjects"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No subjects registered yet. Create one above!"
                    android:textColor="#64748B"
                    android:gravity="center"
                    android:padding="36dp"
                    android:background="@drawable/card_bg"
                    android:textSize="15sp"
                    android:visibility="gone" />
            </FrameLayout>

        </LinearLayout>

        <!-- TASKS TAB -->
        <LinearLayout
            android:id="@+id/tasks_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <!-- Filter and Create Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:elevation="2dp"
                android:padding="18dp"
                android:layout_marginBottom="18dp">

                <Button
                    android:id="@+id/btn_open_add_task_dialog"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/btn_primary"
                    android:text="➕ Schedule Study Task"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>

                <!-- Filters -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Filter:"
                        android:textColor="#64748B"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginRight="10dp"/>

                    <Spinner
                        android:id="@+id/spinner_filter_status"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:background="@drawable/edittext_bg"/>

                    <View
                        android:layout_width="12dp"
                        android:layout_height="match_parent" />

                    <Spinner
                        android:id="@+id/spinner_filter_subject"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1.2"
                        android:background="@drawable/edittext_bg"/>
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <ListView
                    android:id="@+id/tasks_listview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="@android:color/transparent"
                    android:dividerHeight="0dp"
                    android:overScrollMode="never" />

                <TextView
                    android:id="@+id/tv_no_tasks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No study tasks found matching filters."
                    android:textColor="#64748B"
                    android:gravity="center"
                    android:padding="36dp"
                    android:background="@drawable/card_bg"
                    android:textSize="15sp"
                    android:visibility="gone" />
            </FrameLayout>

        </LinearLayout>

    </FrameLayout>

    <!-- Premium Clean Bottom Navigation Bar with 3D inset bevel tray -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:orientation="horizontal"
        android:background="@drawable/nav_bar_3d_bg"
        android:elevation="16dp"
        android:gravity="center_vertical"
        android:paddingLeft="14dp"
        android:paddingRight="14dp">

        <!-- Tab 1 Button -->
        <LinearLayout
            android:id="@+id/nav_dashboard"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginRight="6dp">

            <TextView
                android:id="@+id/tv_nav_dashboard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊 Dashboard"
                android:textColor="#4F46E5"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />
        </LinearLayout>

        <!-- Tab 2 Button -->
        <LinearLayout
            android:id="@+id/nav_subjects"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp">

            <TextView
                android:id="@+id/tv_nav_subjects"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📚 Subjects"
                android:textColor="#64748B"
                android:textSize="14sp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />
        </LinearLayout>

        <!-- Tab 3 Button -->
        <LinearLayout
            android:id="@+id/nav_tasks"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginLeft="6dp">

            <TextView
                android:id="@+id/tv_nav_tasks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📝 Tasks"
                android:textColor="#64748B"
                android:textSize="14sp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>