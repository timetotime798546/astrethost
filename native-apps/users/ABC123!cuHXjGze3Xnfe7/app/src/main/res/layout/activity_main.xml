<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F3F8">

    <!-- Top Toolbar / Header -->
    <RelativeLayout
        android:id="@+id/toolbar_container"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#6C5CE7"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/toolbar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alphabet Explorer"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_centerVertical="true"/>

        <TextView
            android:id="@+id/toolbar_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Score: 0"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:gravity="center"
            android:visibility="gone"/>
    </RelativeLayout>

    <!-- Content Area Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- MODE 1: Learn Grid View -->
        <LinearLayout
            android:id="@+id/container_learn"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="visible">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select a letter to explore!"
                android:textColor="#57606F"
                android:textSize="16sp"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:textStyle="bold"/>

            <GridView
                android:id="@+id/alphabet_grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:numColumns="3"
                android:verticalSpacing="12dp"
                android:horizontalSpacing="12dp"
                android:stretchMode="columnWidth"
                android:gravity="center"/>
        </LinearLayout>

        <!-- MODE 2: Quiz Game View -->
        <RelativeLayout
            android:id="@+id/container_quiz"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/quiz_prompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Which letter makes the sound...?"
                android:textColor="#374151"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="20dp"/>

            <TextView
                android:id="@+id/quiz_target_letter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="?"
                android:textColor="#FF6B6B"
                android:textSize="96sp"
                android:textStyle="bold"
                android:layout_centerHorizontal="true"
                android:layout_below="@id/quiz_prompt"
                android:layout_marginTop="16dp"/>

            <Button
                android:id="@+id/btn_quiz_listen"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:text="🔊 Listen Sound"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_below="@id/quiz_target_letter"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="16dp"
                android:textColor="#FFFFFF"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                style="?android:attr/borderlessButtonStyle"/>

            <!-- Grid of options -->
            <GridLayout
                android:id="@+id/quiz_options_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="16dp"
                android:columnCount="2"
                android:rowCount="2"
                android:alignmentMode="alignBounds">

                <Button
                    android:id="@+id/btn_option_1"
                    android:layout_width="0dp"
                    android:layout_height="76dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="8dp"
                    android:text="A"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    style="?android:attr/borderlessButtonStyle"/>

                <Button
                    android:id="@+id/btn_option_2"
                    android:layout_width="0dp"
                    android:layout_height="76dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="8dp"
                    android:text="B"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    style="?android:attr/borderlessButtonStyle"/>

                <Button
                    android:id="@+id/btn_option_3"
                    android:layout_width="0dp"
                    android:layout_height="76dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="8dp"
                    android:text="C"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    style="?android:attr/borderlessButtonStyle"/>

                <Button
                    android:id="@+id/btn_option_4"
                    android:layout_width="0dp"
                    android:layout_height="76dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="8dp"
                    android:text="D"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    style="?android:attr/borderlessButtonStyle"/>
            </GridLayout>
        </RelativeLayout>

        <!-- MODE 3: Tracing View -->
        <RelativeLayout
            android:id="@+id/container_trace"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/trace_instruction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Trace the letter below"
                android:textColor="#374151"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="10dp"/>

            <FrameLayout
                android:id="@+id/trace_canvas_holder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_above="@+id/trace_controls"
                android:layout_below="@id/trace_instruction"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="#FFFFFF"
                android:padding="4dp"/>

            <LinearLayout
                android:id="@+id/trace_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btn_trace_prev"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:text="◀ Prev"
                    android:layout_weight="1"
                    android:layout_marginRight="6dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    style="?android:attr/borderlessButtonStyle"/>

                <Button
                    android:id="@+id/btn_trace_clear"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:text="🧹 Clear"
                    android:layout_weight="1"
                    android:layout_marginRight="6dp"
                    android:layout_marginLeft="6dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    style="?android:attr/borderlessButtonStyle"/>

                <Button
                    android:id="@+id/btn_trace_next"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:text="Next ▶"
                    android:layout_weight="1"
                    android:layout_marginLeft="6dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    style="?android:attr/borderlessButtonStyle"/>
            </LinearLayout>
        </RelativeLayout>

        <!-- Overlay Detail Layout (Modal Sheet Style) -->
        <FrameLayout
            android:id="@+id/detail_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#A61A2130"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            android:padding="24dp">

            <!-- Rounded White Card Container -->
            <LinearLayout
                android:id="@+id/detail_card_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Header / Close button -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Letter Details"
                        android:textColor="#1F2937"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_centerVertical="true"/>

                    <Button
                        android:id="@+id/btn_close_detail"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:text="✕"
                        android:textSize="14sp"
                        android:textColor="#9CA3AF"
                        android:background="#F3F4F6"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        style="?android:attr/borderlessButtonStyle"/>
                </RelativeLayout>

                <!-- Letter Pairing -->
                <TextView
                    android:id="@+id/detail_letter_pair"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Aa"
                    android:textColor="#6C5CE7"
                    android:textSize="96sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"/>

                <!-- Description / Phrase -->
                <TextView
                    android:id="@+id/detail_word_phrase"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="A is for Apple"
                    android:textColor="#374151"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="24dp"/>

                <!-- Speaker / Voice Button -->
                <Button
                    android:id="@+id/btn_speak_detail"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="🔊 Listen Phonics"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="24dp"
                    style="?android:attr/borderlessButtonStyle"/>

                <!-- Navigation Controls -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <Button
                        android:id="@+id/btn_detail_prev"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginRight="8dp"
                        android:text="◀ Previous"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#6C5CE7"
                        android:background="#F3F4F6"
                        style="?android:attr/borderlessButtonStyle"/>

                    <Button
                        android:id="@+id/btn_detail_next"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginLeft="8dp"
                        android:text="Next ▶"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="#6C5CE7"
                        style="?android:attr/borderlessButtonStyle"/>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>

    <!-- Bottom Navigation Bar (Floating Pills Style) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:gravity="center"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <Button
            android:id="@+id/nav_btn_learn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="📖 Learn"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            style="?android:attr/borderlessButtonStyle"/>

        <Button
            android:id="@+id/nav_btn_quiz"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="❓ Quiz"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            style="?android:attr/borderlessButtonStyle"/>

        <Button
            android:id="@+id/nav_btn_trace"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="✍️ Trace"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            style="?android:attr/borderlessButtonStyle"/>
    </LinearLayout>
</LinearLayout>