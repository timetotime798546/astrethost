<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC">

    <!-- Premium Custom Header bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#4F46E5"
        android:elevation="4dp"
        android:paddingLeft="20dp"
        android:paddingRight="20dp">

        <TextView
            android:id="@+id/header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="🎓 Study Planner Pro"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.02" />
    </RelativeLayout>

    <!-- Main Content Frame with soft border highlights -->
    <FrameLayout
        android:id="@+id/content_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- DASHBOARD TAB -->
        <ScrollView
            android:id="@+id/dashboard_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Progress Tracker Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:elevation="1dp"
                    android:padding="20dp"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📈 Overall Study Progress"
                        android:textColor="#1E293B"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical">

                        <ProgressBar
                            android:id="@+id/dashboard_progress_bar"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp"
                            android:layout_height="16dp"
                            android:layout_weight="1"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/custom_progress_bar" />

                        <TextView
                            android:id="@+id/dashboard_progress_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textColor="#4F46E5"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginLeft="14dp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Statistics Grid Row 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp">

                    <!-- Card 1: Subjects -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/card_subjects_bg"
                        android:elevation="1dp"
                        android:orientation="horizontal"
                        android:layout_marginRight="7dp">

                        <View
                            android:layout_width="5dp"
                            android:layout_height="match_parent"
                            android:background="#4F46E5" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📚 Subjects"
                                android:textColor="#4F46E5"
                                android:textSize="13sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/stats_subjects_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="#0F172A"
                                android:textSize="26sp"
                                android:textStyle="bold"
                                android:layout_marginTop="6dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Card 2: Tasks -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/card_pending_bg"
                        android:elevation="1dp"
                        android:orientation="horizontal"
                        android:layout_marginLeft="7dp">

                        <View
                            android:layout_width="5dp"
                            android:layout_height="match_parent"
                            android:background="#F43F5E" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⏳ Pending"
                                android:textColor="#E11D48"
                                android:textSize="13sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/stats_tasks_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="#F43F5E"
                                android:textSize="26sp"
                                android:textStyle="bold"
                                android:layout_marginTop="6dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Statistics Grid Row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="24dp">

                    <!-- Card 3: Completed Tasks -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/card_completed_bg"
                        android:elevation="1dp"
                        android:orientation="horizontal"
                        android:layout_marginRight="7dp">

                        <View
                            android:layout_width="5dp"
                            android:layout_height="match_parent"
                            android:background="#10B981" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✅ Completed"
                                android:textColor="#059669"
                                android:textSize="13sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/stats_completed_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="#10B981"
                                android:textSize="26sp"
                                android:textStyle="bold"
                                android:layout_marginTop="6dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Card 4: Study Hours -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/card_hours_bg"
                        android:elevation="1dp"
                        android:orientation="horizontal"
                        android:layout_marginLeft="7dp">

                        <View
                            android:layout_width="5dp"
                            android:layout_height="match_parent"
                            android:background="#F59E0B" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⏱️ Hours Plan"
                                android:textColor="#D97706"
                                android:textSize="13sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/stats_hours_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 hrs"
                                android:textColor="#F59E0B"
                                android:textSize="26sp"
                                android:textStyle="bold"
                                android:layout_marginTop="6dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Upcoming Deadlines Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📅 Upcoming Tasks &amp; Deadlines"
                    android:textColor="#1E293B"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"
                    android:letterSpacing="0.01"/>

                <!-- Upcoming tasks container -->
                <LinearLayout
                    android:id="@+id/upcoming_tasks_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <!-- Dynamic child items will be inflated here in Java -->
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_no_upcoming"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎉 No upcoming tasks. Great job!"
                    android:textColor="#64748B"
                    android:gravity="center"
                    android:padding="32dp"
                    android:background="@drawable/card_bg"
                    android:layout_marginTop="6dp"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <!-- Quick Button to Go to Tasks -->
                <Button
                    android:id="@+id/btn_quick_add_task"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/btn_primary"
                    android:text="Manage Tasks &amp; Schedule 📝"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:elevation="2dp" />

            </LinearLayout>
        </ScrollView>

        <!-- SUBJECTS TAB -->
        <LinearLayout
            android:id="@+id/subjects_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <!-- Subject Input Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:elevation="1dp"
                android:padding="20dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📚 Register New Subject"
                    android:textColor="#1E293B"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="14dp"/>

                <EditText
                    android:id="@+id/et_subject_code"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/edittext_bg"
                    android:hint="Subject Code (e.g. MATH-101)"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:textColor="#0F172A"
                    android:textColorHint="#94A3B8"
                    android:textSize="14sp"
                    android:singleLine="true"/>

                <EditText
                    android:id="@+id/et_subject_name"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/edittext_bg"
                    android:hint="Subject Name (e.g. Advanced Calculus)"
                    android:layout_marginTop="12dp"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:textColor="#0F172A"
                    android:textColorHint="#94A3B8"
                    android:textSize="14sp"
                    android:singleLine="true"/>

                <Button
                    android:id="@+id/btn_add_subject"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/btn_primary"
                    android:text="Save Subject 📚"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Registered Course Modules"
                android:textColor="#1E293B"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <ListView
                    android:id="@+id/subjects_listview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="@android:color/transparent"
                    android:dividerHeight="0dp"
                    android:overScrollMode="never" />

                <TextView
                    android:id="@+id/tv_no_subjects"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No subjects added yet."
                    android:textColor="#64748B"
                    android:gravity="center"
                    android:padding="32dp"
                    android:background="@drawable/card_bg"
                    android:textSize="15sp"
                    android:visibility="gone" />
            </FrameLayout>

        </LinearLayout>

        <!-- TASKS TAB -->
        <LinearLayout
            android:id="@+id/tasks_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <!-- Filter and Create Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:elevation="1dp"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btn_open_add_task_dialog"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/btn_primary"
                    android:text="➕ Schedule Study Task"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>

                <!-- Filters -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Filter:"
                        android:textColor="#64748B"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginRight="8dp"/>

                    <Spinner
                        android:id="@+id/spinner_filter_status"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/edittext_bg"/>

                    <View
                        android:layout_width="10dp"
                        android:layout_height="match_parent" />

                    <Spinner
                        android:id="@+id/spinner_filter_subject"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1.2"
                        android:background="@drawable/edittext_bg"/>
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <ListView
                    android:id="@+id/tasks_listview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="@android:color/transparent"
                    android:dividerHeight="0dp"
                    android:overScrollMode="never" />

                <TextView
                    android:id="@+id/tv_no_tasks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No tasks match filter rules."
                    android:textColor="#64748B"
                    android:gravity="center"
                    android:padding="32dp"
                    android:background="@drawable/card_bg"
                    android:textSize="15sp"
                    android:visibility="gone" />
            </FrameLayout>

        </LinearLayout>

    </FrameLayout>

    <!-- Premium Clean Bottom Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <!-- Tab 1 Button -->
        <LinearLayout
            android:id="@+id/nav_dashboard"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginRight="6dp">

            <TextView
                android:id="@+id/tv_nav_dashboard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊 Dashboard"
                android:textColor="#4F46E5"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />
        </LinearLayout>

        <!-- Tab 2 Button -->
        <LinearLayout
            android:id="@+id/nav_subjects"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp">

            <TextView
                android:id="@+id/tv_nav_subjects"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📚 Subjects"
                android:textColor="#64748B"
                android:textSize="13sp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />
        </LinearLayout>

        <!-- Tab 3 Button -->
        <LinearLayout
            android:id="@+id/nav_tasks"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginLeft="6dp">

            <TextView
                android:id="@+id/tv_nav_tasks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📝 Tasks"
                android:textColor="#64748B"
                android:textSize="13sp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>