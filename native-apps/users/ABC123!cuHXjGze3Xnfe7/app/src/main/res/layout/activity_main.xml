<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- MAIN DASHBOARD CONTAINER -->
    <LinearLayout
        android:id="@+id/layout_dashboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- Custom Header Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="#3F51B5"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerY="true"
                android:text="NoteSphere"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Search Bar and Filter Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="#FFFFFF"
            android:elevation="2dp">

            <EditText
                android:id="@+id/et_search"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:background="@android:drawable/edit_text"
                android:hint="Search notes by title or content..."
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Filter Category:"
                    android:textSize="14sp"
                    android:textColor="#555555"
                    android:layout_marginRight="8dp" />

                <Spinner
                    android:id="@+id/spinner_filter_category"
                    android:layout_width="match_parent"
                    android:layout_height="40dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Empty State View -->
        <TextView
            android:id="@+id/tv_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="64dp"
            android:gravity="center"
            android:text="No notes found!\nCreate your first note using the '+' button below."
            android:textColor="#777777"
            android:textSize="16sp"
            android:lineSpacingMultiplier="1.2"
            android:visibility="gone" />

        <!-- ListView for Notes -->
        <ListView
            android:id="@+id/lv_notes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:divider="#E0E0E0"
            android:dividerHeight="1dp"
            android:padding="8dp"
            android:clipToPadding="false"/>
    </LinearLayout>

    <!-- FLOATING ACTION BUTTON (ADD NOTE) -->
    <Button
        android:id="@+id/btn_add_note"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentRight="true"
        android:layout_margin="24dp"
        android:text="+"
        android:textSize="28sp"
        android:textColor="#FFFFFF"
        android:background="#FF4081"
        android:elevation="6dp" />

    <!-- NOTE EDIT/CREATE FORM OVERLAY (Visible only during editing/creating) -->
    <LinearLayout
        android:id="@+id/layout_editor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:visibility="gone">

        <!-- Editor Title Banner -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="#3F51B5"
            android:paddingHorizontal="16dp">

            <TextView
                android:id="@+id/tv_editor_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerY="true"
                android:text="New Note"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Title input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Title"
                android:textColor="#3F51B5"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/et_note_title"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@android:drawable/edit_text"
                android:hint="Enter note title..."
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:textSize="16sp" />

            <!-- Category selector -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Category"
                android:textColor="#3F51B5"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/spinner_note_category"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <!-- Note Content input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Content"
                android:textColor="#3F51B5"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/et_note_content"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@android:drawable/edit_text"
                android:hint="Type something amazing here..."
                android:gravity="top|left"
                android:padding="12dp"
                android:inputType="textMultiLine"
                android:scrollbars="vertical"
                android:textSize="16sp" />

            <!-- Controls bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:gravity="right">

                <Button
                    android:id="@+id/btn_cancel_note"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cancel"
                    android:textColor="#555555"
                    android:background="@android:drawable/btn_default"
                    android:layout_marginRight="12dp" />

                <Button
                    android:id="@+id/btn_save_note"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Save Note"
                    android:textColor="#FFFFFF"
                    android:background="#3F51B5" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>