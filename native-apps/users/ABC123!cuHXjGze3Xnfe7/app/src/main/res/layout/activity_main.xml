<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F9FC">

    <!-- Top Toolbar / Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#3F51B5"
        android:padding="12dp">

        <TextView
            android:id="@+id/toolbar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alphabet Explorer"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_centerVertical="true"/>

        <TextView
            android:id="@+id/toolbar_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Score: 0"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:visibility="gone"/>
    </RelativeLayout>

    <!-- Content Area Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- MODE 1: Learn Grid View -->
        <LinearLayout
            android:id="@+id/container_learn"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="visible">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select a letter to explore!"
                android:textColor="#333333"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:textStyle="italic"/>

            <GridView
                android:id="@+id/alphabet_grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:numColumns="3"
                android:verticalSpacing="8dp"
                android:horizontalSpacing="8dp"
                android:stretchMode="columnWidth"
                android:gravity="center"/>
        </LinearLayout>

        <!-- MODE 2: Quiz Game View -->
        <RelativeLayout
            android:id="@+id/container_quiz"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/quiz_prompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Which letter makes the sound...?"
                android:textColor="#333333"
                android:textSize="22sp"
                android:gravity="center"
                android:layout_marginTop="20dp"/>

            <TextView
                android:id="@+id/quiz_target_letter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="?"
                android:textColor="#E91E63"
                android:textSize="80sp"
                android:textStyle="bold"
                android:layout_centerHorizontal="true"
                android:layout_below="@id/quiz_prompt"
                android:layout_marginTop="20dp"/>

            <Button
                android:id="@+id/btn_quiz_listen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔊 Listen Sound"
                android:layout_below="@id/quiz_target_letter"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="10dp"
                android:background="#FF9800"
                android:textColor="#FFFFFF"
                android:padding="10dp"/>

            <!-- Grid of options -->
            <GridLayout
                android:id="@+id/quiz_options_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="40dp"
                android:columnCount="2"
                android:rowCount="2"
                android:alignmentMode="alignBounds">

                <Button
                    android:id="@+id/btn_option_1"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="8dp"
                    android:text="A"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>

                <Button
                    android:id="@+id/btn_option_2"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="8dp"
                    android:text="B"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>

                <Button
                    android:id="@+id/btn_option_3"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="8dp"
                    android:text="C"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>

                <Button
                    android:id="@+id/btn_option_4"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="8dp"
                    android:text="D"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>
            </GridLayout>
        </RelativeLayout>

        <!-- MODE 3: Tracing View -->
        <RelativeLayout
            android:id="@+id/container_trace"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/trace_instruction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Trace the letter below"
                android:textColor="#333333"
                android:textSize="18sp"
                android:gravity="center"
                android:layout_marginTop="10dp"/>

            <FrameLayout
                android:id="@+id/trace_canvas_holder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_above="@+id/trace_controls"
                android:layout_below="@id/trace_instruction"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:background="#FFFFFF"/>

            <LinearLayout
                android:id="@+id/trace_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="8dp">

                <Button
                    android:id="@+id/btn_trace_prev"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="◀ Prev"
                    android:layout_weight="1"
                    android:layout_marginRight="4dp"
                    android:background="#3F51B5"
                    android:textColor="#FFFFFF"/>

                <Button
                    android:id="@+id/btn_trace_clear"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="🧹 Clear"
                    android:layout_weight="1"
                    android:layout_marginRight="4dp"
                    android:layout_marginLeft="4dp"
                    android:background="#E91E63"
                    android:textColor="#FFFFFF"/>

                <Button
                    android:id="@+id/btn_trace_next"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Next ▶"
                    android:layout_weight="1"
                    android:layout_marginLeft="4dp"
                    android:background="#3F51B5"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>
        </RelativeLayout>

        <!-- Overlay Detail Layout -->
        <RelativeLayout
            android:id="@+id/detail_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F5F5F5"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            android:padding="16dp">

            <!-- Back/Close Button -->
            <Button
                android:id="@+id/btn_close_detail"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="✕"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:background="#9E9E9E"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true"/>

            <!-- Upper and lowercase representation -->
            <TextView
                android:id="@+id/detail_letter_pair"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aa"
                android:textColor="#2196F3"
                android:textSize="120sp"
                android:textStyle="bold"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="50dp"/>

            <!-- Phrase e.g. "A is for Apple" -->
            <TextView
                android:id="@+id/detail_word_phrase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="A is for Apple"
                android:textColor="#333333"
                android:textSize="28sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_below="@id/detail_letter_pair"
                android:layout_marginTop="20dp"/>

            <!-- Speaker/Voice Button -->
            <Button
                android:id="@+id/btn_speak_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔊 Listen Phonics"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:background="#4CAF50"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:layout_below="@id/detail_word_phrase"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="30dp"/>

            <!-- Navigation Controls -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="20dp">

                <Button
                    android:id="@+id/btn_detail_prev"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="◀ Previous"
                    android:background="#3F51B5"
                    android:textColor="#FFFFFF"
                    android:layout_alignParentLeft="true"/>

                <Button
                    android:id="@+id/btn_detail_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Next ▶"
                    android:background="#3F51B5"
                    android:textColor="#FFFFFF"
                    android:layout_alignParentRight="true"/>
            </RelativeLayout>
        </RelativeLayout>
    </FrameLayout>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="#E0E0E0"
        android:weightSum="3">

        <Button
            android:id="@+id/nav_btn_learn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="📖 Learn"
            android:textSize="14sp"
            android:background="#C5CAE9"
            android:textColor="#3F51B5"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/nav_btn_quiz"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="❓ Quiz"
            android:textSize="14sp"
            android:background="#E0E0E0"
            android:textColor="#757575"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/nav_btn_trace"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="✍️ Trace"
            android:textSize="14sp"
            android:background="#E0E0E0"
            android:textColor="#757575"
            android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>