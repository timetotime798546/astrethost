<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Top spacing -->
        <View
            android:layout_width="match_parent"
            android:layout_height="40dp" />

        <!-- App Icon Placeholder -->
        <TextView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="#E1F5FE"
            android:gravity="center"
            android:text="✨"
            android:textSize="40sp" />

        <!-- Greeting Header -->
        <TextView
            android:id="@+id/greetingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Hello there!"
            android:textColor="#37474F"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Main requested question text -->
        <TextView
            android:id="@+id/mainQuestion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="How are you?"
            android:textColor="#1A237E"
            android:textSize="32sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Tap a button below to share your feeling"
            android:textColor="#78909C"
            android:textSize="14sp"
            android:gravity="center" />

        <!-- Option selection list -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="32dp">

            <Button
                android:id="@+id/btnAmazing"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:background="#4CAF50"
                android:text="🚀 Amazing"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnGood"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:background="#2196F3"
                android:text="😊 Good / OK"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnTired"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:background="#FF9800"
                android:text="🥱 Tired"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSad"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:background="#E53935"
                android:text="😔 Down / Sad"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Interactive Quote/Response Card -->
        <LinearLayout
            android:id="@+id/responseCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone"
            android:gravity="center">

            <TextView
                android:id="@+id/responseTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#1B5E20"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/responseQuote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#546E7A"
                android:textSize="15sp"
                android:gravity="center" />

        </LinearLayout>

        <!-- Dynamic Reset Switch -->
        <Button
            android:id="@+id/btnReset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#E0E0E0"
            android:text="Change my status"
            android:textColor="#424242"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>