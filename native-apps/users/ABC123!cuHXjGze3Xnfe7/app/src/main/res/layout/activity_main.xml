<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/screen_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Header Greeting -->
        <TextView
            android:id="@+id/textHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome!"
            android:textColor="#37474F"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:letterSpacing="0.1" />

        <!-- App Display Content Title Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="28dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:elevation="4dp"
            android:gravity="center">

            <TextView
                android:id="@+id/textMainMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="hi how to do"
                android:textColor="#004D40"
                android:textSize="32sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="12dp" />

            <View
                android:layout_width="60dp"
                android:layout_height="3dp"
                android:background="#00796B"
                android:layout_marginBottom="24dp" />

            <!-- Subtitle Interactive Prompt -->
            <TextView
                android:id="@+id/textSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Here is a simple, useful tip for today:"
                android:textColor="#78909C"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <!-- Dynamic Tip Block -->
            <TextView
                android:id="@+id/textTipContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="How to stay productive: Focus on one small, clear task for just 25 minutes without looking at your phone."
                android:textColor="#37474F"
                android:textSize="16sp"
                android:textStyle="italic"
                android:gravity="center"
                android:lineSpacingMultiplier="1.2"
                android:padding="8dp" />

        </LinearLayout>

        <!-- Button to cycle through quick how-to guides -->
        <Button
            android:id="@+id/buttonNextTip"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Show Another How-To Idea"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/button_background"
            android:layout_marginBottom="32dp"
            android:textAllCaps="false" />

        <!-- Extra Quick Help section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="20dp"
            android:gravity="left">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quick Guide List"
                android:textColor="#263238"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Row Item 1 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✔ How to build simple apps: Start with standard views, use Java arrays for content, and design simple user paths."
                android:textColor="#455A64"
                android:textSize="13sp"
                android:layout_marginBottom="8dp" />

            <!-- Row Item 2 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✔ How to stay relaxed: Inhale deeply for four seconds, hold for four seconds, then exhale slowly."
                android:textColor="#455A64"
                android:textSize="13sp"
                android:layout_marginBottom="8dp" />

            <!-- Row Item 3 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✔ How to learn fast: Explain what you just learned to someone else or write it down in your own words."
                android:textColor="#455A64"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Simple &amp; Lightweight Guide App"
            android:textColor="#90A4AE"
            android:textSize="12sp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>