{
  "backend": true,
  "api_base_url": "https://trumpledroid-api.cloudbeta28624.workers.dev",
  "roles": {
    "user": ["own"]
  },
  "collections": {
    "products": {
      "fields": {
        "name": "string",
        "buy_price": "number",
        "sell_price": "number",
        "stock": "integer",
        "unit": "string"
      },
      "operations": ["create", "read", "update", "delete"]
    },
    "customers": {
      "fields": {
        "name": "string",
        "phone": "string",
        "address": "string"
      },
      "operations": ["create", "read", "update", "delete"]
    },
    "transactions": {
      "fields": {
        "customer_id": "string",
        "customer_name": "string",
        "type": "string",
        "amount": "number",
        "note": "string",
        "date": "string"
      },
      "operations": ["create", "read", "update", "delete"]
    },
    "sales": {
      "fields": {
        "invoice_no": "string",
        "customer_name": "string",
        "subtotal": "number",
        "discount": "number",
        "tax": "number",
        "total": "number",
        "payment_mode": "string",
        "items_summary": "string",
        "date": "string"
      },
      "operations": ["create", "read", "update", "delete"]
    }
  },
  "logic": {
    "profit": {
      "type": "calculation",
      "inputs": ["sell_price", "buy_price", "quantity"],
      "formula": "(sell_price - buy_price) * quantity"
    },
    "invoice_total": {
      "type": "calculation",
      "inputs": ["subtotal", "discount", "tax"],
      "formula": "subtotal - discount + tax"
    },
    "customer_balance": {
      "type": "calculation",
      "inputs": ["total_given", "total_received"],
      "formula": "total_given - total_received"
    }
  }
}