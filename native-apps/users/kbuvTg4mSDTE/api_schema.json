{
  "backend": true,
  "api_base_url": "https://trumpledroid-api.cloudbeta28624.workers.dev",
  "roles": {
    "user": ["own"]
  },
  "collections": {
    "products": {
      "fields": {
        "name": "string",
        "category": "string",
        "sku": "string",
        "purchase_price": "number",
        "selling_price": "number",
        "quantity": "integer",
        "low_stock_threshold": "integer"
      },
      "operations": ["create", "read", "update", "delete"]
    },
    "sales": {
      "fields": {
        "sale_date": "string",
        "items_summary": "string",
        "total_revenue": "number"
      },
      "operations": ["create", "read"]
    }
  },
  "logic": {
    "profit_margin": {
      "type": "calculation",
      "inputs": ["purchase_price", "selling_price"],
      "formula": "((selling_price - purchase_price) / selling_price) * 100"
    },
    "inventory_valuation": {
      "type": "calculation",
      "inputs": ["purchase_price", "quantity"],
      "formula": "sum(purchase_price * quantity)"
    }
  }
}