{
  "backend": true,
  "api_base_url": "https://trumpledroid-api.cloudbeta28624.workers.dev",
  "roles": {
    "user": ["own"]
  },
  "collections": {
    "students": {
      "fields": {
        "name": "string",
        "roll_no": "string",
        "grade": "string",
        "attendance_present": "integer",
        "attendance_total": "integer",
        "marks_obtained": "integer",
        "marks_total": "integer"
      },
      "operations": ["create", "read", "update", "delete"]
    }
  },
  "logic": {
    "attendance_percentage": {
      "type": "calculation",
      "inputs": ["attendance_present", "attendance_total"],
      "formula": "(attendance_present / attendance_total) * 100"
    },
    "marks_percentage": {
      "type": "calculation",
      "inputs": ["marks_obtained", "marks_total"],
      "formula": "(marks_obtained / marks_total) * 100"
    }
  }
}