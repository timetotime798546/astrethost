{
  "backend": true,
  "api_base_url": "https://trumpledroid-api.cloudbeta28624.workers.dev",
  "roles": {
    "user": ["own"]
  },
  "collections": {
    "patients": {
      "fields": {
        "name": "string",
        "age": "integer",
        "gender": "string",
        "admission_date": "string",
        "illness": "string",
        "room_number": "string",
        "status": "string"
      },
      "operations": ["create", "read", "update", "delete"]
    }
  },
  "logic": {
    "patient_statistics": {
      "type": "calculation",
      "inputs": ["patients"],
      "formula": "average_age(patients) & status_distribution(patients)"
    }
  }
}