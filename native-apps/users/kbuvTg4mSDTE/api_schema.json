{
  "backend": true,
  "api_base_url": "https://trumpledroid-api.cloudbeta28624.workers.dev",
  "roles": {
    "user": ["own"]
  },
  "collections": {
    "orders": {
      "fields": {
        "product_name": "string",
        "price": "number",
        "quantity": "integer",
        "shoe_size": "string",
        "shoe_color": "string",
        "subtotal": "number",
        "tax": "number",
        "discount": "number",
        "total": "number",
        "order_date": "string"
      },
      "operations": ["create", "read"]
    },
    "favorites": {
      "fields": {
        "product_id": "string",
        "product_name": "string",
        "price": "number",
        "image_url": "string"
      },
      "operations": ["create", "read", "delete"]
    }
  },
  "logic": {
    "order_pricing": {
      "type": "calculation",
      "inputs": ["price", "quantity"],
      "formula": "subtotal = price * quantity; tax = subtotal * 0.08; discount = subtotal > 150 ? subtotal * 0.10 : 0; total = subtotal + tax + 15.0 - discount"
    }
  }
}