{
  "backend": true,
  "api_base_url": "https://trumpledroid-api.cloudbeta28624.workers.dev",
  "roles": {
    "user": ["own"]
  },
  "collections": {
    "notes": {
      "fields": {
        "title": "string",
        "content": "string",
        "category": "string",
        "color": "string",
        "is_pinned": "boolean"
      },
      "operations": ["create", "read", "update", "delete"]
    }
  },
  "logic": {
    "note_word_count": {
      "type": "calculation",
      "inputs": ["content"],
      "formula": "words(content)"
    },
    "note_char_count": {
      "type": "calculation",
      "inputs": ["content"],
      "formula": "length(content)"
    },
    "total_words_count": {
      "type": "calculation",
      "inputs": ["notes_list"],
      "formula": "sum(words_of_all_notes)"
    }
  }
}