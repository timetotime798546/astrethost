{
  "backend": true,
  "api_base_url": "https://trumpledroid-api.cloudbeta28624.workers.dev",
  "roles": {
    "user": ["own"]
  },
  "collections": {
    "clients": {
      "fields": {
        "name": "string",
        "email": "string",
        "phone": "string",
        "address": "string"
      },
      "operations": ["create", "read", "update", "delete"]
    },
    "inventory": {
      "fields": {
        "item_name": "string",
        "sku": "string",
        "quantity": "number",
        "unit_price": "number",
        "cost_price": "number"
      },
      "operations": ["create", "read", "update", "delete"]
    },
    "invoices": {
      "fields": {
        "client_name": "string",
        "items_summary": "string",
        "subtotal": "number",
        "discount_percent": "number",
        "tax_percent": "number",
        "total": "number",
        "profit": "number"
      },
      "operations": ["create", "read", "update", "delete"]
    }
  },
  "logic": {
    "invoice_total": {
      "type": "calculation",
      "inputs": ["subtotal", "discount_percent", "tax_percent"],
      "formula": "(subtotal * (1 - discount_percent/100)) * (1 + tax_percent/100)"
    },
    "invoice_profit": {
      "type": "calculation",
      "inputs": ["total", "estimated_cost"],
      "formula": "total - estimated_cost"
    }
  }
}