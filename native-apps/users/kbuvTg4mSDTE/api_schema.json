{
  "backend": true,
  "api_base_url": "https://trumpledroid-api.cloudbeta28624.workers.dev",
  "roles": {
    "user": ["own"]
  },
  "collections": {
    "members": {
      "fields": {
        "name": "string",
        "phone": "string",
        "email": "string",
        "joining_date": "string",
        "plan": "string",
        "fee": "number",
        "balance": "number",
        "status": "string",
        "expiry_date": "string",
        "notes": "string"
      },
      "operations": ["create", "read", "update", "delete"]
    },
    "attendance": {
      "fields": {
        "member_id": "string",
        "member_name": "string",
        "date": "string",
        "status": "string"
      },
      "operations": ["create", "read", "update", "delete"]
    },
    "payments": {
      "fields": {
        "member_id": "string",
        "member_name": "string",
        "amount": "number",
        "payment_date": "string",
        "payment_type": "string",
        "notes": "string"
      },
      "operations": ["create", "read", "update", "delete"]
    },
    "expenses": {
      "fields": {
        "category": "string",
        "amount": "number",
        "date": "string",
        "description": "string"
      },
      "operations": ["create", "read", "update", "delete"]
    },
    "trainers": {
      "fields": {
        "name": "string",
        "phone": "string",
        "specialty": "string",
        "salary": "number"
      },
      "operations": ["create", "read", "update", "delete"]
    }
  },
  "logic": {
    "net_profit": {
      "type": "calculation",
      "inputs": ["monthly_revenue", "monthly_expenses"],
      "formula": "monthly_revenue - monthly_expenses"
    }
  }
}