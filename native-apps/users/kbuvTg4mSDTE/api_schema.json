{
  "backend": true,
  "api_base_url": "https://trumpledroid-api.cloudbeta28624.workers.dev",
  "roles": {
    "user": ["own"]
  },
  "collections": {
    "customers": {
      "fields": {
        "name": "string",
        "phone": "string"
      },
      "operations": ["create", "read", "update", "delete"]
    },
    "khata_entries": {
      "fields": {
        "customer_phone": "string",
        "amount": "number",
        "type": "string",
        "date": "string",
        "notes": "string"
      },
      "operations": ["create", "read", "update", "delete"]
    }
  },
  "logic": {
    "customer_balance": {
      "type": "calculation",
      "inputs": ["total_jama", "total_udhaar"],
      "formula": "total_jama - total_udhaar"
    }
  }
}