{
  "backend": true,
  "api_base_url": "https://trumpledroid-api.cloudbeta28624.workers.dev",
  "roles": {
    "user": ["own"]
  },
  "collections": {
    "inventory": {
      "fields": {
        "item_name": "string",
        "sku": "string",
        "warehouse": "string",
        "stock": "number",
        "reorder_level": "number",
        "wholesale_price": "number",
        "retail_price": "number"
      },
      "operations": ["create", "read", "update", "delete"]
    },
    "transactions": {
      "fields": {
        "customer_name": "string",
        "items": "string",
        "subtotal": "number",
        "discount": "number",
        "tax": "number",
        "total": "number",
        "payment_status": "string"
      },
      "operations": ["create", "read", "update", "delete"]
    },
    "expenses": {
      "fields": {
        "title": "string",
        "category": "string",
        "amount": "number",
        "date": "string",
        "status": "string"
      },
      "operations": ["create", "read", "update", "delete"]
    }
  },
  "logic": {
    "invoice_total_calc": {
      "type": "calculation",
      "inputs": ["subtotal", "discount", "tax_rate"],
      "formula": "(subtotal - discount) * (1 + tax_rate)"
    },
    "net_cash_flow": {
      "type": "calculation",
      "inputs": ["total_revenue", "total_expenses"],
      "formula": "total_revenue - total_expenses"
    }
  }
}