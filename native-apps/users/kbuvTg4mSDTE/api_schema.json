{
  "backend": true,
  "api_base_url": "https://trumpledroid-api.cloudbeta28624.workers.dev",
  "roles": {
    "user": ["own"]
  },
  "collections": {
    "cctv_customers": {
      "fields": {
        "customer_name": "string",
        "phone": "string",
        "address": "string",
        "installation_date": "string",
        "camera_count": "integer",
        "total_amount": "number",
        "amount_received": "number",
        "balance": "number",
        "camera_details": "string"
      },
      "operations": ["create", "read", "update", "delete"]
    }
  },
  "logic": {
    "balance": {
      "type": "calculation",
      "inputs": ["total_amount", "amount_received"],
      "formula": "total_amount - amount_received"
    }
  }
}