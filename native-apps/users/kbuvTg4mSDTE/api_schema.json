{
  "backend": false,
  "roles": {},
  "collections": {},
  "logic": {
    "subtotal_calculation": {
      "type": "calculation",
      "inputs": ["item_prices", "quantities"],
      "formula": "sum(price * quantity)"
    },
    "gst_calculation": {
      "type": "calculation",
      "inputs": ["subtotal"],
      "formula": "subtotal * 0.05"
    },
    "grand_total_calculation": {
      "type": "calculation",
      "inputs": ["subtotal", "gst", "discount"],
      "formula": "subtotal + gst - discount"
    }
  }
}