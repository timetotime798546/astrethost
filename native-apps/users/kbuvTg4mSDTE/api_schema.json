{
  "backend": true,
  "api_base_url": "https://trumpledroid-api.cloudbeta28624.workers.dev",
  "roles": {
    "user": ["own"]
  },
  "collections": {
    "notes": {
      "fields": {
        "title": "string",
        "content": "string",
        "color": "string",
        "updated_at": "string"
      },
      "operations": ["create", "read", "update", "delete"]
    }
  },
  "logic": {
    "total_words": {
      "type": "calculation",
      "inputs": ["content"],
      "formula": "sum(words(content))"
    }
  }
}