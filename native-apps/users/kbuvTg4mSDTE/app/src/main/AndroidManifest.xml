<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@drawable/icon"
        android:roundIcon="@drawable/icon"
        android:label="DailyBiz Manager"
        android:theme="@android:style/Theme.Material.Light">

        <activity 
            android:name="com.dailybizmanager.app.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name="com.dailybizmanager.app.ProductsActivity" android:exported="false" />
        <activity android:name="com.dailybizmanager.app.AddProductActivity" android:exported="false" />
        <activity android:name="com.dailybizmanager.app.CustomersActivity" android:exported="false" />
        <activity android:name="com.dailybizmanager.app.AddCustomerActivity" android:exported="false" />
        <activity android:name="com.dailybizmanager.app.SalesActivity" android:exported="false" />
        <activity android:name="com.dailybizmanager.app.PurchasesActivity" android:exported="false" />
        <activity android:name="com.dailybizmanager.app.ExpensesActivity" android:exported="false" />
        <activity android:name="com.dailybizmanager.app.ReportsActivity" android:exported="false" />
        <activity android:name="com.dailybizmanager.app.SettingsActivity" android:exported="false" />
        <activity android:name="com.dailybizmanager.app.InvoiceActivity" android:exported="false" />
        <activity android:name="com.dailybizmanager.app.LowStockActivity" android:exported="false" />

    </application>
</manifest>