<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.gympro.app">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/icon"
        android:roundIcon="@drawable/icon"
        android:label="GYM PRO"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material">

        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".RegisterActivity" android:exported="false" />
        <activity android:name=".ForgotPasswordActivity" android:exported="false" />
        <activity android:name=".MainActivity" android:exported="false" />
        <activity android:name=".MembersActivity" android:exported="false" />
        <activity android:name=".AttendanceActivity" android:exported="false" />
        <activity android:name=".PaymentsActivity" android:exported="false" />
        <activity android:name=".ExpensesActivity" android:exported="false" />
        <activity android:name=".TrainersActivity" android:exported="false" />

    </application>

</manifest>