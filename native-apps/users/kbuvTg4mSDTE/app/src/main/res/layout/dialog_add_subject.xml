<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Create Subject"
        android:textColor="#1976D2"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Subject Name"
        android:textColor="#616161"
        android:textSize="12sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/et_subject_name"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:hint="e.g. Physics, Literature"
        android:background="@drawable/input_field_bg"
        android:padding="10dp"
        android:singleLine="true"
        android:textSize="14sp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Highlight Color"
        android:textColor="#616161"
        android:textSize="12sp"
        android:layout_marginBottom="8dp" />

    <!-- Simple grid color options selection -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="20dp">

        <View
            android:id="@+id/color_opt1"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="#E53935"
            android:layout_margin="4dp" />

        <View
            android:id="@+id/color_opt2"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="#1E88E5"
            android:layout_margin="4dp" />

        <View
            android:id="@+id/color_opt3"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="#43A047"
            android:layout_margin="4dp" />

        <View
            android:id="@+id/color_opt4"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="#8E24AA"
            android:layout_margin="4dp" />

        <View
            android:id="@+id/color_opt5"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="#FDD835"
            android:layout_margin="4dp" />

        <View
            android:id="@+id/color_opt6"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="#FB8C00"
            android:layout_margin="4dp" />
    </LinearLayout>

</LinearLayout>