<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F11">

    <LinearLayout
        android:id="@+id/header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#16161C"
        android:padding="20dp"
        android:gravity="center_vertical"
        android:layout_alignParentTop="true">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OmniFlow Business ERP"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.02" />

            <TextView
                android:id="@+id/tvUserSession"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Console Session: loading..."
                android:textColor="#00E5FF"
                android:textSize="12sp"
                android:fontFamily="sans-serif"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSignOut"
            android:layout_width="72dp"
            android:layout_height="36dp"
            android:text="EXIT"
            android:background="@drawable/bg_secondary_button"
            android:backgroundTint="#FF5252"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottom_nav_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_bottom_nav"
        android:gravity="center_vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:layout_alignParentBottom="true">

        <LinearLayout
            android:id="@+id/navDashboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">
            
            <TextView
                android:id="@+id/txtNavDashboard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dashboard"
                android:textColor="#00E5FF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />
            <View
                android:id="@+id/indicatorDashboard"
                android:layout_width="16dp"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:background="#00E5FF" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navInventory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">
            
            <TextView
                android:id="@+id/txtNavInventory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inventory"
                android:textColor="#8F8F9F"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />
            <View
                android:id="@+id/indicatorInventory"
                android:layout_width="16dp"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:background="#00000000" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navPOS"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">
            
            <TextView
                android:id="@+id/txtNavPOS"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="POS Billing"
                android:textColor="#8F8F9F"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />
            <View
                android:id="@+id/indicatorPOS"
                android:layout_width="16dp"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:background="#00000000" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navExpenses"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">
            
            <TextView
                android:id="@+id/txtNavExpenses"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Expenses"
                android:textColor="#8F8F9F"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />
            <View
                android:id="@+id/indicatorExpenses"
                android:layout_width="16dp"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:background="#00000000" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header_container"
        android:layout_above="@id/bottom_nav_bar">

        <ScrollView
            android:id="@+id/panelDashboard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Financial Position (Calculated)"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card_elevated"
                        android:padding="16dp"
                        android:layout_marginRight="6dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="TOTAL REVENUE"
                                android:textColor="#8F8F9F"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_arrow_up" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvTotalRevenue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$0.00"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="16dp"
                            android:orientation="horizontal"
                            android:gravity="bottom"
                            android:layout_marginTop="8dp">
                            <View android:layout_width="4dp" android:layout_height="6dp" android:background="#4CAF50" android:layout_marginRight="2dp" />
                            <View android:layout_width="4dp" android:layout_height="9dp" android:background="#4CAF50" android:layout_marginRight="2dp" />
                            <View android:layout_width="4dp" android:layout_height="7dp" android:background="#4CAF50" android:layout_marginRight="2dp" />
                            <View android:layout_width="4dp" android:layout_height="12dp" android:background="#4CAF50" android:layout_marginRight="2dp" />
                            <View android:layout_width="4dp" android:layout_height="15dp" android:background="#4CAF50" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card_elevated"
                        android:padding="16dp"
                        android:layout_marginLeft="6dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="TOTAL EXPENSES"
                                android:textColor="#8F8F9F"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_arrow_down" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvTotalExpenses"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$0.00"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="16dp"
                            android:orientation="horizontal"
                            android:gravity="bottom"
                            android:layout_marginTop="8dp">
                            <View android:layout_width="4dp" android:layout_height="12dp" android:background="#FF5252" android:layout_marginRight="2dp" />
                            <View android:layout_width="4dp" android:layout_height="10dp" android:background="#FF5252" android:layout_marginRight="2dp" />
                            <View android:layout_width="4dp" android:layout_height="13dp" android:background="#FF5252" android:layout_marginRight="2dp" />
                            <View android:layout_width="4dp" android:layout_height="8dp" android:background="#FF5252" android:layout_marginRight="2dp" />
                            <View android:layout_width="4dp" android:layout_height="11dp" android:background="#FF5252" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_elevated"
                    android:padding="18dp"
                    android:layout_marginBottom="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NET OPERATING CASH FLOW"
                        android:textColor="#8F8F9F"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvNetOperatingFlow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$0.00"
                        android:textColor="#4CAF50"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enterprise Supply &amp; Sync Panel"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_alert_card"
                    android:padding="16dp"
                    android:layout_marginBottom="24dp">

                    <TextView
                        android:id="@+id/tvWarehouseAlerts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#FFCDD2"
                        android:text="All warehouse levels stable."
                        android:textSize="13sp"
                        android:layout_marginBottom="16dp"
                        android:fontFamily="sans-serif" />

                    <Button
                        android:id="@+id/btnRefreshDashboard"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="SYNC ALL CLOUD DATA"
                        android:textColor="#121212"
                        android:background="@drawable/bg_primary_button"
                        android:backgroundTint="#00E5FF"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:elevation="2dp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/panelInventory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Warehouse Stock Manager"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_elevated"
                    android:padding="16dp"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="REGISTER NEW STOCK ITEM"
                        android:textColor="#00ADB5"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <EditText
                        android:id="@+id/etInvName"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="Item Name"
                        android:textColorHint="#5A5A66"
                        android:background="@drawable/bg_outline_input"
                        android:textColor="#FFFFFF"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:textSize="14sp"
                        android:layout_marginBottom="10dp" />

                    <EditText
                        android:id="@+id/etInvSku"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="SKU / Barcode Index"
                        android:textColorHint="#5A5A66"
                        android:background="@drawable/bg_outline_input"
                        android:textColor="#FFFFFF"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:textSize="14sp"
                        android:layout_marginBottom="10dp" />

                    <EditText
                        android:id="@+id/etInvWarehouse"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="Warehouse Location (e.g. North-A)"
                        android:textColorHint="#5A5A66"
                        android:background="@drawable/bg_outline_input"
                        android:textColor="#FFFFFF"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:textSize="14sp"
                        android:layout_marginBottom="10dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="10dp">

                        <EditText
                            android:id="@+id/etInvStock"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="48dp"
                            android:hint="Stock Units"
                            android:textColorHint="#5A5A66"
                            android:background="@drawable/bg_outline_input"
                            android:textColor="#FFFFFF"
                            android:paddingLeft="12dp"
                            android:paddingRight="12dp"
                            android:inputType="number"
                            android:textSize="14sp"
                            android:layout_marginRight="6dp" />

                        <EditText
                            android:id="@+id/etInvReorder"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="48dp"
                            android:hint="Reorder Level"
                            android:textColorHint="#5A5A66"
                            android:background="@drawable/bg_outline_input"
                            android:textColor="#FFFFFF"
                            android:paddingLeft="12dp"
                            android:paddingRight="12dp"
                            android:inputType="number"
                            android:textSize="14sp"
                            android:layout_marginLeft="6dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <EditText
                            android:id="@+id/etInvWholesale"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="48dp"
                            android:hint="Wholesale ($)"
                            android:textColorHint="#5A5A66"
                            android:background="@drawable/bg_outline_input"
                            android:textColor="#FFFFFF"
                            android:paddingLeft="12dp"
                            android:paddingRight="12dp"
                            android:inputType="numberDecimal"
                            android:textSize="14sp"
                            android:layout_marginRight="6dp" />

                        <EditText
                            android:id="@+id/etInvRetail"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="48dp"
                            android:hint="Retail ($)"
                            android:textColorHint="#5A5A66"
                            android:background="@drawable/bg_outline_input"
                            android:textColor="#FFFFFF"
                            android:paddingLeft="12dp"
                            android:paddingRight="12dp"
                            android:inputType="numberDecimal"
                            android:textSize="14sp"
                            android:layout_marginLeft="6dp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnSaveInventory"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="SAVE TO WAREHOUSE DATA"
                        android:background="@drawable/bg_primary_button"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stock Catalog Records"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:id="@+id/listInventoryContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/panelPOS"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Interactive POS Terminal"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_elevated"
                    android:padding="16dp"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CUSTOMER KHATA / DETAILS"
                        android:textColor="#00E5FF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <EditText
                        android:id="@+id/etPosCustomer"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="Customer Name"
                        android:textColorHint="#5A5A66"
                        android:background="@drawable/bg_outline_input"
                        android:textColor="#FFFFFF"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:textSize="14sp"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SELECT ITEM TO CART"
                        android:textColor="#00E5FF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <Spinner
                        android:id="@+id/spinnerPosItems"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_outline_input"
                        android:layout_marginBottom="10dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <EditText
                            android:id="@+id/etPosQty"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="48dp"
                            android:hint="Qty"
                            android:textColorHint="#5A5A66"
                            android:background="@drawable/bg_outline_input"
                            android:textColor="#FFFFFF"
                            android:paddingLeft="12dp"
                            android:paddingRight="12dp"
                            android:inputType="number"
                            android:textSize="14sp"
                            android:layout_marginRight="8dp" />

                        <Button
                            android:id="@+id/btnPosAddToCart"
                            android:layout_width="100dp"
                            android:layout_height="48dp"
                            android:text="ADD"
                            android:background="@drawable/bg_primary_button"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CURRENT INVOICE CART"
                        android:textColor="#00E5FF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/tvPosCartContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#16161C"
                        android:textColor="#FFFFFF"
                        android:padding="12dp"
                        android:text="Cart empty. Add items to calculate invoice values."
                        android:textSize="13sp"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="10dp">

                        <EditText
                            android:id="@+id/etPosDiscount"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="48dp"
                            android:hint="Discount ($)"
                            android:textColorHint="#5A5A66"
                            android:background="@drawable/bg_outline_input"
                            android:textColor="#FFFFFF"
                            android:paddingLeft="12dp"
                            android:paddingRight="12dp"
                            android:inputType="numberDecimal"
                            android:textSize="14sp"
                            android:layout_marginRight="6dp" />

                        <EditText
                            android:id="@+id/etPosTaxRate"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="48dp"
                            android:hint="Tax Rate (e.g. 0.15)"
                            android:textColorHint="#5A5A66"
                            android:background="@drawable/bg_outline_input"
                            android:textColor="#FFFFFF"
                            android:paddingLeft="12dp"
                            android:paddingRight="12dp"
                            android:inputType="numberDecimal"
                            android:textSize="14sp"
                            android:layout_marginLeft="6dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#16161C"
                        android:padding="16dp"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:id="@+id/tvPosSubtotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Subtotal: $0.00"
                            android:textColor="#8F8F9F"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvPosTaxCalculated"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Calculated Tax: $0.00"
                            android:textColor="#8F8F9F"
                            android:textSize="13sp"
                            android:layout_marginTop="4dp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#2E2E38"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/tvPosTotalAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Net Invoice Total: $0.00"
                            android:textColor="#00ADB5"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnSubmitInvoice"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="FINALIZE INVOICE &amp; RECORD"
                        android:background="@drawable/bg_primary_button"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recent Finalized Invoices"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:id="@+id/listTransactionsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/panelExpenses"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Operational Expense Tracker"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_elevated"
                    android:padding="16dp"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CREATE VOUCHER SUBMISSION"
                        android:textColor="#FF5252"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <EditText
                        android:id="@+id/etExpTitle"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="Expense Title / Description"
                        android:textColorHint="#5A5A66"
                        android:background="@drawable/bg_outline_input"
                        android:textColor="#FFFFFF"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:textSize="14sp"
                        android:layout_marginBottom="10dp" />

                    <EditText
                        android:id="@+id/etExpCategory"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="Category (e.g. Travel, Logistics)"
                        android:textColorHint="#5A5A66"
                        android:background="@drawable/bg_outline_input"
                        android:textColor="#FFFFFF"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:textSize="14sp"
                        android:layout_marginBottom="10dp" />

                    <EditText
                        android:id="@+id/etExpAmount"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="Voucher Amount ($)"
                        android:textColorHint="#5A5A66"
                        android:background="@drawable/bg_outline_input"
                        android:textColor="#FFFFFF"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:inputType="numberDecimal"
                        android:textSize="14sp"
                        android:layout_marginBottom="16dp" />

                    <Button
                        android:id="@+id/btnSaveExpense"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="SUBMIT EXPENSE VOUCHER"
                        android:background="@drawable/bg_primary_button"
                        android:backgroundTint="#FF5252"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Corporate Expense Ledger"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:id="@+id/listExpensesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</RelativeLayout>