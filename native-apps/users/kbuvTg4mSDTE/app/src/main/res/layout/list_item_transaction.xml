<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/glass_card"
    android:padding="12dp"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.3"
        android:orientation="vertical">

        <TextView
            android:id="@+id/item_trans_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2023-10-15 14:30"
            android:textColor="#A09BB0"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/item_trans_notes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Optional Notes Description"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="right">

        <TextView
            android:id="@+id/item_trans_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="\u20B90.00"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/item_trans_type_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pill"
            android:textSize="9dp"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

</LinearLayout>