<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_bg"
    android:padding="16dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp">

    <!-- Card Top Block -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/tv_item_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Note Title Placeholder"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_alignParentLeft="true"
            android:layout_toLeftOf="@+id/tv_item_word_badge"
            android:ellipsize="end"
            android:singleLine="true" />

        <TextView
            android:id="@+id/tv_item_word_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="15 words"
            android:textSize="11sp"
            android:textColor="#7F78D2"
            android:textStyle="bold"
            android:background="#EFEBFC"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_alignParentRight="true" />

    </RelativeLayout>

    <!-- Content Excerpt Preview -->
    <TextView
        android:id="@+id/tv_item_excerpt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Lorem ipsum dynamic content excerpt that is truncated eleganty to provide an informative summary."
        android:textSize="13sp"
        android:textColor="#666666"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginBottom="12dp" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EAEAEA"
        android:layout_marginBottom="8dp" />

    <!-- Metadata Bottom Block -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv_item_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Oct 12, 10:43 AM"
            android:textSize="11sp"
            android:textColor="#999999"
            android:layout_alignParentLeft="true" />

        <!-- Accent marker dynamically customized to show matching styling indicator -->
        <View
            android:id="@+id/view_item_accent_color"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="#FCF7E3"
            android:layout_alignParentRight="true" />

    </RelativeLayout>

</LinearLayout>