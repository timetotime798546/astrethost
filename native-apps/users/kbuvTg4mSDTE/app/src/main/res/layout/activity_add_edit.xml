<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/txtFormHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Product Inventory Editor"
            android:textColor="#00796B"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <!-- Barcode Scanner Stub -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#E0F2F1"
                android:padding="10dp"
                android:gravity="center"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📷 Barcode / QR Lookup Placeholder Active"
                    android:textColor="#004D40"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- SKU Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stock Keeping Unit (SKU)"
                android:textColor="#777777"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/edtFormSku"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g., GR-1092"
                android:background="@drawable/edittext_bg"
                android:textColor="#333333"
                android:layout_marginBottom="12dp" />

            <!-- Product Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Product Name"
                android:textColor="#777777"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/edtFormName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g., Whole Wheat Flour"
                android:background="@drawable/edittext_bg"
                android:textColor="#333333"
                android:layout_marginBottom="12dp" />

            <!-- Category -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Category Classification"
                android:textColor="#777777"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/spinFormCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/edittext_bg"
                android:layout_marginBottom="16dp" />

            <!-- Purchase & Sale Prices -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginRight="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Purchase Price ($)"
                        android:textColor="#777777"
                        android:textSize="12sp"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/edtFormPurchasePrice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="5.00"
                        android:inputType="numberDecimal"
                        android:background="@drawable/edittext_bg"
                        android:textColor="#333333" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginLeft="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Selling Price ($)"
                        android:textColor="#777777"
                        android:textSize="12sp"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/edtFormSellingPrice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="7.50"
                        android:inputType="numberDecimal"
                        android:background="@drawable/edittext_bg"
                        android:textColor="#333333" />
                </LinearLayout>
            </LinearLayout>

            <!-- Dynamic margin preview -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F0F9F6"
                android:padding="10dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/txtFormMarginResult"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Calculated Margin: 0.00% ($0.00 profit)"
                    android:textColor="#00796B"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Stock quantity & Low warning threshhold -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginRight="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Stock Quantity"
                        android:textColor="#777777"
                        android:textSize="12sp"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/edtFormQuantity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="100"
                        android:inputType="number"
                        android:background="@drawable/edittext_bg"
                        android:textColor="#333333" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginLeft="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Low Threshold"
                        android:textColor="#777777"
                        android:textSize="12sp"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/edtFormLowStock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="10"
                        android:inputType="number"
                        android:background="@drawable/edittext_bg"
                        android:textColor="#333333" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <!-- Save Button -->
        <Button
            android:id="@+id/btnFormSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💾 Save Product Settings"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_primary"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Delete Button -->
        <Button
            android:id="@+id/btnFormDelete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Delete This Product"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_primary"
            android:backgroundTint="#D32F2F"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>