<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OmniFlow ERP"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enterprise Management Panel"
            android:textColor="#03A9F4"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginBottom="32dp"/>

        <LinearLayout
            android:id="@+id/layoutNormal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Secure Console Login"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Corporate Email"
                android:textColor="#BBBBBB"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#212121"
                android:textColor="#FFFFFF"
                android:padding="12dp"
                android:inputType="textEmailAddress"
                android:textSize="14sp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Security Password"
                android:textColor="#BBBBBB"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#212121"
                android:textColor="#FFFFFF"
                android:padding="12dp"
                android:inputType="textPassword"
                android:textSize="14sp"
                android:layout_marginBottom="24dp"/>

            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="AUTHORIZE SIGN-IN"
                android:textColor="#FFFFFF"
                android:background="#03A9F4"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="REGISTER NEW ENTERPRISE ACCOUNT"
                android:textColor="#03A9F4"
                android:background="#1B5E20"
                android:textSize="12sp"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnForgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Forgot Credential Password?"
                android:textColor="#888888"
                style="?android:attr/borderlessButtonStyle"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutOtp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Verification OTP Request"
                android:textColor="#FFEB3B"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter Registered Email"
                android:textColor="#BBBBBB"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etOtpEmail"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#212121"
                android:textColor="#FFFFFF"
                android:padding="12dp"
                android:inputType="textEmailAddress"
                android:textSize="14sp"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnSendOtp"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="GENERATE OTP RESET CODE"
                android:textColor="#000000"
                android:background="#FFEB3B"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Verification Code (OTP)"
                android:textColor="#BBBBBB"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etOtpCode"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#212121"
                android:textColor="#FFFFFF"
                android:padding="12dp"
                android:inputType="number"
                android:textSize="14sp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New Target Password"
                android:textColor="#BBBBBB"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etOtpNewPassword"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#212121"
                android:textColor="#FFFFFF"
                android:padding="12dp"
                android:inputType="textPassword"
                android:textSize="14sp"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btnVerifyAndReset"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="APPLY NEW PASSWORD"
                android:textColor="#FFFFFF"
                android:background="#4CAF50"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnCancelOtp"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="BACK TO MAIN LOGIN"
                android:textColor="#FFFFFF"
                android:background="#B71C1C"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>