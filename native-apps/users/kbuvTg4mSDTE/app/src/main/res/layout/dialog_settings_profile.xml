<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_bg"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Edit Shop Profile"
        android:textColor="@color/primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Shop Name *"
        android:textColor="@color/text_dark"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/edit_shop_name"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:hint="e.g. Gupta General Store"
        android:inputType="text"
        android:padding="10dp"
        android:background="@drawable/search_bg"
        android:textColor="@color/text_dark"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Shopkeeper Name"
        android:textColor="@color/text_dark"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/edit_keeper_name"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:hint="e.g. Ramesh Gupta"
        android:inputType="textPersonName"
        android:padding="10dp"
        android:background="@drawable/search_bg"
        android:textColor="@color/text_dark"
        android:layout_marginBottom="20dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btn_profile_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            style="?android:attr/borderlessButtonStyle"
            android:textColor="@color/text_muted"
            android:layout_marginRight="10dp" />

        <Button
            android:id="@+id/btn_profile_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Update"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_primary"
            android:paddingHorizontal="20dp" />
    </LinearLayout>
</LinearLayout>