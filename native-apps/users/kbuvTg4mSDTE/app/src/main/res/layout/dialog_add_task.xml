<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create Planner Task"
            android:textColor="#1976D2"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Subject Assignment"
            android:textColor="#616161"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinner_task_subject"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Task Title"
            android:textColor="#616161"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/et_task_title"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="e.g. Read Chapter 5, Complete Project"
            android:background="@drawable/input_field_bg"
            android:padding="10dp"
            android:singleLine="true"
            android:textSize="14sp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Due Date"
            android:textColor="#616161"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/et_task_due"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="Select Due Date"
            android:background="@drawable/input_field_bg"
            android:padding="10dp"
            android:clickable="true"
            android:focusable="false"
            android:textSize="14sp"
            android:layout_marginBottom="14dp" />

        <!-- Alarm Reminder Section Toggle -->
        <CheckBox
            android:id="@+id/cb_reminder_enabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Set Alert Reminder Notification"
            android:textColor="#212121"
            android:textSize="14sp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:id="@+id/layout_reminder_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alert Time"
                android:textColor="#616161"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/et_task_time"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="Select Reminder Time"
                android:background="@drawable/input_field_bg"
                android:padding="10dp"
                android:clickable="true"
                android:focusable="false"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>