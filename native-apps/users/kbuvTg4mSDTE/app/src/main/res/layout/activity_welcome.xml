<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#ECEFF1"
    android:padding="24dp">

    <!-- Title Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LUDO CLASSIC"
        android:textColor="#37474F"
        android:textSize="38sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Player Mode to Start Match"
        android:textColor="#78909C"
        android:textSize="15sp"
        android:layout_marginBottom="42dp" />

    <!-- Mode Buttons List -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:maxWidth="320dp">

        <Button
            android:id="@+id/btn_mode_2"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="16dp"
            android:text="2 Players Match"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#E53935"
            android:textColor="#FFFFFF"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btn_mode_3"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="16dp"
            android:text="3 Players Match"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#43A047"
            android:textColor="#FFFFFF"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btn_mode_4"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="4 Players Match"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#1E88E5"
            android:textColor="#FFFFFF"
            android:textAllCaps="false" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:text="Real Synthesized Audio Soundtracks Included"
        android:textColor="#90A4AE"
        android:textSize="11sp" />
</LinearLayout>