<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Top Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/primary"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="28dp"
        android:paddingBottom="16dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="Back"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:background="#334155" />

        <TextView
            android:id="@+id/tv_editor_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="14dp"
            android:text="@string/new_note"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_pin_toggle"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginRight="8dp"
            android:text="@string/pin"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:background="#334155" />

        <Button
            android:id="@+id/btn_save_note"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="@string/save"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@color/accent" />
    </LinearLayout>

    <!-- Calculation Stats Bar (Native Local Logic) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#F1F5F9"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <TextView
            android:id="@+id/tv_live_word_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 words"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_live_char_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 chars"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_live_read_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 min read"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Category Selector Buttons -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="#FFFFFF"
        android:padding="8dp">

        <LinearLayout
            android:id="@+id/category_selector_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/opt_cat_general"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="@string/category_general"
                android:textSize="11sp"
                android:background="@color/tag_general"
                android:textColor="@color/tag_text_general"
                android:layout_marginRight="6dp" />

            <Button
                android:id="@+id/opt_cat_work"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="@string/category_work"
                android:textSize="11sp"
                android:background="@color/tag_work"
                android:textColor="@color/tag_text_work"
                android:layout_marginRight="6dp" />

            <Button
                android:id="@+id/opt_cat_personal"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="@string/category_personal"
                android:textSize="11sp"
                android:background="@color/tag_personal"
                android:textColor="@color/tag_text_personal"
                android:layout_marginRight="6dp" />

            <Button
                android:id="@+id/opt_cat_ideas"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="@string/category_ideas"
                android:textSize="11sp"
                android:background="@color/tag_ideas"
                android:textColor="@color/tag_text_ideas"
                android:layout_marginRight="6dp" />

            <Button
                android:id="@+id/opt_cat_urgent"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="@string/category_urgent"
                android:textSize="11sp"
                android:background="@color/tag_urgent"
                android:textColor="@color/tag_text_urgent"
                android:layout_marginRight="6dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Input Section -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/et_note_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/title_hint"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:background="@null"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:singleLine="true" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border"
                android:layout_marginBottom="16dp" />

            <EditText
                android:id="@+id/et_note_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/content_hint"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:background="@null"
                android:gravity="top"
                android:minLines="12"
                android:inputType="textMultiLine|textCapSentences" />
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Delete Button (visible when editing existing note) -->
    <Button
        android:id="@+id/btn_delete_note"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_margin="16dp"
        android:text="@string/delete"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:background="#EF4444"
        android:visibility="gone" />

</LinearLayout>