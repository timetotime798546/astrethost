<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtFormTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add New Product"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#2C3E50"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/edtProdName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Product Name"
            android:layout_marginBottom="12dp"
            android:background="#FFFFFF"
            android:padding="12dp" />

        <EditText
            android:id="@+id/edtProdSku"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="SKU / Barcode"
            android:layout_marginBottom="12dp"
            android:background="#FFFFFF"
            android:padding="12dp" />

        <EditText
            android:id="@+id/edtProdCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Category (e.g. Groceries, Electronics)"
            android:layout_marginBottom="12dp"
            android:background="#FFFFFF"
            android:padding="12dp" />

        <EditText
            android:id="@+id/edtProdPurchasePrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Purchase Price"
            android:inputType="numberDecimal"
            android:layout_marginBottom="12dp"
            android:background="#FFFFFF"
            android:padding="12dp" />

        <EditText
            android:id="@+id/edtProdSellingPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Selling Price"
            android:inputType="numberDecimal"
            android:layout_marginBottom="12dp"
            android:background="#FFFFFF"
            android:padding="12dp" />

        <EditText
            android:id="@+id/edtProdStock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Initial Stock Quantity"
            android:inputType="number"
            android:layout_marginBottom="12dp"
            android:background="#FFFFFF"
            android:padding="12dp" />

        <EditText
            android:id="@+id/edtProdMinStock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Minimum Stock (Threshold Alert)"
            android:inputType="number"
            android:layout_marginBottom="12dp"
            android:background="#FFFFFF"
            android:padding="12dp" />

        <EditText
            android:id="@+id/edtProdUnit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Unit (e.g. pcs, kg, box)"
            android:layout_marginBottom="20dp"
            android:background="#FFFFFF"
            android:padding="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cancel"
                android:background="#95A5A6"
                android:textColor="#FFFFFF"
                android:layout_marginRight="8dp" />

            <Button
                android:id="@+id/btnSaveProduct"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Save Product"
                android:background="#2ECC71"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <Button
            android:id="@+id/btnDeleteProduct"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Delete Product"
            android:background="#E74C3C"
            android:textColor="#FFFFFF"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>