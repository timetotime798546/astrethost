<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/glass_background"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/detail_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="&lt; BACK"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/glass_card"
            android:paddingHorizontal="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="12dp">

            <TextView
                android:id="@+id/detail_tv_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Customer Name"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detail_tv_phone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Customer Phone"
                android:textColor="#A09BB0"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sharing_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_below="@id/detail_header"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btn_pdf"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="SHARE PDF BILL"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/glass_button"
            android:layout_marginRight="6dp" />

        <Button
            android:id="@+id/btn_csv"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="EXPORT CSV"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/glass_card"
            android:layout_marginLeft="6dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/detail_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/glass_card"
        android:padding="16dp"
        android:layout_below="@id/sharing_row"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NET STANDING BALANCE"
            android:textColor="#A09BB0"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detail_tv_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rs. 0.00"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Got (Jama)"
                    android:textColor="#A09BB0"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/detail_tv_total_got"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="\u20B90.00"
                    android:textColor="#00E676"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Gave (Udhaar)"
                    android:textColor="#A09BB0"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/detail_tv_total_gave"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="\u20B90.00"
                    android:textColor="#FF1744"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ListView
        android:id="@+id/detail_lv_transactions"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/detail_summary"
        android:layout_above="@id/transaction_buttons"
        android:divider="@android:color/transparent"
        android:dividerHeight="8dp"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:id="@+id/transaction_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_alignParentBottom="true">

        <Button
            android:id="@+id/btn_gave"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="GAVE (UDHAAR)"
            android:textColor="#FF1744"
            android:textStyle="bold"
            android:background="@drawable/glass_card_red"
            android:layout_marginRight="6dp" />

        <Button
            android:id="@+id/btn_got"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="GOT (JAMA)"
            android:textColor="#00E676"
            android:textStyle="bold"
            android:background="@drawable/glass_card_green"
            android:layout_marginLeft="6dp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/detail_progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone" />

</RelativeLayout>