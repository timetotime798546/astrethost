<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical">

    <!-- Circle Color Indication -->
    <View
        android:id="@+id/vIndicator"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:background="@color/income_green"
        android:layout_marginRight="12dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvItemCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Food"
            android:textSize="16sp"
            android:textColor="@color/text_dark"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvItemNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dinner description notes"
            android:textSize="12sp"
            android:textColor="@color/text_muted"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvItemDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2023-11-20"
            android:textSize="10sp"
            android:textColor="@color/text_muted" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvItemAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+$50.00"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/income_green"
            android:layout_marginRight="16dp" />

        <ImageView
            android:id="@+id/btnDeleteItem"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_delete" />
    </LinearLayout>
</LinearLayout>