<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Replenish Product Stock"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#2C3E50"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Product to Restock"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spnRestockProducts"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/edtSupplier"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Supplier / Wholesaler Name"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/edtPurchaseCost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Unit Purchase Price"
            android:inputType="numberDecimal"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/edtPurchaseQty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Restock Quantity"
            android:inputType="number"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnSavePurchase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SAVE REQUISITION &amp; ADD STOCK"
            android:background="#2ECC71"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="24dp" />

        <!-- Purchase History Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Restock History Logs"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#2C3E50"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/layoutPurchaseHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <!-- Dynamic listing -->
        </LinearLayout>

    </LinearLayout>
</ScrollView>