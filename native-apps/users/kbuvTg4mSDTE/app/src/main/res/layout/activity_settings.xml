<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SettingsActivity"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Qwen Server URL:"
            android:textStyle="bold"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/qwenServerUrlEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g., http://10.0.2.2:4444"
            android:inputType="textUri"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/testConnectionButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Test Connection"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/connectionTestResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textStyle="italic" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@android:color/darker_gray"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Voice Selection:"
            android:textStyle="bold"
            android:textSize="16sp" />

        <Spinner
            android:id="@+id/voiceSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Speech Rate:"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="16dp" />

        <SeekBar
            android:id="@+id/speechRateSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="200"
            android:progress="100"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/speechRateValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1.0x"
            android:layout_gravity="end" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Voice Pitch:"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="16dp" />

        <SeekBar
            android:id="@+id/voicePitchSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="200"
            android:progress="100"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/voicePitchValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1.0x"
            android:layout_gravity="end" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@android:color/darker_gray"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp" />

        <Switch
            android:id="@+id/autoListenSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Auto-listen after AI speaks"
            android:textStyle="bold"
            android:textSize="16sp"
            android:checked="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Maximum Response Tokens (Qwen):"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/maxTokensEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g., 200"
            android:inputType="numberSigned"
            android:minEms="3"
            android:maxLength="4"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/clearConversationButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clear Conversation History"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/saveSettingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Settings"
            android:layout_marginTop="24dp" />

    </LinearLayout>
</ScrollView>