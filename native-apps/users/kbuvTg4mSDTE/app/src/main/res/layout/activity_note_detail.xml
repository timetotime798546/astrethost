<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Action Bar Grid Header -->
    <RelativeLayout
        android:id="@+id/rl_editor_header"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:background="#FFFFFF">

        <Button
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:text="← Cancel"
            android:textColor="#777777"
            android:textStyle="bold"
            android:layout_centerVertical="true" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_delete"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:text="Delete"
                android:textColor="#FF5E5E"
                android:textStyle="bold"
                android:layout_marginRight="8dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_save"
                android:layout_width="80dp"
                android:layout_height="36dp"
                android:background="@drawable/btn_primary"
                android:text="Save"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Color Theme Options Strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical"
        android:background="#FFFFFF">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Paper Tone:"
            android:textSize="12sp"
            android:textColor="#777777"
            android:layout_marginRight="12dp" />

        <!-- Choice 1: Soft Classic White -->
        <View
            android:id="@+id/color_white"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="#FFFFFF"
            android:layout_marginRight="8dp" />

        <!-- Choice 2: Pastel Blue -->
        <View
            android:id="@+id/color_blue"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="#E8F4F8"
            android:layout_marginRight="8dp" />

        <!-- Choice 3: Pastel Yellow/Cream -->
        <View
            android:id="@+id/color_cream"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="#FCF7E3"
            android:layout_marginRight="8dp" />

        <!-- Choice 4: Pastel Mint -->
        <View
            android:id="@+id/color_mint"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="#EAF8F2"
            android:layout_marginRight="8dp" />

        <!-- Choice 5: Pastel Pink -->
        <View
            android:id="@+id/color_pink"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="#FCECEF" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EAEAEA" />

    <!-- Progress Indicator -->
    <ProgressBar
        android:id="@+id/pb_detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone"
        android:layout_marginTop="8dp" />

    <!-- Dynamic Canvas Wrapper -->
    <LinearLayout
        android:id="@+id/ll_detail_canvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="#FFFFFF">

        <!-- Word and Character Counts Display (Mandatory local calculation) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tv_local_words"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Words: 0"
                android:textColor="#555555"
                android:textSize="12sp"
                android:layout_marginRight="16dp" />

            <TextView
                android:id="@+id/tv_local_chars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Characters: 0"
                android:textColor="#555555"
                android:textSize="12sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/et_note_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Title of your thought..."
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:background="@android:color/transparent"
            android:textColorHint="#999999"
            android:layout_marginBottom="16dp"
            android:singleLine="true" />

        <EditText
            android:id="@+id/et_note_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:hint="Begin typing details here..."
            android:textSize="15sp"
            android:textColor="#444444"
            android:background="@android:color/transparent"
            android:textColorHint="#BBBBBB"
            android:gravity="top"
            android:scrollbars="vertical" />

    </LinearLayout>
</LinearLayout>