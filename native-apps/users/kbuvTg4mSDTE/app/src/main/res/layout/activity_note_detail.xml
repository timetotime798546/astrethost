<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="← Back"
                android:textSize="12sp"
                android:backgroundTint="#64748B"
                android:textColor="#FFFFFF"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <Button
                android:id="@+id/btnDeleteNote"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Delete"
                android:textSize="12sp"
                android:backgroundTint="#EF4444"
                android:textColor="#FFFFFF"
                android:visibility="gone"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnSaveNote"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Save"
                android:textSize="12sp"
                android:textStyle="bold"
                android:backgroundTint="#2563EB"
                android:textColor="#FFFFFF"/>

        </LinearLayout>

        <EditText
            android:id="@+id/etNoteTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Title..."
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#0F172A"
            android:background="@null"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <Spinner
                android:id="@+id/spinnerCategory"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="#F1F5F9"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_marginEnd="12dp"/>

            <CheckBox
                android:id="@+id/cbPinned"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📌 Pin Note"
                android:textSize="13sp"
                android:textColor="#0F172A"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tag Color: "
                android:textSize="12sp"
                android:textColor="#64748B"
                android:textStyle="bold"/>

            <RadioGroup
                android:id="@+id/rgColor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbBlue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Blue"
                    android:textSize="11sp"
                    android:checked="true"/>

                <RadioButton
                    android:id="@+id/rbGreen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Green"
                    android:textSize="11sp"/>

                <RadioButton
                    android:id="@+id/rbOrange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Orange"
                    android:textSize="11sp"/>

                <RadioButton
                    android:id="@+id/rbPurple"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Purple"
                    android:textSize="11sp"/>

            </RadioGroup>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E2E8F0"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etNoteContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:hint="Start typing your note here..."
            android:gravity="top|start"
            android:textSize="15sp"
            android:textColor="#334155"
            android:background="@null"
            android:minLines="12"
            android:inputType="textMultiLine"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp">

            <TextView
                android:id="@+id/tvLiveWordCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Words: 0"
                android:textSize="12sp"
                android:textColor="#64748B"
                android:layout_marginEnd="16dp"/>

            <TextView
                android:id="@+id/tvLiveCharCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Characters: 0"
                android:textSize="12sp"
                android:textColor="#64748B"/>

        </LinearLayout>

        <ProgressBar
            android:id="@+id/pbDetailLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"/>

    </LinearLayout>
</ScrollView>