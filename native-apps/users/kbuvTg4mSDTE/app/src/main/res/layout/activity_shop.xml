<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FA">

    <!-- Header Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#FFFFFF"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <TextView
            android:id="@+id/tvShopHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="SHOZICA"
            android:textColor="#111111"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true">

            <Button
                android:id="@+id/btnHeaderOrders"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:background="#EAEAEA"
                android:text="📜"
                android:textSize="18sp"
                android:textColor="#111111"
                android:layout_marginRight="8dp" />

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <Button
                    android:id="@+id/btnHeaderCart"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:background="#111111"
                    android:text="🛒"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF" />

                <!-- Badge overlay for Cart Size -->
                <TextView
                    android:id="@+id/tvCartBadge"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="#FF4757"
                    android:textColor="#FFFFFF"
                    android:textSize="10dp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:text="0"
                    android:layout_alignTop="@id/btnHeaderCart"
                    android:layout_alignRight="@id/btnHeaderCart"
                    android:layout_marginTop="-4dp"
                    android:layout_marginRight="-4dp" />
            </RelativeLayout>
        </LinearLayout>
    </RelativeLayout>

    <!-- Search Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="#FFFFFF">

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="#F0F1F4"
            android:hint="Search premium footwear..."
            android:inputType="text"
            android:paddingLeft="14dp"
            android:textColor="#333333"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Categories Filters -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/layoutCategories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCatAll"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="#111111"
                android:text="All Ateliers"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:layout_marginRight="8dp"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"/>

            <Button
                android:id="@+id/btnCatSport"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="#FFFFFF"
                android:text="Performance Sport"
                android:textColor="#333333"
                android:textSize="12sp"
                android:layout_marginRight="8dp"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"/>

            <Button
                android:id="@+id/btnCatClassic"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="#FFFFFF"
                android:text="Classic Leather"
                android:textColor="#333333"
                android:textSize="12sp"
                android:layout_marginRight="8dp"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"/>

            <Button
                android:id="@+id/btnCatCasual"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="#FFFFFF"
                android:text="Urban Walker"
                android:textColor="#333333"
                android:textSize="12sp"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"/>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Shoe Catalogue Grid View -->
    <GridView
        android:id="@+id/gridShoes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:numColumns="2"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:horizontalSpacing="8dp"
        android:verticalSpacing="8dp" />

    <!-- Bottom Logout Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:padding="12dp"
        android:gravity="center">

        <Button
            android:id="@+id/btnShopLogout"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="#FFEBEB"
            android:text="Logout Session"
            android:textColor="#FF4757"
            android:textSize="12sp"
            android:paddingLeft="20dp"
            android:paddingRight="20dp" />
    </LinearLayout>

</LinearLayout>