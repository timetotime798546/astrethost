<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_bg"
    android:orientation="vertical"
    android:padding="14dp"
    android:layout_marginBottom="8dp">

    <!-- Row 1: Name and Category badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/txtProdName"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Product Display Name"
            android:textColor="#333333"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtCategoryBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#E0F2F1"
            android:text="Hardware"
            android:textColor="#00796B"
            android:textSize="11sp"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3dp" />
    </LinearLayout>

    <!-- Row 2: SKU and pricing margins -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/txtSkuCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SKU: HW-449"
            android:textColor="#777777"
            android:textSize="12sp" />

        <View
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/txtMarginLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Margin: 12.5%"
            android:textColor="#00796B"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Row 3: Current stocks, prices and critical alerts -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/txtPricingLabel"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Buy: $10.00 | Sell: $12.50"
            android:textColor="#333333"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txtStockLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Qty: 48 units"
            android:textColor="#333333"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Critical low stock badge (shown optionally) -->
    <TextView
        android:id="@+id/txtLowStockIndicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚠️ Low Stock Alert: Below warning limit!"
        android:textColor="#D32F2F"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

</LinearLayout>