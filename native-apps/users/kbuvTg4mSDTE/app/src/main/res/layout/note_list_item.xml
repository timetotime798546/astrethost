<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/note_item_bg"
    android:padding="16dp"
    android:elevation="1dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/text_note_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@+id/text_note_category"
            android:layout_alignParentLeft="true"
            android:text="Note Title"
            android:textColor="#212121"
            android:textSize="18sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/text_note_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:text="Work"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/tag_bg"
            android:textColor="#1E88E5"/>
    </RelativeLayout>

    <TextView
        android:id="@+id/text_note_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="This is a preview of the note content..."
        android:textColor="#555555"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"
        android:maxLines="2"
        android:ellipsize="end"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/text_note_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Oct 24, 2023 14:30"
        android:textColor="#9E9E9E"
        android:textSize="11sp"
        android:gravity="right"/>

</LinearLayout>