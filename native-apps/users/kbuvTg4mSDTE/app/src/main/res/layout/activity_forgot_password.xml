<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAFAFA"
    android:padding="24dp"
    android:gravity="center_vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reset Password"
        android:textColor="#3F51B5"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Follow instructions to recover your workspace"
        android:textColor="#757575"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Step 1: Get OTP"
        android:textColor="#212121"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/edit_forgot_email"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#FFFFFF"
        android:elevation="1dp"
        android:hint="Your Register Email"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:textColor="#212121"
        android:textSize="15sp"
        android:inputType="textEmailAddress"
        android:singleLine="true"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/button_send_otp"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Request OTP"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="@drawable/btn_primary_bg"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Step 2: Enter Details and Reset"
        android:textColor="#212121"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/edit_forgot_otp"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#FFFFFF"
        android:elevation="1dp"
        android:hint="6-Digit OTP Code"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:textColor="#212121"
        android:textSize="15sp"
        android:inputType="number"
        android:singleLine="true"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/edit_forgot_new_password"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#FFFFFF"
        android:elevation="1dp"
        android:hint="New Password"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:textColor="#212121"
        android:textSize="15sp"
        android:inputType="textPassword"
        android:singleLine="true"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/button_reset_password"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Reset Password"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="@drawable/btn_save_bg"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/text_back_to_login"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back to Login"
        android:textColor="#3F51B5"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="8dp"/>

</LinearLayout>