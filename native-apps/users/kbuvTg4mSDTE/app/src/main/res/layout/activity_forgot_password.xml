<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← BACK TO LOGIN"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="32dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reset Password"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recover your shozica access using dynamic OTP verification via Gmail."
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <!-- Status Box -->
        <TextView
            android:id="@+id/otp_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/status_green"
            android:textSize="14sp"
            android:background="@color/bg_card"
            android:padding="12dp"
            android:visibility="gone"
            android:layout_marginBottom="20dp"/>

        <!-- STEP 1 CONTAINER: Request OTP -->
        <LinearLayout
            android:id="@+id/container_step1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/et_recover_email"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="Enter registered email"
                android:textColorHint="@color/text_secondary"
                android:textColor="@color/text_primary"
                android:background="@color/bg_card"
                android:paddingHorizontal="16dp"
                android:inputType="textEmailAddress"
                android:textSize="15sp"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btn_request_otp"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="SEND VERIFICATION OTP"
                android:textColor="@color/bg_dark"
                android:background="@color/accent_gold"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- STEP 2 CONTAINER: Verify and Reset -->
        <LinearLayout
            android:id="@+id/container_step2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter Verification Code"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/et_otp"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="6-Digit OTP Code"
                android:textColorHint="@color/text_secondary"
                android:textColor="@color/text_primary"
                android:background="@color/bg_card"
                android:paddingHorizontal="16dp"
                android:inputType="number"
                android:textSize="16sp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter New Password"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/et_new_password"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="New Secure Password"
                android:textColorHint="@color/text_secondary"
                android:textColor="@color/text_primary"
                android:background="@color/bg_card"
                android:paddingHorizontal="16dp"
                android:inputType="textPassword"
                android:textSize="15sp"
                android:layout_marginBottom="20dp" />

            <Button
                android:id="@+id/btn_reset_password"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="RESET PASSWORD"
                android:textColor="@color/bg_dark"
                android:background="@color/accent_gold"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Progress State Indicator -->
        <ProgressBar
            android:id="@+id/otp_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>