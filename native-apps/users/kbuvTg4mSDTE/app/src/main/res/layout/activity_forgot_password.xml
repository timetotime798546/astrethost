<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#121824">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RESET PASSWORD"
            android:textColor="#D4AF37"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="50dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reset your password securely via OTP"
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:layout_marginTop="8dp" />

        <!-- Card Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E293B"
            android:layout_marginTop="30dp"
            android:padding="20dp">

            <!-- Step 1 Layout -->
            <LinearLayout
                android:id="@+id/llStep1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="REGISTERED EMAIL"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etForgotEmail"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="#121824"
                    android:textColor="#FFFFFF"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:layout_marginTop="6dp"
                    android:inputType="textEmailAddress"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnSendOtp"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="REQUEST OTP CODE"
                    android:textColor="#121824"
                    android:textStyle="bold"
                    android:background="@drawable/button_rounded"
                    android:layout_marginTop="20dp" />
            </LinearLayout>

            <!-- Step 2 Layout -->
            <LinearLayout
                android:id="@+id/llStep2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ENTER 6-DIGIT OTP"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etOtpCode"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="#121824"
                    android:textColor="#FFFFFF"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:layout_marginTop="6dp"
                    android:inputType="number"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ENTER NEW PASSWORD"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp" />

                <EditText
                    android:id="@+id/etNewPassword"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="#121824"
                    android:textColor="#FFFFFF"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:layout_marginTop="6dp"
                    android:inputType="textPassword"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnSubmitReset"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="CONFIRM RESET"
                    android:textColor="#121824"
                    android:textStyle="bold"
                    android:background="@drawable/button_rounded"
                    android:layout_marginTop="20dp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/pbLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                android:layout_marginTop="16dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/btnBackToLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel &amp; Return to Login"
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:layout_marginTop="20dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>
</ScrollView>