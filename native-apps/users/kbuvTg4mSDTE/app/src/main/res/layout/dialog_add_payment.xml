<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_slate"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Record Payment"
            android:textColor="@color/text_white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/dialogPayMemberSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/input_bg" />

        <EditText
            android:id="@+id/dialogPayAmount"
            style="@style/GymProInputStyle"
            android:layout_marginBottom="10dp"
            android:hint="Paid Amount (₹)"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/dialogPayPending"
            style="@style/GymProInputStyle"
            android:layout_marginBottom="10dp"
            android:hint="Pending Amount (₹)"
            android:inputType="numberDecimal" />

        <Spinner
            android:id="@+id/dialogPayMethodSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/input_bg" />

        <Button
            android:id="@+id/dialogBtnSavePayment"
            style="@style/GymProButtonStyle"
            android:text="Record Payment" />

    </LinearLayout>

</ScrollView>