<?xml version="1.0" encoding="utf-8"?>
<!-- Single-Image Adaptive Context: Clean Row with Thumbnail Aligned with Text Content -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@color/surface"
    android:padding="12dp"
    android:layout_marginBottom="12dp"
    android:elevation="2dp"
    android:gravity="center_vertical">

    <!-- Responsive Single Image Aligned with Text Content -->
    <ImageView
        android:id="@+id/ivServiceThumbnail"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:scaleType="centerCrop"
        android:background="#CBD5E1" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingLeft="12dp">

        <TextView
            android:id="@+id/tvServiceName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Artisan Haircut"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvServiceDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="2"
            android:text="Precision scissor cut and hot lather neck shave."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tvServicePrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$35.00"
                android:textColor="@color/accent"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvServiceDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:text="30 mins"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btnViewDetails"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="View"
        android:textColor="@color/surface"
        android:background="@color/primary"
        android:textSize="11sp"
        android:layout_marginLeft="6dp" />
</LinearLayout>