<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_slate"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Add New Gym Member"
            android:textColor="@color/text_white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/dialogMemName"
            style="@style/GymProInputStyle"
            android:layout_marginBottom="10dp"
            android:hint="Full Name" />

        <EditText
            android:id="@+id/dialogMemPhone"
            style="@style/GymProInputStyle"
            android:layout_marginBottom="10dp"
            android:hint="Phone Number"
            android:inputType="phone" />

        <EditText
            android:id="@+id/dialogMemEmail"
            style="@style/GymProInputStyle"
            android:layout_marginBottom="10dp"
            android:hint="Email Address"
            android:inputType="textEmailAddress" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/dialogMemAge"
                style="@style/GymProInputStyle"
                android:layout_width="0dp"
                android:layout_marginRight="6dp"
                android:layout_weight="1"
                android:hint="Age"
                android:inputType="number" />

            <Spinner
                android:id="@+id/dialogMemGender"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginLeft="6dp"
                android:layout_weight="1"
                android:background="@drawable/input_bg" />

        </LinearLayout>

        <Spinner
            android:id="@+id/dialogMemPlan"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/input_bg" />

        <Button
            android:id="@+id/dialogBtnSaveMember"
            style="@style/GymProButtonStyle"
            android:text="Save Member" />

    </LinearLayout>

</ScrollView>