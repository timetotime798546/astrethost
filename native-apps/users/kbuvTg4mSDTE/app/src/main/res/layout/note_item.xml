<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:layout_marginBottom="12dp"
    android:padding="16dp"
    android:elevation="2dp">

    <!-- Title and Category Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/itemTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Note Title"
            android:textColor="#212121"
            android:textSize="18sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/itemCategoryChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WORK"
            android:textColor="#FFFFFF"
            android:background="#FF9800"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"/>
    </LinearLayout>

    <!-- Content Snippet -->
    <TextView
        android:id="@+id/itemContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="This is an example note content snippet that will expand or cut off depending on content length."
        android:textColor="#616161"
        android:textSize="14sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginBottom="12dp" />

    <!-- Bottom details/action bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Word count calculation display (LOCAL OFFLINE STATS) -->
        <TextView
            android:id="@+id/itemWordCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12 words"
            android:textColor="#9E9E9E"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" • "
            android:textColor="#E0E0E0"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp" />

        <TextView
            android:id="@+id/itemDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Oct 24, 2023"
            android:textColor="#9E9E9E"
            android:textSize="11sp" />

        <!-- Delete item button (standard Button styled nicely to save space) -->
        <Button
            android:id="@+id/btnItemDelete"
            android:layout_width="64dp"
            android:layout_height="28dp"
            android:text="DELETE"
            android:textSize="9sp"
            android:textColor="#FFFFFF"
            android:background="#D32F2F"
            android:textStyle="bold"
            android:focusable="false"
            android:focusableInTouchMode="false"/>
    </LinearLayout>
</LinearLayout>