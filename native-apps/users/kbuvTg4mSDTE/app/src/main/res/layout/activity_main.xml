<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#101216"
    android:padding="20dp">

    <!-- Top Toolbar / Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Pro Calculator"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnHistoryToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_button_number"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="History"
            android:textColor="#00C853"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Screen / Display Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.6"
        android:orientation="vertical"
        android:gravity="bottom|end"
        android:padding="20dp"
        android:background="@drawable/bg_screen"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#7A8499"
            android:textSize="16sp"
            android:gravity="end"
            android:singleLine="true"
            android:ellipsize="start"
            android:text=""
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/tvDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="48sp"
            android:textStyle="bold"
            android:gravity="end"
            android:singleLine="true"
            android:ellipsize="start"
            android:text="0" />

    </LinearLayout>

    <!-- Keypad Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3.8"
        android:orientation="vertical">

        <!-- Row 1: Clear, Brackets, Percentage, Divide -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnClear"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:text="C"
                android:textSize="20sp"
                android:textColor="#FF5252"
                android:background="@drawable/bg_button_action" />

            <Button
                android:id="@+id/btnOpenBracket"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:text="("
                android:textSize="20sp"
                android:textColor="#42A5F5"
                android:background="@drawable/bg_button_number" />

            <Button
                android:id="@+id/btnCloseBracket"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:text=")"
                android:textSize="20sp"
                android:textColor="#42A5F5"
                android:background="@drawable/bg_button_number" />

            <Button
                android:id="@+id/btnDivide"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:text="÷"
                android:textSize="24sp"
                android:textColor="#42A5F5"
                android:background="@drawable/bg_button_operator" />
        </LinearLayout>

        <!-- Row 2: 7, 8, 9, Multiply -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn7"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:text="7"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_button_number" />

            <Button
                android:id="@+id/btn8"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:text="8"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_button_number" />

            <Button
                android:id="@+id/btn9"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:text="9"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_button_number" />

            <Button
                android:id="@+id/btnMultiply"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:text="×"
                android:textSize="24sp"
                android:textColor="#42A5F5"
                android:background="@drawable/bg_button_operator" />
        </LinearLayout>

        <!-- Row 3: 4, 5, 6, Subtract -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:text="4"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_button_number" />

            <Button
                android:id="@+id/btn5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:text="5"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_button_number" />

            <Button
                android:id="@+id/btn6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:text="6"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_button_number" />

            <Button
                android:id="@+id/btnSubtract"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:text="-"
                android:textSize="24sp"
                android:textColor="#42A5F5"
                android:background="@drawable/bg_button_operator" />
        </LinearLayout>

        <!-- Row 4: 1, 2, 3, Add -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:text="1"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_button_number" />

            <Button
                android:id="@+id/btn2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:text="2"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_button_number" />

            <Button
                android:id="@+id/btn3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:text="3"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_button_number" />

            <Button
                android:id="@+id/btnAdd"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:text="+"
                android:textSize="24sp"
                android:textColor="#42A5F5"
                android:background="@drawable/bg_button_operator" />
        </LinearLayout>

        <!-- Row 5: Backspace, 0, Decimal, Equals -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:text="⌫"
                android:textSize="20sp"
                android:textColor="#FFA726"
                android:background="@drawable/bg_button_number" />

            <Button
                android:id="@+id/btn0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:text="0"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_button_number" />

            <Button
                android:id="@+id/btnDecimal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:text="."
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_button_number" />

            <Button
                android:id="@+id/btnEquals"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:text="="
                android:textSize="26sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_button_equals" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>