<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F9FAFB"
    android:padding="20dp">

    <!-- Premium App Workspace Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MY WORKSPACE"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#6366F1"
            android:letterSpacing="0.15" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Notes &amp; Ideas"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#111827"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Modern Search Bar Input -->
    <EditText
        android:id="@+id/et_search"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Search title or content..."
        android:background="@drawable/bg_search_input"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_marginBottom="16dp"
        android:inputType="text"
        android:textColor="#111827"
        android:textColorHint="#9CA3AF"
        android:textSize="15sp" />

    <!-- Category Selector & Custom Dynamic Filters Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:background="@drawable/bg_spinner"
            android:gravity="center_vertical"
            android:padding="2dp">

            <Spinner
                android:id="@+id/spinner_filter"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="@null" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_add_category"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="+ Category"
            android:background="@drawable/bg_button_add_category"
            android:textColor="#4F46E5"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_marginLeft="12dp"
            android:paddingLeft="16dp"
            android:paddingRight="16dp" />
    </LinearLayout>

    <!-- Premium Custom Notes Cards ListView Container -->
    <ListView
        android:id="@+id/lv_notes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="14dp"
        android:scrollbars="none"
        android:overScrollMode="never" />

    <!-- Bottom Primary Create Action Action -->
    <Button
        android:id="@+id/btn_add_note"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_button_primary"
        android:textColor="#FFFFFF"
        android:text="+ Create New Note"
        android:textStyle="bold"
        android:textSize="16sp" />
</LinearLayout>