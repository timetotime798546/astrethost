<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F6F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- LOGIN CONTAINER -->
        <LinearLayout
            android:id="@+id/loginContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:padding="24dp"
            android:layout_gravity="center"
            android:visibility="visible">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Calculator Verifier"
                android:textColor="#1A73E8"
                android:textSize="28sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Login to your account to verify calculations with Cloudflare Workers"
                android:textColor="#5F6368"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Email Address"
                android:textColor="#202124"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/loginEmail"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#F1F3F4"
                android:padding="12dp"
                android:inputType="textEmailAddress"
                android:hint="email@example.com"
                android:textColor="#202124"
                android:textColorHint="#9AA0A6"
                android:layout_marginBottom="16dp"
                android:singleLine="true"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Password"
                android:textColor="#202124"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/loginPassword"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#F1F3F4"
                android:padding="12dp"
                android:inputType="textPassword"
                android:hint="••••••••"
                android:textColor="#202124"
                android:textColorHint="#9AA0A6"
                android:layout_marginBottom="24dp"
                android:singleLine="true"/>

            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Login"
                android:textColor="#FFFFFF"
                android:background="#1A73E8"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/txtGoToRegister"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Don't have an account? Register"
                android:textColor="#1A73E8"
                android:textSize="14sp"
                android:gravity="center"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"/>

            <ProgressBar
                android:id="@+id/loginProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/txtLoginError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#D93025"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginTop="12dp"
                android:visibility="gone"/>

        </LinearLayout>

        <!-- REGISTER CONTAINER -->
        <LinearLayout
            android:id="@+id/registerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:padding="24dp"
            android:layout_gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Create Account"
                android:textColor="#1A73E8"
                android:textSize="28sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Join to calculate and verify authoritatively"
                android:textColor="#5F6368"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Email Address"
                android:textColor="#202124"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/registerEmail"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#F1F3F4"
                android:padding="12dp"
                android:inputType="textEmailAddress"
                android:hint="email@example.com"
                android:textColor="#202124"
                android:textColorHint="#9AA0A6"
                android:layout_marginBottom="16dp"
                android:singleLine="true"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Password"
                android:textColor="#202124"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/registerPassword"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#F1F3F4"
                android:padding="12dp"
                android:inputType="textPassword"
                android:hint="At least 6 characters"
                android:textColor="#202124"
                android:textColorHint="#9AA0A6"
                android:layout_marginBottom="16dp"
                android:singleLine="true"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Confirm Password"
                android:textColor="#202124"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/registerConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#F1F3F4"
                android:padding="12dp"
                android:inputType="textPassword"
                android:hint="Repeat password"
                android:textColor="#202124"
                android:textColorHint="#9AA0A6"
                android:layout_marginBottom="24dp"
                android:singleLine="true"/>

            <Button
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Register"
                android:textColor="#FFFFFF"
                android:background="#1A73E8"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/txtGoToLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Already have an account? Login"
                android:textColor="#1A73E8"
                android:textSize="14sp"
                android:gravity="center"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"/>

            <ProgressBar
                android:id="@+id/registerProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/txtRegisterError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#D93025"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginTop="12dp"
                android:visibility="gone"/>

        </LinearLayout>

        <!-- CALCULATOR CONTAINER -->
        <LinearLayout
            android:id="@+id/calculatorContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:padding="24dp"
            android:visibility="gone">

            <!-- HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp"
                android:paddingBottom="12dp"
                android:background="?android:attr/dividerHorizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Calculator Verifier"
                        android:textColor="#1A73E8"
                        android:textSize="18sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/txtUserEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="user@example.com"
                        android:textColor="#5F6368"
                        android:textSize="12sp"/>
                </LinearLayout>

                <Button
                    android:id="@+id/btnLogout"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Logout"
                    android:textColor="#D93025"
                    android:background="?android:attr/selectableItemBackground"
                    android:textSize="12sp"/>
            </LinearLayout>

            <!-- INPUTS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Number A"
                android:textColor="#202124"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/editNumA"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#F1F3F4"
                android:padding="12dp"
                android:inputType="numberDecimal|numberSigned"
                android:hint="Enter first number"
                android:textColor="#202124"
                android:textColorHint="#9AA0A6"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Arithmetic Operation"
                android:textColor="#202124"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="4dp"/>

            <!-- Operation Selection -->
            <Spinner
                android:id="@+id/spinnerOp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#F1F3F4"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Number B"
                android:textColor="#202124"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/editNumB"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#F1F3F4"
                android:padding="12dp"
                android:inputType="numberDecimal|numberSigned"
                android:hint="Enter second number"
                android:textColor="#202124"
                android:textColorHint="#9AA0A6"
                android:layout_marginBottom="24dp"/>

            <!-- ACTIONS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btnCalculate"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Calculate"
                    android:textColor="#FFFFFF"
                    android:background="#1A73E8"
                    android:textStyle="bold"
                    android:layout_marginRight="4dp"/>

                <Button
                    android:id="@+id/btnClear"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Clear"
                    android:textColor="#202124"
                    android:background="#E8EAED"
                    android:textStyle="bold"
                    android:layout_marginLeft="4dp"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnVerify"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Verify Result with Backend"
                android:textColor="#FFFFFF"
                android:background="#34A853"
                android:textStyle="bold"
                android:enabled="false"
                android:layout_marginBottom="20dp"/>

            <!-- RESULT AREA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#F8F9FA"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/textResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Result: -"
                    android:textColor="#202124"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center"/>

                <TextView
                    android:id="@+id/textVerifyStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Enter numbers and click Calculate."
                    android:textColor="#5F6368"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>

            <!-- DETAILED VERIFY RESULTS -->
            <LinearLayout
                android:id="@+id/layoutVerifyResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#E6F4EA"
                android:padding="16dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txtVerifyHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="✓ Result verified"
                    android:textColor="#137333"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/txtVerifyDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Expected: 30.0 | Received: 30.0"
                    android:textColor="#137333"
                    android:textSize="14sp"
                    android:gravity="center"/>
            </LinearLayout>

            <!-- LOADING BAR FOR VERIFY -->
            <ProgressBar
                android:id="@+id/verifyProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"/>

        </LinearLayout>

    </LinearLayout>
</ScrollView>