<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/studio_bg">

    <!-- 1. TOP STUDIO CONTROL HEADER -->
    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:background="@drawable/bg_studio_header">

        <!-- Brand Title & Tag -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PhotoForge Pro"
                android:textColor="@color/studio_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/brand_subtitle"
                android:textColor="@color/studio_accent"
                android:textSize="8sp"
                android:letterSpacing="0.1" />
        </LinearLayout>

        <!-- Undo Button -->
        <Button
            android:id="@+id/btn_undo"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:text="↶"
            android:textSize="18sp"
            android:textColor="@color/studio_text_primary"
            android:background="@drawable/bg_tool_button"
            android:layout_marginRight="6dp" />

        <!-- Redo Button -->
        <Button
            android:id="@+id/btn_redo"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:text="↷"
            android:textSize="18sp"
            android:textColor="@color/studio_text_primary"
            android:background="@drawable/bg_tool_button"
            android:layout_marginRight="6dp" />

        <!-- Layers Manager Badge -->
        <TextView
            android:id="@+id/badge_layers"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="Layers (2)"
            android:gravity="center"
            android:textColor="@color/studio_text_primary"
            android:textSize="11sp"
            android:background="@drawable/bg_badge"
            android:layout_marginRight="6dp" />

        <!-- Split View Toggle -->
        <Button
            android:id="@+id/btn_split_compare"
            android:layout_width="44dp"
            android:layout_height="36dp"
            android:text="B/A"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/studio_text_primary"
            android:background="@drawable/bg_tool_button"
            android:layout_marginRight="8dp" />

        <!-- Save & Export Button -->
        <Button
            android:id="@+id/btn_save_export"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Save &amp; Share"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:background="@drawable/bg_action_btn" />
    </LinearLayout>

    <!-- 2. MIDDLE VIEWPORT & SIDEBAR SPLIT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Primary Left Sidebar (Workspace Tools) -->
        <LinearLayout
            android:id="@+id/sidebar_tools"
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@color/studio_surface"
            android:paddingTop="8dp">

            <Button
                android:id="@+id/side_btn_projects"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="📂"
                android:textSize="18sp"
                android:textColor="@color/studio_text_primary"
                android:background="@drawable/bg_tool_button"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/side_btn_ai"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="✨"
                android:textSize="18sp"
                android:textColor="@color/studio_text_primary"
                android:background="@drawable/bg_tool_button"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/side_btn_batch"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="📚"
                android:textSize="18sp"
                android:textColor="@color/studio_text_primary"
                android:background="@drawable/bg_tool_button"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/side_btn_collage"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="🖼"
                android:textSize="18sp"
                android:textColor="@color/studio_text_primary"
                android:background="@drawable/bg_tool_button"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/side_btn_vault"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="🔒"
                android:textSize="18sp"
                android:textColor="@color/studio_text_primary"
                android:background="@drawable/bg_tool_button"
                android:layout_marginBottom="8dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/side_btn_profile"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="👤"
                android:textSize="18sp"
                android:textColor="@color/studio_text_primary"
                android:background="@drawable/bg_tool_button"
                android:layout_marginBottom="8dp" />
        </LinearLayout>

        <!-- Center Workspace Image Canvas Viewport -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#0A0B0D">

            <com.photoforgepro.app.PhotoCanvasView
                android:id="@+id/photo_canvas_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Floating Top Helper Notification / Status -->
            <TextView
                android:id="@+id/tv_canvas_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="10dp"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="Canvas Active · 100% Client-Side Engine"
                android:textSize="10sp"
                android:textColor="@color/studio_text_secondary"
                android:background="@drawable/bg_badge" />

            <!-- Floating Quick Import Button -->
            <Button
                android:id="@+id/btn_import_image"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_gravity="top|right"
                android:layout_marginTop="8dp"
                android:layout_marginRight="8dp"
                android:text="+ Load Image"
                android:textSize="11sp"
                android:textColor="@color/studio_accent_light"
                android:background="@drawable/bg_badge" />
        </FrameLayout>
    </LinearLayout>

    <!-- 3. HORIZONTALLY SCROLLABLE EDITING TOOLS CATEGORY BAR -->
    <HorizontalScrollView
        android:id="@+id/tools_category_scroll"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:scrollbars="none"
        android:background="@color/studio_surface">

        <LinearLayout
            android:id="@+id/tools_category_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="8dp"
            android:paddingRight="8dp">

            <Button
                android:id="@+id/tool_btn_adjust"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="⚡ Adjust"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_badge_accent"
                android:layout_marginRight="6dp" />

            <Button
                android:id="@+id/tool_btn_filters"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="🎬 Cinematic"
                android:textSize="11sp"
                android:textColor="@color/studio_text_secondary"
                android:background="@drawable/bg_tool_button"
                android:layout_marginRight="6dp" />

            <Button
                android:id="@+id/tool_btn_rotate"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="🔄 Rotate"
                android:textSize="11sp"
                android:textColor="@color/studio_text_secondary"
                android:background="@drawable/bg_tool_button"
                android:layout_marginRight="6dp" />

            <Button
                android:id="@+id/tool_btn_hsl"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="🎨 HSL Grading"
                android:textSize="11sp"
                android:textColor="@color/studio_text_secondary"
                android:background="@drawable/bg_tool_button"
                android:layout_marginRight="6dp" />

            <Button
                android:id="@+id/tool_btn_curves"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="📈 Curves"
                android:textSize="11sp"
                android:textColor="@color/studio_text_secondary"
                android:background="@drawable/bg_tool_button"
                android:layout_marginRight="6dp" />

            <Button
                android:id="@+id/tool_btn_denoise"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="💧 Denoise"
                android:textSize="11sp"
                android:textColor="@color/studio_text_secondary"
                android:background="@drawable/bg_tool_button"
                android:layout_marginRight="6dp" />

            <Button
                android:id="@+id/tool_btn_sharpen"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="🔪 Sharpen"
                android:textSize="11sp"
                android:textColor="@color/studio_text_secondary"
                android:background="@drawable/bg_tool_button"
                android:layout_marginRight="6dp" />

            <Button
                android:id="@+id/tool_btn_healing"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="🩹 Healing"
                android:textSize="11sp"
                android:textColor="@color/studio_text_secondary"
                android:background="@drawable/bg_tool_button"
                android:layout_marginRight="6dp" />

            <Button
                android:id="@+id/tool_btn_vignette"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="⭕ Lens Blur"
                android:textSize="11sp"
                android:textColor="@color/studio_text_secondary"
                android:background="@drawable/bg_tool_button"
                android:layout_marginRight="6dp" />

            <Button
                android:id="@+id/tool_btn_reset"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="↩ Reset"
                android:textSize="11sp"
                android:textColor="@color/studio_danger"
                android:background="@drawable/bg_tool_button" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 4. PRECISION ADJUSTMENT SLIDERS PANEL (BOTTOM DRAWER) -->
    <LinearLayout
        android:id="@+id/precision_drawer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/studio_card"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <!-- Slider 1: Exposure -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:text="Exposure"
                android:textColor="@color/studio_text_primary"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/slider_exposure"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="200"
                android:progress="100" />

            <TextView
                android:id="@+id/val_exposure"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:text="0.0"
                android:gravity="right"
                android:textColor="@color/studio_accent_light"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Slider 2: Contrast -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:text="Contrast"
                android:textColor="@color/studio_text_primary"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/slider_contrast"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="200"
                android:progress="100" />

            <TextView
                android:id="@+id/val_contrast"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:text="0"
                android:gravity="right"
                android:textColor="@color/studio_accent_light"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Slider 3: Saturation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:text="Saturation"
                android:textColor="@color/studio_text_primary"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/slider_saturation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="200"
                android:progress="100" />

            <TextView
                android:id="@+id/val_saturation"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:text="0"
                android:gravity="right"
                android:textColor="@color/studio_accent_light"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Slider 4: Shadows -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:text="Shadows"
                android:textColor="@color/studio_text_primary"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/slider_shadows"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="200"
                android:progress="100" />

            <TextView
                android:id="@+id/val_shadows"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:text="0"
                android:gravity="right"
                android:textColor="@color/studio_accent_light"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Slider 5: Highlights -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:text="Highlights"
                android:textColor="@color/studio_text_primary"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/slider_highlights"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="200"
                android:progress="100" />

            <TextView
                android:id="@+id/val_highlights"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:text="0"
                android:gravity="right"
                android:textColor="@color/studio_accent_light"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 5. BOTTOM NAVIGATION BAR -->
    <LinearLayout
        android:id="@+id/bottom_nav_bar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:background="@color/studio_surface"
        android:gravity="center_vertical">

        <LinearLayout
            android:id="@+id/tab_nav_editing"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎨"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_editing"
                android:textColor="@color/studio_accent"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_nav_ai"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_ai"
                android:textColor="@color/studio_text_secondary"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_nav_gallery"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🖼"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_gallery"
                android:textColor="@color/studio_text_secondary"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_nav_community"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌐"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_community"
                android:textColor="@color/studio_text_secondary"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>