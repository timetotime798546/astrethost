<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- The 3D GL Viewport Container -->
    <FrameLayout
        android:id="@+id/gl_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Game HUD Overlay -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="12dp">

        <!-- Top Panel (Speedometer, RPM, and Sensor Toggle) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true">

            <!-- Left Utility Controls (Tilt Toggle and Lights Toggle) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_toggle_sensor"
                    android:layout_width="100dp"
                    android:layout_height="42dp"
                    android:background="#4CAF50"
                    android:text="TILT: ON"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="match_parent" />

                <Button
                    android:id="@+id/btn_toggle_lights"
                    android:layout_width="110dp"
                    android:layout_height="42dp"
                    android:background="@drawable/btn_lights_bg"
                    android:text="LIGHTS: OFF"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Cyberpunk Digital Meter Panel (Top Center) -->
            <LinearLayout
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:background="@drawable/hud_panel_bg"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/tv_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 MPH"
                    android:textColor="#FFEB3B"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <!-- Shift RPM Dynamic Lightup progress Bar -->
                <LinearLayout
                    android:id="@+id/rpm_bar_container"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:background="#33FFFFFF"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">
                    <View
                        android:id="@+id/v_rpm_bar"
                        android:layout_width="10dp"
                        android:layout_height="match_parent"
                        android:background="#FF3D00" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_gear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GEAR: N"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Score Display Box (Top Right) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:background="@drawable/hud_panel_bg"
                android:orientation="vertical"
                android:gravity="end"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">
                
                <TextView
                    android:id="@+id/tv_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SCORE: 00000"
                    android:textColor="#00FFCC"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_best_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BEST: 00000"
                    android:textColor="#FF3D00"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Bottom Responsive Dashboard Controls -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_alignParentBottom="true">

            <!-- Left / Right Steering Buttons (Bottom Left) -->
            <LinearLayout
                android:id="@+id/steering_controls"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentLeft="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_left"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:background="@drawable/btn_steer_bg"
                    android:text="◀"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="16dp"
                    android:layout_height="match_parent" />

                <Button
                    android:id="@+id/btn_right"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:background="@drawable/btn_steer_bg"
                    android:text="▶"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Centered Car Horn Button (Bottom Center) -->
            <Button
                android:id="@+id/btn_horn"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_centerInParent="true"
                android:background="@drawable/btn_horn_bg"
                android:text="HORN"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:elevation="4dp" />

            <!-- Gas / Brake Pedals (Bottom Right) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Brake Pedal -->
                <Button
                    android:id="@+id/btn_brake"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/btn_brake_bg"
                    android:text="BRAKE"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="12sp" />

                <View
                    android:layout_width="16dp"
                    android:layout_height="match_parent" />

                <!-- Gas Pedal -->
                <Button
                    android:id="@+id/btn_gas"
                    android:layout_width="85dp"
                    android:layout_height="85dp"
                    android:background="@drawable/btn_gas_bg"
                    android:text="GAS"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="16sp" />
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>

    <!-- Start / Collision Game Over Overlay Screen -->
    <LinearLayout
        android:id="@+id/overlay_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E605070A"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible"
        android:padding="20dp">

        <TextView
            android:id="@+id/tv_overlay_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="REAL 3D RACER"
            android:textColor="#00FFCC"
            android:textSize="40sp"
            android:textStyle="bold"
            android:shadowColor="#00FFCC"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="8"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tv_overlay_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tilt device or use buttons to weave through highway traffic! Turn on lights and blow horn!"
            android:textColor="#CCCCCC"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btn_start"
            android:layout_width="220dp"
            android:layout_height="55dp"
            android:background="@drawable/btn_gas_bg"
            android:text="START DRIVE"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>