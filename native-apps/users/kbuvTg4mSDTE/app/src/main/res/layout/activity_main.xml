<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F4F6F9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Title Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3D Metallic Card"
            android:textColor="#1F2937"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center_horizontal"
            android:layout_marginTop="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter info and drag the card to rotate in 3D"
            android:textColor="#6B7280"
            android:textSize="14sp"
            android:gravity="center_horizontal"
            android:layout_marginBottom="18dp"/>

        <!-- Custom 3D Card Display Area -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginBottom="16dp"
            android:background="#00000000">

            <!-- Container for the actual custom view rendering the card -->
            <com.metalliccardgenerator.app.MetallicCardView
                android:id="@+id/custom_metallic_card_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />
        </FrameLayout>

        <!-- Dynamic Preset Selector -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose Metal Texture:"
            android:textColor="#374151"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/btn_theme_gold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="24K Gold"
                android:textColor="#FFFFFF"
                android:background="#B58920"
                android:layout_marginRight="6dp" />

            <Button
                android:id="@+id/btn_theme_silver"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Platinum"
                android:textColor="#333333"
                android:background="#CBD5E0"
                android:layout_marginRight="6dp" />

            <Button
                android:id="@+id/btn_theme_obsidian"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Obsidian"
                android:textColor="#FFFFFF"
                android:background="#1A202C" />
        </LinearLayout>

        <!-- Information Input Forms -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shop &amp; Business Information"
                android:textColor="#111827"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <!-- Shop Name Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shop / Business Name"
                android:textColor="#4B5563"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/et_shop_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. Apex Chrono Boutique"
                android:maxLines="1"
                android:inputType="textCapWords"
                android:textColor="#1F2937"
                android:textSize="15sp"
                android:layout_marginBottom="16dp"
                android:padding="10dp"
                android:background="#F3F4F6"/>

            <!-- Phone Number Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phone Number"
                android:textColor="#4B5563"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/et_phone_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. +1 (555) 019-2834"
                android:maxLines="1"
                android:inputType="phone"
                android:textColor="#1F2937"
                android:textSize="15sp"
                android:layout_marginBottom="12dp"
                android:padding="10dp"
                android:background="#F3F4F6"/>

            <!-- Reset Button for Quick interaction demo -->
            <Button
                android:id="@+id/btn_reset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Reset Angles &amp; Values"
                android:background="#3B82F6"
                android:textColor="#FFFFFF"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Designed with dynamic specular reflection mapping. Touch and hold the card to tilt perspective."
            android:textColor="#9CA3AF"
            android:textSize="11sp"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"/>

    </LinearLayout>
</ScrollView>