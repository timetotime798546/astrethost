<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#121316">

    <!-- Premium Rounded Display Layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_display"
        android:padding="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp">

        <!-- Real-time formula / tracking equation -->
        <TextView
            android:id="@+id/formulaTextView"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:gravity="end"
            android:textSize="18sp"
            android:textColor="#8E8E93"
            android:singleLine="true"
            android:ellipsize="start"
            android:text="" />

        <!-- Main Editable display (acts as visual screen) -->
        <EditText
            android:id="@+id/displayEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:gravity="end"
            android:hint="0"
            android:textColorHint="#444446"
            android:textColor="#FFFFFF"
            android:inputType="numberDecimal"
            android:maxLength="15"
            android:singleLine="true"
            android:textSize="54sp"
            android:focusable="false"
            android:longClickable="false"
            android:text="0" />
    </LinearLayout>

    <!-- Calculator Grid Panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Row 1: Clear & Divide -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonClear"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:text="C"
                android:textSize="26sp"
                android:textColor="#F2F2F7"
                android:fontFamily="sans-serif-light"
                android:textAllCaps="false"
                android:layout_margin="5dp"
                android:background="@drawable/btn_utility_selector" />

            <Button
                android:id="@+id/buttonDivide"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="÷"
                android:textSize="28sp"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-light"
                android:textAllCaps="false"
                android:layout_margin="5dp"
                android:background="@drawable/btn_operator_selector" />
        </LinearLayout>

        <!-- Row 2: 7, 8, 9, Multiply -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button7"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="7"
                android:textSize="26sp"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-light"
                android:textAllCaps="false"
                android:layout_margin="5dp"
                android:background="@drawable/btn_number_selector" />

            <Button
                android:id="@+id/button8"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="8"
                android:textSize="26sp"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-light"
                android:textAllCaps="false"
                android:layout_margin="5dp"
                android:background="@drawable/btn_number_selector" />

            <Button
                android:id="@+id/button9"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="9"
                android:textSize="26sp"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-light"
                android:textAllCaps="false"
                android:layout_margin="5dp"
                android:background="@drawable/btn_number_selector" />

            <Button
                android:id="@+id/buttonMultiply"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="×"
                android:textSize="28sp"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-light"
                android:textAllCaps="false"
                android:layout_margin="5dp"
                android:background="@drawable/btn_operator_selector" />
        </LinearLayout>

        <!-- Row 3: 4, 5, 6, Subtract -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="4"
                android:textSize="26sp"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-light"
                android:textAllCaps="false"
                android:layout_margin="5dp"
                android:background="@drawable/btn_number_selector" />

            <Button
                android:id="@+id/button5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="5"
                android:textSize="26sp"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-light"
                android:textAllCaps="false"
                android:layout_margin="5dp"
                android:background="@drawable/btn_number_selector" />

            <Button
                android:id="@+id/button6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="6"
                android:textSize="26sp"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-light"
                android:textAllCaps="false"
                android:layout_margin="5dp"
                android:background="@drawable/btn_number_selector" />

            <Button
                android:id="@+id/buttonSubtract"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="−"
                android:textSize="28sp"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-light"
                android:textAllCaps="false"
                android:layout_margin="5dp"
                android:background="@drawable/btn_operator_selector" />
        </LinearLayout>

        <!-- Row 4: 1, 2, 3, Add -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="1"
                android:textSize="26sp"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-light"
                android:textAllCaps="false"
                android:layout_margin="5dp"
                android:background="@drawable/btn_number_selector" />

            <Button
                android:id="@+id/button2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="2"
                android:textSize="26sp"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-light"
                android:textAllCaps="false"
                android:layout_margin="5dp"
                android:background="@drawable/btn_number_selector" />

            <Button
                android:id="@+id/button3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="3"
                android:textSize="26sp"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-light"
                android:textAllCaps="false"
                android:layout_margin="5dp"
                android:background="@drawable/btn_number_selector" />

            <Button
                android:id="@+id/buttonAdd"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="+"
                android:textSize="28sp"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-light"
                android:textAllCaps="false"
                android:layout_margin="5dp"
                android:background="@drawable/btn_operator_selector" />
        </LinearLayout>

        <!-- Row 5: 0, . , = -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:text="0"
                android:textSize="26sp"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-light"
                android:textAllCaps="false"
                android:layout_margin="5dp"
                android:background="@drawable/btn_number_selector" />

            <Button
                android:id="@+id/buttonDecimal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="."
                android:textSize="26sp"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-light"
                android:textAllCaps="false"
                android:layout_margin="5dp"
                android:background="@drawable/btn_number_selector" />

            <Button
                android:id="@+id/buttonEquals"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="="
                android:textSize="28sp"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-light"
                android:textAllCaps="false"
                android:layout_margin="5dp"
                android:background="@drawable/btn_operator_selector" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>