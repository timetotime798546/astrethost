<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#ECEFF1">

    <!-- Top Action Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#37474F"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerY="true"
            android:text="Ludo Classic"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerY="true"
            android:text="New Match"
            android:backgroundTint="#00897B"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textAllCaps="false" />
    </RelativeLayout>

    <!-- Player Options Selector -->
    <LinearLayout
        android:id="@+id/layout_setup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="12dp"
        android:elevation="4dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Players Count:"
            android:textColor="#37474F"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3">

            <Button
                android:id="@+id/btn_players_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginRight="4dp"
                android:text="2 Players"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:backgroundTint="#78909C"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btn_players_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginRight="4dp"
                android:text="3 Players"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:backgroundTint="#78909C"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btn_players_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="4 Players"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:backgroundTint="#37474F"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <!-- Turn indicator & game state message banner -->
    <LinearLayout
        android:id="@+id/layout_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:padding="10dp"
        android:layout_marginBottom="8dp">

        <View
            android:id="@+id/view_turn_color"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginRight="12dp"
            android:background="#E53935" />

        <TextView
            android:id="@+id/tv_turn_indicator"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Red's Turn! Roll the dice."
            android:textColor="#37474F"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Ludo Board Wrapper -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="4dp">

        <com.ludoclassic.app.LudoBoardView
            android:id="@+id/ludo_board"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />
    </FrameLayout>

    <!-- Bottom Controls (Dice Roller) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#37474F"
        android:padding="16dp">

        <!-- Physical Dice UI Representation -->
        <RelativeLayout
            android:id="@+id/btn_roll_dice"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:background="#FFFFFF"
            android:elevation="8dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="10dp"
            android:padding="12dp">

            <!-- 3x3 Dots Grid layout on the physical dice -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:columnCount="3"
                android:rowCount="3">

                <!-- Row 0 -->
                <View
                    android:id="@+id/dot_tl"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_row="0"
                    android:layout_column="0"
                    android:layout_margin="3dp"
                    android:background="#000000"
                    android:visibility="invisible" />

                <View
                    android:id="@+id/dot_tc"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_row="0"
                    android:layout_column="1"
                    android:layout_margin="3dp"
                    android:background="#000000"
                    android:visibility="invisible" />

                <View
                    android:id="@+id/dot_tr"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_row="0"
                    android:layout_column="2"
                    android:layout_margin="3dp"
                    android:background="#000000"
                    android:visibility="invisible" />

                <!-- Row 1 -->
                <View
                    android:id="@+id/dot_ml"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_row="1"
                    android:layout_column="0"
                    android:layout_margin="3dp"
                    android:background="#000000"
                    android:visibility="invisible" />

                <View
                    android:id="@+id/dot_mc"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_row="1"
                    android:layout_column="1"
                    android:layout_margin="3dp"
                    android:background="#000000"
                    android:visibility="visible" />

                <View
                    android:id="@+id/dot_mr"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_row="1"
                    android:layout_column="2"
                    android:layout_margin="3dp"
                    android:background="#000000"
                    android:visibility="invisible" />

                <!-- Row 2 -->
                <View
                    android:id="@+id/dot_bl"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_row="2"
                    android:layout_column="0"
                    android:layout_margin="3dp"
                    android:background="#000000"
                    android:visibility="invisible" />

                <View
                    android:id="@+id/dot_bc"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_row="2"
                    android:layout_column="1"
                    android:layout_margin="3dp"
                    android:background="#000000"
                    android:visibility="invisible" />

                <View
                    android:id="@+id/dot_br"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_row="2"
                    android:layout_column="2"
                    android:layout_margin="3dp"
                    android:background="#000000"
                    android:visibility="invisible" />
            </GridLayout>
        </RelativeLayout>

        <TextView
            android:id="@+id/tv_roll_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap Dice to Roll"
            android:textColor="#EEEEEE"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>