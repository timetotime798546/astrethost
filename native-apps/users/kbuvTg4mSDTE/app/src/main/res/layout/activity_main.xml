<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F9F9">

    <!-- Header bar -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#1976D2"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cloud Notes"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="LOGOUT"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:background="#1565C0"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Search & Statistics Bar -->
    <LinearLayout
        android:id="@+id/searchStatsBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/headerBar"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#FFFFFF"
        android:elevation="2dp">

        <!-- Search box -->
        <EditText
            android:id="@+id/searchEditText"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:hint="Search title or content..."
            android:textSize="14sp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:background="@android:drawable/editbox_background_normal"
            android:singleLine="true"
            android:layout_marginBottom="10dp"/>

        <!-- Horizontal Scroll Category filter -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/catAll"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="ALL"
                    android:textSize="11sp"
                    android:layout_marginRight="6dp"
                    android:background="#1976D2"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/catWork"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="WORK"
                    android:textSize="11sp"
                    android:layout_marginRight="6dp"
                    android:background="#E0E0E0"
                    android:textColor="#333333" />

                <Button
                    android:id="@+id/catPersonal"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="PERSONAL"
                    android:textSize="11sp"
                    android:layout_marginRight="6dp"
                    android:background="#E0E0E0"
                    android:textColor="#333333" />

                <Button
                    android:id="@+id/catIdeas"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="IDEAS"
                    android:textSize="11sp"
                    android:layout_marginRight="6dp"
                    android:background="#E0E0E0"
                    android:textColor="#333333" />

                <Button
                    android:id="@+id/catOther"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="OTHER"
                    android:textSize="11sp"
                    android:background="#E0E0E0"
                    android:textColor="#333333" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Stats Counter Section (MANDATORY LOCAL CALCULATION DISPLAY) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#F5F5F5"
            android:padding="8dp">

            <TextView
                android:id="@+id/statsNotesCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Notes: 0"
                android:textColor="#424242"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statsWordsCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total Words: 0"
                android:textColor="#424242"
                android:gravity="right"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Notes list container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/searchStatsBar">

        <ListView
            android:id="@+id/notesListView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:padding="12dp"
            android:clipToPadding="false" />

        <TextView
            android:id="@+id/emptyStateView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="No notes found.\nClick '+' to add your first note!"
            android:textColor="#9E9E9E"
            android:textSize="16sp"
            android:gravity="center"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/mainProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Add Note Button (Custom Styled floating-action style) -->
    <Button
        android:id="@+id/btnAddNote"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentRight="true"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="20dp"
        android:text="+"
        android:textSize="28sp"
        android:textColor="#FFFFFF"
        android:background="#1976D2"
        android:elevation="6dp"/>
</RelativeLayout>