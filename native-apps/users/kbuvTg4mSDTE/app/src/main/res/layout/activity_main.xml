<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp">
        <Button
            android:id="@+id/btnHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HISTORY"
            android:textColor="@color/text_secondary"
            style="?android:attr/borderlessButtonStyle" />
        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
        <Button
            android:id="@+id/btnTheme"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="THEME"
            android:textColor="@color/text_secondary"
            style="?android:attr/borderlessButtonStyle" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:orientation="vertical"
        android:gravity="bottom|end"
        android:padding="24dp"
        android:background="@color/bg_display">

        <TextView
            android:id="@+id/tvExpression"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="20sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvDisplay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="64sp"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:columnCount="4"
        android:rowCount="5"
        android:padding="12dp"
        android:alignmentMode="alignBounds">

        <!-- Row 1 -->
        <Button android:id="@+id/btnC" android:text="C" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/btn_operator" android:textColor="@color/text_primary" />
        <Button android:id="@+id/btnDiv" android:text="/" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/btn_operator" android:textColor="@color/text_primary" />
        <Button android:id="@+id/btnMul" android:text="*" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/btn_operator" android:textColor="@color/text_primary" />
        <Button android:id="@+id/btnDel" android:text="⌫" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/btn_operator" android:textColor="@color/text_primary" />

        <!-- Row 2 -->
        <Button android:id="@+id/btn7" android:text="7" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/btn_numeric" android:textColor="@color/text_primary" />
        <Button android:id="@+id/btn8" android:text="8" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/btn_numeric" android:textColor="@color/text_primary" />
        <Button android:id="@+id/btn9" android:text="9" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/btn_numeric" android:textColor="@color/text_primary" />
        <Button android:id="@+id/btnSub" android:text="-" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/btn_operator" android:textColor="@color/text_primary" />

        <!-- Row 3 -->
        <Button android:id="@+id/btn4" android:text="4" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/btn_numeric" android:textColor="@color/text_primary" />
        <Button android:id="@+id/btn5" android:text="5" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/btn_numeric" android:textColor="@color/text_primary" />
        <Button android:id="@+id/btn6" android:text="6" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/btn_numeric" android:textColor="@color/text_primary" />
        <Button android:id="@+id/btnAdd" android:text="+" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/btn_operator" android:textColor="@color/text_primary" />

        <!-- Row 4 -->
        <Button android:id="@+id/btn1" android:text="1" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/btn_numeric" android:textColor="@color/text_primary" />
        <Button android:id="@+id/btn2" android:text="2" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/btn_numeric" android:textColor="@color/text_primary" />
        <Button android:id="@+id/btn3" android:text="3" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/btn_numeric" android:textColor="@color/text_primary" />
        <Button android:id="@+id/btnEqual" android:text="=" android:layout_columnWeight="1" android:layout_rowSpan="2" android:layout_gravity="fill" android:layout_margin="4dp" android:background="@drawable/btn_action" android:textColor="@color/text_primary" />

        <!-- Row 5 -->
        <Button android:id="@+id/btn0" android:text="0" android:layout_columnWeight="2" android:layout_columnSpan="2" android:layout_margin="4dp" android:background="@drawable/btn_numeric" android:textColor="@color/text_primary" />
        <Button android:id="@+id/btnDot" android:text="." android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/btn_numeric" android:textColor="@color/text_primary" />

    </GridLayout>
</LinearLayout>