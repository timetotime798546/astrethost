<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FA">

    <!-- Header bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#3F51B5"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="Offline AI Mind"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:background="#81C784"
            android:paddingLeft="8dp"
            android:paddingTop="4dp"
            android:paddingRight="8dp"
            android:paddingBottom="4dp"
            android:text="100% OFFLINE CORE"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Navigation tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:elevation="2dp">

        <Button
            android:id="@+id/btnTabChat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="AI Chatbot"
            android:textColor="#3F51B5"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="?android:attr/selectableItemBackground" />

        <Button
            android:id="@+id/btnTabTrain"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Train Brain"
            android:textColor="#757575"
            android:textSize="12sp"
            android:textStyle="normal"
            android:background="?android:attr/selectableItemBackground" />

        <Button
            android:id="@+id/btnTabLab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="AI Lab Tools"
            android:textColor="#757575"
            android:textSize="12sp"
            android:textStyle="normal"
            android:background="?android:attr/selectableItemBackground" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0" />

    <!-- Frame for tabs -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Tab 1: Chatbot layout -->
        <LinearLayout
            android:id="@+id/layoutChatContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="visible"
            android:padding="12dp">

            <ScrollView
                android:id="@+id/chatScrollView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="10dp"
                android:scrollbars="vertical">

                <LinearLayout
                    android:id="@+id/chatHistoryContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etChatInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Ask or teach your offline AI mind..."
                    android:textColor="#212121"
                    android:textSize="15sp"
                    android:background="@drawable/et_background"
                    android:layout_marginRight="8dp"
                    android:imeOptions="actionSend"
                    android:inputType="textShortMessage" />

                <Button
                    android:id="@+id/btnChatSend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Send"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:background="@drawable/btn_primary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tab 2: Train Brain layout -->
        <ScrollView
            android:id="@+id/layoutTrainContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Program Synaptic Pathways"
                    android:textColor="#3F51B5"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Directly code triggers and answers into this AI's local database. It matches the triggers when speaking with you."
                    android:textColor="#616161"
                    android:textSize="13sp"
                    android:layout_marginBottom="20dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="User Input Keyword (Lowercase):"
                    android:textColor="#212121"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etTrigger"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g. favorite drink"
                    android:textSize="15sp"
                    android:background="@drawable/et_background"
                    android:layout_marginBottom="16dp"
                    android:inputType="text" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="AI Reply Message:"
                    android:textColor="#212121"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etResponse"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g. I run on electricity, but I love cool files!"
                    android:textSize="15sp"
                    android:background="@drawable/et_background"
                    android:layout_marginBottom="20dp"
                    android:inputType="text" />

                <Button
                    android:id="@+id/btnTrainBrain"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Fuse Cognitive Synapse"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:background="@drawable/btn_primary"
                    android:layout_marginBottom="30dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Currently Trained Core Connections"
                    android:textColor="#3F51B5"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:id="@+id/brainListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#FAFAFA"
                    android:padding="8dp" />
            </LinearLayout>
        </ScrollView>

        <!-- Tab 3: AI Lab Tools layout -->
        <ScrollView
            android:id="@+id/layoutLabContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Sentiment Engine Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#FFFFFF"
                    android:padding="16dp"
                    android:elevation="2dp"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tool 1: Sentiment Predictive Engine"
                        android:textColor="#3F51B5"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Local lexicon parser extracts and counts emotional nodes to evaluate raw psychological weight."
                        android:textColor="#757575"
                        android:textSize="12sp"
                        android:layout_marginBottom="12dp" />

                    <EditText
                        android:id="@+id/etSentimentInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Type custom sentiments, e.g. I am having an amazing, great day..."
                        android:textSize="14sp"
                        android:background="@drawable/et_background"
                        android:layout_marginBottom="12dp"
                        android:inputType="text" />

                    <Button
                        android:id="@+id/btnAnalyzeSentiment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Execute Core Analytics"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/btn_primary"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tvSentimentResult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Awaiting text analysis sequence..."
                        android:textColor="#424242"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Procedural Art Generator Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#FFFFFF"
                    android:padding="16dp"
                    android:elevation="2dp"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tool 2: Generative Pixel Art Generator"
                        android:textColor="#3F51B5"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Generates responsive 16x16 symmetric retro-sprite graphic templates entirely offline using prompt seed hashes."
                        android:textColor="#757575"
                        android:textSize="12sp"
                        android:layout_marginBottom="12dp" />

                    <EditText
                        android:id="@+id/etArtPrompt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Try: space star, green forest, fire dragon..."
                        android:textSize="14sp"
                        android:background="@drawable/et_background"
                        android:layout_marginBottom="12dp"
                        android:inputType="text" />

                    <Button
                        android:id="@+id/btnGenerateArt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Generate Procedural Sprite"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/btn_primary"
                        android:layout_marginBottom="16dp" />

                    <ImageView
                        android:id="@+id/ivArtOutput"
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:layout_gravity="center"
                        android:background="#E0E0E0"
                        android:scaleType="fitCenter"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="The visual matrix uses custom mathematical seeding algorithms to render local sprite assets."
                        android:textColor="#9E9E9E"
                        android:textSize="11sp"
                        android:gravity="center" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </FrameLayout>

</LinearLayout>