<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- The 3D GL Viewport Container -->
    <FrameLayout
        android:id="@+id/gl_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Game HUD Overlay -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <!-- Top Panel (Scores & Speedometer) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_alignParentTop="true"
            android:weightSum="3">

            <!-- Dynamic Speed Display -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 MPH"
                    android:textColor="#FFEB3B"
                    android:textSize="28sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tv_gear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GEAR: N"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Score View -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SCORE: 00000"
                    android:textColor="#00FFCC"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Best Score / Distance View -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_best_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BEST: 00000"
                    android:textColor="#FF3D00"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom Responsive Dashboard Controls -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_alignParentBottom="true">

            <!-- Left / Right Steering Buttons (Bottom Left) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentLeft="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_left"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@android:drawable/ic_media_previous"
                    android:backgroundTint="#80FFFFFF"
                    android:text="" />

                <View
                    android:layout_width="20dp"
                    android:layout_height="match_parent" />

                <Button
                    android:id="@+id/btn_right"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@android:drawable/ic_media_next"
                    android:backgroundTint="#80FFFFFF"
                    android:text="" />
            </LinearLayout>

            <!-- Gas / Brake Pedals (Bottom Right) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Brake Pedal -->
                <Button
                    android:id="@+id/btn_brake"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@android:drawable/btn_default_small"
                    android:backgroundTint="#E53935"
                    android:text="BRAKE"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="12sp" />

                <View
                    android:layout_width="20dp"
                    android:layout_height="match_parent" />

                <!-- Gas Pedal -->
                <Button
                    android:id="@+id/btn_gas"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:background="@android:drawable/btn_default_small"
                    android:backgroundTint="#4CAF50"
                    android:text="GAS"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="16sp" />
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>

    <!-- Start / Collision Game Over Overlay Screen -->
    <LinearLayout
        android:id="@+id/overlay_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D9000000"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible">

        <TextView
            android:id="@+id/tv_overlay_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="REAL 3D RACER"
            android:textColor="#00FFCC"
            android:textSize="42sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/tv_overlay_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Steer, shift, speed past traffic! Dodge other cars."
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="30dp" />

        <Button
            android:id="@+id/btn_start"
            android:layout_width="200dp"
            android:layout_height="60dp"
            android:backgroundTint="#FF9800"
            android:text="START DRIVE"
            android:textColor="#000"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>