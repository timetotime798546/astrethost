<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_display_dark"
    android:weightSum="10">

    <!-- Screen Output / Results Pane -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3.5"
        android:orientation="vertical"
        android:gravity="bottom|end"
        android:padding="24dp">

        <!-- History / Mathematical Input Formula View -->
        <HorizontalScrollView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:fillViewport="true"
            android:scrollbars="none">

            <TextView
                android:id="@+id/tv_formula"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/text_formula"
                android:textSize="36sp"
                android:fontFamily="sans-serif-light"
                android:singleLine="true" />
        </HorizontalScrollView>

        <!-- Live Preview / Evaluated Answer View -->
        <TextView
            android:id="@+id/tv_preview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_preview"
            android:textSize="28sp"
            android:fontFamily="sans-serif"
            android:singleLine="true" />

    </LinearLayout>

    <!-- Interactive Keypad Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="6.5"
        android:background="@color/bg_keypad_dark"
        android:orientation="vertical"
        android:padding="16dp"
        android:weightSum="5">

        <!-- ROW 1: Clear, Open Paren, Close Paren, Backspace/Delete -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp"
            android:weightSum="4">

            <Button
                android:id="@+id/btn_clear"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/btn_action_bg"
                android:text="C"
                android:textAllCaps="false"
                android:textColor="@color/color_delete_text"
                android:textSize="22sp"
                android:fontFamily="sans-serif-medium" />

            <Button
                android:id="@+id/btn_paren_open"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/btn_action_bg"
                android:text="("
                android:textAllCaps="false"
                android:textColor="@color/color_action_text"
                android:textSize="22sp"
                android:fontFamily="sans-serif-medium" />

            <Button
                android:id="@+id/btn_paren_close"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/btn_action_bg"
                android:text=")"
                android:textAllCaps="false"
                android:textColor="@color/color_action_text"
                android:textSize="22sp"
                android:fontFamily="sans-serif-medium" />

            <Button
                android:id="@+id/btn_delete"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/btn_action_bg"
                android:text="⌫"
                android:textAllCaps="false"
                android:textColor="@color/color_delete_text"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- ROW 2: 7, 8, 9, Division -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp"
            android:weightSum="4">

            <Button
                android:id="@+id/btn_7"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/btn_numeric_bg"
                android:text="7"
                android:textColor="@color/color_numeric_text"
                android:textSize="24sp"
                android:fontFamily="sans-serif-light" />

            <Button
                android:id="@+id/btn_8"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/btn_numeric_bg"
                android:text="8"
                android:textColor="@color/color_numeric_text"
                android:textSize="24sp"
                android:fontFamily="sans-serif-light" />

            <Button
                android:id="@+id/btn_9"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/btn_numeric_bg"
                android:text="9"
                android:textColor="@color/color_numeric_text"
                android:textSize="24sp"
                android:fontFamily="sans-serif-light" />

            <Button
                android:id="@+id/btn_div"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/btn_operator_bg"
                android:text="÷"
                android:textColor="@color/color_operator_text"
                android:textSize="26sp" />
        </LinearLayout>

        <!-- ROW 3: 4, 5, 6, Multiplication -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp"
            android:weightSum="4">

            <Button
                android:id="@+id/btn_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/btn_numeric_bg"
                android:text="4"
                android:textColor="@color/color_numeric_text"
                android:textSize="24sp"
                android:fontFamily="sans-serif-light" />

            <Button
                android:id="@+id/btn_5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/btn_numeric_bg"
                android:text="5"
                android:textColor="@color/color_numeric_text"
                android:textSize="24sp"
                android:fontFamily="sans-serif-light" />

            <Button
                android:id="@+id/btn_6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/btn_numeric_bg"
                android:text="6"
                android:textColor="@color/color_numeric_text"
                android:textSize="24sp"
                android:fontFamily="sans-serif-light" />

            <Button
                android:id="@+id/btn_mul"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/btn_operator_bg"
                android:text="×"
                android:textColor="@color/color_operator_text"
                android:textSize="26sp" />
        </LinearLayout>

        <!-- ROW 4: 1, 2, 3, Subtraction -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp"
            android:weightSum="4">

            <Button
                android:id="@+id/btn_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/btn_numeric_bg"
                android:text="1"
                android:textColor="@color/color_numeric_text"
                android:textSize="24sp"
                android:fontFamily="sans-serif-light" />

            <Button
                android:id="@+id/btn_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/btn_numeric_bg"
                android:text="2"
                android:textColor="@color/color_numeric_text"
                android:textSize="24sp"
                android:fontFamily="sans-serif-light" />

            <Button
                android:id="@+id/btn_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/btn_numeric_bg"
                android:text="3"
                android:textColor="@color/color_numeric_text"
                android:textSize="24sp"
                android:fontFamily="sans-serif-light" />

            <Button
                android:id="@+id/btn_sub"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/btn_operator_bg"
                android:text="−"
                android:textColor="@color/color_operator_text"
                android:textSize="26sp" />
        </LinearLayout>

        <!-- ROW 5: Decimal, 0, Percent, Addition/Equal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:weightSum="4">

            <Button
                android:id="@+id/btn_dot"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/btn_numeric_bg"
                android:text="."
                android:textColor="@color/color_numeric_text"
                android:textSize="24sp"
                android:fontFamily="sans-serif-medium" />

            <Button
                android:id="@+id/btn_0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/btn_numeric_bg"
                android:text="0"
                android:textColor="@color/color_numeric_text"
                android:textSize="24sp"
                android:fontFamily="sans-serif-light" />

            <Button
                android:id="@+id/btn_percent"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/btn_action_bg"
                android:text="%"
                android:textColor="@color/color_action_text"
                android:textSize="22sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:weightSum="2">

                <Button
                    android:id="@+id/btn_add"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:layout_marginBottom="2dp"
                    android:background="@drawable/btn_operator_bg"
                    android:text="+"
                    android:textColor="@color/color_operator_text"
                    android:textSize="20sp" />

                <Button
                    android:id="@+id/btn_equal"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/btn_equal_bg"
                    android:text="="
                    android:textColor="@color/color_operator_text"
                    android:textSize="20sp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>