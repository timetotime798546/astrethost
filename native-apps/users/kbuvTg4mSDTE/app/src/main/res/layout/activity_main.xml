<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05050F">

    <!-- The interactive 3D rendering game Canvas -->
    <com.neonsphererun.app.GameView
        android:id="@+id/game_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Heads-Up Display (HUD) layer -->
    <RelativeLayout
        android:id="@+id/hud_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/score_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:fontFamily="sans-serif-condensed"
            android:text="DISTANCE: 0m"
            android:textColor="#00F3FF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/speed_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:fontFamily="sans-serif-condensed"
            android:text="SPEED: 1.0x"
            android:textColor="#39FF14"
            android:textSize="22sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Main Entry Menu Screen -->
    <LinearLayout
        android:id="@+id/menu_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#DD070714"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="30dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:text="NEON SPHERE"
            android:textColor="#00F3FF"
            android:textSize="45sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-5dp"
            android:fontFamily="sans-serif-condensed"
            android:text="RUN"
            android:textColor="#FF007F"
            android:textSize="45sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-light"
            android:text="Endless 3D Cyber Run"
            android:textColor="#A0A0C0"
            android:textSize="16sp" />

        <!-- High Score board -->
        <TextView
            android:id="@+id/menu_high_score_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:fontFamily="sans-serif-condensed"
            android:text="RECORD: 0m"
            android:textColor="#39FF14"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Sensitivity Controller -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-condensed"
                android:text="STEERING SENSITIVITY"
                android:textColor="#A0A0C0"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/sensitivity_seekbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progress="50" />
        </LinearLayout>

        <Button
            android:id="@+id/start_button"
            android:layout_width="220dp"
            android:layout_height="60dp"
            android:layout_marginTop="40dp"
            android:background="#FF007F"
            android:fontFamily="sans-serif-condensed"
            android:text="LAUNCH SPHERE"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2"
            android:text="Drag left or right to steer. Avoid the neon wireframe gates. Speed increases with distance!"
            android:textColor="#606080"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Game Over Panel Screen -->
    <LinearLayout
        android:id="@+id/game_over_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#EE140A1A"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="30dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:text="CONNECTION LOST"
            android:textColor="#FF007F"
            android:textSize="38sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:text="SPHERE CRASHED"
            android:textColor="#FF007F"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/new_high_score_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#39FF14"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="NEW RECORD BREAK!"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/game_over_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:fontFamily="sans-serif-condensed"
            android:text="DISTANCE: 0m"
            android:textColor="#00F3FF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/game_over_highscore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="sans-serif-light"
            android:text="BEST RECORD: 0m"
            android:textColor="#A0A0C0"
            android:textSize="18sp" />

        <Button
            android:id="@+id/restart_button"
            android:layout_width="220dp"
            android:layout_height="60dp"
            android:layout_marginTop="40dp"
            android:background="#00F3FF"
            android:fontFamily="sans-serif-condensed"
            android:text="REBOOT RUN"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>