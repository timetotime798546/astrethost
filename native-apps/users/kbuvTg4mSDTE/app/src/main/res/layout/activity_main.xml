<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D0821"
    android:padding="16dp">

    <!-- App Header -->
    <TextView
        android:id="@+id/app_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/title_magic"
        android:textColor="#FFD700"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/subtitle_magic"
        android:textColor="#9C97B0"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- Tab Buttons Layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btn_tab_oracle"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/tab_selected_bg"
            android:text="@string/tab_oracle"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_tab_reader"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/tab_unselected_bg"
            android:text="@string/tab_reader"
            android:textColor="#9C97B0"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_tab_wand"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/tab_unselected_bg"
            android:text="@string/tab_wand"
            android:textColor="#9C97B0"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main Container Frame -->
    <FrameLayout
        android:id="@+id/content_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 1. Magic 8-Ball Container -->
        <ScrollView
            android:id="@+id/container_oracle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ask any Yes/No question, then tap the Magic 8-Ball or shake your phone!"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:layout_marginBottom="16dp" />

                <EditText
                    android:id="@+id/et_question"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="Type your destiny question..."
                    android:textColorHint="#9C97B0"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/card_bg"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:layout_marginBottom="24dp"
                    android:singleLine="true" />

                <!-- Glow Oracle Sphere -->
                <RelativeLayout
                    android:id="@+id/ball_layout"
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:background="@drawable/circle_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_gravity="center"
                    android:layout_marginBottom="24dp">

                    <TextView
                        android:id="@+id/tv_ball_answer"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="Tap\nTo See\nYour Fate"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_margin="20dp"
                        android:shadowColor="#000"
                        android:shadowDx="2"
                        android:shadowDy="2"
                        android:shadowRadius="3"
                        android:textSize="18sp" />
                </RelativeLayout>

                <Button
                    android:id="@+id/btn_cast_oracle"
                    android:layout_width="200dp"
                    android:layout_height="48dp"
                    android:background="@drawable/button_glow"
                    android:text="INVOKE DESTINY"
                    android:textColor="#0D0821"
                    android:textStyle="bold" />
            </LinearLayout>
        </ScrollView>

        <!-- 2. Mind Reader Container -->
        <ScrollView
            android:id="@+id/container_reader"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/card_bg"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tv_reader_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="THE MIND READER"
                    android:textColor="#FFD700"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tv_reader_step_num"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STEP 1 OF 6"
                    android:textColor="#00FFFF"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/tv_reader_instruction"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:text="Think of any secret integer between 1 and 10.\n\nKeep it safe in your mind."
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:gravity="center"
                    android:layout_marginBottom="24dp" />

                <Button
                    android:id="@+id/btn_reader_next"
                    android:layout_width="180dp"
                    android:layout_height="48dp"
                    android:background="@drawable/button_glow"
                    android:text="CONTINUE"
                    android:textColor="#0D0821"
                    android:textStyle="bold" />
            </LinearLayout>
        </ScrollView>

        <!-- 3. Magic Wand Container -->
        <RelativeLayout
            android:id="@+id/container_wand"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <!-- Particle Engine background and interaction layer -->
            <com.magicwandoracle.app.MagicParticleView
                android:id="@+id/particle_canvas"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_alignParentTop="true"
                android:layout_marginTop="20dp"
                android:clickable="false"
                android:focusable="false">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ MAGIC SPELL DECK ⚡"
                    android:textColor="#00FFFF"
                    android:textStyle="bold"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap screen to spawn particles or wave your device to summon magical energy."
                    android:textColor="#9C97B0"
                    android:gravity="center"
                    android:layout_marginTop="8dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:textSize="12sp" />
            </LinearLayout>
        </RelativeLayout>
    </FrameLayout>
</LinearLayout>