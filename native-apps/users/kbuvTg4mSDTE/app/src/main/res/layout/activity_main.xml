<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:keepScreenOn="true">

    <LinearLayout
        android:id="@+id/layout_dashboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_above="@+id/layout_tabs">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LUXE LIGHT"
                android:textColor="@color/text_white"
                android:textSize="24sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Professional Lighting Suite"
                android:textColor="@color/text_gray"
                android:textSize="12sp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="16dp">

            <!-- TORCH TAB VIEW -->
            <ScrollView
                android:id="@+id/view_torch"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="24dp">

                        <Button
                            android:id="@+id/btn_power"
                            android:layout_width="140dp"
                            android:layout_height="140dp"
                            android:background="@drawable/btn_round_off"
                            android:text="OFF"
                            android:textColor="@color/text_white"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <!-- STROBE CARD -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/card_background"
                        android:padding="16dp"
                        android:layout_marginBottom="16dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Strobe Light"
                                android:textColor="@color/text_white"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <ToggleButton
                                android:id="@+id/toggle_strobe"
                                android:layout_width="80dp"
                                android:layout_height="36dp"
                                android:layout_alignParentEnd="true"
                                android:textOn="ON"
                                android:textOff="OFF" />
                        </RelativeLayout>

                        <TextView
                            android:id="@+id/txt_strobe_freq"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Frequency: 5 Hz"
                            android:textColor="@color/text_gray"
                            android:layout_marginTop="8dp" />

                        <SeekBar
                            android:id="@+id/seek_strobe"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:max="19"
                            android:progress="4" />
                    </LinearLayout>

                    <!-- SOS CARD -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/card_background"
                        android:padding="16dp"
                        android:layout_marginBottom="16dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="SOS Distress Mode"
                                    android:textColor="@color/text_white"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Continuous Morse SOS pattern"
                                    android:textColor="@color/text_gray"
                                    android:textSize="12sp"
                                    android:layout_marginTop="2dp"/>
                            </LinearLayout>

                            <ToggleButton
                                android:id="@+id/toggle_sos"
                                android:layout_width="80dp"
                                android:layout_height="36dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:textOn="SOS"
                                android:textOff="OFF" />
                        </RelativeLayout>
                    </LinearLayout>

                </LinearLayout>
            </ScrollView>

            <!-- SCREEN LIGHT TAB VIEW -->
            <ScrollView
                android:id="@+id/view_screen_light"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Screen Light Color Panel"
                        android:textColor="@color/text_white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp" />

                    <!-- COLOR SELECTION -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/card_background"
                        android:padding="16dp"
                        android:layout_marginBottom="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:layout_marginBottom="12dp">

                            <Button
                                android:id="@+id/btn_color_white"
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:background="#FFFFFF"
                                android:layout_margin="6dp" />

                            <Button
                                android:id="@+id/btn_color_yellow"
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:background="#FFEB3B"
                                android:layout_margin="6dp" />

                            <Button
                                android:id="@+id/btn_color_orange"
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:background="#FF9800"
                                android:layout_margin="6dp" />

                            <Button
                                android:id="@+id/btn_color_red"
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:background="#E53935"
                                android:layout_margin="6dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center">

                            <Button
                                android:id="@+id/btn_color_green"
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:background="#4CAF50"
                                android:layout_margin="6dp" />

                            <Button
                                android:id="@+id/btn_color_cyan"
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:background="#00BCD4"
                                android:layout_margin="6dp" />

                            <Button
                                android:id="@+id/btn_color_blue"
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:background="#2196F3"
                                android:layout_margin="6dp" />

                            <Button
                                android:id="@+id/btn_color_purple"
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:background="#9C27B0"
                                android:layout_margin="6dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- BRIGHTNESS SLIDER -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/card_background"
                        android:padding="16dp"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:id="@+id/txt_brightness"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Screen Brightness: 100%"
                            android:textColor="@color/text_white"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <SeekBar
                            android:id="@+id/seek_brightness"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:max="100"
                            android:progress="100" />
                    </LinearLayout>

                    <!-- LIVE PREVIEW AREA -->
                    <LinearLayout
                        android:id="@+id/panel_color_preview"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="#FFFFFF"
                        android:layout_marginBottom="16dp">

                        <Button
                            android:id="@+id/btn_fullscreen_beam"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LAUNCH FULLSCREEN"
                            android:background="#121212"
                            android:textColor="@color/text_white"
                            android:paddingLeft="16dp"
                            android:paddingRight="16dp"
                            android:layout_margin="8dp" />
                    </LinearLayout>

                </LinearLayout>
            </ScrollView>

            <!-- PARTY DISCO TAB VIEW -->
            <ScrollView
                android:id="@+id/view_party"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Disco Light Party Mode"
                        android:textColor="@color/text_white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp" />

                    <!-- DISCO VISUALIZER PREVIEW -->
                    <View
                        android:id="@+id/view_disco_visualizer"
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:background="#E53935"
                        android:layout_marginBottom="16dp" />

                    <!-- DISCO SPEED CARD -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/card_background"
                        android:padding="16dp"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:id="@+id/txt_party_speed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Disco Pulse Speed: Standard"
                            android:textColor="@color/text_white"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <SeekBar
                            android:id="@+id/seek_party_speed"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:max="4"
                            android:progress="2" />
                    </LinearLayout>

                    <!-- SYNC WITH CAMERA FLASH CARD -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/card_background"
                        android:padding="16dp"
                        android:layout_marginBottom="16dp">

                        <CheckBox
                            android:id="@+id/check_sync_flash"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Sync Physical Torch Flash"
                            android:textColor="@color/text_white"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <!-- START PARTY TRIGGER -->
                    <Button
                        android:id="@+id/btn_party_start"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:text="START PARTY"
                        android:textStyle="bold"
                        android:textColor="@color/text_white"
                        android:background="#4CAF50"
                        android:layout_marginBottom="24dp" />

                </LinearLayout>
            </ScrollView>

        </FrameLayout>

    </LinearLayout>

    <!-- BOTTOM TAB BAR NAVIGATION -->
    <LinearLayout
        android:id="@+id/layout_tabs"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:layout_alignParentBottom="true"
        android:background="#1E1E1E"
        android:weightSum="3">

        <LinearLayout
            android:id="@+id/tab_torch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#2E2E2E"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/txt_tab_torch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔦 TORCH"
                android:textColor="@color/accent_gold"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_screen"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/txt_tab_screen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💡 SCREEN"
                android:textColor="@color/text_gray"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_party"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/txt_tab_party"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🪩 PARTY"
                android:textColor="@color/text_gray"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <!-- FULLSCREEN OVERLAY BEAM -->
    <RelativeLayout
        android:id="@+id/layout_fullscreen_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TAP ANYWHERE TO RETURN"
            android:textColor="#80000000"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_centerInParent="true" />
    </RelativeLayout>

</RelativeLayout>