<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Custom Header Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#3F51B5"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dashboard"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_centerVertical="true"/>

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Logout"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:background="#00000000"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Study Statistics Summary Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@android:drawable/dialog_holo_light_frame"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Study Progress Tracking"
                    android:textStyle="bold"
                    android:textColor="#3F51B5"
                    android:textSize="16sp"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvTotalStudyHours"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.0h"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="#2196F3"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Study"
                            android:textSize="11sp"
                            android:textColor="#727272"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvCompletedTasks"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0/0"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="#4CAF50"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tasks Done"
                            android:textSize="11sp"
                            android:textColor="#727272"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvProgressRate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="#FF9800"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Comp. Rate"
                            android:textSize="11sp"
                            android:textColor="#727272"/>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvProgressInterpretation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Let's start study planning! Click Manage Subjects below to get configured."
                    android:textSize="12sp"
                    android:textColor="#424242"
                    android:gravity="center"
                    android:paddingTop="6dp"/>
            </LinearLayout>

            <!-- Menu Navigation Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btnManageSubjects"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Manage Subjects"
                    android:background="#3F51B5"
                    android:textColor="#FFFFFF"
                    android:layout_marginRight="6dp"
                    android:padding="12dp"
                    android:textSize="12sp"/>

                <Button
                    android:id="@+id/btnManageTasks"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Manage Tasks"
                    android:background="#00BCD4"
                    android:textColor="#FFFFFF"
                    android:layout_marginLeft="6dp"
                    android:padding="12dp"
                    android:textSize="12sp"/>
            </LinearLayout>

            <!-- Upcoming Study Plan List -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@android:drawable/dialog_holo_light_frame"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Upcoming Reminders &amp; Tasks"
                    android:textStyle="bold"
                    android:textColor="#3F51B5"
                    android:textSize="15sp"
                    android:layout_marginBottom="8dp"/>

                <ListView
                    android:id="@+id/lvUpcomingTasks"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    android:divider="#E0E0E0"
                    android:dividerHeight="1dp"/>

                <TextView
                    android:id="@+id/tvNoUpcomingTasks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No tasks pending. Start your path to success!"
                    android:textColor="#9E9E9E"
                    android:gravity="center"
                    android:layout_marginVertical="24dp"
                    android:visibility="gone"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>