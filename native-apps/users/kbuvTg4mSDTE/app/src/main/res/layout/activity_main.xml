<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#09090E"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NATIVE 3D UI ENGINE"
                android:textColor="#00E676"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.15" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3D UI Sandbox Lab"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/fpsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="60 FPS"
            android:textColor="#88888F"
            android:textSize="12sp"
            android:background="#161622"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/tabCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3D Interactive Card"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:background="#1A8CFF"
                android:layout_marginRight="8dp"
                android:textAllCaps="false"
                style="?android:attr/buttonStyleSmall" />

            <Button
                android:id="@+id/tabCube"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3D Polyhedrons"
                android:textColor="#88888F"
                android:textSize="12sp"
                android:background="#161622"
                android:layout_marginRight="8dp"
                android:textAllCaps="false"
                style="?android:attr/buttonStyleSmall" />

            <Button
                android:id="@+id/tabSphere"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3D Sphere Cloud"
                android:textColor="#88888F"
                android:textSize="12sp"
                android:background="#161622"
                android:textAllCaps="false"
                style="?android:attr/buttonStyleSmall" />
        </LinearLayout>
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:background="#12121A"
        android:layout_marginBottom="12dp">

        <FrameLayout
            android:id="@+id/containerCardView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="24dp"
            android:visibility="visible">

            <com.threeduilab.app.ThreeDCardView
                android:id="@+id/threeDCardView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center">

                <LinearLayout
                    android:id="@+id/cardInnerLayout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#1A1A2F"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:elevation="8dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AETHER CO."
                            android:textColor="#00E676"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"
                            android:text="NATIVE 3D"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="20dp"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="45dp"
                            android:layout_height="32dp"
                            android:background="#E5A93C" />

                        <View
                            android:layout_width="16dp"
                            android:layout_height="1dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=")))"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/cardNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4532  8890  1204  7651"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:letterSpacing="0.15"
                        android:layout_marginBottom="16dp"
                        android:fontFamily="monospace" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CARD HOLDER"
                                android:textColor="#88888F"
                                android:textSize="8sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ALEXANDER VANE"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"
                            android:orientation="vertical"
                            android:gravity="right">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="EXPIRES"
                                android:textColor="#88888F"
                                android:textSize="8sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="12 / 29"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </RelativeLayout>
                </LinearLayout>

            </com.threeduilab.app.ThreeDCardView>
        </FrameLayout>

        <com.threeduilab.app.ThreeDCubeView
            android:id="@+id/threeDCubeView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#12121A"
            android:padding="12dp">

            <TextView
                android:id="@+id/controlTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3D Card Parameters"
                android:textColor="#88888F"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:id="@+id/controlsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Auto-Floating / Tilt Loop"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                    <Switch
                        android:id="@+id/switchCardAuto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true" />
                </RelativeLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Maximum Tilt angle"
                    android:textColor="#88888F"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <SeekBar
                        android:id="@+id/seekCardTilt"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="40"
                        android:progress="25" />

                    <TextView
                        android:id="@+id/textCardTiltValue"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:gravity="right"
                        android:text="25°"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Perspective Camera Distance (Focal)"
                    android:textColor="#88888F"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <SeekBar
                        android:id="@+id/seekCardPersp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="25"
                        android:progress="10" /> 

                    <TextView
                        android:id="@+id/textCardPerspValue"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:gravity="right"
                        android:text="15"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/controlsPolyhedron"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/shapeSelectorGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <Button
                        android:id="@+id/btnCubeShape"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Cube"
                        android:textSize="11sp"
                        android:background="#1A8CFF"
                        android:textColor="#FFFFFF"
                        android:layout_marginRight="4dp"
                        style="?android:attr/buttonStyleSmall" />

                    <Button
                        android:id="@+id/btnPyramidShape"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Pyramid"
                        android:textSize="11sp"
                        android:background="#161622"
                        android:textColor="#88888F"
                        android:layout_marginRight="4dp"
                        style="?android:attr/buttonStyleSmall" />

                    <Button
                        android:id="@+id/btnOctaShape"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Octahedron"
                        android:textSize="11sp"
                        android:background="#161622"
                        android:textColor="#88888F"
                        style="?android:attr/buttonStyleSmall" />
                </LinearLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Auto-Spin Rotation"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                    <Switch
                        android:id="@+id/switchCubeSpin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:checked="true" />
                </RelativeLayout>

                <TextView
                    android:id="@+id/labelFaceTransparency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Face Opacity (Solid vs Wireframe)"
                    android:textColor="#88888F"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/rowFaceTransparency"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <SeekBar
                        android:id="@+id/seekFaceAlpha"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="255"
                        android:progress="100" />

                    <TextView
                        android:id="@+id/textFaceAlphaValue"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:gravity="right"
                        android:text="100"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Spin Speed Factor"
                    android:textColor="#88888F"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <SeekBar
                        android:id="@+id/seekCubeSpeed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="10"
                        android:progress="5" />

                    <TextView
                        android:id="@+id/textCubeSpeedValue"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:gravity="right"
                        android:text="1.0x"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#222232"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="System Theme Accent"
                android:textColor="#88888F"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnThemeNeon"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="Neon Green"
                    android:textSize="10sp"
                    android:background="#22FF80"
                    android:textColor="#000000"
                    android:layout_marginRight="4dp"
                    style="?android:attr/buttonStyleSmall" />

                <Button
                    android:id="@+id/btnThemeCosmic"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="Cosmic Blue"
                    android:textSize="10sp"
                    android:background="#0091EA"
                    android:textColor="#FFFFFF"
                    android:layout_marginRight="4dp"
                    style="?android:attr/buttonStyleSmall" />

                <Button
                    android:id="@+id/btnThemeGold"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="Laser Gold"
                    android:textSize="10sp"
                    android:background="#FFD700"
                    android:textColor="#000000"
                    android:layout_marginRight="4dp"
                    style="?android:attr/buttonStyleSmall" />

                <Button
                    android:id="@+id/btnThemeCyber"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="Cyber Red"
                    android:textSize="10sp"
                    android:background="#FF2D55"
                    android:textColor="#FFFFFF"
                    style="?android:attr/buttonStyleSmall" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>