<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B5E20"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!-- Game view rendering canvas -->
    <com.roadcrossing.app.GameView
        android:id="@+id/game_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Main Menu Overlay -->
    <LinearLayout
        android:id="@+id/menu_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#C0000000"
        android:visibility="visible"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ROAD CROSSING"
            android:textColor="#FFFFFF"
            android:textSize="36sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/menu_best_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Best Score: 0"
            android:textColor="#FFEB3B"
            android:textSize="20sp"
            android:layout_marginBottom="40dp" />

        <Button
            android:id="@+id/btn_play"
            android:layout_width="220dp"
            android:layout_height="55dp"
            android:text="PLAY"
            android:textSize="18sp"
            android:background="#4CAF50"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btn_how_to_play"
            android:layout_width="220dp"
            android:layout_height="55dp"
            android:text="HOW TO PLAY"
            android:textSize="18sp"
            android:background="#2196F3"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btn_quit"
            android:layout_width="220dp"
            android:layout_height="55dp"
            android:text="QUIT"
            android:textSize="18sp"
            android:background="#F44336"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- How To Play Overlay -->
    <LinearLayout
        android:id="@+id/how_to_play_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#F0111111"
        android:visibility="gone"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HOW TO PLAY"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1. Swipe UP, DOWN, LEFT, RIGHT or use the on-screen buttons to move.\n\n2. Avoid moving cars, taxis, and trucks on the road.\n\n3. Rest in the safe green grassy lanes.\n\n4. Travel as far as possible to get a high score!"
            android:textColor="#DDDDDD"
            android:textSize="16sp"
            android:lineSpacingMultiplier="1.2"
            android:layout_marginBottom="40dp" />

        <Button
            android:id="@+id/btn_how_to_play_back"
            android:layout_width="220dp"
            android:layout_height="55dp"
            android:text="BACK"
            android:textSize="18sp"
            android:background="#757575"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Game Over Overlay -->
    <LinearLayout
        android:id="@+id/game_over_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#D0B71C1C"
        android:visibility="gone"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GAME OVER"
            android:textColor="#FFFFFF"
            android:textSize="40sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/game_over_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Score: 0"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/game_over_best_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Best Score: 0"
            android:textColor="#FFEB3B"
            android:textSize="20sp"
            android:layout_marginBottom="40dp" />

        <Button
            android:id="@+id/btn_retry"
            android:layout_width="220dp"
            android:layout_height="55dp"
            android:text="RETRY"
            android:textSize="18sp"
            android:background="#4CAF50"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btn_home"
            android:layout_width="220dp"
            android:layout_height="55dp"
            android:text="HOME"
            android:textSize="18sp"
            android:background="#757575"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- HUD Overlay -->
    <RelativeLayout
        android:id="@+id/hud_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:clickable="false">

        <!-- Top Scores Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:layout_alignParentTop="true">

            <TextView
                android:id="@+id/hud_score"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SCORE: 0"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:shadowColor="#000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="2" />

            <TextView
                android:id="@+id/hud_best"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BEST: 0"
                android:textColor="#FFEB3B"
                android:textSize="20sp"
                android:textStyle="bold"
                android:shadowColor="#000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="2" />
        </LinearLayout>

        <!-- D-Pad Controllers (At Bottom) -->
        <RelativeLayout
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/btn_up"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:text="▲"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:background="#802196F3"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true" />

            <Button
                android:id="@+id/btn_left"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:text="◀"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:background="#802196F3"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true" />

            <Button
                android:id="@+id/btn_right"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:text="▶"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:background="#802196F3"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true" />

            <Button
                android:id="@+id/btn_down"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:text="▼"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:background="#802196F3"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true" />
        </RelativeLayout>
    </RelativeLayout>
</FrameLayout>