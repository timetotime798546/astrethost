<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F6F8">

    <!-- Header bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#2E3B4E"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <TextView
            android:id="@+id/appTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="Gmail SMTP Mailer"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:background="#1E88E5"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:text="SMTP Settings"
            android:paddingLeft="12dp"
            android:paddingRight="12dp" />
    </RelativeLayout>

    <!-- Config status line -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#EAECEE"
        android:orientation="horizontal"
        android:padding="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SMTP Sender: "
            android:textColor="#4A5568"
            android:textStyle="bold"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvCurrentSender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Not configured"
            android:textColor="#E53935"
            android:textSize="13sp"
            android:ellipsize="end"
            android:singleLine="true"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Card Layout Container for Input -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:elevation="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RECIPIENT EMAIL (TO)"
                    android:textColor="#718096"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <EditText
                    android:id="@+id/etRecipient"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="#EDF2F7"
                    android:inputType="textEmailAddress"
                    android:hint="receiver@example.com"
                    android:textColor="#2D3748"
                    android:padding="8dp"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SUBJECT"
                    android:textColor="#718096"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <EditText
                    android:id="@+id/etSubject"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="#EDF2F7"
                    android:inputType="text"
                    android:hint="Email Subject"
                    android:textColor="#2D3748"
                    android:padding="8dp"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MESSAGE BODY"
                    android:textColor="#718096"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <EditText
                    android:id="@+id/etBody"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:background="#EDF2F7"
                    android:gravity="top|left"
                    android:inputType="textMultiLine"
                    android:hint="Type your email body here..."
                    android:textColor="#2D3748"
                    android:padding="8dp"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btnSend"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="#2E3B4E"
                    android:text="SEND EMAIL"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:layout_marginTop="6dp"/>

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    android:visibility="gone"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>

            <!-- Console live log display header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SMTP PROTOCOL LOGS"
                android:textColor="#718096"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="6dp" />

            <!-- Logs container console -->
            <ScrollView
                android:id="@+id/svLogContainer"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:background="#1A202C"
                android:padding="10dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/tvLogs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mailer ready. Open Settings to configure Gmail parameters."
                    android:textColor="#48BB78"
                    android:textSize="12sp"
                    android:fontFamily="monospace" />
            </ScrollView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>