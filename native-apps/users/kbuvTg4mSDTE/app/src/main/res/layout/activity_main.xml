<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <!-- Top Hospital Header App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/teal_primary"
        android:padding="16dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CareSync Pro"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_header_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hospital Network &amp; Clinic Management"
                android:textColor="#CCFBF1"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_auth_action"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Sign In"
            android:textColor="#0D9488"
            android:background="@drawable/bg_card_rounded"
            android:textSize="12sp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp" />
    </LinearLayout>

    <!-- Navigation Tabs -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="#FFFFFF">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingLeft="8dp"
            android:paddingRight="8dp">

            <Button
                android:id="@+id/tab_dashboard"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Dashboard"
                android:textStyle="bold"
                android:textColor="@color/teal_primary"
                android:background="@android:color/transparent"
                android:paddingLeft="12dp"
                android:paddingRight="12dp" />

            <Button
                android:id="@+id/tab_patients"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Patient EHR"
                android:textColor="@color/text_secondary"
                android:background="@android:color/transparent"
                android:paddingLeft="12dp"
                android:paddingRight="12dp" />

            <Button
                android:id="@+id/tab_opd"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Appointments &amp; Rx"
                android:textColor="@color/text_secondary"
                android:background="@android:color/transparent"
                android:paddingLeft="12dp"
                android:paddingRight="12dp" />

            <Button
                android:id="@+id/tab_pharmacy"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Pharmacy Inventory"
                android:textColor="@color/text_secondary"
                android:background="@android:color/transparent"
                android:paddingLeft="12dp"
                android:paddingRight="12dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/surface_card_border" />

    <!-- Container for dynamic modular screens -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 1. Executive Dashboard Section -->
        <ScrollView
            android:id="@+id/view_dashboard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Executive Hospital Overview"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- 4 KPI Stat Widgets Grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <!-- Stat 1: Today's Appointments -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_stat_teal"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:layout_marginRight="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Appointments"
                            android:textColor="#CCFBF1"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tv_stat_appointments"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="18"
                            android:textColor="#FFFFFF"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Today scheduled"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Stat 2: Active Inpatients -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_stat_indigo"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:layout_marginLeft="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Active Inpatients"
                            android:textColor="#E0E7FF"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tv_stat_inpatients"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="42"
                            android:textColor="#FFFFFF"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ward Occupancy 84%"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <!-- Stat 3: Pending Lab Reports -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_stat_amber"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:layout_marginRight="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pending Labs"
                            android:textColor="#FEF3C7"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tv_stat_lab_reports"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="7"
                            android:textColor="#FFFFFF"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Action needed"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Stat 4: Pharmacy Revenue -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_stat_emerald"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:layout_marginLeft="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pharmacy Rev."
                            android:textColor="#D1FAE5"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tv_stat_pharmacy_revenue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$3,450"
                            android:textColor="#FFFFFF"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Today collected"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Quick Emergency Actions -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quick Emergency &amp; Clinical Actions"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <Button
                        android:id="@+id/btn_quick_new_patient"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="+ Patient"
                        android:textSize="12sp"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_button_primary"
                        android:layout_marginRight="4dp" />

                    <Button
                        android:id="@+id/btn_quick_book_apt"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="+ Appt"
                        android:textSize="12sp"
                        android:textColor="@color/indigo_primary"
                        android:background="@drawable/bg_card_rounded"
                        android:layout_marginRight="4dp" />

                    <Button
                        android:id="@+id/btn_quick_create_bill"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="Billing"
                        android:textSize="12sp"
                        android:textColor="@color/indigo_primary"
                        android:background="@drawable/bg_card_rounded"
                        android:layout_marginRight="4dp" />

                    <Button
                        android:id="@+id/btn_quick_prescribe"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="Prescribe"
                        android:textSize="12sp"
                        android:textColor="@color/indigo_primary"
                        android:background="@drawable/bg_card_rounded" />
                </LinearLayout>

                <!-- Patient Queue Status Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Live Patient Queue Status"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_queue_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3 in Queue"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/container_dashboard_queue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>
        </ScrollView>

        <!-- 2. Patient EHR & OPD Register View -->
        <LinearLayout
            android:id="@+id/view_patients"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="16dp">

            <!-- Search Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <EditText
                    android:id="@+id/et_patient_search"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:hint="Search by Name, Mobile, or MRN..."
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:background="@drawable/bg_input_field"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_open_add_patient"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="+ Register"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_button_primary"
                    android:layout_marginLeft="8dp"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:textSize="12sp" />
            </LinearLayout>

            <ListView
                android:id="@+id/lv_patients"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@null"
                android:dividerHeight="8dp" />
        </LinearLayout>

        <!-- 3. OPD Consultation, Appointment Booking & Billing View -->
        <ScrollView
            android:id="@+id/view_opd"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Doctor Scheduling &amp; Consultation Billing"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Appointment Booking Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_rounded"
                    android:padding="14dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Book Consultation Slot"
                        android:textColor="@color/teal_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <EditText
                        android:id="@+id/et_booking_mrn"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:hint="Patient MRN or Full Name"
                        android:background="@drawable/bg_input_field"
                        android:paddingLeft="10dp"
                        android:textSize="13sp"
                        android:layout_marginBottom="8dp" />

                    <Spinner
                        android:id="@+id/spn_doctor_select"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_input_field"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <EditText
                            android:id="@+id/et_booking_date"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:hint="Date (YYYY-MM-DD)"
                            android:background="@drawable/bg_input_field"
                            android:paddingLeft="10dp"
                            android:textSize="13sp"
                            android:layout_marginRight="4dp" />

                        <EditText
                            android:id="@+id/et_booking_slot"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:hint="Slot (e.g. 10:30 AM)"
                            android:background="@drawable/bg_input_field"
                            android:paddingLeft="10dp"
                            android:textSize="13sp"
                            android:layout_marginLeft="4dp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_confirm_booking"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:text="Confirm Appointment"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_button_primary"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Digital Prescription & Billing Builder -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_rounded"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Digital Prescription &amp; Checkout Billing"
                        android:textColor="@color/indigo_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <EditText
                        android:id="@+id/et_rx_patient"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:hint="Patient Name / MRN"
                        android:background="@drawable/bg_input_field"
                        android:paddingLeft="10dp"
                        android:textSize="13sp"
                        android:layout_marginBottom="8dp" />

                    <Spinner
                        android:id="@+id/spn_rx_medicine"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_input_field"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <EditText
                            android:id="@+id/et_rx_dosage"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:hint="Dosage (e.g. 1-0-1)"
                            android:background="@drawable/bg_input_field"
                            android:paddingLeft="10dp"
                            android:textSize="13sp"
                            android:layout_marginRight="4dp" />

                        <EditText
                            android:id="@+id/et_rx_duration"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:hint="Duration (e.g. 5 Days)"
                            android:background="@drawable/bg_input_field"
                            android:paddingLeft="10dp"
                            android:textSize="13sp"
                            android:layout_marginLeft="4dp" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/et_rx_notes"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:hint="Clinical notes and instructions..."
                        android:gravity="top|left"
                        android:background="@drawable/bg_input_field"
                        android:padding="8dp"
                        android:textSize="13sp"
                        android:layout_marginBottom="10dp" />

                    <!-- Billing calculations -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <EditText
                            android:id="@+id/et_bill_fee"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:hint="Fee ($)"
                            android:inputType="numberDecimal"
                            android:text="60.00"
                            android:background="@drawable/bg_input_field"
                            android:paddingLeft="10dp"
                            android:textSize="13sp"
                            android:layout_marginRight="4dp" />

                        <EditText
                            android:id="@+id/et_bill_discount"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:hint="Discount ($)"
                            android:inputType="numberDecimal"
                            android:text="5.00"
                            android:background="@drawable/bg_input_field"
                            android:paddingLeft="10dp"
                            android:textSize="13sp"
                            android:layout_marginRight="4dp" />

                        <EditText
                            android:id="@+id/et_bill_tax"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:hint="Tax ($)"
                            android:inputType="numberDecimal"
                            android:text="4.40"
                            android:background="@drawable/bg_input_field"
                            android:paddingLeft="10dp"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Computed Realtime Net Bill -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="10dp"
                        android:background="#F1F5F9"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Calculated Net OPD Fee:"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_computed_net_bill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$59.40"
                            android:textColor="@color/teal_dark"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_fulfill_prescription"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:text="Fulfill Rx &amp; Print Receipt"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_button_primary"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- 4. Pharmacy & Supplies Inventory View -->
        <LinearLayout
            android:id="@+id/view_pharmacy"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pharmacy &amp; Supplies Inventory"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Real-time stock &amp; Expiry alert monitor"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_open_add_medicine"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="+ Stock"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_button_primary"
                    android:textSize="12sp"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp" />
            </LinearLayout>

            <ListView
                android:id="@+id/lv_pharmacy"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@null"
                android:dividerHeight="8dp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>