<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_match"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F7">

    <!-- Custom Header App Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#6200EE"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerY="true"
            android:text="AnimMagic Playground"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Tab Bar Layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:elevation="4dp">

        <Button
            android:id="@+id/tab_preset"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:text="Presets"
            android:textColor="#6200EE"
            android:textStyle="bold"
            android:textSize="13sp" />

        <Button
            android:id="@+id/tab_flipbook"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:text="Flipbook Creator"
            android:textColor="#757575"
            android:textStyle="normal"
            android:textSize="13sp" />

        <Button
            android:id="@+id/tab_particle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:text="Physics Canvas"
            android:textColor="#757575"
            android:textStyle="normal"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Content Containers -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- PRESET TWEEN VIEW -->
        <ScrollView
            android:id="@+id/panel_preset"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <!-- Animation Arena Preview Screen -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:background="#FFFFFF"
                    android:layout_marginBottom="16dp"
                    android:elevation="2dp">

                    <View
                        android:id="@+id/anim_preview_box"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_gravity="center" />
                </FrameLayout>

                <!-- Animation Config Controls Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#FFFFFF"
                    android:padding="16dp"
                    android:elevation="2dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Animation Types"
                        android:textColor="#212121"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <CheckBox
                            android:id="@+id/cb_rotate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Rotation"
                            android:checked="true"/>

                        <CheckBox
                            android:id="@+id/cb_scale"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Scaling"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <CheckBox
                            android:id="@+id/cb_translate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Translation" />

                        <CheckBox
                            android:id="@+id/cb_fade"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Fading" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Interpolation Curves"
                        android:textColor="#212121"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <RadioGroup
                        android:id="@+id/rg_interpolators"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp">

                        <RadioButton
                            android:id="@+id/rb_linear"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Linear (Smooth, Constant)"
                            android:checked="true"/>

                        <RadioButton
                            android:id="@+id/rb_bounce"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bounce (Gravity Elasticity)"/>

                        <RadioButton
                            android:id="@+id/rb_accelerate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Accelerate (Ease In)"/>

                        <RadioButton
                            android:id="@+id/rb_overshoot"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Overshoot (Dynamic Bounce Past Target)"/>
                    </RadioGroup>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_duration_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Duration: 1000 ms"
                            android:textColor="#212121"
                            android:textSize="14sp"
                            android:layout_marginBottom="4dp"/>

                        <SeekBar
                            android:id="@+id/sb_duration"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="5000"
                            android:progress="1000" />
                    </LinearLayout>

                </LinearLayout>

                <Button
                    android:id="@+id/btn_trigger_anim"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Launch Animation"
                    android:background="#6200EE"
                    android:textColor="#FFFFFF" />

            </LinearLayout>
        </ScrollView>

        <!-- FLIPBOOK CANVAS DRAWING VIEW -->
        <LinearLayout
            android:id="@+id/panel_flipbook"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Canvas Holder -->
            <FrameLayout
                android:id="@+id/flipbook_canvas_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#FFFFFF"
                android:elevation="2dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tv_frame_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Frames Captured: 0"
                    android:textColor="#212121"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cb_onion_skin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Onion Skinning"
                    android:checked="true" />
            </LinearLayout>

            <!-- Playback Control Panels -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btn_add_frame"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Save Frame"
                    android:background="#03DAC5"
                    android:textColor="#000000"
                    android:layout_marginRight="4dp" />

                <Button
                    android:id="@+id/btn_clear_frame"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Clear Current"
                    android:background="#CF6679"
                    android:textColor="#FFFFFF"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp" />

                <Button
                    android:id="@+id/btn_reset_flipbook"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Reset Project"
                    android:background="#9E9E9E"
                    android:textColor="#FFFFFF"
                    android:layout_marginLeft="4dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="8dp"
                android:elevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:id="@+id/tv_fps_label"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Playback FPS: 6"
                        android:textColor="#212121"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_play_flipbook"
                        android:layout_width="120dp"
                        android:layout_height="36dp"
                        android:text="Play Movie"
                        android:textSize="12dp"
                        android:background="#6200EE"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/sb_fps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="24"
                    android:progress="6" />

            </LinearLayout>

        </LinearLayout>

        <!-- PHYSICS PARTICLE VIEW -->
        <LinearLayout
            android:id="@+id/panel_particle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Touch Screen to Generate Physical Particles!"
                android:textStyle="italic"
                android:textColor="#757575"
                android:layout_marginBottom="8dp"
                android:layout_gravity="center_horizontal" />

            <!-- Physics Interactive Arena Canvas -->
            <FrameLayout
                android:id="@+id/particle_canvas_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#1E1E1E"
                android:elevation="2dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="12dp"
                android:layout_marginTop="8dp"
                android:elevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_gravity_label"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Gravity Acceleration: 0.5"
                        android:textColor="#212121"
                        android:textStyle="bold"/>

                    <Button
                        android:id="@+id/btn_clear_particles"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Clear Particles"
                        android:background="#CF6679"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"/>
                </LinearLayout>

                <SeekBar
                    android:id="@+id/sb_gravity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="20"
                    android:progress="5"
                    android:layout_marginTop="8dp"/>

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>
</LinearLayout>