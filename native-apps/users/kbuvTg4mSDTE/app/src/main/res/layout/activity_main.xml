<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Voice Assistant"
                android:textColor="#1A237E"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_service_status_dot"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="@drawable/circle_error"
                android:layout_gravity="center" />
        </LinearLayout>

        <!-- Service Status Controller Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACCESSIBILITY CONTROLLER"
                android:textColor="#78909C"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tv_service_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Checking Status..."
                android:textColor="#FFA000"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tv_service_status_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Checking configuration status parameters..."
                android:textColor="#546E7A"
                android:textSize="14sp"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/btn_action_accessibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enable Accessibility Service"
                android:textColor="#FFFFFF"
                android:background="#1A237E"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- AI Configuration Settings Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GEMINI AI CONFIGURATION"
                android:textColor="#1A237E"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gemini API Key"
                android:textColor="#37474F"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/et_api_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter Gemini API Key"
                android:inputType="textPassword"
                android:background="@android:drawable/editbox_background"
                android:padding="10dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gemini Model"
                android:textColor="#37474F"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/sp_model"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tv_custom_model_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Custom Model Name"
                android:textColor="#37474F"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/et_custom_model"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. gemini-2.5-flash"
                android:background="@android:drawable/editbox_background"
                android:padding="10dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_save_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Save AI Settings"
                android:textColor="#FFFFFF"
                android:background="#1A237E"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Test Command Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MANUAL COMMAND TRIGGER"
                android:textColor="#1A237E"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/et_test_command"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Type Hinglish/English command..."
                android:background="@android:drawable/editbox_background"
                android:padding="10dp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btn_run_test_command"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Run Text Command via AI"
                android:textColor="#FFFFFF"
                android:background="#1A237E"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- System Overlay Permission Card -->
        <LinearLayout
            android:id="@+id/card_overlay_permission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="18dp"
            android:layout_marginBottom="16dp"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REQUIRED PERMISSION"
                android:textColor="#E53935"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="System Alert Window"
                android:textColor="#37474F"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="The floating AI assistant mic orb requires permission to display overlay widgets above active applications."
                android:textColor="#546E7A"
                android:textSize="13sp"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/btn_action_overlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Grant Overlay Permission"
                android:textColor="#FFFFFF"
                android:background="#FF9100"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- How To Use Guide Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GUIDELINES"
                android:textColor="#78909C"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/how_to_use"
                android:textColor="#37474F"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.2"
                android:layout_marginBottom="14dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#CFD8DC"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MULTIPLE ACTION EXAMPLES"
                android:textColor="#78909C"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_supported_commands"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/supported_commands"
                android:textColor="#455A64"
                android:lineSpacingMultiplier="1.2"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Installed Apps Dynamic Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DYNAMICAL LAUNCHABLE INSTALLED APPS"
                android:textColor="#78909C"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Say 'Open [App Name]' or '[App] kholo':"
                android:textColor="#546E7A"
                android:textSize="12sp"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:id="@+id/ll_detected_apps_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <!-- Programmatically populated via MainActivity.java -->
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>