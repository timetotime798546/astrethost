<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main"
    android:padding="16dp">

    <!-- Display Screens Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.8"
        android:orientation="vertical"
        android:gravity="bottom|end"
        android:layout_marginBottom="16dp"
        android:paddingEnd="12dp"
        android:paddingStart="12dp">

        <!-- Expression Preview Text View -->
        <TextView
            android:id="@+id/tv_expression"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/display_text_secondary"
            android:textSize="26sp"
            android:fontFamily="sans-serif-light"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:gravity="end" />

        <!-- Final Result Display Text View -->
        <TextView
            android:id="@+id/tv_result"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/display_text_primary"
            android:textSize="60sp"
            android:fontFamily="sans-serif"
            android:maxLines="2"
            android:gravity="end"
            android:ellipsize="end"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- Keypad Container Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3.2"
        android:orientation="vertical">

        <!-- Row 1: AC, Backspace, Modulo, Division -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btn_clear"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:text="AC"
                android:textColor="@color/btn_special_text"
                android:textSize="22sp"
                android:textAllCaps="false"
                android:background="@drawable/btn_special_bg" />

            <Button
                android:id="@+id/btn_delete"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:text="⌫"
                android:textColor="@color/btn_special_text"
                android:textSize="22sp"
                android:background="@drawable/btn_special_bg" />

            <Button
                android:id="@+id/btn_modulo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:text="%"
                android:textColor="@color/btn_special_text"
                android:textSize="22sp"
                android:background="@drawable/btn_special_bg" />

            <Button
                android:id="@+id/btn_divide"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="÷"
                android:textColor="@color/btn_operator_text"
                android:textSize="28sp"
                android:background="@drawable/btn_operator_bg" />
        </LinearLayout>

        <!-- Row 2: 7, 8, 9, Multiplication -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btn_7"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:text="7"
                android:textColor="@color/btn_number_text"
                android:textSize="24sp"
                android:background="@drawable/btn_number_bg" />

            <Button
                android:id="@+id/btn_8"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:text="8"
                android:textColor="@color/btn_number_text"
                android:textSize="24sp"
                android:background="@drawable/btn_number_bg" />

            <Button
                android:id="@+id/btn_9"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:text="9"
                android:textColor="@color/btn_number_text"
                android:textSize="24sp"
                android:background="@drawable/btn_number_bg" />

            <Button
                android:id="@+id/btn_multiply"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="×"
                android:textColor="@color/btn_operator_text"
                android:textSize="28sp"
                android:background="@drawable/btn_operator_bg" />
        </LinearLayout>

        <!-- Row 3: 4, 5, 6, Subtraction -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btn_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:text="4"
                android:textColor="@color/btn_number_text"
                android:textSize="24sp"
                android:background="@drawable/btn_number_bg" />

            <Button
                android:id="@+id/btn_5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:text="5"
                android:textColor="@color/btn_number_text"
                android:textSize="24sp"
                android:background="@drawable/btn_number_bg" />

            <Button
                android:id="@+id/btn_6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:text="6"
                android:textColor="@color/btn_number_text"
                android:textSize="24sp"
                android:background="@drawable/btn_number_bg" />

            <Button
                android:id="@+id/btn_subtract"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="-"
                android:textColor="@color/btn_operator_text"
                android:textSize="28sp"
                android:background="@drawable/btn_operator_bg" />
        </LinearLayout>

        <!-- Row 4: 1, 2, 3, Addition -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btn_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:text="1"
                android:textColor="@color/btn_number_text"
                android:textSize="24sp"
                android:background="@drawable/btn_number_bg" />

            <Button
                android:id="@+id/btn_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:text="2"
                android:textColor="@color/btn_number_text"
                android:textSize="24sp"
                android:background="@drawable/btn_number_bg" />

            <Button
                android:id="@+id/btn_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:text="3"
                android:textColor="@color/btn_number_text"
                android:textSize="24sp"
                android:background="@drawable/btn_number_bg" />

            <Button
                android:id="@+id/btn_add"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="+"
                android:textColor="@color/btn_operator_text"
                android:textSize="28sp"
                android:background="@drawable/btn_operator_bg" />
        </LinearLayout>

        <!-- Row 5: Sign Toggle (+/-), 0, Decimal (.), Equals (=) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_sign"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:text="±"
                android:textColor="@color/btn_number_text"
                android:textSize="24sp"
                android:background="@drawable/btn_number_bg" />

            <Button
                android:id="@+id/btn_0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:text="0"
                android:textColor="@color/btn_number_text"
                android:textSize="24sp"
                android:background="@drawable/btn_number_bg" />

            <Button
                android:id="@+id/btn_dot"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:text="."
                android:textColor="@color/btn_number_text"
                android:textSize="24sp"
                android:background="@drawable/btn_number_bg" />

            <Button
                android:id="@+id/btn_equals"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="="
                android:textColor="@color/btn_operator_text"
                android:textSize="28sp"
                android:background="@drawable/btn_operator_bg" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>