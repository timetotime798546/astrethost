<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="16dp">

    <!-- DISPLAY REGION -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.3"
        android:orientation="vertical"
        android:gravity="bottom|end"
        android:paddingBottom="16dp">

        <!-- History Display -->
        <TextView
            android:id="@+id/tvHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8E8E93"
            android:textSize="18sp"
            android:gravity="end"
            android:maxLines="1"
            android:ellipsize="start"
            android:text="" />

        <!-- Current Formula -->
        <TextView
            android:id="@+id/tvFormula"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="44sp"
            android:textStyle="bold"
            android:gravity="end"
            android:layout_marginTop="8dp"
            android:ellipsize="start"
            android:singleLine="true"
            android:text="0" />

        <!-- Real-time Preview / Final Result -->
        <TextView
            android:id="@+id/tvResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#30D158"
            android:textSize="26sp"
            android:gravity="end"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="" />
    </LinearLayout>

    <!-- DIVIDER -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2C2C2E"
        android:layout_marginBottom="16dp" />

    <!-- KEYBOARD REGION -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2.7"
        android:orientation="vertical">

        <!-- Row 1: C, ( ), %, / -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btnClear"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="C"
                android:textSize="22sp"
                android:textColor="#000000"
                android:background="@drawable/btn_bg_action"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnBrackets"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:text="( )"
                android:textSize="22sp"
                android:textColor="#000000"
                android:background="@drawable/btn_bg_action"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnPercent"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:text="%"
                android:textSize="22sp"
                android:textColor="#000000"
                android:background="@drawable/btn_bg_action"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnDivide"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="/"
                android:textSize="24sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_bg_operator"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Row 2: 7, 8, 9, * -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btn7"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="7"
                android:textSize="24sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_bg_numeric"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn8"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:text="8"
                android:textSize="24sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_bg_numeric"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn9"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:text="9"
                android:textSize="24sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_bg_numeric"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnMultiply"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="*"
                android:textSize="24sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_bg_operator"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Row 3: 4, 5, 6, - -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btn4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="4"
                android:textSize="24sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_bg_numeric"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:text="5"
                android:textSize="24sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_bg_numeric"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:text="6"
                android:textSize="24sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_bg_numeric"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnSubtract"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="-"
                android:textSize="28sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_bg_operator"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Row 4: 1, 2, 3, + -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btn1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="1"
                android:textSize="24sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_bg_numeric"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:text="2"
                android:textSize="24sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_bg_numeric"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:text="3"
                android:textSize="24sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_bg_numeric"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnAdd"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="+"
                android:textSize="26sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_bg_operator"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Row 5: Backspace (DEL), 0, ., = -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDelete"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="⌫"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_bg_numeric"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:text="0"
                android:textSize="24sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_bg_numeric"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnDot"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:text="."
                android:textSize="24sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_bg_numeric"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnEquals"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="="
                android:textSize="28sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_bg_equals"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>