<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA">

    <!-- Screen 1: Notes List Screen -->
    <LinearLayout
        android:id="@+id/layout_main_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#3F51B5"
            android:paddingLeft="16dp"
            android:paddingRight="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="Quick Notes"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_manage_categories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toLeftOf="@+id/btn_new_note"
                android:layout_marginRight="8dp"
                android:text="Categories"
                android:textColor="#FFFFFF"
                android:background="?android:attr/selectableItemBackground"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_new_note"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:text="+ Add"
                android:textColor="#FFFFFF"
                android:background="?android:attr/selectableItemBackground"
                android:textSize="14sp" />
        </RelativeLayout>

        <!-- Search and Filter Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:background="#FFFFFF"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/et_search"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Search notes..."
                android:textSize="14sp"
                android:inputType="text"
                android:maxLines="1"
                android:padding="10dp"
                android:background="@android:drawable/editbox_background_normal" />

            <Spinner
                android:id="@+id/spinner_filter_category"
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp" />
        </LinearLayout>

        <!-- List Container -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ListView
                android:id="@+id/notes_list_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="#E0E0E0"
                android:dividerHeight="1dp" />

            <TextView
                android:id="@+id/tv_empty_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="No notes found.\nTap '+ Add' to create one!"
                android:textAlignment="center"
                android:textColor="#9E9E9E"
                android:textSize="16sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Screen 2: Note Editor Screen -->
    <LinearLayout
        android:id="@+id/layout_note_editor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="#FFFFFF">

        <!-- Editor Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#3F51B5"
            android:paddingLeft="16dp"
            android:paddingRight="16dp">

            <TextView
                android:id="@+id/tv_editor_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="New Note"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_editor_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:text="Back"
                android:textColor="#FFFFFF"
                android:background="?android:attr/selectableItemBackground" />
        </RelativeLayout>

        <!-- Editor Fields -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Note Title"
                    android:textColor="#757575"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_note_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter title..."
                    android:textSize="18sp"
                    android:inputType="textCapSentences"
                    android:maxLines="2"
                    android:layout_marginTop="4dp"
                    android:padding="8dp"
                    android:background="@android:drawable/editbox_background_normal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Category"
                    android:textColor="#757575"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp" />

                <Spinner
                    android:id="@+id/spinner_note_category"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:padding="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Content"
                    android:textColor="#757575"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp" />

                <EditText
                    android:id="@+id/et_note_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Type note contents here..."
                    android:textSize="16sp"
                    android:inputType="textMultiLine|textCapSentences"
                    android:gravity="top|left"
                    android:minLines="8"
                    android:layout_marginTop="4dp"
                    android:padding="10dp"
                    android:background="@android:drawable/editbox_background_normal" />

            </LinearLayout>
        </ScrollView>

        <!-- Bottom Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:padding="8dp"
            android:background="#F5F5F5"
            android:gravity="center">

            <Button
                android:id="@+id/btn_delete_note"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginRight="8dp"
                android:text="Delete"
                android:textColor="#FFFFFF"
                android:background="#F44336" />

            <Button
                android:id="@+id/btn_save_note"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:text="Save Note"
                android:textColor="#FFFFFF"
                android:background="#4CAF50" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>