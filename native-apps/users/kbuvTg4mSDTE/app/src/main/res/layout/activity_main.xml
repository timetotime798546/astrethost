<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA">

    <!-- App Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2C3E50"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Interactive Physics, Canvas, and Property Animators"
            android:textColor="#BDC3C7"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Tab Bar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#EAEDED"
        android:scrollbars="none"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <Button
                android:id="@+id/btn_tab_property"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/tab_button_active"
                android:text="Property Lab"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_tab_interpolator"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/tab_button_inactive"
                android:text="Interpolator Lab"
                android:textColor="#2C3E50"
                android:textSize="12sp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_tab_physics"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/tab_button_inactive"
                android:text="Physics Sandbox"
                android:textColor="#2C3E50"
                android:textSize="12sp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_tab_particle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/tab_button_inactive"
                android:text="Particle Box"
                android:textColor="#2C3E50"
                android:textSize="12sp"
                android:textAllCaps="false" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Main Content Frame -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 1. PROPERTY LAB TAB -->
        <ScrollView
            android:id="@+id/panel_property"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Target Showcase Area -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:background="@drawable/card_bg"
                    android:layout_marginBottom="16dp">

                    <View
                        android:id="@+id/animated_target"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_gravity="center"
                        android:background="@drawable/animated_box_bg" />
                </FrameLayout>

                <!-- Parameter Controls -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Animation Settings"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="#2C3E50"
                        android:layout_marginBottom="12dp"/>

                    <!-- Duration Slider -->
                    <TextView
                        android:id="@+id/lbl_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Duration: 1000 ms"
                        android:textSize="13sp" />
                    <SeekBar
                        android:id="@+id/seek_duration"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="4000"
                        android:progress="1000"
                        android:layout_marginBottom="12dp" />

                    <!-- Rotation Slider -->
                    <TextView
                        android:id="@+id/lbl_rotation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rotation Angle: 360°"
                        android:textSize="13sp" />
                    <SeekBar
                        android:id="@+id/seek_rotation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="720"
                        android:progress="360"
                        android:layout_marginBottom="12dp" />

                    <!-- Scale Slider -->
                    <TextView
                        android:id="@+id/lbl_scale"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Scale Factor: 1.5x"
                        android:textSize="13sp" />
                    <SeekBar
                        android:id="@+id/seek_scale"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="200"
                        android:progress="150"
                        android:layout_marginBottom="12dp" />

                    <!-- Translation Slider -->
                    <TextView
                        android:id="@+id/lbl_translation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="X-Translation: 0 px"
                        android:textSize="13sp" />
                    <SeekBar
                        android:id="@+id/seek_translation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="400"
                        android:progress="200"
                        android:layout_marginBottom="12dp" />

                    <!-- Select Interpolator -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Interpolator Curve"
                        android:textSize="13sp"
                        android:layout_marginBottom="4dp"/>
                    <Spinner
                        android:id="@+id/spinner_property_interpolator"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginBottom="16dp"/>

                    <!-- Trigger Actions -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_play_property"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="#2ECC71"
                            android:text="Play Animation"
                            android:textColor="#FFFFFF"
                            android:layout_marginEnd="8dp" />

                        <Button
                            android:id="@+id/btn_reset_property"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="#E74C3C"
                            android:text="Reset Target"
                            android:textColor="#FFFFFF" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- 2. INTERPOLATOR LAB TAB -->
        <LinearLayout
            android:id="@+id/panel_interpolator"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <!-- Dropdown Switcher -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/card_bg"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Curve Preset:"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginEnd="10dp"/>

                <Spinner
                    android:id="@+id/spinner_curve_interpolator"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>

            <!-- Interpolator Visualization Graph -->
            <com.animationsandbox.app.InterpolatorGraphView
                android:id="@+id/interpolator_graph_view"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="@drawable/card_bg"
                android:layout_marginBottom="16dp" />

            <!-- Track Visualizer Arena -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Linear Timeline vs. Evaluated Motion"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp"/>

                <!-- Swipe Arena -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:background="#ECF0F1"
                    android:padding="6dp"
                    android:layout_marginBottom="16dp">

                    <View
                        android:id="@+id/test_animated_dot"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/animated_box_bg" />
                </FrameLayout>

                <Button
                    android:id="@+id/btn_trigger_test_motion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#2980B9"
                    android:text="Run Test Motion (2.5s)"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>

        <!-- 3. PHYSICS SANDBOX TAB -->
        <LinearLayout
            android:id="@+id/panel_physics"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <!-- Simulator View -->
            <com.animationsandbox.app.PhysicsSandboxView
                android:id="@+id/physics_sandbox_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/card_bg"
                android:layout_marginBottom="16dp" />

            <!-- Slider Options Panel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="16dp">

                <!-- Physics gravity slider -->
                <TextView
                    android:id="@+id/lbl_physics_gravity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gravity Strength: 1.2"
                    android:textSize="13sp" />
                <SeekBar
                    android:id="@+id/seek_physics_gravity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="30"
                    android:progress="12"
                    android:layout_marginBottom="12dp" />

                <!-- Elastic bounciness slider -->
                <TextView
                    android:id="@+id/lbl_physics_bounciness"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bounciness Elasticity: 0.75"
                    android:textSize="13sp" />
                <SeekBar
                    android:id="@+id/seek_physics_bounciness"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="95"
                    android:progress="75"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/btn_clear_physics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#E74C3C"
                    android:text="Clear Sandbox Canvas"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>

        <!-- 4. PARTICLE BOX TAB -->
        <LinearLayout
            android:id="@+id/panel_particle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <!-- Particle Board View -->
            <com.animationsandbox.app.ParticleExplosionView
                android:id="@+id/particle_explosion_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/card_bg"
                android:layout_marginBottom="16dp"/>

            <!-- Config Controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="16dp">

                <!-- Particle Speed -->
                <TextView
                    android:id="@+id/lbl_particle_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Velocity Speed Scale: 1.0x"
                    android:textSize="13sp" />
                <SeekBar
                    android:id="@+id/seek_particle_speed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="20"
                    android:progress="10"
                    android:layout_marginBottom="12dp" />

                <!-- Density Count Slider -->
                <TextView
                    android:id="@+id/lbl_particle_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Particle Burst Density: 40"
                    android:textSize="13sp" />
                <SeekBar
                    android:id="@+id/seek_particle_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="40"
                    android:layout_marginBottom="12dp" />

                <!-- Particle Lifespan Slider -->
                <TextView
                    android:id="@+id/lbl_particle_lifespan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lifespan Duration: 1.0x"
                    android:textSize="13sp" />
                <SeekBar
                    android:id="@+id/seek_particle_lifespan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="20"
                    android:progress="10"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/btn_clear_particles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#E74C3C"
                    android:text="Clear Explosions"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>
        </LinearLayout>

    </FrameLayout>
</LinearLayout>