<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/layout_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentTop="true">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/text_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NoteSphere"
                android:textColor="#212121"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_alignParentLeft="true"/>

            <Button
                android:id="@+id/button_logout"
                android:layout_width="80dp"
                android:layout_height="36dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:background="@drawable/btn_cancel_bg"
                android:text="Logout"
                android:textColor="#E53935"
                android:textSize="12sp"
                android:textStyle="bold"/>
        </RelativeLayout>

        <TextView
            android:id="@+id/text_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Keep your thoughts organized online"
            android:textColor="#757575"
            android:textSize="14sp"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/edit_search"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:hint="Search title or content..."
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:textColor="#212121"
            android:textSize="16sp"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Category:"
                android:textColor="#424242"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginRight="8dp"/>

            <Spinner
                android:id="@+id/spinner_category_filter"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="#FFFFFF"
                android:elevation="1dp"
                android:spinnerMode="dropdown"/>
        </LinearLayout>
    </LinearLayout>

    <ListView
        android:id="@+id/list_notes"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layout_header"
        android:divider="@null"
        android:dividerHeight="10dp"
        android:scrollbars="none"/>

    <TextView
        android:id="@+id/text_empty_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No notes found.\nTap + to write a new note!"
        android:textColor="#9E9E9E"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_centerInParent="true"
        android:visibility="gone"/>

    <Button
        android:id="@+id/button_add_note"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentRight="true"
        android:layout_marginBottom="16dp"
        android:layout_marginRight="16dp"
        android:text="+"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:background="@drawable/button_circle_bg"
        android:elevation="6dp"
        android:gravity="center"/>

</RelativeLayout>