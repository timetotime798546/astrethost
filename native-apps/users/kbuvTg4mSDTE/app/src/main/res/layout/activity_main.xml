<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Top App Header -->
    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/primary"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_stats_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:text="0 notes" />
        </LinearLayout>

        <!-- Search Input Bar -->
        <EditText
            android:id="@+id/et_search"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:background="#334155"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:hint="@string/search_hint"
            android:textColor="#FFFFFF"
            android:textColorHint="#94A3B8"
            android:textSize="14sp"
            android:inputType="text"
            android:singleLine="true" />
    </LinearLayout>

    <!-- Category Filter Horizontal Scroll -->
    <HorizontalScrollView
        android:id="@+id/category_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/header_layout"
        android:scrollbars="none"
        android:background="#FFFFFF"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <LinearLayout
            android:id="@+id/category_chip_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_filter_all"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/category_all"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:background="@color/primary"
                android:textColor="#FFFFFF"
                android:layout_marginRight="8dp" />

            <Button
                android:id="@+id/btn_filter_general"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/category_general"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:background="@color/tag_general"
                android:textColor="@color/tag_text_general"
                android:layout_marginRight="8dp" />

            <Button
                android:id="@+id/btn_filter_work"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/category_work"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:background="@color/tag_work"
                android:textColor="@color/tag_text_work"
                android:layout_marginRight="8dp" />

            <Button
                android:id="@+id/btn_filter_personal"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/category_personal"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:background="@color/tag_personal"
                android:textColor="@color/tag_text_personal"
                android:layout_marginRight="8dp" />

            <Button
                android:id="@+id/btn_filter_ideas"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/category_ideas"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:background="@color/tag_ideas"
                android:textColor="@color/tag_text_ideas"
                android:layout_marginRight="8dp" />

            <Button
                android:id="@+id/btn_filter_urgent"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/category_urgent"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:background="@color/tag_urgent"
                android:textColor="@color/tag_text_urgent"
                android:layout_marginRight="8dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Notes Container ScrollView -->
    <ScrollView
        android:id="@+id/scroll_notes"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/category_scroll"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/notes_list_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Empty State -->
            <TextView
                android:id="@+id/tv_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="60dp"
                android:text="@string/empty_notes"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <!-- Floating Action Button to Add Note -->
    <Button
        android:id="@+id/btn_add_note"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentRight="true"
        android:layout_margin="24dp"
        android:text="+"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:background="@color/accent"
        android:elevation="6dp" />

</RelativeLayout>