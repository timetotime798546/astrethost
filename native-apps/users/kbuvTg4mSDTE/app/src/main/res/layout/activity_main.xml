<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:background="?android:attr/colorBackground">
        <Button
            android:id="@+id/btnHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="History"
            style="?android:attr/borderlessButtonStyle" />
        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
        <Button
            android:id="@+id/btnTheme"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Theme"
            style="?android:attr/borderlessButtonStyle" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvDisplay"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom|end"
        android:padding="24dp"
        android:text="0"
        android:textSize="48sp"
        android:textColor="?android:attr/textColorPrimary" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="5"
        android:padding="8dp">

        <Button android:text="C" android:layout_columnWeight="1" android:id="@+id/btnC" />
        <Button android:text="/" android:layout_columnWeight="1" android:id="@+id/btnDiv" />
        <Button android:text="*" android:layout_columnWeight="1" android:id="@+id/btnMul" />
        <Button android:text="DEL" android:layout_columnWeight="1" android:id="@+id/btnDel" />

        <Button android:text="7" android:layout_columnWeight="1" android:id="@+id/btn7" />
        <Button android:text="8" android:layout_columnWeight="1" android:id="@+id/btn8" />
        <Button android:text="9" android:layout_columnWeight="1" android:id="@+id/btn9" />
        <Button android:text="-" android:layout_columnWeight="1" android:id="@+id/btnSub" />

        <Button android:text="4" android:layout_columnWeight="1" android:id="@+id/btn4" />
        <Button android:text="5" android:layout_columnWeight="1" android:id="@+id/btn5" />
        <Button android:text="6" android:layout_columnWeight="1" android:id="@+id/btn6" />
        <Button android:text="+" android:layout_columnWeight="1" android:id="@+id/btnAdd" />

        <Button android:text="1" android:layout_columnWeight="1" android:id="@+id/btn1" />
        <Button android:text="2" android:layout_columnWeight="1" android:id="@+id/btn2" />
        <Button android:text="3" android:layout_columnWeight="1" android:id="@+id/btn3" />
        <Button android:text="=" android:layout_columnWeight="1" android:layout_rowSpan="2" android:layout_gravity="fill" android:id="@+id/btnEqual" />

        <Button android:text="0" android:layout_columnWeight="2" android:layout_columnSpan="2" android:id="@+id/btn0" />
        <Button android:text="." android:layout_columnWeight="1" android:id="@+id/btnDot" />

    </GridLayout>
</LinearLayout>