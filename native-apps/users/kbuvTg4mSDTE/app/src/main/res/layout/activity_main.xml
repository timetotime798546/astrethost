<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F7">

    <!-- Header Toolbar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#0F2027"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="Quiz Card Creator"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_clear_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:background="?android:attr/selectableItemBackground"
            android:text="CLEAR ALL"
            android:textColor="#FF5252"
            android:textSize="14sp"
            android:textStyle="bold"
            android:padding="8dp" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card Section Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIVE PREVIEW (16:9 ASPECT RATIO)"
                android:textColor="#37474F"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>

            <!-- 16:9 Aspect Ratio Frame Layout Container -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#CCCCCC">

                <!-- Simple helper layout where code will dynamically force 16:9 dimension -->
                <ImageView
                    android:id="@+id/card_preview"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:scaleType="fitCenter"
                    android:background="#1E3C72" />
            </FrameLayout>

            <!-- Customization Controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="12dp"
                android:layout_marginTop="12dp"
                android:elevation="2dp">

                <!-- Theme Choice Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BACKGROUND THEME"
                    android:textColor="#546E7A"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:id="@+id/theme_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    android:layout_marginBottom="8dp">

                    <!-- Font Color Section -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:orientation="vertical"
                        android:layout_marginRight="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TEXT COLOR"
                            android:textColor="#546E7A"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:scrollbars="none"
                            android:layout_marginTop="6dp">

                            <LinearLayout
                                android:id="@+id/color_container"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" />
                        </HorizontalScrollView>
                    </LinearLayout>

                    <!-- Font Size Section -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.8"
                        android:orientation="vertical"
                        android:layout_marginLeft="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="FONT SIZE"
                            android:textColor="#546E7A"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/size_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Question Input Fields -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:layout_marginTop="12dp"
                android:elevation="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="QUESTION BUILDER FORM"
                    android:textColor="#37474F"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <!-- Question Input -->
                <EditText
                    android:id="@+id/edit_question"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Type your question here..."
                    android:background="@android:drawable/editbox_background_normal"
                    android:padding="10dp"
                    android:textSize="15sp"
                    android:layout_marginBottom="12dp"
                    android:inputType="textMultiLine"
                    android:minLines="2" />

                <!-- Options grid simulated in Linear layouts -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    android:layout_marginBottom="8dp">

                    <EditText
                        android:id="@+id/edit_option_a"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Option A"
                        android:background="@android:drawable/editbox_background_normal"
                        android:padding="8dp"
                        android:textSize="14sp"
                        android:layout_marginRight="4dp"
                        android:inputType="text" />

                    <EditText
                        android:id="@+id/edit_option_b"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Option B"
                        android:background="@android:drawable/editbox_background_normal"
                        android:padding="8dp"
                        android:textSize="14sp"
                        android:layout_marginLeft="4dp"
                        android:inputType="text" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    android:layout_marginBottom="16dp">

                    <EditText
                        android:id="@+id/edit_option_c"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Option C"
                        android:background="@android:drawable/editbox_background_normal"
                        android:padding="8dp"
                        android:textSize="14sp"
                        android:layout_marginRight="4dp"
                        android:inputType="text" />

                    <EditText
                        android:id="@+id/edit_option_d"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Option D"
                        android:background="@android:drawable/editbox_background_normal"
                        android:padding="8dp"
                        android:textSize="14sp"
                        android:layout_marginLeft="4dp"
                        android:inputType="text" />
                </LinearLayout>

                <!-- Save and Single Export Action Button Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <Button
                        android:id="@+id/btn_save_current_image"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Save Image"
                        android:textSize="13sp"
                        android:background="#E0E0E0"
                        android:textColor="#212121"
                        android:layout_marginRight="4dp"/>

                    <Button
                        android:id="@+id/btn_add_update_question"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Add Card"
                        android:textSize="13sp"
                        android:background="#00838F"
                        android:textColor="#FFFFFF"
                        android:layout_marginLeft="4dp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_editing_indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Currently Editing Question Mode"
                    android:textColor="#EF6C00"
                    android:textSize="12sp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Cards List Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="30dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/tv_count_header"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SAVED CARDS (0)"
                        android:textColor="#263238"
                        android:textSize="12sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:text="Slide/Scroll Below"
                        android:textColor="#78909C"
                        android:textSize="11sp" />
                </RelativeLayout>

                <!-- Dynamically populated card view stack -->
                <LinearLayout
                    android:id="@+id/questions_list_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Absolute Bottom Merge Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:padding="12dp"
        android:elevation="10dp"
        android:weightSum="1">

        <Button
            android:id="@+id/btn_export_all_pdf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#4CAF50"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp"
            android:text="MERGE ALL TO SINGLE PDF"
            android:padding="12dp"/>
    </LinearLayout>
</LinearLayout>