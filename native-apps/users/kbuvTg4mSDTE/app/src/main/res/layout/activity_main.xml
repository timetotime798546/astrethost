<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="12dp">

    <!-- Screen Display Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.8"
        android:orientation="vertical"
        android:gravity="bottom|end"
        android:padding="16dp"
        android:background="@drawable/display_bg">

        <TextView
            android:id="@+id/tv_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="#8AFFFFFF"
            android:textSize="18sp"
            android:singleLine="true"
            android:ellipsize="start"
            android:text="" />

        <TextView
            android:id="@+id/tv_display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="#FFFFFF"
            android:textSize="48sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginTop="8dp"
            android:text="0" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2C2C2C"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"/>

    <!-- Keypad Layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4"
        android:orientation="vertical">

        <!-- Row M: Memory & Advanced Functions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <Button
                android:id="@+id/btn_mc"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="MC"
                android:textAllCaps="false"
                android:textColor="#FF9800"
                android:background="@drawable/btn_number"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btn_mr"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="MR"
                android:textAllCaps="false"
                android:textColor="#FF9800"
                android:background="@drawable/btn_number"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btn_sqrt"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="√"
                android:textColor="#00E676"
                android:background="@drawable/btn_number"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btn_power"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="^"
                android:textColor="#00E676"
                android:background="@drawable/btn_number"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Row 1: Clear, DEL, %, Divide -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <Button
                android:id="@+id/btn_clear"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="C"
                android:textColor="#FF1744"
                android:background="@drawable/btn_function"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btn_del"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="⌫"
                android:textColor="#212121"
                android:background="@drawable/btn_function"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btn_percent"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="%"
                android:textColor="#212121"
                android:background="@drawable/btn_function"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btn_divide"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="÷"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_operator"
                android:textSize="24sp" />
        </LinearLayout>

        <!-- Row 2: 7, 8, 9, Multiply -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <Button
                android:id="@+id/btn_7"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="7"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_number"
                android:textSize="24sp" />

            <Button
                android:id="@+id/btn_8"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="8"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_number"
                android:textSize="24sp" />

            <Button
                android:id="@+id/btn_9"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="9"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_number"
                android:textSize="24sp" />

            <Button
                android:id="@+id/btn_multiply"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="×"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_operator"
                android:textSize="24sp" />
        </LinearLayout>

        <!-- Row 3: 4, 5, 6, Subtract -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <Button
                android:id="@+id/btn_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="4"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_number"
                android:textSize="24sp" />

            <Button
                android:id="@+id/btn_5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="5"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_number"
                android:textSize="24sp" />

            <Button
                android:id="@+id/btn_6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="6"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_number"
                android:textSize="24sp" />

            <Button
                android:id="@+id/btn_subtract"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="-"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_operator"
                android:textSize="24sp" />
        </LinearLayout>

        <!-- Row 4: 1, 2, 3, Add -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <Button
                android:id="@+id/btn_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="1"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_number"
                android:textSize="24sp" />

            <Button
                android:id="@+id/btn_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="2"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_number"
                android:textSize="24sp" />

            <Button
                android:id="@+id/btn_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="3"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_number"
                android:textSize="24sp" />

            <Button
                android:id="@+id/btn_add"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="+"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_operator"
                android:textSize="24sp" />
        </LinearLayout>

        <!-- Row 5: Toggle Sign, 0, Decimal, Equals -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_toggle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="±"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_number"
                android:textSize="24sp" />

            <Button
                android:id="@+id/btn_0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="0"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_number"
                android:textSize="24sp" />

            <Button
                android:id="@+id/btn_dot"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="."
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_number"
                android:textSize="24sp" />

            <Button
                android:id="@+id/btn_equals"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="="
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_operator"
                android:textSize="24sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>