<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Top Action Bar -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@color/bg_card">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="SHOZICA PREMOR"
            android:textColor="@color/accent_gold"
            android:textSize="18sp"
            android:letterSpacing="0.1"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btn_cart"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_compass"
            android:tint="@color/accent_gold"
            android:padding="8dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <!-- Navigation Tabs -->
    <LinearLayout
        android:id="@+id/nav_tabs"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_below="@id/top_bar"
        android:orientation="horizontal"
        android:background="#171924">

        <TextView
            android:id="@+id/tab_shop"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="SHOP"
            android:textColor="@color/accent_gold"
            android:textSize="12dp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/tab_orders"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="MY ORDERS"
            android:textColor="@color/text_secondary"
            android:textSize="12dp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/tab_profile"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="PROFILE"
            android:textColor="@color/text_secondary"
            android:textSize="12dp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <!-- CONTENT MODULES -->

    <!-- Shop View Panel -->
    <LinearLayout
        android:id="@+id/panel_shop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/nav_tabs"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="visible">

        <!-- Category Horizontal Selectors -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/cat_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All Premium"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:background="@color/accent_gold"
                    android:textColor="@color/bg_dark"
                    android:textStyle="bold"
                    android:layout_marginRight="10dp" />

                <TextView
                    android:id="@+id/cat_running"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Running"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:background="@color/bg_card"
                    android:textColor="@color/text_secondary"
                    android:layout_marginRight="10dp" />

                <TextView
                    android:id="@+id/cat_casual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Casual Sneaker"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:background="@color/bg_card"
                    android:textColor="@color/text_secondary"
                    android:layout_marginRight="10dp" />

                <TextView
                    android:id="@+id/cat_formal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Formal Classic"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:background="@color/bg_card"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </HorizontalScrollView>

        <ListView
            android:id="@+id/list_shoes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/bg_dark"
            android:dividerHeight="12dp" />
    </LinearLayout>

    <!-- Orders Panel -->
    <LinearLayout
        android:id="@+id/panel_orders"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/nav_tabs"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Order History"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fetched dynamically from the cloud database server."
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="16dp"/>

        <ProgressBar
            android:id="@+id/progress_orders"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/empty_orders_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="You haven't placed any premium orders yet."
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="60dp"
            android:visibility="visible" />

        <ListView
            android:id="@+id/list_orders"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/divider"
            android:dividerHeight="10dp" />
    </LinearLayout>

    <!-- Profile Panel -->
    <LinearLayout
        android:id="@+id/panel_profile"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/nav_tabs"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="28dp"
        android:visibility="gone">

        <TextView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@color/bg_card"
            android:gravity="center"
            android:text="👤"
            android:textSize="36sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/profile_email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="user@example.com"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/profile_app_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="APP ID: shozica"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btn_logout"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="LOG OUT ACCURELY"
            android:textColor="@color/text_primary"
            android:background="@color/status_red"
            android:textStyle="bold" />

    </LinearLayout>
</RelativeLayout>