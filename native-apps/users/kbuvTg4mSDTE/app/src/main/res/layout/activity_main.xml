<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0F1D">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#1E293B"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:elevation="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="LUDO 3D"
            android:textColor="#F59E0B"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_menu"
                android:layout_width="80dp"
                android:layout_height="40dp"
                android:layout_marginRight="8dp"
                android:text="Lobby"
                android:background="@drawable/glass_card"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_reset"
                android:layout_width="80dp"
                android:layout_height="40dp"
                android:text="Restart"
                android:background="@drawable/btn_neon_green"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="false" />
        </LinearLayout>
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/layout_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp"
        android:layout_margin="10dp"
        android:background="@drawable/glass_card">

        <View
            android:id="@+id/view_turn_color"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginRight="14dp"
            android:background="#EF4444" />

        <TextView
            android:id="@+id/tv_turn_indicator"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Red's Turn! Roll the dice."
            android:textColor="#F1F5F9"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:padding="2dp">

        <com.ludoclassic.app.LudoBoardView
            android:id="@+id/ludo_board"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#0F172A"
        android:padding="18dp"
        android:elevation="12dp">

        <RelativeLayout
            android:id="@+id/btn_roll_dice"
            android:layout_width="94dp"
            android:layout_height="94dp"
            android:background="@drawable/dice_3d_bg"
            android:elevation="12dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="12dp"
            android:padding="14dp">

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:columnCount="3"
                android:rowCount="3">

                <!-- Row 0 -->
                <View
                    android:id="@+id/dot_tl"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_row="0"
                    android:layout_column="0"
                    android:layout_margin="3dp"
                    android:background="#0F172A"
                    android:visibility="invisible" />

                <View
                    android:id="@+id/dot_tc"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_row="0"
                    android:layout_column="1"
                    android:layout_margin="3dp"
                    android:background="#0F172A"
                    android:visibility="invisible" />

                <View
                    android:id="@+id/dot_tr"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_row="0"
                    android:layout_column="2"
                    android:layout_margin="3dp"
                    android:background="#0F172A"
                    android:visibility="invisible" />

                <!-- Row 1 -->
                <View
                    android:id="@+id/dot_ml"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_row="1"
                    android:layout_column="0"
                    android:layout_margin="3dp"
                    android:background="#0F172A"
                    android:visibility="invisible" />

                <View
                    android:id="@+id/dot_mc"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_row="1"
                    android:layout_column="1"
                    android:layout_margin="3dp"
                    android:background="#0F172A"
                    android:visibility="visible" />

                <View
                    android:id="@+id/dot_mr"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_row="1"
                    android:layout_column="2"
                    android:layout_margin="3dp"
                    android:background="#0F172A"
                    android:visibility="invisible" />

                <!-- Row 2 -->
                <View
                    android:id="@+id/dot_bl"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_row="2"
                    android:layout_column="0"
                    android:layout_margin="3dp"
                    android:background="#0F172A"
                    android:visibility="invisible" />

                <View
                    android:id="@+id/dot_bc"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_row="2"
                    android:layout_column="1"
                    android:layout_margin="3dp"
                    android:background="#0F172A"
                    android:visibility="invisible" />

                <View
                    android:id="@+id/dot_br"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_row="2"
                    android:layout_column="2"
                    android:layout_margin="3dp"
                    android:background="#0F172A"
                    android:visibility="invisible" />
            </GridLayout>
        </RelativeLayout>

        <TextView
            android:id="@+id/tv_roll_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap Dice to Roll"
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />
    </LinearLayout>
</LinearLayout>