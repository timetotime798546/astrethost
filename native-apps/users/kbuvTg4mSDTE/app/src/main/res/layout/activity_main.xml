<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="4dp">

    <EditText
        android:id="@+id/display"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.5"
        android:textSize="56sp"
        android:editable="false"
        android:textColor="#FFFFFF"
        android:background="#00000000"
        android:gravity="bottom|end"
        android:padding="24dp"
        android:singleLine="true" />

    <LinearLayout style="@style/RowStyle">
        <Button style="@style/ButtonStyle.Action" android:text="C" android:onClick="onClear" android:textColor="#FF5252" />
        <Button style="@style/ButtonStyle.Action" android:text="/" android:onClick="onOpClick" />
        <Button style="@style/ButtonStyle.Action" android:text="*" android:onClick="onOpClick" />
        <Button style="@style/ButtonStyle.Action" android:text="-" android:onClick="onOpClick" />
    </LinearLayout>

    <LinearLayout style="@style/RowStyle">
        <Button style="@style/ButtonStyle" android:text="7" android:onClick="onNumClick" />
        <Button style="@style/ButtonStyle" android:text="8" android:onClick="onNumClick" />
        <Button style="@style/ButtonStyle" android:text="9" android:onClick="onNumClick" />
        <Button style="@style/ButtonStyle.Action" android:text="+" android:onClick="onOpClick" />
    </LinearLayout>

    <LinearLayout style="@style/RowStyle">
        <Button style="@style/ButtonStyle" android:text="4" android:onClick="onNumClick" />
        <Button style="@style/ButtonStyle" android:text="5" android:onClick="onNumClick" />
        <Button style="@style/ButtonStyle" android:text="6" android:onClick="onNumClick" />
        <Button style="@style/ButtonStyle.Special" android:text="=" android:onClick="onEquals" />
    </LinearLayout>

    <LinearLayout style="@style/RowStyle">
        <Button style="@style/ButtonStyle" android:text="1" android:onClick="onNumClick" />
        <Button style="@style/ButtonStyle" android:text="2" android:onClick="onNumClick" />
        <Button style="@style/ButtonStyle" android:text="3" android:onClick="onNumClick" />
        <Button style="@style/ButtonStyle.Special" android:text="=" android:onClick="onEquals" android:visibility="invisible" />
    </LinearLayout>

    <LinearLayout style="@style/RowStyle">
        <Button style="@style/ButtonStyle" android:text="0" android:onClick="onNumClick" android:layout_weight="2" />
        <Button style="@style/ButtonStyle" android:text="." android:onClick="onNumClick" />
    </LinearLayout>

    <style name="RowStyle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="ButtonStyle" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:background">#2C2C2C</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="ButtonStyle.Action" parent="ButtonStyle">
        <item name="android:background">#3D3D3D</item>
        <item name="android:textColor">#00E676</item>
    </style>

    <style name="ButtonStyle.Special" parent="ButtonStyle">
        <item name="android:background">#6200EE</item>
    </style>
</LinearLayout>