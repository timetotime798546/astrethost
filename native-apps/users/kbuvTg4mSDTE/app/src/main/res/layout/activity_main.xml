<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F172A">

    <!-- Top Branding Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:background="#1E293B"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:elevation="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛠️ DevToolbox"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Offline Utility"
            android:textColor="#6366F1"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="#312E81"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"/>
    </LinearLayout>

    <!-- Custom Tailwind-style Tabs Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1E293B"
        android:paddingHorizontal="4dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tab_base64"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Base64"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_margin="4dp"
            android:background="#6366F1"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/tab_json"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="JSON Format"
            android:textColor="#94A3B8"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_margin="4dp"
            android:background="#334155"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/tab_hash"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hasher"
            android:textColor="#94A3B8"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_margin="4dp"
            android:background="#334155"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <!-- Scrollable Module Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <!-- TAB 1: BASE64 TOOL -->
        <ScrollView
            android:id="@+id/view_tab_base64"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Text-to-Base64 Encoder / Decoder"
                    android:textColor="#F8FAFC"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Input plaintext or base64 code string to process."
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp"/>

                <!-- Input Text Box -->
                <EditText
                    android:id="@+id/b64_input"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:background="#0F172A"
                    android:gravity="top|left"
                    android:hint="Type or paste your text here..."
                    android:textColorHint="#475569"
                    android:textColor="#F8FAFC"
                    android:textSize="14sp"
                    android:padding="12dp"
                    android:inputType="textMultiLine"
                    android:scrollbars="vertical"
                    android:layout_marginBottom="12dp"
                    android:layerType="software" />

                <!-- Control Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <Button
                        android:id="@+id/btn_b64_encode"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Encode"
                        android:textAllCaps="false"
                        android:background="#6366F1"
                        android:textColor="#FFFFFF"
                        android:layout_marginRight="4dp"/>

                    <Button
                        android:id="@+id/btn_b64_decode"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Decode"
                        android:textAllCaps="false"
                        android:background="#06B6D4"
                        android:textColor="#FFFFFF"
                        android:layout_marginLeft="4dp"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Result String"
                    android:textColor="#F8FAFC"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <!-- Output Box Layout -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#1E293B"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/b64_output"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minLines="3"
                        android:text=""
                        android:textColor="#10B981"
                        android:textSize="14sp"
                        android:textIsSelectable="true"
                        android:layout_marginBottom="40dp"/>

                    <Button
                        android:id="@+id/btn_b64_copy"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="📋 Copy"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textAllCaps="false"
                        android:background="#475569"
                        android:layout_alignParentBottom="true"
                        android:layout_alignParentRight="true"/>
                </RelativeLayout>

            </LinearLayout>
        </ScrollView>

        <!-- TAB 2: JSON FORMATTER TOOL -->
        <ScrollView
            android:id="@+id/view_tab_json"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Live JSON Formatter &amp; Validator"
                    android:textColor="#F8FAFC"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enter raw JSON. Syntax errors are highlighted in real-time."
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp"/>

                <!-- JSON Input Box -->
                <EditText
                    android:id="@+id/json_input"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:background="#0F172A"
                    android:gravity="top|left"
                    android:hint='{"key": "value", "array": [1, 2, 3]}'
                    android:textColorHint="#475569"
                    android:textColor="#F8FAFC"
                    android:textSize="14sp"
                    android:padding="12dp"
                    android:inputType="textMultiLine"
                    android:scrollbars="vertical"
                    android:layout_marginBottom="8dp"/>

                <!-- Live validation status bar -->
                <TextView
                    android:id="@+id/json_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Waiting for input..."
                    android:textColor="#94A3B8"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Formatted Output"
                    android:textColor="#F8FAFC"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <!-- Formatted Output Box -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#1E293B"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/json_output"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minLines="5"
                        android:text=""
                        android:textColor="#38BDF8"
                        android:textSize="13sp"
                        android:typeface="monospace"
                        android:textIsSelectable="true"
                        android:layout_marginBottom="40dp"/>

                    <Button
                        android:id="@+id/btn_json_copy"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="📋 Copy JSON"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textAllCaps="false"
                        android:background="#475569"
                        android:layout_alignParentBottom="true"
                        android:layout_alignParentRight="true"/>
                </RelativeLayout>

            </LinearLayout>
        </ScrollView>

        <!-- TAB 3: HASH GENERATOR TOOL -->
        <ScrollView
            android:id="@+id/view_tab_hash"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Live Hash Generator"
                    android:textColor="#F8FAFC"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Type plain text below to generate MD5 and SHA-256 hashes on-the-fly."
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp"/>

                <!-- Hash Plaintext Input -->
                <EditText
                    android:id="@+id/hash_input"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:background="#0F172A"
                    android:gravity="top|left"
                    android:hint="Start typing plain text..."
                    android:textColorHint="#475569"
                    android:textColor="#F8FAFC"
                    android:textSize="14sp"
                    android:padding="12dp"
                    android:inputType="textMultiLine"
                    android:scrollbars="vertical"
                    android:layout_marginBottom="16dp"/>

                <!-- MD5 Output Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#1E293B"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MD5 Hash"
                        android:textColor="#F8FAFC"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/hash_md5_output"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="d41d8cd98f00b204e9800998ecf8427e"
                        android:textColor="#F59E0B"
                        android:textSize="13sp"
                        android:typeface="monospace"
                        android:textIsSelectable="true"
                        android:layout_marginBottom="8dp"/>

                    <Button
                        android:id="@+id/btn_copy_md5"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Copy MD5"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textAllCaps="false"
                        android:background="#475569"
                        android:layout_gravity="right"/>
                </LinearLayout>

                <!-- SHA-256 Output Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#1E293B"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SHA-256 Hash"
                        android:textColor="#F8FAFC"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/hash_sha256_output"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
                        android:textColor="#10B981"
                        android:textSize="13sp"
                        android:typeface="monospace"
                        android:textIsSelectable="true"
                        android:layout_marginBottom="8dp"/>

                    <Button
                        android:id="@+id/btn_copy_sha256"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Copy SHA-256"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textAllCaps="false"
                        android:background="#475569"
                        android:layout_gravity="right"/>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </FrameLayout>
</LinearLayout>