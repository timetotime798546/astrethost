<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:orientation="vertical">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#00796B"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="POS Quick Billing"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Adding Product To Basket Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#FFFFFF">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Product to Sell"
            android:textColor="#777777"
            android:textSize="11sp"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinBillingProducts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edittext_bg"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/edtBillingQty"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="Qty to sell"
                android:inputType="number"
                android:background="@drawable/edittext_bg"
                android:layout_marginRight="8dp" />

            <Button
                android:id="@+id/btnAddToBill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add to Bill"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_primary"
                android:textStyle="bold"
                android:paddingHorizontal="20dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Cart items title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sales Basket Items"
        android:textColor="#333333"
        android:textStyle="bold"
        android:textSize="14sp"
        android:layout_margin="12dp" />

    <!-- Current Sales Basket Items -->
    <ListView
        android:id="@+id/listBillingCart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#E0E0E0"
        android:dividerHeight="1dp"
        android:paddingHorizontal="12dp" />

    <!-- Summary Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:padding="16dp"
        android:elevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="TOTAL OUTSTANDING:"
                android:textColor="#333333"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtBillingTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$0.00"
                android:textColor="#D32F2F"
                android:textStyle="bold"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCheckout"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Checkout Ledger"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_primary"
                android:textStyle="bold"
                android:layout_marginRight="6dp" />

            <Button
                android:id="@+id/btnShareInvoice"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Share WhatsApp"
                android:textColor="#333333"
                android:background="@drawable/btn_secondary"
                android:textStyle="bold"
                android:layout_marginLeft="6dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>