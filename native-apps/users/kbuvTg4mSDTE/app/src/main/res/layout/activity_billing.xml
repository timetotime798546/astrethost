<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#ECEFF1">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#2E7D32"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="POS Billing &amp; Invoicing Terminal"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:elevation="2dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Invoice Checkout details"
            android:textColor="#2E7D32"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etCustomerName"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="Customer Name"
            android:background="@android:drawable/editbox_background_normal"
            android:paddingLeft="8dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/etProductName"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="2"
                android:hint="Add Item Name"
                android:background="@android:drawable/editbox_background_normal"
                android:paddingLeft="8dp"
                android:layout_marginRight="4dp" />

            <EditText
                android:id="@+id/etProductPrice"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:hint="$ Price"
                android:inputType="numberDecimal"
                android:background="@android:drawable/editbox_background_normal"
                android:paddingLeft="8dp"
                android:layout_marginLeft="4dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnAddToCart"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="ADD ITEM TO CART"
            android:textColor="#FFFFFF"
            android:background="#1B5E20"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/etDiscountRate"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:hint="Discount ($)"
                android:inputType="numberDecimal"
                android:background="@android:drawable/editbox_background_normal"
                android:paddingLeft="8dp"
                android:layout_marginRight="4dp" />

            <!-- Tax Rate is fixed as 18% GST representing complex tax policies -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Tax Rate: 18% (GST)"
                android:textColor="#D84315"
                android:textStyle="bold"
                android:gravity="center_vertical"
                android:layout_marginLeft="4dp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#E8F5E9"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dynamic Billing Summary (Local Calculations)"
            android:textColor="#2E7D32"
            android:textStyle="bold"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvSubtotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Subtotal: $0.00"
            android:textColor="#333333"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvTaxCalculated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tax Calculated (18%): $0.00"
            android:textColor="#333333"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvTotalWithTax"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Grand Total: $0.00"
            android:textColor="#1B5E20"
            android:textStyle="bold"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Cart Layout -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Customer Shopping Cart"
        android:textColor="#37474F"
        android:textStyle="bold"
        android:textSize="14sp"
        android:layout_margin="12dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/layoutCartList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="12dp"
            android:paddingRight="12dp" />
    </ScrollView>

    <Button
        android:id="@+id/btnFinalizeInvoice"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="GENERATE DIGITAL INVOICE"
        android:textColor="#FFFFFF"
        android:background="#2E7D32"
        android:textStyle="bold"
        android:layout_margin="12dp" />
</LinearLayout>