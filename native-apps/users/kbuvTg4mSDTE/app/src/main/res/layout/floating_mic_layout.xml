<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="8dp">

    <!-- Active Status Text Bubble on Left -->
    <TextView
        android:id="@+id/status_text_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tap to listen"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="@drawable/status_bg"
        android:layout_marginRight="8dp"
        android:visibility="gone" />

    <!-- Mic Container Circular Icon -->
    <FrameLayout
        android:id="@+id/mic_container"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/circle_default"
        android:clickable="false"
        android:focusable="false">

        <TextView
            android:id="@+id/mic_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎙️"
            android:textSize="28sp"
            android:layout_gravity="center" />
    </FrameLayout>
</LinearLayout>