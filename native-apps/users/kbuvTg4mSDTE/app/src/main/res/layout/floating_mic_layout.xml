<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Active Status Text Bubble on Left -->
    <TextView
        android:id="@+id/status_text_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tap to listen"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:background="@drawable/status_bg"
        android:layout_marginEnd="10dp"
        android:layout_marginRight="10dp"
        android:elevation="4dp"
        android:visibility="gone" />

    <!-- AI Orb System -->
    <FrameLayout
        android:id="@+id/orb_system"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Glowing Breathing Outer Layer -->
        <View
            android:id="@+id/orb_glow"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:background="@drawable/circle_default"
            android:alpha="0.3" />

        <!-- Main Interactive Inner Orb Frame -->
        <FrameLayout
            android:id="@+id/mic_container"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_gravity="center"
            android:background="@drawable/circle_default"
            android:elevation="6dp"
            android:clickable="false"
            android:focusable="false">

            <TextView
                android:id="@+id/mic_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✦"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_gravity="center" />
        </FrameLayout>
    </FrameLayout>
</LinearLayout>