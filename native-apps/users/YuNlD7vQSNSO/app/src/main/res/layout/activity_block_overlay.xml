<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A252F"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <!-- Big Shield Icon -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔒"
        android:textSize="72sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="STRICT STUDY MODE"
        android:textColor="#E74C3C"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FOCUS LOCK ACTIVE"
        android:textColor="#ECF0F1"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="4dp" />

    <View
        android:layout_width="120dp"
        android:layout_height="2dp"
        android:background="#E74C3C"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="20dp" />

    <!-- Context Text -->
    <TextView
        android:id="@+id/txtBlockedAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Entertainment App Blocked"
        android:textColor="#F39C12"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="You requested a strict distraction lock. This application is restricted until your study period officially completes."
        android:textColor="#BDC3C7"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="32dp" />

    <!-- Slogan Text -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="“Great works are performed, not by strength, but by perseverance.”"
        android:textColor="#95A5A6"
        android:textSize="13sp"
        android:textStyle="italic"
        android:gravity="center"
        android:layout_marginBottom="40dp" />

    <!-- Button -->
    <Button
        android:id="@+id/btnReturnToStudy"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="GO BACK TO STUDYING"
        android:textColor="#FFFFFF"
        android:background="@drawable/btn_primary"
        android:textStyle="bold" />

</LinearLayout>