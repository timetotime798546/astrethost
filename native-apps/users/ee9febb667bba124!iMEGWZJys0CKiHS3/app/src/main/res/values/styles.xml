<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. -->
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <!-- Color custom configurations inside dark mode default styling -->
    </style>

    <!-- Calc Button Common Base -->
    <style name="CalcBtnBase">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">#ffffff</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Numerical buttons style -->
    <style name="CalcBtnNum" parent="CalcBtnBase">
        <item name="android:background">@drawable/btn_selector_num</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">#ffffff</item>
    </style>

    <!-- Operator buttons style (/, *, -, +) -->
    <style name="CalcBtnOperator" parent="CalcBtnBase">
        <item name="android:background">@drawable/btn_selector_operator</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">#ffffff</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Advanced Scientific Function Buttons (sin, cos, ln, etc) -->
    <style name="CalcBtnFunc" parent="CalcBtnBase">
        <item name="android:background">@drawable/btn_selector_func</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#81D4FA</item>
    </style>

    <!-- Special Clear and Backspace buttons -->
    <style name="CalcBtnSpecial" parent="CalcBtnBase">
        <item name="android:background">@drawable/btn_selector_special</item>
        <item name="android:textColor">#FF8A80</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Equals Button Style -->
    <style name="CalcBtnEqual" parent="CalcBtnBase">
        <item name="android:background">@drawable/btn_selector_equal</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#ffffff</item>
    </style>
</resources>