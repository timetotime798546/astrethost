<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚖️ Body Mass Index"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1ABC9C"
        android:layout_marginBottom="20dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Height (in Centimeters):"
        android:textStyle="bold"
        android:textColor="#2C3E50"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/edit_bmi_height"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="e.g., 175"
        android:inputType="numberDecimal"
        android:layout_marginBottom="16dp"
        android:minHeight="48dp"
        android:padding="10dp"
        android:background="#F8F9F9" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Weight (in Kilograms):"
        android:textStyle="bold"
        android:textColor="#2C3E50"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/edit_bmi_weight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="e.g., 70"
        android:inputType="numberDecimal"
        android:layout_marginBottom="24dp"
        android:minHeight="48dp"
        android:padding="10dp"
        android:background="#F8F9F9" />

    <Button
        android:id="@+id/btn_calc_bmi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CALCULATE BODY INDEX"
        android:textColor="#FFFFFF"
        android:background="#1ABC9C"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"
        android:minHeight="48dp" />

    <LinearLayout
        android:id="@+id/layout_bmi_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#F2F4F4"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:id="@+id/txt_bmi_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="22.4"
            android:textSize="44sp"
            android:textStyle="bold"
            android:textColor="#2ECC71" />

        <TextView
            android:id="@+id/txt_bmi_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HEALTHY RANGE"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#27AE60"
            android:layout_marginTop="4dp" />
    </LinearLayout>
</LinearLayout>