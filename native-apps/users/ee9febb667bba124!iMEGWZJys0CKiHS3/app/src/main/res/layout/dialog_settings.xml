<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gemini API Preferences"
            android:textColor="#00796B"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- API Key Inputs -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gemini API Key"
            android:textColor="#212121"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/et_api_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter your Gemini API key"
            android:inputType="textPassword"
            android:textSize="15sp"
            android:layout_marginBottom="16dp"
            android:padding="10dp"
            android:background="@drawable/bg_card" />

        <!-- Model Options Group -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Gemini Model"
            android:textColor="#212121"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <RadioGroup
            android:id="@+id/rg_models"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <RadioButton
                android:id="@+id/rb_model_25_flash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="gemini-2.5-flash (Recommended)" />

            <RadioButton
                android:id="@+id/rb_model_15_flash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="gemini-1.5-flash" />

            <RadioButton
                android:id="@+id/rb_model_15_pro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="gemini-1.5-pro" />

            <RadioButton
                android:id="@+id/rb_model_custom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Custom Model ID" />
        </RadioGroup>

        <!-- Dynamic Custom Model Input -->
        <LinearLayout
            android:id="@+id/layout_custom_model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Custom Model Identifier"
                android:textColor="#757575"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/et_custom_model"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. gemini-2.5-pro-preview"
                android:inputType="text"
                android:textSize="15sp"
                android:padding="10dp"
                android:background="@drawable/bg_card" />
        </LinearLayout>

        <!-- System instructions/Role setting -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="System Role / Voice Instructions"
            android:textColor="#212121"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/et_role"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="You are a helpful, brief voice assistant."
            android:inputType="textMultiLine"
            android:gravity="top"
            android:lines="3"
            android:textSize="15sp"
            android:layout_marginBottom="20dp"
            android:padding="10dp"
            android:background="@drawable/bg_card" />

        <!-- Actions buttons layout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="right"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_cancel_settings"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancel"
                android:textColor="#757575" />

            <Button
                android:id="@+id/btn_save_settings"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Save Settings"
                android:textColor="#00796B"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>