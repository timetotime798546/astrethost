<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0D1B">

    <!-- Game view container where the dynamically instantiated GameView is hosted -->
    <FrameLayout
        android:id="@+id/game_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Main Menu Interface overlay -->
    <LinearLayout
        android:id="@+id/menu_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="#E6070914">

        <!-- Title Design -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NEON FUEL"
            android:textColor="#00FFFF"
            android:textSize="48sp"
            android:textStyle="bold"
            android:shadowColor="#00A8A8"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="15" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HYPER SPEED RACER"
            android:textColor="#FF007F"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.2"
            android:shadowColor="#A80054"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="10"
            android:layout_marginBottom="40dp" />

        <!-- High Score tracker -->
        <TextView
            android:id="@+id/high_score_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BEST RECORD: 0000"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="30dp" />

        <!-- Difficulty selection -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SELECT TRACK DIFFICULTY:"
            android:textColor="#8A95A5"
            android:textSize="12sp"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/difficulty_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="35dp">

            <RadioButton
                android:id="@+id/diff_easy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EASY"
                android:textColor="#00FF66"
                android:textSize="14dp"
                android:buttonTint="#00FF66"
                android:layout_marginEnd="16dp"
                android:checked="true" />

            <RadioButton
                android:id="@+id/diff_med"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MEDIUM"
                android:textColor="#FFAA00"
                android:textSize="14dp"
                android:buttonTint="#FFAA00"
                android:layout_marginEnd="16dp" />

            <RadioButton
                android:id="@+id/diff_hard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRO"
                android:textColor="#FF3333"
                android:textSize="14dp"
                android:buttonTint="#FF3333" />
        </RadioGroup>

        <!-- Controls instructions box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#141A2F"
            android:padding="16dp"
            android:layout_marginBottom="40dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="HOW TO PLAY"
                android:textColor="#00FFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Drag your finger anywhere or tap left/right to steer.\n• Avoid colliding with incoming retro vehicles.\n• Grab yellow Energy Coins (+100 XP).\n• Grab Green Fuel Canisters to keep engine alive!"
                android:textColor="#C0CDDF"
                android:textSize="12sp"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

        <!-- Play Action Button -->
        <Button
            android:id="@+id/start_btn"
            android:layout_width="240dp"
            android:layout_height="55dp"
            android:backgroundTint="#00FFFF"
            android:text="START RACE"
            android:textColor="#070914"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Realtime HUD Display overlay -->
    <RelativeLayout
        android:id="@+id/hud_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:visibility="gone">

        <!-- Top HUD row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:id="@+id/hud_top">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/hud_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SCORE: 0"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/hud_level"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LEVEL 1"
                    android:textColor="#FF007F"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/hud_speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="180 MPH"
                android:textColor="#00FFFF"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Fuel indicator bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_alignParentBottom="true"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FUEL: "
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/hud_fuel_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:progress="100"
                android:max="100"
                android:progressTint="#00FF66" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Game Over overlay interface -->
    <LinearLayout
        android:id="@+id/game_over_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="#F20C0F1D"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CRASHED!"
            android:textColor="#FF3333"
            android:textSize="52sp"
            android:textStyle="bold"
            android:shadowColor="#990000"
            android:shadowRadius="15"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your performance levels dropped."
            android:textColor="#8A95A5"
            android:textSize="14sp"
            android:layout_marginBottom="40dp" />

        <!-- Score details card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#141A2F"
            android:padding="20dp"
            android:layout_marginBottom="40dp">

            <TextView
                android:id="@+id/go_final_score"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="FINAL SCORE: 0"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:gravity="center"
                android:layout_marginBottom="8dp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/go_coins"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="COINS COLLECTED: 0"
                android:textColor="#FFAA00"
                android:textSize="16sp"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/go_max_speed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TOP SPEED: 0 MPH"
                android:textColor="#00FFFF"
                android:textSize="16sp"
                android:gravity="center" />
        </LinearLayout>

        <Button
            android:id="@+id/replay_btn"
            android:layout_width="240dp"
            android:layout_height="50dp"
            android:backgroundTint="#FF007F"
            android:text="RACE AGAIN"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/go_menu_btn"
            android:layout_width="240dp"
            android:layout_height="50dp"
            android:backgroundTint="#313C52"
            android:text="MAIN MENU"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>