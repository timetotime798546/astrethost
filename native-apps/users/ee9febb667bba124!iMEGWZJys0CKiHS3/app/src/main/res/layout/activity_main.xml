<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5"
    android:padding="8dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LUDO CLASSIC"
            android:textColor="#37474F"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true" />

        <Button
            android:id="@+id/btnReset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Restart"
            android:textSize="12sp"
            android:backgroundTint="#CFD8DC"
            android:textColor="#37474F"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnMode2P"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="2 Players (Red/Yellow)"
            android:textSize="11sp"
            android:layout_marginRight="4dp" />

        <Button
            android:id="@+id/btnMode4P"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="4 Players"
            android:textSize="11sp"
            android:layout_marginLeft="4dp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:layout_gravity="center"
        android:layout_marginBottom="8dp">

        <com.ludoclassic.app.LudoBoardView
            android:id="@+id/ludoBoard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />
    </FrameLayout>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Red's Turn: Tap ROLL DICE"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="#EF5350"
        android:gravity="center"
        android:padding="10dp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <com.ludoclassic.app.DiceView
            android:id="@+id/diceView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="12dp" />

        <Button
            android:id="@+id/btnRoll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ROLL DICE"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="14dp"
            android:backgroundTint="#37474F"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="4dp">

        <LinearLayout
            android:id="@+id/statRed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp"
            android:background="#FFEBEE">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RED"
                android:textColor="#E53935"
                android:textStyle="bold"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/txtRedScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0/4 Home"
                android:textColor="#E53935"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/statGreen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp"
            android:background="#E8F5E9"
            android:layout_marginLeft="4dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GREEN"
                android:textColor="#4CAF50"
                android:textStyle="bold"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/txtGreenScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0/4 Home"
                android:textColor="#4CAF50"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/statYellow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp"
            android:background="#FFFDE7"
            android:layout_marginLeft="4dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YELLOW"
                android:textColor="#FBC02D"
                android:textStyle="bold"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/txtYellowScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0/4 Home"
                android:textColor="#FBC02D"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/statBlue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp"
            android:background="#E3F2FD"
            android:layout_marginLeft="4dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BLUE"
                android:textColor="#1E88E5"
                android:textStyle="bold"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/txtBlueScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0/4 Home"
                android:textColor="#1E88E5"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>