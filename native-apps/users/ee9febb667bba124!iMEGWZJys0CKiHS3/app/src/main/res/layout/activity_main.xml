<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F6FA">

    <!-- Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:background="#4A0E4E"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">
        
        <TextView
            android:id="@+id/toolbar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔮 Magic Math Calculator"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Tab Selection Bar - Style Attribute Removed to prevent Theme/Inflation Crash -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#EAEAEA">

        <Button
            android:id="@+id/btn_tab_calculator"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Calculator"
            android:textSize="11sp"
            android:background="#4A0E4E"
            android:textColor="#FFFFFF"
            android:padding="12dp"
            android:gravity="center" />

        <Button
            android:id="@+id/btn_tab_kaprekar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="6174 Magic"
            android:textSize="11sp"
            android:background="#FFFFFF"
            android:textColor="#4A0E4E"
            android:padding="12dp"
            android:gravity="center" />

        <Button
            android:id="@+id/btn_tab_mindreader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Mind Reader"
            android:textSize="11sp"
            android:background="#FFFFFF"
            android:textColor="#4A0E4E"
            android:padding="12dp"
            android:gravity="center" />
    </LinearLayout>

    <!-- Main Content Panels -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp">

        <!-- SECTION 1: Standard / Magic Calculator Layout -->
        <LinearLayout
            android:id="@+id/layout_calculator"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- Calculator Display Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:gravity="right|center_vertical"
                android:padding="16dp"
                android:layout_marginBottom="12dp">
                
                <TextView
                    android:id="@+id/txt_calc_expression"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#7F8C8D"
                    android:textSize="18sp"
                    android:text="" />

                <TextView
                    android:id="@+id/txt_calc_display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#2C3E50"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:text="0" />
            </LinearLayout>

            <!-- Buttons Grid Layer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
                
                <!-- Row 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">
                    <Button android:id="@+id/btn_c" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="C" android:textColor="#D32F2F" android:textSize="18sp" android:textStyle="bold" android:layout_marginRight="4dp"/>
                    <Button android:id="@+id/btn_back" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="⌫" android:textColor="#D32F2F" android:textSize="18sp" android:layout_marginRight="4dp"/>
                    <Button android:id="@+id/btn_magic_trick" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="🔮 1089" android:textColor="#8E44AD" android:textSize="13sp" android:textStyle="bold" android:layout_marginRight="4dp"/>
                    <Button android:id="@+id/btn_div" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="/" android:textColor="#2980B9" android:textSize="20sp" android:textStyle="bold"/>
                </LinearLayout>

                <!-- Row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">
                    <Button android:id="@+id/btn_7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="7" android:textSize="20sp" android:layout_marginRight="4dp"/>
                    <Button android:id="@+id/btn_8" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="8" android:textSize="20sp" android:layout_marginRight="4dp"/>
                    <Button android:id="@+id/btn_9" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="9" android:textSize="20sp" android:layout_marginRight="4dp"/>
                    <Button android:id="@+id/btn_mul" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="*" android:textColor="#2980B9" android:textSize="20sp" android:textStyle="bold"/>
                </LinearLayout>

                <!-- Row 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">
                    <Button android:id="@+id/btn_4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="4" android:textSize="20sp" android:layout_marginRight="4dp"/>
                    <Button android:id="@+id/btn_5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="5" android:textSize="20sp" android:layout_marginRight="4dp"/>
                    <Button android:id="@+id/btn_6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="6" android:textSize="20sp" android:layout_marginRight="4dp"/>
                    <Button android:id="@+id/btn_sub" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="-" android:textColor="#2980B9" android:textSize="20sp" android:textStyle="bold"/>
                </LinearLayout>

                <!-- Row 4 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">
                    <Button android:id="@+id/btn_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="1" android:textSize="20sp" android:layout_marginRight="4dp"/>
                    <Button android:id="@+id/btn_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="2" android:textSize="20sp" android:layout_marginRight="4dp"/>
                    <Button android:id="@+id/btn_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="3" android:textSize="20sp" android:layout_marginRight="4dp"/>
                    <Button android:id="@+id/btn_add" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="+" android:textColor="#2980B9" android:textSize="20sp" android:textStyle="bold"/>
                </LinearLayout>

                <!-- Row 5 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">
                    <Button android:id="@+id/btn_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2" android:text="0" android:textSize="20sp" android:layout_marginRight="4dp"/>
                    <Button android:id="@+id/btn_dot" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="." android:textSize="20sp" android:layout_marginRight="4dp"/>
                    <Button android:id="@+id/btn_eq" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="=" android:textColor="#FFFFFF" android:background="#4A0E4E" android:textSize="22sp" android:textStyle="bold"/>
                </LinearLayout>

             </LinearLayout>
        </LinearLayout>

        <!-- SECTION 2: Kaprekar's Constant (6174) Logic Tool -->
        <LinearLayout
            android:id="@+id/layout_kaprekar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kaprekar's Constant Magic (6174)"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#4A0E4E"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter any 4-digit number (with at least two distinct digits). The magic logic always reaches 6174 in 7 steps or less by ordering and subtracting digits!"
                android:textSize="12sp"
                android:textColor="#7F8C8D"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <EditText
                    android:id="@+id/edt_kaprekar_input"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:hint="e.g. 4812"
                    android:inputType="number"
                    android:maxLength="4"
                    android:textSize="16sp"
                    android:padding="12dp"
                    android:background="#FFFFFF"/>

                <Button
                    android:id="@+id/btn_kaprekar_calculate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Magicalize"
                    android:background="#4A0E4E"
                    android:textColor="#FFFFFF"
                    android:layout_marginLeft="8dp"/>
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#FFFFFF"
                android:padding="8dp">

                <TextView
                    android:id="@+id/txt_kaprekar_output"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Results will be shown here..."
                    android:textColor="#2C3E50"
                    android:textSize="14sp"
                    android:lineSpacingMultiplier="1.2"/>
            </ScrollView>
        </LinearLayout>

        <!-- SECTION 3: Mind Reader Game -->
        <LinearLayout
            android:id="@+id/layout_mindreader"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Game Intro Layout -->
            <LinearLayout
                android:id="@+id/layout_reader_intro"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🧙 Mind Reading Math Wizard"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#4A0E4E"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Think of a secret number between 1 and 63.\n\nUsing binary division cards, I will magically scan your mind and guess your exact choice!"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:textColor="#5F6C7D"
                    android:layout_marginBottom="24dp"
                    android:paddingLeft="24dp"
                    android:paddingRight="24dp"/>

                <Button
                    android:id="@+id/btn_reader_start"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Start Mind Reading"
                    android:background="#4A0E4E"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:paddingLeft="24dp"
                    android:paddingRight="24dp"/>
            </LinearLayout>

            <!-- Game Playing Layout -->
            <LinearLayout
                android:id="@+id/layout_reader_play"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txt_reader_step"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Card 1 of 6"
                    android:textColor="#4A0E4E"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Is your secret number present in this grid?"
                    android:textColor="#7F8C8D"
                    android:textSize="13sp"
                    android:layout_marginBottom="12dp"/>

                <!-- Grid Display Card Area -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="#4A0E4E"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/txt_reader_numbers_grid"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:gravity="center"
                        android:textStyle="bold"
                        android:lineSpacingMultiplier="1.4"
                        android:text="" />
                </LinearLayout>

                <!-- Input Answers -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_reader_no"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="❌ NO"
                        android:background="#D32F2F"
                        android:textColor="#FFFFFF"
                        android:layout_marginRight="8dp"/>

                    <Button
                        android:id="@+id/btn_reader_yes"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="✔ YES"
                        android:background="#388E3C"
                        android:textColor="#FFFFFF"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Game Reveal Result Layout -->
            <LinearLayout
                android:id="@+id/layout_reader_reveal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✨ YOUR SECRET NUMBER IS..."
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#7F8C8D"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/txt_reader_final_result"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="42"
                    android:textSize="80sp"
                    android:textStyle="bold"
                    android:textColor="#4A0E4E"
                    android:layout_marginBottom="24dp"/>

                <TextView
                    android:id="@+id/txt_reader_magic_explanation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Magical binary system logic reading completed."
                    android:textSize="12sp"
                    android:textColor="#95A5A6"
                    android:layout_marginBottom="24dp"
                    android:gravity="center"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"/>

                <Button
                    android:id="@+id/btn_reader_reset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Play Again"
                    android:background="#4A0E4E"
                    android:textColor="#FFFFFF"
                    android:paddingLeft="24dp"
                    android:paddingRight="24dp"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>