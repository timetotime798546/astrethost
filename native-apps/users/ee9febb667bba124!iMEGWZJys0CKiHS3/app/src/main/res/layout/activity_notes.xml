<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="16dp">

    <TextView
        android:id="@+id/txt_notes_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📝 Notebook"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#9B59B6"
        android:layout_marginBottom="16dp" />

    <ListView
        android:id="@+id/list_notes"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/txt_notes_header"
        android:layout_above="@+id/btn_create_note"
        android:layout_marginBottom="12dp"
        android:divider="#F2F3F4"
        android:dividerHeight="2dp" />

    <Button
        android:id="@+id/btn_create_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:text="+ WRITE NEW NOTE"
        android:textColor="#FFFFFF"
        android:background="#9B59B6"
        android:textSize="15sp"
        android:textStyle="bold"
        android:minHeight="48dp" />
</RelativeLayout>