<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Expense Log"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#2ECC71"
        android:layout_marginBottom="20dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Transaction Title:"
        android:textStyle="bold"
        android:textColor="#2C3E50"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/edit_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="e.g., Grocery Shopping"
        android:inputType="text"
        android:layout_marginBottom="16dp"
        android:minHeight="48dp"
        android:padding="10dp"
        android:background="#F8F9F9" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Value/Cost ($):"
        android:textStyle="bold"
        android:textColor="#2C3E50"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/edit_amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="0.00"
        android:inputType="numberDecimal"
        android:layout_marginBottom="16dp"
        android:minHeight="48dp"
        android:padding="10dp"
        android:background="#F8F9F9" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Category:"
        android:textStyle="bold"
        android:textColor="#2C3E50"
        android:layout_marginBottom="6dp" />

    <Spinner
        android:id="@+id/spinner_exp_category"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:minHeight="48dp" />

    <Button
        android:id="@+id/btn_save_expense"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SAVE TRANSACTION"
        android:textColor="#FFFFFF"
        android:background="#2ECC71"
        android:textSize="15sp"
        android:textStyle="bold"
        android:minHeight="48dp" />
</LinearLayout>