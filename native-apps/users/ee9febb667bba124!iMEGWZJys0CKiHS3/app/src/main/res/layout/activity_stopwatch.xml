<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#2C3E50"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⏱️ Stop Watch Pro"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="40dp" />

    <TextView
        android:id="@+id/txt_time_counter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="00:00.00"
        android:textSize="64sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:layout_marginBottom="40dp"
        android:fontFamily="monospace" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="24dp">

        <Button
            android:id="@+id/btn_stopwatch_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="START"
            android:textColor="#FFFFFF"
            android:background="#2ECC71"
            android:layout_marginEnd="12dp"
            android:minHeight="48dp"
            android:paddingHorizontal="20dp" />

        <Button
            android:id="@+id/btn_stopwatch_pause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PAUSE"
            android:textColor="#FFFFFF"
            android:background="#E67E22"
            android:layout_marginEnd="12dp"
            android:minHeight="48dp"
            android:paddingHorizontal="20dp" />

        <Button
            android:id="@+id/btn_stopwatch_reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RESET"
            android:textColor="#FFFFFF"
            android:background="#E74C3C"
            android:minHeight="48dp"
            android:paddingHorizontal="20dp" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Precision Performance Log:"
        android:textSize="13sp"
        android:textColor="#95A5A6"
        android:layout_marginBottom="8dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/txt_stopwatch_laps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="15sp"
            android:textColor="#ECF0F1"
            android:lineSpacingExtra="4dp"
            android:fontFamily="monospace" />
    </ScrollView>
</LinearLayout>