{
  "backend": true,
  "api_base_url": "https://trumpledroid-api.cloudbeta28624.workers.dev",
  "roles": {
    "user": ["own"]
  },
  "collections": {
    "user_records": {
      "fields": {
        "title": "string",
        "content": "string",
        "category": "string",
        "priority_level": "integer",
        "completed": "boolean"
      },
      "operations": ["create", "read", "update", "delete"]
    }
  },
  "logic": {
    "completion_rate": {
      "type": "calculation",
      "inputs": ["completed_count", "total_count"],
      "formula": "(completed_count * 100) / total_count"
    },
    "high_priority_ratio": {
      "type": "calculation",
      "inputs": ["high_priority_count", "total_count"],
      "formula": "(high_priority_count * 100) / total_count"
    }
  }
}