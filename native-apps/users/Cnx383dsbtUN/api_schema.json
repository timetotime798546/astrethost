{
  "backend": false,
  "roles": {},
  "collections": {},
  "logic": {
    "race_score": {
      "type": "calculation",
      "inputs": ["distance", "coins", "speed_multiplier"],
      "formula": "(distance * speed_multiplier) + (coins * 50)"
    },
    "upgrade_cost": {
      "type": "calculation",
      "inputs": ["current_level", "base_cost"],
      "formula": "base_cost * (current_level + 1)"
    }
  }
}