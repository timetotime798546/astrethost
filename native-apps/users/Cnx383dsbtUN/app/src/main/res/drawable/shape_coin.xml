<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Glow Rim -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#B8860B" />
            <size android:width="190dp" android:height="190dp" />
        </shape>
    </item>
    <!-- Mid Ridge -->
    <item android:top="8dp" android:bottom="8dp" android:left="8dp" android:right="8dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#FFE57F"
                android:centerColor="#FFD700"
                android:endColor="#C67D00"
                android:type="linear" />
            <stroke android:width="4dp" android:color="#FFF8E1" />
        </shape>
    </item>
    <!-- Inner Core -->
    <item android:top="22dp" android:bottom="22dp" android:left="22dp" android:right="22dp">
        <shape android:shape="oval">
            <gradient
                android:angle="90"
                android:startColor="#B27400"
                android:centerColor="#FFD54F"
                android:endColor="#FFF9C4"
                android:type="linear" />
            <stroke android:width="3dp" android:color="#FFECB3" />
        </shape>
    </item>
</layer-list>