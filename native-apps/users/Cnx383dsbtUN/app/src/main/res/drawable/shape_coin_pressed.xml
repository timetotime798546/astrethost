<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#996515" />
            <size android:width="190dp" android:height="190dp" />
        </shape>
    </item>
    <item android:top="12dp" android:bottom="12dp" android:left="12dp" android:right="12dp">
        <shape android:shape="oval">
            <gradient
                android:angle="90"
                android:startColor="#FFB300"
                android:endColor="#FFD54F"
                android:type="linear" />
            <stroke android:width="3dp" android:color="#FFD700" />
        </shape>
    </item>
</layer-list>