<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- 3D Road Perspective Surface Canvas -->
    <com.turbo3dracer.app.GameView
        android:id="@+id/game_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Digital HUD Overlay -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/hud_bg"
        android:padding="8dp"
        android:gravity="center_vertical">

        <!-- Speedometer -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SPEED"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tv_hud_speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 KM/H"
                android:textColor="@color/neon_blue"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Distance -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="24dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DISTANCE"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tv_hud_distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 M"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Coins -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="24dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CREDITS"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tv_hud_coins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 CR"
                android:textColor="@color/neon_amber"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Dynamic Score -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="end"
            android:paddingRight="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SCORE"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tv_hud_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/neon_green"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_pause"
            android:layout_width="48dp"
            android:layout_height="38dp"
            android:text="II"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:background="@color/bg_card" />
    </LinearLayout>

    <!-- Bottom Left Steering Controls -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:orientation="horizontal"
        android:layout_margin="16dp">

        <Button
            android:id="@+id/btn_steer_left"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:text="&lt;"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:background="@color/hud_bg" />

        <Button
            android:id="@+id/btn_steer_right"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginLeft="14dp"
            android:text="&gt;"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:background="@color/hud_bg" />
    </LinearLayout>

    <!-- Bottom Right Pedals & Nitro -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:orientation="horizontal"
        android:layout_margin="16dp">

        <!-- Nitro Button with Level Fill Indicator -->
        <LinearLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:orientation="vertical"
            android:gravity="center">

            <Button
                android:id="@+id/btn_nitro"
                android:layout_width="72dp"
                android:layout_height="56dp"
                android:text="NITRO"
                android:textColor="@color/bg_dark"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@color/neon_blue" />

            <ProgressBar
                android:id="@+id/pb_nitro_bar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:max="100"
                android:progress="100"
                android:progressTint="@color/neon_blue" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_brake"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginLeft="14dp"
            android:text="BRAKE"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@color/hud_bg" />

        <Button
            android:id="@+id/btn_gas"
            android:layout_width="84dp"
            android:layout_height="72dp"
            android:layout_marginLeft="14dp"
            android:text="GAS"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="@color/neon_pink" />
    </LinearLayout>

    <!-- Pause / Game Over Modal -->
    <LinearLayout
        android:id="@+id/layout_modal"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@color/bg_card"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_modal_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="RACE PAUSED"
            android:textColor="@color/neon_blue"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_modal_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Current Score: 0"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btn_modal_action"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/resume"
            android:textColor="@color/bg_dark"
            android:textStyle="bold"
            android:background="@color/neon_green"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/btn_modal_exit"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/quit"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:background="@color/bg_dark"
            android:layout_marginTop="10dp" />
    </LinearLayout>

</FrameLayout>