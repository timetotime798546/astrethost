<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RECOVER ACCESS"
            android:textColor="@color/accent_gold"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card_bg"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Step 1: Request OTP"
                android:textColor="@color/text_white"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Registered Email"
                android:inputType="textEmailAddress"
                android:textColor="@color/text_white"
                android:textColorHint="#66BB6A"
                android:background="#0A1E0E"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnSendOtp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="SEND OTP CODE"
                android:textColor="#041A0A"
                android:backgroundTint="@color/accent_gold"
                android:layout_marginBottom="20dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/card_border"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Step 2: Enter OTP &amp; New Password"
                android:textColor="@color/text_white"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etOtp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="6-Digit OTP"
                android:inputType="number"
                android:textColor="@color/text_white"
                android:textColorHint="#66BB6A"
                android:background="#0A1E0E"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/etNewPassword"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="New Password"
                android:inputType="textPassword"
                android:textColor="@color/text_white"
                android:textColorHint="#66BB6A"
                android:background="#0A1E0E"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnResetPassword"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="SAVE NEW PASSWORD"
                android:textColor="#FFFFFF"
                android:backgroundTint="@color/turf_green" />

        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>