<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card_dark"
    android:layout_marginBottom="10dp"
    android:padding="12dp">

    <!-- Station Badge / Frequency -->
    <LinearLayout
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="#2E3754"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="2dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_radio" />

        <TextView
            android:id="@+id/txtItemFreq"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="94.5"
            android:textColor="@color/accent_cyan"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/txtItemName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Groove Salad"
            android:textColor="@color/text_white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:singleLine="true" />

        <TextView
            android:id="@+id/txtItemGenre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Chillout / Ambient • English"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:singleLine="true" />

        <TextView
            android:id="@+id/txtItemCountry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="United States"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Action / Favorite -->
    <ImageView
        android:id="@+id/btnItemFav"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:src="@drawable/ic_favorite_off"
        android:background="?android:attr/selectableItemBackgroundBorderless" />

</LinearLayout>