<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- 3D Stadium & Pitch Engine -->
    <com.cricketpro3d.app.Cricket3DView
        android:id="@+id/cricket3DView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Scoreboard HUD -->
    <LinearLayout
        android:id="@+id/topScoreboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#DD041A0A"
        android:padding="12dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvMatchMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SUPER OVER CHASE"
                android:textColor="@color/accent_gold"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTarget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="Target: 18 runs"
                android:textColor="@color/text_white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <!-- Score Display -->
            <TextView
                android:id="@+id/tvLiveScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 / 0"
                android:textColor="@color/text_white"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOvers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" (0.0 Ovs)"
                android:textColor="@color/text_sub"
                android:textSize="16sp"
                android:layout_gravity="bottom"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="3dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Required Run Rate -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/tvEquation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Need 18 off 6"
                    android:textColor="@color/accent_gold"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRRR"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RRR: 18.0 | SR: 0.0"
                    android:textColor="@color/text_sub"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Over breakdown balls summary -->
        <TextView
            android:id="@+id/tvOverBalls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="THIS OVER: [ - - - - - - ]"
            android:textColor="@color/text_white"
            android:textSize="11sp"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <!-- Center Screen Commentary / Timing Feedback -->
    <TextView
        android:id="@+id/tvFeedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/topScoreboard"
        android:layout_marginTop="20dp"
        android:background="#CC132418"
        android:textColor="@color/accent_gold"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Bottom Controls Deck -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="#E60A130C"
        android:padding="12dp">

        <!-- Shot Type & Bowl Button Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnToggleElevation"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="SHOT: GROUND"
                android:textSize="12sp"
                android:textColor="@color/text_white"
                android:backgroundTint="#2E4A35"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnNextBall"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1.2"
                android:text="BOWL NEXT"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#041A0A"
                android:backgroundTint="@color/accent_gold" />
        </LinearLayout>

        <!-- Shot Direction & SWING BAT TRIGGER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnLegSide"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="&lt; LEG"
                android:textColor="@color/text_white"
                android:textStyle="bold"
                android:backgroundTint="#1B3822"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnStraight"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="STRAIGHT"
                android:textColor="#041A0A"
                android:textStyle="bold"
                android:backgroundTint="@color/accent_gold"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnOffSide"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="OFF &gt;"
                android:textColor="@color/text_white"
                android:textStyle="bold"
                android:backgroundTint="#1B3822"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnHit"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.4"
                android:text="SWING BAT!"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="@color/accent_red" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>