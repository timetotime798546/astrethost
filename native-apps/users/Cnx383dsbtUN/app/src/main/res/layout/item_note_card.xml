<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/tvCardTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Record Title"
            android:textColor="@color/text_main"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCardBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#E0F2FE"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="Priority 1"
            android:textColor="@color/primary"
            android:textSize="11sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvCardCategory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Category: General"
        android:textColor="@color/text_sub"
        android:textSize="12sp"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/tvCardContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Record description and encrypted contents displayed here."
        android:textColor="@color/text_main"
        android:textSize="13sp"
        android:layout_marginBottom="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvCardStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Status: Pending"
            android:textColor="@color/warning"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnToggleComplete"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Toggle Done"
            android:background="#E2E8F0"
            android:textColor="@color/text_main"
            android:textSize="11sp"
            android:paddingHorizontal="8dp"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnDeleteCard"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Delete"
            android:background="#FEE2E2"
            android:textColor="@color/danger"
            android:textSize="11sp"
            android:paddingHorizontal="8dp" />

    </LinearLayout>

</LinearLayout>