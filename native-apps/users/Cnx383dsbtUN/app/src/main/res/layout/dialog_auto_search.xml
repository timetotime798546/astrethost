<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface_card"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Discover Radio Stations"
        android:textColor="@color/text_white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Search thousands of verified live public broadcast streams by name, genre, country, or language."
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/editDialogStationName"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_search_input"
        android:hint="Station Name (e.g. BBC, Jazz, FM)"
        android:inputType="text"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/text_white"
        android:textColorHint="@color/text_muted"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/editDialogGenre"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_search_input"
        android:hint="Genre / Tag (e.g. Rock, News, Chill)"
        android:inputType="text"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/text_white"
        android:textColorHint="@color/text_muted"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/editDialogCountry"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_search_input"
        android:hint="Country (e.g. United States, Germany, India)"
        android:inputType="text"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/text_white"
        android:textColorHint="@color/text_muted"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/editDialogLanguage"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_search_input"
        android:hint="Language (e.g. English, Spanish, French)"
        android:inputType="text"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/text_white"
        android:textColorHint="@color/text_muted"
        android:textSize="13sp" />

</LinearLayout>