<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_glass_card"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Document Thumbnail -->
        <ImageView
            android:id="@+id/ivDocThumb"
            android:layout_width="60dp"
            android:layout_height="75dp"
            android:background="#12131A"
            android:scaleType="centerCrop"
            android:contentDescription="Thumbnail" />

        <!-- Info metadata -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginLeft="14dp">

            <TextView
                android:id="@+id/tvDocTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Invoice_2024.pdf"
                android:textColor="#F1F5F9"
                android:textSize="16sp"
                android:textStyle="bold"
                android:singleLine="true" />

            <TextView
                android:id="@+id/tvDocDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Oct 24, 2024 14:30"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:layout_marginTop="3dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PDF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#00E5FF"
                    android:background="#1F364D"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />

                <TextView
                    android:id="@+id/tvDocSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="245 KB"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:layout_marginLeft="8dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2E364A"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp" />

    <!-- Action buttons row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="right">

        <Button
            android:id="@+id/btnShareDoc"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="Share"
            android:textSize="11sp"
            android:textColor="#00E5FF"
            android:background="#2E364A"
            android:layout_marginRight="8dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp" />

        <Button
            android:id="@+id/btnDeleteDoc"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="Delete"
            android:textSize="11sp"
            android:textColor="#EF4444"
            android:background="#2E364A"
            android:paddingLeft="12dp"
            android:paddingRight="12dp" />
    </LinearLayout>

</LinearLayout>