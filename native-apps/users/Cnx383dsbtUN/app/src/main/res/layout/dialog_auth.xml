<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_card_dark"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvAuthDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Arcade Player Login"
        android:textColor="@color/accent_gold"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/tvAuthDialogSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sign in to sync high scores and claim cloud reward points."
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:layout_marginBottom="14dp" />

    <EditText
        android:id="@+id/etPlayerEmail"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_input_box"
        android:hint="Player Email"
        android:inputType="textEmailAddress"
        android:paddingHorizontal="12dp"
        android:textColor="@color/text_white"
        android:textColorHint="@color/text_muted"
        android:textSize="14sp"
        android:layout_marginBottom="10dp" />

    <EditText
        android:id="@+id/etPlayerPassword"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_input_box"
        android:hint="Password (min 6 chars)"
        android:inputType="textPassword"
        android:paddingHorizontal="12dp"
        android:textColor="@color/text_white"
        android:textColorHint="@color/text_muted"
        android:textSize="14sp"
        android:layout_marginBottom="14dp" />

    <ProgressBar
        android:id="@+id/pbDialogAuth"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvAuthError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/neon_red"
        android:textSize="12sp"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnSubmitPlayerAuth"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_upgrade_button"
        android:text="SIGN IN"
        android:textColor="@color/text_white"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvToggleSignup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Need Account? Sign Up"
            android:textColor="@color/neon_cyan"
            android:textSize="13sp"
            android:padding="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" • "
            android:textColor="@color/text_muted" />

        <TextView
            android:id="@+id/tvDialogForgotPass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Forgot Pass?"
            android:textColor="@color/accent_gold"
            android:textSize="13sp"
            android:padding="8dp" />

    </LinearLayout>

</LinearLayout>