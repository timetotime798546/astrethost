<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/card_bg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reset Password"
        android:textColor="@color/text_main"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvDialogInstructions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enter your account email to receive an OTP."
        android:textColor="@color/text_sub"
        android:textSize="13sp"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etResetEmail"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:hint="Registered Email"
        android:inputType="textEmailAddress"
        android:background="@drawable/bg_input"
        android:paddingHorizontal="12dp"
        android:textSize="14sp"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnRequestOtp"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:text="Send OTP to Gmail"
        android:textColor="#FFFFFF"
        android:background="@drawable/bg_button"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:id="@+id/layoutOtpSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <EditText
            android:id="@+id/etOtpCode"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="Enter 6-digit OTP"
            android:inputType="number"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="12dp"
            android:textSize="14sp"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/etNewPassword"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="Enter New Password"
            android:inputType="textPassword"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="12dp"
            android:textSize="14sp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnSubmitReset"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="Verify OTP &amp; Reset Password"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/pbResetProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvResetFeedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/danger"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

</LinearLayout>