<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_card_dark"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reset Player Password"
        android:textColor="@color/accent_gold"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/tvResetSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enter registered email to receive verification OTP via Gmail."
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etResetEmail"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_input_box"
        android:hint="Registered Gmail"
        android:inputType="textEmailAddress"
        android:paddingHorizontal="12dp"
        android:textColor="@color/text_white"
        android:textColorHint="@color/text_muted"
        android:textSize="14sp"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnSendOtp"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="@drawable/bg_upgrade_button"
        android:text="SEND OTP TO GMAIL"
        android:textColor="@color/text_white"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:id="@+id/layoutResetInputs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <EditText
            android:id="@+id/etResetOtp"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_input_box"
            android:hint="6-Digit OTP Code"
            android:inputType="number"
            android:paddingHorizontal="12dp"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_muted"
            android:textSize="14sp"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/etNewPassword"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_input_box"
            android:hint="Enter New Password (min 6)"
            android:inputType="textPassword"
            android:paddingHorizontal="12dp"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_muted"
            android:textSize="14sp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnConfirmPasswordReset"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/bg_claim_button"
            android:text="VERIFY &amp; RESET PASSWORD"
            android:textColor="@color/text_white"
            android:textStyle="bold" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/pbResetOtpProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvResetStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/neon_red"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

</LinearLayout>