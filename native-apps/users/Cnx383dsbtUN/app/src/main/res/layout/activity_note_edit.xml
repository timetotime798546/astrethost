<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/edit_root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_light">

    <!-- Top Action Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/btn_back_note"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/btn_outline"
            android:text="← Back"
            android:textAllCaps="false"
            android:textColor="@color/text_main"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_editor_mode_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="New Note"
            android:textColor="@color/primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_toggle_pin"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/btn_outline"
            android:text="☆ Pin"
            android:textAllCaps="false"
            android:textColor="@color/amber"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_save_note"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/btn_primary"
            android:paddingHorizontal="16dp"
            android:text="Save"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Live Local Calculation Counter Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#EDF2F7"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/tv_live_word_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Words: 0 | Characters: 0"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_live_read_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Read time: 0 min"
            android:textColor="@color/primary_accent"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Meta Pickers (Category & Color) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Category:"
            android:textColor="@color/text_main"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinner_category"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Theme:"
            android:textColor="@color/text_main"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinner_color"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress_editor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- Title and Content Fields -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <EditText
            android:id="@+id/et_note_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/input_bg"
            android:hint="Note Title"
            android:padding="12dp"
            android:textColor="@color/text_main"
            android:textColorHint="@color/text_muted"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_note_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:background="@drawable/input_bg"
            android:gravity="top|start"
            android:hint="Start typing your note here..."
            android:inputType="textMultiLine"
            android:padding="12dp"
            android:textColor="@color/text_main"
            android:textColorHint="@color/text_muted"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>