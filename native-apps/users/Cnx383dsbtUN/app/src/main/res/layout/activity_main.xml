<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CRICKET PRO 3D"
                android:textColor="@color/accent_gold"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnMenuSoundToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="SFX: ON 🔊"
                    android:textSize="11sp"
                    android:textColor="@color/accent_gold"
                    android:backgroundTint="#1B3822"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnLogout"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Sign Out"
                    android:textSize="11sp"
                    android:textColor="@color/text_white"
                    android:backgroundTint="#2E4A35" />
            </LinearLayout>
        </RelativeLayout>

        <TextView
            android:id="@+id/tvPlayerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Player: cricketer@game.com"
            android:textColor="@color/text_sub"
            android:textSize="13sp"
            android:layout_marginBottom="18dp" />

        <!-- Career Dashboard Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card_bg"
            android:padding="16dp"
            android:elevation="4dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CAREER DASHBOARD"
                android:textColor="@color/accent_gold"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TOTAL RUNS"
                        android:textColor="@color/text_sub"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/tvTotalRuns"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/text_white"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HIGH SCORE"
                        android:textColor="@color/text_sub"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/tvHighScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0*"
                        android:textColor="@color/accent_gold"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TROPHIES / WINS"
                        android:textColor="@color/text_sub"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/tvWins"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/text_white"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">
                <TextView
                    android:id="@+id/tvBoundaries"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Boundary Hits: 0 Sixes | 0 Fours"
                    android:textColor="@color/text_sub"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Touch Controls Guide Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1B3822"
            android:padding="14dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎮 SWIPE GESTURE CONTROLS ENABLED"
                android:textColor="@color/accent_gold"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Swipe your finger across the pitch screen in any direction to swing the bat. Swipe UP for lofted maximum sixes, swipe LEFT for leg glances, or swipe RIGHT for off-side cover drives!"
                android:textColor="@color/text_white"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Game Modes Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SELECT 3D MATCH MODE"
            android:textColor="@color/text_white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Mode 1: Super Over Thriller -->
        <LinearLayout
            android:id="@+id/cardSuperOver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ SUPER OVER THRILLER"
                android:textColor="@color/accent_gold"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chase 18 runs off 6 balls in high pressure death bowling! 2 wickets in hand."
                android:textColor="@color/text_sub"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnPlaySuperOver"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="PLAY SUPER OVER"
                android:textColor="#041A0A"
                android:textStyle="bold"
                android:backgroundTint="@color/accent_gold" />
        </LinearLayout>

        <!-- Mode 2: T20 2-Over Chase -->
        <LinearLayout
            android:id="@+id/cardT20Chase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏏 2-OVER T20 CHASE"
                android:textColor="@color/text_white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chase 32 runs off 12 balls with pace and spin variations. 3 wickets in hand."
                android:textColor="@color/text_sub"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnPlayT20"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="PLAY 2-OVER CHASE"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="@color/turf_green" />
        </LinearLayout>

        <!-- Mode 3: Nets / Batting Practice -->
        <LinearLayout
            android:id="@+id/cardNets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎯 NETS BATTING PRACTICE"
                android:textColor="@color/text_white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Master swing, seam, yorker, and spin timing with unlimited deliveries."
                android:textColor="@color/text_sub"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnPlayNets"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="ENTER PRACTICE NETS"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="#2E4A35" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>