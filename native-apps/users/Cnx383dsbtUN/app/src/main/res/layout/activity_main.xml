<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/primary_dark">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/surface_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_radio" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/text_white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tagline"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnSleepTimerTop"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:src="@drawable/ic_timer"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

        <ImageView
            android:id="@+id/btnMenuOptions"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:src="@drawable/ic_radio"
            android:background="?android:attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- PLAYER CARD (HERO) -->
            <LinearLayout
                android:id="@+id/playerCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_player_gradient"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/txtLiveBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ONLINE FM"
                        android:textColor="@color/accent_cyan"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:background="#2E3754"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp" />

                    <TextView
                        android:id="@+id/txtTimerStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text=""
                        android:textColor="@color/accent_yellow"
                        android:textSize="11sp" />

                    <ImageView
                        android:id="@+id/btnHeroFav"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:padding="6dp"
                        android:src="@drawable/ic_favorite_off"
                        android:background="?android:attr/selectableItemBackgroundBorderless" />
                </LinearLayout>

                <!-- Station Big Name & Genre -->
                <TextView
                    android:id="@+id/txtCurrentStationName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/not_playing"
                    android:textColor="@color/text_white"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:gravity="center_horizontal" />

                <TextView
                    android:id="@+id/txtCurrentStationInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Tap any station below to tune in"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:gravity="center_horizontal" />

                <!-- Status Indicator -->
                <TextView
                    android:id="@+id/txtPlaybackStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/status_stopped"
                    android:textColor="@color/accent_cyan"
                    android:textSize="12sp"
                    android:gravity="center_horizontal" />

                <ProgressBar
                    android:id="@+id/progressBuffering"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="8dp"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <!-- Controls -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <!-- Stop Button -->
                    <ImageView
                        android:id="@+id/btnStop"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="12dp"
                        android:src="@drawable/ic_stop"
                        android:background="?android:attr/selectableItemBackgroundBorderless" />

                    <Space
                        android:layout_width="24dp"
                        android:layout_height="wrap_content" />

                    <!-- Play/Pause Big Button -->
                    <ImageButton
                        android:id="@+id/btnPlayPause"
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:src="@drawable/ic_play"
                        android:background="@drawable/bg_button_circle"
                        android:contentDescription="@string/btn_play" />

                    <Space
                        android:layout_width="24dp"
                        android:layout_height="wrap_content" />

                    <!-- Quick Timer Button -->
                    <ImageView
                        android:id="@+id/btnHeroTimer"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="12dp"
                        android:src="@drawable/ic_timer"
                        android:background="?android:attr/selectableItemBackgroundBorderless" />
                </LinearLayout>

            </LinearLayout>

            <!-- TABS (All, Favorites, Recent) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_card_dark">

                <Button
                    android:id="@+id/tabAll"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:text="@string/tab_all"
                    android:textAllCaps="false"
                    android:textColor="@color/accent_cyan"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/tabFavorites"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:text="@string/tab_favorites"
                    android:textAllCaps="false"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/tabRecent"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:text="@string/tab_recent"
                    android:textAllCaps="false"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Search and Filter Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/editSearch"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_search_input"
                    android:drawableStart="@drawable/ic_radio"
                    android:drawablePadding="10dp"
                    android:hint="@string/search_hint"
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/text_white"
                    android:textColorHint="@color/text_muted"
                    android:textSize="14sp" />

                <Spinner
                    android:id="@+id/spinnerGenre"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_card_dark"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />

            </LinearLayout>

            <!-- Station List Section -->
            <TextView
                android:id="@+id/txtListHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="Popular Broadcasts (10)"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Empty State Container -->
            <TextView
                android:id="@+id/txtEmptyView"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:gravity="center"
                android:text="No stations found matching your search or filters."
                android:textColor="@color/text_muted"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- Dynamic Container for Stations -->
            <LinearLayout
                android:id="@+id/containerStations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>