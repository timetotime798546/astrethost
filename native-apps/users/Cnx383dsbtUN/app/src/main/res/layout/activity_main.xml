<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#12131A">

    <!-- Top Fixed Glassmorphic Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="#1E222D"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DOC"
            android:textColor="#00E5FF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SCAN PRO"
            android:textColor="#F1F5F9"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginLeft="4dp" />

        <TextView
            android:id="@+id/tvHeaderBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PDF CREATOR"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:background="#2A3042"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp" />
    </LinearLayout>

    <!-- Main Screens Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- TAB 1: Camera & Scan Screen -->
        <ScrollView
            android:id="@+id/screenScan"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Capture Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_glass_card"
                    android:padding="20dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Instant Camera Scanner"
                        android:textColor="#F1F5F9"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Capture paper receipts, invoices, IDs, and notes into clean PDFs"
                        android:textColor="#94A3B8"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:layout_marginTop="6dp" />

                    <Button
                        android:id="@+id/btnLaunchCamera"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="Open Camera Scanner"
                        android:textStyle="bold"
                        android:textColor="#12131A"
                        android:background="#00E5FF"
                        android:layout_marginTop="20dp" />

                    <Button
                        android:id="@+id/btnPickGallery"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="Import From Gallery"
                        android:textColor="#F1F5F9"
                        android:background="#2E364A"
                        android:layout_marginTop="10dp" />
                </LinearLayout>

                <!-- Feature Highlights -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SCANNER SUITE FEATURES"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_glass_card"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Magic Color &amp; Grayscale Document Enhancement"
                        android:textColor="#94A3B8"
                        android:textSize="13sp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Interactive Document Redaction (Brush &amp; Rect Box)"
                        android:textColor="#94A3B8"
                        android:textSize="13sp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Native Offline PDF Generation (A4 Compliant)"
                        android:textColor="#94A3B8"
                        android:textSize="13sp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Private Offline Storage &amp; Search Gallery"
                        android:textColor="#94A3B8"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- TAB 2: Documents Gallery Screen -->
        <LinearLayout
            android:id="@+id/screenDocuments"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <!-- Search box -->
            <EditText
                android:id="@+id/etSearchDocs"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_glass_card"
                android:hint="Search documents by name..."
                android:textColorHint="#64748B"
                android:textColor="#F1F5F9"
                android:textSize="14sp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:singleLine="true" />

            <TextView
                android:id="@+id/tvEmptyGallery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No scanned documents yet.\nTap 'Camera/Scan' to capture your first document."
                android:textColor="#94A3B8"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginTop="40dp"
                android:visibility="gone" />

            <!-- Document items container -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:id="@+id/layoutDocumentsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

        </LinearLayout>

        <!-- TAB 3: Settings Screen -->
        <ScrollView
            android:id="@+id/screenSettings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Preferences &amp; Engine"
                    android:textColor="#F1F5F9"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_glass_card"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PDF Standard"
                        android:textColor="#F1F5F9"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ISO 32000-1 / A4 72 DPI Vector Native"
                        android:textColor="#94A3B8"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#2E364A"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Storage Location"
                        android:textColor="#F1F5F9"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Encrypted Sandbox Internal App Storage"
                        android:textColor="#94A3B8"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnClearAllDocs"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Clear All Saved Documents"
                    android:textColor="#EF4444"
                    android:background="#2E364A" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="DocScan Pro v1.0 • Native Engine"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:layout_marginTop="32dp" />
            </LinearLayout>
        </ScrollView>

    </FrameLayout>

    <!-- Bottom Navigation Bar with 3 Tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_bottom_nav">

        <LinearLayout
            android:id="@+id/navTabScan"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvNavScan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Camera / Scan"
                android:textColor="#00E5FF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navTabDocs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvNavDocs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Documents"
                android:textColor="#94A3B8"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navTabSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvNavSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textColor="#94A3B8"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>