<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_arcade"
    android:padding="16dp">

    <!-- Top Header: Title, Live Event Notice, & Player Session -->
    <LinearLayout
        android:id="@+id/layoutTopHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="vertical">

        <!-- Banner bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚡ TAP COIN ARCADE ⚡"
                android:textColor="@color/accent_gold"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAccountAction"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_upgrade_button"
                android:paddingHorizontal="12dp"
                android:text="PLAYER SIGN IN"
                android:textColor="@color/text_white"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Live Admin Announcement Banner -->
        <TextView
            android:id="@+id/tvAdminNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_arcade_card"
            android:gravity="center"
            android:padding="8dp"
            android:text="⚡ 2X FRENZY EVENT ACTIVE! TAP TO EARN REWARDS! ⚡"
            android:textColor="@color/neon_cyan"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Scores and Balances Display Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_arcade_card"
            android:orientation="horizontal"
            android:padding="12dp"
            android:weightSum="3">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvHighScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/accent_gold"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HIGH SCORE"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#253248" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCloudBalance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.00"
                    android:textColor="@color/neon_green"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CLOUD POINTS"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#253248" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvMultiplier"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1X"
                    android:textColor="@color/neon_cyan"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MULTIPLIER"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Center Stage: Giant Interactive Tap Coin & Score Counter -->
    <LinearLayout
        android:id="@+id/layoutCenterArcade"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Big Real-time Score -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CURRENT RUN SCORE"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:letterSpacing="0.15"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCurrentScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/text_white"
            android:textSize="54sp"
            android:textStyle="bold" />

        <!-- Floating tap combo feedback message -->
        <TextView
            android:id="@+id/tvTapFeedback"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="+1 TAP!"
            android:textColor="@color/neon_cyan"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="invisible" />

        <!-- Interactive Coin Button -->
        <FrameLayout
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp">

            <ImageButton
                android:id="@+id/btnTapCoin"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="center"
                android:background="@drawable/selector_coin"
                android:contentDescription="Arcade Tap Coin"
                android:elevation="8dp" />

            <!-- In-Coin Symbol Overlay -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="★"
                android:textColor="#FFFFFF"
                android:textSize="70sp"
                android:textStyle="bold"
                android:elevation="10dp" />

        </FrameLayout>

        <!-- Dynamic Tap Power Upgrade Indicator -->
        <Button
            android:id="@+id/btnUpgradeTap"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_upgrade_button"
            android:paddingHorizontal="20dp"
            android:text="@string/upgrade_btn"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvUpgradeCost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Upgrade Cost: 25 Score | Power: +1/tap"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- Bottom Controls: Auto-Sync Status Bar & Reset Run -->
    <LinearLayout
        android:id="@+id/layoutBottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical">

        <!-- Live Auto-Sync Status Indicator -->
        <LinearLayout
            android:id="@+id/layoutSyncStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_arcade_card"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="10dp">

            <ProgressBar
                android:id="@+id/pbActionLoading"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvSyncStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auto_sync_active"
                android:textColor="@color/neon_green"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <Button
            android:id="@+id/btnResetRun"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_arcade_card"
            android:text="@string/reset_btn"
            android:textColor="@color/neon_red"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

</RelativeLayout>