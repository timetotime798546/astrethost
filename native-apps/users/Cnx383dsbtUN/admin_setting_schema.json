{
  "app_id": "payquick-wallet",
  "admin_setting_schema": {
    "merchant_name": {
      "type": "string",
      "label": "Merchant Name",
      "default": "PayQuick Super Store"
    },
    "upi_id": {
      "type": "string",
      "label": "UPI ID",
      "default": "payquick@okhdfcbank"
    },
    "payment_qr_code": {
      "type": "image",
      "label": "Payment QR Code URL",
      "default": "https://images.unsplash.com/photo-1607604276583-eef5d076aa5f?w=400&auto=format&fit=crop&q=80"
    },
    "max_deposit_limit": {
      "type": "number",
      "label": "Maximum Wallet Deposit Limit",
      "default": 50000
    }
  },
  "initial_values": {
    "merchant_name": "PayQuick Super Store",
    "upi_id": "payquick@okhdfcbank",
    "payment_qr_code": "https://images.unsplash.com/photo-1607604276583-eef5d076aa5f?w=400&auto=format&fit=crop&q=80",
    "max_deposit_limit": 50000
  }
}