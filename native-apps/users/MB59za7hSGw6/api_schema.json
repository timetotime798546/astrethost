{
  "backend": true,
  "api_base_url": "https://trumpledroid-api.cloudbeta28624.workers.dev",
  "roles": {
    "user": ["own"]
  },
  "collections": {
    "transactions": {
      "fields": {
        "title": "string",
        "amount": "number",
        "type": "string",
        "category": "string",
        "date": "string",
        "note": "string"
      },
      "operations": ["create", "read", "update", "delete"]
    }
  },
  "logic": {
    "total_balance": {
      "type": "calculation",
      "inputs": ["total_income", "total_expense"],
      "formula": "total_income - total_expense"
    },
    "category_percentage": {
      "type": "calculation",
      "inputs": ["category_total", "total_expense"],
      "formula": "(category_total / total_expense) * 100"
    }
  }
}