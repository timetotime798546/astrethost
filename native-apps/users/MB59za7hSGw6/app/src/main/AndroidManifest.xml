<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.mumbaimedical.app">

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/icon"
        android:roundIcon="@drawable/icon"
        android:label="Mumbai Medical"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MedicineListActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".AddEditMedicineActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".NewSaleActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".SalesListActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".NewPurchaseActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".CustomerActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".AddCustomerActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".CustomerKhataActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".SupplierActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ExpiryAlertsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ReportsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".BackupRestoreActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

    </application>
</manifest>