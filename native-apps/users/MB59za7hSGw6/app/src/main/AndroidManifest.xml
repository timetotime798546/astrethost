<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.alfariskirana.app">

    <application
        android:allowBackup="true"
        android:icon="@drawable/icon"
        android:roundIcon="@drawable/icon"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ProductListActivity"
            android:label="Grocery Products" />

        <activity
            android:name=".AddEditProductActivity"
            android:label="Product Form" />

        <activity
            android:name=".CustomerListActivity"
            android:label="Customer &amp; Khata Ledger" />

        <activity
            android:name=".AddEditCustomerActivity"
            android:label="Customer Form" />

        <activity
            android:name=".CustomerDetailActivity"
            android:label="Customer Udhaar History" />

        <activity
            android:name=".NewSaleActivity"
            android:label="New Billing" />

        <activity
            android:name=".SaleBillDetailActivity"
            android:label="Sale Invoice" />

        <activity
            android:name=".PurchaseListActivity"
            android:label="Stock Inward &amp; Purchases" />

        <activity
            android:name=".AddPurchaseActivity"
            android:label="New Purchase Entry" />

        <activity
            android:name=".ExpenseListActivity"
            android:label="Store Daily Expenses" />

        <activity
            android:name=".AddExpenseActivity"
            android:label="Record Expense" />

        <activity
            android:name=".ReportsActivity"
            android:label="Kirana Analytics &amp; Reports" />

    </application>

</manifest>