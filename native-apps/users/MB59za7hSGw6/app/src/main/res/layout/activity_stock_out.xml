<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Header Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_header"
        android:padding="16dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnStockOutBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:text="←"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:background="@drawable/bg_btn_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Stock Out (Device Sale)"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginLeft="14dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Device Selection Card -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SELECT MOBILE FOR SALE / बिक्री के लिए फोन चुनें"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="6dp" />

            <!-- Search Available Stock Label & Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Search Available Stock / उपलब्ध फोन खोजें"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etSearchAvailable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="🔍 Search by IMEI, Serial, or Model..."
                android:background="@drawable/bg_input"
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <ListView
                android:id="@+id/lvAvailableMobiles"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:background="@drawable/bg_card"
                android:divider="@color/divider"
                android:dividerHeight="1dp"
                android:padding="4dp"
                android:layout_marginBottom="16dp" />

            <!-- Selected Mobile Info Banner -->
            <LinearLayout
                android:id="@+id/layoutSelectedInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_badge_accent"
                android:padding="14dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvSelectedModel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Brand Model"
                    android:textColor="@color/accent"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSelectedImei"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IMEI: -"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/tvSelectedPurchase"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Purchase Cost: ₹0.00"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Sale Details Form Card Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:elevation="1dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TRANSACTION &amp; CUSTOMER DETAILS / बिक्री एवं ग्राहक विवरण"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="12dp" />

                <!-- Sale Price Field Label & Input -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Final Selling Price (₹) * / अंतिम बिक्री मूल्य"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etSalePrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter agreed selling price"
                    android:background="@drawable/bg_input"
                    android:padding="12dp"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:inputType="numberDecimal"
                    android:layout_marginBottom="12dp" />

                <!-- Customer Name Field Label & Input -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Customer Name (Optional) / ग्राहक का नाम"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etCustomerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter customer full name"
                    android:background="@drawable/bg_input"
                    android:padding="12dp"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:inputType="textCapWords"
                    android:layout_marginBottom="12dp" />

                <!-- Customer Phone Field Label & Input -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Customer Phone (Optional) / ग्राहक का फोन"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etCustomerPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter 10-digit mobile number"
                    android:background="@drawable/bg_input"
                    android:padding="12dp"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:inputType="phone"
                    android:layout_marginBottom="12dp" />

                <!-- Sale Notes Field Label & Input -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sale Notes &amp; Warranty / वारंटी एवं विवरण"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etSaleNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter warranty details, invoice reference or remarks"
                    android:background="@drawable/bg_input"
                    android:padding="12dp"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:inputType="textMultiLine"
                    android:minLines="2" />
            </LinearLayout>

            <Button
                android:id="@+id/btnConfirmStockOut"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="🏷️ Confirm Stock Out (Mark SOLD)"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_orange"
                android:elevation="2dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>