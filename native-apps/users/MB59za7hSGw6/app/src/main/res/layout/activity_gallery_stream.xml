<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <VideoView
        android:id="@+id/videoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true" />

    <TextView
        android:id="@+id/tvEmptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="Tap 'Select Gallery Video' below to start stream."
        android:textColor="#E0E0E0"
        android:textSize="16sp" />

    <!-- Live Stream Overlay HUD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#80000000"
        android:gravity="center_vertical"
        android:layout_alignParentTop="true">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔴 LIVE VIDEO STREAM (Gallery Mode)"
            android:textColor="#FF1744"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnMuteToggle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="MUTE"
            android:textSize="12sp"
            android:background="#333333"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Bottom Action Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#B3000000"
        android:layout_alignParentBottom="true">

        <Button
            android:id="@+id/btnPickVideo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Select Gallery Video"
            android:background="#FF4081"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnPlayPause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pause"
            android:background="#424242"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</RelativeLayout>