<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#0F172A"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_card"
        android:padding="28dp"
        android:elevation="6dp">

        <TextView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:text="🔒"
            android:textSize="36sp"
            android:gravity="center"
            android:background="@drawable/bg_badge_sold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DEMO EXPIRED"
            android:textColor="@color/danger"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginBottom="14dp" />

        <!-- Hindi Message on Top -->
        <TextView
            android:id="@+id/tvDemoHindiMsg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/demo_expired_hindi"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <!-- English Message Below -->
        <TextView
            android:id="@+id/tvDemoEnglishMsg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/demo_expired_english"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="24dp" />

        <!-- WhatsApp Open Chat Button -->
        <Button
            android:id="@+id/btnWhatsappContact"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/contact_whatsapp"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_success"
            android:elevation="3dp" />

    </LinearLayout>
</LinearLayout>