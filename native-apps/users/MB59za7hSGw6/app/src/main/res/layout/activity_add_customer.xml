<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_form_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add New Borrower"
            android:textColor="@color/primary_dark_green"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Customer Name *"
            android:textColor="@color/text_primary" />

        <EditText
            android:id="@+id/et_cust_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card_bg"
            android:hint="Full Name"
            android:inputType="textPersonName"
            android:padding="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Mobile Phone Number"
            android:textColor="@color/text_primary" />

        <EditText
            android:id="@+id/et_cust_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card_bg"
            android:hint="10-digit Mobile Number"
            android:inputType="phone"
            android:padding="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Residential Address"
            android:textColor="@color/text_primary" />

        <EditText
            android:id="@+id/et_cust_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card_bg"
            android:hint="Address / Location"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:padding="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Optional Notes / Remarks"
            android:textColor="@color/text_primary" />

        <EditText
            android:id="@+id/et_cust_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card_bg"
            android:hint="Guarantor, reference details, etc."
            android:inputType="textMultiLine"
            android:minLines="2"
            android:padding="12dp" />

        <Button
            android:id="@+id/btn_save_customer"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/primary_dark_green"
            android:text="💾 Save Borrower Profile"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>