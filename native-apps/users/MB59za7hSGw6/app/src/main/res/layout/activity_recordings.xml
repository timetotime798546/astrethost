<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cctv_black"
    android:orientation="vertical">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cctv_dark_panel"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_vault_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:fontFamily="monospace"
            android:text="CCTV FOOTAGE ARCHIVE"
            android:textColor="@color/cctv_hud_green"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_clear_all"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_alignParentRight="true"
            android:background="#D32F2F"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="PURGE ALL"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Total Usage Stats Banner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1F2B37"
        android:padding="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_total_summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:text="Archive: 0 files | Total: 0 MB"
            android:textColor="@color/cctv_text_primary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_free_disk_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="Free: 0 GB"
            android:textColor="@color/cctv_accent"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Empty View State -->
    <TextView
        android:id="@+id/tv_empty_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:fontFamily="monospace"
        android:padding="32dp"
        android:text="No CCTV recordings found in offline storage.\n\nStart surveillance on the monitor screen to record clips."
        android:textColor="@color/cctv_text_secondary"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Recordings List -->
    <ListView
        android:id="@+id/lv_recordings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@color/cctv_divider"
        android:dividerHeight="1dp" />

</LinearLayout>