<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:background="@drawable/card_bg"
    android:layout_marginBottom="8dp">

    <ImageView
        android:id="@+id/img_track_thumb"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_play"
        android:contentDescription="Track Thumbnail" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/txt_track_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/yt_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/txt_track_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/yt_text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/txt_track_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/yt_red"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:background="@drawable/btn_rounded" />

            <TextView
                android:id="@+id/txt_track_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#888888"
                android:textSize="11sp"
                android:layout_marginStart="8dp" />

        </LinearLayout>

    </LinearLayout>

    <View
        android:id="@+id/view_playing_badge"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@color/yt_red"
        android:visibility="gone" />

</LinearLayout>