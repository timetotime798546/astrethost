<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/editor_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Top Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp">

        <Button
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:text="←"
            android:textColor="#FFFFFF"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/editor_screen_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="8dp"
            android:text="Edit Note"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_toggle_pin"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginRight="6dp"
            android:background="@android:color/transparent"
            android:text="@string/btn_pin"
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_editor_delete"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginRight="6dp"
            android:background="@android:color/transparent"
            android:text="@string/btn_delete"
            android:textColor="@color/danger"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_editor_save"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/btn_primary"
            android:text="@string/btn_save"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingLeft="14dp"
            android:paddingRight="14dp" />
    </LinearLayout>

    <!-- Category Selector and Color Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:padding="10dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Category:"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinner_category"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="8dp" />

        <!-- Color Accent Chips -->
        <LinearLayout
            android:id="@+id/color_selector_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:id="@+id/color_chip_white"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_margin="3dp"
                android:background="#FFFFFF" />

            <View
                android:id="@+id/color_chip_yellow"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_margin="3dp"
                android:background="#FEF3C7" />

            <View
                android:id="@+id/color_chip_green"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_margin="3dp"
                android:background="#D1FAE5" />

            <View
                android:id="@+id/color_chip_blue"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_margin="3dp"
                android:background="#DBEAFE" />

            <View
                android:id="@+id/color_chip_purple"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_margin="3dp"
                android:background="#EDE9FE" />
        </LinearLayout>
    </LinearLayout>

    <!-- Word and Character Counter Bar (Mandatory Local Offline Calculation) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F1F5F9"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_calc_words"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Words: 0"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_calc_chars"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Characters: 0"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_calc_reading_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="~0 min read"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Scrollable Note Content Inputs -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/et_note_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:hint="@string/title_hint"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="20sp"
                android:textStyle="bold"
                android:paddingBottom="12dp"
                android:singleLine="true" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/et_note_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:gravity="top|start"
                android:hint="@string/content_hint"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>