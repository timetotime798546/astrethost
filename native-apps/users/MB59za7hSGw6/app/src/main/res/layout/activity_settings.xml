<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="App Security &amp; Settings"
            android:textColor="@color/primary_dark_green"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- PIN Protection Settings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/card_bg"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="16dp">

            <CheckBox
                android:id="@+id/cb_enable_pin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enable App PIN Protection Lock"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Set Security PIN (4-6 digits):"
                android:textColor="@color/text_primary" />

            <EditText
                android:id="@+id/et_set_pin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/bg_light"
                android:hint="Enter PIN"
                android:inputType="numberPassword"
                android:padding="12dp" />

            <Button
                android:id="@+id/btn_save_pin"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/primary_dark_green"
                android:text="Save PIN Security Settings"
                android:textColor="#FFFFFF" />

        </LinearLayout>

        <!-- App Information Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/card_bg"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VarshaLaxmi Microfinance Manager"
                android:textColor="@color/primary_dark_green"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Version 1.0 (100% Offline SQLite Build)"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="All financial data stays strictly on this device for absolute privacy and data sovereignty."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>