<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_tx_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#E8F5E9"
            android:paddingLeft="8dp"
            android:paddingTop="4dp"
            android:paddingRight="8dp"
            android:paddingBottom="4dp"
            android:text="STOCK IN"
            android:textColor="#2E7D32"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_tx_prod_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:text="Samsung Galaxy A55"
            android:textColor="#212121"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_tx_qty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+5 Pcs"
            android:textColor="#2E7D32"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_tx_details"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Prev: 10 | New: 15 | Date: 2025-02-14 10:30"
        android:textColor="#757575"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_tx_notes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Notes: Batch #4"
            android:textColor="#616161"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_tx_delete"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="#FFEBEE"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:text="Delete Tx"
            android:textColor="#C62828"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>