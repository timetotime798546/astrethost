<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/cctv_card_bg"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Video Icon Block -->
    <LinearLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_vertical"
        android:background="#141C24"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▶"
            android:textColor="@color/cctv_accent"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="MP4"
            android:textColor="@color/cctv_text_secondary"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- Metadata Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_item_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:text="CCTV_20250101_120000.mp4"
            android:textColor="@color/cctv_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_item_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:text="2025-01-01 12:00:00 • 24.5 MB"
            android:textColor="@color/cctv_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Delete Action Button -->
    <Button
        android:id="@+id/btn_item_delete"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_vertical"
        android:background="#37474F"
        android:text="✕"
        android:textColor="#FF5252"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>