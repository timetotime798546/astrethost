<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_white"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="नया उधार जोड़ें (Add Udhaar)"
        android:textColor="@color/danger"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="ग्राहक के खाते में नया उधार दर्ज करें"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="14dp"
        android:background="@color/divider" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="उधार राशि (Amount ₹) *"
        android:textColor="@color/text_dark"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/et_dialog_udhaar_amount"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_input_field"
        android:hint="0.00"
        android:inputType="numberDecimal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="विवरण / सामान की जानकारी (Notes)"
        android:textColor="@color/text_dark"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/et_dialog_udhaar_notes"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_input_field"
        android:hint="जैसे: राश्न सामान, आटा 5kg, तेल"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textSize="14sp" />

    <!-- Photo Attachment Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="रसीद / बिल की फोटो (Udhar Photo - Optional)"
        android:textColor="@color/text_dark"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_dialog_udhaar_camera"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_outline"
            android:text="📷 Camera"
            android:textColor="@color/text_dark"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_dialog_udhaar_gallery"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_outline"
            android:text="🖼️ Gallery"
            android:textColor="@color/text_dark"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Thumbnail Preview Box -->
    <RelativeLayout
        android:id="@+id/layout_photo_preview_box"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_card_white"
        android:padding="6dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/iv_dialog_udhaar_preview"
            android:layout_width="78dp"
            android:layout_height="78dp"
            android:layout_centerVertical="true"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/tv_photo_attached_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@id/iv_dialog_udhaar_preview"
            android:text="✓ Photo Attached"
            android:textColor="@color/success"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_remove_photo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_button_danger"
            android:text="✕"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="दिनांक और समय (Date &amp; Time)"
        android:textColor="@color/text_dark"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/et_dialog_udhaar_date"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_input_field"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_dialog_udhaar_cancel"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_button_outline"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="रद्द करें (Cancel)"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_dialog_udhaar_save"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_button_danger"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="+ नया उधार जोड़ें"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>