<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="16dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvNoteTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@id/tvNoteCategoryBadge"
            android:layout_alignParentStart="true"
            android:text="Note Title"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvNoteCategoryBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:background="@drawable/bg_badge"
            android:text="Work"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/primary" />

    </RelativeLayout>

    <TextView
        android:id="@+id/tvNoteContentSnippet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Note snippet content preview goes here..."
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="8dp"
        android:maxLines="2"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvNoteDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Oct 24, 2023"
            android:textSize="11sp"
            android:textColor="@color/text_hint" />

        <TextView
            android:id="@+id/tvNoteWordStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="45 words • 280 chars"
            android:textSize="11sp"
            android:textColor="@color/text_hint"
            android:layout_marginEnd="12dp" />

        <Button
            android:id="@+id/btnDeleteNoteItem"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@color/danger_light"
            android:text="Delete"
            android:textColor="@color/danger"
            android:textSize="11sp"
            android:paddingHorizontal="10dp" />

    </LinearLayout>

</LinearLayout>