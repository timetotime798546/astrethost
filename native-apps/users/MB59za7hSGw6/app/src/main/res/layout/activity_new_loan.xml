<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Issue New Loan / Top-up"
            android:textColor="@color/primary_dark_green"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Select Borrower -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Select Borrower *"
            android:textColor="@color/text_primary" />

        <Spinner
            android:id="@+id/sp_loan_customer"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/card_bg"
            android:padding="8dp" />

        <!-- Mode Selection -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Loan Processing Mode"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rg_loan_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rb_mode_new"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="MODE A: Create Brand New Loan Account" />

            <RadioButton
                android:id="@+id/rb_mode_addition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MODE B: Add Money to Existing Active Loan" />
        </RadioGroup>

        <!-- Existing Loan Spinner for Mode B -->
        <LinearLayout
            android:id="@+id/layout_existing_loans"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Select Active Loan Account to Top-Up *"
                android:textColor="@color/text_primary" />

            <Spinner
                android:id="@+id/sp_existing_loans"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@color/card_bg"
                android:padding="8dp" />
        </LinearLayout>

        <!-- Loan Amount -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Loan Amount (₹) *"
            android:textColor="@color/text_primary" />

        <EditText
            android:id="@+id/et_loan_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card_bg"
            android:hint="e.g. 5000"
            android:inputType="numberDecimal"
            android:padding="12dp" />

        <!-- Loan Date -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Loan Issue Date (YYYY-MM-DD)"
            android:textColor="@color/text_primary" />

        <EditText
            android:id="@+id/et_loan_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card_bg"
            android:hint="2024-11-01"
            android:inputType="date"
            android:padding="12dp" />

        <!-- New Loan Specific Fields -->
        <LinearLayout
            android:id="@+id/layout_new_loan_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Interest Calculation Method"
                android:textColor="@color/text_primary" />

            <Spinner
                android:id="@+id/sp_interest_method"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@color/card_bg"
                android:padding="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Interest Rate (% or Flat ₹ Amount)"
                android:textColor="@color/text_primary" />

            <EditText
                android:id="@+id/et_interest_rate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/card_bg"
                android:hint="e.g. 2 for 2% monthly"
                android:inputType="numberDecimal"
                android:padding="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Due Date (Optional YYYY-MM-DD)"
                android:textColor="@color/text_primary" />

            <EditText
                android:id="@+id/et_due_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/card_bg"
                android:hint="YYYY-MM-DD"
                android:inputType="date"
                android:padding="12dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Remarks / Notes"
            android:textColor="@color/text_primary" />

        <EditText
            android:id="@+id/et_loan_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card_bg"
            android:hint="Additional details..."
            android:inputType="text"
            android:padding="12dp" />

        <Button
            android:id="@+id/btn_save_loan"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/primary_dark_green"
            android:text="💾 Save &amp; Disburse Loan"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>