<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- Dynamic AI Girlfriend Simulated Feed -->
    <FrameLayout
        android:id="@+id/videoContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/imgAiAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/icon"
            android:contentDescription="AI Feed" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#66000000" />
    </FrameLayout>

    <!-- Header Live HUD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#99000000"
        android:gravity="center_vertical"
        android:layout_alignParentTop="true">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="💖 RIYA (AI Girlfriend) • LIVE"
            android:textColor="#FF4081"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Speaking Hinglish..."
            android:textColor="#00E676"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Chat Message List Overlay -->
    <ListView
        android:id="@+id/lvChatMessages"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="60dp"
        android:layout_marginBottom="70dp"
        android:divider="@null"
        android:dividerHeight="8dp"
        android:padding="12dp"
        android:transcriptMode="alwaysScroll"
        android:stackFromBottom="true" />

    <!-- Chat Control & Input Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:background="#CC1E1E2C"
        android:layout_alignParentBottom="true"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/etMessageInput"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:hint="Type sweet message in Hinglish..."
            android:textColorHint="#9E9E9E"
            android:textColor="#FFFFFF"
            android:background="#2C2C3E"
            android:paddingHorizontal="14dp"
            android:textSize="14sp"
            android:maxLines="2" />

        <Button
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="SEND ❤️"
            android:textSize="12sp"
            android:background="#FF4081"
            android:textColor="#FFFFFF"
            android:layout_marginStart="8dp" />
    </LinearLayout>

</RelativeLayout>