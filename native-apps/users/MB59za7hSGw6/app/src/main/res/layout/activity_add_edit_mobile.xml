<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Header Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_header"
        android:padding="16dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnBackMobileForm"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:text="←"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:background="@drawable/bg_btn_primary" />

        <TextView
            android:id="@+id/tvFormTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Add Mobile Entry"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginLeft="14dp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Entry Method Buttons -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INTAKE METHOD"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btnFormCameraScan"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="📷 Camera"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_btn_accent"
                    android:layout_marginRight="4dp" />

                <Button
                    android:id="@+id/btnFormGalleryUpload"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="📁 Gallery"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_btn_primary"
                    android:layout_marginLeft="2dp"
                    android:layout_marginRight="2dp" />

                <Button
                    android:id="@+id/btnFormManual"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="✏️ Manual"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_btn_outline"
                    android:layout_marginLeft="4dp" />
            </LinearLayout>

            <!-- Specs Form Fields Card Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:elevation="1dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DEVICE SPECIFICATIONS"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="12dp" />

                <EditText
                    android:id="@+id/etBrand"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Brand (e.g., Apple, Samsung, Xiaomi)"
                    android:background="@drawable/bg_input"
                    android:padding="12dp"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:layout_marginBottom="10dp"
                    android:inputType="textCapWords" />

                <EditText
                    android:id="@+id/etModel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Model (e.g., iPhone 14 Pro, Galaxy S23)"
                    android:background="@drawable/bg_input"
                    android:padding="12dp"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:layout_marginBottom="10dp"
                    android:inputType="textCapWords" />

                <EditText
                    android:id="@+id/etModelNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Model Number (e.g., SM-S911B, A2890)"
                    android:background="@drawable/bg_input"
                    android:padding="12dp"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:layout_marginBottom="10dp"
                    android:inputType="textCapCharacters" />

                <EditText
                    android:id="@+id/etImei1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="IMEI 1 (15 digits required) *"
                    android:background="@drawable/bg_input"
                    android:padding="12dp"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:layout_marginBottom="10dp"
                    android:inputType="number"
                    android:maxLength="15" />

                <EditText
                    android:id="@+id/etImei2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="IMEI 2 (15 digits required) *"
                    android:background="@drawable/bg_input"
                    android:padding="12dp"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:layout_marginBottom="10dp"
                    android:inputType="number"
                    android:maxLength="15" />

                <EditText
                    android:id="@+id/etSerialNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Serial Number (S/N)"
                    android:background="@drawable/bg_input"
                    android:padding="12dp"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:layout_marginBottom="10dp"
                    android:inputType="textCapCharacters" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <EditText
                        android:id="@+id/etRam"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="RAM (e.g., 8 GB)"
                        android:background="@drawable/bg_input"
                        android:padding="12dp"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:layout_marginRight="4dp"
                        android:inputType="text" />

                    <EditText
                        android:id="@+id/etStorage"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Storage (e.g., 128 GB)"
                        android:background="@drawable/bg_input"
                        android:padding="12dp"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:layout_marginLeft="4dp"
                        android:inputType="text" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etColor"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Color (e.g., Black)"
                        android:background="@drawable/bg_input"
                        android:padding="12dp"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:layout_marginRight="4dp"
                        android:inputType="textCapWords" />

                    <EditText
                        android:id="@+id/etProductCode"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Product Code / SKU"
                        android:background="@drawable/bg_input"
                        android:padding="12dp"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:layout_marginLeft="4dp"
                        android:inputType="textCapCharacters" />
                </LinearLayout>
            </LinearLayout>

            <!-- Pricing Fields Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:elevation="1dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PRICING &amp; NOTES"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <EditText
                        android:id="@+id/etPurchasePrice"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Purchase Price (₹)"
                        android:background="@drawable/bg_input"
                        android:padding="12dp"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:layout_marginRight="4dp"
                        android:inputType="numberDecimal" />

                    <EditText
                        android:id="@+id/etSellingPrice"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Target Sale Price (₹)"
                        android:background="@drawable/bg_input"
                        android:padding="12dp"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:layout_marginLeft="4dp"
                        android:inputType="numberDecimal" />
                </LinearLayout>

                <EditText
                    android:id="@+id/etNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Additional Notes / Condition"
                    android:background="@drawable/bg_input"
                    android:padding="12dp"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:inputType="textMultiLine"
                    android:minLines="2" />
            </LinearLayout>

            <!-- Raw OCR Box Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:elevation="1dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RAW OCR EXTRACTED TEXT"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/etRawOcr"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:hint="Raw OCR text will appear here..."
                    android:background="@drawable/bg_input"
                    android:padding="10dp"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="top|left"
                    android:inputType="textMultiLine" />
            </LinearLayout>

            <Button
                android:id="@+id/btnSaveMobile"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="💾 Save Mobile Entry"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_success"
                android:elevation="2dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>