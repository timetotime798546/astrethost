<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/yt_dark_bg">

    <!-- Main Content Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header Navigation Toolbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:background="@color/yt_surface"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                android:contentDescription="Back" />

            <ImageButton
                android:id="@+id/btn_forward"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_forward"
                android:contentDescription="Forward" />

            <ImageButton
                android:id="@+id/btn_refresh"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_refresh"
                android:contentDescription="Refresh" />

            <ImageButton
                android:id="@+id/btn_home"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_home"
                android:contentDescription="Home" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YouTube"
                android:textColor="@color/yt_red"
                android:textStyle="bold"
                android:textSize="18sp"
                android:paddingEnd="8dp" />

            <ImageButton
                android:id="@+id/btn_history"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_history"
                android:contentDescription="History" />

            <ImageButton
                android:id="@+id/btn_exit"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_exit"
                android:contentDescription="Exit App" />

        </LinearLayout>

        <!-- Loading Progress Bar -->
        <ProgressBar
            android:id="@+id/progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:max="100"
            android:progressTint="@color/yt_red"
            android:visibility="gone" />

        <!-- YouTube WebView Frame -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <WebView
                android:id="@+id/web_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:id="@+id/error_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@color/yt_dark_bg"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Connection Error"
                    android:textColor="@color/yt_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Unable to load YouTube website. Please check your network connection and try again."
                    android:textColor="@color/yt_text_secondary"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:layout_marginBottom="24dp" />

                <Button
                    android:id="@+id/btn_retry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Retry Loading"
                    android:background="@drawable/btn_rounded"
                    android:textColor="@color/yt_text_primary"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp" />

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

    <!-- Full-Screen Lock Overlay UI (Persistent & Un-dismissable when expired) -->
    <ScrollView
        android:id="@+id/paywall_lock_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/yt_dark_bg"
        android:fillViewport="true"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="20dp">

            <TextView
                android:id="@+id/txt_paywall_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/trial_expired_title"
                android:textColor="@color/yt_text_primary"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/txt_paywall_subtext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Upgrade to Lifetime Premium access for standard activation."
                android:textColor="@color/yt_text_secondary"
                android:textSize="15sp"
                android:gravity="center"
                android:layout_marginBottom="20dp" />

            <!-- Device ID Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/btn_rounded"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your Device ID:"
                    android:textColor="@color/yt_text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/txt_device_id"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Fetching..."
                    android:textColor="@color/yt_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:selectableWhenTextViewIdIsSet="true"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btn_copy_device_id"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="@string/copy_device_id"
                    android:textColor="@color/yt_text_primary"
                    android:background="@drawable/btn_rounded"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- Payment Details & QR Code Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/btn_rounded"
                android:gravity="center_horizontal"
                android:padding="16dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pay via UPI ID / QR Code"
                    android:textColor="@color/yt_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/txt_upi_id"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="UPI ID: N/A"
                        android:textColor="@color/yt_text_secondary"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btn_copy_upi"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="@string/copy_upi_id"
                        android:textColor="@color/yt_red"
                        android:background="?android:attr/selectableItemBackground"
                        android:textSize="12sp" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/img_qr_code"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:background="#FFFFFF"
                    android:scaleType="fitCenter"
                    android:contentDescription="Payment QR Code"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/txt_qr_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scan QR code to make payment"
                    android:textColor="@color/yt_text_secondary"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Primary Action Buttons -->
            <Button
                android:id="@+id/btn_send_whatsapp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/send_whatsapp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_primary"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btn_check_status"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/check_access_status"
                android:textColor="@color/yt_text_primary"
                android:background="@drawable/btn_rounded"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="24dp" />

        </LinearLayout>

    </ScrollView>

</RelativeLayout>