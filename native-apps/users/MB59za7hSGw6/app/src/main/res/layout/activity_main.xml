<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/yt_dark_bg">

    <!-- Main Active Player Layout -->
    <LinearLayout
        android:id="@+id/main_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header Navigation Toolbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:background="@color/yt_surface"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                android:contentDescription="Back" />

            <ImageButton
                android:id="@+id/btn_forward"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_forward"
                android:contentDescription="Forward" />

            <ImageButton
                android:id="@+id/btn_refresh"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_refresh"
                android:contentDescription="Refresh" />

            <ImageButton
                android:id="@+id/btn_home"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_home"
                android:contentDescription="Home" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YouTube"
                android:textColor="@color/yt_red"
                android:textStyle="bold"
                android:textSize="18sp"
                android:paddingEnd="8dp" />

            <ImageButton
                android:id="@+id/btn_history"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_history"
                android:contentDescription="History" />

            <ImageButton
                android:id="@+id/btn_exit"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_exit"
                android:contentDescription="Exit App" />

        </LinearLayout>

        <!-- Loading Progress Bar -->
        <ProgressBar
            android:id="@+id/progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:max="100"
            android:progressTint="@color/yt_red"
            android:visibility="gone" />

        <!-- YouTube WebView Frame -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <WebView
                android:id="@+id/web_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:id="@+id/error_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@color/yt_dark_bg"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Connection Error"
                    android:textColor="@color/yt_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Unable to load YouTube website. Please check your network connection and try again."
                    android:textColor="@color/yt_text_secondary"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:layout_marginBottom="24dp" />

                <Button
                    android:id="@+id/btn_retry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Retry Loading"
                    android:background="@drawable/btn_rounded"
                    android:textColor="@color/yt_text_primary"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp" />

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

    <!-- Full-Screen Paywall Lock Overlay UI Container (When Expired) -->
    <ScrollView
        android:id="@+id/paywall_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/yt_dark_bg"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <TextView
                android:id="@+id/txt_paywall_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/paywall_expired_title"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/txt_paywall_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/paywall_expired_sub"
                android:textColor="@color/yt_text_secondary"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginBottom="24dp" />

            <!-- Device ID Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YOUR DEVICE ID"
                    android:textColor="#888888"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/txt_device_id"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Device ID"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btn_copy_device_id"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="@string/copy_device_id"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/btn_rounded"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Payment Details Card with QR Code -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/card_bg"
                android:padding="16dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PAYMENT METHOD"
                    android:textColor="#888888"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <FrameLayout
                    android:layout_width="210dp"
                    android:layout_height="210dp"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:id="@+id/img_qr_code"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:contentDescription="UPI Payment QR Code"
                        android:background="#FFFFFF"
                        android:padding="8dp" />

                    <ProgressBar
                        android:id="@+id/qr_progress"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:visibility="gone" />

                </FrameLayout>

                <TextView
                    android:id="@+id/txt_upi_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UPI ID: --"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <Button
                    android:id="@+id/btn_copy_upi"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="@string/copy_upi"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/btn_rounded"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- Action CTAs -->
            <Button
                android:id="@+id/btn_whatsapp_proof"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="@string/send_whatsapp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_primary"
                android:textStyle="bold"
                android:textSize="15sp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btn_check_status"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/check_status"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_rounded"
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />

            <ProgressBar
                android:id="@+id/check_status_progress"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:visibility="gone"
                android:layout_marginBottom="16dp" />

        </LinearLayout>

    </ScrollView>

</FrameLayout>