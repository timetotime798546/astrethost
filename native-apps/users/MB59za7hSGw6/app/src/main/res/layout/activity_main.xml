<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Top Navigation & Search Header -->
    <LinearLayout
        android:id="@+id/layout_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@color/header_bg"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▶ YouTube Audio"
                android:textColor="@color/yt_red"
                android:textSize="20sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/card_bg"
                android:paddingLeft="10dp"
                android:paddingTop="4dp"
                android:paddingRight="10dp"
                android:paddingBottom="4dp"
                android:text="Background Ready"
                android:textColor="@color/text_gray"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Search Bar Input -->
        <EditText
            android:id="@+id/et_search"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:background="@color/card_bg"
            android:hint="Search track title or artist..."
            android:inputType="text"
            android:maxLines="1"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_gray"
            android:textSize="14sp" />

        <!-- Category Horizontal Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chip_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="8dp"
                    android:background="@color/chip_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingLeft="14dp"
                    android:paddingTop="6dp"
                    android:paddingRight="14dp"
                    android:paddingBottom="6dp"
                    android:text="All Tracks"
                    android:textColor="@color/text_white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chip_trending"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="8dp"
                    android:background="@color/chip_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingLeft="14dp"
                    android:paddingTop="6dp"
                    android:paddingRight="14dp"
                    android:paddingBottom="6dp"
                    android:text="Trending"
                    android:textColor="@color/text_white"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chip_lofi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="8dp"
                    android:background="@color/chip_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingLeft="14dp"
                    android:paddingTop="6dp"
                    android:paddingRight="14dp"
                    android:paddingBottom="6dp"
                    android:text="Lo-Fi Beats"
                    android:textColor="@color/text_white"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chip_podcasts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="8dp"
                    android:background="@color/chip_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingLeft="14dp"
                    android:paddingTop="6dp"
                    android:paddingRight="14dp"
                    android:paddingBottom="6dp"
                    android:text="Podcasts"
                    android:textColor="@color/text_white"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chip_favs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/chip_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingLeft="14dp"
                    android:paddingTop="6dp"
                    android:paddingRight="14dp"
                    android:paddingBottom="6dp"
                    android:text="Favorites ♡"
                    android:textColor="@color/yt_red"
                    android:textSize="12sp" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Track List Container -->
    <ListView
        android:id="@+id/lv_tracks"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/layout_player_bottom"
        android:layout_below="@id/layout_header"
        android:divider="@color/divider_color"
        android:dividerHeight="1dp" />

    <!-- Bottom Player & Controls Card -->
    <LinearLayout
        android:id="@+id/layout_player_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/header_bg"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Track Title & Subtitle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_active_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@color/card_bg"
                android:gravity="center"
                android:text="🎵"
                android:textColor="@color/text_white"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_active_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Select a track to play"
                    android:textColor="@color/text_white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_active_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Background Engine Idle"
                    android:textColor="@color/text_gray"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_active_fav"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="♡"
                android:textColor="@color/yt_red"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- Progress Seek Bar and Timing -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_time_current"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="@color/text_gray"
                android:textSize="11sp" />

            <SeekBar
                android:id="@+id/sb_progress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progressDrawable="@android:drawable/progress_horizontal"
                android:thumbTint="@color/yt_red" />

            <TextView
                android:id="@+id/tv_time_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="@color/text_gray"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Playback Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_prev"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="⏮"
                android:textColor="@color/text_white"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/btn_play_pause"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:background="@color/yt_red"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="▶"
                android:textColor="@color/text_white"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/btn_next"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="⏭"
                android:textColor="@color/text_white"
                android:textSize="22sp" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>