<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="12dp">

    <!-- Header & Mode Tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Calculator"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_mode_standard"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Standard"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_tab_selected"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn_mode_scientific"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Scientific"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_tab_unselected"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn_mode_tools"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Tools"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_tab_unselected"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />
    </LinearLayout>

    <!-- Main Display Screen -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:orientation="vertical"
        android:background="@drawable/bg_display_card"
        android:padding="16dp"
        android:gravity="bottom|end"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btn_history"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="🕒"
                android:textSize="14sp"
                android:background="@drawable/bg_card_rounded"
                android:textColor="@color/text_secondary"
                android:padding="0dp" />

            <TextView
                android:id="@+id/tv_expression"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_secondary"
                android:textSize="20sp"
                android:gravity="end"
                android:maxLines="2"
                android:ellipsize="start"
                android:text="" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="36sp"
            android:textStyle="bold"
            android:gravity="end"
            android:maxLines="1"
            android:ellipsize="none"
            android:layout_marginTop="4dp"
            android:text="0" />
    </LinearLayout>

    <!-- CONTAINER FOR CALCULATOR PANELS -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- STANDARD & SCIENTIFIC CONTAINER -->
        <LinearLayout
            android:id="@+id/layout_calc_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Scientific Panel (Collapsible) -->
            <LinearLayout
                android:id="@+id/panel_scientific"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="2"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">
                    <Button android:id="@+id/btn_sin" style="@style/CalcButtonFunction" android:text="sin" />
                    <Button android:id="@+id/btn_cos" style="@style/CalcButtonFunction" android:text="cos" />
                    <Button android:id="@+id/btn_tan" style="@style/CalcButtonFunction" android:text="tan" />
                    <Button android:id="@+id/btn_deg_rad" style="@style/CalcButtonFunction" android:text="DEG" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">
                    <Button android:id="@+id/btn_sqrt" style="@style/CalcButtonFunction" android:text="√" />
                    <Button android:id="@+id/btn_pow" style="@style/CalcButtonFunction" android:text="x^y" />
                    <Button android:id="@+id/btn_log" style="@style/CalcButtonFunction" android:text="log" />
                    <Button android:id="@+id/btn_ln" style="@style/CalcButtonFunction" android:text="ln" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">
                    <Button android:id="@+id/btn_pi" style="@style/CalcButtonFunction" android:text="π" />
                    <Button android:id="@+id/btn_e" style="@style/CalcButtonFunction" android:text="e" />
                    <Button android:id="@+id/btn_fact" style="@style/CalcButtonFunction" android:text="n!" />
                    <Button android:id="@+id/btn_square" style="@style/CalcButtonFunction" android:text="x²" />
                </LinearLayout>
            </LinearLayout>

            <!-- Standard Keypad -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="5"
                android:orientation="vertical">

                <!-- Row 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">
                    <Button android:id="@+id/btn_clear" style="@style/CalcButton" android:background="@drawable/bg_btn_clear" android:text="AC" android:textColor="#FFFFFF" />
                    <Button android:id="@+id/btn_brackets" style="@style/CalcButtonFunction" android:text="( )" />
                    <Button android:id="@+id/btn_percent" style="@style/CalcButtonFunction" android:text="%" />
                    <Button android:id="@+id/btn_divide" style="@style/CalcButtonOperator" android:text="÷" />
                </LinearLayout>

                <!-- Row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">
                    <Button android:id="@+id/btn_7" style="@style/CalcButton" android:text="7" />
                    <Button android:id="@+id/btn_8" style="@style/CalcButton" android:text="8" />
                    <Button android:id="@+id/btn_9" style="@style/CalcButton" android:text="9" />
                    <Button android:id="@+id/btn_multiply" style="@style/CalcButtonOperator" android:text="×" />
                </LinearLayout>

                <!-- Row 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">
                    <Button android:id="@+id/btn_4" style="@style/CalcButton" android:text="4" />
                    <Button android:id="@+id/btn_5" style="@style/CalcButton" android:text="5" />
                    <Button android:id="@+id/btn_6" style="@style/CalcButton" android:text="6" />
                    <Button android:id="@+id/btn_minus" style="@style/CalcButtonOperator" android:text="-" />
                </LinearLayout>

                <!-- Row 4 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">
                    <Button android:id="@+id/btn_1" style="@style/CalcButton" android:text="1" />
                    <Button android:id="@+id/btn_2" style="@style/CalcButton" android:text="2" />
                    <Button android:id="@+id/btn_3" style="@style/CalcButton" android:text="3" />
                    <Button android:id="@+id/btn_plus" style="@style/CalcButtonOperator" android:text="+" />
                </LinearLayout>

                <!-- Row 5 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">
                    <Button android:id="@+id/btn_sign" style="@style/CalcButton" android:text="±" />
                    <Button android:id="@+id/btn_0" style="@style/CalcButton" android:text="0" />
                    <Button android:id="@+id/btn_dot" style="@style/CalcButton" android:text="." />
                    <Button android:id="@+id/btn_backspace" style="@style/CalcButton" android:text="⌫" />
                    <Button android:id="@+id/btn_equals" style="@style/CalcButtonEquals" android:text="=" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- TOOLS & CONVERTERS PANEL -->
        <ScrollView
            android:id="@+id/panel_tools"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Unit Converter Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_rounded"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Unit Converter"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <Spinner
                        android:id="@+id/spinner_converter_type"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_display_card"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/et_unit_input"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_display_card"
                            android:hint="Enter value"
                            android:textColorHint="@color/text_secondary"
                            android:textColor="@color/text_primary"
                            android:inputType="numberDecimal"
                            android:padding="10dp"
                            android:textSize="14sp" />

                        <Spinner
                            android:id="@+id/spinner_unit_from"
                            android:layout_width="110dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_display_card" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="="
                        android:textColor="@color/text_accent"
                        android:textSize="20sp"
                        android:gravity="center"
                        android:layout_margin="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_unit_output"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_display_card"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:gravity="center_vertical"
                            android:padding="10dp"
                            android:text="0.0" />

                        <Spinner
                            android:id="@+id/spinner_unit_to"
                            android:layout_width="110dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_display_card" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Financial / Tip Calculator Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_rounded"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tip &amp; Bill Splitter"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <EditText
                            android:id="@+id/et_bill_amount"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:hint="Bill Amount ($)"
                            android:textColorHint="@color/text_secondary"
                            android:textColor="@color/text_primary"
                            android:inputType="numberDecimal"
                            android:background="@drawable/bg_display_card"
                            android:padding="10dp"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/et_tip_percent"
                            android:layout_width="100dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="8dp"
                            android:hint="Tip % (15)"
                            android:textColorHint="@color/text_secondary"
                            android:textColor="@color/text_primary"
                            android:inputType="number"
                            android:background="@drawable/bg_display_card"
                            android:padding="10dp"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <EditText
                            android:id="@+id/et_split_people"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:hint="Split People (1)"
                            android:textColorHint="@color/text_secondary"
                            android:textColor="@color/text_primary"
                            android:inputType="number"
                            android:background="@drawable/bg_display_card"
                            android:padding="10dp"
                            android:textSize="14sp" />

                        <Button
                            android:id="@+id/btn_calc_tip"
                            android:layout_width="100dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="8dp"
                            android:text="Calculate"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:background="@drawable/bg_btn_operator" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_tip_result"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:text="Total per Person: $0.00" />
                </LinearLayout>

                <!-- BMI Calculator Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_rounded"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BMI Health Calculator"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <EditText
                            android:id="@+id/et_bmi_weight"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:hint="Weight (kg)"
                            android:textColorHint="@color/text_secondary"
                            android:textColor="@color/text_primary"
                            android:inputType="numberDecimal"
                            android:background="@drawable/bg_display_card"
                            android:padding="10dp"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/et_bmi_height"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:hint="Height (cm)"
                            android:textColorHint="@color/text_secondary"
                            android:textColor="@color/text_primary"
                            android:inputType="numberDecimal"
                            android:background="@drawable/bg_display_card"
                            android:padding="10dp"
                            android:textSize="14sp" />

                        <Button
                            android:id="@+id/btn_calc_bmi"
                            android:layout_width="90dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="8dp"
                            android:text="BMI"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:background="@drawable/bg_btn_function" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_bmi_result"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:text="BMI Status: -" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>