<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/arcade_bg"
    android:padding="12dp">

    <!-- Top Scoreboard Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/arcade_surface"
        android:padding="10dp"
        android:gravity="center_vertical">

        <!-- Current Score -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/score_label"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/snake_head"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- High Score -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/high_score_label"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_high_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/accent_yellow"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Difficulty Button -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/speed_label"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_speed"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="@string/speed_normal"
                android:textSize="11sp"
                android:textColor="@color/text_primary"
                android:background="@drawable/btn_arcade"
                android:paddingLeft="8dp"
                android:paddingRight="8dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Game Canvas View Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp">

        <com.retrosnake.app.SnakeView
            android:id="@+id/snake_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/grid_bg" />

        <!-- Overlay Message for Paused / Game Over / Ready -->
        <LinearLayout
            android:id="@+id/layout_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#B30D1117"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_overlay_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/game_over_title"
                android:textColor="@color/food_apple"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_overlay_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Tap Start or D-Pad to play"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_overlay_action"
                android:layout_width="160dp"
                android:layout_height="44dp"
                android:layout_marginTop="16dp"
                android:text="@string/btn_restart"
                android:textColor="@color/arcade_bg"
                android:textStyle="bold"
                android:background="#00E676" />
        </LinearLayout>
    </FrameLayout>

    <!-- Controls Bottom Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/arcade_surface"
        android:padding="8dp">

        <!-- Action / State Buttons -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.8"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingRight="6dp">

            <Button
                android:id="@+id/btn_action"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="@string/btn_pause"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:background="@drawable/btn_arcade"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btn_reset"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="@string/btn_restart"
                android:textColor="@color/food_apple"
                android:textSize="13sp"
                android:background="@drawable/btn_arcade" />
        </LinearLayout>

        <!-- Virtual Arcade D-Pad Grid -->
        <GridLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="3"
            android:layout_gravity="center">

            <!-- Row 1: Empty, UP, Empty -->
            <View
                android:layout_width="54dp"
                android:layout_height="48dp" />

            <Button
                android:id="@+id/btn_up"
                android:layout_width="54dp"
                android:layout_height="48dp"
                android:text="▲"
                android:textColor="@color/snake_head"
                android:textSize="18sp"
                android:background="@drawable/btn_arcade" />

            <View
                android:layout_width="54dp"
                android:layout_height="48dp" />

            <!-- Row 2: LEFT, CENTER, RIGHT -->
            <Button
                android:id="@+id/btn_left"
                android:layout_width="54dp"
                android:layout_height="48dp"
                android:text="◀"
                android:textColor="@color/snake_head"
                android:textSize="18sp"
                android:background="@drawable/btn_arcade" />

            <View
                android:layout_width="54dp"
                android:layout_height="48dp"
                android:background="@color/arcade_surface" />

            <Button
                android:id="@+id/btn_right"
                android:layout_width="54dp"
                android:layout_height="48dp"
                android:text="▶"
                android:textColor="@color/snake_head"
                android:textSize="18sp"
                android:background="@drawable/btn_arcade" />

            <!-- Row 3: Empty, DOWN, Empty -->
            <View
                android:layout_width="54dp"
                android:layout_height="48dp" />

            <Button
                android:id="@+id/btn_down"
                android:layout_width="54dp"
                android:layout_height="48dp"
                android:text="▼"
                android:textColor="@color/snake_head"
                android:textSize="18sp"
                android:background="@drawable/btn_arcade" />

            <View
                android:layout_width="54dp"
                android:layout_height="48dp" />
        </GridLayout>

    </LinearLayout>

</LinearLayout>