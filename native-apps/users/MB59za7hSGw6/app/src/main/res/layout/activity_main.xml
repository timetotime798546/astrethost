<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- 3D Hardware Accelerated OpenGL ES 2.0 SurfaceView -->
    <com.cyberrunner.app.CyberGLSurfaceView
        android:id="@+id/gl_surface_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Neon HUD Bar -->
    <LinearLayout
        android:id="@+id/layout_hud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#AA05040A">

        <!-- Score / Distance -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/score_label"
                android:textColor="@color/cyan_neon"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 m"
                android:textColor="@color/text_white"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Coins -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/coins_label"
                android:textColor="@color/yellow_neon"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_coins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/yellow_neon"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- High Score -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/high_score_label"
                android:textColor="@color/magenta_neon"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_high_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 m"
                android:textColor="@color/text_white"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Speed Indicator -->
    <TextView
        android:id="@+id/tv_speed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/layout_hud"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="16dp"
        android:text="1.0x SPEED"
        android:textColor="@color/cyan_neon"
        android:textSize="11sp"
        android:textStyle="bold"
        android:background="#66100E22"
        android:padding="6dp" />

    <!-- Ready Screen Overlay -->
    <LinearLayout
        android:id="@+id/overlay_ready"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#B305040A"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CYBER RUNNER 3D"
            android:textColor="@color/cyan_neon"
            android:textSize="32sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/hint_ready"
            android:textColor="@color/text_dim"
            android:textSize="14sp" />

        <View
            android:layout_width="120dp"
            android:layout_height="2dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="@color/magenta_neon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tap_to_jump"
            android:textColor="@color/yellow_neon"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_overlay_start"
            android:layout_width="220dp"
            android:layout_height="50dp"
            android:layout_marginTop="28dp"
            android:background="#281E48"
            android:text="@string/start_game"
            android:textColor="@color/cyan_neon"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Game Over Screen Overlay -->
    <LinearLayout
        android:id="@+id/overlay_game_over"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:background="#D905040A"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/game_over"
            android:textColor="@color/hazard_red"
            android:textSize="30sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/tv_final_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="DISTANCE: 0 m"
            android:textColor="@color/text_white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_final_coins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="CYBER COINS: 0"
            android:textColor="@color/yellow_neon"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_overlay_retry"
            android:layout_width="220dp"
            android:layout_height="48dp"
            android:layout_marginTop="28dp"
            android:background="#FF0055"
            android:text="@string/restart"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_overlay_leaderboard"
            android:layout_width="220dp"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:background="#281E48"
            android:text="@string/leaderboard"
            android:textColor="@color/cyan_neon"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Bottom Controls (Sound Toggle & Leaderboard) -->
    <LinearLayout
        android:id="@+id/layout_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="16dp">

        <Button
            android:id="@+id/btn_sound_toggle"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/sound_on"
            android:background="#281E48"
            android:textColor="@color/cyan_neon"
            android:textSize="12sp"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_marginEnd="12dp" />

        <Button
            android:id="@+id/btn_leaderboard"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/leaderboard"
            android:background="#281E48"
            android:textColor="@color/magenta_neon"
            android:textSize="12sp"
            android:paddingLeft="16dp"
            android:paddingRight="16dp" />
    </LinearLayout>

</RelativeLayout>