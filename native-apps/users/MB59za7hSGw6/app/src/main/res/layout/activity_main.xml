<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/yt_dark_bg">

    <!-- Main Active Player Layout -->
    <LinearLayout
        android:id="@+id/main_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Toolbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:background="@color/yt_surface"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="LockPlayTube"
                android:textColor="@color/yt_red"
                android:textStyle="bold"
                android:textSize="18sp" />

            <ImageButton
                android:id="@+id/btn_history"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_history"
                android:contentDescription="History" />

            <ImageButton
                android:id="@+id/btn_exit"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_exit"
                android:contentDescription="Exit App" />

        </LinearLayout>

        <!-- Search Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:background="@color/yt_surface">

            <EditText
                android:id="@+id/edit_search"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:hint="Search audio, beats &amp; podcasts..."
                android:textColorHint="@color/yt_text_secondary"
                android:textColor="@color/yt_text_primary"
                android:textSize="14sp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/btn_rounded" />

            <ImageButton
                android:id="@+id/btn_voice_search"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/btn_rounded"
                android:src="@drawable/ic_play"
                android:contentDescription="Voice Search" />

        </LinearLayout>

        <!-- Category Horizontal Scroll -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:padding="8dp"
            android:background="@color/yt_dark_bg">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_cat_all"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="All"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/btn_rounded"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_cat_lofi"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Lo-Fi"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/btn_rounded"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_cat_chill"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Chill"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/btn_rounded"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_cat_podcast"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Podcasts"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/btn_rounded"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_cat_sleep"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Sleep"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/btn_rounded" />

            </LinearLayout>

        </HorizontalScrollView>

        <!-- Now Playing Controller Card -->
        <LinearLayout
            android:id="@+id/card_player_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="12dp"
            android:layout_margin="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txt_now_playing_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/yt_text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/txt_now_playing_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/yt_text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <SeekBar
                android:id="@+id/seek_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:progressTint="@color/yt_red"
                android:thumbTint="@color/yt_red" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/txt_current_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#888888"
                    android:textSize="11sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/txt_total_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#888888"
                    android:textSize="11sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp">

                <ImageButton
                    android:id="@+id/btn_prev_track"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_back"
                    android:contentDescription="Previous Track" />

                <ImageButton
                    android:id="@+id/btn_play_pause"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/btn_rounded"
                    android:src="@drawable/ic_pause"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:contentDescription="Play or Pause" />

                <ImageButton
                    android:id="@+id/btn_next_track"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_forward"
                    android:contentDescription="Next Track" />

            </LinearLayout>

        </LinearLayout>

        <!-- Track List -->
        <ListView
            android:id="@+id/list_tracks"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="8dp"
            android:divider="@null"
            android:dividerHeight="0dp" />

    </LinearLayout>

    <!-- Full-Screen Paywall Lock Overlay UI Container (When Expired) -->
    <ScrollView
        android:id="@+id/paywall_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/yt_dark_bg"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <TextView
                android:id="@+id/txt_paywall_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/paywall_expired_title"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/txt_paywall_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/paywall_expired_sub"
                android:textColor="@color/yt_text_secondary"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginBottom="24dp" />

            <!-- Device ID Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YOUR DEVICE ID"
                    android:textColor="#888888"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/txt_device_id"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Device ID"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btn_copy_device_id"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="@string/copy_device_id"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/btn_rounded"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Payment Details Card with QR Code -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/card_bg"
                android:padding="16dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PAYMENT METHOD"
                    android:textColor="#888888"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <FrameLayout
                    android:layout_width="210dp"
                    android:layout_height="210dp"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:id="@+id/img_qr_code"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:contentDescription="UPI Payment QR Code"
                        android:background="#FFFFFF"
                        android:padding="8dp" />

                    <ProgressBar
                        android:id="@+id/qr_progress"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:visibility="gone" />

                </FrameLayout>

                <TextView
                    android:id="@+id/txt_upi_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UPI ID: --"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <Button
                    android:id="@+id/btn_copy_upi"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="@string/copy_upi"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/btn_rounded"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- Action CTAs -->
            <Button
                android:id="@+id/btn_whatsapp_proof"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="@string/send_whatsapp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_primary"
                android:textStyle="bold"
                android:textSize="15sp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btn_check_status"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/check_status"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_rounded"
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />

            <ProgressBar
                android:id="@+id/check_status_progress"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:visibility="gone"
                android:layout_marginBottom="16dp" />

        </LinearLayout>

    </ScrollView>

</FrameLayout>