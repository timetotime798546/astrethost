<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Top Action Bar -->
    <LinearLayout
        android:id="@+id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:background="@color/header_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="YT Background Player"
            android:textColor="@color/text_white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_sleep_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:text="⏱️ Timer"
            android:textColor="@color/text_white"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Search Section -->
    <LinearLayout
        android:id="@+id/search_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/header_bar"
        android:background="@color/header_bg"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingTop="4dp"
        android:paddingRight="16dp"
        android:paddingBottom="12dp">

        <EditText
            android:id="@+id/et_search"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@color/card_bg"
            android:hint="@string/search_hint"
            android:inputType="text"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_gray"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Horizontal Category Filter Chips -->
    <HorizontalScrollView
        android:id="@+id/category_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/search_container"
        android:background="@color/header_bg"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/chip_all"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginRight="8dp"
                android:background="@color/yt_red"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:text="All Tracks"
                android:textColor="@color/text_white"
                android:textSize="12sp" />

            <Button
                android:id="@+id/chip_trending"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginRight="8dp"
                android:background="@color/chip_bg"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:text="Trending"
                android:textColor="@color/text_white"
                android:textSize="12sp" />

            <Button
                android:id="@+id/chip_lofi"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginRight="8dp"
                android:background="@color/chip_bg"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:text="Lo-Fi &amp; Chill"
                android:textColor="@color/text_white"
                android:textSize="12sp" />

            <Button
                android:id="@+id/chip_podcasts"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginRight="8dp"
                android:background="@color/chip_bg"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:text="Podcasts"
                android:textColor="@color/text_white"
                android:textSize="12sp" />

            <Button
                android:id="@+id/chip_favorites"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@color/chip_bg"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:text="❤️ Favorites"
                android:textColor="@color/text_white"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Track List -->
    <ListView
        android:id="@+id/lv_audio_tracks"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/mini_player_bar"
        android:layout_below="@id/category_scroll"
        android:divider="@color/divider_color"
        android:dividerHeight="1dp" />

    <!-- Bottom Persistent Mini Player -->
    <LinearLayout
        android:id="@+id/mini_player_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_above="@id/status_bar"
        android:background="@color/player_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:visibility="visible">

        <TextView
            android:id="@+id/tv_mini_icon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@color/card_bg"
            android:gravity="center"
            android:text="🎵"
            android:textColor="@color/text_white"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_mini_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Select a track to play"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_mini_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Background Audio Engine Ready"
                android:textColor="@color/text_gray"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_mini_play_pause"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="▶"
            android:textColor="@color/text_white"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/btn_mini_next"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="⏭"
            android:textColor="@color/text_white"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- Background Service Active Banner -->
    <LinearLayout
        android:id="@+id/status_bar"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_alignParentBottom="true"
        android:background="@color/yt_dark_red"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bg_service_active"
            android:textColor="@color/text_white"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Full Screen Player Overlay (Hidden by default) -->
    <RelativeLayout
        android:id="@+id/full_player_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_dark"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <!-- Close overlay button header -->
        <LinearLayout
            android:id="@+id/full_header"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_alignParentTop="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingRight="16dp">

            <TextView
                android:id="@+id/btn_close_full_player"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="▼"
                android:textColor="@color/text_white"
                android:textSize="20sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Now Playing in Background"
                android:textColor="@color/text_gray"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_full_fav"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="♡"
                android:textColor="@color/yt_red"
                android:textSize="24sp" />
        </LinearLayout>

        <!-- Album Art Card Container -->
        <LinearLayout
            android:id="@+id/art_container"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_below="@id/full_header"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="24dp"
            android:background="@color/card_bg"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_full_large_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎧"
                android:textSize="80sp" />
        </LinearLayout>

        <!-- Track Title & Artist -->
        <LinearLayout
            android:id="@+id/full_title_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/art_container"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingLeft="24dp"
            android:paddingRight="24dp">

            <TextView
                android:id="@+id/tv_full_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:text="Track Title"
                android:textColor="@color/text_white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_full_artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Artist Name"
                android:textColor="@color/text_gray"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Progress Seekbar Container -->
        <LinearLayout
            android:id="@+id/seekbar_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/full_title_container"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:paddingLeft="24dp"
            android:paddingRight="24dp">

            <SeekBar
                android:id="@+id/seekbar_audio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progressDrawable="@android:drawable/progress_horizontal" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tv_current_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:text="0:00"
                    android:textColor="@color/text_gray"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_total_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:text="0:00"
                    android:textColor="@color/text_gray"
                    android:textSize="12sp" />
            </RelativeLayout>
        </LinearLayout>

        <!-- Main Media Player Controls -->
        <LinearLayout
            android:id="@+id/full_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/seekbar_container"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_full_shuffle"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="🔀"
                android:textColor="@color/text_gray"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/btn_full_prev"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="⏮"
                android:textColor="@color/text_white"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/btn_full_play_pause"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:background="@color/yt_red"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="▶"
                android:textColor="@color/text_white"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/btn_full_next"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="⏭"
                android:textColor="@color/text_white"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/btn_full_repeat"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="🔁"
                android:textColor="@color/text_gray"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- Volume Control Slider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/full_controls"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="32dp"
            android:paddingRight="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔈"
                android:textColor="@color/text_gray"
                android:textSize="16sp" />

            <SeekBar
                android:id="@+id/seekbar_volume"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔊"
                android:textColor="@color/text_gray"
                android:textSize="16sp" />
        </LinearLayout>

    </RelativeLayout>

</RelativeLayout>