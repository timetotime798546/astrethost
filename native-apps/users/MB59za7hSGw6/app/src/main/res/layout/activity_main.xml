<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/shell_blue_main"
    android:gravity="center_horizontal"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Top Console Header & Speaker Grille -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/lbl_branding"
            android:textColor="@color/text_shell_label"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <!-- Speaker Grille Slits -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <View
                android:layout_width="4dp"
                android:layout_height="14dp"
                android:layout_margin="2dp"
                android:background="@color/shell_blue_dark" />
            <View
                android:layout_width="4dp"
                android:layout_height="18dp"
                android:layout_margin="2dp"
                android:background="@color/shell_blue_dark" />
            <View
                android:layout_width="4dp"
                android:layout_height="22dp"
                android:layout_margin="2dp"
                android:background="@color/shell_blue_dark" />
            <View
                android:layout_width="4dp"
                android:layout_height="18dp"
                android:layout_margin="2dp"
                android:background="@color/shell_blue_dark" />
            <View
                android:layout_width="4dp"
                android:layout_height="14dp"
                android:layout_margin="2dp"
                android:background="@color/shell_blue_dark" />
        </LinearLayout>
    </LinearLayout>

    <!-- Retro LCD Screen Frame with Outer Bezel -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:background="@drawable/lcd_bezel_background">

        <com.brickgameclassic.app.LcdScreenView
            android:id="@+id/lcdScreenView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- System Function Buttons: Reset, Sound, Start/Pause -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="6dp">

        <!-- Reset Button -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginRight="18dp">
            <Button
                android:id="@+id/btnReset"
                android:layout_width="48dp"
                android:layout_height="28dp"
                android:background="@drawable/btn_small_pill" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lbl_reset"
                style="@style/ConsoleTextStyle"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Sound Button -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginRight="18dp">
            <Button
                android:id="@+id/btnSound"
                android:layout_width="48dp"
                android:layout_height="28dp"
                android:background="@drawable/btn_small_pill" />
            <TextView
                android:id="@+id/txtSoundStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lbl_sound"
                style="@style/ConsoleTextStyle"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Start / Pause Button -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">
            <Button
                android:id="@+id/btnStartPause"
                android:layout_width="56dp"
                android:layout_height="28dp"
                android:background="@drawable/btn_small_pill" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lbl_start_pause"
                style="@style/ConsoleTextStyle"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Controls Area: D-Pad on Left, Giant Action Buttons on Right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.0"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:layout_marginTop="4dp">

        <!-- D-PAD / Directional Movement Cluster -->
        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center">

            <!-- Hard Drop (Up button in classic D-pad layout) -->
            <Button
                android:id="@+id/btnHardDrop"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_centerHorizontal="true"
                android:layout_alignParentTop="true"
                android:background="@drawable/btn_round_yellow"
                android:text="▲"
                android:textColor="@color/shell_screen_frame"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Left Button -->
            <Button
                android:id="@+id/btnLeft"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:background="@drawable/btn_round_yellow"
                android:text="◀"
                android:textColor="@color/shell_screen_frame"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Center cross pivot decorative dot -->
            <View
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_centerInParent="true"
                android:background="@color/shell_blue_dark" />

            <!-- Right Button -->
            <Button
                android:id="@+id/btnRight"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:background="@drawable/btn_round_yellow"
                android:text="▶"
                android:textColor="@color/shell_screen_frame"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Soft Down Button -->
            <Button
                android:id="@+id/btnDown"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_centerHorizontal="true"
                android:layout_alignParentBottom="true"
                android:background="@drawable/btn_round_yellow"
                android:text="▼"
                android:textColor="@color/shell_screen_frame"
                android:textSize="20sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Right Side: Big ROTATE Action Button -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.9"
            android:orientation="vertical"
            android:gravity="center">

            <Button
                android:id="@+id/btnRotate"
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:background="@drawable/btn_round_cyan"
                android:text="ROTATE"
                android:textColor="@color/shell_screen_frame"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lbl_rotate"
                style="@style/ConsoleTextStyle"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>