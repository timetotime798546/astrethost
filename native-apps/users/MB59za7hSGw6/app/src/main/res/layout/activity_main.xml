<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card_bg"
            android:padding="20dp"
            android:elevation="4dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SoundCraft Audio FX"
                android:textColor="@color/primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Real-time Native Audio Synthesizer ready."
                android:textColor="@color/accent_cyan"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Pitch & Volume Tuner Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card_bg"
            android:padding="16dp"
            android:elevation="3dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Master Controls"
                android:textColor="@color/primary_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvPitchLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Pitch Multiplier: 1.00x"
                    android:textColor="@color/text_main"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnResetPitch"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Reset"
                    android:textSize="11sp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/sbPitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="200"
                android:progress="100"
                android:layout_marginTop="6dp" />

            <!-- Tone Frequency Slider -->
            <TextView
                android:id="@+id/tvFreqLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Synth Frequency: 440 Hz (Note A4)"
                android:textColor="@color/text_main"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/sbFrequency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="1600"
                android:progress="310"
                android:layout_marginTop="6dp" />

            <Button
                android:id="@+id/btnPlayCustomTone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Play Continuous Sine Tone"
                android:backgroundTint="@color/accent_cyan"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Sound FX Pads Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Instant FX Pads"
            android:textColor="@color/primary_dark"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- FX Grid Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btnFxLaser"
                android:layout_width="0dp"
                android:layout_height="75dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="⚡ LASER FX"
                android:textSize="13sp"
                android:backgroundTint="@color/accent_purple"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnFxCoin"
                android:layout_width="0dp"
                android:layout_height="75dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="🪙 COIN CHIME"
                android:textSize="13sp"
                android:backgroundTint="@color/accent_amber"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- FX Grid Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btnFxJump"
                android:layout_width="0dp"
                android:layout_height="75dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="🕹️ 8-BIT JUMP"
                android:textSize="13sp"
                android:backgroundTint="@color/accent_emerald"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnFxSiren"
                android:layout_width="0dp"
                android:layout_height="75dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="🚨 SIREN SWEEP"
                android:textSize="13sp"
                android:backgroundTint="@color/accent_rose"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Drum Machine Beat Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Acoustic &amp; Percussion Kits"
            android:textColor="@color/primary_dark"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnFxKick"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="🥁 BASS KICK"
                android:textSize="13sp"
                android:backgroundTint="@color/primary"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnFxSnare"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="💥 SNARE CRACK"
                android:textSize="13sp"
                android:backgroundTint="@color/primary_dark"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Musical Keyboard Octave Pads -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mini Piano Keynotes"
            android:textColor="@color/primary_dark"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnNoteC"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="C"
                android:textSize="14sp"
                android:backgroundTint="#334155"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnNoteD"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="D"
                android:textSize="14sp"
                android:backgroundTint="#475569"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnNoteE"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="E"
                android:textSize="14sp"
                android:backgroundTint="#334155"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnNoteF"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="F"
                android:textSize="14sp"
                android:backgroundTint="#475569"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnNoteG"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="G"
                android:textSize="14sp"
                android:backgroundTint="#334155"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnNoteA"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="A"
                android:textSize="14sp"
                android:backgroundTint="#475569"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnNoteB"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="B"
                android:textSize="14sp"
                android:backgroundTint="#334155"
                android:textColor="#FFFFFF" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>