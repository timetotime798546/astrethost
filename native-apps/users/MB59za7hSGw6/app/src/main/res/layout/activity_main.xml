<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:gravity="center_horizontal"
    android:padding="24dp">

    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="40dp"
        android:src="@drawable/icon"
        android:contentDescription="App Logo" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AI Girlfriend Stream"
        android:textColor="#FF4081"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Video Stream &amp; Companion Mode"
        android:textColor="#B0BEC5"
        android:textSize="14sp"
        android:layout_marginTop="8dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Mode A Button -->
    <LinearLayout
        android:id="@+id/btnModeGallery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1E1E2C"
        android:padding="20dp"
        android:layout_marginBottom="20dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎬 Mode A: Gallery Video Stream"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pick pre-recorded videos from gallery and stream with camera overlay simulation."
            android:textColor="#9E9E9E"
            android:textSize="13sp"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <!-- Mode B Button -->
    <LinearLayout
        android:id="@+id/btnModeAi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#2C1E2A"
        android:padding="20dp"
        android:layout_marginBottom="30dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💖 Mode B: Live AI Girlfriend (Hinglish)"
            android:textColor="#FF80AB"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Interactive AI girlfriend roleplay with sweet Hinglish responses &amp; live video feed."
            android:textColor="#B0BEC5"
            android:textSize="13sp"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvPermissionStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Granting Permissions..."
        android:textColor="#FFC107"
        android:textSize="12sp"
        android:layout_marginBottom="16dp" />

</LinearLayout>