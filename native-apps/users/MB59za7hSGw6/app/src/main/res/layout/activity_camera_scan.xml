<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Real-time Camera Preview -->
    <SurfaceView
        android:id="@+id/surfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Scanner Guide Overlay -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Align QR Code or Barcode in Frame"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="#99000000"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginBottom="30dp" />

        <!-- Viewfinder Reticle Frame -->
        <View
            android:layout_width="280dp"
            android:layout_height="220dp"
            android:background="@drawable/ic_launcher_background"
            android:alpha="0.2" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Supports EAN-13, EAN-8, UPC, Code128, QR Code &amp; DataMatrix"
            android:textColor="#CBD5E1"
            android:textSize="11sp"
            android:layout_marginTop="20dp" />
    </LinearLayout>

    <!-- Header Quick Controls Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:layout_gravity="top">

        <Button
            android:id="@+id/btnCloseScanner"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="✕"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:background="#80000000" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnFlashlight"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="🔦 Flash OFF"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:background="#80000000"
            android:paddingLeft="14dp"
            android:paddingRight="14dp" />
    </LinearLayout>

</FrameLayout>