<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Collect Loan Payment"
            android:textColor="@color/primary_dark_green"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Select Borrower *"
            android:textColor="@color/text_primary" />

        <Spinner
            android:id="@+id/sp_pay_customer"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/card_bg"
            android:padding="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Select Loan Account *"
            android:textColor="@color/text_primary" />

        <Spinner
            android:id="@+id/sp_pay_loan"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/card_bg"
            android:padding="8dp" />

        <!-- Outstanding Breakdown Info Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/card_bg"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tv_pay_loan_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loan Breakdown Summary"
                android:textColor="@color/primary_dark_green"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_pay_outstanding_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Total Outstanding: ₹ 0.00"
                android:textColor="@color/negative_red"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Total Payment Collected (₹) *"
            android:textColor="@color/text_primary" />

        <EditText
            android:id="@+id/et_pay_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card_bg"
            android:hint="Enter collected amount"
            android:inputType="numberDecimal"
            android:padding="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Payment Allocation Mode"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rg_pay_split"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rb_split_auto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Auto Split (Pay Accrued Interest First, then Principal)" />

            <RadioButton
                android:id="@+id/rb_split_manual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manual Allocation (Custom Interest vs Principal)" />
        </RadioGroup>

        <!-- Manual Split Fields -->
        <LinearLayout
            android:id="@+id/layout_manual_split"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Principal Component (₹)"
                android:textColor="@color/text_primary" />

            <EditText
                android:id="@+id/et_pay_principal_component"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/card_bg"
                android:hint="Principal portion"
                android:inputType="numberDecimal"
                android:padding="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Interest Component (₹)"
                android:textColor="@color/text_primary" />

            <EditText
                android:id="@+id/et_pay_interest_component"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/card_bg"
                android:hint="Interest portion"
                android:inputType="numberDecimal"
                android:padding="12dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Payment Date (YYYY-MM-DD)"
            android:textColor="@color/text_primary" />

        <EditText
            android:id="@+id/et_pay_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card_bg"
            android:hint="2024-11-01"
            android:inputType="date"
            android:padding="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Payment Method"
            android:textColor="@color/text_primary" />

        <Spinner
            android:id="@+id/sp_pay_method"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/card_bg"
            android:padding="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Notes / Receipt Ref"
            android:textColor="@color/text_primary" />

        <EditText
            android:id="@+id/et_pay_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card_bg"
            android:hint="UPI Ref ID or Cash details..."
            android:inputType="text"
            android:padding="12dp" />

        <Button
            android:id="@+id/btn_save_payment"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/positive_green"
            android:text="💵 Save Payment Receipt"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>