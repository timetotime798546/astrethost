<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="20dp">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/leaderboard"
            android:textColor="@color/cyan_neon"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:background="#281E48"
            android:textColor="@color/text_white"
            android:text="@string/back"
            android:textSize="12sp"
            android:paddingLeft="14dp"
            android:paddingRight="14dp" />
    </RelativeLayout>

    <!-- Column Headers -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="#1B142F">

        <TextView
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:text="RANK"
            android:textColor="@color/text_dim"
            android:textStyle="bold"
            android:gravity="center"
            android:textSize="12sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="DISTANCE"
            android:textColor="@color/cyan_neon"
            android:textStyle="bold"
            android:textSize="12sp" />

        <TextView
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:text="COINS"
            android:textColor="@color/yellow_neon"
            android:textStyle="bold"
            android:gravity="center"
            android:textSize="12sp" />

        <TextView
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="RECORDED"
            android:textColor="@color/text_dim"
            android:textStyle="bold"
            android:gravity="end"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- High Score Scroll List -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/ll_scores_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp" />
    </ScrollView>

    <!-- Reset Records Button -->
    <Button
        android:id="@+id/btn_clear_scores"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:background="#2E1124"
        android:text="@string/clear_scores"
        android:textColor="@color/hazard_red"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>