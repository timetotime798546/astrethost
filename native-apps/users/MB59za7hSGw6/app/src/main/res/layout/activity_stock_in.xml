<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Header Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/primary"
        android:padding="16dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnStockInBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="←"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:background="@color/primary_dark" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Stock In Management"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginLeft="16dp" />

        <Button
            android:id="@+id/btnAddStockInHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Add"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:background="@color/accent"
            android:paddingLeft="12dp"
            android:paddingRight="12dp" />
    </LinearLayout>

    <!-- Search & Quick Intake Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@color/card_bg">

        <EditText
            android:id="@+id/etSearchStockIn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="🔍 Search by IMEI, Model, or Serial..."
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:padding="10dp"
            android:background="@color/background"
            android:inputType="text"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnStockInCamera"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="📷 OCR Camera"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:background="@color/primary"
                android:layout_marginRight="4dp" />

            <Button
                android:id="@+id/btnStockInGallery"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="📁 Gallery Upload"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:background="@color/accent"
                android:layout_marginLeft="4dp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/lvStockIn"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/divider"
            android:dividerHeight="1dp"
            android:padding="12dp"
            android:clipToPadding="false" />

        <TextView
            android:id="@+id/tvEmptyStockIn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="No Stock In records found."
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>