<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#0F172A</item>
        <item name="android:navigationBarColor">#0F172A</item>
        <item name="android:windowBackground">@color/bg_dark</item>
    </style>

    <style name="CalcButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/btn_number_text</item>
        <item name="android:background">@drawable/bg_btn_number</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="CalcButtonOperator" parent="CalcButton">
        <item name="android:textColor">@color/btn_operator_text</item>
        <item name="android:background">@drawable/bg_btn_operator</item>
    </style>

    <style name="CalcButtonEquals" parent="CalcButton">
        <item name="android:textColor">@color/btn_equals_text</item>
        <item name="android:background">@drawable/bg_btn_equals</item>
    </style>

    <style name="CalcButtonFunction" parent="CalcButton">
        <item name="android:textColor">@color/btn_function_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:background">@drawable/bg_btn_function</item>
    </style>
</resources>