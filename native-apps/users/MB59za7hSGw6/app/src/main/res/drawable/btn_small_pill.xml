<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/btn_pill_pressed" />
            <stroke android:width="1.5dp" android:color="@color/neon_cyan" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/btn_pill_bg" />
            <stroke android:width="1.5dp" android:color="@color/btn_pill_stroke" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>