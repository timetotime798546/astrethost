<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/btn_yellow_pressed" />
            <stroke android:width="3dp" android:color="@color/btn_yellow_shadow" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/btn_yellow" />
            <stroke android:width="4dp" android:color="@color/btn_yellow_shadow" />
        </shape>
    </item>
</selector>