<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dropshadow layer -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp"/>
            <solid android:color="#000000"/>
        </shape>
    </item>
    <!-- Raised Metal Border -->
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp"/>
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#282a2e"
                android:endColor="#565c66"/>
            <stroke
                android:width="2dp"
                android:color="#7a828f"/>
        </shape>
    </item>
    <!-- Inner Groove Shadow -->
    <item android:top="8dp" android:left="8dp" android:right="8dp" android:bottom="10dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp"/>
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#080809"
                android:endColor="#16181b"/>
            <stroke
                android:width="2dp"
                android:color="#0a0b0d"/>
        </shape>
    </item>
</layer-list>