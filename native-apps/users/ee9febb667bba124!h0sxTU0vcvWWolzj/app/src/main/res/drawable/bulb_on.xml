<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Halo glow -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="60dp"
                android:startColor="#80ffdd00"
                android:endColor="#00ffdd00"/>
        </shape>
    </item>
    <!-- Metal Bezel -->
    <item android:top="8dp" android:left="8dp" android:right="8dp" android:bottom="10dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#3b3e43"
                android:endColor="#88909c"/>
        </shape>
    </item>
    <!-- Intense Glowing Glass Dome -->
    <item android:top="12dp" android:left="12dp" android:right="12dp" android:bottom="14dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="35dp"
                android:centerX="0.5"
                android:centerY="0.4"
                android:startColor="#ffffff"
                android:centerColor="#ffea00"
                android:endColor="#ff8c00"/>
            <stroke
                android:width="2dp"
                android:color="#ffffff"/>
        </shape>
    </item>
</layer-list>