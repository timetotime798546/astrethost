<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom Shadow -->
    <item android:top="8dp" android:bottom="0dp">
        <shape android:shape="oval">
            <solid android:color="#000000"/>
        </shape>
    </item>
    <!-- Metallic Raised Edge -->
    <item android:bottom="8dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#4e535a"
                android:endColor="#8c939d"/>
            <stroke
                android:width="2dp"
                android:color="#ccd1d9"/>
        </shape>
    </item>
    <!-- Inner Cap Plate (Darker) -->
    <item android:top="6dp" android:left="6dp" android:right="6dp" android:bottom="14dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="80dp"
                android:centerX="0.5"
                android:centerY="0.3"
                android:startColor="#3d4249"
                android:endColor="#1b1c1e"/>
            <stroke
                android:width="1.5dp"
                android:color="#121314"/>
        </shape>
    </item>
    <!-- Off Indicator Center (Dim Red) -->
    <item android:top="28dp" android:left="28dp" android:right="28dp" android:bottom="36dp">
        <shape android:shape="oval">
            <solid android:color="#3d1414"/>
            <stroke
                android:width="3dp"
                android:color="#702121"/>
        </shape>
    </item>
</layer-list>