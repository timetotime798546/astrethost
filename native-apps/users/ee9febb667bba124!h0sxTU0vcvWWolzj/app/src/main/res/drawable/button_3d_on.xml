<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Flatter switch down-shadow -->
    <item android:top="2dp" android:bottom="0dp">
        <shape android:shape="oval">
            <solid android:color="#000000"/>
        </shape>
    </item>
    <!-- Metallic Sunk Edge -->
    <item android:bottom="2dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#25272a"
                android:endColor="#4a4f56"/>
            <stroke
                android:width="1dp"
                android:color="#1d1e21"/>
        </shape>
    </item>
    <!-- Pressed Glowing Face -->
    <item android:top="3dp" android:left="3dp" android:right="3dp" android:bottom="5dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="80dp"
                android:centerX="0.5"
                android:centerY="0.5"
                android:startColor="#ff4d4d"
                android:endColor="#aa0d0d"/>
            <stroke
                android:width="1dp"
                android:color="#4a0404"/>
        </shape>
    </item>
    <!-- On Indicator Center (Bright White-Red Glow) -->
    <item android:top="25dp" android:left="25dp" android:right="25dp" android:bottom="27dp">
        <shape android:shape="oval">
            <solid android:color="#ffffff"/>
            <stroke
                android:width="4dp"
                android:color="#ffcccc"/>
        </shape>
    </item>
</layer-list>