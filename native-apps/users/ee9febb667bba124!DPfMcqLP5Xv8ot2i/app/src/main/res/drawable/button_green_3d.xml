<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed Tactile State -->
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="5dp" android:bottom="0dp" android:left="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#2E7D32" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- Normal Raised 3D State -->
    <item>
        <layer-list>
            <!-- Deep 3D Shadow Base -->
            <item android:top="5dp" android:left="2dp" android:right="2dp" android:bottom="0dp">
                <shape android:shape="rectangle">
                    <solid android:color="#1B5E20" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <!-- Raised Front Face -->
            <item android:bottom="5dp" android:left="1dp" android:right="3dp" android:top="0dp">
                <shape android:shape="rectangle">
                    <gradient 
                        android:startColor="#66BB6A" 
                        android:endColor="#43A047" 
                        android:angle="270" />
                    <corners android:radius="10dp" />
                    <stroke 
                        android:width="1.5dp" 
                        android:color="#A5D6A7" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>