<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 3D Extrusion Shadow Underlay -->
    <item android:top="5dp" android:left="2dp" android:right="2dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#CFD8DC" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Main Tactile Card Face -->
    <item android:bottom="5dp" android:left="1dp" android:right="3dp" android:top="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="14dp" />
            <stroke
                android:width="2dp"
                android:color="#ECEFF1" />
        </shape>
    </item>
</layer-list>