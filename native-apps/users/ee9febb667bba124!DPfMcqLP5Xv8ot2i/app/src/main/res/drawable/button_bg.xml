<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed Tactile State (Pushed physically down into the shadow) -->
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="5dp" android:bottom="0dp" android:left="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#1565C0" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- Normal Raised 3D State -->
    <item>
        <layer-list>
            <!-- Deep 3D Shadow Base -->
            <item android:top="5dp" android:left="2dp" android:right="2dp" android:bottom="0dp">
                <shape android:shape="rectangle">
                    <solid android:color="#0D47A1" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <!-- Raised Front Face -->
            <item android:bottom="5dp" android:left="1dp" android:right="3dp" android:top="0dp">
                <shape android:shape="rectangle">
                    <gradient 
                        android:startColor="#42A5F5" 
                        android:endColor="#1E88E5" 
                        android:angle="270" />
                    <corners android:radius="10dp" />
                    <stroke 
                        android:width="1.5dp" 
                        android:color="#90CAF9" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>