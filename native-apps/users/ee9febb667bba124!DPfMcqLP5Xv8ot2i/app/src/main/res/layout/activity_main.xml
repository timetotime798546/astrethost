<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#ECEFF1">

    <!-- 3D Header Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="#1E88E5"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:elevation="6dp">

        <TextView
            android:id="@+id/textAppTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Student Study Planner"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:shadowColor="#0D47A1"
            android:shadowDx="2"
            android:shadowDy="3"
            android:shadowRadius="1" />

        <Button
            android:id="@+id/buttonQuickAction"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="+ Quick Add"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:background="@drawable/button_green_3d"
            android:textColor="#FFFFFF"
            android:paddingLeft="14dp"
            android:paddingRight="14dp" />
    </LinearLayout>

    <!-- Content Sections Wrapper -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp">

        <!-- PANEL 1: DASHBOARD -->
        <ScrollView
            android:id="@+id/panelDashboard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp">

                <!-- Overall Progress Card with 3D shadow -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_bg"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Overall Plan Progress"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="#37474F" />

                    <TextView
                        android:id="@+id/textProgressPercentage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0% Complete"
                        android:textSize="30sp"
                        android:textColor="#2E7D32"
                        android:textStyle="bold"
                        android:layout_marginTop="6dp" />

                    <ProgressBar
                        android:id="@+id/progressOverall"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="14dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="14dp"
                        android:progressDrawable="@android:drawable/progress_horizontal" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3"
                        android:layout_marginTop="4dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/statTotalTasks"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="#37474F" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tasks Listed"
                                android:textSize="11sp"
                                android:textColor="#78909C" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/statTotalHours"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0h"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="#37474F" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Study Hours"
                                android:textSize="11sp"
                                android:textColor="#78909C" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/statSubjectsCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="#37474F" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Subjects"
                                android:textSize="11sp"
                                android:textColor="#78909C" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Subject-Wise Progress Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your Subjects Progress"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="#455A64"
                    android:layout_marginBottom="8dp"
                    android:layout_marginLeft="4dp" />

                <LinearLayout
                    android:id="@+id/layoutSubjectProgressList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp" />

                <!-- Quick Upcoming Reminders List -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Upcoming Alerts"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="#455A64"
                    android:layout_marginBottom="8dp"
                    android:layout_marginLeft="4dp" />

                <LinearLayout
                    android:id="@+id/layoutDashboardReminders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="16dp">
                    <TextView
                        android:id="@+id/textNoRemindersDashboard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No scheduled alarms or study events."
                        android:textColor="#78909C"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- PANEL 2: SUBJECTS -->
        <LinearLayout
            android:id="@+id/panelSubjects"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/btnAddSubject"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="+ Add New Subject"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_bg"
                android:textAllCaps="false"
                android:layout_marginBottom="16dp" />

            <ListView
                android:id="@+id/listViewSubjects"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@android:color/transparent"
                android:dividerHeight="10dp" />
        </LinearLayout>

        <!-- PANEL 3: TASKS -->
        <LinearLayout
            android:id="@+id/panelTasks"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp"
                android:gravity="center_vertical">

                <Spinner
                    android:id="@+id/spinnerTaskFilter"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginRight="10dp"
                    android:background="@drawable/card_bg"
                    android:paddingLeft="12dp" />

                <Button
                    android:id="@+id/btnAddTask"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="+ Add Task"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/button_bg"
                    android:textAllCaps="false"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp" />
            </LinearLayout>

            <ListView
                android:id="@+id/listViewTasks"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@android:color/transparent"
                android:dividerHeight="10dp" />
        </LinearLayout>

        <!-- PANEL 4: REMINDERS -->
        <LinearLayout
            android:id="@+id/panelReminders"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/btnAddReminder"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="+ Set Dynamic Alarm"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_bg"
                android:textAllCaps="false"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Active Planner Alarms"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#37474F"
                android:layout_marginBottom="10dp"
                android:layout_marginLeft="4dp" />

            <ListView
                android:id="@+id/listViewReminders"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@android:color/transparent"
                android:dividerHeight="10dp" />
        </LinearLayout>

    </FrameLayout>

    <!-- Bottom Tactile 3D Navigation Tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:elevation="12dp"
        android:weightSum="4"
        android:strokeWidth="1dp"
        android:strokeColor="#CFD8DC">

        <LinearLayout
            android:id="@+id/tabDashboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?android:attr/selectableItemBackground">
            <TextView
                android:id="@+id/tabTextDashboard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dashboard"
                android:textSize="12sp"
                android:textColor="#1E88E5"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabSubjects"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?android:attr/selectableItemBackground">
            <TextView
                android:id="@+id/tabTextSubjects"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Subjects"
                android:textSize="12sp"
                android:textColor="#78909C" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabTasks"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?android:attr/selectableItemBackground">
            <TextView
                android:id="@+id/tabTextTasks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tasks"
                android:textSize="12sp"
                android:textColor="#78909C" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabReminders"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?android:attr/selectableItemBackground">
            <TextView
                android:id="@+id/tabTextReminders"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reminders"
                android:textSize="12sp"
                android:textColor="#78909C" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>