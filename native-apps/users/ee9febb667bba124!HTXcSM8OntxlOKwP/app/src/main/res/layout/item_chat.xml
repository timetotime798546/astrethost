<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="8dp"
    android:paddingRight="8dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- User Bubble Panel layout -->
    <LinearLayout
        android:id="@+id/layout_user"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginLeft="60dp"
        android:background="@drawable/bg_user_bubble"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_user_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#0B1F0B"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tv_user_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:textColor="#5C7C5C"
            android:textSize="10sp"
            android:layout_marginTop="3dp" />
    </LinearLayout>

    <!-- AI Bubble Panel layout -->
    <LinearLayout
        android:id="@+id/layout_ai"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginRight="60dp"
        android:background="@drawable/bg_ai_bubble"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_ai_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#121212"
            android:textSize="15sp" />

        <!-- Bubble Action Panel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <!-- Quick click to speak this bubble offline -->
            <ImageButton
                android:id="@+id/btn_speak"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_speaker_bubble"
                android:scaleType="centerInside"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:contentDescription="Listen response" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_ai_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#888888"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>