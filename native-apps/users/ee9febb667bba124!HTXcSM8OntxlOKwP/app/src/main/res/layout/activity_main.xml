<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6F9">

    <!-- Header toolbar bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#1A73E8"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:elevation="4dp">

        <TextView
            android:id="@+id/tv_app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="Gemini Chat Pro"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Auto TTS Toggle Button -->
        <ImageButton
            android:id="@+id/btn_auto_tts"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_speak"
            android:scaleType="centerInside"
            android:contentDescription="Toggle Auto TTS" />
    </RelativeLayout>

    <!-- Key Rotation Pool Status Bar -->
    <LinearLayout
        android:id="@+id/layout_key_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E8F0FE"
        android:orientation="horizontal"
        android:padding="10dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            
            <TextView
                android:id="@+id/tv_rotation_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="API Pool: 40 Keys Loaded"
                android:textColor="#1A73E8"
                android:textSize="12sp"
                android:textStyle="bold" />
                
            <TextView
                android:id="@+id/tv_active_key_index"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Active Key: #1 (Tap status layout to configure)"
                android:textColor="#555555"
                android:textSize="10sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_rotate_now"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="#1A73E8"
            android:text="Rotate Key"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            style="?android:attr/buttonStyleSmall" />
    </LinearLayout>

    <!-- Message list area -->
    <ListView
        android:id="@+id/lv_chat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:stackFromBottom="true"
        android:transcriptMode="alwaysScroll"
        android:padding="8dp" />

    <!-- Progress Loader -->
    <RelativeLayout
        android:id="@+id/layout_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:background="#F4F6F9"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerHorizontal="true" />
    </RelativeLayout>

    <!-- Bottom Entry Layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:elevation="8dp">

        <EditText
            android:id="@+id/et_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:drawable/edit_text"
            android:hint="Type high-level prompt..."
            android:maxLines="4"
            android:textSize="15sp"
            android:padding="10dp"
            android:textColor="#333333" />

        <ImageButton
            android:id="@+id/btn_send"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_send"
            android:scaleType="centerInside"
            android:contentDescription="Send to Gemini" 
            android:layout_marginLeft="8dp" />
    </LinearLayout>
</LinearLayout>