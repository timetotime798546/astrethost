<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_match"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <!-- MAIN LIST PANEL -->
    <LinearLayout
        android:id="@+id/panel_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header Tool Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            android:background="#2196F3"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerY="true"
                android:text="NoteCraft"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_manage_cats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerY="true"
                android:background="?android:attr/selectableItemBackground"
                android:text="Categories"
                android:textColor="#FFFFFF" />
        </RelativeLayout>

        <!-- Search and Filter Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="#FFFFFF"
            android:elevation="4dp">

            <EditText
                android:id="@+id/edit_search"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:background="#F1F3F4"
                android:hint="Search notes..."
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Category Filter:" 
                    android:textSize="13sp"
                    android:textColor="#757575"/>

                <Spinner
                    android:id="@+id/spinner_filter"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Notes List View -->
        <ListView
            android:id="@+id/list_notes"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="#E0E0E0"
            android:dividerHeight="1dp"
            android:padding="8dp"
            android:clipToPadding="false" />

        <!-- Bottom Action Layout -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <Button
                android:id="@+id/btn_add_note"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="#2196F3"
                android:text="Create New Note"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </RelativeLayout>
    </LinearLayout>

    <!-- NOTE EDITOR PANEL (Hidden initially) -->
    <LinearLayout
        android:id="@+id/panel_editor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:visibility="gone">

        <!-- Editor Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            android:background="#F1F3F4"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/lbl_editor_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerY="true"
                android:text="Create Note"
                android:textColor="#212121"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_editor_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerY="true"
                android:background="?android:attr/selectableItemBackground"
                android:text="Cancel"
                android:textColor="#F44336" />
        </RelativeLayout>

        <!-- Editor Fields -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/edit_note_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Title"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:background="@null"
                    android:minHeight="48dp"
                    android:singleLine="true"
                    android:paddingBottom="8dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select Category"
                    android:textSize="12sp"
                    android:textColor="#757575" />

                <Spinner
                    android:id="@+id/spinner_note_cat"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:layout_marginBottom="16dp" />

                <EditText
                    android:id="@+id/edit_note_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Write your note here..."
                    android:textSize="16sp"
                    android:gravity="top|start"
                    android:background="@null"
                    android:minLines="10"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </ScrollView>

        <!-- Editor Bottom Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <Button
                android:id="@+id/btn_delete_note"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="#FFEBEE"
                android:text="Delete"
                android:textColor="#D32F2F"
                android:layout_marginEnd="8dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_save_note"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="2"
                android:background="#4CAF50"
                android:text="Save Note"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- CATEGORY MANAGEMENT PANEL (Hidden initially) -->
    <LinearLayout
        android:id="@+id/panel_categories"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:visibility="gone">

        <!-- Categories Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            android:background="#F1F3F4"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerY="true"
                android:text="Manage Categories"
                android:textColor="#212121"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_cats_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerY="true"
                android:background="?android:attr/selectableItemBackground"
                android:text="Done"
                android:textColor="#2196F3" />
        </RelativeLayout>

        <!-- Add Category Control -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <EditText
                android:id="@+id/edit_new_cat"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:hint="New Category Name"
                android:background="#F1F3F4"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_create_cat"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:background="#2196F3"
                android:text="Add"
                android:textColor="#FFFFFF"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Categories list -->
        <ListView
            android:id="@+id/list_categories"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="#E0E0E0"
            android:dividerHeight="1dp"
            android:padding="16dp"
            android:clipToPadding="false" />
    </LinearLayout>
</FrameLayout>
