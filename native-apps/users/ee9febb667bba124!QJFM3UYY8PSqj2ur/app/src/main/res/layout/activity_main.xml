<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main"
    android:padding="16dp">

    <!-- Display Screens Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3.2"
        android:orientation="vertical"
        android:gravity="bottom|end"
        android:padding="8dp">

        <!-- Equation Formula Screen -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:scrollbars="none">
            <TextView
                android:id="@+id/tvFormula"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/text_formula"
                android:textSize="28sp"
                android:maxLines="1"
                android:gravity="end"
                android:layout_gravity="end" />
        </HorizontalScrollView>

        <!-- Output / Preview Result Screen -->
        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/text_result"
            android:textSize="56sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="end"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- Elegant Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2E2F38"
        android:layout_marginBottom="12dp" />

    <!-- Premium Grid Core Control Layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="6.8"
        android:orientation="vertical">

        <!-- Row 1: C, ( ), %, / -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            <Button
                android:id="@+id/btn_clear"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/btn_action"
                android:text="C"
                android:textColor="@color/btn_action_text"
                android:textSize="22sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/btn_brackets"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/btn_action"
                android:text="( )"
                android:textColor="@color/btn_action_text"
                android:textSize="22sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/btn_percent"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/btn_action"
                android:text="%"
                android:textColor="@color/btn_action_text"
                android:textSize="22sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/btn_div"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/btn_operator"
                android:text="÷"
                android:textColor="@color/btn_op_text"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 2: 7, 8, 9, x -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            <Button
                android:id="@+id/btn_7"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/btn_number"
                android:text="7"
                android:textColor="@color/btn_num_text"
                android:textSize="24sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/btn_8"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/btn_number"
                android:text="8"
                android:textColor="@color/btn_num_text"
                android:textSize="24sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/btn_9"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/btn_number"
                android:text="9"
                android:textColor="@color/btn_num_text"
                android:textSize="24sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/btn_mul"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/btn_operator"
                android:text="×"
                android:textColor="@color/btn_op_text"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 3: 4, 5, 6, - -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            <Button
                android:id="@+id/btn_4"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/btn_number"
                android:text="4"
                android:textColor="@color/btn_num_text"
                android:textSize="24sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/btn_5"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/btn_number"
                android:text="5"
                android:textColor="@color/btn_num_text"
                android:textSize="24sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/btn_6"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/btn_number"
                android:text="6"
                android:textColor="@color/btn_num_text"
                android:textSize="24sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/btn_sub"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/btn_operator"
                android:text="−"
                android:textColor="@color/btn_op_text"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 4: 1, 2, 3, + -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            <Button
                android:id="@+id/btn_1"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/btn_number"
                android:text="1"
                android:textColor="@color/btn_num_text"
                android:textSize="24sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/btn_2"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/btn_number"
                android:text="2"
                android:textColor="@color/btn_num_text"
                android:textSize="24sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/btn_3"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/btn_number"
                android:text="3"
                android:textColor="@color/btn_num_text"
                android:textSize="24sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/btn_add"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/btn_operator"
                android:text="+"
                android:textColor="@color/btn_op_text"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 5: 0, ., Back, = -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btn_0"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/btn_number"
                android:text="0"
                android:textColor="@color/btn_num_text"
                android:textSize="24sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/btn_dot"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/btn_number"
                android:text="."
                android:textColor="@color/btn_num_text"
                android:textSize="24sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/btn_back"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/btn_action"
                android:text="⌫"
                android:textColor="@color/btn_action_text"
                android:textSize="20sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/btn_equal"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/btn_operator"
                android:text="="
                android:textColor="@color/btn_op_text"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>