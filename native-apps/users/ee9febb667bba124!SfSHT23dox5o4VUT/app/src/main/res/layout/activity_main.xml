<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1. LOGIN LAYOUT -->
            <LinearLayout
                android:id="@+id/layout_login"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginTop="60dp"
                android:background="#FFFFFF"
                android:elevation="4dp"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="स्कूल एडमिन लॉगिन"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#1E3A8A"
                    android:layout_gravity="center"
                    android:layout_marginBottom="24dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="यूज़रनेम (admin)"
                    android:textColor="#475569"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/et_username"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="admin दर्ज करें"
                    android:background="#E2E8F0"
                    android:paddingLeft="12dp"
                    android:singleLine="true"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="पासवर्ड (password)"
                    android:textColor="#475569"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/et_password"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="password दर्ज करें"
                    android:background="#E2E8F0"
                    android:paddingLeft="12dp"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:layout_marginBottom="24dp" />

                <Button
                    android:id="@+id/btn_login"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="प्रवेश करें (Login)"
                    android:background="#1E3A8A"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 2. DASHBOARD LAYOUT -->
            <LinearLayout
                android:id="@+id/layout_dashboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Header -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="मुख्य डैशबोर्ड"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#1E3A8A" />

                    <Button
                        android:id="@+id/btn_logout"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_alignParentRight="true"
                        android:background="#DC2626"
                        android:text="लॉगआउट"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />
                </RelativeLayout>

                <!-- Statistics Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3"
                    android:layout_marginBottom="20dp">

                    <!-- Card 1 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="#EFF6FF"
                        android:padding="12dp"
                        android:layout_marginRight="4dp"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="कुल छात्र"
                            android:textSize="11sp"
                            android:textColor="#1E40AF" />
                        <TextView
                            android:id="@+id/tv_stat_total_students"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#1E3A8A" />
                    </LinearLayout>

                    <!-- Card 2 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="#ECFDF5"
                        android:padding="12dp"
                        android:layout_marginRight="4dp"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="आज उपस्थिति"
                            android:textSize="11sp"
                            android:textColor="#065F46" />
                        <TextView
                            android:id="@+id/tv_stat_present_today"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#047857" />
                    </LinearLayout>

                    <!-- Card 3 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="#FFFBEB"
                        android:padding="12dp"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="कुल फीस प्राप्त"
                            android:textSize="11sp"
                            android:textColor="#92400E" />
                        <TextView
                            android:id="@+id/tv_stat_fees_collected"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹0"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#B45309" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Features Grid Menu -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="मैनेजमेंट मॉड्यूल"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#475569"
                    android:layout_marginBottom="10dp" />

                <Button
                    android:id="@+id/btn_nav_add_student"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="➕ नया स्टूडेंट जोड़ें"
                    android:background="#1E3A8A"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btn_nav_view_students"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="📋 स्टूडेंट डायरेक्टरी (सूची)"
                    android:background="#1E3A8A"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btn_nav_attendance"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="✅ उपस्थिति दर्ज करें (Attendance)"
                    android:background="#1E3A8A"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btn_nav_fees"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="💰 फीस कलेक्शन रिकॉर्ड"
                    android:background="#1E3A8A"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btn_nav_marks"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="✍️ परीक्षा मार्क्स प्रविष्टि"
                    android:background="#1E3A8A"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="12dp" />

            </LinearLayout>

            <!-- 3. ADD STUDENT LAYOUT -->
            <LinearLayout
                android:id="@+id/layout_add_student"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="नया छात्र जोडें"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#1E3A8A"
                    android:layout_marginBottom="16dp" />

                <EditText
                    android:id="@+id/et_student_name"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="छात्र का पूरा नाम"
                    android:background="#E2E8F0"
                    android:paddingLeft="12dp"
                    android:layout_marginBottom="12dp" />

                <EditText
                    android:id="@+id/et_student_roll"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="रोल नंबर"
                    android:background="#E2E8F0"
                    android:paddingLeft="12dp"
                    android:layout_marginBottom="12dp" />

                <EditText
                    android:id="@+id/et_student_class"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="कक्षा/क्लास (जैसे: 10th)"
                    android:background="#E2E8F0"
                    android:paddingLeft="12dp"
                    android:layout_marginBottom="12dp" />

                <EditText
                    android:id="@+id/et_student_contact"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="मोबाइल नंबर"
                    android:background="#E2E8F0"
                    android:paddingLeft="12dp"
                    android:inputType="phone"
                    android:layout_marginBottom="20dp" />

                <Button
                    android:id="@+id/btn_save_student"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="सहेजें (Save Student)"
                    android:background="#16A34A"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="10dp" />

                <Button
                    android:id="@+id/btn_cancel_add_student"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="वापस जाएँ"
                    android:background="#64748B"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <!-- 4. VIEW STUDENTS LAYOUT -->
            <LinearLayout
                android:id="@+id/layout_view_students"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="स्टूडेंट डायरेक्टरी सूची"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#1E3A8A"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="(छात्र हटाने के लिए नाम पर देर तक दबाएं - Long Click to Delete)"
                    android:textSize="11sp"
                    android:textColor="#DC2626"
                    android:layout_marginBottom="12dp" />

                <ListView
                    android:id="@+id/lv_students"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:background="#E2E8F0"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/btn_back_view_students"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="मुख्य मेनू में जाएँ"
                    android:background="#64748B"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <!-- 5. ATTENDANCE LAYOUT -->
            <LinearLayout
                android:id="@+id/layout_attendance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="दैनिक उपस्थिति दर्ज करें"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#1E3A8A"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. छात्र चुनें:"
                    android:textColor="#475569"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    android:id="@+id/spinner_attendance_student"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="#E2E8F0"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. स्थिति (Status):"
                    android:textColor="#475569"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    android:id="@+id/spinner_attendance_status"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="#E2E8F0"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/btn_save_attendance"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="उपस्थिति दर्ज करें"
                    android:background="#16A34A"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="आज की उपस्थिति लॉग:"
                    android:textStyle="bold"
                    android:textColor="#475569"
                    android:layout_marginBottom="4dp" />

                <ListView
                    android:id="@+id/lv_attendance_log"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:background="#E2E8F0"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/btn_back_attendance"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="मुख्य मेनू में जाएँ"
                    android:background="#64748B"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <!-- 6. FEES LAYOUT -->
            <LinearLayout
                android:id="@+id/layout_fees"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="फीस कलेक्शन रिकॉर्डर"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#1E3A8A"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="छात्र चुनें:"
                    android:textColor="#475569"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    android:id="@+id/spinner_fee_student"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="#E2E8F0"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="जमा की गई राशि (₹):"
                    android:textColor="#475569"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/et_fee_amount"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="रुपये दर्ज करें (उदा. 2500)"
                    android:background="#E2E8F0"
                    android:inputType="numberDecimal"
                    android:paddingLeft="12dp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="फीस की स्थिति:"
                    android:textColor="#475569"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    android:id="@+id/spinner_fee_status"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="#E2E8F0"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/btn_save_fee"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="फीस रिकॉर्ड जमा करें"
                    android:background="#16A34A"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="भुगतान इतिहास:"
                    android:textStyle="bold"
                    android:textColor="#475569"
                    android:layout_marginBottom="4dp" />

                <ListView
                    android:id="@+id/lv_fee_log"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:background="#E2E8F0"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/btn_back_fees"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="मुख्य मेनू में जाएँ"
                    android:background="#64748B"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <!-- 7. MARKS LAYOUT -->
            <LinearLayout
                android:id="@+id/layout_marks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="छात्र परीक्षा मार्क्स प्रविष्टि"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#1E3A8A"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="छात्र चुनें:"
                    android:textColor="#475569"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    android:id="@+id/spinner_marks_student"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="#E2E8F0"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="विषय (Subject):"
                    android:textColor="#475569"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/et_marks_subject"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="उदा. गणित (Maths), विज्ञान"
                    android:background="#E2E8F0"
                    android:paddingLeft="12dp"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginRight="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="प्राप्त अंक:"
                            android:textColor="#475569"
                            android:layout_marginBottom="4dp" />

                        <EditText
                            android:id="@+id/et_marks_score"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:hint="उदा. 85"
                            android:background="#E2E8F0"
                            android:inputType="numberDecimal"
                            android:paddingLeft="12dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="अधिकतम अंक:"
                            android:textColor="#475569"
                            android:layout_marginBottom="4dp" />

                        <EditText
                            android:id="@+id/et_marks_max"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:hint="उदा. 100"
                            android:background="#E2E8F0"
                            android:inputType="numberDecimal"
                            android:paddingLeft="12dp" />
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btn_save_marks"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="मार्क्स सेव करें"
                    android:background="#16A34A"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="हालिया परिणाम रिकॉर्ड्स:"
                    android:textStyle="bold"
                    android:textColor="#475569"
                    android:layout_marginBottom="4dp" />

                <ListView
                    android:id="@+id/lv_marks_log"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:background="#E2E8F0"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/btn_back_marks"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="मुख्य मेनू में जाएँ"
                    android:background="#64748B"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</RelativeLayout>