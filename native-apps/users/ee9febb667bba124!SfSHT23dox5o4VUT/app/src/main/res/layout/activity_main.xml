<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_match"
    android:layout_height="match_parent"
    android:background="#FAFAFA">

    <!-- SETUP SCREEN -->
    <LinearLayout
        android:id="@+id/setup_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="visible">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Offline AI"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#111111"
            android:gravity="center"
            android:layout_marginTop="48dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Local Llama.cpp + Qwen 2.5 GGUF Chat"
            android:textSize="14sp"
            android:textColor="#666666"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- RAM Monitor Banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFF9C4"
            android:padding="12dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/ram_status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Checking RAM status..."
                android:textColor="#333333"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/ram_warning_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Please wait while scanning system resources."
                android:textColor="#E65100"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Installation Options Card -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose Action:"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btn_setup_install"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📥 Install AI Model (GGUF)"
            android:background="#007AFF"
            android:textColor="#FFFFFF"
            android:padding="14dp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btn_setup_choose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚙️ Model Settings / Management"
            android:background="#E5E5EA"
            android:textColor="#333333"
            android:padding="14dp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btn_setup_continue_mock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💬 Continue offline (Local Engine)"
            android:background="#E5E5EA"
            android:textColor="#333333"
            android:padding="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="* The AI runs completely on-device. No API keys or remote servers are contacted once models are downloaded successfully."
            android:textSize="11sp"
            android:textColor="#999999"
            android:gravity="center"
            android:layout_marginTop="32dp" />
    </LinearLayout>

    <!-- DOWNLOAD SCREEN -->
    <LinearLayout
        android:id="@+id/download_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Model Installer"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#111111"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose Qwen 2.5 GGUF model size to install:"
            android:textColor="#666666"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <!-- Option 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:elevation="2dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Qwen 2.5 Instruct 1.5B (Q4_K_M)"
                android:textStyle="bold"
                android:textColor="#007AFF"
                android:textSize="16sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="File Size: 980 MB | Recommended RAM: 4GB+ RAM"
                android:textColor="#333333"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
            <Button
                android:id="@+id/btn_dl_qwen_1_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Download (980MB)" />
        </LinearLayout>

        <!-- Option 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="24dp"
            android:elevation="2dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Qwen 2.5 Instruct 3B (Q4_K_M)"
                android:textStyle="bold"
                android:textColor="#007AFF"
                android:textSize="16sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="File Size: 1.9 GB | Recommended RAM: 6GB+ RAM"
                android:textColor="#333333"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
            <Button
                android:id="@+id/btn_dl_qwen_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Download (1.9GB)" />
        </LinearLayout>

        <!-- Download Progress Section -->
        <LinearLayout
            android:id="@+id/progress_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/dl_status_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Preparing download stream..."
                android:textStyle="bold"
                android:textColor="#111111" />

            <ProgressBar
                android:id="@+id/dl_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:max="100" />

            <TextView
                android:id="@+id/dl_meta_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0.0 MB of 0.0 MB (0.00 KB/s)"
                android:textColor="#555555"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_cancel_download"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#FF3B30"
                android:textColor="#FFFFFF"
                android:text="Cancel Download" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btn_dl_back"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back to Menu"
            android:background="#E5E5EA"
            android:textColor="#333333" />
    </LinearLayout>

    <!-- CHAT SCREEN -->
    <LinearLayout
        android:id="@+id/chat_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Custom Toolbar -->
        <RelativeLayout
            android:id="@+id/chat_toolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp">

            <TextView
                android:id="@+id/chat_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="Offline AI Chat"
                android:textStyle="bold"
                android:textColor="#111111"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/chat_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/chat_title"
                android:layout_marginTop="-2dp"
                android:text="Qwen Offline Engine"
                android:textColor="#00875A"
                android:textSize="10sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_theme_toggle"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="🌓"
                    android:background="#00000000" />

                <Button
                    android:id="@+id/btn_chat_settings"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="⚙️"
                    android:background="#00000000" />

                <Button
                    android:id="@+id/btn_chat_exit"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="🚪"
                    android:background="#00000000" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Chat Messages List Container -->
        <ScrollView
            android:id="@+id/chat_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="12dp"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/chat_bubble_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <!-- Inference Stats Indicator -->
        <TextView
            android:id="@+id/inference_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#EAEAEA"
            android:padding="6dp"
            android:text="System Ready | Threads: 4 | Context: 2048"
            android:textColor="#444444"
            android:textSize="11sp"
            android:gravity="center" />

        <!-- Message Input Bar -->
        <LinearLayout
            android:id="@+id/input_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#FFFFFF"
            android:padding="8dp"
            android:elevation="8dp">

            <EditText
                android:id="@+id/et_message_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#F2F2F7"
                android:padding="12dp"
                android:hint="Ask anything offline..."
                android:textSize="14sp"
                android:textColor="#111111"
                android:maxLines="4" />

            <Button
                android:id="@+id/btn_send"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Send"
                android:background="#007AFF"
                android:textColor="#FFFFFF"
                android:layout_marginLeft="8dp" />

            <Button
                android:id="@+id/btn_stop_generation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stop"
                android:background="#FF3B30"
                android:textColor="#FFFFFF"
                android:layout_marginLeft="8dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- SETTINGS DIALOG VIEW CONTAINER (Simulated modal container) -->
    <FrameLayout
        android:id="@+id/settings_dialog_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="24dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Offline Llama.cpp Settings"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#111111"
                android:layout_marginBottom="16dp" />

            <!-- Model configuration spinner -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Current Model:"
                android:textSize="12sp"
                android:textColor="#555555" />

            <Spinner
                android:id="@+id/spinner_model"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp" />

            <!-- Thread configurations -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CPU Inference Threads:"
                android:textSize="12sp"
                android:textColor="#555555" />

            <Spinner
                android:id="@+id/spinner_threads"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp" />

            <!-- Context token size -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Context Window Token Count:"
                android:textSize="12sp"
                android:textColor="#555555" />

            <Spinner
                android:id="@+id/spinner_context"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp" />

            <!-- Temperature slider selection parameters -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Creativity Temperature:"
                android:textSize="12sp"
                android:textColor="#555555" />

            <Spinner
                android:id="@+id/spinner_temp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Max Completion Tokens:"
                android:textSize="12sp"
                android:textColor="#555555" />

            <Spinner
                android:id="@+id/spinner_max_tokens"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btn_save_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Save Settings &amp; Reload Engine"
                android:background="#007AFF"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </FrameLayout>
</RelativeLayout>