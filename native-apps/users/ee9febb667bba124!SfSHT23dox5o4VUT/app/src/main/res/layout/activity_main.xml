<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Main Title Header -->
        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="नितिन लाइव वॉलपेपर"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="5dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="कस्टमाइज करें और अपने स्क्रीन पर सेट करें"
            android:textColor="#8A8A8F"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="25dp" />

        <!-- Live Preview / Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E1E1E"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="20dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✨ त्वरित पूर्वावलोकन (Preview)"
                android:textColor="#00E5FF"
                android:textStyle="bold"
                android:textSize="15sp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/textPreview"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="#151515"
                android:gravity="center"
                android:text="नितिन"
                android:textColor="#FFFFFF"
                android:textSize="40sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ऊपर दी गई सेटिंग्स के अनुसार आपका लाइव वॉलपेपर स्क्रीन पर काम करेगा।"
                android:textColor="#8A8A8F"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Custom Name Input -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="अपना नाम लिखें (या नितिन रहने दें):"
            android:textColor="#E0E0E0"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/nameInput"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#2C2C2E"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:text="नितिन"
            android:singleLine="true"
            android:layout_marginBottom="20dp" />

        <!-- Color Themes Card -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="कलर स्कीम चुनें:"
            android:textColor="#E0E0E0"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/colorGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <RadioButton
                android:id="@+id/radioBlue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="नियॉन इलेक्ट्रिक ब्लू (Neon Blue)"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="6dp"
                android:checked="true" />

            <RadioButton
                android:id="@+id/radioRose"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="सनसेट रोज़ और डार्क पिंक (Sunset Rose)"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="6dp" />

            <RadioButton
                android:id="@+id/radioGold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="साइबर गोल्ड और मैटेलिक (Cyber Gold)"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="6dp" />

            <RadioButton
                android:id="@+id/radioPurple"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="कॉस्मिक पर्पल और मैजेंटा (Cosmic Purple)"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="6dp" />

            <RadioButton
                android:id="@+id/radioMint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="पुदीना ओरोरा और सायन (Mint Aurora)"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="6dp" />
        </RadioGroup>

        <!-- Animation Style -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="नाम का एनीमेशन स्टाइल:"
            android:textColor="#E0E0E0"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/animGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <RadioButton
                android:id="@+id/animPulse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="पल्स और रोटेशन (Pulse &amp; Spin)"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="6dp"
                android:checked="true" />

            <RadioButton
                android:id="@+id/animBounce"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="बाउंस और रोटेशन (Bounce &amp; Spin)"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="6dp" />

            <RadioButton
                android:id="@+id/animWave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="काइनेटिक लहरें (Kinetic Wave)"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="6dp" />

            <RadioButton
                android:id="@+id/animFloat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="शांत तैरता नाम (Elegant Float)"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="6dp" />
        </RadioGroup>

        <!-- Particle Effect -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="पृष्ठभूमि डेकोरेटिव कण (Particles):"
            android:textColor="#E0E0E0"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/particleGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <RadioButton
                android:id="@+id/partSparkle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="कॉस्मिक चमकते सितारे (Sparkles)"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="6dp"
                android:checked="true" />

            <RadioButton
                android:id="@+id/partHeart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="उड़ते हुए दिल (Hearts)"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="6dp" />

            <RadioButton
                android:id="@+id/partBubble"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="पुलबुले और ग्लोब (Soft Bubbles)"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="6dp" />

            <RadioButton
                android:id="@+id/partNone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="कोई कण नहीं (None)"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="6dp" />
        </RadioGroup>

        <!-- Particle Speed -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="कणों की गति (Speed):"
            android:textColor="#E0E0E0"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/speedGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <RadioButton
                android:id="@+id/speedSlow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="धीमी"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/speedMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="मध्यम"
                android:textColor="#FFFFFF"
                android:checked="true" />

            <RadioButton
                android:id="@+id/speedFast"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="तेज़"
                android:textColor="#FFFFFF" />
        </RadioGroup>

        <!-- Touch Interaction Switch -->
        <CheckBox
            android:id="@+id/checkRipple"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="टच फीडबैक (स्क्रीन छूने पर तरंग और स्टार फूटेंगे)"
            android:textColor="#E0E0E0"
            android:textSize="14sp"
            android:checked="true"
            android:layout_marginBottom="25dp" />

        <!-- APPLY LIVE WALLPAPER BUTTON -->
        <Button
            android:id="@+id/btnApply"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="वॉलपेपर लागू करें (Apply Wallpaper)"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="#FF5722"
            android:layout_marginBottom="25dp" />

        <!-- Setup Instruction Manual Panel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E1E1E"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💡 लाइव वॉलपेपर लगाने का तरीका:"
                android:textColor="#FFEB3B"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. ऊपर \'वॉलपेपर लागू करें\' बटन पर क्लिक करें।\n2. यह आपके फ़ोन की लाइव वॉलपेपर सेटिंग्स खोल देगा।\n3. सूची में \'Nitin Name Live Wallpaper\' चुनें और लागू (Apply) करें।\n4. यदि ऊपर का बटन काम नहीं करता है, तो आप फ़ोन की मुख्य \'Settings -> Wallpaper -> Live Wallpapers\' में जाकर भी इसे सक्रिय कर सकते हैं।"
                android:textColor="#B0BEC5"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.2" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>