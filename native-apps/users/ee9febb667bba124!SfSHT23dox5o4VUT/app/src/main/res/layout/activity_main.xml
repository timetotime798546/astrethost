<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#212121">

    <!-- Display TextView -->
    <TextView
        android:id="@+id/display_text_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom|right"
        android:padding="16dp"
        android:textSize="60sp"
        android:textColor="#FFFFFF"
        android:text="0"
        android:maxLines="1"
        android:ellipsize="start"
        android:background="#3A3A3A" />

    <!-- Buttons Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:orientation="vertical">

        <!-- Row 1: C, /, * -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <Button style="@style/CalculatorButton.Function" android:id="@+id/button_clear" android:text="C" />
            <Button style="@style/CalculatorButton.Operation" android:id="@+id/button_divide" android:text="/" />
            <Button style="@style/CalculatorButton.Operation" android:id="@+id/button_multiply" android:text="*" />
            <Button style="@style/CalculatorButton.Operation" android:id="@+id/button_minus" android:text="-" />
        </LinearLayout>

        <!-- Row 2: 7, 8, 9, + -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <Button style="@style/CalculatorButton.Number" android:id="@+id/button7" android:text="7" />
            <Button style="@style/CalculatorButton.Number" android:id="@+id/button8" android:text="8" />
            <Button style="@style/CalculatorButton.Number" android:id="@+id/button9" android:text="9" />
            <Button style="@style/CalculatorButton.Operation" android:id="@+id/button_plus" android:text="+" />
        </LinearLayout>

        <!-- Row 3: 4, 5, 6 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <Button style="@style/CalculatorButton.Number" android:id="@+id/button4" android:text="4" />
            <Button style="@style/CalculatorButton.Number" android:id="@+id/button5" android:text="5" />
            <Button style="@style/CalculatorButton.Number" android:id="@+id/button6" android:text="6" />
            <Button style="@style/CalculatorButton.Equals" android:id="@+id/button_equals" android:text="=" android:layout_height="match_parent" android:layout_weight="1"/>
        </LinearLayout>

        <!-- Row 4: 1, 2, 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <Button style="@style/CalculatorButton.Number" android:id="@+id/button1" android:text="1" />
            <Button style="@style/CalculatorButton.Number" android:id="@+id/button2" android:text="2" />
            <Button style="@style/CalculatorButton.Number" android:id="@+id/button3" android:text="3" />

        </LinearLayout>

        <!-- Row 5: 0, . -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <Button style="@style/CalculatorButton.Number" android:id="@+id/button0" android:text="0" android:layout_weight="2"/>
            <Button style="@style/CalculatorButton.Number" android:id="@+id/button_dot" android:text="." />

        </LinearLayout>

    </LinearLayout>

    <!-- Styles for buttons -->
    <style name="CalculatorButton" parent="android:Widget.Material.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">30sp</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="CalculatorButton.Number" parent="CalculatorButton">
        <item name="android:background">#424242</item>
    </style>

    <style name="CalculatorButton.Operation" parent="CalculatorButton">
        <item name="android:background">#FF9800</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="CalculatorButton.Function" parent="CalculatorButton">
        <item name="android:background">#616161</item>
    </style>

    <style name="CalculatorButton.Equals" parent="CalculatorButton">
        <item name="android:background">#FF5722</item>
    </style>

</LinearLayout>