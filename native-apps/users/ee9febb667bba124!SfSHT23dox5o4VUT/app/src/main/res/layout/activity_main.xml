<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6F9">

    <!-- Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:background="#2196F3"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Audio Booster"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- SECTION 1: AUDIO RECORDER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:elevation="2dp"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Record Audio"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <Button
                        android:id="@+id/btn_record_start"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginRight="4dp"
                        android:text="Start Record"
                        android:background="#4CAF50"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/btn_record_stop"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginLeft="4dp"
                        android:text="Stop Record"
                        android:background="#F44336"
                        android:textColor="#FFFFFF"
                        android:enabled="false" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txt_record_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="Status: Idle"
                    android:textStyle="bold"
                    android:textColor="#666666"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- SECTION 2: AMPLIFICATION SETTINGS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:elevation="2dp"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. Amplify Audio Samples"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/txt_selected_file"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Selected File: None (Tap on standard recording below)"
                    android:textStyle="italic"
                    android:textColor="#777777"
                    android:layout_marginBottom="14dp"
                    android:background="#EFEFEF"
                    android:padding="8dp" />

                <TextView
                    android:id="@+id/txt_amplify_level"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Amplification Level: 15x"
                    android:textStyle="bold"
                    android:textColor="#2196F3"
                    android:layout_marginBottom="6dp" />

                <SeekBar
                    android:id="@+id/seek_amplify"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="49"
                    android:progress="14"
                    android:layout_marginBottom="14dp" />

                <Button
                    android:id="@+id/btn_amplify_process"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Amplify &amp; Save File"
                    android:background="#2196F3"
                    android:textColor="#FFFFFF"
                    android:enabled="false" />
            </LinearLayout>

            <!-- SECTION 3: AUDIO LIST -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:elevation="2dp"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3. Saved Recordings &amp; Amplified Files"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_marginBottom="12dp" />

                <ListView
                    android:id="@+id/list_audio_files"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:divider="#E0E0E0"
                    android:dividerHeight="1dp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <Button
                        android:id="@+id/btn_play_selected"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginRight="2dp"
                        android:textSize="12sp"
                        android:text="Play"
                        android:background="#E0E0E0"
                        android:textColor="#333333"
                        android:enabled="false" />

                    <Button
                        android:id="@+id/btn_stop_selected"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginLeft="2dp"
                        android:layout_marginRight="2dp"
                        android:textSize="12sp"
                        android:text="Stop Play"
                        android:background="#E0E0E0"
                        android:textColor="#333333"
                        android:enabled="false" />

                    <Button
                        android:id="@+id/btn_delete_selected"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginLeft="2dp"
                        android:textSize="12sp"
                        android:text="Delete"
                        android:background="#FFCDD2"
                        android:textColor="#B71C1C"
                        android:enabled="false" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>