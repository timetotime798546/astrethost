<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF0F2">

    <!-- Header Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FF6B8B"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <TextView
            android:id="@+id/app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="Priya ❤️ AI Girlfriend"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <!-- Voice Mode Status / Toggle Indicator -->
            <ImageView
                android:id="@+id/btn_voice_toggle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@android:drawable/ic_lock_silent_mode_off"
                android:contentDescription="Voice Toggle"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:layout_marginRight="8dp" />

            <ImageView
                android:id="@+id/btn_settings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_preferences"
                android:contentDescription="Settings"
                android:background="?android:attr/selectableItemBackgroundBorderless" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Voice Status Banner -->
    <LinearLayout
        android:id="@+id/voice_status_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FFE3EC"
        android:padding="8dp"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:id="@+id/voice_status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎙️ Real-Time Voice Chat Active 🎙️"
            android:textColor="#FF4081"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Chat Message List -->
    <ListView
        android:id="@+id/chat_list_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="8dp"
        android:padding="12dp"
        android:clipToPadding="false"
        android:stackFromBottom="true"
        android:transcriptMode="alwaysScroll" />

    <!-- Cancel Send Panel Container -->
    <LinearLayout
        android:id="@+id/cancel_send_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FFE5EC"
        android:padding="10dp"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/cancel_send_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Sending message in 3s..."
            android:textColor="#FF4081"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingLeft="8dp" />

        <Button
            android:id="@+id/btn_cancel_send"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Undo"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF4081"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Message Composer panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical">

        <!-- Microphone Voice Button -->
        <ImageView
            android:id="@+id/btn_mic"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@android:drawable/ic_btn_speak_now"
            android:contentDescription="Speak to Priya"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:layout_marginRight="4dp" />

        <EditText
            android:id="@+id/input_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Type a sweet message to Priya..."
            android:background="@android:color/transparent"
            android:padding="12dp"
            android:maxLines="4"
            android:inputType="textCapSentences|textMultiLine"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btn_send"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Send"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF6B8B"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>