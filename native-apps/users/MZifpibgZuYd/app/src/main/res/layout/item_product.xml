<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="@color/card_bg"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/item_prod_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Product Name"
            android:textColor="@color/text_main"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/item_prod_sku"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SKU: 1002"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/item_prod_pricing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sell: ₹150.00 | Cost: ₹100.00"
            android:textColor="@color/accent_dark"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:id="@+id/item_prod_stock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stock: 25"
            android:textColor="@color/text_main"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/item_prod_alert"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LOW STOCK"
            android:textColor="@color/danger"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>