<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/card_white_bg"
    android:padding="14dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/tvItemCategoryBadge"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/filter_chip_inactive"
        android:text="🛍️"
        android:textSize="18sp"
        android:gravity="center"
        android:layout_marginEnd="12dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvItemTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Groceries"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvItemSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Food &amp; Dining • 2025-05-10"
            android:textColor="#64748B"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:id="@+id/tvItemAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-$45.00"
            android:textColor="#EF4444"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnItemDelete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Delete"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:padding="2dp" />
    </LinearLayout>

</LinearLayout>