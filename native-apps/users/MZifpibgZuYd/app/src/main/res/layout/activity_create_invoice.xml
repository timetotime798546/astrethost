<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="New Invoice Generator"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:layout_marginBottom="14dp" />

        <!-- Customer Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Customer Details"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etCustomerName"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@drawable/bg_input"
                android:hint="Customer Name (e.g., Sarah Johnson)"
                android:textSize="13sp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etCustomerPhone"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@drawable/bg_input"
                android:hint="Phone Number (e.g., +1 555-0199)"
                android:inputType="phone"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Line Items Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Invoice Items"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary" />

                <Button
                    android:id="@+id/btnAddItem"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_button_accent"
                    android:text="+ Add Item"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/itemsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Offline Calculation & Adjustment Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Billing Summary (Real-Time)"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:layout_marginBottom="12dp" />

            <!-- Subtotal -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Subtotal"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvSummarySubtotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$0.00"
                    android:textStyle="bold"
                    android:textColor="@color/primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Discount Input -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Discount %"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etDiscountPercent"
                    android:layout_width="70dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_input"
                    android:inputType="numberDecimal"
                    android:text="0"
                    android:textSize="13sp"
                    android:gravity="end" />

                <TextView
                    android:id="@+id/tvDiscountAmount"
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:text="-$0.00"
                    android:textColor="@color/danger_red"
                    android:textSize="13sp"
                    android:gravity="end"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- Tax Input -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tax / GST %"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etTaxPercent"
                    android:layout_width="70dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_input"
                    android:inputType="numberDecimal"
                    android:text="8.5"
                    android:textSize="13sp"
                    android:gravity="end" />

                <TextView
                    android:id="@+id/tvTaxAmount"
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:text="+$0.00"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp"
                    android:gravity="end"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- Net Total -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Net Invoice Total"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary" />

                <TextView
                    android:id="@+id/tvSummaryTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$0.00"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_blue" />
            </LinearLayout>

            <!-- Payment Received Input -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Amount Paid Now"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etPaidAmount"
                    android:layout_width="110dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_input"
                    android:inputType="numberDecimal"
                    android:hint="0.00"
                    android:textSize="13sp"
                    android:gravity="end" />
            </LinearLayout>

            <!-- Balance Due Display -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Remaining Balance Due"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/danger_red" />

                <TextView
                    android:id="@+id/tvSummaryBalanceDue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$0.00"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/danger_red" />
            </LinearLayout>

        </LinearLayout>

        <!-- Save & Generate Button -->
        <Button
            android:id="@+id/btnSaveInvoice"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_button_primary"
            android:text="Create &amp; Finalize Invoice"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <ProgressBar
            android:id="@+id/saveProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:visibility="gone"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</ScrollView>