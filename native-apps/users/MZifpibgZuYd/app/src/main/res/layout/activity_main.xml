<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_light">

    <!-- Top Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/primary"
        android:padding="16dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_app_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DukaanProfit"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_app_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Smart Shop &amp; Profit Manager"
                android:textColor="#93C5FD"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_quick_bill"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@color/accent"
            android:text="+ Quick Sale"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:paddingLeft="14dp"
            android:paddingRight="14dp" />
    </LinearLayout>

    <!-- Main Dynamic Content Container -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 1. DASHBOARD VIEW -->
        <ScrollView
            android:id="@+id/view_dashboard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- Period Filter Toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="12dp">

                    <Button
                        android:id="@+id/btn_filter_today"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="Today"
                        android:textSize="12sp"
                        android:background="@color/primary"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/btn_filter_week"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="This Week"
                        android:textSize="12sp"
                        android:background="@color/border_color"
                        android:textColor="@color/text_main" />

                    <Button
                        android:id="@+id/btn_filter_month"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="This Month"
                        android:textSize="12sp"
                        android:background="@color/border_color"
                        android:textColor="@color/text_main" />
                </LinearLayout>

                <!-- Metric Cards Row 1: Sales & Expenses -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@color/card_bg"
                        android:padding="14dp"
                        android:orientation="vertical"
                        android:layout_marginRight="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Gross Sales"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_dash_sales"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹0.00"
                            android:textColor="@color/primary"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@color/card_bg"
                        android:padding="14dp"
                        android:orientation="vertical"
                        android:layout_marginLeft="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Expenses"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_dash_expenses"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹0.00"
                            android:textColor="@color/danger"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Metric Cards Row 2: Gross Profit & Net Profit -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@color/card_bg"
                        android:padding="14dp"
                        android:orientation="vertical"
                        android:layout_marginRight="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Gross Profit (Sales - COGS)"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tv_dash_gross_profit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹0.00"
                            android:textColor="@color/accent"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@color/card_bg"
                        android:padding="14dp"
                        android:orientation="vertical"
                        android:layout_marginLeft="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Est. Net Profit (Margin)"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tv_dash_net_profit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹0.00"
                            android:textColor="@color/accent_dark"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Customer Credit Alert Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#FFFBEB"
                    android:padding="14dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Outstanding Customer Udhaar"
                            android:textColor="@color/warning"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_dash_udhaar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹0.00 Pending Collection"
                            android:textColor="@color/text_main"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_dash_view_udhaar"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@color/warning"
                        android:text="Ledger"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Low Stock Alert Warning Box -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Low Stock Alerts"
                    android:textColor="@color/text_main"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/layout_low_stock_box"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/card_bg"
                    android:padding="12dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/tv_low_stock_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="All inventory levels are healthy."
                        android:textColor="@color/text_muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Recent Transactions Summary -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recent Transactions"
                    android:textColor="@color/text_main"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/layout_recent_sales"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/card_bg"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tv_no_sales"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No sales recorded yet."
                        android:textColor="@color/text_muted"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- 2. INVENTORY & PRODUCTS VIEW -->
        <LinearLayout
            android:id="@+id/view_products"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <EditText
                    android:id="@+id/et_search_product"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:hint="Search product or SKU..."
                    android:textSize="13sp"
                    android:background="@color/card_bg"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:singleLine="true" />

                <Button
                    android:id="@+id/btn_add_product"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:text="+ Add Item"
                    android:background="@color/primary"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:layout_marginLeft="8dp" />
            </LinearLayout>

            <!-- Inventory Valuation Summary -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#EFF6FF"
                android:padding="10dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/tv_inventory_valuation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Stock Value: ₹0.00 (Cost) | ₹0.00 (Retail)"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ListView
                android:id="@+id/lv_products"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="@color/border_color"
                android:dividerHeight="1dp" />
        </LinearLayout>

        <!-- 3. FAST BILLING & SALES VIEW -->
        <ScrollView
            android:id="@+id/view_billing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fast Counter Billing"
                    android:textColor="@color/text_main"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <!-- Select Customer -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Customer (Optional / Required for Udhaar):"
                    android:textSize="12sp"
                    android:textColor="@color/text_muted" />

                <Spinner
                    android:id="@+id/sp_billing_customer"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@color/card_bg"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="10dp" />

                <!-- Add Items to Cart Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <Spinner
                        android:id="@+id/sp_billing_products"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="2"
                        android:background="@color/card_bg" />

                    <EditText
                        android:id="@+id/et_billing_qty"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:hint="Qty"
                        android:inputType="number"
                        android:background="@color/card_bg"
                        android:gravity="center"
                        android:layout_marginLeft="6dp" />

                    <Button
                        android:id="@+id/btn_cart_add"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:text="Add"
                        android:background="@color/accent"
                        android:textColor="#FFFFFF"
                        android:layout_marginLeft="6dp" />
                </LinearLayout>

                <!-- Current Bill Cart Items List -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Current Bill Items:"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_main"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:id="@+id/layout_cart_items"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/card_bg"
                    android:padding="8dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/tv_cart_empty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cart is empty. Select product and quantity."
                        android:textColor="@color/text_muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Bill Totals & Discount -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/card_bg"
                    android:padding="12dp"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Items Subtotal:"
                            android:textColor="@color/text_muted" />

                        <TextView
                            android:id="@+id/tv_cart_subtotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹0.00"
                            android:textStyle="bold"
                            android:textColor="@color/text_main" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Discount (₹):"
                            android:textColor="@color/text_muted" />

                        <EditText
                            android:id="@+id/et_billing_discount"
                            android:layout_width="100dp"
                            android:layout_height="36dp"
                            android:inputType="numberDecimal"
                            android:text="0.00"
                            android:gravity="end"
                            android:paddingRight="6dp"
                            android:background="@color/bg_light" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/border_color"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Grand Total:"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="@color/text_main" />

                        <TextView
                            android:id="@+id/tv_cart_grand_total"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹0.00"
                            android:textStyle="bold"
                            android:textSize="18sp"
                            android:textColor="@color/primary" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Payment Selection -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <Button
                        android:id="@+id/btn_pay_cash"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:text="Complete Cash Sale"
                        android:background="@color/accent"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:layout_marginRight="4dp" />

                    <Button
                        android:id="@+id/btn_pay_credit"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:text="Put on Udhaar (Credit)"
                        android:background="@color/warning"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:layout_marginLeft="4dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_share_last_receipt"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="Share Last Bill Receipt (WhatsApp / SMS)"
                    android:background="@color/card_bg"
                    android:textColor="@color/primary"
                    android:textSize="12sp" />

            </LinearLayout>
        </ScrollView>

        <!-- 4. CUSTOMER UDHAAR LEDGER VIEW -->
        <LinearLayout
            android:id="@+id/view_udhaar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/tv_udhaar_header"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Total Dues: ₹0.00"
                    android:textColor="@color/danger"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btn_add_customer"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="+ Add Customer"
                    android:background="@color/primary"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <ListView
                android:id="@+id/lv_customers"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="@color/border_color"
                android:dividerHeight="1dp" />
        </LinearLayout>

        <!-- 5. EXPENSES & REPORTS VIEW -->
        <ScrollView
            android:id="@+id/view_reports"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Shop Expenses &amp; P&amp;L"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_main" />

                    <Button
                        android:id="@+id/btn_add_expense"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="+ Record Expense"
                        android:background="@color/danger"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Comprehensive P&L Breakdown Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/card_bg"
                    android:padding="14dp"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Business Health Report"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tv_rep_total_sales"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Sales Revenue: ₹0.00"
                        android:textColor="@color/text_main"
                        android:textSize="13sp"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tv_rep_cogs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cost of Goods Sold (COGS): ₹0.00"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tv_rep_gross_profit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gross Profit: ₹0.00"
                        android:textColor="@color/accent"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tv_rep_total_expenses"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Business Expenses: ₹0.00"
                        android:textColor="@color/danger"
                        android:textSize="13sp"
                        android:layout_marginBottom="4dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/border_color"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/tv_rep_net_profit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Actual Net Profit: ₹0.00 (0.0% Margin)"
                        android:textColor="@color/accent_dark"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Export Report Action -->
                <Button
                    android:id="@+id/btn_export_csv"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="Export Full Report &amp; Backup (CSV)"
                    android:background="@color/primary"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="16dp" />

                <!-- Recent Expenses Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Expense History"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_main"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/layout_expense_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/card_bg"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/tv_no_expenses"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No business expenses recorded yet."
                        android:textColor="@color/text_muted"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </FrameLayout>

    <!-- Bottom Navigation Bar -->
