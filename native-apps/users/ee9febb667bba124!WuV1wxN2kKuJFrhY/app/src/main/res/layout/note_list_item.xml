<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.google.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/note_card_bg"
    android:padding="12dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/note_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@+id/note_date"
            android:text="Note Title"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/note_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:text="Oct 12, 2023"
            android:textSize="11sp"
            android:textColor="#9E9E9E" />
    </RelativeLayout>

    <TextView
        android:id="@+id/note_snippet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="This is a summary preview of the note content."
        android:textSize="13sp"
        android:textColor="#616161"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/note_category_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Personal"
            android:textSize="11sp"
            android:textColor="#1976D2"
            android:background="@drawable/category_badge_bg"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>