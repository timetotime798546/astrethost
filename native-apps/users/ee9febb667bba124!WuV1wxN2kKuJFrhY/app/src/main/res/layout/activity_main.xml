<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <!-- Primary Interactive Calculator Panel -->
    <LinearLayout
        android:id="@+id/main_calculator_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top branding bar with History trigger -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MODERN Slate"
                android:textColor="@color/text_accent_blue"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.2" />

            <Button
                android:id="@+id/btn_open_history"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/history_btn_bg"
                android:text="🕒 History"
                android:textColor="@color/text_white"
                android:textSize="12sp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />
        </LinearLayout>

        <!-- Dynamic Output display -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.3"
            android:orientation="vertical"
            android:gravity="bottom|end"
            android:background="@drawable/display_gradient"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <!-- Computation Formula Track -->
            <HorizontalScrollView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:scrollbars="none">
                <TextView
                    android:id="@+id/tv_formula"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/text_display_secondary"
                    android:textSize="20sp"
                    android:singleLine="true" />
            </HorizontalScrollView>

            <!-- Result String Display -->
            <HorizontalScrollView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:scrollbars="none"
                android:layout_marginTop="8dp">
                <TextView
                    android:id="@+id/tv_display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/text_display_primary"
                    android:textSize="48sp"
                    android:textStyle="bold"
                    android:singleLine="true" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Interactive Grid Keys -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3.0"
            android:orientation="vertical">

            <!-- Row 1: [ C ] [ ± ] [ % ] [ / ] -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">
                
                <Button
                    android:id="@+id/btn_clear"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/btn_action"
                    android:text="C"
                    android:textColor="@color/text_white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_toggle_sign"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/btn_action"
                    android:text="±"
                    android:textColor="@color/text_white"
                    android:textSize="22sp" />

                <Button
                    android:id="@+id/btn_percent"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/btn_action"
                    android:text="%"
                    android:textColor="@color/text_white"
                    android:textSize="22sp" />

                <Button
                    android:id="@+id/btn_divide"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/btn_operator"
                    android:text="÷"
                    android:textColor="@color/text_white"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Row 2: [ 7 ] [ 8 ] [ 9 ] [ x ] -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btn_7"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/btn_number"
                    android:text="7"
                    android:textColor="@color/text_white"
                    android:textSize="22sp" />

                <Button
                    android:id="@+id/btn_8"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/btn_number"
                    android:text="8"
                    android:textColor="@color/text_white"
                    android:textSize="22sp" />

                <Button
                    android:id="@+id/btn_9"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/btn_number"
                    android:text="9"
                    android:textColor="@color/text_white"
                    android:textSize="22sp" />

                <Button
                    android:id="@+id/btn_multiply"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/btn_operator"
                    android:text="×"
                    android:textColor="@color/text_white"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Row 3: [ 4 ] [ 5 ] [ 6 ] [ - ] -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btn_4"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/btn_number"
                    android:text="4"
                    android:textColor="@color/text_white"
                    android:textSize="22sp" />

                <Button
                    android:id="@+id/btn_5"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/btn_number"
                    android:text="5"
                    android:textColor="@color/text_white"
                    android:textSize="22sp" />

                <Button
                    android:id="@+id/btn_6"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/btn_number"
                    android:text="6"
                    android:textColor="@color/text_white"
                    android:textSize="22sp" />

                <Button
                    android:id="@+id/btn_subtract"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/btn_operator"
                    android:text="−"
                    android:textColor="@color/text_white"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Row 4: [ 1 ] [ 2 ] [ 3 ] [ + ] -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btn_1"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/btn_number"
                    android:text="1"
                    android:textColor="@color/text_white"
                    android:textSize="22sp" />

                <Button
                    android:id="@+id/btn_2"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/btn_number"
                    android:text="2"
                    android:textColor="@color/text_white"
                    android:textSize="22sp" />

                <Button
                    android:id="@+id/btn_3"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/btn_number"
                    android:text="3"
                    android:textColor="@color/text_white"
                    android:textSize="22sp" />

                <Button
                    android:id="@+id/btn_add"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/btn_operator"
                    android:text="+"
                    android:textColor="@color/text_white"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Row 5: [ Del ] [ 0 ] [ . ] [ = ] -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_delete"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/btn_action"
                    android:text="⌫"
                    android:textColor="@color/text_white"
                    android:textSize="20sp" />

                <Button
                    android:id="@+id/btn_0"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/btn_number"
                    android:text="0"
                    android:textColor="@color/text_white"
                    android:textSize="22sp" />

                <Button
                    android:id="@+id/btn_decimal"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/btn_number"
                    android:text="."
                    android:textColor="@color/text_white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_equals"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/btn_equals"
                    android:text="="
                    android:textColor="@color/text_white"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Overlay Sliding History Drawer -->
    <LinearLayout
        android:id="@+id/history_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/history_panel_gradient"
        android:padding="20dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Calculation Logs"
                android:textColor="@color/text_accent_violet"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_clear_history"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/history_btn_bg"
                android:text="🗑️ Clear All"
                android:textColor="#EF4444"
                android:textSize="11sp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_close_history"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/history_btn_bg"
                android:text="✕"
                android:textColor="@color/text_white"
                android:textSize="12sp" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="vertical">
            
            <LinearLayout
                android:id="@+id/history_list_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <!-- App Loader Splash Screen Overlay -->
    <RelativeLayout
        android:id="@+id/loader_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/loader_gradient"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Premium Loader Indicator -->
            <ProgressBar
                android:id="@+id/loader_progress"
                style="?android:attr/progressBarStyleLarge"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:indeterminate="true"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MODERN"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"
                android:letterSpacing="0.2" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CALCULATOR"
                android:textColor="#818CF8"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.3" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Premium Slate Experience"
                android:textColor="#9CA3AF"
                android:textSize="12sp"
                android:layout_marginTop="24dp"
                android:fontFamily="sans-serif-light" />
        </LinearLayout>
    </RelativeLayout>

</FrameLayout>