<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#ECEFF1">

    <!-- Header Toolbar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#1A237E"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="HTML to APK Studio"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:text="v1.0"
            android:textColor="#00E5FF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Professional Tab Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="#283593">

        <Button
            android:id="@+id/tab_editor"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:text="EDITOR"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/tab_preview"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:text="PREVIEW"
            android:textColor="#8C9EFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/tab_templates"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:text="TEMPLATES"
            android:textColor="#8C9EFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/tab_guide"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:text="APK BLUEPRINT"
            android:textColor="#8C9EFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Active Tab Indicator Line Strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:orientation="horizontal"
        android:background="#283593">
        <View
            android:id="@+id/indicator_editor"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#00E5FF" />
        <View
            android:id="@+id/indicator_preview"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#283593" />
        <View
            android:id="@+id/indicator_templates"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#283593" />
        <View
            android:id="@+id/indicator_guide"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#283593" />
    </LinearLayout>

    <!-- Main Fragment Container Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Tab 1: IDE Editor Panel -->
        <LinearLayout
            android:id="@+id/container_editor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Code Editor Helper Bar"
                android:textColor="#37474F"
                android:textSize="11sp"
                android:layout_marginBottom="4dp" />

            <!-- Snippets Carousel -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:id="@+id/snippets_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <EditText
                    android:id="@+id/editor_field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/editor_bg"
                    android:gravity="top|left"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:padding="12dp"
                    android:textColor="#F8F8F2"
                    android:textSize="13sp"
                    android:typeface="monospace" />
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btn_clear"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Reset Code"
                    android:textColor="#FF1744"
                    android:background="?android:attr/selectableItemBackground"
                    android:layout_marginRight="4dp" />

                <Button
                    android:id="@+id/btn_run"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:background="@drawable/button_bg"
                    android:textColor="#FFFFFF"
                    android:text="Preview Live Sandbox"
                    android:textStyle="bold"
                    android:layout_marginLeft="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tab 2: Sandbox WebView Sandbox -->
        <LinearLayout
            android:id="@+id/container_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:visibility="gone">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:background="#37474F"
                android:paddingLeft="12dp"
                android:paddingRight="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="Sandbox Viewport"
                    android:textColor="#ECEFF1"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/preview_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:text="READY TO LOAD"
                    android:textColor="#00E676"
                    android:textStyle="bold"
                    android:textSize="11sp" />
            </RelativeLayout>

            <WebView
                android:id="@+id/preview_webview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>

        <!-- Tab 3: Code Templates Panel -->
        <LinearLayout
            android:id="@+id/container_templates"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select Code Preset Template"
                android:textColor="#1A237E"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Choose one of our responsive pre-coded layouts to immediately inject into the HTML builder sandbox."
                android:textColor="#546E7A"
                android:textSize="13sp"
                android:layout_marginBottom="12dp" />

            <ListView
                android:id="@+id/templates_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="#CFD8DC"
                android:dividerHeight="1dp" />
        </LinearLayout>

        <!-- Tab 4: Comprehensive Conversion Blueprint Guide -->
        <ScrollView
            android:id="@+id/container_guide"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Packaging HTML to a Real Standalone APK"
                    android:textColor="#1A237E"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Here is the step-by-step implementation system to pack custom web files inside a secure Android application."
                    android:textColor="#546E7A"
                    android:textSize="13sp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="16dp" />

                <!-- Directive 1 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Create the Assets Directory"
                    android:textColor="#1565C0"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="In your standard native Android project workspace, locate and create a folder here: \n'app/src/main/assets/' \nPlace your code file ('index.html') inside it."
                    android:textColor="#37474F"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />

                <!-- Directive 2 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. XML Component Configuration"
                    android:textColor="#1565C0"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#ECEFF1"
                    android:padding="10dp"
                    android:text="&lt;WebView\n    android:id=&quot;@+id/local_webview&quot;\n    android:layout_width=&quot;match_parent&quot;\n    android:layout_height=&quot;match_parent&quot; /&gt;"
                    android:textColor="#263238"
                    android:typeface="monospace"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />

                <!-- Directive 3 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3. Native Android Wrapper Code"
                    android:textColor="#1565C0"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#ECEFF1"
                    android:padding="10dp"
                    android:text="WebView webView = findViewById(R.id.local_webview);\nWebSettings settings = webView.getSettings();\n\n// Enable execution scripts\nsettings.setJavaScriptEnabled(true);\nsettings.setDomStorageEnabled(true);\n\n// Load directly from local file storage\nwebView.loadUrl(&quot;file:///android_asset/index.html&quot;);"
                    android:textColor="#263238"
                    android:typeface="monospace"
                    android:textSize="10sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />

                <!-- Directive 4 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4. Javascript to Java Bridging"
                    android:textColor="#1565C0"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="By employing custom web interfaces ('addJavascriptInterface()'), JavaScript script statements inside HTML can execute native phone functions like triggers, local SDK notifications, hardware systems, and camera systems directly!"
                    android:textColor="#37474F"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="24dp" />

            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>