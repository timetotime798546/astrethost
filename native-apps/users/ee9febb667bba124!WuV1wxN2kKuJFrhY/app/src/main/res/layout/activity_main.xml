<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- Top Action Bar -->
    <RelativeLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#1E1E1E"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="PicCraft Editor"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_reset"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="#333333"
                android:text="Reset"
                android:textAllCaps="false"
                android:textColor="#FF4444"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_save"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="#00C853"
                android:text="Save"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Workspace Area where the image will display -->
    <FrameLayout
        android:id="@+id/workspace_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/control_panel"
        android:layout_below="@+id/top_bar"
        android:background="#1A1A1A"
        android:padding="16dp">

        <!-- Custom Photo View containing all the canvas draws -->
        <FrameLayout
            android:id="@+id/photo_frame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <!-- Placeholder when no image is loaded -->
        <LinearLayout
            android:id="@+id/layout_empty_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No Photo Loaded"
                android:textColor="#888888"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btn_import_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#00796B"
                android:paddingHorizontal="24dp"
                android:text="Load Image"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom Editing Control Panels -->
    <LinearLayout
        android:id="@+id/control_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#1E1E1E"
        android:orientation="vertical">

        <!-- Variable Context Panel based on selected Mode -->
        <FrameLayout
            android:id="@+id/tool_options_container"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="#151515"
            android:paddingHorizontal="12dp">

            <!-- 1. Filters Sub-Panel (Horizontal Scroll of Presets) -->
            <HorizontalScrollView
                android:id="@+id/panel_filters"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp">

                    <Button
                        android:id="@+id/filter_none"
                        android:layout_width="72dp"
                        android:layout_height="50dp"
                        android:layout_margin="4dp"
                        android:background="#333333"
                        android:text="None"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/filter_grayscale"
                        android:layout_width="72dp"
                        android:layout_height="50dp"
                        android:layout_margin="4dp"
                        android:background="#333333"
                        android:text="Mono"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/filter_sepia"
                        android:layout_width="72dp"
                        android:layout_height="50dp"
                        android:layout_margin="4dp"
                        android:background="#333333"
                        android:text="Sepia"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/filter_invert"
                        android:layout_width="72dp"
                        android:layout_height="50dp"
                        android:layout_margin="4dp"
                        android:background="#333333"
                        android:text="Invert"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/filter_warm"
                        android:layout_width="72dp"
                        android:layout_height="50dp"
                        android:layout_margin="4dp"
                        android:background="#333333"
                        android:text="Warm"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/filter_cool"
                        android:layout_width="72dp"
                        android:layout_height="50dp"
                        android:layout_margin="4dp"
                        android:background="#333333"
                        android:text="Cool"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- 2. Slider Adjustment Sub-Panel -->
            <LinearLayout
                android:id="@+id/panel_adjust"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_slider_label"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="Brightness"
                        android:textColor="#CCCCCC"
                        android:textSize="12sp" />

                    <SeekBar
                        android:id="@+id/adjustment_seekbar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="200"
                        android:progress="100" />
                </LinearLayout>

                <!-- Sub Selector for Adjustment Mode -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_adjust_brightness"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginHorizontal="4dp"
                        android:background="#00796B"
                        android:text="Bright"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp" />

                    <Button
                        android:id="@+id/btn_adjust_contrast"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginHorizontal="4dp"
                        android:background="#333333"
                        android:text="Contrast"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp" />

                    <Button
                        android:id="@+id/btn_adjust_saturation"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginHorizontal="4dp"
                        android:background="#333333"
                        android:text="Saturate"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 3. Drawing Canvas Sub-Panel -->
            <LinearLayout
                android:id="@+id/panel_draw"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <!-- Color Options -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/color_red"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_margin="4dp"
                        android:background="#FF0000" />

                    <View
                        android:id="@+id/color_green"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_margin="4dp"
                        android:background="#00FF00" />

                    <View
                        android:id="@+id/color_blue"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_margin="4dp"
                        android:background="#0000FF" />

                    <View
                        android:id="@+id/color_yellow"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_margin="4dp"
                        android:background="#FFFF00" />

                    <View
                        android:id="@+id/color_white"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_margin="4dp"
                        android:background="#FFFFFF" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Brush Size"
                        android:textColor="#888888"
                        android:textSize="10sp" />

                    <SeekBar
                        android:id="@+id/brush_size_seekbar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="50"
                        android:progress="10" />
                </LinearLayout>
            </LinearLayout>

            <!-- 4. Overlay Text Sub-Panel -->
            <LinearLayout
                android:id="@+id/panel_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <EditText
                    android:id="@+id/et_overlay_text"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="#252525"
                    android:hint="Type custom text..."
                    android:textColor="#FFFFFF"
                    android:textColorHint="#555555"
                    android:textCursorDrawable="@null"
                    android:paddingHorizontal="8dp"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btn_add_text_apply"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="#00796B"
                    android:text="Apply"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <!-- 5. Transformations (Rotate / Flip / Crop) Sub-Panel -->
            <LinearLayout
                android:id="@+id/panel_transform"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <Button
                    android:id="@+id/btn_rotate_left"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginHorizontal="4dp"
                    android:background="#333333"
                    android:text="Rot L"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_rotate_right"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginHorizontal="4dp"
                    android:background="#333333"
                    android:text="Rot R"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_flip_h"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginHorizontal="4dp"
                    android:background="#333333"
                    android:text="Flip H"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_flip_v"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginHorizontal="4dp"
                    android:background="#333333"
                    android:text="Flip V"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

        </FrameLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2D2D2D" />

        <!-- Main Dock Menu (Primary Actions) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <Button
                    android:id="@+id/tab_load"
                    android:layout_width="80dp"
                    android:layout_height="match_parent"
                    android:background="?android:attr/selectableItemBackground"
                    android:text="Load"
                    android:textAllCaps="false"
                    android:textColor="#00E676"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/tab_filters"
                    android:layout_width="80dp"
                    android:layout_height="match_parent"
                    android:background="?android:attr/selectableItemBackground"
                    android:text="Filters"
                    android:textAllCaps="false"
                    android:textColor="#CCCCCC"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/tab_adjust"
                    android:layout_width="80dp"
                    android:layout_height="match_parent"
                    android:background="?android:attr/selectableItemBackground"
                    android:text="Adjust"
                    android:textAllCaps="false"
                    android:textColor="#CCCCCC"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/tab_draw"
                    android:layout_width="80dp"
                    android:layout_height="match_parent"
                    android:background="?android:attr/selectableItemBackground"
                    android:text="Draw"
                    android:textAllCaps="false"
                    android:textColor="#CCCCCC"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/tab_text"
                    android:layout_width="80dp"
                    android:layout_height="match_parent"
                    android:background="?android:attr/selectableItemBackground"
                    android:text="Text"
                    android:textAllCaps="false"
                    android:textColor="#CCCCCC"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/tab_transform"
                    android:layout_width="80dp"
                    android:layout_height="match_parent"
                    android:background="?android:attr/selectableItemBackground"
                    android:text="Transform"
                    android:textAllCaps="false"
                    android:textColor="#CCCCCC"
                    android:textSize="12sp" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</RelativeLayout>