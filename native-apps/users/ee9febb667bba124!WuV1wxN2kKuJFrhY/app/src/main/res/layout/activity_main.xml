<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="12dp">

    <!-- Screen Display Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.8"
        android:orientation="vertical"
        android:gravity="bottom|end"
        android:padding="16dp">

        <!-- History Expression Scroll View -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:scrollbars="none">
            <TextView
                android:id="@+id/tvExpression"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#8E8E93"
                android:textSize="26sp"
                android:gravity="end"
                android:singleLine="true" />
        </HorizontalScrollView>

        <!-- Current Output Scroll View -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fillViewport="true"
            android:scrollbars="none">
            <TextView
                android:id="@+id/tvResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="54sp"
                android:textStyle="bold"
                android:gravity="end"
                android:singleLine="true" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Keyboard Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3.2"
        android:orientation="vertical">

        <!-- Row 1: C, +/-, %, / -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnC"
                style="?android:attr/buttonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:background="@drawable/btn_special"
                android:text="C"
                android:textColor="#000000"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnToggleSign"
                style="?android:attr/buttonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:background="@drawable/btn_special"
                android:text="±"
                android:textColor="#000000"
                android:textSize="24sp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnPercent"
                style="?android:attr/buttonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:background="@drawable/btn_special"
                android:text="%"
                android:textColor="#000000"
                android:textSize="24sp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnDivide"
                style="?android:attr/buttonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:background="@drawable/btn_operator"
                android:text="÷"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Row 2: 7, 8, 9, * -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn7"
                style="?android:attr/buttonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:background="@drawable/btn_numeric"
                android:text="7"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn8"
                style="?android:attr/buttonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:background="@drawable/btn_numeric"
                android:text="8"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn9"
                style="?android:attr/buttonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:background="@drawable/btn_numeric"
                android:text="9"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnMultiply"
                style="?android:attr/buttonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:background="@drawable/btn_operator"
                android:text="×"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Row 3: 4, 5, 6, - -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn4"
                style="?android:attr/buttonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:background="@drawable/btn_numeric"
                android:text="4"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn5"
                style="?android:attr/buttonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:background="@drawable/btn_numeric"
                android:text="5"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn6"
                style="?android:attr/buttonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:background="@drawable/btn_numeric"
                android:text="6"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnSubtract"
                style="?android:attr/buttonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:background="@drawable/btn_operator"
                android:text="−"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Row 4: 1, 2, 3, + -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn1"
                style="?android:attr/buttonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:background="@drawable/btn_numeric"
                android:text="1"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn2"
                style="?android:attr/buttonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:background="@drawable/btn_numeric"
                android:text="2"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn3"
                style="?android:attr/buttonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:background="@drawable/btn_numeric"
                android:text="3"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnPlus"
                style="?android:attr/buttonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:background="@drawable/btn_operator"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Row 5: 0, ., backspace, = -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn0"
                style="?android:attr/buttonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:background="@drawable/btn_numeric"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnDot"
                style="?android:attr/buttonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:background="@drawable/btn_numeric"
                android:text="."
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnBackspace"
                style="?android:attr/buttonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:background="@drawable/btn_special"
                android:text="⌫"
                android:textColor="#000000"
                android:textSize="24sp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnEqual"
                style="?android:attr/buttonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:background="@drawable/btn_equal"
                android:text="="
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>