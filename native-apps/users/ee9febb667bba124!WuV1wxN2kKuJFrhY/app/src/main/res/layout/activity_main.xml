<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Top Application Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#005A9C"
        android:orientation="vertical"
        android:padding="16dp">
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Build Diagnostics"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Real-time Android Debugging &amp; Environment Diagnostics"
            android:textColor="#E0E0E0"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Interactive Navigation Tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#E0E0E0"
        android:padding="2dp">

        <Button
            android:id="@+id/btn_tab_system"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="System Info"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="#FFFFFF"
            android:textColor="#333333"
            android:layout_margin="1dp" />

        <Button
            android:id="@+id/btn_tab_diagnostics"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hardware"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="#E0E0E0"
            android:textColor="#333333"
            android:layout_margin="1dp" />

        <Button
            android:id="@+id/btn_tab_sandbox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Error Sandbox"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="#E0E0E0"
            android:textColor="#333333"
            android:layout_margin="1dp" />
    </LinearLayout>

    <!-- Content Panel Areas -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp">

        <!-- TAB 1: System Info Layout -->
        <ScrollView
            android:id="@+id/scroll_system_info"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Environment Metrics"
                    android:textColor="#333333"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- System Info Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/txt_system_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Gathering environment details..."
                        android:textColor="#444444"
                        android:textSize="14sp"
                        android:lineSpacingMultiplier="1.2" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_refresh_sys"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Refresh System Data"
                    android:textColor="#FFFFFF"
                    android:background="#005A9C" />
            </LinearLayout>
        </ScrollView>

        <!-- TAB 2: Hardware Diagnostics Layout -->
        <ScrollView
            android:id="@+id/scroll_diagnostics"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Network Connectivity Suite"
                    android:textColor="#333333"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- Connection Ping Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Internet Socket Ping Test"
                        android:textColor="#005A9C"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txt_ping_result"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Status: Idle (Tap Run to execute socket diagnostic to 1.1.1.1)"
                        android:textColor="#666666"
                        android:textSize="13sp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/btn_run_ping"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Execute Network Ping"
                        android:textColor="#FFFFFF"
                        android:background="#008080" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Display Parameters"
                    android:textColor="#333333"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- Screen Properties Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/txt_screen_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Measuring Screen..."
                        android:textColor="#444444"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Onboard Device Sensors"
                    android:textColor="#333333"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- Sensors Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/txt_sensors_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Listing physical sensors..."
                        android:textColor="#444444"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- TAB 3: Error Simulator Sandbox Layout -->
        <ScrollView
            android:id="@+id/scroll_sandbox"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Simulated Crash Sandbox"
                    android:textColor="#333333"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Execute controlled operations to trigger exceptions. Inspect stack trace logs below in real-time."
                    android:textColor="#666666"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp" />

                <!-- Sandbox Buttons Grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <Button
                        android:id="@+id/btn_trigger_npe"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Trigger NPE"
                        android:textColor="#FFFFFF"
                        android:background="#D32F2F"
                        android:layout_marginRight="4dp"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_trigger_arith"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Div / 0 Error"
                        android:textColor="#FFFFFF"
                        android:background="#D32F2F"
                        android:layout_marginLeft="2dp"
                        android:layout_marginRight="2dp"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_trigger_index"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Index Error"
                        android:textColor="#FFFFFF"
                        android:background="#D32F2F"
                        android:layout_marginLeft="4dp"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Terminal Log Console"
                        android:textColor="#333333"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_clear_console"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Clear Log"
                        android:textSize="11sp"
                        android:background="#757575"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

                <!-- Console Display Container -->
                <ScrollView
                    android:id="@+id/scroll_console_container"
                    android:layout_width="match_parent"
                    android:layout_height="280dp"
                    android:background="@drawable/console_bg"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/txt_console_output"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="[CONSOLE INITIALIZED SUCCESS]\nWaiting for error signals...\n"
                        android:textColor="#00FF66"
                        android:textSize="11sp"
                        android:typeface="monospace" />
                </ScrollView>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>