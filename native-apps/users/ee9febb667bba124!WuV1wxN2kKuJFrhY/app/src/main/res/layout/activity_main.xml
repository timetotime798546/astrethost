<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_size"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- APP HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SonicWave Lab"
                        style="@style/HeaderTextStyle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dynamic Synthesizer &amp; Effects"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <!-- Status LED -->
                <View
                    android:id="@+id/ledIndicator"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@android:drawable/presence_online"
                    android:layout_gravity="center"
                    android:alpha="0.3" />
            </LinearLayout>

            <!-- CUSTOM INTERACTIVE VISUALIZER -->
            <com.sonicwavelab.app.SoundVisualizerView
                android:id="@+id/soundVisualizer"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginBottom="16dp" />

            <!-- CONTROLS & FILTERS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/card_background"
                android:padding="14dp"
                android:elevation="2dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Effects &amp; Filter Lab"
                    style="@style/SectionHeaderStyle" />

                <!-- Base Frequency Slider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Base Pitch (Frequency)"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary" />
                        <TextView
                            android:id="@+id/txtFreqValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="440 Hz"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/accent_blue" />
                    </LinearLayout>
                    <SeekBar
                        android:id="@+id/seekFrequency"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="1800"
                        android:progress="340"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Duration Slider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Synthesize Duration"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary" />
                        <TextView
                            android:id="@+id/txtDurationValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.6s"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/accent_blue" />
                    </LinearLayout>
                    <SeekBar
                        android:id="@+id/seekDuration"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="18"
                        android:progress="4"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Echo Delay Slider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Echo Filter Decay"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary" />
                        <TextView
                            android:id="@+id/txtEchoValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="150ms"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/accent_blue" />
                    </LinearLayout>
                    <SeekBar
                        android:id="@+id/seekEcho"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="500"
                        android:progress="150"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

            </LinearLayout>

            <!-- SOUND Presets / Generators -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Synth Preset"
                style="@style/SectionHeaderStyle" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="3"
                android:alignmentMode="alignBounds"
                android:layout_marginBottom="16dp">

                <!-- Button 1: Laser -->
                <Button
                    android:id="@+id/btnSynthLaser"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:layout_height="52dp"
                    android:layout_margin="4dp"
                    android:text="⚡ LASER BEAM"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@color/accent_laser" />

                <!-- Button 2: Jump -->
                <Button
                    android:id="@+id/btnSynthJump"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:layout_height="52dp"
                    android:layout_margin="4dp"
                    android:text="▲ CHIPTUNE JUMP"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@color/accent_blue" />

                <!-- Button 3: Swell -->
                <Button
                    android:id="@+id/btnSynthSwell"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:layout_height="52dp"
                    android:layout_margin="4dp"
                    android:text="🌊 AMBIENT SWELL"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@color/accent_swell" />

                <!-- Button 4: Zen Bell -->
                <Button
                    android:id="@+id/btnSynthBell"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:layout_height="52dp"
                    android:layout_margin="4dp"
                    android:text="🔔 ZEN BELL"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#2C3E50"
                    android:background="@color/accent_bell" />

                <!-- Button 5: White Noise Blast -->
                <Button
                    android:id="@+id/btnSynthNoise"
                    android:layout_width="0dp"
                    android:layout_columnWeight="2"
                    android:layout_height="52dp"
                    android:layout_margin="4dp"
                    android:text="💥 COSMIC NOISE EXPLOSION"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@color/accent_noise" />

            </GridLayout>

            <!-- SOUND PLAYBACK HISTORY LOG -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Synthesis &amp; Playback Log"
                    style="@style/SectionHeaderStyle" />

                <Button
                    android:id="@+id/btnClearHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Clear Log"
                    android:textSize="11sp"
                    android:background="@android:color/transparent"
                    android:textColor="@color/accent_laser" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/historyContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

    <!-- LOADING & PROCESSING LOADER OVERLAY -->
    <RelativeLayout
        android:id="@+id/loaderOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/overlay_bg"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_centerInParent="true"
            android:padding="24dp">

            <!-- Animated Rotating Circle -->
            <ProgressBar
                android:id="@+id/progressLoader"
                style="?android:attr/progressBarStyleLarge"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/accent_neon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Synthesizing Waves..."
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/txtLoaderDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Applying DSP Effects Filters"
                android:textColor="@color/accent_neon"
                android:textSize="13sp"
                android:layout_marginTop="6dp" />

        </LinearLayout>
    </RelativeLayout>

</RelativeLayout>