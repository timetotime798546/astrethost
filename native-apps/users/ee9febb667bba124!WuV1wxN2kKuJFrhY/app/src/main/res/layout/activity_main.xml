<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- MAIN APP SCREEN WRAPPER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Premium Metallic Slate Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/header_bg"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Expense Tracker Pro"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="center_horizontal"
                android:shadowColor="#3D0F172A"
                android:shadowRadius="8"
                android:shadowDx="0"
                android:shadowDy="4"
                android:layout_marginBottom="16dp" />

            <!-- Metrics Layer Card Panel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/card_bg"
                android:padding="16dp"
                android:gravity="center_vertical">

                <!-- Balance block -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NET BALANCE"
                        android:textColor="#64748B"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtNetBalance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$0.00"
                        android:textColor="#0F172A"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginTop="3dp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="32dp"
                    android:background="#E2E8F0" />

                <!-- Income block -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="INCOME"
                        android:textColor="#64748B"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtIncomeSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$0.00"
                        android:textColor="#10B981"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="3dp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="32dp"
                    android:background="#E2E8F0" />

                <!-- Expense block -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EXPENSES"
                        android:textColor="#64748B"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtExpenseSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$0.00"
                        android:textColor="#EF4444"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="3dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- DYNAMIC BODY CONTENT SCENES -->
        <FrameLayout
            android:id="@+id/contentFrame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- TAB SCREEN 1: HOME (Dashboard & Pull Refresh List) -->
            <LinearLayout
                android:id="@+id/layoutHome"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Dynamic Drag pull-refresh loader drawer -->
                <LinearLayout
                    android:id="@+id/layoutRefreshHeader"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:background="#F1F5F9"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp">

                    <ProgressBar
                        android:id="@+id/prgRefresh"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginRight="12dp" />

                    <TextView
                        android:id="@+id/txtRefreshStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pull down to reload..."
                        android:textColor="#475569"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Recent Transactions"
                        android:textColor="#0F172A"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnDeleteAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Flush DB"
                        android:textColor="#EF4444"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/card_bg"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <ListView
                    android:id="@+id/lstTransactions"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="@android:color/transparent"
                    android:dividerHeight="8dp"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:clipToPadding="false"
                    android:scrollbars="none" />
            </LinearLayout>

            <!-- TAB SCREEN 2: ADD TRANSACTION PANEL FORM -->
            <ScrollView
                android:id="@+id/layoutAdd"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Record New Transaction"
                        android:textColor="#0F172A"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="20dp" />

                    <!-- Premium Button Toggle Selectors -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:orientation="horizontal"
                        android:layout_marginBottom="24dp">

                        <Button
                            android:id="@+id/btnTypeExpense"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:text="EXPENSE"
                            android:background="@drawable/btn_bg_expense"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnTypeIncome"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:text="INCOME"
                            android:background="@drawable/btn_bg_neutral"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginLeft="12dp" />
                    </LinearLayout>

                    <!-- Amount Box with Premium Background -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="AMOUNT VALUE ($)"
                        android:textColor="#475569"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/edtAmount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:hint="0.00"
                        android:textColor="#0F172A"
                        android:textSize="17sp"
                        android:padding="14dp"
                        android:background="@drawable/edit_text_bg"
                        android:layout_marginBottom="20dp" />

                    <!-- Spinner Setup category -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="CHOOSE CATEGORY"
                        android:textColor="#475569"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <Spinner
                        android:id="@+id/spnCategory"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:padding="14dp"
                        android:background="@drawable/edit_text_bg"
                        android:layout_marginBottom="20dp" />

                    <!-- Date control -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="TRANSACTION DATE"
                        android:textColor="#475569"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <Button
                        android:id="@+id/btnSelectDate"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="Set Date"
                        android:gravity="left|center_vertical"
                        android:paddingLeft="14dp"
                        android:textColor="#0F172A"
                        android:textSize="14sp"
                        android:background="@drawable/edit_text_bg"
                        android:layout_marginBottom="20dp" />

                    <!-- Optional explanation details note -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="OPTIONAL DETAIL EXPLANATION"
                        android:textColor="#475569"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/edtNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences"
                        android:hint="e.g. Starbucks drip coffee"
                        android:textColor="#0F172A"
                        android:textSize="15sp"
                        android:padding="14dp"
                        android:background="@drawable/edit_text_bg"
                        android:layout_marginBottom="28dp" />

                    <!-- Action Save Form Trigger (Premium Neutral Button layout) -->
                    <Button
                        android:id="@+id/btnSaveTransaction"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:text="SAVE TRANSACTION"
                        android:background="@drawable/btn_bg_neutral"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </ScrollView>

            <!-- TAB SCREEN 3: ANALYTICS & VISUALIZATION -->
            <LinearLayout
                android:id="@+id/layoutReports"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Expense Distribution"
                    android:textColor="#0F172A"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <!-- Custom Pie-based canvas element -->
                <com.expensetrackerpro.app.ChartView
                    android:id="@+id/chartView"
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:background="@drawable/card_bg"
                    android:padding="12dp"
                    android:layout_marginBottom="20dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="BUDGET ALLOCATIONS"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/layoutBreakdownList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>
            </LinearLayout>
        </FrameLayout>

        <!-- PREMIUM GLASS-LIKE NAVIGATION BAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:background="#FFFFFF"
            android:gravity="center_vertical"
            android:elevation="12dp">

            <!-- Home Tab block -->
            <LinearLayout
                android:id="@+id/tabHomeTrigger"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:layout_margin="4dp"
                android:background="@drawable/tab_selected_bg">

                <TextView
                    android:id="@+id/txtTabHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Home List"
                    android:textColor="#4F46E5"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:background="#E2E8F0"
                android:layout_gravity="center_vertical" />

            <!-- Add Tab block -->
            <LinearLayout
                android:id="@+id/tabAddTrigger"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:layout_margin="4dp">

                <TextView
                    android:id="@+id/txtTabAdd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+ Log Record"
                    android:textColor="#94A3B8"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:background="#E2E8F0"
                android:layout_gravity="center_vertical" />

            <!-- Report Tab block -->
            <LinearLayout
                android:id="@+id/tabReportsTrigger"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:layout_margin="4dp">

                <TextView
                    android:id="@+id/txtTabReports"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reports"
                    android:textColor="#94A3B8"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- PREMIUM SPLASH SCREEN WITH SMOOTH GRADIENT LOAD LAYER -->
    <LinearLayout
        android:id="@+id/loaderOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#0F172A"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:background="@drawable/card_bg">

            <ProgressBar
                android:id="@+id/prgOpenLoader"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Expense Tracker Pro"
                android:textColor="#0F172A"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/txtLoaderPercentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Initializing... 0%"
                android:textColor="#64748B"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>