<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090909">

    <!-- Premium Top Action Bar -->
    <RelativeLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#121212"
        android:paddingHorizontal="16dp"
        android:elevation="4dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/app_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PICCRAFT"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <!-- Golden PRO badge -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_premium_gold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="PRO"
                android:textColor="#000000"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_reset"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_button_dark"
                android:text="Reset"
                android:textAllCaps="false"
                android:textColor="#FF5252"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_save"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_premium_gold"
                android:text="Export"
                android:textAllCaps="false"
                android:textColor="#121212"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Workspace Container (Premium Slate Viewport) -->
    <FrameLayout
        android:id="@+id/workspace_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/premium_control_panel"
        android:layout_below="@+id/top_bar"
        android:background="#0A0A0A"
        android:padding="16dp">

        <FrameLayout
            android:id="@+id/photo_frame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:elevation="2dp" />

        <!-- High-End Empty State UX -->
        <LinearLayout
            android:id="@+id/layout_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No Studio Canvas Loaded"
                android:textColor="#8E8E93"
                android:textSize="18sp"
                android:textStyle="italic" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Import a high-resolution photograph to unlock the premium tools."
                android:textColor="#555555"
                android:textSize="12sp"
                android:gravity="center" />

            <Button
                android:id="@+id/btn_import_empty"
                android:layout_width="220dp"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_premium_gold"
                android:text="Start Editing"
                android:textColor="#121212"
                android:textStyle="bold"
                android:textAllCaps="false" />
        </LinearLayout>
    </FrameLayout>

    <!-- Premium Control & Customization Deck -->
    <LinearLayout
        android:id="@+id/premium_control_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#121212"
        android:orientation="vertical"
        android:elevation="8dp">

        <!-- Tool Options Custom Containers -->
        <FrameLayout
            android:id="@+id/tool_options_container"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:background="#161616"
            android:paddingHorizontal="16dp">

            <!-- 1. PREMIUM FILTERS (Horizontal Scroll) -->
            <HorizontalScrollView
                android:id="@+id/panel_filters"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/filter_none"
                        android:layout_width="80dp"
                        android:layout_height="56dp"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_button_dark"
                        android:text="Original"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/filter_cyber"
                        android:layout_width="80dp"
                        android:layout_height="56dp"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_button_dark"
                        android:text="Cyber Neon"
                        android:textAllCaps="false"
                        android:textColor="#FF00FF"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/filter_gold"
                        android:layout_width="80dp"
                        android:layout_height="56dp"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_button_dark"
                        android:text="Gold Glow"
                        android:textAllCaps="false"
                        android:textColor="#FFE259"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/filter_emerald"
                        android:layout_width="80dp"
                        android:layout_height="56dp"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_button_dark"
                        android:text="Emerald"
                        android:textAllCaps="false"
                        android:textColor="#00E676"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/filter_midnight"
                        android:layout_width="80dp"
                        android:layout_height="56dp"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_button_dark"
                        android:text="Midnight"
                        android:textAllCaps="false"
                        android:textColor="#448AFF"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/filter_grayscale"
                        android:layout_width="80dp"
                        android:layout_height="56dp"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_button_dark"
                        android:text="Mono"
                        android:textAllCaps="false"
                        android:textColor="#8E8E93"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/filter_sepia"
                        android:layout_width="80dp"
                        android:layout_height="56dp"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_button_dark"
                        android:text="Sepia"
                        android:textAllCaps="false"
                        android:textColor="#D4AF37"
                        android:textSize="11sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- 2. SLIDER ADJUSTMENTS -->
            <LinearLayout
                android:id="@+id/panel_adjust"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_slider_label"
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:text="Brightness"
                        android:textColor="#FFE259"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <SeekBar
                        android:id="@+id/adjustment_seekbar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="200"
                        android:progress="100" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_adjust_brightness"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginHorizontal="4dp"
                        android:background="@drawable/bg_premium_gold"
                        android:text="Brightness"
                        android:textAllCaps="false"
                        android:textColor="#121212"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_adjust_contrast"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginHorizontal="4dp"
                        android:background="@drawable/bg_button_dark"
                        android:text="Contrast"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp" />

                    <Button
                        android:id="@+id/btn_adjust_saturation"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginHorizontal="4dp"
                        android:background="@drawable/bg_button_dark"
                        android:text="Saturation"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 3. PREMIUM CANVAS DRAWING -->
            <LinearLayout
                android:id="@+id/panel_draw"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <!-- Color Nodes -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/color_red"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_margin="4dp"
                        android:background="#FF5252" />

                    <View
                        android:id="@+id/color_green"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_margin="4dp"
                        android:background="#00E676" />

                    <View
                        android:id="@+id/color_blue"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_margin="4dp"
                        android:background="#448AFF" />

                    <View
                        android:id="@+id/color_yellow"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_margin="4dp"
                        android:background="#FFE259" />

                    <View
                        android:id="@+id/color_white"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_margin="4dp"
                        android:background="#FFFFFF" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="140dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Brush Weight"
                        android:textColor="#8E8E93"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <SeekBar
                        android:id="@+id/brush_size_seekbar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="50"
                        android:progress="10" />
                </LinearLayout>
            </LinearLayout>

            <!-- 4. TEXT OVERLAYS -->
            <LinearLayout
                android:id="@+id/panel_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <EditText
                    android:id="@+id/et_overlay_text"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_dark"
                    android:hint="Overlay luxury text..."
                    android:textColor="#FFFFFF"
                    android:textColorHint="#444444"
                    android:paddingHorizontal="12dp"
                    android:textSize="14sp"
                    android:singleLine="true" />

                <Button
                    android:id="@+id/btn_add_text_apply"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_premium_gold"
                    android:text="Apply"
                    android:textColor="#121212"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 5. TRANSFORMATIONS -->
            <LinearLayout
                android:id="@+id/panel_transform"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <Button
                    android:id="@+id/btn_rotate_left"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="4dp"
                    android:background="@drawable/bg_button_dark"
                    android:text="Rotate L"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_rotate_right"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="4dp"
                    android:background="@drawable/bg_button_dark"
                    android:text="Rotate R"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_flip_h"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="4dp"
                    android:background="@drawable/bg_button_dark"
                    android:text="Flip H"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_flip_v"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="4dp"
                    android:background="@drawable/bg_button_dark"
                    android:text="Flip V"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 6. PREMIUM FRAMES (Premium Add-on Feature) -->
            <HorizontalScrollView
                android:id="@+id/panel_frames"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/frame_none"
                        android:layout_width="90dp"
                        android:layout_height="56dp"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_button_dark"
                        android:text="No Frame"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/frame_gold"
                        android:layout_width="90dp"
                        android:layout_height="56dp"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_button_dark"
                        android:text="Royal Gold"
                        android:textAllCaps="false"
                        android:textColor="#FFE259"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/frame_cyber"
                        android:layout_width="90dp"
                        android:layout_height="56dp"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_button_dark"
                        android:text="Cyber Neon"
                        android:textAllCaps="false"
                        android:textColor="#FF00FF"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/frame_matte"
                        android:layout_width="90dp"
                        android:layout_height="56dp"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_button_dark"
                        android:text="Cinematic"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp" />
                </LinearLayout>
            </HorizontalScrollView>

        </FrameLayout>

        <!-- Divider Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#222222" />

        <!-- Navigation Tab Layout (Modern Dock Navigation) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:scrollbars="none"
            android:background="#121212">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <Button
                    android:id="@+id/tab_load"
                    android:layout_width="86dp"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="2dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:text="Import"
                    android:textAllCaps="false"
                    android:textColor="#00E676"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/tab_filters"
                    android:layout_width="86dp"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="2dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:text="Filters"
                    android:textAllCaps="false"
                    android:textColor="#8E8E93"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/tab_adjust"
                    android:layout_width="86dp"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="2dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:text="Adjust"
                    android:textAllCaps="false"
                    android:textColor="#8E8E93"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/tab_draw"
                    android:layout_width="86dp"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="2dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:text="Canvas Draw"
                    android:textAllCaps="false"
                    android:textColor="#8E8E93"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/tab_text"
                    android:layout_width="86dp"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="2dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:text="Text Layer"
                    android:textAllCaps="false"
                    android:textColor="#8E8E93"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/tab_transform"
                    android:layout_width="86dp"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="2dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:text="Geometry"
                    android:textAllCaps="false"
                    android:textColor="#8E8E93"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/tab_frames"
                    android:layout_width="86dp"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="2dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:text="Pro Frames"
                    android:textAllCaps="false"
                    android:textColor="#FFE259"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- AI Enhance Shortcut -->
                <Button
                    android:id="@+id/btn_ai_enhance"
                    android:layout_width="100dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_premium_gold"
                    android:text="✦ AI Auto"
                    android:textAllCaps="false"
                    android:textColor="#121212"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</RelativeLayout>