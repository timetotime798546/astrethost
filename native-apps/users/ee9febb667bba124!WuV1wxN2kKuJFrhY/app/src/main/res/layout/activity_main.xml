<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Live Camera Viewfinder stream -->
    <SurfaceView
        android:id="@+id/camera_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true" />

    <!-- Top control overlay layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#33000000"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:layout_alignParentTop="true">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Camera Pro"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Camera toggling option -->
        <Button
            android:id="@+id/btn_switch"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="Ghumayein ↻"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:background="@drawable/btn_bg"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_marginRight="8dp" />

        <!-- Flash management option -->
        <Button
            android:id="@+id/btn_flash"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="Flash: OFF"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:background="@drawable/btn_bg"
            android:paddingLeft="12dp"
            android:paddingRight="12dp" />

    </LinearLayout>

    <!-- Bottom utility controls layout -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="#55000000"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:layout_alignParentBottom="true">

        <!-- Captured gallery preview thumbnail -->
        <ImageView
            android:id="@+id/img_thumbnail"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:scaleType="centerCrop"
            android:background="@drawable/btn_bg"
            android:padding="2dp"
            android:visibility="gone" />

        <!-- Camera Shutter release trigger -->
        <Button
            android:id="@+id/btn_shutter"
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:layout_centerInParent="true"
            android:background="@drawable/shutter_bg" />

        <TextView
            android:id="@+id/txt_instructions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:text="Tap to Focus"
            android:textColor="#DDFFFFFF"
            android:textSize="11sp" />

    </RelativeLayout>

    <!-- Image preview overlay system -->
    <RelativeLayout
        android:id="@+id/preview_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <!-- High-res display area of taken photograph -->
        <ImageView
            android:id="@+id/img_full_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />

        <!-- Translucent custom Actionbar layout inside preview -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#66000000"
            android:padding="16dp"
            android:layout_alignParentTop="true">

            <Button
                android:id="@+id/btn_close_preview"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_alignParentLeft="true"
                android:text="← Piche"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_bg"
                android:paddingLeft="16dp"
                android:paddingRight="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Aapki Photo"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_delete_preview"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_alignParentRight="true"
                android:text="Mitao 🗑"
                android:textColor="#FF6666"
                android:background="@drawable/btn_bg"
                android:paddingLeft="16dp"
                android:paddingRight="16dp" />

        </RelativeLayout>

    </RelativeLayout>

</RelativeLayout>