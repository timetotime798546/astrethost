<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft 3D drop-shadow boundary representing elevated depth -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#CBD5E1"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
    <!-- Surface plate -->
    <item android:bottom="4dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FFFFFF"
                android:endColor="#F8FAFC"
                android:angle="270"/>
            <corners android:radius="14dp"/>
            <stroke android:width="1dp" android:color="#E2E8F0" />
        </shape>
    </item>
</layer-list>