<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <!-- 3D base shadow layer (fully collapsed) -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="@color/btn_special_shadow" />
                </shape>
            </item>
            <!-- Lowered keycap face -->
            <item android:top="4dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="13dp" />
                    <gradient
                        android:startColor="@color/btn_special_pressed_top"
                        android:endColor="@color/btn_special_pressed_bottom"
                        android:angle="270" />
                    <stroke android:width="1dp" android:color="#BFC2CC" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <!-- 3D base shadow (extruded 3D depth) -->
            <item android:top="4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="@color/btn_special_shadow" />
                </shape>
            </item>
            <!-- Raised keycap face -->
            <item android:bottom="6dp" android:left="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="13dp" />
                    <gradient
                        android:startColor="@color/btn_special_normal_top"
                        android:endColor="@color/btn_special_normal_bottom"
                        android:angle="270" />
                    <stroke android:width="1.5dp" android:color="#EBECEF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>