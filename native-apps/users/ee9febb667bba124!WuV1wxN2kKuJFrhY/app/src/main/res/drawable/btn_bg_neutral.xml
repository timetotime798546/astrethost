<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom solid shadow segment -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1E293B"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
    <!-- Soft neutral 3D plate -->
    <item android:bottom="5dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#475569"
                android:endColor="#334155"
                android:angle="90"/>
            <corners android:radius="12dp"/>
            <stroke android:width="1dp" android:color="#94A3B8"/>
        </shape>
    </item>
</layer-list>