<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 3D bottom shadow -->
    <item android:top="8dp" android:left="8dp">
        <shape android:shape="oval">
            <solid android:color="#050505" />
        </shape>
    </item>
    <!-- 3D body depth -->
    <item android:top="4dp" android:left="4dp" android:bottom="4dp" android:right="4dp">
        <shape android:shape="oval">
            <solid android:color="#1A1C22" />
            <stroke android:width="2dp" android:color="#2D3038" />
        </shape>
    </item>
    <!-- Front glossy gradient ring face -->
    <item android:bottom="8dp" android:right="8dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#00FF66"
                android:endColor="#1F943E"
                android:angle="270" />
            <stroke android:width="2dp" android:color="#96F8AA" />
        </shape>
    </item>
</layer-list>