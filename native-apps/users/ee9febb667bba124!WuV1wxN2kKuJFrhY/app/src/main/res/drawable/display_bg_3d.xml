<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Top outer rim highlighting bevel -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#2D3038" />
        </shape>
    </item>
    <!-- Inner shadow simulate recess -->
    <item android:top="2dp" android:bottom="1dp" android:left="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="15dp" />
            <solid android:color="#0A0B0E" />
        </shape>
    </item>
    <!-- Screen body -->
    <item android:top="4dp" android:bottom="2dp" android:left="4dp" android:right="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="13dp" />
            <gradient
                android:startColor="#0F1115"
                android:endColor="#151922"
                android:angle="270" />
        </shape>
    </item>
</layer-list>