{
  "backend": true,
  "api_base_url": "https://trumpledroid-api.cloudbeta28624.workers.dev",
  "roles": {
    "user": ["own"]
  },
  "collections": {
    "transactions": {
      "fields": {
        "title": "string",
        "amount": "number",
        "type": "string",
        "category": "string",
        "date": "string"
      },
      "operations": ["create", "read", "update", "delete"]
    }
  },
  "logic": {
    "balance": {
      "type": "calculation",
      "inputs": ["income", "expenses"],
      "formula": "income - expenses"
    },
    "savings_rate": {
      "type": "calculation",
      "inputs": ["income", "expenses"],
      "formula": "((income - expenses) / income) * 100"
    }
  }
}