<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="New Record"
            android:textColor="#2E7D32"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Log your earnings or expense flow"
            android:textColor="#757575"
            android:textSize="14dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="32dp" />

        <!-- Segment Type Selection -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TRANSACTION TYPE"
            android:textColor="#2E7D32"
            android:textSize="12sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rg_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rb_expense"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Expense"
                android:checked="true"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/rb_income"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Income"
                android:textSize="16sp" />
        </RadioGroup>

        <!-- Amount Entry -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AMOUNT ($)"
            android:textColor="#2E7D32"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_amount"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="0.00"
            android:inputType="numberDecimal"
            android:textColor="#212121"
            android:background="@android:drawable/edit_text"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:paddingLeft="12dp" />

        <!-- Category Select Dropdown -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CATEGORY"
            android:textColor="#2E7D32"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinner_category"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:background="@android:drawable/btn_dropdown"/>

        <!-- Custom Category option -->
        <EditText
            android:id="@+id/et_custom_category"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Enter Custom Category name..."
            android:textColor="#212121"
            android:background="@android:drawable/edit_text"
            android:layout_marginBottom="16dp"
            android:paddingLeft="12dp"
            android:visibility="gone"/>

        <!-- Date Entry Picker -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DATE (YYYY-MM-DD)"
            android:textColor="#2E7D32"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_date"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="e.g. 2024-10-24"
            android:inputType="date"
            android:textColor="#212121"
            android:background="@android:drawable/edit_text"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:paddingLeft="12dp" />

        <!-- Note Entry -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DESCRIPTION (OPTIONAL)"
            android:textColor="#2E7D32"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_description"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="E.g., Groceries from hypermarket"
            android:inputType="textCapSentences"
            android:textColor="#212121"
            android:background="@android:drawable/edit_text"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="32dp"
            android:paddingLeft="12dp" />

        <!-- Action Buttons -->
        <Button
            android:id="@+id/btn_save_transaction"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="SAVE TRANSACTION"
            android:background="#2E7D32"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btn_cancel_transaction"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="CANCEL"
            android:background="?android:attr/selectableItemBackground"
            android:textColor="#757575"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>