<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BARBER Q"
            android:textColor="#C5A880"
            android:textSize="36sp"
            android:textStyle="bold"
            android:layout_marginTop="50dp"
            android:letterSpacing="0.2"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Premium Saloon Booking"
            android:textColor="#888888"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="40dp"/>

        <!-- Auth Form Container -->
        <LinearLayout
            android:id="@+id/authFormContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Title -->
            <TextView
                android:id="@+id/formTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign In"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="20dp"/>

            <!-- Optional Name Field (Signup Only) -->
            <EditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Full Name"
                android:textColorHint="#555555"
                android:textColor="#FFFFFF"
                android:paddingLeft="15dp"
                android:background="@drawable/input_border"
                android:inputType="textPersonName"
                android:layout_marginBottom="16dp"
                android:visibility="gone"/>

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Email Address"
                android:textColorHint="#555555"
                android:textColor="#FFFFFF"
                android:paddingLeft="15dp"
                android:background="@drawable/input_border"
                android:inputType="textEmailAddress"
                android:layout_marginBottom="16dp"/>

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Password"
                android:textColorHint="#555555"
                android:textColor="#FFFFFF"
                android:paddingLeft="15dp"
                android:background="@drawable/input_border"
                android:inputType="textPassword"
                android:layout_marginBottom="24dp"/>

            <Button
                android:id="@+id/btnSubmit"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="LOG IN"
                android:textColor="#121212"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/button_gold"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/btnToggleAuth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Don't have an account? Sign Up"
                android:textColor="#C5A880"
                android:textSize="14sp"
                android:layout_gravity="center"
                android:padding="8dp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/btnForgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Forgot Password?"
                android:textColor="#888888"
                android:textSize="13sp"
                android:layout_gravity="center"
                android:padding="8dp"/>

        </LinearLayout>

        <!-- Forgot Password Container -->
        <LinearLayout
            android:id="@+id/forgotFormContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reset Password"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enter your email to request a secure OTP to set your password."
                android:textColor="#888888"
                android:textSize="14dp"
                android:layout_marginBottom="20dp"/>

            <EditText
                android:id="@+id/etForgotEmail"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Your Email Address"
                android:textColorHint="#555555"
                android:textColor="#FFFFFF"
                android:paddingLeft="15dp"
                android:background="@drawable/input_border"
                android:inputType="textEmailAddress"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnRequestOtp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="SEND OTP CODE"
                android:textColor="#121212"
                android:background="@drawable/button_gold"
                android:layout_marginBottom="24dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#2D2D2D"
                android:layout_marginBottom="24dp"/>

            <EditText
                android:id="@+id/etForgotOtp"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="OTP Token"
                android:textColorHint="#555555"
                android:textColor="#FFFFFF"
                android:paddingLeft="15dp"
                android:background="@drawable/input_border"
                android:inputType="number"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/etForgotNewPassword"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="New Secure Password"
                android:textColorHint="#555555"
                android:textColor="#FFFFFF"
                android:paddingLeft="15dp"
                android:background="@drawable/input_border"
                android:inputType="textPassword"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btnResetPassword"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="SUBMIT NEW PASSWORD"
                android:textColor="#121212"
                android:background="@drawable/button_gold"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/btnBackToLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Back to Sign In"
                android:textColor="#C5A880"
                android:textSize="14dp"
                android:layout_gravity="center"
                android:padding="10dp"/>

        </LinearLayout>

        <!-- Progress Container -->
        <ProgressBar
            android:id="@+id/loginProgress"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="20dp"
            android:visibility="gone"/>

    </LinearLayout>
</ScrollView>