<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reset Password"
            android:textColor="#2E7D32"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_forgot_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Verify your email to receive standard security tokens"
            android:textColor="#757575"
            android:textSize="14dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="32dp" />

        <!-- STEP 1 Layout: Request OTP -->
        <LinearLayout
            android:id="@+id/layout_request_otp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EMAIL ADDRESS"
                android:textColor="#2E7D32"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_forgot_email"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="user@example.com"
                android:inputType="textEmailAddress"
                android:textColor="#212121"
                android:background="@android:drawable/edit_text"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:paddingLeft="12dp" />

            <Button
                android:id="@+id/btn_send_otp"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="SEND ONE TIME CODE"
                android:background="#2E7D32"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- STEP 2 Layout: Reset Password -->
        <LinearLayout
            android:id="@+id/layout_reset_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VERIFICATION CODE (OTP)"
                android:textColor="#2E7D32"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_verification_otp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Enter 6 digit OTP"
                android:inputType="number"
                android:textColor="#212121"
                android:background="@android:drawable/edit_text"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:paddingLeft="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NEW PASSWORD"
                android:textColor="#2E7D32"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_new_password"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="New password (min 6 characters)"
                android:inputType="textPassword"
                android:textColor="#212121"
                android:background="@android:drawable/edit_text"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:paddingLeft="12dp" />

            <Button
                android:id="@+id/btn_reset_password"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="CONFIRM RESET"
                android:background="#2E7D32"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_back_to_login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel and Return to Login"
            android:textColor="#757575"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>
</ScrollView>