<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header Navigation -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← BACK"
                android:textColor="#C5A880"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:padding="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Appointment Booking"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>

        <!-- Selection Summary -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SELECTED TREATMENTS"
                android:textColor="#888888"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/tvSelectedServicesSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="None selected"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:layout_marginBottom="12dp"/>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Calculated Charge"
                    android:textColor="#888888"
                    android:textSize="13sp"/>

                <TextView
                    android:id="@+id/tvBookingTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹0"
                    android:textColor="#C5A880"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_alignParentRight="true"/>
            </RelativeLayout>
        </LinearLayout>

        <!-- Customer Inputs -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Customer Information"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etBookingName"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Full Name"
            android:textColorHint="#555555"
            android:textColor="#FFFFFF"
            android:paddingLeft="14dp"
            android:background="@drawable/input_border"
            android:inputType="textPersonName"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etBookingPhone"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Phone Number"
            android:textColorHint="#555555"
            android:textColor="#FFFFFF"
            android:paddingLeft="14dp"
            android:background="@drawable/input_border"
            android:inputType="phone"
            android:layout_marginBottom="24dp"/>

        <!-- Date Picker trigger -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Date"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnSelectDate"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Pick Appointment Date"
            android:textColor="#FFFFFF"
            android:background="@drawable/input_border"
            android:layout_marginBottom="24dp" />

        <!-- Slot Picker matrix -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Available Time Slots"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <!-- Simple Grid styling for Slots via Linear Layout Rows -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="30dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3"
                android:layout_marginBottom="10dp">

                <Button
                    android:id="@+id/slot1"
                    android:layout_width="0dp"
                    android:layout_height="45dp"
                    android:layout_weight="1"
                    android:text="10:00 AM"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:background="@drawable/slot_button_selector"
                    android:layout_marginRight="6dp"/>

                <Button
                    android:id="@+id/slot2"
                    android:layout_width="0dp"
                    android:layout_height="45dp"
                    android:layout_weight="1"
                    android:text="11:30 AM"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:background="@drawable/slot_button_selector"
                    android:layout_marginRight="6dp"/>

                <Button
                    android:id="@+id/slot3"
                    android:layout_width="0dp"
                    android:layout_height="45dp"
                    android:layout_weight="1"
                    android:text="01:00 PM"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:background="@drawable/slot_button_selector"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3">

                <Button
                    android:id="@+id/slot4"
                    android:layout_width="0dp"
                    android:layout_height="45dp"
                    android:layout_weight="1"
                    android:text="02:30 PM"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:background="@drawable/slot_button_selector"
                    android:layout_marginRight="6dp"/>

                <Button
                    android:id="@+id/slot5"
                    android:layout_width="0dp"
                    android:layout_height="45dp"
                    android:layout_weight="1"
                    android:text="04:00 PM"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:background="@drawable/slot_button_selector"
                    android:layout_marginRight="6dp"/>

                <Button
                    android:id="@+id/slot6"
                    android:layout_width="0dp"
                    android:layout_height="45dp"
                    android:layout_weight="1"
                    android:text="05:30 PM"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:background="@drawable/slot_button_selector"/>
            </LinearLayout>

        </LinearLayout>

        <!-- Complete Booking -->
        <Button
            android:id="@+id/btnBookAppointment"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="CONFIRM APPOINTMENT"
            android:textColor="#121212"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/button_gold"
            android:layout_marginBottom="16dp"/>

        <ProgressBar
            android:id="@+id/bookingProgress"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:visibility="gone"/>

    </LinearLayout>
</ScrollView>