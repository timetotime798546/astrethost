<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#3F51B5"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Smart Multi Tool"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Offline Calculation Suite"
                android:textColor="#E0E0E0"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Tool 1: BMI Calculator -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. BMI Calculator"
                android:textColor="#333333"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Weight (kg):"
                android:textColor="#666666"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/et_bmi_weight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:hint="e.g. 70"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Height (cm):"
                android:textColor="#666666"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/et_bmi_height"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:hint="e.g. 175"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btn_calculate_bmi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Calculate BMI"
                android:background="#3F51B5"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/tv_bmi_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:padding="8dp"
                android:background="#E8EAF6"
                android:textColor="#1A237E"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Tool 2: Tip & Split Calculator -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. Tip &amp; Split Calculator"
                android:textColor="#333333"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bill Amount ($):"
                android:textColor="#666666"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/et_tip_bill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:hint="e.g. 84.50"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tip Percentage (%):"
                android:textColor="#666666"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/et_tip_percent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:hint="e.g. 15"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Number of People:"
                android:textColor="#666666"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/et_tip_people"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:hint="e.g. 4"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btn_calculate_tip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Calculate Tip"
                android:background="#3F51B5"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/tv_tip_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:padding="8dp"
                android:background="#E8EAF6"
                android:textColor="#1A237E"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Tool 3: Unit Converter -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. Multi-Unit Converter"
                android:textColor="#333333"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Conversion:"
                android:textColor="#666666"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <RadioGroup
                android:id="@+id/rg_conversion_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

                <RadioButton
                    android:id="@+id/rb_c_to_f"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Celsius to Fahrenheit"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/rb_f_to_c"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Fahrenheit to Celsius" />

                <RadioButton
                    android:id="@+id/rb_m_to_ft"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Meters to Feet" />

                <RadioButton
                    android:id="@+id/rb_ft_to_m"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Feet to Meters" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Input Value:"
                android:textColor="#666666"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/et_convert_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberSigned|numberDecimal"
                android:hint="Enter value"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btn_convert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Convert"
                android:background="#3F51B5"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/tv_convert_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:padding="8dp"
                android:background="#E8EAF6"
                android:textColor="#1A237E"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>