<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/calc_background"
    android:padding="16dp">

    <!-- DISPLAY SCREEN AREA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.3"
        android:orientation="vertical"
        android:gravity="bottom"
        android:background="@color/calc_display_bg"
        android:padding="20dp"
        android:layout_marginBottom="16dp">

        <!-- Expression View -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:scrollbars="none"
            android:gravity="right">
            
            <TextView
                android:id="@+id/tv_expression"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/text_white"
                android:textSize="44sp"
                android:singleLine="true"
                android:layout_gravity="right" />
        </HorizontalScrollView>

        <!-- Live Preview / Calculated Result View -->
        <TextView
            android:id="@+id/tv_result_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/text_gray"
            android:textSize="26sp"
            android:gravity="right"
            android:layout_marginTop="8dp"
            android:singleLine="true" />
    </LinearLayout>

    <!-- KEYPAD AREA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3.2"
        android:orientation="vertical">

        <!-- ROW 1: [ C ] [ +/- ] [ % ] [ / ] -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btn_clear"
                style="?android:attr/buttonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="C"
                android:textSize="22sp"
                android:textColor="@color/text_white"
                android:background="@drawable/btn_action_bg"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_negate"
                style="?android:attr/buttonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="±"
                android:textSize="22sp"
                android:textColor="@color/text_white"
                android:background="@drawable/btn_action_bg"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_percent"
                style="?android:attr/buttonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="%"
                android:textSize="22sp"
                android:textColor="@color/text_white"
                android:background="@drawable/btn_action_bg"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_divide"
                style="?android:attr/buttonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="÷"
                android:textSize="24sp"
                android:textColor="@color/text_white"
                android:background="@drawable/btn_operator_bg" />
        </LinearLayout>

        <!-- ROW 2: [ 7 ] [ 8 ] [ 9 ] [ * ] -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btn_7"
                style="?android:attr/buttonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="7"
                android:textSize="22sp"
                android:textColor="@color/text_white"
                android:background="@drawable/btn_number_bg"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_8"
                style="?android:attr/buttonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="8"
                android:textSize="22sp"
                android:textColor="@color/text_white"
                android:background="@drawable/btn_number_bg"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_9"
                style="?android:attr/buttonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="9"
                android:textSize="22sp"
                android:textColor="@color/text_white"
                android:background="@drawable/btn_number_bg"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_multiply"
                style="?android:attr/buttonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="×"
                android:textSize="24sp"
                android:textColor="@color/text_white"
                android:background="@drawable/btn_operator_bg" />
        </LinearLayout>

        <!-- ROW 3: [ 4 ] [ 5 ] [ 6 ] [ - ] -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btn_4"
                style="?android:attr/buttonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="4"
                android:textSize="22sp"
                android:textColor="@color/text_white"
                android:background="@drawable/btn_number_bg"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_5"
                style="?android:attr/buttonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="5"
                android:textSize="22sp"
                android:textColor="@color/text_white"
                android:background="@drawable/btn_number_bg"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_6"
                style="?android:attr/buttonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="6"
                android:textSize="22sp"
                android:textColor="@color/text_white"
                android:background="@drawable/btn_number_bg"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_subtract"
                style="?android:attr/buttonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="−"
                android:textSize="24sp"
                android:textColor="@color/text_white"
                android:background="@drawable/btn_operator_bg" />
        </LinearLayout>

        <!-- ROW 4: [ 1 ] [ 2 ] [ 3 ] [ + ] -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btn_1"
                style="?android:attr/buttonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="1"
                android:textSize="22sp"
                android:textColor="@color/text_white"
                android:background="@drawable/btn_number_bg"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_2"
                style="?android:attr/buttonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="2"
                android:textSize="22sp"
                android:textColor="@color/text_white"
                android:background="@drawable/btn_number_bg"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_3"
                style="?android:attr/buttonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="3"
                android:textSize="22sp"
                android:textColor="@color/text_white"
                android:background="@drawable/btn_number_bg"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_add"
                style="?android:attr/buttonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="+"
                android:textSize="24sp"
                android:textColor="@color/text_white"
                android:background="@drawable/btn_operator_bg" />
        </LinearLayout>

        <!-- ROW 5: [ 0 ] [ . ] [ DEL ] [ = ] -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_0"
                style="?android:attr/buttonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="0"
                android:textSize="22sp"
                android:textColor="@color/text_white"
                android:background="@drawable/btn_number_bg"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_decimal"
                style="?android:attr/buttonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="."
                android:textSize="22sp"
                android:textColor="@color/text_white"
                android:background="@drawable/btn_number_bg"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_delete"
                style="?android:attr/buttonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="⌫"
                android:textSize="20sp"
                android:textColor="@color/text_white"
                android:background="@drawable/btn_action_bg"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_equals"
                style="?android:attr/buttonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="="
                android:textSize="24sp"
                android:textColor="@color/text_white"
                android:background="@drawable/btn_equal_bg" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>