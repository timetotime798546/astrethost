<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- Top Styling Appbar -->
    <RelativeLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#1E1E1E"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="BARBER Q"
            android:textColor="#C5A880"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnHistory"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="My Bookings"
                android:textColor="#C5A880"
                android:textSize="12sp"
                android:background="@drawable/input_border"
                android:layout_marginRight="10dp"
                android:paddingHorizontal="10dp" />

            <ImageView
                android:id="@+id/btnLogout"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_lock_power_off"
                android:contentDescription="Logout"
                android:tint="#888888" />

        </LinearLayout>
    </RelativeLayout>

    <!-- Main Content Area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/pricingPanel"
        android:layout_below="@id/appBar"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Grooming Services"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select one or more professional treatments below."
                android:textColor="#888888"
                android:textSize="12sp"
                android:layout_marginBottom="20dp"/>

            <!-- Service Item Cards -->
            <LinearLayout
                android:id="@+id/servicesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Service 1 -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_background"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp">

                    <CheckBox
                        android:id="@+id/cbHaircut"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentLeft="true"
                        android:layout_centerVertical="true"
                        android:buttonTint="#C5A880" />

                    <ImageView
                        android:id="@+id/ivHaircut"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_toRightOf="@id/cbHaircut"
                        android:layout_centerVertical="true"
                        android:layout_marginLeft="8dp"
                        android:scaleType="centerCrop"
                        android:src="@android:drawable/ic_menu_gallery" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@id/ivHaircut"
                        android:layout_toLeftOf="@+id/tvHaircutPrice"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="8dp"
                        android:layout_centerVertical="true"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Classic Haircut"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Professional styling customized to your head profile"
                            android:textColor="#888888"
                            android:textSize="11sp"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvHaircutPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:text="₹150"
                        android:textColor="#C5A880"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <!-- Service 2 -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_background"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp">

                    <CheckBox
                        android:id="@+id/cbShaving"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentLeft="true"
                        android:layout_centerVertical="true"
                        android:buttonTint="#C5A880" />

                    <ImageView
                        android:id="@+id/ivShaving"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_toRightOf="@id/cbShaving"
                        android:layout_centerVertical="true"
                        android:layout_marginLeft="8dp"
                        android:scaleType="centerCrop"
                        android:src="@android:drawable/ic_menu_gallery" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@id/ivShaving"
                        android:layout_toLeftOf="@+id/tvShavingPrice"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="8dp"
                        android:layout_centerVertical="true"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Classic Shave"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hot towel treatment &amp; smooth razor outline"
                            android:textColor="#888888"
                            android:textSize="11sp"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvShavingPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:text="₹80"
                        android:textColor="#C5A880"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <!-- Service 3 -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_background"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp">

                    <CheckBox
                        android:id="@+id/cbBeardTrim"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentLeft="true"
                        android:layout_centerVertical="true"
                        android:buttonTint="#C5A880" />

                    <ImageView
                        android:id="@+id/ivBeardTrim"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_toRightOf="@id/cbBeardTrim"
                        android:layout_centerVertical="true"
                        android:layout_marginLeft="8dp"
                        android:scaleType="centerCrop"
                        android:src="@android:drawable/ic_menu_gallery" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@id/ivBeardTrim"
                        android:layout_toLeftOf="@+id/tvBeardTrimPrice"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="8dp"
                        android:layout_centerVertical="true"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Beard Trim"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Beard design with nourishing essential beard oil"
                            android:textColor="#888888"
                            android:textSize="11sp"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvBeardTrimPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:text="₹100"
                        android:textColor="#C5A880"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <!-- Service 4 -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_background"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp">

                    <CheckBox
                        android:id="@+id/cbFacial"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentLeft="true"
                        android:layout_centerVertical="true"
                        android:buttonTint="#C5A880" />

                    <ImageView
                        android:id="@+id/ivFacial"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_toRightOf="@id/cbFacial"
                        android:layout_centerVertical="true"
                        android:layout_marginLeft="8dp"
                        android:scaleType="centerCrop"
                        android:src="@android:drawable/ic_menu_gallery" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@id/ivFacial"
                        android:layout_toLeftOf="@+id/tvFacialPrice"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="8dp"
                        android:layout_centerVertical="true"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Royal Facial"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cleansing herbal steam &amp; exfoliating gold scrub"
                            android:textColor="#888888"
                            android:textSize="11sp"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvFacialPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:text="₹300"
                        android:textColor="#C5A880"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <!-- Service 5 -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_background"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp">

                    <CheckBox
                        android:id="@+id/cbHairSpa"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentLeft="true"
                        android:layout_centerVertical="true"
                        android:buttonTint="#C5A880" />

                    <ImageView
                        android:id="@+id/ivHairSpa"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_toRightOf="@id/cbHairSpa"
                        android:layout_centerVertical="true"
                        android:layout_marginLeft="8dp"
                        android:scaleType="centerCrop"
                        android:src="@android:drawable/ic_menu_gallery" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@id/ivHairSpa"
                        android:layout_toLeftOf="@+id/tvHairSpaPrice"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="8dp"
                        android:layout_centerVertical="true"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Premium Hair Spa"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Intense conditioning &amp; head acupressure massage"
                            android:textColor="#888888"
                            android:textSize="11sp"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvHairSpaPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:text="₹250"
                        android:textColor="#C5A880"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </RelativeLayout>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Pricing / CTA Panel -->
    <LinearLayout
        android:id="@+id/pricingPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#1E1E1E"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="20dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Amount"
                android:textColor="#888888"
                android:textSize="14sp"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"/>

            <TextView
                android:id="@+id/tvTotalPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0"
                android:textColor="#C5A880"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>

        <Button
            android:id="@+id/btnProceed"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="PROCEED TO BOOKING"
            android:textColor="#121212"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/button_gold" />

    </LinearLayout>

</RelativeLayout>