<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- Top Navigation Header -->
    <RelativeLayout
        android:id="@+id/historyBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#1E1E1E"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/btnBackHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← DASHBOARD"
            android:textColor="#C5A880"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_centerVertical="true"
            android:padding="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Booking History"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>

    <!-- Error/No-Data Message -->
    <LinearLayout
        android:id="@+id/emptyView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No booked spots found"
            android:textColor="#888888"
            android:textSize="16sp"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Book treatments on your dashboard tab."
            android:textColor="#555555"
            android:textSize="12sp"/>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/historyProgress"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_centerInParent="true"
        android:visibility="gone"/>

    <!-- Scrollable container for dynamic custom view listings -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/historyBar"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/historyContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>
    </ScrollView>

</RelativeLayout>