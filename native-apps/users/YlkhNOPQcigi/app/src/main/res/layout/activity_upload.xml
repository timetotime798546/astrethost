<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F8F8F8">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Upload Media / Video File"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/editTextFileTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Title / Name of Media"
        android:inputType="text"
        android:padding="10dp"
        android:background="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/editTextDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Description (optional)"
        android:inputType="textMultiLine"
        android:lines="3"
        android:padding="10dp"
        android:background="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/buttonChooseFile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Choose Video / Image File"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/textViewSelectedFile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No file selected"
        android:textColor="#666666"
        android:textSize="12sp"
        android:layout_marginBottom="16dp" />

    <ProgressBar
        android:id="@+id/uploadProgressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/buttonStartUpload"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Upload Now"
        android:background="#008800"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/buttonCancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cancel"
        android:background="#888888"
        android:textColor="#FFFFFF" />

</LinearLayout>