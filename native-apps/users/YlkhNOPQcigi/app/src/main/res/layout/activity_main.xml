<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fb_bg">

    <!-- Facebook Blue Top Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/fb_blue"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="facebook"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="-0.03" />

        <Button
            android:id="@+id/btnWebPortalHeader"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="🌐 Web Portal"
            android:textColor="#FFFFFF"
            android:background="@color/fb_dark_blue"
            android:textSize="12sp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_marginRight="8dp" />

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Logout"
            android:textColor="#FFFFFF"
            android:background="@color/fb_dark_blue"
            android:textSize="12sp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp" />

    </LinearLayout>

    <!-- Navigation Tab Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/fb_card_bg"
        android:orientation="horizontal"
        android:elevation="2dp">

        <TextView
            android:id="@+id/tabHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="🏠 Feed"
            android:textColor="@color/fb_blue"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@color/fb_card_bg" />

        <TextView
            android:id="@+id/tabNotifications"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="🔔 Alerts"
            android:textColor="@color/fb_text_secondary"
            android:textSize="14sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tabProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="👤 Profile"
            android:textColor="@color/fb_text_secondary"
            android:textSize="14sp"
            android:gravity="center" />

    </LinearLayout>

    <!-- Main Dynamic Feed Container -->
    <ScrollView
        android:id="@+id/scrollFeed"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Create Post Box Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/fb_card_bg"
                android:padding="16dp"
                android:layout_marginBottom="10dp"
                android:elevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvUserAvatar"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@color/fb_blue"
                        android:text="U"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <EditText
                        android:id="@+id/etNewPost"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:hint="What's on your mind?"
                        android:background="@color/fb_bg"
                        android:paddingLeft="14dp"
                        android:paddingRight="14dp"
                        android:textSize="14sp"
                        android:layout_marginLeft="10dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:gravity="right">

                    <CheckBox
                        android:id="@+id/cbAttachPhoto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📷 Photo"
                        android:textColor="@color/fb_text_secondary"
                        android:textSize="13sp"
                        android:layout_marginRight="12dp" />

                    <Button
                        android:id="@+id/btnPost"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Post"
                        android:textColor="#FFFFFF"
                        android:background="@color/fb_blue"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:paddingLeft="20dp"
                        android:paddingRight="20dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Stories Bar Header -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:scrollbars="none"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:id="@+id/containerStories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

            </HorizontalScrollView>

            <!-- Offline / Web Banner Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#E7F3FF"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp"
                android:paddingLeft="16dp"
                android:paddingRight="16dp">

                <TextView
                    android:id="@+id/tvBannerText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Welcome to Facebook Home feed! Launch official portal anytime."
                    android:textColor="@color/fb_dark_blue"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnLaunchWebBanner"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Open Web"
                    android:textColor="#FFFFFF"
                    android:background="@color/fb_blue"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- Posts List Container -->
            <LinearLayout
                android:id="@+id/containerPosts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <ProgressBar
                android:id="@+id/pbFeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                android:layout_margin="16dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>