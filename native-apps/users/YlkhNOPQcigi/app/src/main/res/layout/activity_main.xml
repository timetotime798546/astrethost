<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Top Action Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp"
        android:background="#FFFFFF"
        android:elevation="2dp">

        <TextView
            android:id="@+id/app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="Instagram Home"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#000000" />

        <Button
            android:id="@+id/btn_open_instagram_web"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="Open Web"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:background="#E1306C"
            android:paddingHorizontal="12dp" />
    </RelativeLayout>

    <!-- Main Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Banner / Web Launcher Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FAF9F9"
                android:padding="16dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome to Instagram Home"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#262626" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Browse the native feed below or visit instagram.com directly in your browser."
                    android:textSize="13sp"
                    android:textColor="#737373" />

                <Button
                    android:id="@+id/btn_banner_launch"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:text="Go to instagram.com"
                    android:textColor="#FFFFFF"
                    android:background="#3897F0"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Stories Bar -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stories"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#262626"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingVertical="12dp"
                android:clipToPadding="false"
                android:paddingHorizontal="12dp">

                <LinearLayout
                    android:id="@+id/stories_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EFEFEF" />

            <!-- Feed Posts Container -->
            <LinearLayout
                android:id="@+id/posts_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:borderTopWidth="1dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Home"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#000000" />

        <TextView
            android:id="@+id/nav_explore"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Explore"
            android:textSize="13sp"
            android:textColor="#737373" />

        <TextView
            android:id="@+id/nav_web"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="instagram.com"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#E1306C" />
    </LinearLayout>

</LinearLayout>