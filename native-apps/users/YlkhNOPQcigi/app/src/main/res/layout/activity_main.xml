<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fb_bg">

    <!-- Top Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="@color/fb_card_bg"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:elevation="2dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="facebook"
            android:textColor="@color/fb_blue"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="-0.04" />

        <Button
            android:id="@+id/btnSearch"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="🔍"
            android:textSize="14sp"
            android:background="@color/fb_bg"
            android:textColor="@color/fb_text_primary"
            android:layout_marginRight="8dp" />

        <Button
            android:id="@+id/btnMessenger"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="💬"
            android:textSize="14sp"
            android:background="@color/fb_bg"
            android:textColor="@color/fb_text_primary"
            android:layout_marginRight="8dp" />

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Logout"
            android:textSize="12sp"
            android:background="@color/fb_bg"
            android:textColor="@color/fb_text_secondary"
            android:paddingLeft="8dp"
            android:paddingRight="8dp" />

    </LinearLayout>

    <!-- Top Navigation Tabs Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/fb_card_bg"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tabHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="🏠 Feed"
            android:textColor="@color/fb_blue"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@color/fb_light_blue" />

        <TextView
            android:id="@+id/tabWatch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="📺 Watch"
            android:textColor="@color/fb_text_secondary"
            android:textSize="13sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tabFriends"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="👥 Friends"
            android:textColor="@color/fb_text_secondary"
            android:textSize="13sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tabNotifications"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="🔔 Notifications"
            android:textColor="@color/fb_text_secondary"
            android:textSize="11sp"
            android:gravity="center" />

    </LinearLayout>

    <!-- Main Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Composer Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/fb_card_bg"
                android:padding="12dp"
                android:layout_marginBottom="8dp"
                android:elevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvUserAvatar"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@color/fb_blue"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:text="U" />

                    <EditText
                        android:id="@+id/etNewPostContent"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:hint="What's on your mind?"
                        android:background="@color/fb_bg"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:textSize="14sp"
                        android:layout_marginLeft="10dp" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/fb_border"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/btnLive"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="🎥 Live"
                        android:textColor="#E41E3F"
                        android:background="@color/fb_card_bg"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnPhoto"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="🖼 Photo"
                        android:textColor="@color/fb_green"
                        android:background="@color/fb_card_bg"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnPublish"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="Post"
                        android:textColor="#FFFFFF"
                        android:background="@color/fb_blue"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Stories Container -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:id="@+id/storiesContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

            </HorizontalScrollView>

            <!-- Loading Progress -->
            <ProgressBar
                android:id="@+id/feedProgressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp" />

            <!-- Dynamic Feed Posts Layout -->
            <LinearLayout
                android:id="@+id/feedPostsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>