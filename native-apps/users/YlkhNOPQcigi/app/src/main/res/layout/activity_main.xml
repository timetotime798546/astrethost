<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F2F5">

    <!-- Top Facebook Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:elevation="2dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="facebook"
            android:textColor="#1877F2"
            android:textSize="26sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSearch"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:text="🔍"
            android:textSize="14sp"
            android:background="#E4E6EB"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnMessenger"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:text="💬"
            android:textSize="14sp"
            android:background="#E4E6EB" />
    </LinearLayout>

    <!-- Top Navigation Tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/tabHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="🏠 Feed"
            android:gravity="center"
            android:textColor="#1877F2"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tabFriends"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="👥 Friends"
            android:gravity="center"
            android:textColor="#65676B"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tabWatch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="📺 Watch"
            android:gravity="center"
            android:textColor="#65676B"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tabMenu"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="🌐 Web"
            android:gravity="center"
            android:textColor="#65676B"
            android:textSize="14sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#CED0D4" />

    <!-- Main Feed Scroll Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Real Facebook Browser Launcher Banner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#E7F3FF"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Open official Facebook site in system browser?"
                    android:textColor="#050505"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnOpenWeb"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Open Web"
                    android:textColor="#FFFFFF"
                    android:background="#1877F2"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Create Post Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="#1877F2"
                        android:text="You"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/btnCreatePostTrigger"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:background="#F0F2F5"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:text="What's on your mind?"
                        android:textColor="#65676B"
                        android:textSize="14sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E4E6EB"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🎥 Live"
                        android:gravity="center"
                        android:textColor="#F3425F"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🖼️ Photo"
                        android:gravity="center"
                        android:textColor="#45BD62"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="😊 Feeling"
                        android:gravity="center"
                        android:textColor="#F7B928"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Stories Carousel Section -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:id="@+id/storiesContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- Dynamic Posts Feed -->
            <LinearLayout
                android:id="@+id/feedContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>