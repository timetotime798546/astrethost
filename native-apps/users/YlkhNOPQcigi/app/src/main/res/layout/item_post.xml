<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:layout_marginBottom="12dp">

    <!-- Post Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/img_post_avatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:scaleType="centerCrop"
            android:background="#CCCCCC" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/txt_post_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="username"
                android:textStyle="bold"
                android:textColor="#000000"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txt_post_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Location"
                android:textColor="#737373"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_post_options"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="⋮"
            android:textSize="20sp"
            android:textColor="#000000"
            android:gravity="center" />
    </LinearLayout>

    <!-- Main Media Image -->
    <ImageView
        android:id="@+id/img_post_media"
        android:layout_width="match_parent"
        android:layout_height="380dp"
        android:scaleType="centerCrop"
        android:background="#EFEFEF" />

    <!-- Action Bar (Like, Comment, Share, Bookmark) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/btn_post_like"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="♡"
            android:textSize="24sp"
            android:textColor="#000000"
            android:gravity="center" />

        <TextView
            android:id="@+id/btn_post_comment"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="💬"
            android:textSize="20sp"
            android:gravity="center"
            android:layout_marginStart="8dp" />

        <TextView
            android:id="@+id/btn_post_share"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="✈"
            android:textSize="20sp"
            android:gravity="center"
            android:layout_marginStart="8dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btn_post_bookmark"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="🔖"
            android:textSize="20sp"
            android:gravity="center" />
    </LinearLayout>

    <!-- Likes count -->
    <TextView
        android:id="@+id/txt_post_likes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="1,240 likes"
        android:textStyle="bold"
        android:textColor="#000000"
        android:textSize="13sp" />

    <!-- Caption -->
    <TextView
        android:id="@+id/txt_post_caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:text="username: Caption description text goes here..."
        android:textColor="#000000"
        android:textSize="13sp" />

    <!-- View Comments Trigger -->
    <TextView
        android:id="@+id/btn_view_comments"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:text="View all 18 comments"
        android:textColor="#737373"
        android:textSize="12sp" />

    <!-- Time elapsed -->
    <TextView
        android:id="@+id/txt_post_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="12dp"
        android:text="2 HOURS AGO"
        android:textColor="#999999"
        android:textSize="10sp" />

</LinearLayout>