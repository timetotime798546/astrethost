<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/fb_card_bg"
    android:layout_marginBottom="10dp"
    android:padding="16dp"
    android:elevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvPostAvatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@color/fb_blue"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginLeft="10dp">

            <TextView
                android:id="@+id/tvAuthor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/fb_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/fb_text_secondary"
                android:textSize="12sp" />

        </LinearLayout>

        <Button
            android:id="@+id/btnDeletePost"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="✕"
            android:textColor="@color/fb_text_secondary"
            android:background="@color/fb_bg"
            android:textSize="14sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/fb_text_primary"
        android:textSize="15sp"
        android:lineSpacingExtra="3dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:id="@+id/imageContainer"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:background="@color/fb_light_blue"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvImageTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📷 Shared Image Attachment"
            android:textColor="@color/fb_blue"
            android:textStyle="bold"
            android:textSize="14sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/fb_border"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnLike"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="👍 Like (0)"
            android:textColor="@color/fb_text_secondary"
            android:background="@color/fb_card_bg"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnComment"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="💬 Comment"
            android:textColor="@color/fb_text_secondary"
            android:background="@color/fb_card_bg"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnShare"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="↗ Share"
            android:textColor="@color/fb_text_secondary"
            android:background="@color/fb_card_bg"
            android:textSize="13sp" />

    </LinearLayout>

</LinearLayout>