<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center">

        <!-- Gradient Story Border Ring -->
        <View
            android:id="@+id/story_ring_border"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="#E1306C" />

        <ImageView
            android:id="@+id/img_story_avatar"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_gravity="center"
            android:scaleType="centerCrop"
            android:background="#DDDDDD" />

        <!-- Plus badge for user story -->
        <TextView
            android:id="@+id/txt_add_story_badge"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="bottom|end"
            android:background="#0095F6"
            android:textColor="#FFFFFF"
            android:text="+"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/txt_story_username"
        android:layout_width="72dp"
        android:layout_height="wrap_content"
        android:text="username"
        android:textSize="11sp"
        android:textColor="#000000"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginTop="4dp" />

</LinearLayout>