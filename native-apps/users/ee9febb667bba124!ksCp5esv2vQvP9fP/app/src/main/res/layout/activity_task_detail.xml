<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/btnDetailBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/card_bg"
                android:text="◀"
                android:textColor="#1E2125"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvDetailTitleHeader"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Manage Task"
                android:textColor="#1E2125"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginLeft="12dp" />

            <Button
                android:id="@+id/btnDetailToggleFavorite"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/card_bg"
                android:text="☆"
                android:textColor="#FF4081"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Main Card Form -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Task Title"
                android:textColor="#1E2125"
                android:textStyle="bold"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etDetailTaskTitle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/input_bg"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:inputType="text"
                android:textColor="#1E2125"
                android:textCursorDrawable="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Description"
                android:textColor="#1E2125"
                android:textStyle="bold"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etDetailTaskDesc"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/input_bg"
                android:padding="12dp"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:textColor="#1E2125"
                android:textCursorDrawable="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Category"
                android:textColor="#1E2125"
                android:textStyle="bold"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/spDetailCategory"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/input_bg" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Due Date (YYYY-MM-DD)"
                android:textColor="#1E2125"
                android:textStyle="bold"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etDetailDueDate"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/input_bg"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:inputType="date"
                android:hint="e.g. 2024-12-31"
                android:textColor="#1E2125"
                android:textCursorDrawable="@null" />

            <CheckBox
                android:id="@+id/cbDetailIsCompleted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mark as Completed"
                android:textColor="#1E2125"
                android:textSize="14sp"
                android:layout_marginBottom="12dp" />

        </LinearLayout>

        <!-- Control Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnDetailSave"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/button_bg"
                android:text="Save Tasks"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnDetailShare"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/card_bg"
                android:text="Share with Friends"
                android:textColor="#2196F3"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnDetailDelete"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/button_danger_bg"
                android:text="Delete Task"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>