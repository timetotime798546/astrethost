<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/note_bg"
    android:padding="14dp">

    <TextView
        android:id="@+id/note_item_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_toLeftOf="@+id/note_item_date"
        android:text="Note Title"
        android:textColor="#212121"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/note_item_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_alignParentTop="true"
        android:text="Oct 24, 12:00 PM"
        android:textColor="#999999"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/note_item_category"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/note_item_title"
        android:layout_alignParentLeft="true"
        android:layout_marginTop="6dp"
        android:background="@drawable/badge_bg"
        android:text="Work"
        android:textColor="#37474F"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/note_item_snippet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/note_item_category"
        android:layout_alignParentLeft="true"
        android:layout_toLeftOf="@+id/btn_delete_wrapper"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Snippet details of custom saved note text..."
        android:textColor="#666666"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/btn_delete_wrapper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:padding="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DELETE"
            android:textColor="#C62828"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</RelativeLayout>