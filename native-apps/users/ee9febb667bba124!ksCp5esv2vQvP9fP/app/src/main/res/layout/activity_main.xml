<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#15181F">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#1E222B"
            android:paddingLeft="16dp"
            android:paddingRight="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerY="true"
                android:text="3D SYNTH-CALC"
                android:textColor="#FF00FFCC"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_toggle_history"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_alignParentRight="true"
                android:layout_centerY="true"
                android:background="#2C3241"
                android:text="SHOW HISTORY"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_margin="16dp"
            android:background="#0C1014"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tv_formula"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="right"
                android:ellipsize="start"
                android:singleLine="true"
                android:text=""
                android:textColor="#8000FFCC"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tv_display"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="right|bottom"
                android:text="0"
                android:textColor="#FF00FFCC"
                android:textSize="40sp"
                android:textStyle="bold"
                android:shadowColor="#FF00FFCC"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="10" />
        </LinearLayout>

        <com.threedcalculator.app.ThreeDCalculatorView
            android:id="@+id/calc_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_clear_history"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="8dp"
            android:background="#FF3B30"
            android:text="CLEAR HISTORY RECORDS"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <ScrollView
            android:id="@+id/history_scroll"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="16dp"
            android:background="#12151D"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/history_list_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/loader_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0A0D14"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.threedcalculator.app.ThreeDLoaderView
                android:id="@+id/loader_animation"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_marginBottom="32dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3D SYNTH CALCULATOR"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/loader_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Booting 3D System..."
                android:textColor="#FF00FFCC"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/loader_progress_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="0%"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>