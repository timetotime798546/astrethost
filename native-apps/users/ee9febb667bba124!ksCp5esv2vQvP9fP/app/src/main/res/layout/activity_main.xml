<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/black">

    <!-- Display Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.8"
        android:orientation="vertical"
        android:gravity="bottom">

        <!-- Scrollable History screen -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:scrollbars="none">
            
            <TextView
                android:id="@+id/tvHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#8E8E93"
                android:textSize="22sp"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:gravity="end"
                android:singleLine="true" />
        </HorizontalScrollView>

        <!-- Scrollable Current Input screen -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:scrollbars="none"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp">
            
            <TextView
                android:id="@+id/tvInput"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="48sp"
                android:textStyle="bold"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:gravity="end"
                android:singleLine="true" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Keypad Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4.2"
        android:orientation="vertical"
        android:padding="6dp">

        <!-- Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <Button android:id="@+id/btn_ac" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:text="AC" android:textColor="#FF453A" android:textSize="18sp" android:textStyle="bold" android:background="@drawable/btn_action" android:textAllCaps="false" />
            <Button android:id="@+id/btn_back" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:text="⌫" android:textColor="@color/white" android:textSize="18sp" android:background="@drawable/btn_action" android:textAllCaps="false" />
            <Button android:id="@+id/btn_percent" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:text="%" android:textColor="@color/white" android:textSize="18sp" android:background="@drawable/btn_action" android:textAllCaps="false" />
            <Button android:id="@+id/btn_power" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:text="^" android:textColor="@color/white" android:textSize="18sp" android:background="@drawable/btn_scientific" android:textAllCaps="false" />
            <Button android:id="@+id/btn_divide" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:text="÷" android:textColor="@color/white" android:textSize="22sp" android:background="@drawable/btn_operator" android:textAllCaps="false" />
        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <Button android:id="@+id/btn_sin" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:text="sin" android:textColor="@color/white" android:textSize="16sp" android:background="@drawable/btn_scientific" android:textAllCaps="false" />
            <Button android:id="@+id/btn_7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:text="7" android:textColor="@color/white" android:textSize="22sp" android:background="@drawable/btn_numeric" android:textAllCaps="false" />
            <Button android:id="@+id/btn_8" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:text="8" android:textColor="@color/white" android:textSize="22sp" android:background="@drawable/btn_numeric" android:textAllCaps="false" />
            <Button android:id="@+id/btn_9" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:text="9" android:textColor="@color/white" android:textSize="22sp" android:background="@drawable/btn_numeric" android:textAllCaps="false" />
            <Button android:id="@+id/btn_multiply" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:text="×" android:textColor="@color/white" android:textSize="22sp" android:background="@drawable/btn_operator" android:textAllCaps="false" />
        </LinearLayout>

        <!-- Row 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <Button android:id="@+id/btn_cos" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:text="cos" android:textColor="@color/white" android:textSize="16sp" android:background="@drawable/btn_scientific" android:textAllCaps="false" />
            <Button android:id="@+id/btn_4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:text="4" android:textColor="@color/white" android:textSize="22sp" android:background="@drawable/btn_numeric" android:textAllCaps="false" />
            <Button android:id="@+id/btn_5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:text="5" android:textColor="@color/white" android:textSize="22sp" android:background="@drawable/btn_numeric" android:textAllCaps="false" />
            <Button android:id="@+id/btn_6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:text="6" android:textColor="@color/white" android:textSize="22sp" android:background="@drawable/btn_numeric" android:textAllCaps="false" />
            <Button android:id="@+id/btn_subtract" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:text="-" android:textColor="@color/white" android:textSize="24sp" android:background="@drawable/btn_operator" android:textAllCaps="false" />
        </LinearLayout>

        <!-- Row 4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <Button android:id="@+id/btn_tan" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:text="tan" android:textColor="@color/white" android:textSize="16sp" android:background="@drawable/btn_scientific" android:textAllCaps="false" />
            <Button android:id="@+id/btn_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:text="1" android:textColor="@color/white" android:textSize="22sp" android:background="@drawable/btn_numeric" android:textAllCaps="false" />
            <Button android:id="@+id/btn_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:text="2" android:textColor="@color/white" android:textSize="22sp" android:background="@drawable/btn_numeric" android:textAllCaps="false" />
            <Button android:id="@+id/btn_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:text="3" android:textColor="@color/white" android:textSize="22sp" android:background="@drawable/btn_numeric" android:textAllCaps="false" />
            <Button android:id="@+id/btn_add" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:text="+" android:textColor="@color/white" android:textSize="22sp" android:background="@drawable/btn_operator" android:textAllCaps="false" />
        </LinearLayout>

        <!-- Row 5 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <Button android:id="@+id/btn_ln" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:text="ln" android:textColor="@color/white" android:textSize="16sp" android:background="@drawable/btn_scientific" android:textAllCaps="false" />
            <Button android:id="@+id/btn_sqrt" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:text="√" android:textColor="@color/white" android:textSize="18sp" android:background="@drawable/btn_scientific" android:textAllCaps="false" />
            <Button android:id="@+id/btn_pi" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:text="π" android:textColor="@color/white" android:textSize="18sp" android:background="@drawable/btn_scientific" android:textAllCaps="false" />
            <Button android:id="@+id/btn_open_paren" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:text="(" android:textColor="@color/white" android:textSize="18sp" android:background="@drawable/btn_scientific" android:textAllCaps="false" />
            <Button android:id="@+id/btn_close_paren" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:text=")" android:textColor="@color/white" android:textSize="18sp" android:background="@drawable/btn_scientific" android:textAllCaps="false" />
        </LinearLayout>

        <!-- Row 6 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <Button android:id="@+id/btn_log" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:text="log" android:textColor="@color/white" android:textSize="15sp" android:background="@drawable/btn_scientific" android:textAllCaps="false" />
            <Button android:id="@+id/btn_e" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:text="e" android:textColor="@color/white" android:textSize="18sp" android:background="@drawable/btn_scientific" android:textAllCaps="false" />
            <Button android:id="@+id/btn_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:text="0" android:textColor="@color/white" android:textSize="22sp" android:background="@drawable/btn_numeric" android:textAllCaps="false" />
            <Button android:id="@+id/btn_dot" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:text="." android:textColor="@color/white" android:textSize="22sp" android:background="@drawable/btn_numeric" android:textAllCaps="false" />
            <Button android:id="@+id/btn_equals" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:text="=" android:textColor="@color/white" android:textSize="26sp" android:background="@drawable/btn_equals" android:textAllCaps="false" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>