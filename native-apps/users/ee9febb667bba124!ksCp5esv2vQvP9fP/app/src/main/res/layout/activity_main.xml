<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <LinearLayout
        android:id="@+id/main_content_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:weightSum="10">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.1"
            android:background="#1E1E1E"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="3D History Explorer"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_sound_toggle"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="#2E2E2E"
                    android:text="🔊"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:layout_marginRight="8dp" />

                <Button
                    android:id="@+id/btn_info"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="#2E2E2E"
                    android:text="ℹ️"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />
            </LinearLayout>
        </RelativeLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="5.4"
            android:background="#161616">

            <com.history3dexplorer.app.History3DCarouselView
                android:id="@+id/carousel_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="12dp"
                android:text="◀ Drag to spin 3D Carousel • Tap card to expand ▶"
                android:textColor="#666666"
                android:textSize="12sp"
                android:textStyle="italic" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3.5"
            android:background="#1E1E1E"
            android:orientation="vertical"
            android:padding="16dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/txt_era_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ancient Egypt"
                    android:textColor="#FFD700"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_era_year"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_alignBaseline="@+id/txt_era_title"
                    android:text="3100 BC"
                    android:textColor="#AAAAAA"
                    android:textSize="15sp" />
            </RelativeLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/txt_era_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.25"
                    android:text="Loading descriptive historical text..."
                    android:textColor="#DDDDDD"
                    android:textSize="14sp" />
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_trivia_challenge"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.1"
                    android:background="#FFD700"
                    android:text="💡 Trivia Challenge"
                    android:textColor="#111111"
                    android:textStyle="bold"
                    android:layout_marginRight="6dp" />

                <Button
                    android:id="@+id/btn_quick_fact"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0"
                    android:background="#333333"
                    android:text="🔍 Did You Know?"
                    android:textColor="#FFFFFF"
                    android:layout_marginLeft="6dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/splash_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#080808"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3D HISTORY"
                android:textColor="#FFD700"
                android:textSize="34sp"
                android:textStyle="bold"
                android:letterSpacing="0.2" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="E X P L O R E R"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:letterSpacing="0.4"
                android:layout_marginTop="4dp" />

            <ProgressBar
                android:id="@+id/splash_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="220dp"
                android:layout_height="8dp"
                android:layout_marginTop="44dp"
                android:progressDrawable="@android:drawable/progress_horizontal" />

            <TextView
                android:id="@+id/txt_splash_loading_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Opening dimensional archives..."
                android:textColor="#888888"
                android:textSize="13sp"
                android:textStyle="italic" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="30dp"
            android:text="A Fully-Synthesized 3D Educational Voyage"
            android:textColor="#555555"
            android:textSize="11sp" />
    </RelativeLayout>
</RelativeLayout>