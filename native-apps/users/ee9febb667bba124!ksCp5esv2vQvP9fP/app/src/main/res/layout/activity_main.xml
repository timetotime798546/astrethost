<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC">

    <!-- Styled App Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="#007AFF"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Student Study Planner"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Organize, Plan, &amp; Execute Your Academics"
            android:textColor="#E2E8F0"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Main Screen Frame swapping area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 1. DASHBOARD SCREEN -->
        <ScrollView
            android:id="@+id/layout_dashboard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Academic Progress Summary Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_bg"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Overall Task Progress"
                        android:textColor="#1E293B"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/dashboard_progress_bar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="8dp"
                        android:max="100"
                        android:progress="0" />

                    <TextView
                        android:id="@+id/dashboard_progress_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0% tasks completed"
                        android:textColor="#64748B"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quick Actions"
                    android:textColor="#1E293B"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <Button
                        android:id="@+id/dash_btn_add_task"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginRight="4dp"
                        android:text="+ Add Task"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/button_bg"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/dash_btn_add_subj"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginLeft="4dp"
                        android:text="+ Add Subject"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/button_bg"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Today's Overview"
                    android:textColor="#1E293B"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/dashboard_today_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <!-- Dynamic task widgets loaded via Java -->
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- 2. SUBJECTS SCREEN -->
        <ScrollView
            android:id="@+id/layout_subjects"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Add New Subject Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_bg"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Create New Subject"
                        android:textColor="#1E293B"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <EditText
                        android:id="@+id/input_subject_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Subject Name (e.g. Chemistry, Biology)"
                        android:inputType="textCapWords"
                        android:textSize="14sp"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Choose Code Color:"
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginBottom="16dp">

                        <!-- Simple color picker radio options simulated via buttons in MainActivity -->
                        <Button android:id="@+id/color_pick_red" android:layout_width="30dp" android:layout_height="30dp" android:layout_margin="4dp" android:background="#FF3B30" />
                        <Button android:id="@+id/color_pick_green" android:layout_width="30dp" android:layout_height="30dp" android:layout_margin="4dp" android:background="#34C759" />
                        <Button android:id="@+id/color_pick_blue" android:layout_width="30dp" android:layout_height="30dp" android:layout_margin="4dp" android:background="#007AFF" />
                        <Button android:id="@+id/color_pick_purple" android:layout_width="30dp" android:layout_height="30dp" android:layout_margin="4dp" android:background="#AF52DE" />
                        <Button android:id="@+id/color_pick_orange" android:layout_width="30dp" android:layout_height="30dp" android:layout_margin="4dp" android:background="#FF9500" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_save_subject"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Save Subject"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/button_bg" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Registered Subjects"
                    android:textColor="#1E293B"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/subjects_list_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <!-- Loaded via Java dynamically -->
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- 3. TASKS PLANNER SCREEN -->
        <ScrollView
            android:id="@+id/layout_tasks"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Add New Task Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_bg"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Schedule New Study Task"
                        android:textColor="#1E293B"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <EditText
                        android:id="@+id/input_task_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Task Title (e.g. Read Chapter 4)"
                        android:inputType="textCapSentences"
                        android:textSize="14sp"
                        android:layout_marginBottom="10dp" />

                    <EditText
                        android:id="@+id/input_task_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Short description/topic notes"
                        android:inputType="textCapSentences"
                        android:textSize="14sp"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Associated Academic Subject:"
                        android:textColor="#64748B"
                        android:textSize="11sp" />

                    <Spinner
                        android:id="@+id/spinner_task_subject"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Task Priority:"
                                android:textColor="#64748B"
                                android:textSize="11sp" />
                            <Spinner
                                android:id="@+id/spinner_task_priority"
                                android:layout_width="match_parent"
                                android:layout_height="40dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingLeft="8dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Due Date:"
                                android:textColor="#64748B"
                                android:textSize="11sp" />
                            <Button
                                android:id="@+id/btn_pick_date"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:text="Select Date"
                                android:textSize="12sp"
                                android:background="#E2E8F0"
                                android:textColor="#1E293B" />
                        </LinearLayout>
                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_save_task"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Add Task to Schedule"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/button_bg" />
                </LinearLayout>

                <!-- Filter System -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <Button
                        android:id="@+id/btn_filter_all"
                        android:layout_width="0dp"
                        android:layout_height="35dp"
                        android:layout_weight="1"
                        android:layout_marginRight="2dp"
                        android:text="All"
                        android:textSize="11sp"
                        android:background="#E2E8F0"
                        android:textColor="#1E293B" />

                    <Button
                        android:id="@+id/btn_filter_pending"
                        android:layout_width="0dp"
                        android:layout_height="35dp"
                        android:layout_weight="1.2"
                        android:layout_marginLeft="2dp"
                        android:layout_marginRight="2dp"
                        android:text="Pending"
                        android:textSize="11sp"
                        android:background="#007AFF"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/btn_filter_done"
                        android:layout_width="0dp"
                        android:layout_height="35dp"
                        android:layout_weight="1.2"
                        android:layout_marginLeft="2dp"
                        android:text="Completed"
                        android:textSize="11sp"
                        android:background="#E2E8F0"
                        android:textColor="#1E293B" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tasks_list_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <!-- Tasks loaded dynamically in Java -->
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- 4. STATS SCREEN -->
        <ScrollView
            android:id="@+id/layout_stats"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Academic Stats Dashboard Summary -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_bg"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Academic Analytics"
                        android:textColor="#1E293B"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/txt_stat_total_subj"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="4"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textColor="#007AFF" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Subjects"
                                android:textSize="12sp"
                                android:textColor="#64748B" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/txt_stat_total_tasks"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="10"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textColor="#F59E0B" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Total Tasks"
                                android:textSize="12sp"
                                android:textColor="#64748B" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/txt_stat_completed_tasks"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="6"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textColor="#10B981" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Completed"
                                android:textSize="12sp"
                                android:textColor="#64748B" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Progress Per Subject"
                    android:textColor="#1E293B"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/stats_subjects_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <!-- Dynamically populated subjects tracking cards -->
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Navigation Tab Bar divider line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E8F0" />

    <!-- Dynamic Bottom Navigation Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#FFFFFF"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tab_dashboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏠"
                android:textSize="18sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dashboard"
                android:textSize="11sp"
                android:textColor="#007AFF"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_subjects"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📚"
                android:textSize="18sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Subjects"
                android:textSize="11sp"
                android:textColor="#64748B" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_tasks"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋"
                android:textSize="18sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tasks"
                android:textSize="11sp"
                android:textColor="#64748B" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_stats"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊"
                android:textSize="18sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Analytics"
                android:textSize="11sp"
                android:textColor="#64748B" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>