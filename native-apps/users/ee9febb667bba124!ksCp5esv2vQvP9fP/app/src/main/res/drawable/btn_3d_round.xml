<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Circular Mechanical Switch: Pressed State -->
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#08090B" />
                </shape>
            </item>
            <item android:top="6dp" android:left="1dp" android:right="1dp" android:bottom="1dp">
                <shape android:shape="oval">
                    <gradient
                        android:startColor="#2E313A"
                        android:endColor="#1B1D23"
                        android:angle="270" />
                    <stroke android:width="1dp" android:color="#3C3F4B" />
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- Circular Mechanical Switch: Normal State -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#060709" />
                </shape>
            </item>
            <item android:top="2dp" android:bottom="1dp">
                <shape android:shape="oval">
                    <solid android:color="#1D2026" />
                </shape>
            </item>
            <item android:top="1dp" android:bottom="6dp">
                <shape android:shape="oval">
                    <solid android:color="#5D6375" />
                </shape>
            </item>
            <item android:top="2dp" android:bottom="8dp" android:left="1dp" android:right="1dp">
                <shape android:shape="oval">
                    <gradient
                        android:startColor="#464B59"
                        android:endColor="#2A2E38"
                        android:angle="270" />
                    <stroke android:width="1dp" android:color="#4F5567" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>