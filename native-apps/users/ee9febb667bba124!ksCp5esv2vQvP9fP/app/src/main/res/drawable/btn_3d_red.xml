<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed State -->
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="6dp">
                <shape>
                    <solid android:color="#6B120D" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item android:top="6dp">
                <shape>
                    <gradient
                        android:startColor="#C42F27"
                        android:endColor="#9E1B15"
                        android:angle="270" />
                    <corners android:radius="12dp" />
                    <stroke android:width="1.5dp" android:color="#E34238" />
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- Normal State -->
    <item>
        <layer-list>
            <item android:top="6dp">
                <shape>
                    <solid android:color="#851B15" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item android:bottom="6dp">
                <shape>
                    <gradient
                        android:startColor="#FF5B52"
                        android:endColor="#D12B21"
                        android:angle="270" />
                    <corners android:radius="12dp" />
                    <stroke android:width="1.5dp" android:color="#FF7D75" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>