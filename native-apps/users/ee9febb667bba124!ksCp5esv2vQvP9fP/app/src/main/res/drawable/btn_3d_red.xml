<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed State -->
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape>
                    <solid android:color="#2D0806" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:top="8dp" android:left="1.5dp" android:right="1.5dp" android:bottom="1dp">
                <shape>
                    <gradient
                        android:startColor="#9E1A13"
                        android:endColor="#75100B"
                        android:angle="270" />
                    <corners android:radius="9dp" />
                    <stroke android:width="1.2dp" android:color="#C0261D" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Normal State -->
    <item>
        <layer-list>
            <item>
                <shape>
                    <solid android:color="#200403" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:top="3dp" android:bottom="1.5dp">
                <shape>
                    <solid android:color="#96150E" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:top="1dp" android:bottom="8dp">
                <shape>
                    <solid android:color="#FF6B63" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:top="2dp" android:bottom="10dp" android:left="1.5dp" android:right="1.5dp">
                <shape>
                    <gradient
                        android:startColor="#FF4235"
                        android:endColor="#CC1C11"
                        android:angle="270" />
                    <corners android:radius="8dp" />
                    <stroke android:width="1dp" android:color="#FF7168" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>