<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed State: Bottom 3D shadow shrinks/disappears, button face moves down -->
    <item android:state_pressed="true">
        <layer-list>
            <!-- Bottom dark base plate -->
            <item android:top="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#000000" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <!-- Shrunken face surface -->
            <item android:top="2dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#242428"
                        android:endColor="#151517"
                        android:angle="270" />
                    <corners android:radius="14dp" />
                    <stroke android:width="1dp" android:color="#303035" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Normal State: Dynamic 3D extruding depth -->
    <item>
        <layer-list>
            <!-- Deep outer drop shadow (Extrusion base) -->
            <item android:top="5dp">
                <shape android:shape="rectangle">
                    <solid android:color="#000000" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <!-- 3D Bevel lip -->
            <item android:top="1dp" android:bottom="4dp" android:left="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#111113" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <!-- High mechanical tactile face -->
            <item android:bottom="6dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#46464E"
                        android:endColor="#242428"
                        android:angle="270" />
                    <corners android:radius="14dp" />
                    <stroke android:width="1dp" android:color="#5C5C66" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>