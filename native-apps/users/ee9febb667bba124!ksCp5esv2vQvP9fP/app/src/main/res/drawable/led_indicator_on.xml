<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dynamic state LED: Active Glowing -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#08090A" />
            <stroke android:width="1dp" android:color="#373E47" />
        </shape>
    </item>
    <!-- Lens Glow -->
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#39FF14"
                android:centerColor="#00FF66"
                android:endColor="#006B1B"
                android:angle="270" />
            <stroke android:width="1dp" android:color="#C8FFC0" />
        </shape>
    </item>
</layer-list>