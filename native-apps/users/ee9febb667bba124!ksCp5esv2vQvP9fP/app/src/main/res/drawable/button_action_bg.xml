<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed State -->
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#1E1E22" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item android:top="2dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#404046"
                        android:endColor="#2E2E33"
                        android:angle="270" />
                    <corners android:radius="14dp" />
                    <stroke android:width="1dp" android:color="#4E4E56" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Normal State -->
    <item>
        <layer-list>
            <item android:top="5dp">
                <shape android:shape="rectangle">
                    <solid android:color="#1C1C1F" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item android:top="1dp" android:bottom="4dp" android:left="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#2C2C30" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item android:bottom="6dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#787880"
                        android:endColor="#4D4D54"
                        android:angle="270" />
                    <corners android:radius="14dp" />
                    <stroke android:width="1dp" android:color="#92929C" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>