<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 3D shadow extrude bottom layer -->
    <item android:bottom="0dp" android:left="0dp" android:right="0dp" android:top="6dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#0F111A" />
        </shape>
    </item>
    <!-- Main interactive surface card layer -->
    <item android:bottom="6dp" android:left="0dp" android:right="0dp" android:top="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#24283D" />
            <stroke android:width="1.5dp" android:color="#3F51B5" />
        </shape>
    </item>
</layer-list>