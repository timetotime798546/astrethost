<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed State -->
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#6B3C00" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item android:top="2dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#C27300"
                        android:endColor="#A36100"
                        android:angle="270" />
                    <corners android:radius="14dp" />
                    <stroke android:width="1dp" android:color="#E08500" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Normal State -->
    <item>
        <layer-list>
            <item android:top="5dp">
                <shape android:shape="rectangle">
                    <solid android:color="#5A3200" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item android:top="1dp" android:bottom="4dp" android:left="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#854A00" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item android:bottom="6dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#FFB443"
                        android:endColor="#FF9F0A"
                        android:angle="270" />
                    <corners android:radius="14dp" />
                    <stroke android:width="1dp" android:color="#FFD085" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>