<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed State -->
    <item android:state_pressed="true">
        <layer-list>
            <!-- Deep recessed background shadow -->
            <item android:top="6dp">
                <shape>
                    <solid android:color="#111112" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <!-- Face pushed down -->
            <item android:top="6dp">
                <shape>
                    <gradient
                        android:startColor="#36363B"
                        android:endColor="#2A2A2E"
                        android:angle="270" />
                    <corners android:radius="12dp" />
                    <stroke android:width="1.5dp" android:color="#424247" />
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- Normal State -->
    <item>
        <layer-list>
            <!-- Base 3D dark side edge -->
            <item android:top="6dp">
                <shape>
                    <solid android:color="#18181B" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <!-- Face pop up -->
            <item android:bottom="6dp">
                <shape>
                    <gradient
                        android:startColor="#4B4B52"
                        android:endColor="#333338"
                        android:angle="270" />
                    <corners android:radius="12dp" />
                    <stroke android:width="1.5dp" android:color="#5D5D66" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>