<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed State: Physical key shifts deep down into keywell -->
    <item android:state_pressed="true">
        <layer-list>
            <!-- Deep recess shadow inside keyhole -->
            <item>
                <shape>
                    <solid android:color="#0C0D0F" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <!-- Sunken keycap surface -->
            <item android:top="8dp" android:left="1.5dp" android:right="1.5dp" android:bottom="1dp">
                <shape>
                    <gradient
                        android:startColor="#32353E"
                        android:endColor="#24262C"
                        android:angle="270" />
                    <corners android:radius="9dp" />
                    <stroke android:width="1.2dp" android:color="#3E424D" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Normal State: Extruded prominent mechanical key layout -->
    <item>
        <layer-list>
            <!-- Shadow cast on case -->
            <item>
                <shape>
                    <solid android:color="#08090B" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <!-- Thick vertical mechanical keycap sidewalls (3D extrusion height) -->
            <item android:top="3dp" android:bottom="1.5dp">
                <shape>
                    <solid android:color="#22252C" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <!-- Bright Bevel top edge catchlight -->
            <item android:top="1dp" android:bottom="8dp">
                <shape>
                    <solid android:color="#5D6372" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <!-- Keycap upper matte core tactile pad -->
            <item android:top="2dp" android:bottom="10dp" android:left="1.5dp" android:right="1.5dp">
                <shape>
                    <gradient
                        android:startColor="#464B57"
                        android:endColor="#2B2F37"
                        android:angle="270" />
                    <corners android:radius="8dp" />
                    <stroke android:width="1dp" android:color="#4F5563" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>