<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer black slot bezel rim -->
    <item>
        <shape>
            <solid android:color="#0B0C0E" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Bottom highlight shadow of mechanical display casing slot -->
    <item android:bottom="2dp">
        <shape>
            <solid android:color="#464B59" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Display Slot inner casing -->
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="4dp">
        <shape>
            <solid android:color="#181A20" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#2B2F3B" />
        </shape>
    </item>
    <!-- Sunken Screen dark well depth -->
    <item android:top="8dp" android:left="8dp" android:right="8dp" android:bottom="11dp">
        <shape>
            <solid android:color="#050608" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <!-- Glow LCD glass matrix layer -->
    <item android:top="11dp" android:left="11dp" android:right="11dp" android:bottom="14dp">
        <shape>
            <gradient
                android:startColor="#0A1C15"
                android:endColor="#040B08"
                android:angle="270" />
            <corners android:radius="6dp" />
            <stroke android:width="1.5dp" android:color="#1F4637" />
        </shape>
    </item>
    <!-- Realistic overhead light reflection/glare across upper pane -->
    <item android:top="11dp" android:left="11dp" android:right="11dp" android:bottom="42dp">
        <shape>
            <gradient
                android:startColor="#2AFFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270" />
            <corners android:topLeftRadius="6dp" android:topRightRadius="6dp" />
        </shape>
    </item>
</layer-list>