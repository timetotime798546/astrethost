<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer dark frame shadow -->
    <item>
        <shape>
            <solid android:color="#080809" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- Top inner shadow simulating depth -->
    <item android:top="3dp" android:left="1dp" android:right="1dp">
        <shape>
            <solid android:color="#0D0D0F" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- Actual display inner face -->
    <item android:top="5dp" android:bottom="2dp" android:left="3dp" android:right="3dp">
        <shape>
            <gradient
                android:startColor="#15161A"
                android:endColor="#1C1D24"
                android:angle="270" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#282A36" />
        </shape>
    </item>
</layer-list>