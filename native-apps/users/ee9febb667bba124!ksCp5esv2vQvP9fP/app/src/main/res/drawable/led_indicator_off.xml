<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dynamic state LED: Dark/Dim -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#08090A" />
            <stroke android:width="1dp" android:color="#373E47" />
        </shape>
    </item>
    <!-- Inactive Dim Lens -->
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#1B3A1C"
                android:centerColor="#102811"
                android:endColor="#071408"
                android:angle="270" />
            <stroke android:width="1dp" android:color="#224724" />
        </shape>
    </item>
</layer-list>