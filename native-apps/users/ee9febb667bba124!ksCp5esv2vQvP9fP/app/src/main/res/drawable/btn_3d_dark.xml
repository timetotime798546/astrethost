<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed State -->
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape>
                    <solid android:color="#050607" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:top="8dp" android:left="1.5dp" android:right="1.5dp" android:bottom="1dp">
                <shape>
                    <gradient
                        android:startColor="#1B1C21"
                        android:endColor="#111215"
                        android:angle="270" />
                    <corners android:radius="9dp" />
                    <stroke android:width="1.2dp" android:color="#272931" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Normal State -->
    <item>
        <layer-list>
            <item>
                <shape>
                    <solid android:color="#040405" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:top="3dp" android:bottom="1.5dp">
                <shape>
                    <solid android:color="#111317" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:top="1dp" android:bottom="8dp">
                <shape>
                    <solid android:color="#3F424E" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:top="2dp" android:bottom="10dp" android:left="1.5dp" android:right="1.5dp">
                <shape>
                    <gradient
                        android:startColor="#2B2D36"
                        android:endColor="#17181D"
                        android:angle="270" />
                    <corners android:radius="8dp" />
                    <stroke android:width="1dp" android:color="#373A46" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>