<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed State -->
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="6dp">
                <shape>
                    <solid android:color="#08080A" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item android:top="6dp">
                <shape>
                    <gradient
                        android:startColor="#1A1A1E"
                        android:endColor="#121215"
                        android:angle="270" />
                    <corners android:radius="12dp" />
                    <stroke android:width="1.5dp" android:color="#25252B" />
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- Normal State -->
    <item>
        <layer-list>
            <item android:top="6dp">
                <shape>
                    <solid android:color="#0E0E11" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item android:bottom="6dp">
                <shape>
                    <gradient
                        android:startColor="#2A2A33"
                        android:endColor="#1A1A20"
                        android:angle="270" />
                    <corners android:radius="12dp" />
                    <stroke android:width="1.5dp" android:color="#383845" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>