<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Plate Outer Beveled Shadow -->
    <item>
        <shape>
            <solid android:color="#0B0C0E" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <!-- Bottom highlight rim -->
    <item android:bottom="1dp">
        <shape>
            <solid android:color="#636A7A" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <!-- Metal plate finish -->
    <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="2dp">
        <shape>
            <gradient
                android:startColor="#414652"
                android:centerColor="#2D313A"
                android:endColor="#1F2128"
                android:angle="270" />
            <corners android:radius="3dp" />
            <stroke android:width="0.5dp" android:color="#52596A" />
        </shape>
    </item>
</layer-list>