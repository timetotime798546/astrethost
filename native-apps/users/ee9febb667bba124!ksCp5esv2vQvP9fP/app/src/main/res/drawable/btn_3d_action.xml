<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="2dp" android:bottom="0dp" android:left="0dp" android:right="0dp">
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="#303F9F" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="3dp" android:bottom="0dp" android:left="0dp" android:right="0dp">
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="#1A237E" />
                </shape>
            </item>
            <item android:top="0dp" android:bottom="3dp" android:left="0dp" android:right="0dp">
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="#3F51B5" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>