<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/note_card"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/text_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@+id/text_category"
            android:text="Note Title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:singleLine="true" />

        <TextView
            android:id="@+id/text_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/category_badge"
            android:text="Personal"
            android:textColor="#1976D2"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

    </RelativeLayout>

    <TextView
        android:id="@+id/text_content_snippet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="This is a quick preview of what the content is..."
        android:textColor="#666666"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"
        android:maxLines="2" />

    <TextView
        android:id="@+id/text_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Oct 23, 2023 14:05"
        android:textColor="#999999"
        android:textSize="11sp" />

</LinearLayout>